//@version=6
indicator("My Custom No-Trading Shield", overlay=true)

// Convert chart time to Dubai Time (UTC+4) using v6 time functions
dubaiHour   = time("1", "", "GMT+4") != 0 ? hour(time, "GMT+4") : na
dubaiMinute = time("1", "", "GMT+4") != 0 ? minute(time, "GMT+4") : na
dubaiDay    = time("1", "", "GMT+4") != 0 ? dayofweek(time, "GMT+4") : na

// Rule 1: Friday starting exactly at 16:00 (4:00 PM)
isFridayAfternoon = (dubaiDay == 6 and (dubaiHour > 16 or (dubaiHour == 16 and dubaiMinute >= 0)))

// Rule 2: Complete weekend closure (Saturday = 7, Sunday = 1)
isWeekend = (dubaiDay == 7 or dubaiDay == 1)

// Rule 3: All of Monday (Monday = 2)
isMonday = (dubaiDay == 2)

// Rule 4: Tuesday morning up until 11:00 AM (Tuesday = 3)
isTuesdayMorning = (dubaiDay == 3 and dubaiHour < 11)

// Combine all rules to create the total No-Trading Window
isNoTradeZone = isFridayAfternoon or isWeekend or isMonday or isTuesdayMorning

// Shading color (Soft Red/Gray with 90% transparency so you can still see candles underneath)
bg_color = isNoTradeZone ? color.new(color.red, 90) : na
bgcolor(bg_color)