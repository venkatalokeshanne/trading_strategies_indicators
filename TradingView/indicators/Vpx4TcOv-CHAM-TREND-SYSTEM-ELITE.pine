//@version=6
indicator("CHAM TREND SYSTEM ELITE", shorttitle="CHAM ELITE", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=200)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CHAM TREND SYSTEM ELITE
// Trend + Structure + Liquidity + Supply/Demand + Volume
// Non-repainting signal logic uses confirmed bars.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

groupTrend = "TREND ENGINE"

fastLen = input.int(9, "Fast EMA", minval=1, group=groupTrend)
slowLen = input.int(21, "Slow EMA", minval=2, group=groupTrend)
smmaLen = input.int(50, "SMMA", minval=2, group=groupTrend)
ema200Len = input.int(200, "EMA 200", minval=20, group=groupTrend)

useHTF = input.bool(true, "Use Higher Timeframe Filter", group=groupTrend)
htfTF = input.timeframe("60", "Higher Timeframe", group=groupTrend)

groupStructure = "MARKET STRUCTURE"

pivotLeft = input.int(5, "Pivot Left", minval=2, group=groupStructure)
pivotRight = input.int(5, "Pivot Right", minval=2, group=groupStructure)

groupLiquidity = "LIQUIDITY"

liqLookback = input.int(20, "Liquidity Lookback", minval=5, group=groupLiquidity)
liqBuffer = input.float(0.20, "Liquidity ATR Buffer", minval=0.05, step=0.05, group=groupLiquidity)

groupVolume = "VOLUME"

volumeLen = input.int(20, "Volume Average", minval=2, group=groupVolume)
volumeMultiplier = input.float(1.25, "Strong Volume Multiplier", minval=0.5, step=0.05, group=groupVolume)

groupMomentum = "MOMENTUM"

rsiLen = input.int(14, "RSI Length", minval=2, group=groupMomentum)
bullRSI = input.int(52, "Bullish RSI Threshold", minval=40, maxval=70, group=groupMomentum)
bearRSI = input.int(48, "Bearish RSI Threshold", minval=30, maxval=60, group=groupMomentum)

groupSignals = "PRECISION ENGINE"

minimumScore = input.int(75, "Minimum Score", minval=50, maxval=100, group=groupSignals)
cooldown = input.int(8, "Signal Cooldown Bars", minval=1, group=groupSignals)

requireStructure = input.bool(true, "Require Structure", group=groupSignals)
requireVolume = input.bool(true, "Require Volume", group=groupSignals)
requireCandle = input.bool(true, "Require Candle Confirmation", group=groupSignals)

groupZones = "SUPPLY / DEMAND"

showZones = input.bool(true, "Show Supply / Demand", group=groupZones)
zoneATR = input.float(0.75, "Zone Width ATR", minval=0.1, step=0.05, group=groupZones)
zoneBars = input.int(50, "Zone Extension", minval=10, group=groupZones)

groupRisk = "RISK MANAGEMENT"

atrLen = input.int(14, "ATR Length", minval=2, group=groupRisk)
stopATR = input.float(1.5, "Stop Loss ATR", minval=0.5, step=0.1, group=groupRisk)

tp1RR = input.float(1.0, "TP1 R:R", minval=0.25, step=0.25, group=groupRisk)
tp2RR = input.float(2.0, "TP2 R:R", minval=0.5, step=0.25, group=groupRisk)
tp3RR = input.float(3.0, "TP3 R:R", minval=1.0, step=0.25, group=groupRisk)

groupDisplay = "DISPLAY"

showMAs = input.bool(true, "Show Moving Averages", group=groupDisplay)
showSR = input.bool(true, "Show Support / Resistance", group=groupDisplay)
showLiquidity = input.bool(true, "Show Liquidity Sweeps", group=groupDisplay)
showTrendlines = input.bool(true, "Show Trendlines", group=groupDisplay)
showStructure = input.bool(true, "Show Structure", group=groupDisplay)
showDashboard = input.bool(true, "Show Dashboard", group=groupDisplay)
showRisk = input.bool(true, "Show Entry / SL / TP", group=groupDisplay)
showBackground = input.bool(true, "Show Trend Background", group=groupDisplay)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CORE INDICATORS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

fastEMA = ta.ema(close, fastLen)
slowEMA = ta.ema(close, slowLen)

smma50 = ta.rma(close, smmaLen)
ema200 = ta.ema(close, ema200Len)

atr = ta.atr(atrLen)

rsi = ta.rsi(close, rsiLen)

volumeAverage = ta.sma(volume, volumeLen)

strongVolume = volume > volumeAverage * volumeMultiplier

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MA CROSS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bullCross = ta.crossover(fastEMA, slowEMA)
bearCross = ta.crossunder(fastEMA, slowEMA)

maBull = fastEMA > slowEMA
maBear = fastEMA < slowEMA

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TREND
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

smmaBull = close > smma50 and smma50 > smma50[3]
smmaBear = close < smma50 and smma50 < smma50[3]

majorBull = close > ema200
majorBear = close < ema200

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// HIGHER TIMEFRAME
// Uses previous confirmed HTF candle.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

htfClose = request.security(
     syminfo.tickerid,
     htfTF,
     close[1],
     lookahead=barmerge.lookahead_on)

htfSMMA = request.security(
     syminfo.tickerid,
     htfTF,
     ta.rma(close, smmaLen)[1],
     lookahead=barmerge.lookahead_on)

htfEMA = request.security(
     syminfo.tickerid,
     htfTF,
     ta.ema(close, ema200Len)[1],
     lookahead=barmerge.lookahead_on)

htfBull = htfClose > htfSMMA and htfSMMA > htfEMA
htfBear = htfClose < htfSMMA and htfSMMA < htfEMA

htfBullOK = not useHTF or htfBull
htfBearOK = not useHTF or htfBear

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MARKET STRUCTURE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

pivotHigh = ta.pivothigh(high, pivotLeft, pivotRight)
pivotLow = ta.pivotlow(low, pivotLeft, pivotRight)

var float lastHigh = na
var float previousHigh = na
var float lastLow = na
var float previousLow = na

var int lastHighBar = na
var int previousHighBar = na
var int lastLowBar = na
var int previousLowBar = na

if not na(pivotHigh)
    previousHigh := lastHigh
    previousHighBar := lastHighBar
    lastHigh := pivotHigh
    lastHighBar := bar_index - pivotRight

if not na(pivotLow)
    previousLow := lastLow
    previousLowBar := lastLowBar
    lastLow := pivotLow
    lastLowBar := bar_index - pivotRight

HH = not na(lastHigh) and not na(previousHigh) and lastHigh > previousHigh
LH = not na(lastHigh) and not na(previousHigh) and lastHigh < previousHigh

HL = not na(lastLow) and not na(previousLow) and lastLow > previousLow
LL = not na(lastLow) and not na(previousLow) and lastLow < previousLow

bullStructure = HH and HL
bearStructure = LH and LL

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// STRUCTURE LABELS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if showStructure and not na(pivotHigh)
    label.new(
         bar_index - pivotRight,
         pivotHigh,
         HH ? "HH" : LH ? "LH" : "SH",
         style=label.style_label_down,
         color=HH ? color.green : color.red,
         textcolor=color.white,
         size=size.tiny)

if showStructure and not na(pivotLow)
    label.new(
         bar_index - pivotRight,
         pivotLow,
         HL ? "HL" : LL ? "LL" : "SL",
         style=label.style_label_up,
         color=HL ? color.green : color.red,
         textcolor=color.white,
         size=size.tiny)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BREAK OF STRUCTURE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bullBOS = not na(lastHigh) and close > lastHigh
bearBOS = not na(lastLow) and close < lastLow

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SUPPORT / RESISTANCE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

support = ta.lowest(low, 50)
resistance = ta.highest(high, 50)

plot(
     showSR ? support : na,
     "Support",
     color=color.new(color.green, 25),
     linewidth=2)

plot(
     showSR ? resistance : na,
     "Resistance",
     color=color.new(color.red, 25),
     linewidth=2)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LIQUIDITY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

buySideLevel = ta.highest(high[1], liqLookback)
sellSideLevel = ta.lowest(low[1], liqLookback)

buySideSweep =
     high > buySideLevel and
     close < buySideLevel and
     high - buySideLevel <= atr * liqBuffer

sellSideSweep =
     low < sellSideLevel and
     close > sellSideLevel and
     sellSideLevel - low <= atr * liqBuffer

if showLiquidity and buySideSweep
    label.new(
         bar_index,
         high,
         "BSL\nSWEEP",
         style=label.style_label_down,
         color=color.orange,
         textcolor=color.white,
         size=size.tiny)

if showLiquidity and sellSideSweep
    label.new(
         bar_index,
         low,
         "SSL\nSWEEP",
         style=label.style_label_up,
         color=color.aqua,
         textcolor=color.black,
         size=size.tiny)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SUPPLY / DEMAND
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var box demandBox = na
var box supplyBox = na

if showZones and not na(pivotLow)

    if not na(demandBox)
        box.delete(demandBox)

    demandBox := box.new(
         left=bar_index - pivotRight,
         top=pivotLow + atr * zoneATR,
         right=bar_index + zoneBars,
         bottom=pivotLow - atr * zoneATR,
         bgcolor=color.new(color.green, 88),
         border_color=color.new(color.green, 40))

if showZones and not na(pivotHigh)

    if not na(supplyBox)
        box.delete(supplyBox)

    supplyBox := box.new(
         left=bar_index - pivotRight,
         top=pivotHigh + atr * zoneATR,
         right=bar_index + zoneBars,
         bottom=pivotHigh - atr * zoneATR,
         bgcolor=color.new(color.red, 88),
         border_color=color.new(color.red, 40))

nearDemand =
     not na(lastLow) and
     math.abs(close - lastLow) <= atr * 1.25

nearSupply =
     not na(lastHigh) and
     math.abs(close - lastHigh) <= atr * 1.25

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CANDLE CONFIRMATION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

candleRange = high - low
candleBody = math.abs(close - open)

bullCandle =
     candleRange > 0 and
     close > open and
     candleBody / candleRange >= 0.55

bearCandle =
     candleRange > 0 and
     close < open and
     candleBody / candleRange >= 0.55

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MOMENTUM
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bullMomentum =
     rsi > bullRSI and
     rsi > rsi[1]

bearMomentum =
     rsi < bearRSI and
     rsi < rsi[1]

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BREAKOUT / RETEST
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bullBreakout =
     close > resistance[1] and
     strongVolume and
     close > open

bearBreakout =
     close < support[1] and
     strongVolume and
     close < open

bullRetest =
     low <= resistance[1] and
     close > resistance[1] and
     close > open

bearRetest =
     high >= support[1] and
     close < support[1] and
     close < open

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TRENDLINES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var line upTrendline = na
var line downTrendline = na

if showTrendlines

    if not na(lastLowBar) and not na(previousLowBar)

        if not na(upTrendline)
            line.delete(upTrendline)

        upTrendline := line.new(
             previousLowBar,
             previousLow,
             lastLowBar,
             lastLow,
             xloc=xloc.bar_index,
             extend=extend.right,
             color=color.green,
             style=line.style_dashed,
             width=2)

    if not na(lastHighBar) and not na(previousHighBar)

        if not na(downTrendline)
            line.delete(downTrendline)

        downTrendline := line.new(
             previousHighBar,
             previousHigh,
             lastHighBar,
             lastHigh,
             xloc=xloc.bar_index,
             extend=extend.right,
             color=color.red,
             style=line.style_dashed,
             width=2)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CONFLUENCE SCORE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

buyScore = 0

buyScore += smmaBull ? 15 : 0
buyScore += majorBull ? 10 : 0
buyScore += maBull ? 10 : 0
buyScore += bullStructure ? 15 : 0
buyScore += htfBullOK ? 10 : 0
buyScore += bullMomentum ? 10 : 0
buyScore += strongVolume ? 10 : 0
buyScore += nearDemand ? 10 : 0
buyScore += sellSideSweep ? 10 : 0
buyScore += (bullBreakout or bullRetest) ? 10 : 0
buyScore += bullCandle ? 5 : 0

sellScore = 0

sellScore += smmaBear ? 15 : 0
sellScore += majorBear ? 10 : 0
sellScore += maBear ? 10 : 0
sellScore += bearStructure ? 15 : 0
sellScore += htfBearOK ? 10 : 0
sellScore += bearMomentum ? 10 : 0
sellScore += strongVolume ? 10 : 0
sellScore += nearSupply ? 10 : 0
sellScore += buySideSweep ? 10 : 0
sellScore += (bearBreakout or bearRetest) ? 10 : 0
sellScore += bearCandle ? 5 : 0

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SIGNAL FILTER
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

structureBuyOK =
     not requireStructure or bullStructure

structureSellOK =
     not requireStructure or bearStructure

volumeBuyOK =
     not requireVolume or strongVolume

volumeSellOK =
     not requireVolume or strongVolume

candleBuyOK =
     not requireCandle or bullCandle

candleSellOK =
     not requireCandle or bearCandle

var int lastSignalBar = na

canSignal =
     na(lastSignalBar) or
     bar_index - lastSignalBar >= cooldown

precisionBuy =
     barstate.isconfirmed and
     canSignal and
     buyScore >= minimumScore and
     maBull and
     smmaBull and
     majorBull and
     htfBullOK and
     structureBuyOK and
     volumeBuyOK and
     candleBuyOK

precisionSell =
     barstate.isconfirmed and
     canSignal and
     sellScore >= minimumScore and
     maBear and
     smmaBear and
     majorBear and
     htfBearOK and
     structureSellOK and
     volumeSellOK and
     candleSellOK

if precisionBuy or precisionSell
    lastSignalBar := bar_index

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BEST BUY / SELL ZONES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bestBuy =
     nearDemand and
     smmaBull and
     maBull and
     bullMomentum and
     strongVolume and
     (sellSideSweep or bullRetest)

bestSell =
     nearSupply and
     smmaBear and
     maBear and
     bearMomentum and
     strongVolume and
     (buySideSweep or bearRetest)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SIGNAL PLOTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

plotshape(
     precisionBuy,
     title="CHAM ELITE BUY",
     style=shape.labelup,
     location=location.belowbar,
     text="CHAM\nBUY",
     color=color.lime,
     textcolor=color.black,
     size=size.normal)

plotshape(
     precisionSell,
     title="CHAM ELITE SELL",
     style=shape.labeldown,
     location=location.abovebar,
     text="CHAM\nSELL",
     color=color.red,
     textcolor=color.white,
     size=size.normal)

plotshape(
     bestBuy,
     title="BEST BUY ZONE",
     style=shape.diamond,
     location=location.belowbar,
     text="BEST BUY",
     color=color.aqua,
     textcolor=color.black,
     size=size.tiny)

plotshape(
     bestSell,
     title="BEST SELL ZONE",
     style=shape.diamond,
     location=location.abovebar,
     text="BEST SELL",
     color=color.orange,
     textcolor=color.black,
     size=size.tiny)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTRY / SL / TP
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var float entry = na
var float stop = na
var float tp1 = na
var float tp2 = na
var float tp3 = na

if precisionBuy

    entry := close
    stop := close - atr * stopATR

    risk = entry - stop

    tp1 := entry + risk * tp1RR
    tp2 := entry + risk * tp2RR
    tp3 := entry + risk * tp3RR

if precisionSell

    entry := close
    stop := close + atr * stopATR

    risk = stop - entry

    tp1 := entry - risk * tp1RR
    tp2 := entry - risk * tp2RR
    tp3 := entry - risk * tp3RR

plot(
     showRisk ? entry : na,
     "ENTRY",
     color=color.white,
     linewidth=2,
     style=plot.style_linebr)

plot(
     showRisk ? stop : na,
     "STOP LOSS",
     color=color.red,
     linewidth=2,
     style=plot.style_linebr)

plot(
     showRisk ? tp1 : na,
     "TP1",
     color=color.green,
     linewidth=1,
     style=plot.style_linebr)

plot(
     showRisk ? tp2 : na,
     "TP2",
     color=color.green,
     linewidth=2,
     style=plot.style_linebr)

plot(
     showRisk ? tp3 : na,
     "TP3",
     color=color.green,
     linewidth=1,
     style=plot.style_linebr)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MOVING AVERAGES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

plot(showMAs ? fastEMA : na, "Fast EMA", color=color.yellow, linewidth=2)
plot(showMAs ? slowEMA : na, "Slow EMA", color=color.fuchsia, linewidth=2)
plot(showMAs ? smma50 : na, "SMMA 50", color=color.aqua, linewidth=3)
plot(showMAs ? ema200 : na, "EMA 200", color=color.orange, linewidth=2)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TREND BACKGROUND
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bullEnvironment =
     htfBullOK and
     smmaBull and
     maBull and
     majorBull

bearEnvironment =
     htfBearOK and
     smmaBear and
     maBear and
     majorBear

bgcolor(
     showBackground ?
     bullEnvironment ? color.new(color.green, 94) :
     bearEnvironment ? color.new(color.red, 94) :
     na :
     na)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DASHBOARD
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var table dashboard =
     table.new(position.top_right, 2, 14, border_width=1)

if barstate.islast and showDashboard

    table.cell(
         dashboard, 0, 0,
         "CHAM TREND SYSTEM",
         text_color=color.white)

    table.cell(
         dashboard, 1, 0,
         "ELITE",
         text_color=color.white)

    table.cell(dashboard, 0, 1, "TREND")

    table.cell(
         dashboard, 1, 1,
         bullEnvironment ? "BULLISH" :
         bearEnvironment ? "BEARISH" :
         "MIXED")

    table.cell(dashboard, 0, 2, "MA")

    table.cell(
         dashboard, 1, 2,
         maBull ? "BULLISH" :
         maBear ? "BEARISH" :
         "MIXED")

    table.cell(dashboard, 0, 3, "SMMA 50")

    table.cell(
         dashboard, 1, 3,
         smmaBull ? "UP" :
         smmaBear ? "DOWN" :
         "FLAT")

    table.cell(dashboard, 0, 4, "HTF")

    table.cell(
         dashboard, 1, 4,
         htfBull ? "BULL" :
         htfBear ? "BEAR" :
         "MIXED")

    table.cell(dashboard, 0, 5, "STRUCTURE")

    table.cell(
         dashboard, 1, 5,
         bullStructure ? "HH + HL" :
         bearStructure ? "LH + LL" :
         "MIXED")

    table.cell(dashboard, 0, 6, "BUY SCORE")

    table.cell(
         dashboard, 1, 6,
         str.tostring(buyScore) + "/115")

    table.cell(dashboard, 0, 7, "SELL SCORE")

    table.cell(
         dashboard, 1, 7,
         str.tostring(sellScore) + "/115")

    table.cell(dashboard, 0, 8, "VOLUME")

    table.cell(
         dashboard, 1, 8,
         strongVolume ? "STRONG" : "NORMAL")

    table.cell(dashboard, 0, 9, "LIQUIDITY")

    table.cell(
         dashboard, 1, 9,
         sellSideSweep ? "SSL SWEPT" :
         buySideSweep ? "BSL SWEPT" :
         "NONE")

    table.cell(dashboard, 0, 10, "ZONE")

    table.cell(
         dashboard, 1, 10,
         nearDemand ? "DEMAND" :
         nearSupply ? "SUPPLY" :
         "NONE")

    table.cell(dashboard, 0, 11, "RSI")

    table.cell(
         dashboard, 1, 11,
         str.tostring(rsi, "#.0"))

    table.cell(dashboard, 0, 12, "SIGNAL")

    table.cell(
         dashboard, 1, 12,
         precisionBuy ? "BUY" :
         precisionSell ? "SELL" :
         bestBuy ? "BEST BUY" :
         bestSell ? "BEST SELL" :
         "WAIT")

    table.cell(dashboard, 0, 13, "STATUS")

    table.cell(
         dashboard, 1, 13,
         precisionBuy or precisionSell ?
         "CONFIRMED" :
         "WAIT")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ALERTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

alertcondition(
     precisionBuy,
     title="CHAM ELITE BUY",
     message="CHAM ELITE BUY | {{exchange}}:{{ticker}} | Price {{close}}")

alertcondition(
     precisionSell,
     title="CHAM ELITE SELL",
     message="CHAM ELITE SELL | {{exchange}}:{{ticker}} | Price {{close}}")

alertcondition(
     bestBuy,
     title="CHAM BEST BUY ZONE",
     message="CHAM BEST BUY ZONE | {{exchange}}:{{ticker}} | Price {{close}}")

alertcondition(
     bestSell,
     title="CHAM BEST SELL ZONE",
     message="CHAM BEST SELL ZONE | {{exchange}}:{{ticker}} | Price {{close}}")

alertcondition(
     bullCross,
     title="CHAM BULLISH MA CROSS",
     message="CHAM BULLISH MA CROSS | {{exchange}}:{{ticker}} | Price {{close}}")

alertcondition(
     bearCross,
     title="CHAM BEARISH MA CROSS",
     message="CHAM BEARISH MA CROSS | {{exchange}}:{{ticker}} | Price {{close}}")

alertcondition(
     bullBOS,
     title="CHAM BULLISH BOS",
     message="CHAM BULLISH BREAK OF STRUCTURE | {{exchange}}:{{ticker}} | Price {{close}}")

alertcondition(
     bearBOS,
     title="CHAM BEARISH BOS",
     message="CHAM BEARISH BREAK OF STRUCTURE | {{exchange}}:{{ticker}} | Price {{close}}")

alertcondition(
     sellSideSweep,
     title="CHAM SELL SIDE LIQUIDITY",
     message="CHAM SELL SIDE LIQUIDITY SWEEP | {{exchange}}:{{ticker}} | Price {{close}}")

alertcondition(
     buySideSweep,
     title="CHAM BUY SIDE LIQUIDITY",
     message="CHAM BUY SIDE LIQUIDITY SWEEP | {{exchange}}:{{ticker}} | Price {{close}}")