//@version=6
indicator(title = "AmberWaves SPY>SPX", shorttitle = "AmberWaves SPY>SPX", overlay = true, behind_chart = false)

// Generic symbol inputs
primarySymbol  = input.symbol("SPREADEX:SPX", "Primary Symbol")
oppositeSymbol = input.symbol("SPREADEX:SPY", "Opposite Symbol")

// Trend line settings
showTrendLine  = input.bool(true, "Show trend line")
trendLineColor = input.color(color.orange, "Trend line color")
trendLineWidth = input.int(2, "Trend line thickness", minval = 1, maxval = 5)
showCandles    = input.bool(false, "Show converted candles")

// Box settings
boxPosition    = input.string("Top Right", "Value box position", options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right", "Off"])
boxSize        = input.string("Normal", "Value box size", options = ["Tiny", "Small", "Normal", "Large", "Huge"])
boxBgColor     = input.color(color.new(color.black, 10), "Box background")
boxTextColor   = input.color(color.white, "Box text color")
boxBorderColor = input.color(color.new(color.gray, 20), "Box border color")

// Helpers
getTablePosition(pos) =>
    switch pos
        "Top Left" => position.top_left
        "Top Right" => position.top_right
        "Bottom Left" => position.bottom_left
        "Bottom Right" => position.bottom_right
        => position.top_right

getTextSize(sz) =>
    switch sz
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        "Huge" => size.huge
        => size.normal

getTickerName(symbolId) =>
    parts = str.split(symbolId, ":")
    array.size(parts) > 1 ? array.get(parts, 1) : symbolId

// Chart symbol identity
chartTickerId = syminfo.tickerid
chartTicker   = syminfo.ticker

primaryName   = getTickerName(primarySymbol)
oppositeName  = getTickerName(oppositeSymbol)

// Pull both datasets
pOpen  = request.security(primarySymbol, timeframe.period, open,  gaps = barmerge.gaps_off)
pHigh  = request.security(primarySymbol, timeframe.period, high,  gaps = barmerge.gaps_off)
pLow   = request.security(primarySymbol, timeframe.period, low,   gaps = barmerge.gaps_off)
pClose = request.security(primarySymbol, timeframe.period, close, gaps = barmerge.gaps_off)

oOpen  = request.security(oppositeSymbol, timeframe.period, open,  gaps = barmerge.gaps_off)
oHigh  = request.security(oppositeSymbol, timeframe.period, high,  gaps = barmerge.gaps_off)
oLow   = request.security(oppositeSymbol, timeframe.period, low,   gaps = barmerge.gaps_off)
oClose = request.security(oppositeSymbol, timeframe.period, close, gaps = barmerge.gaps_off)

// Generic conversion:
// If chart is primary, convert opposite into primary space.
// If chart is opposite, convert primary into opposite space.
isPrimaryChart = chartTicker == primaryName
isOppositeChart = chartTicker == oppositeName

float convOpen = na
float convHigh = na
float convLow = na
float convClose = na

float rawOtherValue = na
string rawOtherLabel = ""

if isPrimaryChart
    ratio = pClose / oClose
    convOpen := oOpen * ratio
    convHigh := oHigh * ratio
    convLow := oLow * ratio
    convClose := oClose * ratio
    rawOtherValue := oClose
    rawOtherLabel := oppositeName
else if isOppositeChart
    ratio = oClose / pClose
    convOpen := pOpen * ratio
    convHigh := pHigh * ratio
    convLow := pLow * ratio
    convClose := pClose * ratio
    rawOtherValue := pClose
    rawOtherLabel := primaryName

// Plot converted line
plot(showTrendLine ? convClose : na, title = "Converted line", color = trendLineColor, linewidth = trendLineWidth)

// Optional converted candles
plotcandle(
     showCandles ? convOpen : na,
     showCandles ? convHigh : na,
     showCandles ? convLow : na,
     showCandles ? convClose : na,
     title = "Converted Candles",
     color = convClose >= convOpen ? color.new(color.green, 65) : color.new(color.red, 65),
     wickcolor = color.new(color.gray, 40),
     bordercolor = color.new(color.gray, 40)
)

// Fixed box text: raw live value of the other selected symbol
string boxText = ""
if isPrimaryChart or isOppositeChart
    boxText := rawOtherLabel + "\n" + str.tostring(rawOtherValue, format.mintick)
else
    boxText := "Chart must be\n" + primaryName + " or " + oppositeName

// Persistent table
var table valueBox = table.new(position.top_right, 1, 1, border_width = 1)

if barstate.islast
    table.set_position(valueBox, getTablePosition(boxPosition))
    table.cell(
         valueBox,
         0,
         0,
         boxPosition == "Off" ? "" : boxText,
         text_color = boxPosition == "Off" ? color.new(boxTextColor, 100) : boxTextColor,
         bgcolor = boxPosition == "Off" ? color.new(boxBgColor, 100) : boxBgColor,
         text_size = getTextSize(boxSize)
     )