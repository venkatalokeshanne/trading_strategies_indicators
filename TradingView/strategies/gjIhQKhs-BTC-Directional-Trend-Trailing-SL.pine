//@version=6
strategy("BTC Directional Trend + Trailing SL", overlay=true, initial_capital=5000, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// Inputs
emaTrendLen = input.int(200, "Trend EMA")
emaEntryLen = input.int(20, "Entry EMA")
atrLen = input.int(14, "ATR Length")
atrMultiplier = input.float(2.0, "ATR Trailing Multiplier")

// Indicators
emaTrend = ta.ema(close, emaTrendLen)
emaEntry = ta.ema(close, emaEntryLen)
atr = ta.atr(atrLen)

// Conditions
uptrend = close > emaTrend
downtrend = close < emaTrend

longCondition = uptrend and ta.crossover(close, emaEntry)
shortCondition = downtrend and ta.crossunder(close, emaEntry)

// Entries
if longCondition
    strategy.entry("Long", strategy.long)

if shortCondition
    strategy.entry("Short", strategy.short)

// Trailing Stop using ATR
longStop = close - (atr * atrMultiplier)
shortStop = close + (atr * atrMultiplier)

// Exit logic (trailing)
strategy.exit("Long Exit", from_entry="Long", trail_points=atr * atrMultiplier, trail_offset=atr)
strategy.exit("Short Exit", from_entry="Short", trail_points=atr * atrMultiplier, trail_offset=atr)

// Plot
plot(emaTrend, color=color.blue, title="EMA 200")
plot(emaEntry, color=color.orange, title="EMA 20")