// https://mozilla.org/MPL/2.0/
//
// Original ZigZag++ by DevLucem
// Original ZigZag logic/library: DevLucem/ZigLib
//
// Modified and enhanced version:
// - Pine Script v6 conversion
// - Pip distance measurement
// - Candle count between swing points
// - Swing-based Stop Loss line
// - Additional visual/customisation improvements

indicator(
    "Advanced Swing Structure - Pips, Candles & SL",
    "Advanced Swing Structure",
    overlay = true,
    format = format.price,
    max_labels_count = 200,
    max_lines_count = 50
)
// ============================================================================
// INPUTS
// ============================================================================

Depth = input.int(
     12,
     "Depth",
     minval = 1,
     step = 1,
     group = "ZigZag Config"
)

Deviation = input.int(
     5,
     "Deviation",
     minval = 1,
     step = 1,
     group = "ZigZag Config"
)

Backstep = input.int(
     2,
     "Backstep",
     minval = 2,
     step = 1,
     group = "ZigZag Config"
)

line_thick = input.int(
     2,
     "Line Thickness",
     minval = 1,
     maxval = 4,
     group = "Lines"
)

labels = input.int(
     0,
     "Labels Transparency",
     minval = 0,
     maxval = 100,
     group = "Labels"
)

upcolor = input.color(
     color.lime,
     "Bull Color",
     group = "Colors"
)

dncolor = input.color(
     color.red,
     "Bear Color",
     group = "Colors"
)

lines = input.int(
     0,
     "Lines Transparency",
     minval = 0,
     maxval = 100,
     group = "Lines"
)

background = input.int(
     80,
     "Background Transparency",
     minval = 0,
     maxval = 100,
     group = "Colors"
)

labelSizeInput = input.int(
     3,
     "Label Size",
     minval = 1,
     maxval = 5,
     group = "Labels"
)

label_size = switch labelSizeInput
    1 => size.tiny
    2 => size.small
    3 => size.normal
    4 => size.large
    5 => size.huge

repaint = input.bool(
     true,
     "Repaint Levels"
)

extend = input.bool(
     false,
     "Extend ZigZag",
     group = "Lines"
)

// ============================================================================
// STOP LOSS INPUTS
// ============================================================================

groupSL = "Stop Loss from Swing"

showSL = input.bool(
     true,
     "Show SL line",
     group = groupSL
)

slPips = input.float(
     1.0,
     "SL offset (pips)",
     step = 0.1,
     group = groupSL
)

ticksPerPip = input.int(
     10,
     "Ticks per pip",
     minval = 1,
     group = groupSL
)

slColor = input.color(
     color.new(color.orange, 0),
     "SL line color",
     group = groupSL
)

slWidth = input.int(
     2,
     "SL line width",
     minval = 1,
     maxval = 4,
     group = groupSL
)

// ============================================================================
// CUSTOM ZIGZAG FUNCTION
// ============================================================================

zigzag(float _low, float _high, int depth, int deviation, int backstep) =>

    hr = ta.barssince(
         not (
             _high[-ta.highestbars(depth)] - _high >
             deviation * syminfo.mintick
         )[1]
    )

    lr = ta.barssince(
         not (
             _low - _low[-ta.lowestbars(depth)] >
             deviation * syminfo.mintick
         )[1]
    )

    direction = ta.barssince(not (hr > lr)) >= backstep ? -1 : 1

    var chart.point z  = chart.point.now(_low)
    var chart.point z1 = chart.point.now(_low)
    var chart.point z2 = chart.point.now(_high)

    var int z1BarIndex = na
    var int z2BarIndex = na

    // Pine v6 requires explicit boolean comparison.
    if ta.change(direction) != 0
        z1 := z2.copy()
        z1BarIndex := z2BarIndex

        z2 := z.copy()
        z2BarIndex := bar_index

    // Bullish direction.
    if direction > 0

        if _high > z2.price
            z2 := chart.point.now(_high)
            z2BarIndex := bar_index
            z := chart.point.now(_low)

        if _low < z.price
            z := chart.point.now(_low)

    // Bearish direction.
    if direction < 0

        if _low < z2.price
            z2 := chart.point.now(_low)
            z2BarIndex := bar_index
            z := chart.point.now(_high)

        if _high > z.price
            z := chart.point.now(_high)

    [direction, z1, z2, z1BarIndex, z2BarIndex]

// ============================================================================
// FETCH ZIGZAG DATA
// ============================================================================

[direction, z1, z2, z1BarIndex, z2BarIndex] =
     zigzag(low, high, Depth, Deviation, Backstep)

// ============================================================================
// SWING DATA
// ============================================================================

var float lastPrice = na
var int lastBarIndex = na
var int candleCount = na
var float pipDifference = na
var string nowPoint = na

// ============================================================================
// CALCULATE PIP DIFFERENCE / CANDLE COUNT / SWING TYPE
// ============================================================================

if not na(z2.price) and not na(z1.price)

    pipDifference :=
         math.abs(z2.price - z1.price) /
         syminfo.mintick

    if not na(lastBarIndex)
        candleCount := z2BarIndex - lastBarIndex
    else
        candleCount := 0

    lastPrice := z1.price
    lastBarIndex := z1BarIndex

    nowPoint :=
         direction < 0 ?
         (z2.price < lastPrice ? "LL" : "HL") :
         (z2.price > lastPrice ? "HH" : "LH")

// ============================================================================
// ZIGZAG LINES AND LABELS
// ============================================================================

line zz = na
label point = na

if repaint

    zz := line.new(
         z1,
         z2,
         xloc.bar_time,
         extend ? extend.right : extend.none,
         color.new(
             direction > 0 ? upcolor : dncolor,
             lines
         ),
         width = line_thick
    )

    string labelText =
         nowPoint +
         "\nPips: " +
         str.tostring(pipDifference / 10, "#.##") +
         "\nCandles: " +
         str.tostring(candleCount)

    point := label.new(
         z2,
         labelText,
         xloc.bar_time,
         yloc.price,
         color.new(
             direction < 0 ? upcolor : dncolor,
             labels
         ),
         direction > 0 ?
             label.style_label_down :
             label.style_label_up,
         color.new(
             direction > 0 ? upcolor : dncolor,
             labels
         ),
         label_size
    )

    if direction == direction[1]

        line.delete(zz[1])
        label.delete(point[1])

    else

        line.set_extend(
             zz[1],
             extend.none
        )

else

    if direction != direction[1]

        zz := line.new(
             z1[1],
             z2[1],
             xloc.bar_time,
             extend.none,
             color.new(
                 direction > 0 ? upcolor : dncolor,
                 lines
             ),
             width = line_thick
        )

        string labelText =
             nowPoint +
             "\nPips: " +
             str.tostring(pipDifference, "#.##") +
             "\nCandles: " +
             str.tostring(candleCount)

        point := label.new(
             z2[1],
             labelText,
             xloc.bar_time,
             yloc.price,
             color.new(
                 direction[1] < 0 ? upcolor : dncolor,
                 labels
             ),
             direction[1] > 0 ?
                 label.style_label_down :
                 label.style_label_up,
             color.new(
                 direction[1] > 0 ? upcolor : dncolor,
                 labels
             ),
             label_size
        )

// ============================================================================
// DIRECTION DISPLAY
// ============================================================================

bgcolor(
     direction < 0 ?
         color.new(dncolor, background) :
         color.new(upcolor, background),
     title = "Direction Background"
)

plotarrow(
     direction,
     "direction",
     display = display.status_line
)

// ============================================================================
// STOP LOSS LINE
// ============================================================================

var line slLine = na
var int slRefBar = na

slOffset =
     slPips *
     ticksPerPip *
     syminfo.mintick

// Use the last confirmed opposite swing (z1)
// as the stop-loss reference.

haveRef =
     showSL and
     not na(z1BarIndex) and
     not na(z1.price)

slPrice =
     haveRef ?
         (
             direction > 0 ?
                 z1.price - slOffset :
                 z1.price + slOffset
         ) :
         na

if haveRef

    // Create a new SL line whenever the
    // reference swing changes.

    if na(slLine) or z1BarIndex != slRefBar

        if not na(slLine)
            line.delete(slLine)

        slLine := line.new(
             x1 = z1BarIndex,
             y1 = slPrice,
             x2 = bar_index,
             y2 = slPrice,
             xloc = xloc.bar_index,
             extend = extend.right,
             color = slColor,
             width = slWidth
        )

        slRefBar := z1BarIndex

    else

        // Keep the SL horizontal and update it
        // if the SL offset inputs change.

        line.set_y1(
             slLine,
             slPrice
        )

        line.set_y2(
             slLine,
             slPrice
        )

else

    // Remove SL line if disabled or if
    // no valid swing reference exists.

    if not na(slLine)

        line.delete(slLine)

        slLine := na
        slRefBar := na

