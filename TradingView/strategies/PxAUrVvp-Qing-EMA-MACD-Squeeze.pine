//@version=6

strategy("Qing EMA + MACD + Squeeze)", overlay=true, default_qty_type=strategy.cash, default_qty_value=1000, calc_on_every_tick=true, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.1)



// =========================================================================

// 1. EMA Visualization and Table (KEPT INTACT)

// =========================================================================



// Input options for EMAs

veryshort_period = input.int(6, title="Very Short EMA (6) Period", minval=1)

shortest_period = input.int(12, title="Shortest EMA (12) Period", minval=1)

short_period = input.int(20, title="Short EMA (20) Period", minval=1) // Yellow/Trigger

long_period = input.int(50, title="Long EMA (50) Period", minval=1) // Blue/Target

longer_period = input.int(100, title="Longer EMA (100) Period", minval=1)

longest_period = input.int(200, title="Longest EMA (200) Period", minval=1) // Red/Trend



// Color settings for EMAs

veryshort_color = input.color(color.rgb(254, 254, 254), title="Very Short EMA Color") // White

shortest_color = input.color(color.orange, title="Shortest EMA Color") // Orange

short_color = input.color(color.yellow, title="Short EMA Color") // Yellow

long_color = input.color(color.rgb(39, 114, 176), title="Long EMA Color") // Blue

longer_color = input.color(color.rgb(9, 223, 252), title="Longer EMA Color")

longest_color = input.color(color.red, title="Longest EMA Color") // Red



// EMA calculations

veryshort = ta.ema(close, veryshort_period)

shortest = ta.ema(close, shortest_period)

short = ta.ema(close, short_period)

long = ta.ema(close, long_period)

longer = ta.ema(close, longer_period)

longest = ta.ema(close, longest_period)



// Plot EMAs

plot(veryshort, title="Very Short EMA (6)", color=veryshort_color, linewidth=1)

plot(shortest, title="Shortest EMA (12)", color=shortest_color, linewidth=1)

plot(short, title="Short EMA (20)", color=short_color, linewidth=2) // Thicker for trigger visibility

plot(long, title="Long EMA (50)", color=long_color, linewidth=2)

plot(longer, title="Longer EMA (100)", color=longer_color, linewidth=1)

plot(longest, title="Longest EMA (200)", color=longest_color, linewidth=2)



// --- EMA 20 Gap Label (KEPT INTACT) ---

ema20 = short // Using 'short' variable

gapPercentage = ema20 != 0 ? ((close - ema20) / ema20) * 100 : 0

var label gap_label = na

label.delete(gap_label[1]) 

if not na(ema20)

    var color bg_color_val = color.gray 

    bg_color_val := gapPercentage > 0 ? color.rgb(252, 0, 0) : gapPercentage < 0 ? color.green : color.gray

    y_position = close 

    gap_label := label.new(x=bar_index + 2, y=y_position, text=str.tostring(gapPercentage, "#.##") + "%", textcolor=color.white, color=bg_color_val, style=label.style_label_left, size=size.normal, tooltip="Gap between Close and EMA 20")



// --- EMA Value Table (KEPT INTACT) ---

table_horizontal_position = input.string("Right", title="Table Horizontal Position", options=["Left", "Right"])

table_vertical_position = input.string("Top", title="Table Vertical Position", options=["Top", "Center", "Bottom"])

label_position = position.top_right

if table_horizontal_position == "Left" and table_vertical_position == "Top"

    label_position := position.top_left

else if table_horizontal_position == "Right" and table_vertical_position == "Top"

    label_position := position.top_right

else if table_horizontal_position == "Left" and table_vertical_position == "Center"

    label_position := position.middle_left

else if table_horizontal_position == "Right" and table_vertical_position == "Center"

    label_position := position.middle_right

else if table_horizontal_position == "Left" and table_vertical_position == "Bottom"

    label_position := position.bottom_left

else if table_horizontal_position == "Right" and table_vertical_position == "Bottom"

    label_position := position.bottom_right



var table ema_table = table.new(position=label_position, columns=2, rows=7, border_color=color.gray, border_width=1)

font_size = input.string("small", title="Font Size", options=["tiny", "small", "normal", "large", "huge"])

header_text_color = input.color(color.white, title="Header Text Color")



if bar_index == 0

    table.cell(ema_table, 0, 0, "EMA Period", text_color=header_text_color, text_size=font_size)

    table.cell(ema_table, 1, 0, "EMA Value", text_color=header_text_color, text_size=font_size)



table.cell(ema_table, 0, 1, "Very Short EMA (" + str.tostring(veryshort_period) + ")", text_color=veryshort_color, text_size=font_size)

table.cell(ema_table, 1, 1, str.tostring(veryshort, format.mintick), text_color=veryshort_color, text_size=font_size)

table.cell(ema_table, 0, 2, "Shortest EMA (" + str.tostring(shortest_period) + ")", text_color=shortest_color, text_size=font_size)

table.cell(ema_table, 1, 2, str.tostring(shortest, format.mintick), text_color=shortest_color, text_size=font_size)

table.cell(ema_table, 0, 3, "Short EMA (" + str.tostring(short_period) + ")", text_color=short_color, text_size=font_size)

table.cell(ema_table, 1, 3, str.tostring(short, format.mintick), text_color=short_color, text_size=font_size)

table.cell(ema_table, 0, 4, "Long EMA (" + str.tostring(long_period) + ")", text_color=long_color, text_size=font_size)

table.cell(ema_table, 1, 4, str.tostring(long, format.mintick), text_color=long_color, text_size=font_size)

table.cell(ema_table, 0, 5, "Longer EMA (" + str.tostring(longer_period) + ")", text_color=longer_color, text_size=font_size)

table.cell(ema_table, 1, 5, str.tostring(longer, format.mintick), text_color=longer_color, text_size=font_size)

table.cell(ema_table, 0, 6, "Longest EMA (" + str.tostring(longest_period) + ")", text_color=longest_color, text_size=font_size)

table.cell(ema_table, 1, 6, str.tostring(longest, format.mintick), text_color=longest_color, text_size=font_size)





// =========================================================================

// 2. MACD Calculation (for Strategy Signal)

// =========================================================================

fast = input.int(6, 'MACD Fast Length', minval = 2, group = 'MACD')

slow = input.int(14, 'MACD Slow Length', minval = 2, group = 'MACD')

sigLen = input.int(8, 'MACD Signal Length', minval = 2, group = 'MACD')



// MACD Calculations

[macd_val, signal_val, _] = ta.macd(close, fast, slow, sigLen)



macd_crossover_up = ta.crossover(macd_val, signal_val)

macd_crossover_down = ta.crossunder(macd_val, signal_val)





// =========================================================================

// 3. Trading Strategy Logic (Qing Refinements)

// =========================================================================



// --- Refinement: Squeeze Setup Inputs (The Setup) ---

group_setup = "Qing Squeeze Setup"

squeeze_thresh_pct = input.float(0.75, "Squeeze Tightness %", minval=0.1, step=0.05, group=group_setup, tooltip="Max distance (in %) allowed between EMA 6, 12, 20.")

flat_check_bars = input.int(10, "Flatness Lookback Bars", minval=1, group=group_setup, tooltip="How many bars to check for 'flat' EMA 20 movement.")



// --- Refinement: Volume Spike Input (The Trigger) ---

vol_mult = input.float(1.5, "Volume Spike Multiplier", minval=1.0, step=0.1, group="Entry Filters", tooltip="Volume must be x times the 20-bar average.")

vol_avg_len = input.int(20, "Volume Avg Length", minval=1, group="Entry Filters")



// --- Existing User Inputs for Trading Logic ---

sma_short = input.int(10, "Trend Filter Short SMA Length", minval=1, group="Entry Filters")

sma_long = input.int(50, "Trend Filter Long SMA Length", minval=1, group="Entry Filters")

higher_tf = input.timeframe("D", "Higher Timeframe", group="Entry Filters")

use_higher_tf = input.bool(false, "Use Higher Timeframe Filter?", group="Entry Filters")

sma_short_tf = input.int(10, "Higher TF Short SMA", minval=1, group="Entry Filters")

sma_long_tf = input.int(50, "Higher TF Long SMA", minval=1, group="Entry Filters")

cooldown_bars = input.int(5, "Cooldown Bars Between Trades", minval=1, group="Entry Filters")

rsi_period = input.int(14, "RSI Period", minval=1, group="Entry Filters")

rsi_bullish_threshold = input.int(55, "RSI Bullish Filter (e.g., >55)", minval=50, maxval=100, group="Entry Filters")

rsi_bearish_threshold = input.int(45, "RSI Bearish Filter (e.g., <45)", minval=0, maxval=50, group="Entry Filters")



// CRITICAL FIX: Position Sizing and ATR Risk Management

atr_period = input.int(10, "ATR Risk Period", minval=1, group="Risk Management")

stop_loss_atr_factor = input.float(1.2, "ATR Stop Multiplier (1.2)", minval=0.1, step=0.1, group="Risk Management")

take_profit_atr_factor = input.float(2.5, "ATR TP Multiplier (2.5)", minval=0.1, step=0.1, group="Risk Management")

max_risk_pct = input.float(1.0, "Max Risk per Trade (%)", minval=0.1, step=0.1, group="Risk Management") / 100

allow_shorts = input.bool(false, "Allow Short Trades?", group="Trade Control")

use_signal_exit = input.bool(true, "Use Signal Crossover for Exit?", group="Trade Control", tooltip="If true, counter SMA crossover will close the trade, ignoring the ATR TP/SL orders.")





// Trend/Filter Calculations

sma_short_val = ta.sma(close, sma_short)

sma_long_val = ta.sma(close, sma_long)



// Higher Timeframe Trend Filter

sma_short_higher = request.security(syminfo.tickerid, higher_tf, ta.sma(close, sma_short_tf), lookahead=barmerge.lookahead_off)

sma_long_higher = request.security(syminfo.tickerid, higher_tf, ta.sma(close, sma_long_tf), lookahead=barmerge.lookahead_off)

trend_up_higher = sma_short_higher > sma_long_higher

trend_down_higher = sma_short_higher < sma_long_higher

mtf_bias = use_higher_tf ? trend_up_higher : true

mtf_bias_short = use_higher_tf ? trend_down_higher : true



// Momentum Filter (RSI)

rsi = ta.rsi(close, rsi_period)

rsi_bullish = rsi > rsi_bullish_threshold

rsi_bearish = rsi < rsi_bearish_threshold



// Cooldown Logic

var float last_trade_close_bar = na

trade_closed_this_bar = strategy.opentrades == 0 and strategy.opentrades[1] != 0

if (trade_closed_this_bar)

    last_trade_close_bar := bar_index



can_trade = na(last_trade_close_bar) or (bar_index - last_trade_close_bar >= cooldown_bars)



// --- SQUEEZE LOGIC (QING SETUP) ---

// 1. Calculate the spread of the short EMAs (6, 12, 20)

max_short_ema = math.max(veryshort, shortest, short)

min_short_ema = math.min(veryshort, shortest, short)

squeeze_percent_spread = ((max_short_ema - min_short_ema) / close) * 100



// 2. Squeeze Condition

bool is_squeezed = squeeze_percent_spread < squeeze_thresh_pct



// 3. Flat/Tangled Condition

float ema20_change = math.abs(short - short[flat_check_bars]) / short * 100

bool is_flat = ema20_change < 0.2

bool the_squeeze_setup = is_squeezed and is_flat



// --- TRIGGER LOGIC (QING BREAKOUT) ---

// 1. Price Reclaims EMA 20 (Yellow) - candle opens below or near, closes above.

bool price_reclaims_ema20 = close > short and close[1] <= short[1]



// 2. Volume Spike

float vol_avg = ta.sma(volume, vol_avg_len)

bool vol_spike = volume > (vol_avg * vol_mult)



// 3. Context: Counter-trend/Bottom Fishing (Price is below 50 and 200 EMAs)

bool context_counter_trend = close < long and close < longest

bool context_counter_trend_short = close > long and close > longest





// New Primary Entry Signals (Full Qing Strategy)

// The Squeeze must be present in the previous bar for the breakout to be valid.

enterLongCondition = macd_crossover_up and can_trade and strategy.opentrades == 0



// Short entry is the inverse for trend continuation (since the original Qing is bottom fishing)

enterShortCondition = 

     context_counter_trend_short and // Price is above 50/200, targeting downtrend continuation

     ta.crossunder(veryshort, shortest) and // Simple reversal trigger for short

     macd_crossover_down and 

     can_trade and 

     strategy.opentrades == 0 and 

     mtf_bias_short and 

     rsi_bearish and 

     allow_shorts





// Exit Conditions (Signal-based - uses the slower SMA cross for a strong trend change confirmation)

exitSignalLong = ta.crossunder(sma_short_val, sma_long_val)

exitSignalShort = ta.crossover(sma_short_val, sma_long_val)



// --- CRITICAL FIX: Dynamic Risk-Based Position Sizing (Using ATR) ---

a_tr = ta.atr(atr_period)

// Calculate stop distance in dollars using ATR

atr_stop_distance = a_tr * stop_loss_atr_factor

// Calculate dollar amount risked per trade

max_dollar_risk = strategy.equity * max_risk_pct

// Calculate the quantity to buy/sell based on maximum risk and stop distance

// Added safety check for zero stop distance

qty = atr_stop_distance > 0 ? max_dollar_risk / atr_stop_distance : 1

qty := math.max(1, qty) // Ensure a minimum quantity of 1



// === Execute Trades ===



// Long Entry

if (enterLongCondition)

    long_sl_price = close - atr_stop_distance

    long_tp_price = close + atr_stop_distance * take_profit_atr_factor



    strategy.entry("Long", strategy.long, qty=qty)

    

    // Use strategy.exit only if signal exit is NOT desired

    if not use_signal_exit

        strategy.exit("Long Exit TP/SL", "Long", stop=long_sl_price, limit=long_tp_price, comment="TP/SL Exit Long")



// Long Exit (Signal based)

if (use_signal_exit and exitSignalLong and strategy.position_size > 0)

    strategy.close("Long", comment="Signal Exit Long (SMA Cross)")



// Short Entry

if (enterShortCondition)

    short_sl_price = close + atr_stop_distance

    short_tp_price = close - atr_stop_distance * take_profit_atr_factor

    

    strategy.entry("Short", strategy.short, qty=qty)



    // Use strategy.exit only if signal exit is NOT desired

    if not use_signal_exit

        strategy.exit("Short Exit TP/SL", "Short", stop=short_sl_price, limit=short_tp_price, comment="TP/SL Exit Short")



// Short Exit (Signal based)

if (use_signal_exit and exitSignalShort and strategy.position_size < 0)

    strategy.close("Short", comment="Signal Exit Short (SMA Cross)")





// =========================================================================

// 4. Visualization (Plotting setup areas)

// =========================================================================

// Highlight Squeeze Setup

bgcolor(the_squeeze_setup ? color.new(color.yellow, 85) : na, title="EMA Squeeze Zone")

// Plot Volume Spike

plotshape(vol_spike and price_reclaims_ema20, location=location.belowbar, style=shape.triangleup, color=color.green, size=size.small, title="Volume Trigger")



// ==========================================

// REFERENCE LINE SCRIPT (Optimized)

// ==========================================



// 1. Inputs (RENAMED TO AVOID CONFLICTS)

fast_ref = input.int(6, 'Fast Length', minval = 2, group = 'Reference Line')

slow_ref = input.int(15, 'Slow Length', minval = 2, group = 'Reference Line')

sigLen_ref = input.int(8, 'Signal Length', minval = 2, group = 'Reference Line')

trend = input.string('MACD - Signal', 'Trend Determination', options = ['MACD', 'MACD - Signal'], group = 'Reference Line')



// 2. Colors

refLineColor = input.color(color.rgb(253, 254, 255, 43), title="Reference Line Color", group = 'Style')

signalArea = input.bool(true, 'Show Background Fill', group = 'Style')

signalBull = input(color.new(#089981, 85), 'Bullish Fill', group = 'Style')

signalBear = input(color.new(#f23645, 85), 'Bearish Fill', group = 'Style')



// 3. Calculations (USING RENAMED VARIABLES)

[macd_ref, signal_ref, _] = ta.macd(close, fast_ref, slow_ref, sigLen_ref)



// Determine Trend

uptrend = trend == 'MACD' ? macd_ref > 0 : macd_ref > signal_ref

downtrend = trend == 'MACD' ? macd_ref < 0 : macd_ref < signal_ref



// Calculate the Reference Price (The Step Line)

var uptrend_init_price = close

var downtrend_init_price = close



// Reset the price when the trend flips

uptrend_init_price := uptrend and not uptrend[1] ? close : uptrend_init_price

downtrend_init_price := downtrend and not downtrend[1] ? close : downtrend_init_price



// Select which price to use

init_value = uptrend ? uptrend_init_price : downtrend_init_price



// 4. Plotting (FIXED: SPLIT PLOTS TO STOP VERTICAL CONNECTION)

// We split the line into two separate plots. When the trend changes, one line ends (na) and the other begins.

// 'style=plot.style_linebr' prevents the script from drawing a vertical line between the disconnected points.

up_plot = plot(uptrend ? init_value : na, "Ref Price Up", color=refLineColor, style=plot.style_linebr, linewidth=2)

dn_plot = plot(downtrend ? init_value : na, "Ref Price Down", color=refLineColor, style=plot.style_linebr, linewidth=2)



// Price Plot for filling

price_plot = plot(close, editable=false, display=display.none)



// Background Fill (Adapted for split plots)

// When Uptrend (Price > Ref), fill Green.

// When Downtrend (Ref > Price), fill Red.

fill(price_plot, up_plot, top_color=signalBull, bottom_color=color.new(chart.bg_color, 100), title="Bullish Fill")

fill(dn_plot, price_plot, top_color=color.new(chart.bg_color, 100), bottom_color=signalBear, title="Bearish Fill")