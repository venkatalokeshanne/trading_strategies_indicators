// © JayR111886
//
// Money Crab — a crab hauling a bag of money with dollars spilling out,
// drawn entirely from Pine drawings, walking in the open space right of price.
//
// v7: design pass driven by an on-chart screenshot — 16-point smooth shell
// with a smile, eyes seated on their stalks, rounded two-lobe claws, shorter
// thicker legs, a classic round money bag with cinched knot held IN the claw,
// and bills drawn as green notes (capsule + $) spilling from the bag.

//@version=6
indicator("Money Crab", shorttitle = "MONEY CRAB", overlay = true, max_lines_count = 150, max_labels_count = 80, max_polylines_count = 20)

sizeMult  = input.float(0.6, "Crab size (ATR mult)", minval = 0.2, maxval = 5.0, step = 0.1)
offBars   = input.int(12, "Distance right of price (bars)", minval = 5, maxval = 200)
swayBars  = input.int(6, "Walk range (bars)", minval = 2, maxval = 50)
ticksPerStep = input.int(2, "Ticks per step", minval = 1, maxval = 50,
     tooltip = "Updates between steps. Live markets tick several times a second; raise to slow the crab down.")
dropMoney = input.bool(true, "Leave dollars on the ground")
dropEvery = input.int(6, "Drop every N bars", minval = 1, maxval = 100)
keepDrops = input.int(6, "Bills kept on chart", minval = 1, maxval = 15)
crabColor = input.color(#d94f3d, "Crab color")
bagColor  = input.color(#c9a86a, "Bag color")
billColor = input.color(#2ecc71, "Money color")

atr14 = ta.atr(14)
baseY = ta.ema(close, 20)

shellDark  = color.rgb(color.r(crabColor) * 0.70, color.g(crabColor) * 0.70, color.b(crabColor) * 0.70)
shellLight = color.rgb(math.min(255, color.r(crabColor) * 1.30), math.min(255, color.g(crabColor) * 1.30), math.min(255, color.b(crabColor) * 1.30))
bagDark    = color.rgb(color.r(bagColor) * 0.60, color.g(bagColor) * 0.60, color.b(bagColor) * 0.60)
billDark   = color.rgb(color.r(billColor) * 0.45, color.g(billColor) * 0.45, color.b(billColor) * 0.45)

var line[] crabLines = array.new<line>()
var label[] crabDots = array.new<label>()
var polyline[] crabPolys = array.new<polyline>()
var line[] moneyLines = array.new<line>()
var label[] moneyLbls = array.new<label>()

f_clear() =>
    while array.size(crabLines) > 0
        line.delete(array.pop(crabLines))
    while array.size(crabDots) > 0
        label.delete(array.pop(crabDots))
    while array.size(crabPolys) > 0
        polyline.delete(array.pop(crabPolys))

f_cap(int x1, float y1, int x2, float y2, color c, int w) =>
    array.push(crabLines, line.new(x1, y1, x2, y2, xloc = xloc.bar_index, color = c, width = w))

f_dot(int x, float y, color c, string sz) =>
    array.push(crabDots, label.new(x, y, "", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_circle,
         color = c, size = sz == "tiny" ? size.tiny : sz == "small" ? size.small : size.normal))

f_txt(int x, float y, string s, color c, string sz) =>
    array.push(crabDots, label.new(x, y, s, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none,
         textcolor = c, size = sz == "large" ? size.large : sz == "small" ? size.small : sz == "tiny" ? size.tiny : size.normal))

// a dollar note: green capsule with a dark $ on it
f_bill(int x, float y) =>
    f_cap(x, y, x + 1, y, billColor, 6)
    f_txt(x, y, "  $", billDark, "tiny")

// ticks: once per bar on history, once per update live — real-time walking
varip int ticks = 0
ticks := ticks + 1

if barstate.islast
    f_clear()
    float u = nz(atr14, syminfo.mintick * 100) * sizeMult
    int step = int(ticks / ticksPerStep)
    int t = step % (2 * swayBars)
    int sway = t < swayBars ? t : 2 * swayBars - t
    int ax = bar_index + offBars + sway
    float ay = baseY
    float ground = ay - 1.85 * u

    // soft shadow under the feet
    f_cap(ax - 3, ground, ax + 3, ground, color.new(color.gray, 80), 5)

    // legs — three per side, two joints, short and sturdy, alternating stride
    for i = 0 to 2
        int phase = (step + i) % 2
        int hipL = ax - 1 - i
        int hipR = ax + 1 + i
        int kneeL = hipL - 1
        int kneeR = hipR + 1
        int footL = kneeL - (phase == 0 ? 1 : 0)
        int footR = kneeR + (phase == 0 ? 0 : 1)
        f_cap(hipL, ay - 0.50 * u, kneeL, ay - 1.15 * u, shellDark, 4)
        f_cap(kneeL, ay - 1.15 * u, footL, ay - 1.70 * u, shellDark, 3)
        f_cap(hipR, ay - 0.50 * u, kneeR, ay - 1.15 * u, shellDark, 4)
        f_cap(kneeR, ay - 1.15 * u, footR, ay - 1.70 * u, shellDark, 3)

    // arms with rounded two-lobe claws
    f_cap(ax - 3, ay + 0.20 * u, ax - 5, ay + 0.80 * u, crabColor, 5)
    f_dot(ax - 5, ay + 0.85 * u, crabColor, "small")
    f_dot(ax - 6, ay + 1.05 * u, crabColor, "tiny")
    f_cap(ax + 3, ay + 0.20 * u, ax + 5, ay + 0.80 * u, crabColor, 5)
    f_dot(ax + 5, ay + 0.85 * u, crabColor, "small")
    f_dot(ax + 6, ay + 1.05 * u, crabColor, "tiny")

    // shell — 16-point smooth filled ellipse + highlight + smile
    shellPts = array.new<chart.point>()
    for a = 0 to 15
        float ang = a * math.pi / 8.0
        array.push(shellPts, chart.point.from_index(ax + int(math.round(3.5 * math.cos(ang))), ay + 0.85 * u * math.sin(ang)))
    array.push(crabPolys, polyline.new(shellPts, curved = true, closed = true, xloc = xloc.bar_index,
         line_color = shellDark, fill_color = crabColor, line_width = 2))
    f_cap(ax - 1, ay + 0.55 * u, ax + 1, ay + 0.55 * u, shellLight, 4)
    smilePts = array.new<chart.point>()
    array.push(smilePts, chart.point.from_index(ax - 1, ay - 0.20 * u))
    array.push(smilePts, chart.point.from_index(ax, ay - 0.42 * u))
    array.push(smilePts, chart.point.from_index(ax + 1, ay - 0.20 * u))
    array.push(crabPolys, polyline.new(smilePts, curved = true, closed = false, xloc = xloc.bar_index,
         line_color = shellDark, line_width = 3))

    // eyes seated on thick stalks
    f_cap(ax - 1, ay + 0.60 * u, ax - 1, ay + 1.10 * u, crabColor, 3)
    f_cap(ax + 1, ay + 0.60 * u, ax + 1, ay + 1.10 * u, crabColor, 3)
    f_dot(ax - 1, ay + 1.18 * u, color.white, "small")
    f_dot(ax + 1, ay + 1.18 * u, color.white, "small")
    f_dot(ax - 1, ay + 1.14 * u, color.black, "tiny")
    f_dot(ax + 1, ay + 1.14 * u, color.black, "tiny")

    // classic money bag held in the right claw: round body, cinched knot on top
    int bx = ax + 6
    float bagY = ay + 1.05 * u
    bagPts = array.new<chart.point>()
    for a = 0 to 15
        float ang = a * math.pi / 8.0
        array.push(bagPts, chart.point.from_index(bx + int(math.round(1.5 * math.cos(ang))), bagY + 0.50 * u * math.sin(ang)))
    array.push(crabPolys, polyline.new(bagPts, curved = true, closed = true, xloc = xloc.bar_index,
         line_color = bagDark, fill_color = bagColor, line_width = 2))
    f_cap(bx - 1, bagY + 0.55 * u, bx, bagY + 0.72 * u, bagDark, 3)   // gathered neck
    f_cap(bx + 1, bagY + 0.55 * u, bx, bagY + 0.72 * u, bagDark, 3)
    f_cap(bx - 1, bagY + 0.78 * u, bx + 1, bagY + 0.78 * u, bagDark, 4)  // knot
    f_txt(bx, bagY, "$", bagDark, "normal")

    // bills spilling from the bag, tumbling to the ground
    int fallSpan = 12
    for i = 0 to 2
        int ph = (step + i * 4) % fallSpan
        float frac = ph / float(fallSpan)
        int fx = bx + 1 + int(math.round(frac * 2))
        float fy = bagY + 0.60 * u - frac * (bagY + 0.60 * u - ground)
        f_bill(fx, fy)

    // bills resting on the ground behind the crab
    if dropMoney and barstate.isconfirmed and bar_index % dropEvery == 0
        array.push(moneyLines, line.new(bx + 2, ground, bx + 3, ground, xloc = xloc.bar_index, color = billColor, width = 6))
        array.push(moneyLbls, label.new(bx + 2, ground, "  $", xloc = xloc.bar_index, yloc = yloc.price,
             style = label.style_none, textcolor = billDark, size = size.tiny))
        if array.size(moneyLbls) > keepDrops
            label.delete(array.shift(moneyLbls))
            line.delete(array.shift(moneyLines))
