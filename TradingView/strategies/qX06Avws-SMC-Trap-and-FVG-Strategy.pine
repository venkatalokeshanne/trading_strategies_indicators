//@version=6
strategy("SMC Trap → FVG Strategy", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// INPUTS
lookback = input.int(10,"Structure Lookback")
cooldown = input.int(3,"Trap Cooldown")
wickPercent = input.float(0.1,"Trap Wick %")
atrLen = input.int(14,"ATR Length")
atrMultSL = input.float(0.3,"SL Buffer (ATR)")

atr = ta.atr(atrLen)

//────────────────────────────
// LIQUIDITY TRAPS
//────────────────────────────
swingHigh = ta.highest(high[1],lookback)
swingLow = ta.lowest(low[1],lookback)

barRange = high-low
upperWick = high-math.max(open,close)
lowerWick = math.min(open,close)-low

upperPct = barRange>0?upperWick/barRange:0
lowerPct = barRange>0?lowerWick/barRange:0

rawBullTrap = high>swingHigh and close<swingHigh and upperPct>=wickPercent
rawBearTrap = low<swingLow and close>swingLow and lowerPct>=wickPercent

var int lastBullTrap = na
var int lastBearTrap = na

bullTrap = rawBullTrap and (na(lastBullTrap) or bar_index-lastBullTrap>cooldown)
bearTrap = rawBearTrap and (na(lastBearTrap) or bar_index-lastBearTrap>cooldown)

if bullTrap
    lastBullTrap := bar_index

if bearTrap
    lastBearTrap := bar_index

//────────────────────────────
// FVG DETECTION
//────────────────────────────
bullFVG = high[2] < low
bearFVG = low[2] > high

// STORE FVGs
var topArr = array.new_float()
var botArr = array.new_float()
var bullArr = array.new_bool()

if bullFVG
    array.push(topArr, low)
    array.push(botArr, high[2])
    array.push(bullArr, true)

if bearFVG
    array.push(topArr, low[2])
    array.push(botArr, high)
    array.push(bullArr, false)

//────────────────────────────
// FIND NEAREST FVG
//────────────────────────────
f_getNearestFVG(_isLong) =>
    float target = na
    int sz = array.size(topArr)
    
    if sz > 0
        for i = sz-1 to 0
            t = array.get(topArr,i)
            b = array.get(botArr,i)
            bull = array.get(bullArr,i)
            
            // For LONG → target bearish FVG above
            if _isLong and not bull and b > close
                target := b
                break
            
            // For SHORT → target bullish FVG below
            if not _isLong and bull and t < close
                target := t
                break
    
    target

//────────────────────────────
// EXECUTION
//────────────────────────────

// LONG (bear trap)
if bearTrap
    sl = low - atr * atrMultSL
    tp = f_getNearestFVG(true)

    if not na(tp)
        strategy.entry("LONG", strategy.long)
        strategy.exit("TP/SL LONG", from_entry="LONG", stop=sl, limit=tp)

// SHORT (bull trap)
if bullTrap
    sl = high + atr * atrMultSL
    tp = f_getNearestFVG(false)

    if not na(tp)
        strategy.entry("SHORT", strategy.short)
        strategy.exit("TP/SL SHORT", from_entry="SHORT", stop=sl, limit=tp)