//@version=6
strategy('AI MES London Open Breakout', overlay = true, default_qty_type = strategy.fixed, default_qty_value = 1, commission_type = strategy.commission.cash_per_contract, commission_value = 0.62, calc_on_every_tick = false)

// ══════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════

londPreStart = input.int(2, 'Pre-London Range Start Hour (ET)', group = 'Sessions', minval = 0, maxval = 23)
londPreMin = input.int(30, 'Pre-London Range Start Minute (ET)', group = 'Sessions', minval = 0, maxval = 59)
londStart = input.int(3, 'London Open Hour (ET)', group = 'Sessions', minval = 0, maxval = 23)
londStartMin = input.int(0, 'London Open Minute (ET)', group = 'Sessions', minval = 0, maxval = 59)
londEnd = input.int(6, 'London Close Hour (ET)', group = 'Sessions', minval = 0, maxval = 23)
londEndMin = input.int(0, 'London Close Minute (ET)', group = 'Sessions', minval = 0, maxval = 59)

pivotLen = input.int(4, 'Pivot Lookback (bars each side)', group = 'Structure', minval = 2, maxval = 10)

htfTF = input.timeframe('60', 'HTF Timeframe', group = 'Higher Timeframe')
htfEMALen = input.int(21, 'HTF EMA Length', group = 'Higher Timeframe')

rsiLen = input.int(14, 'RSI Length', group = 'Momentum')
rsiLongMin = input.float(45, 'RSI Min for Longs', group = 'Momentum', step = 1.0)
rsiShortMax = input.float(55, 'RSI Max for Shorts', group = 'Momentum', step = 1.0)

volLen = input.int(20, 'Volume MA Length', group = 'Volume')
volMult = input.float(1.2, 'Volume Multiplier', group = 'Volume', step = 0.1)

riskRatio = input.float(1.5, 'Reward:Risk Ratio', group = 'Risk', step = 0.1)
stopBuffer = input.float(2.0, 'Stop Buffer beyond pivot (pts)', group = 'Risk', step = 0.25)
atrLen = input.int(14, 'ATR Length (for stop floor)', group = 'Risk')
atrMult = input.float(1.5, 'ATR Stop Floor Multiplier', group = 'Risk', step = 0.1)
maxTrades = input.int(2, 'Max Trades Per Session', group = 'Risk', minval = 1, maxval = 5)

minRangeSize = input.float(3.0, 'Min Pre-London Range Size (pts)', group = 'Filters', step = 0.5)
useHTFFilter = input.bool(true, 'Use HTF Bias Filter', group = 'Filters')
useVolFilter = input.bool(true, 'Use Volume Filter', group = 'Filters')

// ══════════════════════════════════════════════════════
// SESSION LOGIC
// ══════════════════════════════════════════════════════

etHour = hour(time, 'America/New_York')
etMin = minute(time, 'America/New_York')
etTime = etHour * 100 + etMin

preStartT = londPreStart * 100 + londPreMin
londStartT = londStart * 100 + londStartMin
londEndT = londEnd * 100 + londEndMin

inPreLondon = etTime >= preStartT and etTime < londStartT
inLondon = etTime >= londStartT and etTime < londEndT
inAnySession = inPreLondon or inLondon

newSession = inLondon and not inLondon[1]

var int sessionTrades = 0
if newSession
    sessionTrades := 0
    sessionTrades

underTradeLimit = sessionTrades < maxTrades

// ══════════════════════════════════════════════════════
// PRE-LONDON RANGE
// ══════════════════════════════════════════════════════

var float preHigh = na
var float preLow = na
var float preHighLocked = na
var float preLowLocked = na

if inPreLondon
    preHigh := na(preHigh) ? high : math.max(preHigh, high)
    preLow := na(preLow) ? low : math.min(preLow, low)
    preLow

if newSession
    preHighLocked := preHigh
    preLowLocked := preLow
    preHigh := na
    preLow := na
    preLow

rangeSize = na(preHighLocked) or na(preLowLocked) ? na : preHighLocked - preLowLocked
validRange = not na(rangeSize) and rangeSize >= minRangeSize

// ══════════════════════════════════════════════════════
// HIGHER TIMEFRAME BIAS
// ══════════════════════════════════════════════════════

htfEMA = request.security(syminfo.tickerid, htfTF, ta.ema(close, htfEMALen), lookahead = barmerge.lookahead_off)
bullBias = close > htfEMA
bearBias = close < htfEMA

// ══════════════════════════════════════════════════════
// PIVOT STRUCTURE
// ══════════════════════════════════════════════════════

pivHigh = ta.pivothigh(high, pivotLen, pivotLen)
pivLow = ta.pivotlow(low, pivotLen, pivotLen)

var float lastPivHigh = na
var float lastPivLow = na

if not na(pivHigh)
    lastPivHigh := pivHigh
    lastPivHigh
if not na(pivLow)
    lastPivLow := pivLow
    lastPivLow

breakHigh = not na(lastPivHigh) and close > lastPivHigh and close[1] <= lastPivHigh
breakLow = not na(lastPivLow) and close < lastPivLow and close[1] >= lastPivLow

// ══════════════════════════════════════════════════════
// MOMENTUM & VOLUME
// ══════════════════════════════════════════════════════

rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)
avgVol = ta.sma(volume, volLen)
highVol = not useVolFilter or volume > avgVol * volMult

rsiLong = rsi >= rsiLongMin
rsiShort = rsi <= rsiShortMax

// ══════════════════════════════════════════════════════
// RANGE BREAKOUT CONFIRMATION
// ══════════════════════════════════════════════════════

rangeBreakLong = validRange and close > preHighLocked and close[1] <= preHighLocked
rangeBreakShort = validRange and close < preLowLocked and close[1] >= preLowLocked

// ══════════════════════════════════════════════════════
// ENTRY CONDITIONS
// ══════════════════════════════════════════════════════

htfLong = not useHTFFilter or bullBias
htfShort = not useHTFFilter or bearBias

longCondition = inLondon and underTradeLimit and strategy.position_size == 0 and (rangeBreakLong or breakHigh) and rsiLong and highVol and htfLong

shortCondition = inLondon and underTradeLimit and strategy.position_size == 0 and (rangeBreakShort or breakLow) and rsiShort and highVol and htfShort

// ══════════════════════════════════════════════════════
// DYNAMIC STOP & TARGET
// ══════════════════════════════════════════════════════

pivotLongStop = lastPivLow - stopBuffer
pivotShortStop = lastPivHigh + stopBuffer
atrLongStop = close - atr * atrMult
atrShortStop = close + atr * atrMult

longStop = math.min(pivotLongStop, atrLongStop)
shortStop = math.max(pivotShortStop, atrShortStop)

longRisk = close - longStop
shortRisk = shortStop - close
longTarget = close + longRisk * riskRatio
shortTarget = close - shortRisk * riskRatio

// ══════════════════════════════════════════════════════
// ENTRIES
// ══════════════════════════════════════════════════════

var float entryStop = na
var float entryTarget = na

if strategy.position_size == 0
    entryStop := na
    entryTarget := na
    entryTarget

if longCondition
    entryStop := longStop
    entryTarget := longTarget
    strategy.entry('Long', strategy.long)
    sessionTrades := sessionTrades + 1
    alert('🟢 MES LONDON LONG\n' + 'Trigger: ' + (rangeBreakLong ? 'Range Breakout' : 'Pivot Break') + '\n' + 'Entry: ' + str.tostring(math.round(close, 2)) + '\n' + 'Pre-London High: ' + str.tostring(math.round(preHighLocked, 2)) + '\n' + 'Stop: ' + str.tostring(math.round(longStop, 2)) + '\n' + 'Target: ' + str.tostring(math.round(longTarget, 2)) + '\n' + 'Risk (pts): ' + str.tostring(math.round(longRisk, 2)) + '\n' + 'ATR: ' + str.tostring(math.round(atr, 2)) + '\n' + 'RSI: ' + str.tostring(math.round(rsi, 1)) + '\n' + 'HTF Bias: BULL', alert.freq_once_per_bar)

if shortCondition
    entryStop := shortStop
    entryTarget := shortTarget
    strategy.entry('Short', strategy.short)
    sessionTrades := sessionTrades + 1
    alert('🔴 MES LONDON SHORT\n' + 'Trigger: ' + (rangeBreakShort ? 'Range Breakout' : 'Pivot Break') + '\n' + 'Entry: ' + str.tostring(math.round(close, 2)) + '\n' + 'Pre-London Low: ' + str.tostring(math.round(preLowLocked, 2)) + '\n' + 'Stop: ' + str.tostring(math.round(shortStop, 2)) + '\n' + 'Target: ' + str.tostring(math.round(shortTarget, 2)) + '\n' + 'Risk (pts): ' + str.tostring(math.round(shortRisk, 2)) + '\n' + 'ATR: ' + str.tostring(math.round(atr, 2)) + '\n' + 'RSI: ' + str.tostring(math.round(rsi, 1)) + '\n' + 'HTF Bias: BEAR', alert.freq_once_per_bar)

// ══════════════════════════════════════════════════════
// EXITS
// ══════════════════════════════════════════════════════

if strategy.position_size > 0
    strategy.exit('Long Exit', 'Long', stop = entryStop, limit = entryTarget)
    if low <= entryStop
        alert('🛑 MES LONDON LONG STOP HIT\n' + 'Price: ' + str.tostring(math.round(close, 2)) + '\n' + 'Stop: ' + str.tostring(math.round(entryStop, 2)), alert.freq_once_per_bar)
    if high >= entryTarget
        alert('✅ MES LONDON LONG TARGET HIT\n' + 'Price: ' + str.tostring(math.round(close, 2)) + '\n' + 'Target: ' + str.tostring(math.round(entryTarget, 2)), alert.freq_once_per_bar)

if strategy.position_size < 0
    strategy.exit('Short Exit', 'Short', stop = entryStop, limit = entryTarget)
    if high >= entryStop
        alert('🛑 MES LONDON SHORT STOP HIT\n' + 'Price: ' + str.tostring(math.round(close, 2)) + '\n' + 'Stop: ' + str.tostring(math.round(entryStop, 2)), alert.freq_once_per_bar)
    if low <= entryTarget
        alert('✅ MES LONDON SHORT TARGET HIT\n' + 'Price: ' + str.tostring(math.round(close, 2)) + '\n' + 'Target: ' + str.tostring(math.round(entryTarget, 2)), alert.freq_once_per_bar)

sessionEnd = not inAnySession and inAnySession[1]
if sessionEnd
    strategy.close_all(comment = 'Session End')
    alert('🔔 MES LONDON SESSION END — All positions closed. Price: ' + str.tostring(math.round(close, 2)), alert.freq_once_per_bar)

// ══════════════════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════════════════

plot(htfEMA, '1hr EMA (21)', color = color.new(color.yellow, 20), linewidth = 2)
plot(ta.vwap(hlc3), 'VWAP', color = color.new(color.purple, 20), linewidth = 1)
plot(lastPivHigh, 'Last Pivot High', color = color.new(color.red, 50), style = plot.style_circles, linewidth = 1)
plot(lastPivLow, 'Last Pivot Low', color = color.new(color.green, 50), style = plot.style_circles, linewidth = 1)

plot(inAnySession ? preHighLocked : na, 'Pre-London High', color = color.new(color.orange, 20), style = plot.style_linebr, linewidth = 2)
plot(inAnySession ? preLowLocked : na, 'Pre-London Low', color = color.new(color.aqua, 20), style = plot.style_linebr, linewidth = 2)

plotshape(longCondition, style = shape.triangleup, location = location.belowbar, color = color.lime, size = size.normal, title = 'Long Entry')
plotshape(shortCondition, style = shape.triangledown, location = location.abovebar, color = color.red, size = size.normal, title = 'Short Entry')

isLong = strategy.position_size > 0
isShort = strategy.position_size < 0

plot(isLong ? entryStop : na, 'Long Stop', color = color.red, style = plot.style_linebr, linewidth = 1)
plot(isLong ? entryTarget : na, 'Long Target', color = color.lime, style = plot.style_linebr, linewidth = 1)
plot(isShort ? entryStop : na, 'Short Stop', color = color.red, style = plot.style_linebr, linewidth = 1)
plot(isShort ? entryTarget : na, 'Short Target', color = color.lime, style = plot.style_linebr, linewidth = 1)

bgcolor(inPreLondon ? color.new(color.orange, 92) : na, title = 'Pre-London Window')
bgcolor(inLondon ? color.new(color.blue, 92) : na, title = 'London Session')
bgcolor(inLondon and not validRange ? color.new(color.red, 90) : na, title = 'Invalid Range Warning')

// ══════════════════════════════════════════════════════
// INFO TABLE
// ══════════════════════════════════════════════════════

var table info = table.new(position.top_right, 2, 11, bgcolor = color.new(color.black, 78), border_width = 1)
if barstate.isrealtime or barstate.islastconfirmedhistory
    table.cell(info, 0, 0, 'Session', text_color = color.white, text_size = size.small)
    table.cell(info, 1, 0, inPreLondon ? 'Pre-London' : inLondon ? 'London Open' : 'Closed', text_color = inAnySession ? color.lime : color.gray, text_size = size.small)
    table.cell(info, 0, 1, 'HTF EMA', text_color = color.white, text_size = size.small)
    table.cell(info, 1, 1, str.tostring(math.round(htfEMA, 2)), text_color = color.yellow, text_size = size.small)
    table.cell(info, 0, 2, 'Bias', text_color = color.white, text_size = size.small)
    table.cell(info, 1, 2, bullBias ? 'BULL ▲' : 'BEAR ▼', text_color = bullBias ? color.lime : color.red, text_size = size.small)
    table.cell(info, 0, 3, 'Range High', text_color = color.white, text_size = size.small)
    table.cell(info, 1, 3, na(preHighLocked) ? '–' : str.tostring(math.round(preHighLocked, 2)), text_color = color.orange, text_size = size.small)
    table.cell(info, 0, 4, 'Range Low', text_color = color.white, text_size = size.small)
    table.cell(info, 1, 4, na(preLowLocked) ? '–' : str.tostring(math.round(preLowLocked, 2)), text_color = color.aqua, text_size = size.small)
    table.cell(info, 0, 5, 'Range Size', text_color = color.white, text_size = size.small)
    table.cell(info, 1, 5, na(rangeSize) ? '–' : str.tostring(math.round(rangeSize, 2)) + (validRange ? ' ✓' : ' too small'), text_color = validRange ? color.lime : color.red, text_size = size.small)
    table.cell(info, 0, 6, 'ATR', text_color = color.white, text_size = size.small)
    table.cell(info, 1, 6, str.tostring(math.round(atr, 2)), text_color = color.white, text_size = size.small)
    table.cell(info, 0, 7, 'RSI', text_color = color.white, text_size = size.small)
    table.cell(info, 1, 7, str.tostring(math.round(rsi, 1)) + (rsiLong ? ' ▲' : ' ▼'), text_color = rsiLong ? color.lime : color.red, text_size = size.small)
    table.cell(info, 0, 8, 'Volume', text_color = color.white, text_size = size.small)
    table.cell(info, 1, 8, highVol ? 'HIGH ✓' : 'normal', text_color = highVol ? color.lime : color.gray, text_size = size.small)
    table.cell(info, 0, 9, 'Trades', text_color = color.white, text_size = size.small)
    table.cell(info, 1, 9, str.tostring(sessionTrades) + '/' + str.tostring(maxTrades), text_color = underTradeLimit ? color.lime : color.gray, text_size = size.small)
    table.cell(info, 0, 10, 'Position', text_color = color.white, text_size = size.small)
    table.cell(info, 1, 10, isLong ? 'LONG ▲' : isShort ? 'SHORT ▼' : 'FLAT', text_color = isLong ? color.lime : isShort ? color.red : color.gray, text_size = size.small)
