//@version=6
indicator("RTH ADR", overlay=true)

// ============ INPUTS ============
lookbackDays  = input.int(14, "Lookback Days (RTH Avg Range)", minval=1, maxval=500)
sess          = input.session("0630-1310", "RTH Session (Pacific Time)")
bgOpacity     = input.int(85, "Background Opacity", minval=0, maxval=100, tooltip="100 = solid white, 0 = fully clear")
borderOpacity = input.int(100, "Border Opacity", minval=0, maxval=100)
textOpacity   = input.int(100, "Text Opacity", minval=0, maxval=100)

// ============ SESSION DETECTION (Pacific Time) ============
inSession      = not na(time(timeframe.period, sess, "America/Los_Angeles"))
newSession     = inSession and not inSession[1]
sessionEndedNow = not inSession and inSession[1]

var float sessionHigh = na
var float sessionLow  = na

if newSession
    sessionHigh := high
    sessionLow  := low
else if inSession
    sessionHigh := math.max(sessionHigh, high)
    sessionLow  := math.min(sessionLow, low)

// ============ STORE COMPLETED DAILY RTH RANGES ============
var float[] rangeArr = array.new_float(0)
maxKeep = math.max(lookbackDays + 20, 60)

if sessionEndedNow and barstate.isconfirmed
    dayRange = sessionHigh - sessionLow
    if not na(dayRange)
        array.push(rangeArr, dayRange)
        if array.size(rangeArr) > maxKeep
            array.shift(rangeArr)

// ============ AVERAGE RTH RANGE OVER LOOKBACK DAYS ============
avgRange = float(na)
n = math.min(lookbackDays, array.size(rangeArr))
if n > 0
    total = 0.0
    for i = 0 to n - 1
        total += array.get(rangeArr, array.size(rangeArr) - 1 - i)
    avgRange := total / n

// ============ TODAY'S LIVE RANGE ============
currentRange = (not na(sessionHigh) and not na(sessionLow)) ? (sessionHigh - sessionLow) : na

// ============ PERCENTAGE ============
pct = (not na(avgRange) and avgRange != 0 and not na(currentRange)) ? (currentRange / avgRange) * 100 : na

// ============ COLORS ============
bgCol     = color.new(color.white, 100 - bgOpacity)
borderCol = color.new(color.black, 100 - borderOpacity)
textCol   = color.new(color.black, 100 - textOpacity)

// ============ TABLE ============
var table infoTable = table.new(position.top_right, 2, 3, bgcolor=bgCol, border_width=1, border_color=borderCol, frame_width=1, frame_color=borderCol)

if barstate.islast
    table.cell(infoTable, 0, 0, "RTH ADR (" + str.tostring(lookbackDays) + "d)", text_color=textCol, bgcolor=bgCol)
    table.cell(infoTable, 1, 0, na(avgRange) ? "n/a" : str.tostring(avgRange, "#.00"), text_color=textCol, bgcolor=bgCol)
    table.cell(infoTable, 0, 1, "Today's Range", text_color=textCol, bgcolor=bgCol)
    table.cell(infoTable, 1, 1, na(currentRange) ? "n/a" : str.tostring(currentRange, "#.00"), text_color=textCol, bgcolor=bgCol)
    table.cell(infoTable, 0, 2, "Today % of Avg", text_color=textCol, bgcolor=bgCol)
    table.cell(infoTable, 1, 2, na(pct) ? "n/a" : str.tostring(pct, "#.00") + "%", text_color=textCol, bgcolor=bgCol)
