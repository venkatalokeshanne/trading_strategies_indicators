//@version=6
strategy(title = "Simple Pyramid Strategy", overlay = true, fill_orders_on_standard_ohlc = true)

// This 'Simple Pyramid Strategy' is a generic trading strategy that takes a Buy/Sell source input of: [> 0 for Buy, < 0 for Sell, = 0 for Neither]
// For every signal on every bar, it will open, or add to the current position if in the same direction, by the amount of the configured 'Default order size'.
// A signal in the opposite direction to the current position will completely close out that position and open a new one in the opposite direction.
// It also takes an optional 'Cancel' indicator to close positions or prevent them from being opened. [> 0 for Buy, < 0 for Sell, = 0 for Neither]
// A SELL signal from the cancel indicator will close a long position and a BUY signal will close a short. A SELL will have no effect on a short, as will a BUY not effect a long.
// A stop can optionally be applied, as an actual value, or else a percentage of the price of the chart asset. The current position will close out if the P/L for it exceeds a loss of more than this amount.
// 0 means no stop will be applied.
// Be sure to configure the 'Pyramiding' option to a large number, and ensure 'Initial capital' is also enough to avoid liquidations.
// My 'Simple Buy/Sell Indicator' and 'Custom Buy/Sell Indicator' (coming soon - watch this space) can be used to combine other indicators together into BUY / SELL strategies, using multiple custom rules. These can then be used as inputs to this strategy.


// Inputs

float buySellInput = input.source(defval = open, title = "Buy/Sell Indicator", display = display.none, group = "Indicators",
    tooltip = "Source for a Buy/Sell indicator to open, or add to, positions.\n\n> 0 for Buy\n< 0 for Sell\n= 0 for Neither")

float cancelInput = input.source(defval = open, title = "Cancel Indicator", display = display.none, group = "Indicators", inline = "Cancel")

string cancelTypeInput = input.string(defval = "None", title = "", options = ["Not New", "Close and Not New", "None"], group = "Indicators", inline = "Cancel", display = display.none,
    tooltip = "Source for a 'Cancel' indicator to close positions or prevent them from being opened.\n\n> 0 for Buy\n< 0 for Sell\n= 0 for Neither\n\nA SELL will cancel a long and a BUY will cancel a short. A SELL will have no effect on a short, as will a BUY not effect a long.")

float stopInput = input.float(defval = 0, title = "Stop", minval = 0, maxval = 10000000, step = 0.01, group = "Strategy Stop", inline = "stop", display = display.none)

string stopTypeInput = input.string(defval = "Value", title = "", options = ["Value", "Percent"], group = "Strategy Stop", inline = "stop", display = display.none,
    tooltip = "Use this actual value for the stop, or else a percentage of the price of the chart asset. This will close out the current position if the P/L for it exceeds a loss of more than this amount.\n\n0 means no stop will be applied.")


// Functions

getPercentAsValue(percent) =>
    (percent / 100) * high


// Strategy

if cancelTypeInput == "Close and Not New"

    if strategy.position_size > 0   // long position

        if cancelInput < 0
            strategy.cancel_all()
            strategy.close_all()
            log.info("Long position closed with a SELL cancel indication.")    
        
    else if strategy.position_size < 0   // short position

        if cancelInput > 0
            strategy.cancel_all()
            strategy.close_all()
            log.info("Short position closed with a BUY cancel indication.")    



float stopSize = stopInput

if stopTypeInput == "Percent"
    stopSize := getPercentAsValue(stopInput)

stopSize *= -1

if stopSize != 0
    if strategy.openprofit < stopSize
        strategy.cancel_all()
        strategy.close_all()
        log.info("Stop Hit!")    



if buySellInput > 0 
    if (cancelTypeInput == "None" or cancelInput >= 0)
    
        strategy.entry("Long Entry", strategy.long)
    
    else if strategy.position_size < 0   // short position
        strategy.cancel_all()
        strategy.close_all()
        log.info("BUY signal closing short position.")    


else if buySellInput < 0
    if (cancelTypeInput == "None" or cancelInput <= 0)
        
        strategy.entry("Short Entry", strategy.short)

    else if strategy.position_size > 0   // long position

        strategy.cancel_all()
        strategy.close_all()
        log.info("SELL signal closing long position.")    


log.info("Position Size: " + str.tostring(strategy.position_size) + ", Open Profit: " + str.tostring(strategy.openprofit) + ", Net Profit: " + str.tostring(strategy.netprofit))


