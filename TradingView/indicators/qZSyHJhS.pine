//@version=6
indicator('NY ALMA GOLD', overlay = true, max_lines_count = 500, max_labels_count = 500)

// ============================================================
// INPUTS
// ============================================================
grpAlma = 'Configuración ALMA'
almaLen = input.int(9, 'Longitud', minval = 1, group = grpAlma)
almaOffset = input.float(0.85, 'Compensación (Offset)', minval = 0.0, maxval = 1.0, step = 0.01, group = grpAlma)
almaSigma = input.float(6.0, 'Sigma', minval = 0.01, group = grpAlma)
almaCol = input.color(color.new(color.blue, 0), 'Color línea ALMA', group = grpAlma)

grpTF = 'Temporalidad de Cálculo'
calcTF = input.timeframe('5', 'Temporalidad para calcular ALMA/Precio', options = ['1', '2', '3', '5', '10', '15', '30'], group = grpTF)

grpLinea = 'Líneas (Entrada / TP / SL)'
extensionMin = input.int(10, 'Longitud de las líneas (minutos)', minval = 1, group = grpLinea)
lineaCol = input.color(color.new(color.white, 0), 'Color línea de entrada', group = grpLinea)
lineaAncho = input.int(1, 'Grosor línea de entrada', minval = 1, maxval = 4, group = grpLinea)

grpTP = 'Take Profit'
tpPuntos = input.float(40, 'TP (puntos)', minval = 0, group = grpTP)
tpCol = input.color(color.new(color.green, 0), 'Color línea TP', group = grpTP)
tpAncho = input.int(1, 'Grosor línea TP', minval = 1, maxval = 4, group = grpTP)

grpSL = 'Stop Loss'
slPuntos = input.float(200, 'SL (puntos)', minval = 0, group = grpSL)
slCol = input.color(color.new(color.red, 0), 'Color línea SL', group = grpSL)
slAncho = input.int(1, 'Grosor línea SL', minval = 1, maxval = 4, group = grpSL)

grpSimb = 'Símbolo de Señal'
simboloTipo = input.string('Triángulo', 'Tipo de símbolo', options = ['Triángulo', 'Círculo', 'Bandera', 'Diamante', 'Cruz'], group = grpSimb)
colCompra = input.color(color.new(color.lime, 0), 'Color símbolo compra', group = grpSimb)
colVenta = input.color(color.new(color.red, 0), 'Color símbolo venta', group = grpSimb)
tamanoSimb = input.string('Normal', 'Tamaño del símbolo', options = ['Diminuto', 'Pequeño', 'Normal', 'Grande', 'Enorme'], group = grpSimb)

grpResultado = 'Resultado de la Operación (TP/SL)'
mostrarResultado = input.bool(true, 'Marcar si la operación llegó a TP o SL', group = grpResultado)
colTPHit = input.color(color.new(color.lime, 0), 'Color tilde (TP alcanzado)', group = grpResultado)
colSLHit = input.color(color.new(color.red, 0), 'Color cruz (SL alcanzado)', group = grpResultado)
offsetResultado = input.float(3.0, 'Distancia debajo de la vela (múltiplo ATR)', minval = 0.1, step = 0.1, group = grpResultado)

grpCierre = 'Cierre Forzado por Horario'
cierreHora = input.int(16, 'Hora límite (NY)', minval = 0, maxval = 23, group = grpCierre)
cierreMin = input.int(30, 'Minuto límite (NY)', minval = 0, maxval = 59, group = grpCierre)
colCierreHora = input.color(color.new(color.gray, 0), 'Color símbolo (cierre por horario)', group = grpCierre)

// ============================================================
// HORARIO OBJETIVO — fijo a las 9:29 NY (cierre de esa vela de 1 min)
// Al usar el timezone "America/New_York", el horario objetivo se
// ajusta automáticamente cuando NY cambia entre EST/EDT, sin
// necesidad de selección manual.
// ============================================================
targetHour = 9
targetMinute = 29

tamanoLabel(t) =>
    t == 'Diminuto' ? size.tiny : t == 'Pequeño' ? size.small : t == 'Grande' ? size.large : t == 'Enorme' ? size.huge : size.normal

// ============================================================
// ALMA / PRECIO EN LA TEMPORALIDAD DE CÁLCULO ELEGIDA
// (independiente de la temporalidad del gráfico)
// ============================================================
almaCalc() =>
    ta.alma(close, almaLen, almaOffset, almaSigma)

almaValue = request.security(syminfo.tickerid, calcTF, almaCalc(), lookahead = barmerge.lookahead_off)
closeCalcTF = request.security(syminfo.tickerid, calcTF, close, lookahead = barmerge.lookahead_off)

plot(almaValue, 'ALMA', color = almaCol, linewidth = 1)

atrResultado = ta.atr(14)

// ============================================================
// DETECCIÓN DEL CIERRE DE VELA DE 1 MIN A LAS 9:29 NY
// (via request.security_lower_tf para funcionar en cualquier
//  temporalidad del gráfico, sin depender de su grilla nativa)
// ============================================================
var int entryTime = na
var bool signalHoy = false
var int lastDay = na

lowerTimes = request.security_lower_tf(syminfo.tickerid, '1', time)

today = dayofmonth(time, 'America/New_York') + month(time, 'America/New_York') * 100 + year(time, 'America/New_York') * 10000
if na(lastDay) or today != lastDay
    signalHoy := false
    lastDay := today
    lastDay

signalBar = false
if array.size(lowerTimes) > 0 and not signalHoy
    i = array.size(lowerTimes) - 1
    while i >= 0
        t = int(array.get(lowerTimes, i))
        if hour(t, 'America/New_York') == targetHour and minute(t, 'America/New_York') == targetMinute
            signalBar := true
            entryTime := t
            signalHoy := true
            break
        i := i - 1
        i

// ============================================================
// CORTE POR HORARIO (NY) - se recalcula en cada barra
// ============================================================
horaCierreAlcanzada = hour(time, 'America/New_York') > cierreHora or hour(time, 'America/New_York') == cierreHora and minute(time, 'America/New_York') >= cierreMin

// ============================================================
// ARRAYS PARA SEGUIMIENTO DE OPERACIONES PENDIENTES (TP/SL)
// ============================================================
var array<float> pendEntry = array.new<float>()
var array<float> pendTP = array.new<float>()
var array<float> pendSL = array.new<float>()
var array<bool> pendCompra = array.new<bool>()

// ============================================================
// SEÑAL, LÍNEAS Y SÍMBOLO
// ============================================================
if signalBar
    entryPrice = closeCalcTF
    esCompra = closeCalcTF > almaValue
    dirMult = esCompra ? 1 : -1

    tpPrice = entryPrice + tpPuntos * dirMult
    slPrice = entryPrice - slPuntos * dirMult

    x1 = entryTime
    x2 = entryTime + extensionMin * 60 * 1000

    line.new(x1 = x1, y1 = entryPrice, x2 = x2, y2 = entryPrice, xloc = xloc.bar_time, color = lineaCol, width = lineaAncho, style = line.style_solid)
    line.new(x1 = x1, y1 = tpPrice, x2 = x2, y2 = tpPrice, xloc = xloc.bar_time, color = tpCol, width = tpAncho, style = line.style_dotted)
    line.new(x1 = x1, y1 = slPrice, x2 = x2, y2 = slPrice, xloc = xloc.bar_time, color = slCol, width = slAncho, style = line.style_dotted)

    simbColor = esCompra ? colCompra : colVenta
    simbTexto = switch simboloTipo
        'Triángulo' => esCompra ? '▲' : '▼'
        'Círculo' => '●'
        'Bandera' => '🚩'
        'Diamante' => '◆'
        'Cruz' => '✕'
        => '●'

    label.new(x = x1, y = entryPrice, xloc = xloc.bar_time, yloc = yloc.price, text = simbTexto, style = label.style_none, textcolor = simbColor, size = tamanoLabel(tamanoSimb), color = color.new(color.white, 100))

    if mostrarResultado
        array.push(pendEntry, entryPrice)
        array.push(pendTP, tpPrice)
        array.push(pendSL, slPrice)
        array.push(pendCompra, esCompra)

// ============================================================
// SEGUIMIENTO DE OPERACIONES PENDIENTES: MARCAR TP, SL O CIERRE POR HORARIO
// Nota: si en la misma vela se tocan TP y SL, Pine no puede saber
// cuál ocurrió primero (no hay datos intra-vela). Por criterio
// conservador, en ese caso se prioriza el SL.
// Si llega la hora límite (NY) sin que se haya tocado TP ni SL,
// la operación se cierra como "cierre por horario" (no cuenta
// como TP ni como SL).
// ============================================================
if mostrarResultado and array.size(pendEntry) > 0
    j = array.size(pendEntry) - 1
    while j >= 0
        compraJ = array.get(pendCompra, j)
        tpJ = array.get(pendTP, j)
        slJ = array.get(pendSL, j)

        tocoSL = compraJ ? low <= slJ : high >= slJ
        tocoTP = compraJ ? high >= tpJ : low <= tpJ

        if horaCierreAlcanzada
            yResultado = low - atrResultado * offsetResultado
            label.new(x = bar_index, y = yResultado, xloc = xloc.bar_index, yloc = yloc.price, text = '○', style = label.style_none, textcolor = colCierreHora, size = tamanoLabel(tamanoSimb), color = color.new(color.white, 100))
            array.remove(pendEntry, j)
            array.remove(pendTP, j)
            array.remove(pendSL, j)
            array.remove(pendCompra, j)
        else if tocoSL
            yResultado = low - atrResultado * offsetResultado
            label.new(x = bar_index, y = yResultado, xloc = xloc.bar_index, yloc = yloc.price, text = '✕', style = label.style_none, textcolor = colSLHit, size = tamanoLabel(tamanoSimb), color = color.new(color.white, 100))
            array.remove(pendEntry, j)
            array.remove(pendTP, j)
            array.remove(pendSL, j)
            array.remove(pendCompra, j)
        else if tocoTP
            yResultado = low - atrResultado * offsetResultado
            label.new(x = bar_index, y = yResultado, xloc = xloc.bar_index, yloc = yloc.price, text = '✓', style = label.style_none, textcolor = colTPHit, size = tamanoLabel(tamanoSimb), color = color.new(color.white, 100))
            array.remove(pendEntry, j)
            array.remove(pendTP, j)
            array.remove(pendSL, j)
            array.remove(pendCompra, j)
        j := j - 1
        j
