//@version=6
indicator("NQ 50-Point Grid", overlay=true, max_lines_count=401, max_labels_count=401)

// NQ grid settings
const float GRID_SIZE = 50.0

levelsEachSide = input.int(20, "Levels above and below price", minval=1, maxval=200)
showPriceLabels = input.bool(true, "Show price labels")
labelOffset = input.int(3, "Label offset (bars)", minval=0, maxval=50)
emphasizeHundreds = input.bool(true, "Emphasize 100-point levels")

levelColor = input.color(color.new(color.gray, 55), "50-point line color")
hundredColor = input.color(color.new(color.blue, 20), "100-point line color")
levelWidth = input.int(1, "50-point line width", minval=1, maxval=4)
hundredWidth = input.int(2, "100-point line width", minval=1, maxval=4)

bool isNq = syminfo.root == "NQ" or syminfo.root == "MNQ"
int totalLevels = levelsEachSide * 2 + 1

var line[] gridLines = array.new_line()
var label[] priceLabels = array.new_label()
var table symbolWarning = table.new(position.top_right, 1, 1)

if barstate.islast
    if not isNq
        table.cell(
             symbolWarning,
             0,
             0,
             "NQ 50-Point Grid: use this indicator on an NQ chart.",
             text_color=color.white,
             bgcolor=color.new(color.red, 20)
         )
    else
        table.cell(symbolWarning, 0, 0, "", bgcolor=color.new(color.black, 100))

        // Anchor the grid to an exact 50-point multiple near the current price.
        float centerLevel = math.floor(close / GRID_SIZE) * GRID_SIZE

        // Create the objects once. Their prices are updated on each live tick.
        if array.size(gridLines) == 0
            for index = 0 to totalLevels - 1
                line newLine = line.new(
                     bar_index,
                     close,
                     bar_index + 1,
                     close,
                     xloc=xloc.bar_index,
                     extend=extend.both
                 )
                array.push(gridLines, newLine)

                if showPriceLabels
                    label newLabel = label.new(
                         bar_index,
                         close,
                         "",
                         xloc=xloc.bar_index,
                         yloc=yloc.price,
                         style=label.style_label_left,
                         color=color.new(color.black, 100),
                         size=size.tiny
                     )
                    array.push(priceLabels, newLabel)

        for index = 0 to totalLevels - 1
            int gridOffset = index - levelsEachSide
            float gridPrice = centerLevel + gridOffset * GRID_SIZE
            bool isHundred = int(math.round(gridPrice / GRID_SIZE)) % 2 == 0
            color currentColor = emphasizeHundreds and isHundred ? hundredColor : levelColor
            int currentWidth = emphasizeHundreds and isHundred ? hundredWidth : levelWidth

            line currentLine = array.get(gridLines, index)
            line.set_xy1(currentLine, bar_index, gridPrice)
            line.set_xy2(currentLine, bar_index + 1, gridPrice)
            line.set_color(currentLine, currentColor)
            line.set_width(currentLine, currentWidth)

            if showPriceLabels
                label currentLabel = array.get(priceLabels, index)
                label.set_xy(currentLabel, bar_index + labelOffset, gridPrice)
                label.set_text(currentLabel, str.tostring(gridPrice, format.mintick))
                label.set_textcolor(currentLabel, currentColor)
