//@version=6
indicator("CVD + OBV Reversal Institucional", overlay=false, max_lines_count=200, max_labels_count=200)

// ===================== INPUTS =====================
grpDelta = "Volume Delta (CVD)"
lowerTF    = input.timeframe("1", "Timeframe inferior (aproximación de tick)", group=grpDelta, tooltip="Cuanto más chico, más precisa la aproximación del delta real, pero más carga. 1 minuto suele alcanzar para timeframes de 15min en adelante.")
resetDaily = input.bool(true, "Reiniciar CVD cada sesión/día", group=grpDelta)

grpDiv = "Divergencia CVD"
pivotLeft    = input.int(5, "Barras a la izquierda (pivot)", group=grpDiv)
pivotRight   = input.int(5, "Barras a la derecha (pivot)", group=grpDiv)
maxPivotBars = input.int(60, "Rango máx. entre pivots (barras)", group=grpDiv)

grpEarly = "Alerta Temprana (sin confirmar)"
useEarly = input.bool(true, "Mostrar señal temprana (puede repintar)", group=grpEarly)

grpAbs = "Absorción / Clímax de Volumen"
showAbsorption = input.bool(true, "Mostrar velas de absorción", group=grpAbs)
volAvgLength   = input.int(20, "Largo SMA de volumen", group=grpAbs)
volMultiplier  = input.float(2.0, "Múltiplo de volumen promedio", minval=1.0, step=0.1, group=grpAbs)
maxBodyPct     = input.float(35.0, "Cuerpo máx. (% del rango) para considerar absorción", minval=1.0, maxval=100.0, group=grpAbs)

grpOBV = "OBV"
showObv        = input.bool(true, "Mostrar OBV (referencia)", group=grpOBV)
requireObvConfirm = input.bool(false, "Exigir que el OBV confirme la dirección", group=grpOBV, tooltip="Si está activo, además de la divergencia de CVD, pide que el OBV esté subiendo en el long o bajando en el short en el momento de la señal.")

// ===================== CVD (delta aproximado con timeframe inferior) =====================
[lowerCloses, lowerVolumes] = request.security_lower_tf(syminfo.tickerid, lowerTF, [close, volume])

delta = 0.0
if not na(close[1]) and array.size(lowerCloses) > 0
    prevC = close[1]
    for i = 0 to array.size(lowerCloses) - 1
        c = array.get(lowerCloses, i)
        v = array.get(lowerVolumes, i)
        if c > prevC
            delta += v
        else if c < prevC
            delta -= v
        prevC := c

var float cvd = 0.0
isNewSession = resetDaily and ta.change(time("D")) != 0
if isNewSession
    cvd := 0.0
cvd += delta

obv = ta.obv

// ===================== DETECCIÓN DE DIVERGENCIAS (CVD vs precio) =====================
plFound = not na(ta.pivotlow(cvd, pivotLeft, pivotRight))
phFound = not na(ta.pivothigh(cvd, pivotLeft, pivotRight))

var float lastCvdLow    = na
var float lastPriceLow2 = na
var int   lastLowBar2   = na

var float lastCvdHigh    = na
var float lastPriceHigh2 = na
var int   lastHighBar2   = na

bullishDiv = false
bearishDiv = false

if plFound
    cvdValAtPivot   = cvd[pivotRight]
    priceValAtPivot = low[pivotRight]
    bidx = bar_index - pivotRight
    if not na(lastCvdLow) and (bidx - lastLowBar2) <= maxPivotBars
        if priceValAtPivot < lastPriceLow2 and cvdValAtPivot > lastCvdLow
            bullishDiv := true
            line.new(lastLowBar2, lastCvdLow, bidx, cvdValAtPivot, xloc=xloc.bar_index, color=color.green, width=2)
    lastCvdLow    := cvdValAtPivot
    lastPriceLow2 := priceValAtPivot
    lastLowBar2   := bidx

if phFound
    cvdValAtPivot   = cvd[pivotRight]
    priceValAtPivot = high[pivotRight]
    bidx = bar_index - pivotRight
    if not na(lastCvdHigh) and (bidx - lastHighBar2) <= maxPivotBars
        if priceValAtPivot > lastPriceHigh2 and cvdValAtPivot < lastCvdHigh
            bearishDiv := true
            line.new(lastHighBar2, lastCvdHigh, bidx, cvdValAtPivot, xloc=xloc.bar_index, color=color.red, width=2)
    lastCvdHigh    := cvdValAtPivot
    lastPriceHigh2 := priceValAtPivot
    lastHighBar2   := bidx

// Divergencia temprana (sin esperar confirmación del pivot)
earlyLowCandidate  = low  <= ta.lowest(low, pivotLeft)
earlyHighCandidate = high >= ta.highest(high, pivotLeft)

earlyBullishDiv = useEarly and earlyLowCandidate and not na(lastPriceLow2) and
     low < lastPriceLow2 and cvd > lastCvdLow and (bar_index - lastLowBar2) <= maxPivotBars

earlyBearishDiv = useEarly and earlyHighCandidate and not na(lastPriceHigh2) and
     high > lastPriceHigh2 and cvd < lastCvdHigh and (bar_index - lastHighBar2) <= maxPivotBars

// Confirmación opcional de OBV
obvOkLong  = not requireObvConfirm or obv > obv[1]
obvOkShort = not requireObvConfirm or obv < obv[1]

longCondition       = bullishDiv and obvOkLong
shortCondition      = bearishDiv and obvOkShort
earlyLongCondition  = earlyBullishDiv and obvOkLong
earlyShortCondition = earlyBearishDiv and obvOkShort

// ===================== ABSORCIÓN / CLÍMAX DE VOLUMEN =====================
volAvg    = ta.sma(volume, volAvgLength)
volSpike  = volume > volAvg * volMultiplier
range_    = high - low
bodyPct   = range_ > 0 ? math.abs(close - open) / range_ * 100 : 100.0
smallBody = bodyPct <= maxBodyPct
isAbsorption = showAbsorption and volSpike and smallBody and range_ > 0

bullishAbsorption = isAbsorption and close <= open  // vela bajista/doji con mucho volumen y poco recorrido = compradores absorbiendo
bearishAbsorption = isAbsorption and close > open    // vela alcista con mucho volumen y poco recorrido = vendedores absorbiendo

// ===================== PLOTS: CVD + OBV (panel del indicador) =====================
plot(cvd, "CVD (Delta Acumulado)", color=color.new(color.purple, 0), linewidth=2)
hline(0, "Cero", color=color.new(color.gray, 60))

obvNorm = showObv ? ta.sma(obv, 1) : na
plot(showObv ? obvNorm : na, "OBV (referencia)", color=color.new(color.orange, 40), linewidth=1)

plotshape(bullishDiv, "Divergencia alcista CVD", style=shape.triangleup, location=location.bottom, offset=-pivotRight, color=color.green, size=size.tiny)
plotshape(bearishDiv, "Divergencia bajista CVD", style=shape.triangledown, location=location.top, offset=-pivotRight, color=color.red, size=size.tiny)

plotshape(earlyBullishDiv, "Divergencia alcista (temprana)", style=shape.circle, location=location.bottom, color=color.new(color.lime, 20), size=size.tiny)
plotshape(earlyBearishDiv, "Divergencia bajista (temprana)", style=shape.circle, location=location.top, color=color.new(color.orange, 20), size=size.tiny)

// ===================== PLOTS SOBRE EL GRÁFICO DE PRECIO =====================
if longCondition
    label.new(bar_index - pivotRight, low[pivotRight], "LONG", xloc=xloc.bar_index,
         yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.green, 0),
         textcolor=color.white, size=size.small, force_overlay=true)

if shortCondition
    label.new(bar_index - pivotRight, high[pivotRight], "SHORT", xloc=xloc.bar_index,
         yloc=yloc.abovebar, style=label.style_label_down, color=color.new(color.red, 0),
         textcolor=color.white, size=size.small, force_overlay=true)

plotshape(earlyLongCondition, "Señal LONG (temprana)", style=shape.triangleup, location=location.belowbar,
     color=color.new(color.lime, 20), size=size.tiny, force_overlay=true)
plotshape(earlyShortCondition, "Señal SHORT (temprana)", style=shape.triangledown, location=location.abovebar,
     color=color.new(color.orange, 20), size=size.tiny, force_overlay=true)

plotshape(bullishAbsorption, "Absorción compradora", style=shape.diamond, location=location.belowbar,
     color=color.new(color.aqua, 10), size=size.small, force_overlay=true)
plotshape(bearishAbsorption, "Absorción vendedora", style=shape.diamond, location=location.abovebar,
     color=color.new(color.fuchsia, 10), size=size.small, force_overlay=true)

// ===================== ALERTAS =====================
alertcondition(longCondition, "Señal LONG (CVD)", "Divergencia alcista confirmada entre CVD y precio")
alertcondition(shortCondition, "Señal SHORT (CVD)", "Divergencia bajista confirmada entre CVD y precio")
alertcondition(earlyLongCondition, "Señal LONG temprana (CVD)", "Divergencia alcista sin confirmar entre CVD y precio")
alertcondition(earlyShortCondition, "Señal SHORT temprana (CVD)", "Divergencia bajista sin confirmar entre CVD y precio")
alertcondition(bullishAbsorption, "Absorción compradora", "Volumen muy por encima del promedio con cuerpo chico en vela bajista/doji: posible absorción de venta")
alertcondition(bearishAbsorption, "Absorción vendedora", "Volumen muy por encima del promedio con cuerpo chico en vela alcista: posible absorción de compra")