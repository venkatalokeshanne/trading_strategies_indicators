//@version=6
indicator("Liquidita Pivot MTF - Freeze su Violazione (Rea Style)", overlay=true, max_boxes_count=500)

// --- INPUTS COLORI E TESTO TIMEFRAME ---
group_col   = "Colori per Timeframe"
colM        = input.color(color.new(#2962FF, 75), "Livelli Mensili (1M)", group=group_col)
colW        = input.color(color.new(#AA00FF, 80), "Livelli Settimanali (1W)", group=group_col)
colD        = input.color(color.new(#FF6D00, 80), "Livelli Giornalieri (1D)", group=group_col)
colH4       = input.color(color.new(#00E676, 80), "Livelli 4 Ore (H4)", group=group_col)

group_text  = "Stile Testo Etichette"
textColor   = input.color(color.white, "Colore Testo Etichetta", group=group_text)
textSize    = input.string("Small", "Dimensione Testo", options=["Auto", "Tiny", "Small", "Normal", "Large"], group=group_text)

group_set   = "Impostazioni Swing e Unificazione"
depthInput  = input.int(10, "Profondità Pivot (Barre)", minval=2, group=group_set)
boxPct      = input.float(1.2, "Spessore Rettangolo (%)", minval=0.1, step=0.1, group=group_set) / 100.0

// --- TIPO DATI PER TRACCIARE ZONE E TOCCHI ---
type ZoneBox
    box b
    float topVal
    float botVal
    int touchCount
    string tfLabel
    bool isHigh
    bool isBroken

var ZoneBox[] activeZones = array.new<ZoneBox>()

// --- FUNZIONE PER DIMENSIONE TESTO ---
f_getTextSize(sizeStr) =>
    switch sizeStr
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.auto

txtSize = f_getTextSize(textSize)

// --- AGGIUNTA O FUSIONE DEI BOX ---
f_addOrMergeZone(float pPrice, bool isHigh, string tfLabel, color tfColor) =>
    if not na(pPrice)
        float topVal = isHigh ? pPrice : pPrice * (1.0 + boxPct)
        float botVal = isHigh ? pPrice * (1.0 - boxPct) : pPrice
        
        bool merged = false

        if array.size(activeZones) > 0
            for i = 0 to array.size(activeZones) - 1
                ZoneBox zb = array.get(activeZones, i)
                
                // Controlla la fusione SOLO se la zona precedente è ancora ATTIVA (non violata)
                if zb.tfLabel == tfLabel and zb.isHigh == isHigh and not zb.isBroken
                    bool isOverlapping = not (topVal < zb.botVal or botVal > zb.topVal)
                    
                    if isOverlapping
                        zb.touchCount += 1
                        zb.topVal := math.max(zb.topVal, topVal)
                        zb.botVal := math.min(zb.botVal, botVal)
                        
                        box.set_top(zb.b, zb.topVal)
                        box.set_bottom(zb.b, zb.botVal)
                        box.set_text(zb.b, zb.tfLabel + " (x" + str.tostring(zb.touchCount) + ")")
                        merged := true
                        break

        // Se non è stata unificata a nessuna zona attiva, ne crea una nuova estesa a destra
        if not merged
            string txt = tfLabel + " (x1)"
            box newB = box.new(left=bar_index - depthInput, top=topVal, right=bar_index + 10, bottom=botVal, 
                               bgcolor=tfColor, border_color=tfColor, extend=extend.right,
                               text=txt, text_color=textColor, text_size=txtSize, 
                               text_valign="center", text_halign="left")
            
            ZoneBox newZone = ZoneBox.new(newB, topVal, botVal, 1, tfLabel, isHigh, false)
            array.push(activeZones, newZone)

// --- GESTIONE DELLA VIOLAZIONE DAL CORPO (FREEZE A DESTRA) ---
if array.size(activeZones) > 0
    float cPrice = close

    for i = 0 to array.size(activeZones) - 1
        ZoneBox zb = array.get(activeZones, i)
        
        // Controlla solo le zone ancora attive
        if not zb.isBroken
            bool isBrokenNow = false
            
            // Resistenza (High) violata da chiusura sopra
            if zb.isHigh and cPrice > zb.topVal
                isBrokenNow := true
            // Supporto (Low) violato da chiusura sotto
            else if not zb.isHigh and cPrice < zb.botVal
                isBrokenNow := true

            if isBrokenNow
                zb.isBroken := true
                // Blocca l'estensione verso destra e ferma la coordinata sulla candela corrente
                box.set_extend(zb.b, extend.none)
                box.set_right(zb.b, bar_index)

// --- ESTRAZIONE PIVOT MTF ---
pH_M = request.security(syminfo.tickerid, "M", ta.pivothigh(high, depthInput, depthInput), barmerge.gaps_off, barmerge.lookahead_off)
pL_M = request.security(syminfo.tickerid, "M", ta.pivotlow(low, depthInput, depthInput), barmerge.gaps_off, barmerge.lookahead_off)

pH_W = request.security(syminfo.tickerid, "W", ta.pivothigh(high, depthInput, depthInput), barmerge.gaps_off, barmerge.lookahead_off)
pL_W = request.security(syminfo.tickerid, "W", ta.pivotlow(low, depthInput, depthInput), barmerge.gaps_off, barmerge.lookahead_off)

pH_D = request.security(syminfo.tickerid, "D", ta.pivothigh(high, depthInput, depthInput), barmerge.gaps_off, barmerge.lookahead_off)
pL_D = request.security(syminfo.tickerid, "D", ta.pivotlow(low, depthInput, depthInput), barmerge.gaps_off, barmerge.lookahead_off)

// Applicazione sui cambi di pivot
if not na(pH_M) and (na(pH_M[1]) or pH_M != pH_M[1])
    f_addOrMergeZone(pH_M, true, "1M", colM)
if not na(pL_M) and (na(pL_M[1]) or pL_M != pL_M[1])
    f_addOrMergeZone(pL_M, false, "1M", colM)

if timeframe.isweekly or timeframe.isdaily or timeframe.isintraday
    if not na(pH_W) and (na(pH_W[1]) or pH_W != pH_W[1])
        f_addOrMergeZone(pH_W, true, "1W", colW)
    if not na(pL_W) and (na(pL_W[1]) or pL_W != pL_W[1])
        f_addOrMergeZone(pL_W, false, "1W", colW)

if timeframe.isdaily or timeframe.isintraday
    if not na(pH_D) and (na(pH_D[1]) or pH_D != pH_D[1])
        f_addOrMergeZone(pH_D, true, "1D", colD)
    if not na(pL_D) and (na(pL_D[1]) or pL_D != pL_D[1])
        f_addOrMergeZone(pL_D, false, "1D", colD)