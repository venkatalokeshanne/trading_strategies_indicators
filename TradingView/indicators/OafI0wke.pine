//@version=6
indicator(title="Thach Ichimoku Cloud", shorttitle="Thach Ichimoku", overlay=true)

// ===== Ichimoku chính =====

conversionPeriods = input.int(9, minval=1, title="Conversion Line Length")
basePeriods = input.int(17, minval=1, title="Base Line Length")
laggingSpan2Periods = input.int(26, minval=1, title="Leading Span B Length")
displacement = input.int(26, minval=1, title="Lagging Span")

// ===== Đường 65 / 129 =====

conversionPeriods65 = input.int(65, minval=1, title="Line 65")
basePeriods129 = input.int(129, minval=1, title="Line 129")

// ===== Mây phụ =====

conversionPeriods1 = input.int(9, minval=1, title="Line 3")
basePeriods1 = input.int(9, minval=1, title="Line 4")
laggingSpan2Periods1 = input.int(17, minval=1, title="Leading Span Length")
displacement1 = input.int(1, minval=1, title="Lagging Span")

// ===== Hàm Donchian =====

donchian(len) =>
    math.avg(ta.lowest(len), ta.highest(len))

// ===== Ichimoku chính =====

conversionLine = donchian(conversionPeriods)
baseLine = donchian(basePeriods)

leadLine1 = math.avg(conversionLine, baseLine)
leadLine2 = donchian(laggingSpan2Periods)

// ===== Đường 65 / 129 =====

conversionLine65 = donchian(conversionPeriods65)
baseLine129 = donchian(basePeriods129)

// ===== Mây phụ =====

conversionLine1 = donchian(conversionPeriods1)
baseLine1 = donchian(basePeriods1)

leadLine3 = math.avg(conversionLine1, baseLine1)
leadLine4 = donchian(laggingSpan2Periods1)

// ===== Vẽ Ichimoku chính =====

plot(conversionLine, color=color.rgb(41, 98, 255, 60), title="Conversion Line Length")
plot(baseLine, color=color.rgb(242, 54, 69, 60), title="Base Line Length")

plot(conversionLine65, color=color.rgb(245, 124, 0), title="Line 65")
plot(baseLine129, color=color.rgb(156, 39, 176, 0), title="Line 129")

plot(close, offset=-displacement + 1, color=color.rgb(128, 128, 128, 60), title="Lagging Span")

p1 = plot(leadLine1, offset=displacement - 1, color=color.rgb(76, 175, 80, 60), title="Span A")
p2 = plot(leadLine2, offset=displacement - 1, color=color.rgb(242, 54, 69, 60), title="Span B")

fill(p1,p2,title="Cloud Fill",color=leadLine1 > leadLine2? color.rgb(76, 175, 80, 80): color.rgb(242, 54, 69, 80))

// ===== Mây phụ =====

p3 = plot(leadLine3,offset=displacement1 - 1,color=color.new(color.blue, 100),display=display.none)
p4 = plot(leadLine4,offset=displacement1 - 1,color=color.new(color.gray, 100),display=display.none)

fill(p3,p4,title="Cloud Fill 2",color=leadLine3 > leadLine4? color.rgb(49, 121, 245,80): color.rgb(128, 128, 128,80))

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CÁC MỐC NẾN
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

int candle199 = 199
int candle128 = 128
int candle64 = 64
int candle51 = 51
int candle25 = 25
int candle16 = 16
int candle8 = 8

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// HIỂN THỊ CÁC MỐC
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

showCandleLines = input.bool(true, "Hiển thị đường mốc nến")
showLabels = input.bool(true, "Hiển thị nhãn mốc nến")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MÀU ĐƯỜNG MỐC
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

color color199 = input.color(
     color.rgb(29, 210, 104, 80),
     "Màu nến 200"
     )

color color128 = input.color(
     color.rgb(29, 210, 104, 80),
     "Màu nến 129"
     )

color color64 = input.color(
     color.rgb(29, 210, 104, 80),
     "Màu nến 65"
     )

color color51 = input.color(
     color.rgb(29, 210, 104, 80),
     "Màu nến 52"
     )

color color25 = input.color(
     color.rgb(29, 210, 104, 80),
     "Màu nến 26"
     )

color color16 = input.color(
     color.rgb(29, 210, 104, 80),
     "Màu nến 17"
     )

color color8 = input.color(
     color.rgb(29, 210, 104, 80),
     "Màu nến 9"
     )

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MÀU NHÃN
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

color color199t = color.rgb(29, 210, 104, 80)
color color128t = color.rgb(29, 210, 104, 80)
color color64t = color.rgb(29, 210, 104, 80)
color color51t = color.rgb(29, 210, 104, 80)
color color25t = color.rgb(29, 210, 104, 80)
color color16t = color.rgb(29, 210, 104, 80)
color color8t = color.rgb(29, 210, 104, 80)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// XÁC ĐỊNH VỊ TRÍ CÁC NẾN
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bool is199 = bar_index == last_bar_index - candle199
bool is128 = bar_index == last_bar_index - candle128
bool is64 = bar_index == last_bar_index - candle64
bool is51 = bar_index == last_bar_index - candle51
bool is25 = bar_index == last_bar_index - candle25
bool is16 = bar_index == last_bar_index - candle16
bool is8 = bar_index == last_bar_index - candle8

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// VẼ ĐƯỜNG THẲNG ĐỨNG
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if showCandleLines and is199
    line.new(
         bar_index,
         low,
         bar_index,
         high,
         xloc=xloc.bar_index,
         extend=extend.both,
         color=color199,
         width=2
         )

if showCandleLines and is128
    line.new(
         bar_index,
         low,
         bar_index,
         high,
         xloc=xloc.bar_index,
         extend=extend.both,
         color=color128,
         width=2
         )

if showCandleLines and is64
    line.new(
         bar_index,
         low,
         bar_index,
         high,
         xloc=xloc.bar_index,
         extend=extend.both,
         color=color64,
         width=2
         )

if showCandleLines and is51
    line.new(
         bar_index,
         low,
         bar_index,
         high,
         xloc=xloc.bar_index,
         extend=extend.both,
         color=color51,
         width=2
         )

if showCandleLines and is25
    line.new(
         bar_index,
         low,
         bar_index,
         high,
         xloc=xloc.bar_index,
         extend=extend.both,
         color=color25,
         width=2
         )

if showCandleLines and is16
    line.new(
         bar_index,
         low,
         bar_index,
         high,
         xloc=xloc.bar_index,
         extend=extend.both,
         color=color16,
         width=2
         )

if showCandleLines and is8
    line.new(
         bar_index,
         low,
         bar_index,
         high,
         xloc=xloc.bar_index,
         extend=extend.both,
         color=color8,
         width=2
         )

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// NHÃN MỐC NẾN
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

plotshape(
     showLabels and is199,
     title="Nến 200",
     style=shape.labeldown,
     location=location.abovebar,
     color=color199t,
     text="200",
     textcolor=color.black,
     size=size.small
     )

plotshape(
     showLabels and is128,
     title="Nến 129",
     style=shape.labeldown,
     location=location.abovebar,
     color=color128t,
     text="129",
     textcolor=color.black,
     size=size.small
     )

plotshape(
     showLabels and is64,
     title="Nến 65",
     style=shape.labeldown,
     location=location.abovebar,
     color=color64t,
     text="65",
     textcolor=color.black,
     size=size.small
     )

plotshape(
     showLabels and is51,
     title="Nến 52",
     style=shape.labeldown,
     location=location.abovebar,
     color=color51t,
     text="52",
     textcolor=color.black,
     size=size.small
     )

plotshape(
     showLabels and is25,
     title="Nến 26",
     style=shape.labeldown,
     location=location.abovebar,
     color=color25t,
     text="26",
     textcolor=color.black,
