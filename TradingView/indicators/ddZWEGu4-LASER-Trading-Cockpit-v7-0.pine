bool showVwapSdBand3 = input.bool(true, "Show Band 3", inline = "sd3", group = G_VWAPSD)
float vwapSdMultiplier3 = input.float(3.0, "×", minval = 0.1, step = 0.25, inline = "sd3", group = G_VWAPSD)

color fast1mColor = input.color(color.rgb(245, 158, 11), "1m Fast EMA", group = G_STYLE)
color slow1mColor = input.color(color.rgb(105, 183, 208), "1m Slow EMA", group = G_STYLE)
