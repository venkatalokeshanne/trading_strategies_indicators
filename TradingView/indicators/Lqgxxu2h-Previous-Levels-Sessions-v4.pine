//@version=6
indicator("Previous Levels + Sessions v4", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ╔══════════════════════════════════════════════════════════════╗
// ║                        INPUTS                               ║
// ╚══════════════════════════════════════════════════════════════╝

grpShow = "Zobrazení úrovní"
showPD    = input.bool(true,  "PDH / PDL",   group=grpShow)
showPPD   = input.bool(true,  "PPDH / PPDL", group=grpShow)
showPW    = input.bool(true,  "PWH / PWL",   group=grpShow)
showPPW   = input.bool(true,  "PPWH / PPWL", group=grpShow)
showPM    = input.bool(true,  "PMH / PML",   group=grpShow)
showTexts = input.bool(true,  "Zobrazit pravé popisky", group=grpShow)
showPrice = input.bool(false, "Zobrazit cenu v popisku", group=grpShow)

grpStyle = "Vzhled úrovní"
lineWidth      = input.int(1, "Tloušťka čáry", minval=1, maxval=4, group=grpStyle)
lineStyleInput = input.string("Dotted", "Styl čáry", options=["Dotted", "Dashed", "Solid"], group=grpStyle)
rightLabelBars = input.int(5, "Posun pravého popisku (v barech)", minval=1, maxval=50, group=grpStyle)

grpColors = "Barvy úrovní"
colPD  = input.color(color.white,               "PDH / PDL",   group=grpColors)
colPPD = input.color(color.new(color.gray, 0),  "PPDH / PPDL", group=grpColors)
colPW  = input.color(color.new(color.aqua, 0),  "PWH / PWL",   group=grpColors)
colPPW = input.color(color.new(color.blue, 0),  "PPWH / PPWL", group=grpColors)
colPM  = input.color(color.new(color.orange,0), "PMH / PML",   group=grpColors)

// ── SESSION INPUTS ──────────────────────────────────────────────
grpSess = "Session zóny"
showAsia     = input.bool(true, "Asia session",          group=grpSess)
showLondon   = input.bool(true, "London session",        group=grpSess)
showNY       = input.bool(true, "NY session",            group=grpSess)
showNYO      = input.bool(true, "NYO linie (půlnoc NY)", group=grpSess)
sessLookback = input.int(3,     "Počet session zpět", minval=1, maxval=10, group=grpSess)

// Všechny časy jsou v UTC (TradingView interně používá UTC).
// Převod na pražský čas: UTC+1 zimní (CET) / UTC+2 letní (CEST)
//
// Asia:   00:00–06:00 UTC = 01:00–07:00 CET  / 02:00–08:00 CEST
// London: 07:00–12:30 UTC = 08:00–13:30 CET  / 09:00–14:30 CEST
// NY:     13:30–19:00 UTC = 14:30–20:00 CET  / 15:30–21:00 CEST
// NYO:    05:00 UTC       = 06:00 CET         / 07:00 CEST
//
// DST offset: použij 0 pro zimní čas (CET = UTC+1), 1 pro letní čas (CEST = UTC+2)
dstOffset = input.int(0, "DST offset (0 = CET/zimní, 1 = CEST/letní)", minval=-2, maxval=2, group=grpSess)

// Časy jsou v UTC. Pražský čas (CET=UTC+1): Asia 01-07h, London 08-13:30h, NY 14:30-20h
// V UTC tedy: Asia 00-06, London 07-12:30, NY 13:30-19:00
asiaStartH = input.int(0,  "Asia start (UTC h)",      minval=0, maxval=23, group=grpSess)
asiaEndH   = input.int(6,  "Asia end   (UTC h)",      minval=0, maxval=23, group=grpSess)
lonStartH  = input.int(7,  "London start (UTC h)",    minval=0, maxval=23, group=grpSess)
lonEndH    = input.int(12, "London end   (UTC h)",    minval=0, maxval=23, group=grpSess)
lonEndM    = input.int(30, "London end   (UTC min)",  minval=0, maxval=59, group=grpSess)
nyStartH   = input.int(13, "NY start (UTC h)",        minval=0, maxval=23, group=grpSess)
nyStartM   = input.int(30, "NY start (UTC min)",      minval=0, maxval=59, group=grpSess)
nyEndH     = input.int(19, "NY end   (UTC h)",        minval=0, maxval=23, group=grpSess)

grpSessColors = "Barvy session"
colAsia   = input.color(color.new(color.yellow, 0), "Asia",      group=grpSessColors)
colLondon = input.color(color.new(color.blue,   0), "London",    group=grpSessColors)
colNY     = input.color(color.new(color.green,  0), "NY",        group=grpSessColors)
colNYO    = input.color(color.new(color.white,  0), "NYO linie", group=grpSessColors)
nyo_width     = input.int(1, "NYO tloušťka čáry", minval=1, maxval=4, group=grpSessColors)
nyo_style_inp = input.string("Dotted", "NYO styl čáry", options=["Dotted","Dashed","Solid"], group=grpSessColors)

grpSessStyle      = "Styl session zón"
sessHorizOnly     = input.bool(true, "Pouze horizontální ohraničení (top/bottom)", group=grpSessStyle)
sessBgOpacity     = input.int(95,  "Opacity pozadí (0=plné, 100=průhledné)",      group=grpSessStyle, minval=0, maxval=100)
sessBorderOpacity = input.int(0,   "Opacity ohraničení (0=plné, 100=průhledné)",  group=grpSessStyle, minval=0, maxval=100)
sessBorderWidth   = input.int(1,   "Tloušťka ohraničení",                         group=grpSessStyle, minval=1, maxval=4)

grpSessLevels     = "Session levely (H/L linie)"
showAsiaHL        = input.bool(true,  "Asia High / Low linie",   group=grpSessLevels)
showLondonHL      = input.bool(true,  "London High / Low linie", group=grpSessLevels)
showNYHL          = input.bool(true,  "NY High / Low linie",     group=grpSessLevels)
sessLevelStyleInp = input.string("Dotted", "Styl session levelů", options=["Dotted","Dashed","Solid"], group=grpSessLevels)
sessLevelWidth    = input.int(1, "Tloušťka session levelů", minval=1, maxval=4, group=grpSessLevels)

// ╔══════════════════════════════════════════════════════════════╗
// ║                        STYLES                               ║
// ╚══════════════════════════════════════════════════════════════╝
objLineStyle =
     lineStyleInput == "Dotted" ? line.style_dotted :
     lineStyleInput == "Dashed" ? line.style_dashed :
                                  line.style_solid

nyoLineStyle =
     nyo_style_inp == "Dotted" ? line.style_dotted :
     nyo_style_inp == "Dashed" ? line.style_dashed :
                                 line.style_solid

barMs       = int(math.max(1, timeframe.in_seconds()) * 1000)
MS_PER_HOUR = 3600000

// ╔══════════════════════════════════════════════════════════════╗
// ║               PERIOD CHANGE DETECTION                       ║
// ╚══════════════════════════════════════════════════════════════╝
newDay   = ta.change(time("D")) != 0
newWeek  = ta.change(time("W")) != 0
newMonth = ta.change(time("M")) != 0

// ╔══════════════════════════════════════════════════════════════╗
// ║         TRACK CURRENT PERIOD EXTREMES                       ║
// ╚══════════════════════════════════════════════════════════════╝

// ---------- DAY ----------
var float curDayHigh     = na
var float curDayLow      = na
var int   curDayHighTime = na
var int   curDayLowTime  = na
var int   curDayHighIdx  = na
var int   curDayLowIdx   = na

var float pdh_raw   = na
var float pdl_raw   = na
var int   pdh_t_raw = na
var int   pdl_t_raw = na
var int   pdh_i_raw = na
var int   pdl_i_raw = na

var float ppdh_raw   = na
var float ppdl_raw   = na
var int   ppdh_t_raw = na
var int   ppdl_t_raw = na
var int   ppdh_i_raw = na
var int   ppdl_i_raw = na

// ---------- WEEK ----------
var float curWeekHigh     = na
var float curWeekLow      = na
var int   curWeekHighTime = na
var int   curWeekLowTime  = na
var int   curWeekHighIdx  = na
var int   curWeekLowIdx   = na

var float pwh_raw   = na
var float pwl_raw   = na
var int   pwh_t_raw = na
var int   pwl_t_raw = na
var int   pwh_i_raw = na
var int   pwl_i_raw = na

var float ppwh_raw   = na
var float ppwl_raw   = na
var int   ppwh_t_raw = na
var int   ppwl_t_raw = na
var int   ppwh_i_raw = na
var int   ppwl_i_raw = na

// ---------- MONTH ----------
var float curMonthHigh     = na
var float curMonthLow      = na
var int   curMonthHighTime = na
var int   curMonthLowTime  = na
var int   curMonthHighIdx  = na
var int   curMonthLowIdx   = na

var float pmh_raw   = na
var float pml_raw   = na
var int   pmh_t_raw = na
var int   pml_t_raw = na
var int   pmh_i_raw = na
var int   pml_i_raw = na

if barstate.isfirst
    curDayHigh      := high
    curDayLow       := low
    curDayHighTime  := time
    curDayLowTime   := time
    curDayHighIdx   := bar_index
    curDayLowIdx    := bar_index
    curWeekHigh     := high
    curWeekLow      := low
    curWeekHighTime := time
    curWeekLowTime  := time
    curWeekHighIdx  := bar_index
    curWeekLowIdx   := bar_index
    curMonthHigh     := high
    curMonthLow      := low
    curMonthHighTime := time
    curMonthLowTime  := time
    curMonthHighIdx  := bar_index
    curMonthLowIdx   := bar_index
else
    // ----- DAY -----
    if newDay
        ppdh_raw   := pdh_raw
        ppdh_t_raw := pdh_t_raw
        ppdh_i_raw := pdh_i_raw
        ppdl_raw   := pdl_raw
        ppdl_t_raw := pdl_t_raw
        ppdl_i_raw := pdl_i_raw
        pdh_raw    := curDayHigh
        pdh_t_raw  := curDayHighTime
        pdh_i_raw  := curDayHighIdx
        pdl_raw    := curDayLow
        pdl_t_raw  := curDayLowTime
        pdl_i_raw  := curDayLowIdx
        curDayHigh     := high
        curDayLow      := low
        curDayHighTime := time
        curDayLowTime  := time
        curDayHighIdx  := bar_index
        curDayLowIdx   := bar_index
    else
        if na(curDayHigh) or high > curDayHigh
            curDayHigh     := high
            curDayHighTime := time
            curDayHighIdx  := bar_index
        if na(curDayLow) or low < curDayLow
            curDayLow     := low
            curDayLowTime := time
            curDayLowIdx  := bar_index

    // ----- WEEK -----
    if newWeek
        ppwh_raw   := pwh_raw
        ppwh_t_raw := pwh_t_raw
        ppwh_i_raw := pwh_i_raw
        ppwl_raw   := pwl_raw
        ppwl_t_raw := pwl_t_raw
        ppwl_i_raw := pwl_i_raw
        pwh_raw    := curWeekHigh
        pwh_t_raw  := curWeekHighTime
        pwh_i_raw  := curWeekHighIdx
        pwl_raw    := curWeekLow
        pwl_t_raw  := curWeekLowTime
        pwl_i_raw  := curWeekLowIdx
        curWeekHigh     := high
        curWeekLow      := low
        curWeekHighTime := time
        curWeekLowTime  := time
        curWeekHighIdx  := bar_index
        curWeekLowIdx   := bar_index
    else
        if na(curWeekHigh) or high > curWeekHigh
            curWeekHigh     := high
            curWeekHighTime := time
            curWeekHighIdx  := bar_index
        if na(curWeekLow) or low < curWeekLow
            curWeekLow     := low
            curWeekLowTime := time
            curWeekLowIdx  := bar_index

    // ----- MONTH -----
    if newMonth
        pmh_raw   := curMonthHigh
        pmh_t_raw := curMonthHighTime
        pmh_i_raw := curMonthHighIdx
        pml_raw   := curMonthLow
        pml_t_raw := curMonthLowTime
        pml_i_raw := curMonthLowIdx
        curMonthHigh     := high
        curMonthLow      := low
        curMonthHighTime := time
        curMonthLowTime  := time
        curMonthHighIdx  := bar_index
        curMonthLowIdx   := bar_index
    else
        if na(curMonthHigh) or high > curMonthHigh
            curMonthHigh     := high
            curMonthHighTime := time
            curMonthHighIdx  := bar_index
        if na(curMonthLow) or low < curMonthLow
            curMonthLow     := low
            curMonthLowTime := time
            curMonthLowIdx  := bar_index

// ╔══════════════════════════════════════════════════════════════╗
// ║              FREEZE TO LAST BAR CONTEXT                     ║
// ╚══════════════════════════════════════════════════════════════╝
pdh   = ta.valuewhen(time == last_bar_time, pdh_raw,   0)
pdl   = ta.valuewhen(time == last_bar_time, pdl_raw,   0)
pdh_t = ta.valuewhen(time == last_bar_time, pdh_t_raw, 0)
pdl_t = ta.valuewhen(time == last_bar_time, pdl_t_raw, 0)

ppdh   = ta.valuewhen(time == last_bar_time, ppdh_raw,   0)
ppdl   = ta.valuewhen(time == last_bar_time, ppdl_raw,   0)
ppdh_t = ta.valuewhen(time == last_bar_time, ppdh_t_raw, 0)
ppdl_t = ta.valuewhen(time == last_bar_time, ppdl_t_raw, 0)

pwh   = ta.valuewhen(time == last_bar_time, pwh_raw,   0)
pwl   = ta.valuewhen(time == last_bar_time, pwl_raw,   0)
pwh_t = ta.valuewhen(time == last_bar_time, pwh_t_raw, 0)
pwl_t = ta.valuewhen(time == last_bar_time, pwl_t_raw, 0)

ppwh   = ta.valuewhen(time == last_bar_time, ppwh_raw,   0)
ppwl   = ta.valuewhen(time == last_bar_time, ppwl_raw,   0)
ppwh_t = ta.valuewhen(time == last_bar_time, ppwh_t_raw, 0)
ppwl_t = ta.valuewhen(time == last_bar_time, ppwl_t_raw, 0)

pmh   = ta.valuewhen(time == last_bar_time, pmh_raw,   0)
pml   = ta.valuewhen(time == last_bar_time, pml_raw,   0)
pmh_t = ta.valuewhen(time == last_bar_time, pmh_t_raw, 0)
pml_t = ta.valuewhen(time == last_bar_time, pml_t_raw, 0)

// ╔══════════════════════════════════════════════════════════════╗
// ║              HELPER FUNCTIONS – LEVELS                      ║
// ╚══════════════════════════════════════════════════════════════╝
f_txt(string _name, float _price) =>
    showPrice ? _name + " " + str.tostring(_price, format.mintick) : _name

f_updateMainLine(line _ln, bool _show, float _price, int _startTime, color _col) =>
    line _result = _ln
    int  _rightTime = last_bar_time + barMs * rightLabelBars
    bool _ok = _show and not na(_price) and not na(_startTime)
    if _ok
        if na(_result)
            _result := line.new(_startTime, _price, _rightTime, _price,
                 xloc=xloc.bar_time, extend=extend.none,
                 color=_col, style=objLineStyle, width=lineWidth)
        else
            line.set_x1(_result, _startTime)
            line.set_y1(_result, _price)
            line.set_x2(_result, _rightTime)
            line.set_y2(_result, _price)
            line.set_color(_result, _col)
            line.set_style(_result, objLineStyle)
            line.set_width(_result, lineWidth)
    else
        if not na(_result)
            line.delete(_result)
            _result := na
    _result

f_updateRightLabel(label _lb, bool _show, float _price, string _txt, color _col) =>
    label _result = _lb
    int   _labelTime = last_bar_time + barMs * rightLabelBars
    bool  _ok = _show and not na(_price) and not na(_labelTime)
    if _ok
        if na(_result)
            _result := label.new(_labelTime, _price, _txt,
                 xloc=xloc.bar_time, yloc=yloc.price,
                 style=label.style_none, textcolor=_col,
                 size=size.small, textalign=text.align_left)
        else
            label.set_x(_result, _labelTime)
            label.set_y(_result, _price)
            label.set_text(_result, _txt)
            label.set_textcolor(_result, _col)
    else
        if not na(_result)
            label.delete(_result)
            _result := na
    _result

// ╔══════════════════════════════════════════════════════════════╗
// ║                 LEVEL OBJECTS                               ║
// ╚══════════════════════════════════════════════════════════════╝
var line  ln_PDH  = na
var line  ln_PDL  = na
var line  ln_PPDH = na
var line  ln_PPDL = na
var line  ln_PWH  = na
var line  ln_PWL  = na
var line  ln_PPWH = na
var line  ln_PPWL = na
var line  ln_PMH  = na
var line  ln_PML  = na

var label lb_PDH  = na
var label lb_PDL  = na
var label lb_PPDH = na
var label lb_PPDL = na
var label lb_PWH  = na
var label lb_PWL  = na
var label lb_PPWH = na
var label lb_PPWL = na
var label lb_PMH  = na
var label lb_PML  = na

if barstate.islast
    ln_PDH  := f_updateMainLine(ln_PDH,  showPD,  pdh,  pdh_t,  colPD)
    ln_PDL  := f_updateMainLine(ln_PDL,  showPD,  pdl,  pdl_t,  colPD)
    ln_PPDH := f_updateMainLine(ln_PPDH, showPPD, ppdh, ppdh_t, colPPD)
    ln_PPDL := f_updateMainLine(ln_PPDL, showPPD, ppdl, ppdl_t, colPPD)
    ln_PWH  := f_updateMainLine(ln_PWH,  showPW,  pwh,  pwh_t,  colPW)
    ln_PWL  := f_updateMainLine(ln_PWL,  showPW,  pwl,  pwl_t,  colPW)
    ln_PPWH := f_updateMainLine(ln_PPWH, showPPW, ppwh, ppwh_t, colPPW)
    ln_PPWL := f_updateMainLine(ln_PPWL, showPPW, ppwl, ppwl_t, colPPW)
    ln_PMH  := f_updateMainLine(ln_PMH,  showPM,  pmh,  pmh_t,  colPM)
    ln_PML  := f_updateMainLine(ln_PML,  showPM,  pml,  pml_t,  colPM)

    lb_PDH  := f_updateRightLabel(lb_PDH,  showTexts and showPD,  pdh,  f_txt("PDH",  pdh),  colPD)
    lb_PDL  := f_updateRightLabel(lb_PDL,  showTexts and showPD,  pdl,  f_txt("PDL",  pdl),  colPD)
    lb_PPDH := f_updateRightLabel(lb_PPDH, showTexts and showPPD, ppdh, f_txt("PPDH", ppdh), colPPD)
    lb_PPDL := f_updateRightLabel(lb_PPDL, showTexts and showPPD, ppdl, f_txt("PPDL", ppdl), colPPD)
    lb_PWH  := f_updateRightLabel(lb_PWH,  showTexts and showPW,  pwh,  f_txt("PWH",  pwh),  colPW)
    lb_PWL  := f_updateRightLabel(lb_PWL,  showTexts and showPW,  pwl,  f_txt("PWL",  pwl),  colPW)
    lb_PPWH := f_updateRightLabel(lb_PPWH, showTexts and showPPW, ppwh, f_txt("PPWH", ppwh), colPPW)
    lb_PPWL := f_updateRightLabel(lb_PPWL, showTexts and showPPW, ppwl, f_txt("PPWL", ppwl), colPPW)
    lb_PMH  := f_updateRightLabel(lb_PMH,  showTexts and showPM,  pmh,  f_txt("PMH",  pmh),  colPM)
    lb_PML  := f_updateRightLabel(lb_PML,  showTexts and showPM,  pml,  f_txt("PML",  pml),  colPM)

// ╔══════════════════════════════════════════════════════════════╗
// ║              SESSION ZONES + NYO                            ║
// ╚══════════════════════════════════════════════════════════════╝

f_utcHour(int t)   => hour(t, "UTC")
f_utcMinute(int t) => minute(t, "UTC")

f_dayStartUTC(int t) =>
    int secInDay = hour(t, "UTC") * 3600 + minute(t, "UTC") * 60 + second(t, "UTC")
    t - secInDay * 1000

// Efektivní UTC hodiny s DST korekcí
int asiaStartHeff = (asiaStartH + dstOffset + 24) % 24
int asiaEndHeff   = (asiaEndH   + dstOffset + 24) % 24
int lonStartHeff  = (lonStartH  + dstOffset + 24) % 24
int lonEndHeff    = (lonEndH    + dstOffset + 24) % 24
int nyStartHeff   = (nyStartH   + dstOffset + 24) % 24
int nyEndHeff     = (nyEndH     + dstOffset + 24) % 24
int nyoHeff       = (5          - dstOffset + 24) % 24  // NYO = 00:00 ET; zimní ET=UTC-5 → 05:00 UTC; letní ET=UTC-4 → 04:00 UTC

int  curUTCH = f_utcHour(time)
int  curUTCM = f_utcMinute(time)

bool isAsiaOpen   = showAsia   and curUTCH == asiaStartHeff and curUTCM == 0
bool isLondonOpen = showLondon and curUTCH == lonStartHeff  and curUTCM == 0
bool isNYOpen     = showNY     and curUTCH == nyStartHeff   and curUTCM == nyStartM
bool isNYOBar     = showNYO    and curUTCH == nyoHeff       and curUTCM == 0

// ── Session arrays ───────────────────────────────────────────
// Každá session má box (výplň) + volitelně 2 linie top/bottom (ohraničení)
var box[]  asiaBoxes    = array.new<box>()
var box[]  lonBoxes     = array.new<box>()
var box[]  nyBoxes      = array.new<box>()
var line[] asiaTopLines = array.new<line>()
var line[] asiaBotLines = array.new<line>()
var line[] lonTopLines  = array.new<line>()
var line[] lonBotLines  = array.new<line>()
var line[] nyTopLines   = array.new<line>()
var line[] nyBotLines   = array.new<line>()

var box  asiaOpenBox  = na
var int  asiaOpenTime = na
var line asiaTopLine  = na
var line asiaBotLine  = na
var box  lonOpenBox   = na
var int  lonOpenTime  = na
var line lonTopLine   = na
var line lonBotLine   = na
var box  nyOpenBox    = na
var int  nyOpenTime   = na
var line nyTopLine    = na
var line nyBotLine    = na

f_trimBoxArray(arr, int maxN) =>
    while array.size(arr) > maxN
        obj = array.shift(arr)
        box.delete(obj)

f_trimLineArr(arr, int maxN) =>
    while array.size(arr) > maxN
        obj = array.shift(arr)
        line.delete(obj)

// Box vždy bez border (border řeší linie zvlášť v horiz módu, nebo plný border v plném módu)
f_newBox(int x1, float top, float bot, color col) =>
    box.new(x1, top, x1 + barMs, bot,
         border_color = sessHorizOnly ? color.new(col, 100) : color.new(col, sessBorderOpacity),
         bgcolor      = color.new(col, sessBgOpacity),
         border_width = sessHorizOnly ? 1 : sessBorderWidth,
         xloc         = xloc.bar_time)

// Horizontální linie pro top nebo bottom ohraničení
f_newHorizLine(int x1, float price, color col) =>
    line.new(x1, price, x1 + barMs, price,
         xloc   = xloc.bar_time,
         extend = extend.none,
         color  = color.new(col, sessBorderOpacity),
         style  = line.style_solid,
         width  = sessBorderWidth)

// ── ASIA ─────────────────────────────────────────────────────
if isAsiaOpen
    // Uzavři předchozí
    if not na(asiaOpenBox)
        box.set_right(asiaOpenBox, time)
        array.push(asiaBoxes, asiaOpenBox)
        f_trimBoxArray(asiaBoxes, sessLookback)
        asiaOpenBox := na
    if not na(asiaTopLine)
        array.push(asiaTopLines, asiaTopLine)
        array.push(asiaBotLines, asiaBotLine)
        f_trimLineArr(asiaTopLines, sessLookback)
        f_trimLineArr(asiaBotLines, sessLookback)
        asiaTopLine := na
        asiaBotLine := na
    // Otevři nový – box vždy (výplň), linie navíc pokud sessHorizOnly
    asiaOpenBox := f_newBox(time, high, low, colAsia)
    if sessHorizOnly
        asiaTopLine := f_newHorizLine(time, high, colAsia)
        asiaBotLine := f_newHorizLine(time, low,  colAsia)
    asiaOpenTime := time

if not na(asiaOpenBox)
    bool inAsia = asiaStartHeff > asiaEndHeff ?
         (curUTCH >= asiaStartHeff or curUTCH < asiaEndHeff) :
         (curUTCH >= asiaStartHeff and curUTCH < asiaEndHeff)
    if inAsia
        float bTop = box.get_top(asiaOpenBox)
        float bBot = box.get_bottom(asiaOpenBox)
        float newTop = math.max(nz(bTop, high), high)
        float newBot = math.min(nz(bBot, low),  low)
        box.set_top(asiaOpenBox,    newTop)
        box.set_bottom(asiaOpenBox, newBot)
        box.set_right(asiaOpenBox,  time + barMs)
        box.set_bgcolor(asiaOpenBox, color.new(colAsia, sessBgOpacity))
        box.set_border_color(asiaOpenBox, sessHorizOnly ? color.new(colAsia, 100) : color.new(colAsia, sessBorderOpacity))
        box.set_border_width(asiaOpenBox, sessBorderWidth)
        if sessHorizOnly and not na(asiaTopLine)
            line.set_y1(asiaTopLine, newTop)
            line.set_y2(asiaTopLine, newTop)
            line.set_x2(asiaTopLine, time + barMs)
            line.set_color(asiaTopLine, color.new(colAsia, sessBorderOpacity))
            line.set_width(asiaTopLine, sessBorderWidth)
            line.set_y1(asiaBotLine, newBot)
            line.set_y2(asiaBotLine, newBot)
            line.set_x2(asiaBotLine, time + barMs)
            line.set_color(asiaBotLine, color.new(colAsia, sessBorderOpacity))
            line.set_width(asiaBotLine, sessBorderWidth)
    else
        if not na(asiaOpenBox)
            box.set_right(asiaOpenBox, time)
            array.push(asiaBoxes, asiaOpenBox)
            f_trimBoxArray(asiaBoxes, sessLookback)
            asiaOpenBox := na
        if not na(asiaTopLine)
            array.push(asiaTopLines, asiaTopLine)
            array.push(asiaBotLines, asiaBotLine)
            f_trimLineArr(asiaTopLines, sessLookback)
            f_trimLineArr(asiaBotLines, sessLookback)
            asiaTopLine := na
            asiaBotLine := na

// ── LONDON ───────────────────────────────────────────────────
if isLondonOpen
    if not na(lonOpenBox)
        box.set_right(lonOpenBox, time)
        array.push(lonBoxes, lonOpenBox)
        f_trimBoxArray(lonBoxes, sessLookback)
        lonOpenBox := na
    if not na(lonTopLine)
        array.push(lonTopLines, lonTopLine)
        array.push(lonBotLines, lonBotLine)
        f_trimLineArr(lonTopLines, sessLookback)
        f_trimLineArr(lonBotLines, sessLookback)
        lonTopLine := na
        lonBotLine := na
    lonOpenBox := f_newBox(time, high, low, colLondon)
    if sessHorizOnly
        lonTopLine := f_newHorizLine(time, high, colLondon)
        lonBotLine := f_newHorizLine(time, low,  colLondon)
    lonOpenTime := time

if not na(lonOpenBox)
    bool inLondon = curUTCH >= lonStartHeff and
         (curUTCH < lonEndHeff or (curUTCH == lonEndHeff and curUTCM < lonEndM))
    if inLondon
        float bTop = box.get_top(lonOpenBox)
        float bBot = box.get_bottom(lonOpenBox)
        float newTop = math.max(nz(bTop, high), high)
        float newBot = math.min(nz(bBot, low),  low)
        box.set_top(lonOpenBox,    newTop)
        box.set_bottom(lonOpenBox, newBot)
        box.set_right(lonOpenBox,  time + barMs)
        box.set_bgcolor(lonOpenBox, color.new(colLondon, sessBgOpacity))
        box.set_border_color(lonOpenBox, sessHorizOnly ? color.new(colLondon, 100) : color.new(colLondon, sessBorderOpacity))
        box.set_border_width(lonOpenBox, sessBorderWidth)
        if sessHorizOnly and not na(lonTopLine)
            line.set_y1(lonTopLine, newTop)
            line.set_y2(lonTopLine, newTop)
            line.set_x2(lonTopLine, time + barMs)
            line.set_color(lonTopLine, color.new(colLondon, sessBorderOpacity))
            line.set_width(lonTopLine, sessBorderWidth)
            line.set_y1(lonBotLine, newBot)
            line.set_y2(lonBotLine, newBot)
            line.set_x2(lonBotLine, time + barMs)
            line.set_color(lonBotLine, color.new(colLondon, sessBorderOpacity))
            line.set_width(lonBotLine, sessBorderWidth)
    else
        if not na(lonOpenBox)
            box.set_right(lonOpenBox, time)
            array.push(lonBoxes, lonOpenBox)
            f_trimBoxArray(lonBoxes, sessLookback)
            lonOpenBox := na
        if not na(lonTopLine)
            array.push(lonTopLines, lonTopLine)
            array.push(lonBotLines, lonBotLine)
            f_trimLineArr(lonTopLines, sessLookback)
            f_trimLineArr(lonBotLines, sessLookback)
            lonTopLine := na
            lonBotLine := na

// ── NY ───────────────────────────────────────────────────────
if isNYOpen
    if not na(nyOpenBox)
        box.set_right(nyOpenBox, time)
        array.push(nyBoxes, nyOpenBox)
        f_trimBoxArray(nyBoxes, sessLookback)
        nyOpenBox := na
    if not na(nyTopLine)
        array.push(nyTopLines, nyTopLine)
        array.push(nyBotLines, nyBotLine)
        f_trimLineArr(nyTopLines, sessLookback)
        f_trimLineArr(nyBotLines, sessLookback)
        nyTopLine := na
        nyBotLine := na
    nyOpenBox := f_newBox(time, high, low, colNY)
    if sessHorizOnly
        nyTopLine := f_newHorizLine(time, high, colNY)
        nyBotLine := f_newHorizLine(time, low,  colNY)
    nyOpenTime := time

if not na(nyOpenBox)
    bool inNY = curUTCH >= nyStartHeff and curUTCH < nyEndHeff
    if inNY
        float bTop = box.get_top(nyOpenBox)
        float bBot = box.get_bottom(nyOpenBox)
        float newTop = math.max(nz(bTop, high), high)
        float newBot = math.min(nz(bBot, low),  low)
        box.set_top(nyOpenBox,    newTop)
        box.set_bottom(nyOpenBox, newBot)
        box.set_right(nyOpenBox,  time + barMs)
        box.set_bgcolor(nyOpenBox, color.new(colNY, sessBgOpacity))
        box.set_border_color(nyOpenBox, sessHorizOnly ? color.new(colNY, 100) : color.new(colNY, sessBorderOpacity))
        box.set_border_width(nyOpenBox, sessBorderWidth)
        if sessHorizOnly and not na(nyTopLine)
            line.set_y1(nyTopLine, newTop)
            line.set_y2(nyTopLine, newTop)
            line.set_x2(nyTopLine, time + barMs)
            line.set_color(nyTopLine, color.new(colNY, sessBorderOpacity))
            line.set_width(nyTopLine, sessBorderWidth)
            line.set_y1(nyBotLine, newBot)
            line.set_y2(nyBotLine, newBot)
            line.set_x2(nyBotLine, time + barMs)
            line.set_color(nyBotLine, color.new(colNY, sessBorderOpacity))
            line.set_width(nyBotLine, sessBorderWidth)
    else
        if not na(nyOpenBox)
            box.set_right(nyOpenBox, time)
            array.push(nyBoxes, nyOpenBox)
            f_trimBoxArray(nyBoxes, sessLookback)
            nyOpenBox := na
        if not na(nyTopLine)
            array.push(nyTopLines, nyTopLine)
            array.push(nyBotLines, nyBotLine)
            f_trimLineArr(nyTopLines, sessLookback)
            f_trimLineArr(nyBotLines, sessLookback)
            nyTopLine := na
            nyBotLine := na

// ╔══════════════════════════════════════════════════════════════╗
// ║                     NYO LEVEL                               ║
// ╚══════════════════════════════════════════════════════════════╝
// Horizontální level zakotvený od baru půlnoci NY (jako PDH/PDL).
// Cena = open prvního baru po půlnoci NY = ICT Midnight Open price.

var float nyoPrice     = na
var int   nyoStartTime = na

if isNYOBar
    nyoPrice     := open
    nyoStartTime := time

var line  ln_NYO = na
var label lb_NYO = na

if showNYO and not na(nyoPrice) and not na(nyoStartTime)
    int _rightTime = last_bar_time + barMs * rightLabelBars
    if na(ln_NYO)
        ln_NYO := line.new(nyoStartTime, nyoPrice, _rightTime, nyoPrice,
             xloc=xloc.bar_time, extend=extend.none,
             color=colNYO, style=nyoLineStyle, width=nyo_width)
    else
        line.set_x1(ln_NYO, nyoStartTime)
        line.set_y1(ln_NYO, nyoPrice)
        line.set_x2(ln_NYO, _rightTime)
        line.set_y2(ln_NYO, nyoPrice)
        line.set_color(ln_NYO, colNYO)
        line.set_style(ln_NYO, nyoLineStyle)
        line.set_width(ln_NYO, nyo_width)
    if showTexts
        if na(lb_NYO)
            lb_NYO := label.new(_rightTime, nyoPrice, f_txt("NYO", nyoPrice),
                 xloc=xloc.bar_time, yloc=yloc.price,
                 style=label.style_none, textcolor=colNYO,
                 size=size.small, textalign=text.align_left)
        else
            label.set_x(lb_NYO, _rightTime)
            label.set_y(lb_NYO, nyoPrice)
            label.set_text(lb_NYO, f_txt("NYO", nyoPrice))
            label.set_textcolor(lb_NYO, colNYO)
else
    if not na(ln_NYO)
        line.delete(ln_NYO)
        ln_NYO := na
    if not na(lb_NYO)
        label.delete(lb_NYO)
        lb_NYO := na

// ╔══════════════════════════════════════════════════════════════╗
// ║           SESSION HIGH / LOW LEVELY (jako PDH/PDL)          ║
// ╚══════════════════════════════════════════════════════════════╝
// Každá session po uzavření zanechá horizontální linii High a Low,
// zakotvenou od baru extrému a táhnoucí se doprava (stejný princip
// jako PDH/PDL). Linie se aktualizuje na každém baru.

sessLevelStyle =
     sessLevelStyleInp == "Dotted" ? line.style_dotted :
     sessLevelStyleInp == "Dashed" ? line.style_dashed :
                                     line.style_solid

// ── Tracking extrémy a jejich časy uvnitř každé session ─────
var float asiaHighVal  = na
var int   asiaHighT   = na
var float asiaLowVal   = na
var int   asiaLowT    = na
var float lonHighVal   = na
var int   lonHighT    = na
var float lonLowVal    = na
var int   lonLowT     = na
var float nyHighVal    = na
var int   nyHighT     = na
var float nyLowVal     = na
var int   nyLowT      = na

// Aktuální (otevřená) session – sledování průběžných extrémy
var float curAsiaHigh  = na
var int   curAsiaHighT = na
var float curAsiaLow   = na
var int   curAsiaLowT  = na
var float curLonHigh   = na
var int   curLonHighT  = na
var float curLonLow    = na
var int   curLonLowT   = na
var float curNYHigh    = na
var int   curNYHighT   = na
var float curNYLow     = na
var int   curNYLowT    = na

// Detekce konce session = session byla otevřena a teď jsme mimo ni
bool inAsiaNow   = asiaStartHeff > asiaEndHeff ?
     (curUTCH >= asiaStartHeff or curUTCH < asiaEndHeff) :
     (curUTCH >= asiaStartHeff and curUTCH < asiaEndHeff)
bool inLondonNow = curUTCH >= lonStartHeff and
     (curUTCH < lonEndHeff or (curUTCH == lonEndHeff and curUTCM < lonEndM))
bool inNYNow     = curUTCH >= nyStartHeff and curUTCH < nyEndHeff

// ── ASIA tracking ────────────────────────────────────────────
if isAsiaOpen
    // Nová session začíná – uložíme uzavřenou do levelů
    if not na(curAsiaHigh)
        asiaHighVal := curAsiaHigh
        asiaHighT   := curAsiaHighT
        asiaLowVal  := curAsiaLow
        asiaLowT    := curAsiaLowT
    curAsiaHigh  := high
    curAsiaHighT := time
    curAsiaLow   := low
    curAsiaLowT  := time
else if inAsiaNow
    if na(curAsiaHigh) or high > curAsiaHigh
        curAsiaHigh  := high
        curAsiaHighT := time
    if na(curAsiaLow) or low < curAsiaLow
        curAsiaLow  := low
        curAsiaLowT := time
else if not na(curAsiaHigh)
    // Session právě skončila – přesuň do levelů
    asiaHighVal := curAsiaHigh
    asiaHighT   := curAsiaHighT
    asiaLowVal  := curAsiaLow
    asiaLowT    := curAsiaLowT
    curAsiaHigh := na
    curAsiaLow  := na

// ── LONDON tracking ──────────────────────────────────────────
if isLondonOpen
    if not na(curLonHigh)
        lonHighVal := curLonHigh
        lonHighT   := curLonHighT
        lonLowVal  := curLonLow
        lonLowT    := curLonLowT
    curLonHigh  := high
    curLonHighT := time
    curLonLow   := low
    curLonLowT  := time
else if inLondonNow
    if na(curLonHigh) or high > curLonHigh
        curLonHigh  := high
        curLonHighT := time
    if na(curLonLow) or low < curLonLow
        curLonLow  := low
        curLonLowT := time
else if not na(curLonHigh)
    lonHighVal := curLonHigh
    lonHighT   := curLonHighT
    lonLowVal  := curLonLow
    lonLowT    := curLonLowT
    curLonHigh := na
    curLonLow  := na

// ── NY tracking ──────────────────────────────────────────────
if isNYOpen
    if not na(curNYHigh)
        nyHighVal := curNYHigh
        nyHighT   := curNYHighT
        nyLowVal  := curNYLow
        nyLowT    := curNYLowT
    curNYHigh  := high
    curNYHighT := time
    curNYLow   := low
    curNYLowT  := time
else if inNYNow
    if na(curNYHigh) or high > curNYHigh
        curNYHigh  := high
        curNYHighT := time
    if na(curNYLow) or low < curNYLow
        curNYLow  := low
        curNYLowT := time
else if not na(curNYHigh)
    nyHighVal := curNYHigh
    nyHighT   := curNYHighT
    nyLowVal  := curNYLow
    nyLowT    := curNYLowT
    curNYHigh := na
    curNYLow  := na

// ── Kreslení levelů (pouze na posledním baru) ────────────────
var line  ln_AsiaH = na
var label lb_AsiaH  = na
var line  ln_AsiaL = na
var label lb_AsiaL  = na
var line  ln_LonH  = na
var label lb_LonH   = na
var line  ln_LonL  = na
var label lb_LonL   = na
var line  ln_NYH   = na
var label lb_NYH    = na
var line  ln_NYL   = na
var label lb_NYL    = na

// Helper funkce pro session level linii (vrací line objekt)
f_slLine(line _ln, bool _show, float _price, int _t, color _col, int _rt) =>
    line _rl = _ln
    bool _ok = _show and not na(_price) and not na(_t)
    if _ok
        if na(_rl)
            _rl := line.new(_t, _price, _rt, _price,
                 xloc=xloc.bar_time, extend=extend.none,
                 color=_col, style=sessLevelStyle, width=sessLevelWidth)
        else
            line.set_x1(_rl, _t)
            line.set_y1(_rl, _price)
            line.set_x2(_rl, _rt)
            line.set_y2(_rl, _price)
            line.set_color(_rl, _col)
            line.set_style(_rl, sessLevelStyle)
            line.set_width(_rl, sessLevelWidth)
    else
        if not na(_rl)
            line.delete(_rl)
            _rl := na
    _rl

// Helper funkce pro session level label (vrací label objekt)
f_slLabel(label _ll, bool _show, float _price, string _name, color _col, int _rt) =>
    label _result = _ll
    bool  _ok = _show and showTexts and not na(_price)
    if _ok
        if na(_result)
            _result := label.new(_rt, _price, f_txt(_name, _price),
                 xloc=xloc.bar_time, yloc=yloc.price,
                 style=label.style_none, textcolor=_col,
                 size=size.small, textalign=text.align_left)
        else
            label.set_x(_result, _rt)
            label.set_y(_result, _price)
            label.set_text(_result, f_txt(_name, _price))
            label.set_textcolor(_result, _col)
    else
        if not na(_result)
            label.delete(_result)
            _result := na
    _result

if barstate.islast
    int _rt = last_bar_time + barMs * rightLabelBars

    ln_AsiaH := f_slLine(ln_AsiaH, showAsiaHL,   asiaHighVal, asiaHighT, colAsia,   _rt)
    lb_AsiaH := f_slLabel(lb_AsiaH, showAsiaHL,  asiaHighVal, "AsiaH",   colAsia,   _rt)
    ln_AsiaL := f_slLine(ln_AsiaL, showAsiaHL,   asiaLowVal,  asiaLowT,  colAsia,   _rt)
    lb_AsiaL := f_slLabel(lb_AsiaL, showAsiaHL,  asiaLowVal,  "AsiaL",   colAsia,   _rt)
    ln_LonH  := f_slLine(ln_LonH,  showLondonHL, lonHighVal,  lonHighT,  colLondon, _rt)
    lb_LonH  := f_slLabel(lb_LonH,  showLondonHL, lonHighVal, "LonH",    colLondon, _rt)
    ln_LonL  := f_slLine(ln_LonL,  showLondonHL, lonLowVal,   lonLowT,   colLondon, _rt)
    lb_LonL  := f_slLabel(lb_LonL,  showLondonHL, lonLowVal,  "LonL",    colLondon, _rt)
    ln_NYH   := f_slLine(ln_NYH,   showNYHL,     nyHighVal,   nyHighT,   colNY,     _rt)
    lb_NYH   := f_slLabel(lb_NYH,   showNYHL,    nyHighVal,   "NYH",     colNY,     _rt)
    ln_NYL   := f_slLine(ln_NYL,   showNYHL,     nyLowVal,    nyLowT,    colNY,     _rt)
    lb_NYL   := f_slLabel(lb_NYL,   showNYHL,    nyLowVal,    "NYL",     colNY,     _rt)
