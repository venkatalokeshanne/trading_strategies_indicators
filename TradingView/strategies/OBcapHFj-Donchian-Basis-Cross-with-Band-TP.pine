// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
strategy("Donchian Basis Cross with Band TP", overlay = true, initial_capital = 1000, default_qty_type = strategy.percent_of_equity, default_qty_value = 10)

// --- Inputs ---
// Donchian Settings
donchianLength = input.int(40, "Donchian Channel Length", minval = 1, group = "Donchian Settings", tooltip = "Adjusted to 40 (10 hours on 15m) to provide a more stable trend basis for BTC.")

// Session Filter Settings
useSession    = input.bool(true, "Use Session Filter", group = "Session Filter")
sessionTime   = input.session("0930-1600", "Trading Session", group = "Session Filter", tooltip = "Format: HHMM-HHMM. Example: 0930-1600 for NY session.")
sessionTz     = input.string("UTC", "Timezone", options = ["UTC", "America/New_York", "Europe/London", "Asia/Tokyo"], group = "Session Filter")

// Risk Management
atrLength      = input.int(14, "ATR Length", minval = 1, group = "ATR Settings")
atrMultiplier  = input.float(3.0, "ATR Multiplier", minval = 0.1, step = 0.1, group = "ATR Settings", tooltip = "Multiplier for ATR to determine the stop loss distance. Adjusted to 3.0x.")

// Backtest Time Range
startTime = input.time(timestamp("1 Jan 2026 00:00 +0000"), "Start Time", group = "Time Filter")
endTime   = input.time(timestamp("3 Apr 2026 23:59 +0000"), "End Time", group = "Time Filter")

// --- Calculations ---
// Donchian Channel
upperBand = ta.highest(high, donchianLength)
lowerBand = ta.lowest(low, donchianLength)
basis     = (upperBand + lowerBand) / 2

// Session Check
// time() returns na if the current bar is outside the specified session/timezone
isInSession = not useSession or not na(time(timeframe.period, sessionTime, sessionTz))

// ATR for Volatility-based Stop Loss
atrValue = ta.atr(atrLength)

// Time Filter Condition
isInWindow = time >= startTime and time <= endTime

// Conditions
longCondition  = ta.crossover(close, basis)  and isInWindow and isInSession
shortCondition = ta.crossunder(close, basis) and isInWindow and isInSession

// --- Strategy Execution ---
var float slPrice = na
var float tpPrice = na

// Long Entry
if longCondition and strategy.position_size == 0
    float risk = atrValue * atrMultiplier
    slPrice := close - risk
    tpPrice := upperBand
    
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", "Long", stop = slPrice, limit = tpPrice, comment_loss = "SL", comment_profit = "TP")

// Short Entry
if shortCondition and strategy.position_size == 0
    float risk = atrValue * atrMultiplier
    slPrice := close + risk
    tpPrice := lowerBand
    
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", "Short", stop = slPrice, limit = tpPrice, comment_loss = "SL", comment_profit = "TP")

// Reset levels when not in a position
if strategy.position_size == 0
    slPrice := na
    tpPrice := na

// --- Visuals ---
plot(upperBand, "Upper Band", color = color.new(#089981, 60))
plot(lowerBand, "Lower Band", color = color.new(#f23645, 60))
plot(basis, "Basis", color = color.new(#5b9cf6, 20), linewidth = 2)

// Visualizing Session with Background Color
bgcolor(useSession and isInSession ? color.new(color.blue, 95) : na, title = "Session Highlight")

// Plot SL/TP levels for the current trade
plot(slPrice, "Stop Loss", color = color.red, style = plot.style_linebr, linewidth = 1)
plot(tpPrice, "Take Profit", color = color.green, style = plot.style_linebr, linewidth = 1)

// Background highlight for entries
bgcolor(longCondition ? color.new(#089981, 90) : shortCondition ? color.new(#f23645, 90) : na)

// --- Stats Dashboard ---
var table dashboard = table.new(position.top_right, 2, 3, bgcolor = color.black, border_width = 1, border_color = color.gray)

if barstate.islast
    float netProfit    = strategy.netprofit
    float winRate      = strategy.closedtrades > 0 ? (strategy.wintrades / strategy.closedtrades) * 100 : 0
    float profitFactor = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : 0
    
    table.cell(dashboard, 0, 0, "Net Profit", text_color = color.white)
    table.cell(dashboard, 1, 0, str.format("${0,number,#.##}", netProfit), text_color = netProfit >= 0 ? color.green : color.red)
    
    table.cell(dashboard, 0, 1, "Win Rate", text_color = color.white)
    table.cell(dashboard, 1, 1, str.format("{0,number,#.##}%", winRate), text_color = color.white)
    
    table.cell(dashboard, 0, 2, "Profit Factor", text_color = color.white)
    table.cell(dashboard, 1, 2, str.format("{0,number,#.##}", profitFactor), text_color = profitFactor >= 1 ? color.green : color.red)
