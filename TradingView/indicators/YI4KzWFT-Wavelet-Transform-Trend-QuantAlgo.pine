//@version=6
indicator('Wavelet Transform Trend [QuantAlgo]', overlay = true, max_bars_back = 500)

//              ╔════════════════════════════════╗              //
//              ║      USER-DEFINED SETTINGS     ║              //
//              ╚════════════════════════════════╝              //

g_wavelet = '════════ Wavelet Settings ════════'
g_visual  = '════════ Visual Settings ════════'

tooltip_preset       = 'Select a predefined configuration that loads a complete set of wavelet transform and trend parameters optimized for different trading styles and timeframes. Choosing a preset overrides the manual Wavelet Period, Wavelet Levels, ATR Period, and ATR Mult values below. Select Default to use those manual inputs instead.'
tooltip_preset_det   = 'Default (16 / 3 / 14 / 1.5): Uses the manual Wavelet Period, Wavelet Levels, ATR Period, and ATR Mult inputs. With the factory values, this is a balanced configuration for swing trading on 1H and daily charts. The level 3 approximation spans roughly 16 bars and the trend state flips only when price closes beyond the ATR confirmation band around the reconstructed wavelet path.\n\nFast Response (8 / 2 / 10 / 1.2): Aggressive configuration for scalping and intraday use on 1 minute to 1H charts. A shorter effective span and fewer levels react earlier to local trend shifts, at the cost of more frequent state changes in chop.\n\nSmooth Trend (32 / 4 / 21 / 2.0): Conservative configuration for position trading on daily and weekly charts. A longer effective span, deeper decomposition, and a wider ATR band keep the trend state stable through pullbacks, delivering fewer but higher conviction flips.'
tooltip_source       = 'Price series fed into the Haar wavelet transform. Close is the standard non-repainting choice because it reflects the settled bar. HL2 uses the bar midpoint to reduce close-to-close noise. HLC3 adds close weighting for a balanced estimate. OHLC4 averages all four prices. Open tracks the opening print only.'
tooltip_period       = 'Target span, in bars, of the deepest wavelet approximation. The transform is undecimated, so this value sets the filter dilation used at each level and therefore controls how slow the extracted trend is. Higher values extract slower structure. Lower values track faster local waves. Used when Preset Configuration is Default; otherwise overridden by the selected preset.'
tooltip_levels       = 'Number of Haar decomposition stages. Each level separates a coarser approximation from the detail band at that scale, with the filter dilation doubling every stage. Levels are capped automatically at floor(log2(Wavelet Period)) so the dilation schedule always fits inside the requested span. Higher levels distribute the same span across more scales and give finer control over which bands are removed. Used when Preset Configuration is Default; otherwise overridden by the selected preset.'
tooltip_detail       = 'Soft threshold applied to wavelet detail coefficients before reconstruction when Wavelet Approximation Only is disabled. Expressed in multiples of each level own noise scale, estimated from the smoothed mean absolute detail, so the same value behaves consistently across instruments and price scales. 1.0 removes roughly one standard deviation of detail energy per level. Higher values denoise more aggressively.'
tooltip_approx       = 'When enabled, all wavelet detail coefficients are discarded and only the deepest approximation is used. This isolates the pure wavelet transform trend component and is the recommended mode for directional following. When disabled, every detail band is passed through level-normalized soft thresholding and added back, so impulse moves survive while micro noise is shrunk to zero.'
tooltip_atr_len      = 'Length of the Average True Range used to size the confirmation band around the reconstructed wavelet path. Price must close beyond this band before the binary trend state is allowed to flip. Used when Preset Configuration is Default; otherwise overridden by the selected preset.'
tooltip_atr_mult     = 'Multiplier applied to ATR to size the trend confirmation band. Higher values require a larger close beyond the wavelet path before the trend state flips, which filters noise and reduces whipsaw. Lower values flip earlier and keep the trailing level closer to the wavelet path. Used when Preset Configuration is Default; otherwise overridden by the selected preset.'
tooltip_display      = 'How the wavelet transform trend is drawn. Line plots the confirmed trailing level as a single path with glow and optional radial layering toward price. Wave draws a smoke-trail built from lagged copies of the reconstructed wavelet path. Both modes take their color from the confirmed binary bullish or bearish state.'
tooltip_radial       = 'When enabled, fills the zone between the trend line and mid-price using radial layering: seven concentric fill bands whose density is strongest at the trend line and decays radially toward price. This maps distance from the trend level as a stepped radial field rather than a single flat fill. Only applies when Trend Display is Line.'
tooltip_radial_t     = 'Base transparency of the innermost radial layer (nearest the trend line). The remaining six layers fade on a curve that scales to the available headroom, so all seven stay visually distinct at any base value instead of saturating to invisible. 0 is fully opaque, 100 is fully transparent. Lower values (50 to 70) produce denser layering. Higher values (80 to 95) keep it subtle. Only applies when Trend Display is Line and Show Radial Layering is enabled.'
tooltip_layers       = 'Number of shade layers used when Trend Display is Wave. 3 is lighter and simpler. 5 is denser and more fluid. Has no effect in Line mode.'
tooltip_span         = 'How far back, in bars, the wave trail stretches when Trend Display is Wave. The outermost shade sits exactly this many bars behind the current wavelet path regardless of the layer count. Has no effect in Line mode.'
tooltip_bright       = 'Base transparency of the strongest wave shade layer (0 is fully opaque, 100 is fully transparent). Outer shades step progressively more transparent. Lower values (20 to 45) produce a vivid trail. Higher values (50 to 70) keep the wave soft. Has no effect in Line mode.'
tooltip_color_preset = 'Pre-configured bullish and bearish color schemes for different chart themes and visual preferences. Classic uses traditional green and red. Aqua uses blue and orange. Cosmic uses cyan and purple. Cyber uses cool cyan against warm orange. Neon uses high contrast yellow and magenta. Custom uses the Bullish Color and Bearish Color inputs below. The active pair colors the trend line, glow, radial layering, wave shades, optional bar coloring, and optional background coloring.'
tooltip_bullish      = 'Bullish color used when Color Preset is set to Custom, and whenever the wavelet transform trend is bullish under a non Custom preset that resolves to this slot. Applied to the trend line, glow, radial layering, wave shades, bar coloring, and background coloring.'
tooltip_bearish      = 'Bearish color used when Color Preset is set to Custom, and whenever the wavelet transform trend is bearish under a non Custom preset that resolves to this slot. Applied to the trend line, glow, radial layering, wave shades, bar coloring, and background coloring.'
tooltip_candles      = 'When enabled, each price bar is tinted with the current bullish or bearish color according to the confirmed wavelet transform trend. Uptrend tints bars bullish. Downtrend tints bars bearish. This makes trend state readable directly from the candles without relying only on the line or wave trail.'
tooltip_bar_trans    = 'Transparency of the bar coloring overlay from 0 to 100. Lower values produce more opaque, vivid bar colors that make direction obvious. Higher values produce a lighter tint that signals state without covering price action as heavily. Only applies when Enable Bar Coloring is turned on.'
tooltip_bgcolor      = 'When enabled, the chart background is tinted with the current bullish or bearish color according to the confirmed wavelet transform trend. This reinforces trend state across the full pane and pairs well with radial layering disabled.'
tooltip_bg_trans     = 'Transparency of the background coloring overlay from 0 to 100. Lower values produce a stronger wash. Higher values produce a subtle tint that leaves candles and the wavelet path easier to read. Only applies when Enable Background Coloring is turned on.'

preset          = input.string('Default', 'Preset Configuration', options = ['Default', 'Fast Response', 'Smooth Trend'], group = g_wavelet, tooltip = tooltip_preset + '\n\n' + tooltip_preset_det)
src             = input.source(close, 'Source', group = g_wavelet, tooltip = tooltip_source)
period_input    = input.int(16, 'Wavelet Period', minval = 4, maxval = 200, group = g_wavelet, tooltip = tooltip_period)
levels_input    = input.int(3, 'Wavelet Levels', minval = 1, maxval = 6, group = g_wavelet, tooltip = tooltip_levels)
approx_only     = input.bool(true, 'Wavelet Approximation Only', group = g_wavelet, tooltip = tooltip_approx)
detail_mult     = input.float(1.0, 'Wavelet Detail Threshold', step = 0.1, minval = 0.1, maxval = 5.0, group = g_wavelet, tooltip = tooltip_detail)

atr_len_input   = input.int(14, 'ATR Period', minval = 1, group = g_wavelet, tooltip = tooltip_atr_len)
atr_mult_input  = input.float(1.5, 'ATR Mult', step = 0.1, minval = 0.1, group = g_wavelet, tooltip = tooltip_atr_mult)

display_style   = input.string('Wave', 'Trend Display', options = ['Line', 'Wave'], group = g_visual, tooltip = tooltip_display)
show_radial     = input.bool(true, 'Show Radial Layering', group = g_visual, tooltip = tooltip_radial)
radial_trans    = input.int(75, 'Radial Layer Transparency', minval = 0, maxval = 100, group = g_visual, tooltip = tooltip_radial_t)
wave_layers     = input.int(5, 'Wave Layers', minval = 3, maxval = 5, group = g_visual, tooltip = tooltip_layers)
wave_span       = input.int(12, 'Wave Span', minval = 4, maxval = 40, group = g_visual, tooltip = tooltip_span)
wave_brightness = input.int(30, 'Wave Brightness', minval = 10, maxval = 70, group = g_visual, tooltip = tooltip_bright)
color_preset    = input.string('Custom', 'Color Preset', options = ['Classic', 'Aqua', 'Cosmic', 'Cyber', 'Neon', 'Custom'], group = g_visual, tooltip = tooltip_color_preset)
bullish_input   = input.color(#00ffaa, 'Bullish Color', group = g_visual, tooltip = tooltip_bullish)
bearish_input   = input.color(#ff0000, 'Bearish Color', group = g_visual, tooltip = tooltip_bearish)
show_candles    = input.bool(false, 'Enable Bar Coloring', group = g_visual, tooltip = tooltip_candles)
bar_trans       = input.int(0, 'Bar Color Transparency', minval = 0, maxval = 100, group = g_visual, tooltip = tooltip_bar_trans)
show_bgcolor    = input.bool(false, 'Enable Background Coloring', group = g_visual, tooltip = tooltip_bgcolor)
bg_trans        = input.int(90, 'Background Color Transparency', minval = 0, maxval = 100, group = g_visual, tooltip = tooltip_bg_trans)

period_raw = preset == 'Fast Response' ? 8 : preset == 'Smooth Trend' ? 32 : period_input
levels_raw = preset == 'Fast Response' ? 2 : preset == 'Smooth Trend' ? 4 : levels_input
atr_len    = preset == 'Fast Response' ? 10 : preset == 'Smooth Trend' ? 21 : atr_len_input
atr_mult   = preset == 'Fast Response' ? 1.2 : preset == 'Smooth Trend' ? 2.0 : atr_mult_input

[bullish_color, bearish_color] = switch color_preset
    'Classic' => [#00ff00, #ff0000]
    'Aqua'    => [#00d4ff, #ff8c00]
    'Cosmic'  => [#49ffce, #9932cc]
    'Cyber'   => [#00cccc, #ff6600]
    'Neon'    => [#ffff00, #ff00ff]
    'Custom'  => [bullish_input, bearish_input]
    => [bullish_input, bearish_input]

//              ╔════════════════════════════════╗              //
//              ║        CORE CALCULATION        ║              //
//              ╚════════════════════════════════╝              //

softThresh(float x, float t) =>
    float ax = math.abs(x)
    ax <= t ? 0.0 : math.sign(x) * (ax - t)

sigmaOf(float d) =>
    ta.rma(math.abs(d), atr_len) * 1.2533

int wavelet_max_levels = math.max(1, int(math.floor(math.log(period_raw) / math.log(2) + 1e-9)))
int wavelet_levels     = math.max(1, math.min(levels_raw, math.min(6, wavelet_max_levels)))
int level_span         = int(math.pow(2, wavelet_levels)) - 1
int wavelet_base       = math.max(1, int(math.round((period_raw - 1) / math.max(1.0, float(level_span)))))

int shift1 = math.min(wavelet_base,      period_raw)
int shift2 = math.min(wavelet_base * 2,  period_raw)
int shift3 = math.min(wavelet_base * 4,  period_raw)
int shift4 = math.min(wavelet_base * 8,  period_raw)
int shift5 = math.min(wavelet_base * 16, period_raw)
int shift6 = math.min(wavelet_base * 32, period_raw)

float a0 = src
float a1 = (a0 + a0[shift1]) * 0.5
float d1 = a0 - a1
float a2 = wavelet_levels >= 2 ? (a1 + a1[shift2]) * 0.5 : a1
float d2 = a1 - a2
float a3 = wavelet_levels >= 3 ? (a2 + a2[shift3]) * 0.5 : a2
float d3 = a2 - a3
float a4 = wavelet_levels >= 4 ? (a3 + a3[shift4]) * 0.5 : a3
float d4 = a3 - a4
float a5 = wavelet_levels >= 5 ? (a4 + a4[shift5]) * 0.5 : a4
float d5 = a4 - a5
float a6 = wavelet_levels >= 6 ? (a5 + a5[shift6]) * 0.5 : a5
float d6 = a5 - a6

float t1 = detail_mult * sigmaOf(d1)
float t2 = detail_mult * sigmaOf(d2)
float t3 = detail_mult * sigmaOf(d3)
float t4 = detail_mult * sigmaOf(d4)
float t5 = detail_mult * sigmaOf(d5)
float t6 = detail_mult * sigmaOf(d6)

float detail_sum   = softThresh(d1, t1) + softThresh(d2, t2) + softThresh(d3, t3) + softThresh(d4, t4) + softThresh(d5, t5) + softThresh(d6, t6)
float wavelet_path = approx_only ? a6 : a6 + detail_sum

var float wavelet_confirmed = na
var float mid_confirmed = na
if barstate.isconfirmed
    wavelet_confirmed := wavelet_path
    mid_confirmed := hl2

float trend_dev = ta.atr(atr_len) * atr_mult
float upper_raw = wavelet_confirmed + trend_dev
float lower_raw = wavelet_confirmed - trend_dev

var float upper_band  = na
var float lower_band  = na
var float trend_level = na
var int   trend_dir   = 0

if barstate.isconfirmed and not na(upper_raw) and not na(lower_raw)
    float prev_upper = na(upper_band) ? upper_raw : upper_band
    float prev_lower = na(lower_band) ? lower_raw : lower_band
    float prev_close = nz(close[1], close)
    int   prev_dir   = trend_dir

    lower_band := lower_raw > prev_lower or prev_close < prev_lower ? lower_raw : prev_lower
    upper_band := upper_raw < prev_upper or prev_close > prev_upper ? upper_raw : prev_upper

    trend_dir   := prev_dir == 0 ? (close > wavelet_confirmed ? 1 : -1) : prev_dir == -1 ? (close > upper_band ? 1 : -1) : (close < lower_band ? -1 : 1)
    trend_level := trend_dir == 1 ? lower_band : upper_band

bool bullish_trend_shift = trend_dir == 1 and nz(trend_dir[1]) == -1
bool bearish_trend_shift = trend_dir == -1 and nz(trend_dir[1]) == 1
bool any_trend_shift     = bullish_trend_shift or bearish_trend_shift

color trend_color = trend_dir == -1 ? bearish_color : bullish_color

//              ╔════════════════════════════════╗              //
//              ║         VISUALIZATION          ║              //
//              ╚════════════════════════════════╝              //

bool show_line = display_style == 'Line'
bool show_wave = not show_line and not na(wavelet_confirmed)
bool has_trend = trend_dir != 0 and not na(trend_level)
bool line_live = show_line and has_trend and not any_trend_shift

float trend_line_plot = line_live ? trend_level : na
plot(trend_line_plot, 'Wavelet Transform Trend Glow', color = color.new(trend_color, 70), linewidth = 6, style = plot.style_linebr, display = display.pane)
plot(trend_line_plot, 'Wavelet Transform Trend', color = trend_color, linewidth = 3, style = plot.style_linebr)

bool  radial_on   = show_line and show_radial and line_live
float radial_base = radial_on ? trend_level : na
float radial_edge = radial_on ? mid_confirmed : na
float radial_gap  = radial_edge - radial_base
float radial_1    = radial_on ? radial_base + radial_gap * 0.142857 : na
float radial_2    = radial_on ? radial_base + radial_gap * 0.285714 : na
float radial_3    = radial_on ? radial_base + radial_gap * 0.428571 : na
float radial_4    = radial_on ? radial_base + radial_gap * 0.571429 : na
float radial_5    = radial_on ? radial_base + radial_gap * 0.714286 : na
float radial_6    = radial_on ? radial_base + radial_gap * 0.857143 : na

radialT(int idx) =>
    float ceil_t = radial_trans + (100 - radial_trans) * 0.85
    int(math.round(radial_trans + (ceil_t - radial_trans) * math.pow(idx / 6.0, 0.8)))

int radial_t0 = radialT(0)
int radial_t1 = radialT(1)
int radial_t2 = radialT(2)
int radial_t3 = radialT(3)
int radial_t4 = radialT(4)
int radial_t5 = radialT(5)
int radial_t6 = radialT(6)

p_radial_0 = plot(radial_base, 'Radial Base', color = na, display = display.none, editable = false)
p_radial_1 = plot(radial_1,    'Radial 1',    color = na, display = display.none, editable = false)
p_radial_2 = plot(radial_2,    'Radial 2',    color = na, display = display.none, editable = false)
p_radial_3 = plot(radial_3,    'Radial 3',    color = na, display = display.none, editable = false)
p_radial_4 = plot(radial_4,    'Radial 4',    color = na, display = display.none, editable = false)
p_radial_5 = plot(radial_5,    'Radial 5',    color = na, display = display.none, editable = false)
p_radial_6 = plot(radial_6,    'Radial 6',    color = na, display = display.none, editable = false)
p_radial_7 = plot(radial_edge, 'Radial Edge', color = na, display = display.none, editable = false)

fill(p_radial_0, p_radial_1, color = radial_on ? color.new(trend_color, radial_t0) : na, title = 'Radial Layer 1')
fill(p_radial_1, p_radial_2, color = radial_on ? color.new(trend_color, radial_t1) : na, title = 'Radial Layer 2')
fill(p_radial_2, p_radial_3, color = radial_on ? color.new(trend_color, radial_t2) : na, title = 'Radial Layer 3')
fill(p_radial_3, p_radial_4, color = radial_on ? color.new(trend_color, radial_t3) : na, title = 'Radial Layer 4')
fill(p_radial_4, p_radial_5, color = radial_on ? color.new(trend_color, radial_t4) : na, title = 'Radial Layer 5')
fill(p_radial_5, p_radial_6, color = radial_on ? color.new(trend_color, radial_t5) : na, title = 'Radial Layer 6')
fill(p_radial_6, p_radial_7, color = radial_on ? color.new(trend_color, radial_t6) : na, title = 'Radial Layer 7')

int wave_off1 = math.max(1, int(math.round(wave_span * 1.0 / wave_layers)))
int wave_off2 = math.max(wave_off1 + 1, int(math.round(wave_span * 2.0 / wave_layers)))
int wave_off3 = math.max(wave_off2 + 1, int(math.round(wave_span * 3.0 / wave_layers)))
int wave_off4 = math.max(wave_off3 + 1, int(math.round(wave_span * 4.0 / wave_layers)))
int wave_off5 = math.max(wave_off4 + 1, wave_span)

wave_p0 = plot(show_wave ? wavelet_confirmed : na, 'Wave Layer Base', color = na, display = display.none, editable = false)
wave_p1 = plot(show_wave ? wavelet_confirmed[wave_off1] : na, 'Wave Layer 1', color = na, display = display.none, editable = false)
wave_p2 = plot(show_wave ? wavelet_confirmed[wave_off2] : na, 'Wave Layer 2', color = na, display = display.none, editable = false)
wave_p3 = plot(show_wave ? wavelet_confirmed[wave_off3] : na, 'Wave Layer 3', color = na, display = display.none, editable = false)
wave_p4 = plot(show_wave and wave_layers >= 4 ? wavelet_confirmed[wave_off4] : na, 'Wave Layer 4', color = na, display = display.none, editable = false)
wave_p5 = plot(show_wave and wave_layers >= 5 ? wavelet_confirmed[wave_off5] : na, 'Wave Layer 5', color = na, display = display.none, editable = false)

fill(wave_p0, wave_p1, color = show_wave and has_trend ? color.new(trend_color, wave_brightness) : na, title = 'Wave Layer 1')
fill(wave_p1, wave_p2, color = show_wave and has_trend ? color.new(trend_color, math.min(92, wave_brightness + 12)) : na, title = 'Wave Layer 2')
fill(wave_p2, wave_p3, color = show_wave and has_trend ? color.new(trend_color, math.min(94, wave_brightness + 22)) : na, title = 'Wave Layer 3')
fill(wave_p3, wave_p4, color = show_wave and has_trend and wave_layers >= 4 ? color.new(trend_color, math.min(96, wave_brightness + 30)) : na, title = 'Wave Layer 4')
fill(wave_p4, wave_p5, color = show_wave and has_trend and wave_layers >= 5 ? color.new(trend_color, math.min(97, wave_brightness + 36)) : na, title = 'Wave Layer 5')

barcolor(show_candles and has_trend ? color.new(trend_color, bar_trans) : na, title = 'Wavelet Transform Trend Bar Color')
bgcolor(show_bgcolor and has_trend ? color.new(trend_color, bg_trans) : na, title = 'Wavelet Transform Trend Background Color')

//              ╔════════════════════════════════╗              //
//              ║             ALERTS             ║              //
//              ╚════════════════════════════════╝              //

alertcondition(bullish_trend_shift, title = 'Bullish Wavelet Trend',  message = 'Wavelet Transform Trend: BULLISH on {{exchange}}:{{ticker}} - {{interval}}')
alertcondition(bearish_trend_shift, title = 'Bearish Wavelet Trend',  message = 'Wavelet Transform Trend: BEARISH on {{exchange}}:{{ticker}} - {{interval}}')
alertcondition(any_trend_shift,     title = 'Any Wavelet Trend Flip', message = 'Wavelet Transform Trend: Trend flipped on {{exchange}}:{{ticker}} - {{interval}}')

//              ╔════════════════════════════════╗              //
//              ║           CREATED BY           ║              //
//              ╚════════════════════════════════╝              //

// ██████╗ ██╗   ██╗ █████╗ ███╗   ██╗████████╗     █████╗ ██╗      ██████╗  ██████╗
