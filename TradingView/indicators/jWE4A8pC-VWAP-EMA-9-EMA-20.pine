//@version=6
indicator("VWAP + EMA 9 + EMA 20", overlay=true)

vwapLine = ta.vwap(hlc3)

ema9 = ta.ema(close, 9)

ema20 = ta.ema(close, 20)

plot(vwapLine, title="VWAP", color=color.blue, linewidth=2)

plot(ema9, title="EMA 9", color=color.yellow, linewidth=2)

plot(ema20, title="EMA 20", color=color.red, linewidth=2)