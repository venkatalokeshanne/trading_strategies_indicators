//@version=6
indicator("LineTrendHighLowDay", overlay = true, max_labels_count=500, shorttitle="LTHLD")



var bool new_day = false

if dayofmonth > dayofmonth[1] or month != month[1]
    new_day := true

if dayofmonth == dayofmonth[1]
    new_day := false

var float max = 0.0
var float min = 0.0
var float last_max = 0.0
var float last_min = 0.0


var int max_bar = 0
var int min_bar = 0
var int last_max_bar = 0
var int last_min_bar = 0

var line line_h = na
var line line_l = na

var line line_open = na


if new_day == false and high > max
    max := high
    max_bar := time
    line.set_x2(line_h, max_bar)
    line.set_y2(line_h, max)


if new_day == false and low < min
    min := low
    min_bar := time
    line.set_x2(line_l, min_bar)
    line.set_y2(line_l, min)

if new_day == true
    line.delete(line_h)
    line.delete(line_l)
    line.delete(line_open)
    last_max := max
    last_min := min
    last_max_bar := max_bar
    last_min_bar := min_bar
    label.new(time, high, style = label.style_triangledown, xloc = xloc.bar_time, yloc = yloc.abovebar, size = 6,  color = color.rgb(255, 255, 255))

    label.new(max_bar, high, style = label.style_circle, xloc = xloc.bar_time, yloc = yloc.abovebar, size = 3,  color = color.rgb(2, 255, 179))
    max := high
    max_bar := time

    label.new(min_bar, low, style = label.style_circle, xloc = xloc.bar_time, yloc = yloc.belowbar, size = 3, color = color.rgb(243, 103, 68))
    min := low
    min_bar := time

    line_h := line.new(last_max_bar, last_max, max_bar, max, extend = extend.right, color=color.rgb(120, 255, 120, 0), xloc = xloc.bar_time)
    line_l := line.new(last_min_bar, last_min, min_bar, min, extend = extend.right, color=color.rgb(247, 74, 74), xloc = xloc.bar_time)

    line_open := line.new(time, open, time+60, open, extend = extend.right, color=color.rgb(180, 179, 179), xloc = xloc.bar_time, style = line.style_dashed)

