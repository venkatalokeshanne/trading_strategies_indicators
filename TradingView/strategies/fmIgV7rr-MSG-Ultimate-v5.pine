//@version=6
strategy('MSG Ultimate v5.1', overlay = true, default_qty_type = strategy.percent_of_equity, default_qty_value = 10, pyramiding = 0)

//================ INPUTS =================
showSessions = input.bool(true, 'Show Session Boxes')
showBias = input.bool(true, 'Show Bias Colors')
showLabels = input.bool(true, 'Show Session Labels')
showSignals = input.bool(true, 'Show MSG Signals')
showEntryDots = input.bool(true, 'Show Entry Dots')

tradeAsia = input.bool(false, 'Trade Asia')
tradeLondon = input.bool(true, 'Trade London')
tradeNY = input.bool(true, 'Trade New York')

emaLen = input.int(50, 'EMA Length')
atrLen = input.int(14, 'ATR Length')
atrMult = input.float(1.5, 'TP/SL Multiplier')
minProb = input.int(50, 'Min Probability')

dotSizeInput = input.string('tiny', 'Entry Dot Size', options = ['tiny', 'small', 'normal', 'large'])

//================ DOT SIZE =================
dot_size = switch dotSizeInput
    'tiny' => size.tiny
    'small' => size.small
    'normal' => size.normal
    'large' => size.large

//================ SESSIONS =================
asia = input.session('0000-0600', 'Asia Session')
london = input.session('0700-1200', 'London Session')
ny = input.session('1300-1700', 'NY Session')

inAsia = not na(time(timeframe.period, asia))
inLondon = not na(time(timeframe.period, london))
inNY = not na(time(timeframe.period, ny))

asiaStart = inAsia and not inAsia[1]
londonStart = inLondon and not inLondon[1]
nyStart = inNY and not inNY[1]

//================ SESSION CONTROL =================
validSession = inAsia and tradeAsia or inLondon and tradeLondon or inNY and tradeNY

//================ VARIABLES =================
var box asiaBox = na
var box londonBox = na
var box nyBox = na

var label asiaLabel = na
var label londonLabel = na
var label nyLabel = na

var float asiaMean = na
var float londonMean = na
var float nyMean = na
var float prevMean = na

//================ EMA + ATR =================
ema = ta.ema(close, emaLen)
atr = ta.atr(atrLen)
buffer = atr * 0.5

//================ SESSION BOXES =================
if showSessions
    if asiaStart
        asiaMean := (high + low) / 2
        asiaBox := box.new(bar_index, high, bar_index, low, bgcolor = color.new(color.blue, 80))
    if inAsia and not na(asiaBox)
        box.set_right(asiaBox, bar_index)
        box.set_top(asiaBox, math.max(high, box.get_top(asiaBox)))
        box.set_bottom(asiaBox, math.min(low, box.get_bottom(asiaBox)))
        if showBias
            box.set_bgcolor(asiaBox, close > asiaMean ? color.new(color.green, 60) : color.new(color.red, 60))

    if londonStart
        londonMean := (high + low) / 2
        londonBox := box.new(bar_index, high, bar_index, low, bgcolor = color.new(color.orange, 80))
    if inLondon and not na(londonBox)
        box.set_right(londonBox, bar_index)
        box.set_top(londonBox, math.max(high, box.get_top(londonBox)))
        box.set_bottom(londonBox, math.min(low, box.get_bottom(londonBox)))
        if showBias
            box.set_bgcolor(londonBox, close > londonMean ? color.new(color.green, 60) : color.new(color.red, 60))

    if nyStart
        nyMean := (high + low) / 2
        nyBox := box.new(bar_index, high, bar_index, low, bgcolor = color.new(color.green, 80))
    if inNY and not na(nyBox)
        box.set_right(nyBox, bar_index)
        box.set_top(nyBox, math.max(high, box.get_top(nyBox)))
        box.set_bottom(nyBox, math.min(low, box.get_bottom(nyBox)))
        if showBias
            box.set_bgcolor(nyBox, close > nyMean ? color.new(color.green, 60) : color.new(color.red, 60))

//================ SESSION LABELS =================
if showLabels
    if asiaStart
        label.delete(asiaLabel)
        asiaLabel := label.new(bar_index, high, 'ASIA', style = label.style_label_down, color = color.blue)
    if londonStart
        label.delete(londonLabel)
        londonLabel := label.new(bar_index, high, 'LONDON', style = label.style_label_down, color = color.orange)
    if nyStart
        label.delete(nyLabel)
        nyLabel := label.new(bar_index, high, 'NEW YORK', style = label.style_label_down, color = color.green)

//================ MEANS =================
prevMean := not na(nyMean) ? nyMean : not na(londonMean) ? londonMean : asiaMean
currentMean = inNY ? nyMean : inLondon ? londonMean : asiaMean

//================ BIAS =================
bias = close > currentMean ? 1 : -1

//================ SIGNALS =================
bull = close > prevMean + buffer and close > currentMean + buffer and close > ema
bear = close < prevMean - buffer and close < currentMean - buffer and close < ema

//================ PROBABILITY =================
score = (bull ? 1 : 0) + (bear ? 1 : 0)
prob = math.min(100, 30 + score * 35)

//================ FILTER =================
buy = bull and bias == 1 and prob >= minProb and validSession
sell = bear and bias == -1 and prob >= minProb and validSession

//================ ONE TRADE PER SESSION =================
var traded = false
if asiaStart or londonStart or nyStart
    traded := false

//================ EXECUTION & ATM SYNCED LABELS =================
// Both strategy entries execute as At-The-Market (ATM) orders
if buy and not traded
    strategy.entry('BUY', strategy.long) // ATM Market Long Order
    traded := true
    alert('MSG BUY 🚀 | Session: ' + (inAsia ? 'ASIA' : inLondon ? 'LONDON' : 'NY') + ' | Prob: ' + str.tostring(prob) + '% | Entry: ' + str.tostring(close), alert.freq_once_per_bar_close)
    
    if showSignals
        label.new(bar_index, low - atr * 0.2, 'MSG BUY 🚀', style = label.style_label_up, color = color.green, textcolor = color.white)
        if showEntryDots
            label.new(bar_index, low - atr * 0.2, '', style = label.style_circle, color = color.green, size = dot_size)

if sell and not traded
    strategy.entry('SELL', strategy.short) // ATM Market Short Order
    traded := true
    alert('MSG SELL 🔥 | Session: ' + (inAsia ? 'ASIA' : inLondon ? 'LONDON' : 'NY') + ' | Prob: ' + str.tostring(prob) + '% | Entry: ' + str.tostring(close), alert.freq_once_per_bar_close)
    
    if showSignals
        label.new(bar_index, high + atr * 0.2, 'MSG SELL 🔥', style = label.style_label_down, color = color.red, textcolor = color.white)
        if showEntryDots
            label.new(bar_index, high + atr * 0.2, '', style = label.style_circle, color = color.red, size = dot_size)

//================ TP/SL =================
longTP = close + atr * atrMult
longSL = close - atr * atrMult
shortTP = close - atr * atrMult
shortSL = close + atr * atrMult
strategy.exit('TP BUY', from_entry = 'BUY', limit = longTP, stop = longSL)
strategy.exit('TP SELL', from_entry = 'SELL', limit = shortTP, stop = shortSL)

//================ DASHBOARD =================
var table dash = table.new(position.top_right, 2, 6)
isLong = strategy.position_size > 0
isShort = strategy.position_size < 0
entry = strategy.position_avg_price
tp = isLong ? entry + atr * atrMult : isShort ? entry - atr * atrMult : na
sl = isLong ? entry - atr * atrMult : isShort ? entry + atr * atrMult : na
sessionName = inAsia ? 'ASIA' : inLondon ? 'LONDON' : inNY ? 'NY' : 'OFF'

if barstate.islast
    table.cell(dash, 0, 0, 'MSG PANEL 🔥', bgcolor = color.black, text_color = color.white)
    table.cell(dash, 1, 0, '')

    table.cell(dash, 0, 1, 'Session')
    table.cell(dash, 1, 1, sessionName)

    table.cell(dash, 0, 2, 'Signal')
    table.cell(dash, 1, 2, isLong ? 'BUY' : isShort ? 'SELL' : 'NONE')

    table.cell(dash, 0, 3, 'Prob')
    table.cell(dash, 1, 3, str.tostring(prob) + '%')

    table.cell(dash, 0, 4, 'Entry')
    table.cell(dash, 1, 4, str.tostring(entry))

    table.cell(dash, 0, 5, 'TP/SL')
    table.cell(dash, 1, 5, str.tostring(tp) + ' / ' + str.tostring(sl))
