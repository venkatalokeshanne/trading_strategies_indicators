//@version=6
indicator("Double CCI (Woodies Style)", shorttitle="DoubleCCI", overlay=false)

// ==========================================
// PARAMETROS DE ENTRADA
// ==========================================
trendCCI_Period_Input  = input.int(100, title="TrendCCI Period (Manual)")
entryCCI_Period_Input  = input.int(14, title="EntryCCI Period (Manual)")
turboCCI_Period_Input  = input.int(7, title="TurboCCI Period (Manual)")

zeroCrossAlert         = input.bool(false, title="Zero Cross Alert")
autoTimeframe          = input.bool(true, title="Automatic Timeframe Setting")

// Configuración por temporalidad
m1_trend = input.int(55, "M1 Trend"),  m1_entry = input.int(14, "M1 Entry"),  m1_turbo = input.int(7, "M1 Turbo")
m5_trend = input.int(55, "M5 Trend"),  m5_entry = input.int(14, "M5 Entry"),  m5_turbo = input.int(7, "M5 Turbo")
m15_trend = input.int(55, "M15 Trend"), m15_entry = input.int(14, "M15 Entry"), m15_turbo = input.int(7, "M15 Turbo")
m30_trend = input.int(55, "M30 Trend"), m30_entry = input.int(21, "M30 Entry"), m30_turbo = input.int(7, "M30 Turbo")
h1_trend = input.int(55, "H1 Trend"),  h1_entry = input.int(21, "H1 Entry"),  h1_turbo = input.int(7, "H1 Turbo")
h4_trend = input.int(55, "H4 Trend"),  h4_entry = input.int(21, "H4 Entry"),  h4_turbo = input.int(7, "H4 Turbo")
d1_trend = input.int(55, "D1 Trend"),  d1_entry = input.int(21, "D1 Entry"),  d1_turbo = input.int(7, "D1 Turbo")
w1_trend = input.int(55, "W1 Trend"),  w1_entry = input.int(21, "W1 Entry"),  w1_turbo = input.int(7, "W1 Turbo")
mn_trend = input.int(55, "MN Trend"),  mn_entry = input.int(21, "MN Entry"),  mn_turbo = input.int(7, "MN Turbo")

// ==========================================
// SELECCIÓN AUTOMÁTICA DE PERÍODOS
// ==========================================
f_getPeriods() =>
    int t = trendCCI_Period_Input
    int e = entryCCI_Period_Input
    int tb = turboCCI_Period_Input
    
    if autoTimeframe
        if timeframe.isminutes
            m = timeframe.multiplier
            if m == 1
                t := m1_trend, e := m1_entry, tb := m1_turbo
            else if m == 5
                t := m5_trend, e := m5_entry, tb := m5_turbo
            else if m == 15
                t := m15_trend, e := m15_entry, tb := m15_turbo
            else if m == 30
                t := m30_trend, e := m30_entry, tb := m30_turbo
            else if m == 60
                t := h1_trend, e := h1_entry, tb := h1_turbo
            else if m == 240
                t := h4_trend, e := h4_entry, tb := h4_turbo
        else if timeframe.isdaily
            t := d1_trend, e := d1_entry, tb := d1_turbo
        else if timeframe.isweekly
            t := w1_trend, e := w1_entry, tb := w1_turbo
        else if timeframe.ismonthly
            t := mn_trend, e := mn_entry, tb := mn_turbo
    [t, e, tb]

[trendPeriod, entryPeriod, turboPeriod] = f_getPeriods()

// ==========================================
// CÁLCULO DE CCI
// ==========================================
trendCCI = ta.cci(hlc3, trendPeriod)
entryCCI = ta.cci(hlc3, entryPeriod)
turboCCI = ta.cci(hlc3, turboPeriod)

// ==========================================
// LÓGICA DE BARRAS DE TENDENCIA (WOODIES)
// ==========================================
var int trendUp = 0
var int trendDown = 0

if trendCCI >= 0
    trendUp += 1
    trendDown := 0
else
    trendDown += 1
    trendUp := 0

// Determinar el valor/color del Histograma
float cciTrendUp   = na
float cciTrendDown = na
float cciNoTrend   = na
float cciTimeBar   = na

if trendCCI >= 0
    if trendUp == 5
        cciTimeBar := trendCCI
    else if trendUp > 5
        cciTrendUp := trendCCI
    else
        cciNoTrend := trendCCI
else
    if trendDown == 5
        cciTimeBar := trendCCI
    else if trendDown > 5
        cciTrendDown := trendCCI
    else
        cciNoTrend := trendCCI

// ==========================================
// DIBUJO EN PANTALLA
// ==========================================
// Histograma de Tendencias
plot(cciTrendUp,   title="Trend Up (Green)",   style=plot.style_histogram, color=color.green, linewidth=2)
plot(cciTrendDown, title="Trend Down (Red)",   style=plot.style_histogram, color=color.red, linewidth=2)
plot(cciNoTrend,   title="No Trend (Gray)",    style=plot.style_histogram, color=color.gray, linewidth=2)
plot(cciTimeBar,   title="Time Bar (Orange)",  style=plot.style_histogram, color=color.orange, linewidth=2)

// Líneas principales de CCI
plot(trendCCI, title="Trend CCI", color=color.gray,       linewidth=1)
plot(entryCCI, title="Entry CCI", color=color.silver,  linewidth=1)
plot(turboCCI, title="Turbo CCI", color=color.red,     linewidth=1)

// Niveles clave
hline(300,  "Level +300",  color=color.gray, linestyle=hline.style_dotted)
hline(200,  "Level +200",  color=color.gray, linestyle=hline.style_dotted)
hline(100,  "Level +100",  color=color.gray, linestyle=hline.style_dotted)
hline(50,   "Level +50",   color=color.gray, linestyle=hline.style_dotted)
hline(0,    "Zero Line",   color=color.orange, linewidth=1)
hline(-50,  "Level -50",   color=color.gray, linestyle=hline.style_dotted)
hline(-100, "Level -100",  color=color.gray, linestyle=hline.style_dotted)
hline(-200, "Level -200",  color=color.gray, linestyle=hline.style_dotted)
hline(-300, "Level -300",  color=color.gray, linestyle=hline.style_dotted)

// ==========================================
// ALERTAS
// ==========================================
bullishCross = (entryCCI > 0) and ta.crossover(trendCCI, 0)
bearishCross = (entryCCI < 0) and ta.crossunder(trendCCI, 0)

if zeroCrossAlert and bullishCross
    alert("DoubleCCI: TrendCCI y EntryCCI cruzaron al alza el nivel CERO", alert.freq_once_per_bar_close)

if zeroCrossAlert and bearishCross
    alert("DoubleCCI: TrendCCI y EntryCCI cruzaron a la baja el nivel CERO", alert.freq_once_per_bar_close)