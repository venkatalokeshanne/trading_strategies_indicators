//@version=6
indicator("MM v6 Scanner", overlay=true, max_labels_count=500, max_lines_count=500)

// === INPUTS ===
useMACD = input.bool(true, "Use MACD Filter")
useRSI = input.bool(true, "Use RSI Filter") 
useATR = input.bool(true, "Use ATR Filter")
useVolume = input.bool(true, "Use Volume Filter")
useSMA = input.bool(true, "Use 20 SMA Trend Filter")
useBreakout = input.bool(true, "Use Breakout Filter")
minRequired = input.int(4, "Min Filters Required", minval=1, maxval=6) // <- हे नवीन

macdFast = input.int(12, "MACD Fast")
macdSlow = input.int(26, "MACD Slow")
macdSignal = input.int(9, "MACD Signal")
rsiLen = input.int(14, "RSI Length")
rsiBuyThresh = input.int(50, "RSI Buy Threshold")
atrLen = input.int(14, "ATR Length")
atrThresh = input.float(1.5, "ATR Threshold", step=0.1)
volLen = input.int(20, "Volume Avg Length")
volMult = input.float(1.2, "Volume Multiplier", step=0.1)
smaLen = input.int(20, "SMA Length")
breakoutBars = input.int(20, "Breakout Lookback Bars")

// === CALCULATIONS ===
[macdLine, signalLine, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignal)
macdBull = macdLine > signalLine

rsi = ta.rsi(close, rsiLen)
rsiBull = rsi > rsiBuyThresh

atr = ta.atr(atrLen)
atrOk = atr > atrThresh

volAvg = ta.sma(volume, volLen)
volSpike = volume > volAvg * volMult

sma = ta.sma(close, smaLen)
priceAboveSMA = close > sma

hh = ta.highest(high, breakoutBars)
breakout = ta.crossover(close, hh[1])

// === FINAL SIGNAL ===
conditions = 0
conditions += useMACD? (macdBull? 1 : 0) : 0
conditions += useRSI? (rsiBull? 1 : 0) : 0
conditions += useATR? (atrOk? 1 : 0) : 0
conditions += useVolume? (volSpike? 1 : 0) : 0
conditions += useSMA? (priceAboveSMA? 1 : 0) : 0
conditions += useBreakout? (breakout? 1 : 0) : 0

totalFilters = (useMACD? 1 : 0) + (useRSI? 1 : 0) + (useATR? 1 : 0) + (useVolume? 1 : 0) + (useSMA? 1 : 0) + (useBreakout? 1 : 0)
buySignal = conditions >= minRequired and totalFilters > 0

// === PLOT ===
plotshape(buySignal, title="BUY", style=shape.labelup, location=location.belowbar, color=color.new(color.lime, 0), text="BUY", size=size.small)
alertcondition(buySignal, title="MM BUY", message="MM BUY Signal")