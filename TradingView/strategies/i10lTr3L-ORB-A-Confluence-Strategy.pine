// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
//@version=6
strategy(
     "ORB A+ Confluence Strategy",
     shorttitle = "ORB A+",
     overlay = true,
     initial_capital = 1000000,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     pyramiding = 0,
     commission_type = strategy.commission.percent,
     commission_value = 0,
     process_orders_on_close = true)

// ============================================================================
// GROUPS
// ============================================================================
string GROUP_RANGE  = "Opening Range"
string GROUP_MA     = "Session Moving Average"
string GROUP_TREND  = "A+ Trend Filters"
string GROUP_SCORE  = "A+ Setup Scoring"
string GROUP_VOLUME = "Volume Confirmation"
string GROUP_RISK   = "Trade Targets"
string GROUP_PROP   = "Prop-Style Risk Rules"
string GROUP_STYLE  = "Style"

// ============================================================================
// OPENING RANGE
// ============================================================================
string rangeSessionInput = input.session(
     "0930-1000:23456",
     "Opening Range Session",
     group = GROUP_RANGE)

string sessionTimezoneInput = input.string(
     "America/New_York",
     "Session Timezone",
     options = [
         "America/New_York",
         "Etc/UTC",
         "Europe/London",
         "Asia/Tokyo"],
     group = GROUP_RANGE)

bool showMidpointInput = input.bool(
     true,
     "Show OR Midpoint",
     group = GROUP_RANGE)

bool allowInsideOrbInput = input.bool(
     true,
     "Allow A/A+ Setups Inside OR",
     group = GROUP_RANGE)

// ============================================================================
// SESSION MOVING AVERAGE
// ============================================================================
bool showSessionMAInput = input.bool(
     true,
     "Show Session Moving Average",
     group = GROUP_MA)

int sessionMALengthInput = input.int(
     20,
     "Length",
     minval = 1,
     group = GROUP_MA)

string sessionMATypeInput = input.string(
     "EMA",
     "Type",
     options = ["EMA", "SMA", "WMA", "RMA"],
     group = GROUP_MA)

color sessionMAColorInput = input.color(
     color.orange,
     "MA Color",
     group = GROUP_MA)

// ============================================================================
// TREND FILTERS
// ============================================================================
int maSlopeLookbackInput = input.int(
     3,
     "MA Slope Lookback",
     minval = 1,
     group = GROUP_TREND)

bool useVwapInput = input.bool(
     true,
     "Use VWAP Confirmation",
     group = GROUP_TREND)

bool useMAInput = input.bool(
     true,
     "Use Session MA Confirmation",
     group = GROUP_TREND)

bool useMASlopeInput = input.bool(
     true,
     "Use MA Slope Confirmation",
     group = GROUP_TREND)

bool showVwapInput = input.bool(
     true,
     "Show VWAP",
     group = GROUP_TREND)

// ============================================================================
// VOLUME
// ============================================================================
int volumeLengthInput = input.int(
     20,
     "Volume Average Length",
     minval = 1,
     group = GROUP_VOLUME)

float volumeMultiplierInput = input.float(
     1.25,
     "Strong Volume Multiplier",
     minval = 0.1,
     step = 0.05,
     group = GROUP_VOLUME)

float extremeVolumeMultiplierInput = input.float(
     1.60,
     "A+ Volume Multiplier",
     minval = 0.1,
     step = 0.05,
     group = GROUP_VOLUME)

// ============================================================================
// A / A+ SCORING
// ============================================================================
int minimumAScoreInput = input.int(
     5,
     "Minimum Score for A",
     minval = 1,
     maxval = 8,
     group = GROUP_SCORE)

int minimumAPlusScoreInput = input.int(
     7,
     "Minimum Score for A+",
     minval = 1,
     maxval = 8,
     group = GROUP_SCORE)

float retestToleranceAtrInput = input.float(
     0.25,
     "Retest Tolerance (ATR)",
     minval = 0.05,
     step = 0.05,
     group = GROUP_SCORE)

float maxExtensionAtrInput = input.float(
     1.25,
     "Maximum MA Extension (ATR)",
     minval = 0.25,
     step = 0.05,
     group = GROUP_SCORE)

bool requireConfirmationCandleInput = input.bool(
     true,
     "Require Confirmation Candle",
     group = GROUP_SCORE)

// ============================================================================
// TRADE TARGETS
// ============================================================================
int atrLengthInput = input.int(
     14,
     "ATR Length",
     minval = 1,
     group = GROUP_RISK)

float stopAtrMultiplierInput = input.float(
     1.25,
     "Stop ATR Multiplier",
     minval = 0.1,
     step = 0.05,
     group = GROUP_RISK)

float riskRewardInput = input.float(
     2.0,
     "Risk / Reward",
     minval = 0.5,
     step = 0.25,
     group = GROUP_RISK)

bool useBreakEvenInput = input.bool(
     true,
     "Move Stop to Break-Even",
     group = GROUP_RISK)

float breakEvenTriggerInput = input.float(
     1.0,
     "Break-Even Trigger (R)",
     minval = 0.25,
     step = 0.25,
     group = GROUP_RISK)

bool useTrendExitInput = input.bool(
     true,
     "Enable Trend Failure Exit",
     group = GROUP_RISK)

// ============================================================================
// PROP RULES
// ============================================================================
bool enablePropRulesInput = input.bool(
     true,
     "Enable Prop Guardrails",
     group = GROUP_PROP)

float propAccountSizeInput = input.float(
     50000,
     "Prop Account Size",
     minval = 1,
     step = 1000,
     group = GROUP_PROP)

float dailyLossLimitInput = input.float(
     3.0,
     "Daily Loss Limit (%)",
     minval = 0.1,
     step = 0.1,
     group = GROUP_PROP)

float maxDrawdownInput = input.float(
     6.0,
     "Trailing Max Drawdown (%)",
     minval = 0.1,
     step = 0.1,
     group = GROUP_PROP)

int maxTradesInput = input.int(
     3,
     "Maximum Entries Per Day",
     minval = 1,
     group = GROUP_PROP)

float evaluationTargetInput = input.float(
     6.0,
     "Evaluation Target (%)",
     minval = 0.1,
     step = 0.1,
     group = GROUP_PROP)

// ============================================================================
// STYLE
// ============================================================================
color bullTargetColorInput = input.color(
     #089981,
     "Bull Target Color",
     group = GROUP_STYLE)

color bullFillColorInput = input.color(
     color.new(#089981, 85),
     "Bull Fill Color",
     group = GROUP_STYLE)

color bearTargetColorInput = input.color(
     #f23645,
     "Bear Target Color",
     group = GROUP_STYLE)

color bearFillColorInput = input.color(
     color.new(#f23645, 85),
     "Bear Fill Color",
     group = GROUP_STYLE)

color orLevelsColorInput = input.color(
     #80838d,
     "OR Levels Color",
     group = GROUP_STYLE)

color orHighlightColorInput = input.color(
     color.new(#80838d, 90),
     "OR Highlight Color",
     group = GROUP_STYLE)

string targetStyleInput = input.string(
     "Solid",
     "Target Style",
     options = ["Solid", "Dashed", "Dotted"],
     group = GROUP_STYLE)

bool showSignalsInput = input.bool(
     true,
     "Show A/A+ Signals",
     group = GROUP_STYLE)

bool showTargetsInput = input.bool(
     true,
     "Show Active Targets",
     group = GROUP_STYLE)

// ============================================================================
// MA FUNCTION
// ============================================================================
getMA(float source, int length, string maType) =>
    switch maType
        "EMA" => ta.ema(source, length)
        "SMA" => ta.sma(source, length)
        "WMA" => ta.wma(source, length)
        "RMA" => ta.rma(source, length)
        => ta.ema(source, length)

// ============================================================================
// SESSION STATE
// ============================================================================
int dayStamp = time(
     "D",
     "0000-2359",
     sessionTimezoneInput)

bool newDay =
     not na(dayStamp) and
     (na(dayStamp[1]) or dayStamp != dayStamp[1])

bool inRangeSession =
     not na(
         time(
             timeframe.period,
             rangeSessionInput,
             sessionTimezoneInput))

bool wasInRangeSession =
     bar_index > 0 and inRangeSession[1]

bool rangeSessionStart =
     inRangeSession and not wasInRangeSession

bool rangeSessionEnd =
     not inRangeSession and wasInRangeSession

var float rangeHigh = na
var float rangeLow = na
var bool rangeReady = false

if newDay
    rangeHigh := na
    rangeLow := na
    rangeReady := false

if rangeSessionStart
    rangeHigh := high
    rangeLow := low
    rangeReady := false
else if inRangeSession
    rangeHigh := math.max(rangeHigh, high)
    rangeLow := math.min(rangeLow, low)

if rangeSessionEnd
    rangeReady := true

float rangeMid =
     not na(rangeHigh) and not na(rangeLow)
     ? (rangeHigh + rangeLow) / 2.0
     : na

// ============================================================================
// INDICATORS
// ============================================================================
float sessionMA =
     getMA(
         close,
         sessionMALengthInput,
         sessionMATypeInput)

float sessionVwap = ta.vwap(hlc3)

float atrValue =
     ta.atr(atrLengthInput)

float volumeAverage =
     ta.sma(volume, volumeLengthInput)

bool strongVolume =
     not na(volumeAverage) and
     volume >= volumeAverage * volumeMultiplierInput

bool extremeVolume =
     not na(volumeAverage) and
     volume >= volumeAverage * extremeVolumeMultiplierInput

bool maRising =
     sessionMA > sessionMA[maSlopeLookbackInput]

bool maFalling =
     sessionMA < sessionMA[maSlopeLookbackInput]

bool aboveMA = close > sessionMA
bool belowMA = close < sessionMA

bool aboveVWAP = close > sessionVwap
bool belowVWAP = close < sessionVwap

// ============================================================================
// CANDLE QUALITY
// ============================================================================
float candleRange = high - low
float candleBody = math.abs(close - open)

float bodyPercent =
     candleRange > 0
     ? candleBody / candleRange
     : 0.0

bool bullishCandle = close > open
bool bearishCandle = close < open

bool strongBullCandle =
     bullishCandle and
     bodyPercent >= 0.55 and
     close >= high - candleRange * 0.25

bool strongBearCandle =
     bearishCandle and
     bodyPercent >= 0.55 and
     close <= low + candleRange * 0.25

// ============================================================================
// ORB LOCATION
// ============================================================================
bool outsideLong =
     rangeReady and
     close > rangeHigh

bool outsideShort =
     rangeReady and
     close < rangeLow

bool insideORB =
     rangeReady and
     close <= rangeHigh and
     close >= rangeLow

bool upperHalf =
     insideORB and close > rangeMid

bool lowerHalf =
     insideORB and close < rangeMid

// ============================================================================
// RETEST TOLERANCE
// ============================================================================
float retestTolerance =
     atrValue * retestToleranceAtrInput

// OR retests
bool longOrbRetest =
     rangeReady and
     low <= rangeHigh + retestTolerance and
     low >= rangeHigh - retestTolerance and
     close > rangeHigh

bool shortOrbRetest =
     rangeReady and
     high >= rangeLow - retestTolerance and
     high <= rangeLow + retestTolerance and
     close < rangeLow

// MA retests
bool longMARetest =
     low <= sessionMA + retestTolerance and
     close > sessionMA and
     bullishCandle

bool shortMARetest =
     high >= sessionMA - retestTolerance and
     close < sessionMA and
     bearishCandle

// VWAP retests
bool longVwapRetest =
     low <= sessionVwap + retestTolerance and
     close > sessionVwap and
     bullishCandle

bool shortVwapRetest =
     high >= sessionVwap - retestTolerance and
     close < sessionVwap and
     bearishCandle

// ============================================================================
// OR EDGE REJECTIONS
// ============================================================================
bool longLowRejection =
     insideORB and
     low <= rangeLow + retestTolerance and
     close > rangeLow + retestTolerance and
     bullishCandle

bool shortHighRejection =
     insideORB and
     high >= rangeHigh - retestTolerance and
     close < rangeHigh - retestTolerance and
     bearishCandle

// ============================================================================
// MIDPOINT CONTINUATION
// ============================================================================
bool longMidContinuation =
     insideORB and
     close > rangeMid and
     close[1] <= rangeMid and
     aboveMA and
     aboveVWAP and
     strongBullCandle

bool shortMidContinuation =
     insideORB and
     close < rangeMid and
     close[1] >= rangeMid and
     belowMA and
     belowVWAP and
     strongBearCandle

// ============================================================================
// EXTENSION FILTER
// ============================================================================
float maDistance =
     math.abs(close - sessionMA)

bool notOverextended =
     maDistance <=
     atrValue * maxExtensionAtrInput

// ============================================================================
// A / A+ SCORING
// ============================================================================
int longScore = 0

longScore += aboveVWAP ? 1 : 0
longScore += aboveMA ? 1 : 0
longScore += maRising ? 1 : 0
longScore += strongVolume ? 1 : 0
longScore += strongBullCandle ? 1 : 0

longScore += (
     longOrbRetest or
     longMARetest or
     longVwapRetest or
     longLowRejection or
     longMidContinuation
     ) ? 1 : 0

longScore += (
     outsideLong or
     upperHalf or
     longLowRejection
     ) ? 1 : 0

longScore += extremeVolume ? 1 : 0

int shortScore = 0

shortScore += belowVWAP ? 1 : 0
shortScore += belowMA ? 1 : 0
shortScore += maFalling ? 1 : 0
shortScore += strongVolume ? 1 : 0
shortScore += strongBearCandle ? 1 : 0

shortScore += (
     shortOrbRetest or
     shortMARetest or
     shortVwapRetest or
     shortHighRejection or
     shortMidContinuation
     ) ? 1 : 0

shortScore += (
     outsideShort or
     lowerHalf or
     shortHighRejection
     ) ? 1 : 0

shortScore += extremeVolume ? 1 : 0

// ============================================================================
// SETUP GRADES
// ============================================================================
bool longAPlus =
     longScore >= minimumAPlusScoreInput

bool shortAPlus =
     shortScore >= minimumAPlusScoreInput

bool longA =
     longScore >= minimumAScoreInput and
     longScore < minimumAPlusScoreInput

bool shortA =
     shortScore >= minimumAScoreInput and
     shortScore < minimumAPlusScoreInput

// ============================================================================
// CONFIRMATION
// ============================================================================
bool longConfirmation =
     not requireConfirmationCandleInput or
     strongBullCandle

bool shortConfirmation =
     not requireConfirmationCandleInput or
     strongBearCandle

// ============================================================================
// VALID LOCATION
// ============================================================================
bool validLongLocation =
     outsideLong or
     (
         allowInsideOrbInput and
         insideORB and
         (
             upperHalf or
             longLowRejection or
             longMidContinuation
         )
     )

bool validShortLocation =
     outsideShort or
     (
         allowInsideOrbInput and
         insideORB and
         (
             lowerHalf or
             shortHighRejection or
             shortMidContinuation
         )
     )

// ============================================================================
// PROP ACCOUNT
// ============================================================================
var float baseStrategyEquity = na
var float dayStartPropEquity = na
var float peakPropEquity = na

var int tradesToday = 0

var bool dailyLossBreached = false
var bool maxDrawdownBreached = false
var bool accountTargetReached = false

if na(baseStrategyEquity)
    baseStrategyEquity := strategy.equity

float simulatedPropEquity =
     propAccountSizeInput +
     strategy.equity -
     baseStrategyEquity

if na(dayStartPropEquity) or newDay
    dayStartPropEquity := simulatedPropEquity
    tradesToday := 0
    dailyLossBreached := false

if na(peakPropEquity)
    peakPropEquity := simulatedPropEquity
else
    peakPropEquity :=
         math.max(
             peakPropEquity,
             simulatedPropEquity)

float dailyLossAmount =
     propAccountSizeInput *
     dailyLossLimitInput / 100.0

float maxDrawdownAmount =
     propAccountSizeInput *
     maxDrawdownInput / 100.0

float evaluationTargetAmount =
     propAccountSizeInput *
     evaluationTargetInput / 100.0

if enablePropRulesInput
    if simulatedPropEquity <=
         dayStartPropEquity - dailyLossAmount
        dailyLossBreached := true

    if simulatedPropEquity <=
         peakPropEquity - maxDrawdownAmount
        maxDrawdownBreached := true

    if simulatedPropEquity >=
         propAccountSizeInput +
         evaluationTargetAmount
        accountTargetReached := true

bool propLockout =
     enablePropRulesInput and
     (
         dailyLossBreached or
         maxDrawdownBreached or
         accountTargetReached
     )

bool propTradingAllowed =
     not enablePropRulesInput or
     (
         not propLockout and
         tradesToday < maxTradesInput
     )

// ============================================================================
// TREND VALIDATION
// ============================================================================
bool longTrendValid =
     (not useVwapInput or aboveVWAP) and
     (not useMAInput or aboveMA) and
     (not useMASlopeInput or maRising)

bool shortTrendValid =
     (not useVwapInput or belowVWAP) and
     (not useMAInput or belowMA) and
     (not useMASlopeInput or maFalling)

// ============================================================================
// ENTRY CONDITIONS
// ============================================================================
bool baseTradePermission =
     barstate.isconfirmed and
     rangeReady and
     not inRangeSession and
     strategy.position_size == 0 and
     propTradingAllowed and
     notOverextended

bool longSignal =
     baseTradePermission and
     validLongLocation and
     longTrendValid and
     longConfirmation and
     longScore >= minimumAScoreInput

bool shortSignal =
     baseTradePermission and
     validShortLocation and
     shortTrendValid and
     shortConfirmation and
     shortScore >= minimumAScoreInput

bool finalLongSignal =
     longSignal and not shortSignal

bool finalShortSignal =
     shortSignal and not longSignal

// ============================================================================
// ENTRIES
// ============================================================================
if finalLongSignal
    tradesToday += 1

    strategy.entry(
         "Long",
         strategy.long,
         comment =
             longAPlus
             ? "A+ LONG"
             : "A LONG",
         alert_message =
             (longAPlus ? "A+ LONG" : "A LONG") +
             " | Score " +
             str.tostring(longScore) +
             "/8")

if finalShortSignal
    tradesToday += 1

    strategy.entry(
         "Short",
         strategy.short,
         comment =
             shortAPlus
             ? "A+ SHORT"
             : "A SHORT",
         alert_message =
             (shortAPlus ? "A+ SHORT" : "A SHORT") +
             " | Score " +
             str.tostring(shortScore) +
             "/8")

// ============================================================================
// INITIAL RISK
// ============================================================================
var float longInitialRisk = na
var float shortInitialRisk = na

bool newLongPosition =
     strategy.position_size > 0 and
     strategy.position_size[1] <= 0

bool newShortPosition =
     strategy.position_size < 0 and
     strategy.position_size[1] >= 0

if newLongPosition
    longInitialRisk :=
         atrValue *
         stopAtrMultiplierInput

if newShortPosition
    shortInitialRisk :=
         atrValue *
         stopAtrMultiplierInput

if strategy.position_size == 0
    longInitialRisk := na
    shortInitialRisk := na

// ============================================================================
// STOPS AND TARGETS
// ============================================================================
float longBaseStop =
     strategy.position_size > 0 and
     not na(longInitialRisk)
     ? strategy.position_avg_price -
       longInitialRisk
     : na

float longTarget =
     strategy.position_size > 0 and
     not na(longInitialRisk)
     ? strategy.position_avg_price +
       longInitialRisk * riskRewardInput
     : na

float shortBaseStop =
     strategy.position_size < 0 and
     not na(shortInitialRisk)
     ? strategy.position_avg_price +
       shortInitialRisk
     : na

float shortTarget =
     strategy.position_size < 0 and
     not na(shortInitialRisk)
     ? strategy.position_avg_price -
       shortInitialRisk * riskRewardInput
     : na

// ============================================================================
// BREAK EVEN
// ============================================================================
var bool longBEActive = false
var bool shortBEActive = false

if newLongPosition
    longBEActive := false

if newShortPosition
    shortBEActive := false

bool longBreakEvenReached =
     strategy.position_size > 0 and
     useBreakEvenInput and
     not na(longInitialRisk) and
     high >=
         strategy.position_avg_price +
         longInitialRisk *
         breakEvenTriggerInput

bool shortBreakEvenReached =
     strategy.position_size < 0 and
     useBreakEvenInput and
     not na(shortInitialRisk) and
     low <=
         strategy.position_avg_price -
         shortInitialRisk *
         breakEvenTriggerInput

if longBreakEvenReached
    longBEActive := true

if shortBreakEvenReached
    shortBEActive := true

if strategy.position_size == 0
    longBEActive := false
    shortBEActive := false

float activeLongStop =
     longBEActive
     ? math.max(
         longBaseStop,
         strategy.position_avg_price)
     : longBaseStop

float activeShortStop =
     shortBEActive
     ? math.min(
         shortBaseStop,
         strategy.position_avg_price)
     : shortBaseStop

// ============================================================================
// HARD EXITS
// ============================================================================
strategy.exit(
     "Long Target/Stop",
     from_entry = "Long",
     stop = activeLongStop,
     limit = longTarget,
     alert_message = "EXIT LONG")

strategy.exit(
     "Short Target/Stop",
     from_entry = "Short",
     stop = activeShortStop,
     limit = shortTarget,
     alert_message = "EXIT SHORT")

// ============================================================================
// TREND FAILURE EXIT
// ============================================================================
bool longTrendFailure =
     useTrendExitInput and
     strategy.position_size > 0 and
     close < sessionMA and
     close < sessionVwap and
     bearishCandle

bool shortTrendFailure =
     useTrendExitInput and
     strategy.position_size < 0 and
     close > sessionMA and
     close > sessionVwap and
     bullishCandle

if longTrendFailure
    strategy.close(
         "Long",
         comment = "Trend Exit",
         alert_message = "EXIT LONG: MA + VWAP lost")

if shortTrendFailure
    strategy.close(
         "Short",
         comment = "Trend Exit",
         alert_message = "EXIT SHORT: MA + VWAP reclaimed")

// ============================================================================
// PROP LOCKOUT
// ============================================================================
if propLockout and strategy.position_size != 0
    strategy.close_all(
         comment = "Prop Lockout",
         alert_message = "PROP RULE LOCKOUT")

// ============================================================================
// OR VISUALS
// ============================================================================
bool showRange =
     inRangeSession or rangeReady

orHighPlot = plot(
     showRange ? rangeHigh : na,
     "OR High",
     color = orLevelsColorInput,
     linewidth = 2,
     style = plot.style_linebr)

orLowPlot = plot(
     showRange ? rangeLow : na,
     "OR Low",
     color = orLevelsColorInput,
     linewidth = 2,
     style = plot.style_linebr)

plot(
     showMidpointInput and showRange
     ? rangeMid
     : na,
     "OR Midpoint",
     color = color.new(
         orLevelsColorInput,
         35),
     linewidth = 1,
     style = plot.style_linebr)

fill(
     orHighPlot,
     orLowPlot,
     color = orHighlightColorInput,
     title = "OR Highlight")

// ============================================================================
// SESSION MA + VWAP
// ============================================================================
plot(
     showSessionMAInput
     ? sessionMA
     : na,
     "Session Moving Average",
     color = sessionMAColorInput,
     linewidth = 2)

plot(
     showVwapInput
     ? sessionVwap
     : na,
     "VWAP",
     color = color.purple,
     linewidth = 2)

// ============================================================================
// TARGET / STOP VISUALS
// ============================================================================
longTargetPlot = plot(
     showTargetsInput and
     strategy.position_size > 0
     ? longTarget
     : na,
     "Bull Target",
     color = bullTargetColorInput,
     linewidth = 2,
     style = plot.style_linebr)

longStopPlot = plot(
     showTargetsInput and
     strategy.position_size > 0
     ? activeLongStop
     : na,
     "Bull Stop",
     color = bullTargetColorInput,
     linewidth = 1,
     style = plot.style_linebr)

shortTargetPlot = plot(
     showTargetsInput and
     strategy.position_size < 0
     ? shortTarget
     : na,
     "Bear Target",
     color = bearTargetColorInput,
     linewidth = 2,
     style = plot.style_linebr)

shortStopPlot = plot(
     showTargetsInput and
     strategy.position_size < 0
     ? activeShortStop
     : na,
     "Bear Stop",
     color = bearTargetColorInput,
     linewidth = 1,
     style = plot.style_linebr)

fill(
     longTargetPlot,
     longStopPlot,
     color = bullFillColorInput,
     title = "Bull Target Fill")

fill(
     shortTargetPlot,
     shortStopPlot,
     color = bearFillColorInput,
     title = "Bear Target Fill")

// ============================================================================
// SIGNAL LABELS
// ============================================================================
plotshape(
     showSignalsInput and
     finalLongSignal and
     longAPlus,
     title = "A+ Long",
     style = shape.labelup,
     location = location.belowbar,
     color = bullTargetColorInput,
     text = "A+ LONG",
     textcolor = color.white,
     size = size.small)

plotshape(
     showSignalsInput and
     finalLongSignal and
     longA,
     title = "A Long",
     style = shape.labelup,
     location = location.belowbar,
     color = bullTargetColorInput,
     text = "A LONG",
     textcolor = color.white,
     size = size.tiny)

plotshape(
     showSignalsInput and
     finalShortSignal and
     shortAPlus,
     title = "A+ Short",
     style = shape.labeldown,
     location = location.abovebar,
     color = bearTargetColorInput,
     text = "A+ SHORT",
     textcolor = color.white,
     size = size.small)

plotshape(
     showSignalsInput and
     finalShortSignal and
     shortA,
     title = "A Short",
     style = shape.labeldown,
     location = location.abovebar,
     color = bearTargetColorInput,
     text = "A SHORT",
     textcolor = color.white,
     size = size.tiny)

// ============================================================================
// EXIT LABELS
// ============================================================================
plotshape(
     longTrendFailure,
     title = "Exit Long",
     style = shape.xcross,
     location = location.abovebar,
     color = bearTargetColorInput,
     text = "EXIT L",
     textcolor = color.white,
     size = size.tiny)

plotshape(
     shortTrendFailure,
     title = "Exit Short",
     style = shape.xcross,
     location = location.belowbar,
     color = bullTargetColorInput,
     text = "EXIT S",
     textcolor = color.white,
     size = size.tiny)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(
     finalLongSignal and longAPlus,
     "A+ LONG",
     "A+ LONG setup")

alertcondition(
     finalLongSignal and longA,
     "A LONG",
     "A LONG setup")

alertcondition(
     finalShortSignal and shortAPlus,
     "A+ SHORT",
     "A+ SHORT setup")

alertcondition(
     finalShortSignal and shortA,
     "A SHORT",
     "A SHORT setup")

alertcondition(
     longTrendFailure,
     "EXIT LONG",
     "Long lost Session MA and VWAP")

alertcondition(
     shortTrendFailure,
     "EXIT SHORT",
     "Short reclaimed Session MA and VWAP")

alertcondition(
     propLockout,
     "PROP LOCKOUT",
     "Trading locked by prop risk rules")