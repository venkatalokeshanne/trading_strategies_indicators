    3964.45

)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// กลุ่มที่ 2
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

showGroup2 = input.bool(true, "แสดงกลุ่ม 2")
colorGroup2 = input.color(color.blue, "สีเส้นกลุ่ม 2")
widthGroup2 = input.int(1, "ความหนากลุ่ม 2", minval=1, maxval=5)

group2Prices = array.from(
    5217.26,
    5203.41,
    5133.77,
    5122.62,
    5088.64,
    5073.02,
    5022.67,
    5013.78,
    4964.84,
    4922.19,
    4900.92,
    4880.64,
    4865.60,
    4758.48,
    4705.15,
    4689.22,
    4500.21,
    4491.36,
