leftUsePriceCondition = input.bool(true, "Use Price Condition", group=gL2)
leftHeaderColor = input.color(color.rgb(45,45,45), "Header Color", group=gL2)
leftTextColor = input.color(color.white, "Text Color", group=gL2)
