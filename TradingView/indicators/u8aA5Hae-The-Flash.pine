//@version=6
indicator("The Flash", overlay=true)

// ============================================================================
// INPUT PARAMETERS
// ============================================================================
adxLength = input.int(14, "ADX Length", minval=1)
adxThreshold = input.float(13.0, "ADX Threshold", minval=0, step=0.1)
flashColor = input.color(color.new(color.gray, 70), "Flash Color")
bullishArrowColor = input.color(color.lime, "Bullish Signal Arrow Color")
bearishArrowColor = input.color(color.red, "Bearish Signal Arrow Color")

// ============================================================================
// ADX CALCULATION
// ============================================================================
[diPlus, diMinus, adx] = ta.dmi(adxLength, adxLength)

// ============================================================================
// FLASH LOGIC
// ============================================================================
var bool flashActive = false
var float flashLevel = na
var int flashStartBar = na

// Check if ADX crosses below threshold
adxCrossBelowThreshold = ta.crossunder(adx, adxThreshold)

// Activate flash when ADX crosses below threshold
if adxCrossBelowThreshold
    flashActive := true
    flashLevel := close
    flashStartBar := bar_index

// Check if ADX crosses above either DI (to deactivate flash)
adxCrossAboveDIPlus = flashActive and ta.crossover(adx, diPlus)
adxCrossAboveDIMinus = flashActive and ta.crossover(adx, diMinus)
flashEnded = adxCrossAboveDIPlus or adxCrossAboveDIMinus

// Deactivate flash when ADX crosses above either DI
if flashEnded
    flashActive := false

// Determine signal based on DI relationship when flash ends
// Signal is on the candle RIGHT AFTER the flash ends
var bool showSignal = false
var bool signalIsBullish = false

if flashEnded[1]  // Flash ended on previous bar
    showSignal := true
    signalIsBullish := diPlus > diMinus  // Bullish if +DI is above -DI
else
    showSignal := false

// ============================================================================
// VISUALIZATION
// ============================================================================

// Draw flash using background color
bgcolor(flashActive ? flashColor : na, title="Flash Zone")

// Plot small arrows for signals on the candle after flash ends
// Bullish: arrow pointing up at bottom of candle
// Bearish: arrow pointing down at top of candle
plotshape(showSignal and signalIsBullish, title="Bullish Signal", 
          style=shape.triangleup, location=location.belowbar, 
          color=bullishArrowColor, size=size.tiny)
plotshape(showSignal and not signalIsBullish, title="Bearish Signal", 
          style=shape.triangledown, location=location.abovebar, 
          color=bearishArrowColor, size=size.tiny)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(adxCrossBelowThreshold, title="Flash Activated", 
               message="The Flash: Flash activated - ADX below threshold")
alertcondition(showSignal and signalIsBullish, title="Bullish Signal", 
               message="The Flash: Bullish signal - +DI above -DI")
alertcondition(showSignal and not signalIsBullish, title="Bearish Signal", 
               message="The Flash: Bearish signal - -DI above +DI")

// ============================================================================
// PLOT FOR DEBUGGING (optional - can be removed)
// ============================================================================
// Uncomment below to see ADX and DI values in a separate pane
// plot(adx, "ADX", color=color.red)
// plot(diPlus, "+DI", color=color.green)
// plot(diMinus, "-DI", color=color.orange)
// hline(adxThreshold, "Threshold", color=color.gray, linestyle=hline.style_dashed)