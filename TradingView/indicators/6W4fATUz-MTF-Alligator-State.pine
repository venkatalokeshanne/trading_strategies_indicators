//@version=6
indicator("MTF Alligator State", shorttitle = "Alligator MTF", overlay = true)

// ============================================================
// ALLIGATOR
// ============================================================
src      = input.source(hl2, "Source",        group = "Alligator")
jawLen   = input.int(13, "Jaw Length",   minval = 1, group = "Alligator")
jawOff   = input.int(8,  "Jaw Offset",   minval = 0, group = "Alligator")
teethLen = input.int(8,  "Teeth Length", minval = 1, group = "Alligator")
teethOff = input.int(5,  "Teeth Offset", minval = 0, group = "Alligator")
lipsLen  = input.int(5,  "Lips Length",  minval = 1, group = "Alligator")
lipsOff  = input.int(3,  "Lips Offset",  minval = 0, group = "Alligator")

// ============================================================
// PAPARAN
// ============================================================
confirmedOnly = input.bool(true, "Guna bar HTF yang sudah close sahaja", group = "Paparan")
tblPos = input.string("Top Right", "Kedudukan jadual", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = "Paparan")

// ============================================================
// STATUS: 1 = BUY, -1 = SELL, 0 = SIDEWAYS
// BUY  = lips > teeth > jaw DAN close di atas garisan hijau
// SELL = lips < teeth < jaw DAN close di bawah garisan hijau
// ============================================================
f_state() =>
    float jaw   = ta.rma(src, jawLen)[jawOff]
    float teeth = ta.rma(src, teethLen)[teethOff]
    float lips  = ta.rma(src, lipsLen)[lipsOff]
    bool isBuy  = lips > teeth and teeth > jaw and close > lips
    bool isSell = lips < teeth and teeth < jaw and close < lips
    int st = isBuy ? 1 : isSell ? -1 : 0
    confirmedOnly ? st[1] : st

int sW1 = request.security(syminfo.tickerid, "W",   f_state(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
int sD1 = request.security(syminfo.tickerid, "D",   f_state(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
int sH4 = request.security(syminfo.tickerid, "240", f_state(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
int sH1 = request.security(syminfo.tickerid, "60",  f_state(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

// ============================================================
// LABEL & WARNA
// ============================================================
f_txt(int s) => s == 1 ? "BUY" : s == -1 ? "SELL" : "SIDEWAYS"
f_bg(int s) => s == 1 ? color.new(color.green, 15) : s == -1 ? color.new(color.red, 15) : color.new(color.gray, 45)

pos = tblPos == "Top Left" ? position.top_left : tblPos == "Bottom Right" ? position.bottom_right : tblPos == "Bottom Left" ? position.bottom_left : position.top_right

// ============================================================
// JADUAL
// ============================================================
var table tbl = table.new(pos, 2, 5, border_width = 1, border_color = color.new(color.gray, 60))

if barstate.islast
    table.cell(tbl, 0, 0, "TF",    text_color = color.white, bgcolor = color.black)
    table.cell(tbl, 1, 0, "STATE", text_color = color.white, bgcolor = color.black)
    table.cell(tbl, 0, 1, "W1", text_color = color.white, bgcolor = color.new(color.black, 20))
    table.cell(tbl, 1, 1, f_txt(sW1), text_color = color.white, bgcolor = f_bg(sW1))
    table.cell(tbl, 0, 2, "D1", text_color = color.white, bgcolor = color.new(color.black, 20))
    table.cell(tbl, 1, 2, f_txt(sD1), text_color = color.white, bgcolor = f_bg(sD1))
    table.cell(tbl, 0, 3, "H4", text_color = color.white, bgcolor = color.new(color.black, 20))
    table.cell(tbl, 1, 3, f_txt(sH4), text_color = color.white, bgcolor = f_bg(sH4))
    table.cell(tbl, 0, 4, "H1", text_color = color.white, bgcolor = color.new(color.black, 20))
    table.cell(tbl, 1, 4, f_txt(sH1), text_color = color.white, bgcolor = f_bg(sH1))