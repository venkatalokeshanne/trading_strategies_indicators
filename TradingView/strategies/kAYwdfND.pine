//@version=6
strategy("Simplified 30m Event Strategy - Reverse", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, pyramiding=1)

// === Pivot 参数 ===
left = input.int(2, "Pivot Left")
right = input.int(3, "Pivot Right")
exitBars = input.int(6, "Exit after X bars (5min)")

// === 获取 30分钟数据 ===
high30  = request.security(syminfo.tickerid, "30", high)
low30   = request.security(syminfo.tickerid, "30", low)
close30 = request.security(syminfo.tickerid, "30", close)

// === Pivot 高低点 ===
ph30 = ta.pivothigh(high30, left, right)
pl30 = ta.pivotlow(low30, left, right)

// 最近 Pivot
lastPH = ta.valuewhen(not na(ph30), ph30, 0)
lastPL = ta.valuewhen(not na(pl30), pl30, 0)

// === 验证有效且波动大于最小值 ===
minRange = input.float(5, "Min Pivot Range")
valid = not na(lastPH) and not na(lastPL) and (lastPH - lastPL) >= minRange

// === 简化 Delta ===
delta = close > open ? volume : close < open ? -volume : 0

// === 反向入场信号 ===
longSignal  = valid and close > lastPL and delta < 0   // 原来空的地方做多
shortSignal = valid and close < lastPH and delta > 0   // 原来多的地方做空

// === 持仓计数 ===
var longBarCount  = 0
var shortBarCount = 0

if strategy.position_size > 0
    longBarCount += 1
else
    longBarCount := 0

if strategy.position_size < 0
    shortBarCount += 1
else
    shortBarCount := 0

// === 固定 6-bar 平仓 ===
if longBarCount >= exitBars
    strategy.close("Long")
if shortBarCount >= exitBars
    strategy.close("Short")

// === 下单 ===
if longSignal
    strategy.entry("Long", strategy.long)
if shortSignal
    strategy.entry("Short", strategy.short)

// === 可视化 ===
plot(lastPH, color=color.green)
plot(lastPL, color=color.red)
plotshape(longSignal, location=location.belowbar, style=shape.labelup, color=color.green, text="BUY")
plotshape(shortSignal, location=location.abovebar, style=shape.labeldown, color=color.red, text="SELL")