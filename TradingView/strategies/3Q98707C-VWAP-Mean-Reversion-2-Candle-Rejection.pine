//@version=6
strategy("VWAP Mean Reversion (2 Candle Rejection)", overlay=true)

// Indicators
vwapValue = ta.vwap(close)
atr = ta.atr(14)

// Session filter
hourNY = hour(time, "America/New_York")
sessionFilter = (hourNY >= 18) or (hourNY <= 2)

// EMA flat filter
ema20 = ta.ema(close,20)
emaSlope = math.abs(ema20 - ema20[10])
flatEMA = emaSlope < atr * 0.4

// ATR bands
upperBand = vwapValue + atr * 2.5
lowerBand = vwapValue - atr * 2.5

// Stops
upperStop = vwapValue + atr * 4
lowerStop = vwapValue - atr * 4

// 2-candle rejection signals
longReject = (low[1] < lowerBand[1]) or (low < lowerBand)
shortReject = (high[1] > upperBand[1]) or (high > upperBand)

longSignal = longReject and close > lowerBand
shortSignal = shortReject and close < upperBand

// Long trade calculations
entryLong = close
stopLong = lowerStop
targetLong = vwapValue
riskLong = entryLong - stopLong
rewardLong = targetLong - entryLong
validLongRR = rewardLong >= riskLong * 1.5

// Short trade calculations
entryShort = close
stopShort = upperStop
targetShort = vwapValue
riskShort = stopShort - entryShort
rewardShort = entryShort - targetShort
validShortRR = rewardShort >= riskShort * 1.5

// Execute trades
if longSignal and validLongRR and sessionFilter and flatEMA
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", from_entry="Long", stop=stopLong, limit=targetLong)

if shortSignal and validShortRR and sessionFilter and flatEMA
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", from_entry="Short", stop=stopShort, limit=targetShort)

// Plot lines
plot(vwapValue, color=color.orange, linewidth=2)
plot(upperBand, color=color.red)
plot(lowerBand, color=color.green)
plot(upperStop, color=color.purple)
plot(lowerStop, color=color.purple)