//@version=6
indicator("Andrey Colored Volume", overlay=true)

//---------------------------------------------------------
// Volume values (same as TradingView)
//---------------------------------------------------------
vol      = volume
vol_prev = volume[1]

//---------------------------------------------------------
// 3‑color logic
//---------------------------------------------------------
volColor =
     vol > vol_prev ? color.green :
     vol < vol_prev ? color.red   :
                      color.yellow

//---------------------------------------------------------
// Plot volume exactly like TradingView
//---------------------------------------------------------
plot(vol,
     title = "Volume",
     style = plot.style_columns,
     color = volColor)
