float max_size = MAX_SIZE
// ========================================
// ETF POSITION RISKING
//
// defines how much You want to risk tarding ETF or CFD
// depends also on the margin configuratio for the 
// according instrument.
// setting to na means, You take Your whole account size for calculations
// ========================================

//var int etf_value = 3000
var int etf_value = (WEEKLY_TARGET * 2) + (WEEKLY_TARGET != 0 ? (MAX_DAILY_LOSS * 2) : 0)

// ========================================
// INSTRUMENT MAPPING FUNCTIONS
// ========================================

// OANDA Symbol Mapping
mapToOanda(oa_symbol) =>

    [x_symbol, x_size, x_limit] = switch oa_symbol

        // ===== Indizes =====
        "NAS100USD" => ["NAS100_USD", 2, 1]
        "US30USD"   => ["US30_USD",   2, 1]
        "SPX500USD" => ["SPX500_USD", 2, 1]
        "GER40USD"  => ["DE30_EUR",   2, 1]
        "EU50EUR"   => ["EU50_EUR",   1, 1]
        "JPN225USD" => ["JP225_USD",  2, 1]
        "HK33HKD"   => ["HK33_HKD",   1, 1]
        "CN50USD"   => ["CN50_USD",   1, 1]

        // ===== Bonds =====
        "USB30YUSD" => ["USB30Y_USD", 0, 3]
        "USB10YUSD" => ["USB10Y_USD", 0, 3]

        // ===== Metalle =====
        "XAUUSD" => ["XAU_USD", 1, 3]
        "XAGUSD" => ["XAG_USD", 0, 2]
        "XCUUSD" => ["XCU_USD", 0, 4]

        // ===== Energy =====
        "WTICOUSD"  => ["WTICO_USD", 0, 2]
        "BCOUSD"    => ["BCO_USD",   0, 2]
        "NATGASUSD" => ["NATGAS_USD",0, 3]

        // ===== Corns =====
        "WHEATUSD"  => ["WHEAT_USD", 0, 3]

        // ===== Forex =====
        "EURUSD" => ["EUR_USD", 0, 3]
        "GBPUSD" => ["GBP_USD", 0, 3]
        "USDJPY" => ["USD_JPY", 0, 3]
        "USDCHF" => ["USD_CHF", 0, 3]
        "EURGBP" => ["EUR_GBP", 0, 3]
        "EURCHF" => ["EUR_CHF", 0, 3]

        // ===== Crypto =====
        "BTCUSD" => ["BTC_USD", 3, 0]
        "ETHUSD" => ["ETH_USD", 2, 0]
        "XRPUSD" => ["XRP_USD", 2, 0]

        // ===== Fallback =====
        => [oa_symbol, 0, 0]

    [x_symbol, x_size, x_limit]

// IG Markets Symbol Mapping
mapToIG(ig_symbol) =>
    upper_symbol = str.upper(ig_symbol)
    [x_symbol, x_size, x_minsize, x_limit] = switch upper_symbol

        // ===== Europa =====
        "STXE"      => ["IX.D.STXE.IFM.IP", 1, 0.5, 1]

        // ===== USA =====
        "DOW"      => ["IX.D.DOW.IFM.IP", 1, 0.5, 1]
        "SPTRD"    => ["IX.D.SPTRD.IFM.IP", 2, 0.04, 2]
        "NASDAQ"   => ["IX.D.NASDAQ.IFM.IP", 1, 0.5, 1]

        // ===== Asien =====
        "NIKKEI225"  => [ "IX.D.NIKKEI.IFM.IP", 1, 0.5, 1]
        "CHINA50"    => ["IX.D.XINHUA.IFM.IP", 1, 1.0, 1]
 
        // ===== Metalle =====
        "SPOTGOLD" => ["CS.D.CFDGOLD.CFM.IP", 2, 0.1, 2]
        "COPPER"   => ["CS.D.COPPER.MINI.IP", 2, 0.25, 1]
        "SILVER"   => ["CS.D.CFDSILVER.CFM.IP", 2, 0.1, 3]

        // ===== Energy =====
        "USOIL"      => ["CC.D.CL.UNC.IP", 2, 0.01, 1 ]
        "NATURALGAS" => ["CC.D.NG.UNC.IP", 2, 2.0, 0]

        //"WHEAT-CHICAGOWHEAT"     => ["CC.D.W.UMP.IP", 1, 15.0, 1]
        // ===== Forex =====

        // ===== Crypto =====
        "ETHUSD"    => ["CS.D.ETHUSD.CFD.IP", 1, 0.03, 1]
        // 0.1 $pP
        "BITCOIN"   => ["CS.D.BITCOIN.CFD.IP", 1, 1, 1]

        // ===== Fallback =====
        => [ig_symbol, 1, 0.1, 0]

    [x_symbol, x_size, x_minsize, x_limit]

// fetch prices from mirror instruments and initial init of risk_amount
fetchOtherInstrument() =>
    float pShares = PossibleShares
    float oInstrumentCL = 0.0
    float oMintick = 0.0

    if BASE_TRADE
        t = ticker.new(
            stk_xChange,
            stk_symbol,
            session.extended
        )
        oInstrumentCL := request.security(
            t, chart_timeframe,
            gaps = barmerge.gaps_off,
            lookahead = barmerge.lookahead_off,
            expression = close
            )
        oMintick := request.security(
            t, chart_timeframe,
            gaps = barmerge.gaps_off,
            lookahead = barmerge.lookahead_off,
            expression = syminfo.mintick
            )

        if etf_value == 0
            pShares := ACCOUNT_SIZE / oInstrumentCL
        else
            pShares := (etf_value / margin) / oInstrumentCL

    [oInstrumentCL, pShares, oMintick]

// DEBUG: Detaillierte Instrument Info Box
// if barstate.islast
//     var label infoLabel = na
//     label.delete(infoLabel)
//
//     string info_text = "Instrument: " + stk_symbol + "\n" + 
//                        "Contract: " + currentInstrument + "\n" + 
//                        "Exchange: " + stk_xChange + "\n" + 
//                        "Inst_Type: " + InstType + "\n" + 
//                        "Mirror: " + MIRROR_TRD + "\n" + 
//                        "Close: " + str.tostring(otherInstrumentClose)
//
//     infoLabel := label.new(
//          x = bar_index, 
//          y = high, 
//          text = info_text, 
//          style = label.style_label_down, 
//          color = color.new(#1a1a1a, 10), 
//          textcolor = #00bfff, 
//          size = size.small, 
//          textalign = text.align_left)

// ========================================
// TRADING CONFIG
// ========================================

// stop adaption
if AUTO_TRL
    BASE_TRL_STOP := false
    BASE_TGT := true
if BASE_TRL_STOP
    AUTO_TRL := false
else if (not BASE_TRL_STOP and not AUTO_TRL)
    BASE_RISK := 1.0

// prevent both LONG_ONLY and SHORT_ONLY
if LONG_ONLY and SHORT_ONLY
    LONG_ONLY := false
    SHORT_ONLY := false

// Dashboard output
signal_title = (BASE_SETBACK ? "/SB" : "") + (BASE_REENTRY ? "/RE" : "") + (LONG_ONLY ? "/LO" : "") + (SHORT_ONLY ? "/SO" : "") + "]"
trl_stp_title = BASE_TRL_STOP ? "TRX" : AUTO_TRL ? "TRL-A" : "NoSTP" 
tgt_limit_title = BASE_TGT ? "TGT" : "NoTGT"
param_title = FIX_PARAM ? "FIX" : "FLEX"

// ==================================================================================================
// TRADE SETUP RESOLUTION
// Determines effective INSTR_TRD, MIRROR_TRD, symbols and instrument from SIGNAL_GEN config
// ==================================================================================================

// plausi: token and account defaults
if TOKEN_ID == ""
    TOKEN_ID := "undefined"
if CLIENT_ID == ""
    CLIENT_ID := "undefined"

// ------------------------------------------------
type TradeSetup
    string instr_trd            // resolved: "FUT", "STK", "CFD"
    string mirror_trd           // resolved: "YES" or "NO"
    bool   base_trade           // false = block all signals
    string symbol               // symbol for price fetch  (= stk_symbol)
    string xchange              // exchange for price fetch (= stk_xChange)
    string instrument           // instrument name in alert JSON
    int    dot_size  = 0        // decimal places for position size rounding
    float  min_size  = 0.0      // minimum position size (IG only)

resolveTradeSetup() =>
    t = TradeSetup.new(
        instr_trd  = INSTR_TRD,
        mirror_trd = MIRROR_TRD,
        base_trade = BASE_TRADE,    // preserve any false already set (e.g. wrong timeframe)
        symbol     = stk_symbol,
        xchange    = stk_xChange,
        instrument = Instrument
    )

    // Step 1: Determine effective INSTR_TRD and MIRROR_TRD from SIGNAL_GEN
    if SIGNAL_GEN == "None"
        t.base_trade := false

    else if SIGNAL_GEN == "FUT"
        if t.mirror_trd == "NO"
            t.instr_trd  := "FUT"                       // direct futures mode
        else if InstType != "futures" and InstType != "crypto"
            t.mirror_trd := "NO"                        // non-futures chart: no mirror possible

    else if SIGNAL_GEN == "INSTRUMENT"
        t.mirror_trd := "NO"                            // always direct, no mirror needed

    // Step 2: Validate config and resolve symbol / exchange / instrument name
    if t.base_trade
        if t.instr_trd == "FUT"
            t.instrument := na(currContract) ? currentInstrument : currContract
            t.symbol     := t.instrument
            t.xchange    := xChange

        else if t.instr_trd == "STK"
            if t.mirror_trd == "YES" and stk_symbol == ""
                t.base_trade := false               // mirror requires pre-configured stk_symbol
            else
                // use pre-configured symbol if available, fall back to current instrument
                t.symbol     := stk_symbol != "" ? stk_symbol : currentInstrument
                t.xchange    := stk_symbol != "" ? stk_xChange : syminfo.prefix
                t.instrument := t.symbol

        else if t.instr_trd == "CFD" and CLIENT_ID == "OANDA"
            if t.mirror_trd == "YES" and oa_symbol == ""
                t.base_trade := false               // mirror requires pre-configured oa_symbol
            else
                active_sym         = oa_symbol != "" ? oa_symbol : currentInstrument
                [mapped, dsize, _] = mapToOanda(active_sym)
                t.symbol     := active_sym
                t.xchange    := "OANDA"
                t.instrument := mapped
                t.dot_size   := dsize

        else if t.instr_trd == "CFD" and CLIENT_ID == "IG_MARKETS"
            if t.mirror_trd == "YES" and ig_symbol == ""
                t.base_trade := false               // mirror requires pre-configured ig_symbol
            else
                active_sym              = ig_symbol != "" ? ig_symbol : currentInstrument
                [mapped, dsize, msize, _] = mapToIG(active_sym)
                t.symbol     := active_sym
                t.xchange    := "IG"
                t.instrument := mapped
                t.dot_size   := dsize
                t.min_size   := msize

        else if t.instr_trd == "CFD"
            t.base_trade := false                   // CFD requires OANDA or IG_MARKETS as CLIENT_ID
    t

// ------------------------------------------------
// Apply resolved setup
ts          = resolveTradeSetup()
INSTR_TRD   := ts.instr_trd
MIRROR_TRD  := ts.mirror_trd
BASE_TRADE  := ts.base_trade
stk_symbol  := ts.symbol
stk_xChange := ts.xchange
Instrument  := ts.instrument

// Cache mapping results for the current instrument — used in position sizing and alert building
var int    _map_dsize  = 0
var int    _map_dlimit = 0
var float  _map_minsize = 0.0

if INSTR_TRD == "CFD" and CLIENT_ID == "OANDA"
    [_, _map_dsize, _map_dlimit] = mapToOanda(stk_symbol)
else if INSTR_TRD == "CFD" and CLIENT_ID == "IG_MARKETS"
    [_, _map_dsize, _map_minsize, _map_dlimit] = mapToIG(stk_symbol)

// Safety override for FUT direct mode — ensures correct values even if input reassignment fails
if SIGNAL_GEN == "FUT" and MIRROR_TRD == "NO"
    INSTR_TRD  := "FUT"
    Instrument := na(currContract) ? currentInstrument : currContract

// Fetch prices and compute position sizes
if SIGNAL_GEN == "INSTRUMENT" and BASE_TRADE
    otherInstrumentClose := close
    x_count              = etf_value == 0 ? ACCOUNT_SIZE / close : (etf_value / margin) / close
    if INSTR_TRD == "CFD" and CLIENT_ID == "IG_MARKETS"
        stk_size         := math.max(ts.min_size, math.round(x_count, ts.dot_size))
        DOLLAR_PER_POINT := DOLLAR_PER_POINT * stk_size
    else if INSTR_TRD == "CFD" and CLIENT_ID == "OANDA"
        stk_size         := math.round(x_count, ts.dot_size)
        DOLLAR_PER_POINT := 1.0 * stk_size
    else  // STK
        stk_size         := math.round(x_count, 0)
        DOLLAR_PER_POINT := stk_size

else if INSTR_TRD == "STK" and BASE_TRADE
    [x_Close, x_count, _] = fetchOtherInstrument()
    stk_size             := math.round(x_count, 0)
    otherInstrumentClose := x_Close
    DOLLAR_PER_POINT     := (x_Close * stk_size) / close

else if INSTR_TRD == "CFD" and CLIENT_ID == "OANDA" and BASE_TRADE
    [x_Close, x_count, _] = fetchOtherInstrument()
    otherInstrumentClose := x_Close
    stk_size             := math.round(x_count, ts.dot_size)
    DOLLAR_PER_POINT     := 1.0 * stk_size

else if INSTR_TRD == "CFD" and CLIENT_ID == "IG_MARKETS" and BASE_TRADE
    [x_Close, x_count, _] = fetchOtherInstrument()
    otherInstrumentClose := x_Close
    stk_size             := math.max(ts.min_size, math.round(x_count, ts.dot_size))
    if stk_symbol == "ETHUSD"
        stk_size             := 0.5
    DOLLAR_PER_POINT     := DOLLAR_PER_POINT * stk_size

else if INSTR_TRD == "FUT"
    stk_size := max_size

// Position value scaling
if strategy.position_size != 0
    DOLLAR_PER_POINT     := DOLLAR_PER_POINT * math.abs(strategy.position_size)
    DOLLAR_PER_POINT_FUT := DOLLAR_PER_POINT_FUT * math.abs(strategy.position_size)
else
    DOLLAR_PER_POINT_FUT := SIGNAL_GEN == "FUT" ? DOLLAR_PER_POINT_FUT : DOLLAR_PER_POINT
//
// ==================================================================================================

// ========================================
// COLOR THEMES
// ========================================
[primaryBull, primaryBear, secondaryBull, secondaryBear, neutralColor, accent1, accent2, bgColorTheme] = switch colorTheme
    'Quantum' => [color.aqua, color.fuchsia, color.aqua, color.purple, color.blue, color.lime, color.orange, color.new(color.black, 95)]
    'Matrix' => [color.lime, color.red, color.green, color.maroon, color.gray, color.white, color.yellow, color.new(color.black, 90)]
    'Aurora' => [color.rgb(255, 182, 193), color.rgb(148, 0, 211), color.rgb(255, 218, 185), color.rgb(221, 160, 221), color.rgb(176, 224, 230), color.rgb(255, 255, 224), color.rgb(152, 251, 152), color.new(color.rgb(25, 25, 112), 95)]
    => [color.rgb(0, 255, 255), color.rgb(255, 0, 128), color.rgb(0, 191, 255), color.rgb(255, 20, 147), color.rgb(147, 112, 219), color.rgb(50, 205, 50), color.rgb(255, 140, 0), color.new(#0a0a0a, 95)]

// ========================================
// ADAPTIVE STATE VARIABLES
// ========================================
var array<float> trade_returns = array.new_float(PERFORMANCE_MEMORY)
var array<int> trade_directions = array.new_int(PERFORMANCE_MEMORY)
var array<int> trade_sessions = array.new_int(PERFORMANCE_MEMORY)
var array<string> trade_types = array.new_string(PERFORMANCE_MEMORY)
var array<float> trade_scores = array.new_float(PERFORMANCE_MEMORY)
var array<int> trade_hours = array.new_int(PERFORMANCE_MEMORY)
var array<float> trade_volatilities = array.new_float(PERFORMANCE_MEMORY)

var float adaptive_momentum_weight = 1.0
var float adaptive_structure_weight = 1.2
var float adaptive_volume_weight = 0.8
var float adaptive_reversal_weight = 0.6
var float adaptive_min_score = BASE_MIN_SCORE * 0.8
var float adaptive_risk_multiplier = 1.0

var float momentum_win_rate = 0.5
var float structure_win_rate = 0.5
var float volume_win_rate = 0.5
var float reversal_win_rate = 0.5
var float long_win_rate = 0.5
var float short_win_rate = 0.5

var float asian_performance = 0.0
var float london_performance = 0.0
var float ny_performance = 0.0

var float avg_volatility = 0.0
var bool high_volatility_regime = false
var bool low_volatility_regime = false

var float dailyPnL = 0.0
var float weeklyPnL = 0.0
var int dailyTrades = 0
var int weeklyTrades = 0
var int lastEntryBar = 0
var float maxDailyDD = 0.0
var int total_trades = 0
var float equity_peak = ACCOUNT_SIZE
var float current_drawdown = 0.0

var string last_signal_type_entry = ''
var float last_weighted_score_entry = 0.0
var float last_atr_close_ratio_entry = 0.0
var int last_entry_hour = 0

// ========================================
// SESSION DETECTION FUNCTION
// ========================================
getCurrentSession() =>
    currentTime = hour(time, "America/New_York") * 100 + minute(time, "America/New_York")
    session_val = 0 // 0 = None, 1 = Asian, 2 = London, 3 = NY
    if currentTime >= 1800 or currentTime < 200
        session_val := 1
    else if currentTime >= 200 and currentTime < 830
        session_val := 2
    else if currentTime >= 830 and currentTime <= 1500
        session_val := 3
    session_val

// Reset daily/weekly counters
if dayofweek != dayofweek[1]
    dailyPnL := 0.0
    dailyTrades := 0
    maxDailyDD := 0.0

if dayofweek == dayofweek.monday and dayofweek[1] != dayofweek.monday
    weeklyPnL := 0.0
    weeklyTrades := 0

stopTradingForDay = dailyPnL <= -MAX_DAILY_LOSS
trade_allowed = in_session and not_weekend and not stopTradingForDay

// ========================================
// TRADE EXECUTION WITH LEARNING
// ========================================
if strategy.closedtrades > strategy.closedtrades[1]
    trade_pnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
    trade_return = ACCOUNT_SIZE > 0 ? trade_pnl / ACCOUNT_SIZE : 0

    trade_session = getCurrentSession()

    array.unshift(trade_returns, trade_return)
    array.unshift(trade_directions, strategy.closedtrades.size(strategy.closedtrades - 1) > 0 ? 1 : -1)
    array.unshift(trade_sessions, trade_session)
    array.unshift(trade_types, last_signal_type_entry)
    array.unshift(trade_scores, math.abs(last_weighted_score_entry))
    array.unshift(trade_hours, last_entry_hour)
    array.unshift(trade_volatilities, last_atr_close_ratio_entry)

    if array.size(trade_returns) > PERFORMANCE_MEMORY
        array.pop(trade_returns)
        array.pop(trade_directions)
        array.pop(trade_sessions)
        array.pop(trade_types)
        array.pop(trade_scores)
        array.pop(trade_hours)
        array.pop(trade_volatilities)

    dailyPnL := dailyPnL + trade_pnl
    weeklyPnL := weeklyPnL + trade_pnl
    dailyTrades := dailyTrades + 1
    weeklyTrades := weeklyTrades + 1
    total_trades := total_trades + 1

    if dailyPnL < 0
        maxDailyDD := math.min(maxDailyDD, dailyPnL)

    if array.size(trade_returns) >= LEARNING_PERIOD
        momentum_wins = 0.0
        momentum_total = 0.0
        structure_wins = 0.0
        structure_total = 0.0
        volume_wins = 0.0
        volume_total = 0.0
        reversal_wins = 0.0
        reversal_total = 0.0
        long_wins = 0.0
        long_total = 0.0
        short_wins = 0.0
        short_total = 0.0
        asian_sum = 0.0
        asian_count = 0
        london_sum = 0.0
        london_count = 0
        ny_sum = 0.0
        ny_count = 0

        for i = 0 to math.min(LEARNING_PERIOD - 1, array.size(trade_returns) - 1) by 1
            return_val = array.get(trade_returns, i)
            signal_type_hist = array.get(trade_types, i)
            direction = array.get(trade_directions, i)
            session_hist = array.get(trade_sessions, i)

            if signal_type_hist == 'MOMENTUM'
                momentum_total := momentum_total + 1
                if return_val > 0
                    momentum_wins := momentum_wins + 1
            else if signal_type_hist == 'STRUCTURE'
                structure_total := structure_total + 1
                if return_val > 0
                    structure_wins := structure_wins + 1
            else if signal_type_hist == 'VOLUME'
                volume_total := volume_total + 1
                if return_val > 0
                    volume_wins := volume_wins + 1
            else if signal_type_hist == 'REVERSAL'
                reversal_total := reversal_total + 1
                if return_val > 0
                    reversal_wins := reversal_wins + 1

            if direction == 1
                long_total := long_total + 1
                if return_val > 0
                    long_wins := long_wins + 1
            else
                short_total := short_total + 1
                if return_val > 0
                    short_wins := short_wins + 1

            if session_hist == 1
                asian_sum := asian_sum + return_val
                asian_count := asian_count + 1
            else if session_hist == 2
                london_sum := london_sum + return_val
                london_count := london_count + 1
            else if session_hist == 3
                ny_sum := ny_sum + return_val
                ny_count := ny_count + 1

        momentum_win_rate := momentum_total > 0 ? momentum_wins / momentum_total : 0.5
        structure_win_rate := structure_total > 0 ? structure_wins / structure_total : 0.5
        volume_win_rate := volume_total > 0 ? volume_wins / volume_total : 0.5
        reversal_win_rate := reversal_total > 0 ? reversal_wins / reversal_total : 0.5
        long_win_rate := long_total > 0 ? long_wins / long_total : 0.5
        short_win_rate := short_total > 0 ? short_wins / short_total : 0.5

        asian_performance := asian_count > 0 ? asian_sum / asian_count : 0.0
        london_performance := london_count > 0 ? london_sum / london_count : 0.0
        ny_performance := ny_count > 0 ? ny_sum / ny_count : 0.0

    if array.size(trade_returns) >= LEARNING_PERIOD
        avg_win_rate = (momentum_win_rate + structure_win_rate + volume_win_rate + reversal_win_rate) / 4

        momentum_adjustment = (momentum_win_rate - avg_win_rate) * ADAPTATION_SPEED
        structure_adjustment = (structure_win_rate - avg_win_rate) * ADAPTATION_SPEED
        volume_adjustment = (volume_win_rate - avg_win_rate) * ADAPTATION_SPEED
        reversal_adjustment = (reversal_win_rate - avg_win_rate) * ADAPTATION_SPEED

        adaptive_momentum_weight := math.max(0.2, math.min(2.0, adaptive_momentum_weight + momentum_adjustment))
        adaptive_structure_weight := math.max(0.2, math.min(2.0, adaptive_structure_weight + structure_adjustment))
        adaptive_volume_weight := math.max(0.2, math.min(2.0, adaptive_volume_weight + volume_adjustment))
        adaptive_reversal_weight := math.max(0.2, math.min(2.0, adaptive_reversal_weight + reversal_adjustment))

        overall_win_rate_calc = total_trades > 0 ? strategy.wintrades / total_trades : 0.5
        if overall_win_rate_calc < 0.45
            adaptive_min_score := math.min(5.0, adaptive_min_score + 0.1 * ADAPTATION_SPEED)
        else if overall_win_rate_calc > 0.65
            adaptive_min_score := math.max(1.5, adaptive_min_score - 0.1 * ADAPTATION_SPEED)

        current_equity_calc = strategy.equity
        equity_peak := math.max(equity_peak, current_equity_calc)
        current_drawdown := equity_peak > 0 ? (equity_peak - current_equity_calc) / equity_peak : 0.0

        if current_drawdown > 0.05
            adaptive_risk_multiplier := math.max(0.5, adaptive_risk_multiplier - 0.1 * ADAPTATION_SPEED)
        else if current_drawdown < 0.02
            adaptive_risk_multiplier := math.min(1.5, adaptive_risk_multiplier + 0.05 * ADAPTATION_SPEED)


// ========================================
// SESSION & VOLATILITY DETECTION
// ========================================
currentSession = getCurrentSession()


isPowerHour() =>
    hour * 100 + minute >= 1400 and hour * 100 + minute <= 1500 and currentSession == 3

// ========================================
// MARKET STRUCTURE ANALYSIS
// ========================================
atr = ta.atr(14)
sh_atr = ta.atr(3)
atr_sma = ta.sma(atr, 50)
current_volatility_pct = close != 0 ? atr / close * 100 : 0
sh_volatility_pct = close != 0 ? sh_atr / close * 100 : 0
avg_volatility_calc = ta.sma(atr / close, 100)

if barstate.isconfirmed
    avg_volatility := avg_volatility_calc
    // original: 1.2, 0.8
    high_volatility_regime := atr / close > avg_volatility * 1.3
    low_volatility_regime := atr / close < avg_volatility * 0.8

pivot_len = 10
swing_high = ta.pivothigh(high, pivot_len, pivot_len)
swing_low = ta.pivotlow(low, pivot_len, pivot_len)

var float resistance = na
var float support = na

if not na(swing_high)
    resistance := swing_high
if not na(swing_low)
    support := swing_low

bullish_break = not na(resistance) and close > resistance and close[1] <= resistance
bearish_break = not na(support) and close < support and close[1] >= support

// ========================================
// MOMENTUM INDICATORS
// ========================================
rsi_fast = ta.rsi(close, 7)
rsi_med = ta.rsi(close, 14)
rsi_slow = ta.rsi(close, 21)

[macd, signal_macd, hist_macd] = ta.macd(close, 12, 26, 9)
macd_bull = hist_macd > hist_macd[1] and hist_macd > 0
macd_bear = hist_macd < hist_macd[1] and hist_macd < 0

[diplus, diminus, adx] = ta.dmi(14, 14)
strong_trend = adx > 30
uptrend = diplus > diminus and strong_trend
downtrend = diminus > diplus and strong_trend
consolidating_viz = adx < 15

// ========================================
// VOLUME ANALYSIS
// ========================================
vol_ma = ta.sma(volume, 20)
vol_std = ta.stdev(volume, 20)
high_volume = volume > vol_ma + vol_std

vpt = ta.cum((close - close[1]) / close[1] * volume)
vpt_signal = ta.ema(vpt, 10)
volume_bullish = vpt > vpt_signal
volume_bearish = vpt < vpt_signal


// ========================================
// ADAPTIVE SIGNAL SCORING
// ========================================
float momentum_score = 0.0
float structure_score = 0.0
float volume_score = 0.0
float reversal_score = 0.0

momentum_multiplier = high_volatility_regime ? 0.8 : low_volatility_regime ? 1.3 : 1.0

if uptrend
    momentum_score := momentum_score + 0.8 * momentum_multiplier
if macd_bull
    momentum_score := momentum_score + 0.4 * momentum_multiplier
if rsi_fast > 50 and rsi_fast < 80
    momentum_score := momentum_score + 0.4 * momentum_multiplier

if downtrend
    momentum_score := momentum_score - 0.8 * momentum_multiplier
if macd_bear
    momentum_score := momentum_score - 0.4 * momentum_multiplier
if rsi_fast < 50 and rsi_fast > 20
    momentum_score := momentum_score - 0.4 * momentum_multiplier

if bullish_break
    structure_score := structure_score + 1.0
if bearish_break
    structure_score := structure_score - 1.0

if volume_bullish and high_volume
    volume_score := volume_score + 1.0
if volume_bearish and high_volume
    volume_score := volume_score - 1.0

if rsi_slow < 30 and rsi_fast > rsi_fast[1] and close <= support
    reversal_score := reversal_score + 1.0
if rsi_slow > 70 and rsi_fast < rsi_fast[1] and close >= resistance
    reversal_score := reversal_score - 1.0

sma20 = ta.sma(close, 20)
sma50 = ta.sma(close, 50)
if close > sma20 and sma20 > sma50
    structure_score := structure_score + 0.5
if close < sma20 and sma20 < sma50
    structure_score := structure_score - 0.5

// ========================================
// FINAL SIGNAL WITH ADAPTIVE WEIGHTS
// ========================================
final_momentum_weight = adaptive_momentum_weight
final_structure_weight = adaptive_structure_weight
final_volume_weight = adaptive_volume_weight
final_reversal_weight = adaptive_reversal_weight

weighted_score = momentum_score * final_momentum_weight + structure_score * final_structure_weight + volume_score * final_volume_weight + reversal_score * final_reversal_weight
signal_contributions = array.from(math.abs(momentum_score * final_momentum_weight), math.abs(structure_score * final_structure_weight), math.abs(volume_score * final_volume_weight), math.abs(reversal_score * final_reversal_weight))
max_contribution_idx = array.indexof(signal_contributions, array.max(signal_contributions))
string signal_type_for_current_bar = max_contribution_idx == 0 ? 'MOMENTUM' : max_contribution_idx == 1 ? 'STRUCTURE' : max_contribution_idx == 2 ? 'VOLUME' : 'REVERSAL'

power_hour_multiplier = 1.0
if isPowerHour()
    power_hour_trades = 0
    power_hour_profit = 0.0
    for i = 0 to math.min(49, array.size(trade_hours) - 1) by 1
        if array.get(trade_hours, i) >= 14
            power_hour_trades := power_hour_trades + 1
            power_hour_profit := power_hour_profit + array.get(trade_returns, i)

    if power_hour_trades > 5 and power_hour_profit > 0
        power_hour_multiplier := 1.2

weighted_score := weighted_score * power_hour_multiplier

// ====================================================================================================================================================================================================================================
// ADAPTIVE POSITION SIZING
// ====================================================================================================================================================================================================================================
calculateAdaptivePositionSize() =>

    // logic for TPSL adaptation
    float curr_vola = sh_volatility_pct / 100
    float calc_adaption = high_volatility_regime ? 1.3 : low_volatility_regime ? 0.8 : 1.0 // original = 1.3/0.7/1.0
    float adaptive_sl = (BASE_RISK/100) * calc_adaption
    float adaptive_tp = (BASE_TP/100) * calc_adaption
    float trail_points = 10.0
    float stop_points = close * adaptive_sl
    float fut_size = na
    int dot_step = math.round(math.log10(1 / TICK_SIZE))
    float base_offset = curr_vola / 3

    //float limit_ask = math.round(close * 1.0005, dot_step) // ask
    //float limit_bid = math.round(close * 0.9995, dot_step) // bid
    float limit_ask = math.round(close * (1 + base_offset), dot_step)  // ask
    float limit_bid = math.round(close * (1 - base_offset), dot_step)  // bid

    //position size und anzahl der max shares bei ETF berechnen
    if INSTR_TRD == "STK"
        [ _, _, OminTick] = fetchOtherInstrument()
        dot_step := math.round(math.log10(1 / OminTick))
        limit_ask := math.round(otherInstrumentClose * (1 + base_offset), dot_step)
        limit_bid := math.round(otherInstrumentClose * (1 - base_offset), dot_step)

    else if INSTR_TRD == "CFD" and CLIENT_ID == "OANDA"
        limit_ask := math.round(otherInstrumentClose * (1 + base_offset), _map_dlimit)
        limit_bid := math.round(otherInstrumentClose * (1 - base_offset), _map_dlimit)

    else if INSTR_TRD == "CFD" and CLIENT_ID == "IG_MARKETS"
        limit_ask := math.round(otherInstrumentClose * (1 + base_offset), _map_dlimit)
        limit_bid := math.round(otherInstrumentClose * (1 - base_offset), _map_dlimit)
 
   // ---------------------------------------------------------------
 
    float risk_amount = (MAX_DAILY_LOSS * BASE_RISK)
    float position_value = (stop_points * DOLLAR_PER_POINT_FUT) > 0 ? (risk_amount / (stop_points * DOLLAR_PER_POINT_FUT)) : 1
    //float position_value = (stop_points * DOLLAR_PER_POINT) > 0 ? (risk_amount / (stop_points * DOLLAR_PER_POINT)) : 1
    float signal_confidence = math.min(math.abs(weighted_score) / (adaptive_min_score > 0 ? adaptive_min_score : BASE_MIN_SCORE), 2.0)
    float direction_confidence = weighted_score > 0 ? long_win_rate : short_win_rate
    float type_confidence_val = signal_type_for_current_bar == 'MOMENTUM' ? momentum_win_rate : signal_type_for_current_bar == 'STRUCTURE' ? structure_win_rate : signal_type_for_current_bar == 'VOLUME' ? volume_win_rate : reversal_win_rate
    float total_confidence = (signal_confidence + direction_confidence + type_confidence_val) / 3
    float adjusted_size = position_value * total_confidence

    // ----------------------------------------------------------------------------------------------------------------
    // calculate trail_offset and trail points

    if na(point_factor)
        trail_points := ((signal_confidence + adaptive_min_score) * calc_adaption) / (TICKS_PER_POINT * 0.1)
    else
        trail_points := ((signal_confidence + adaptive_min_score) * calc_adaption) / point_factor

    float trl_offset = (close/100) * TICKS_PER_POINT * BASE_RISK * calc_adaption

    // ----------------------------------------------------------------------------------------------------------------
    // calculate position sizing and instrument choice (Future or ETF) 

    if SIGNAL_GEN == "FUT"
        fut_size := math.max(1, math.min(max_size, math.round(adjusted_size)))
        if currentInstrument == "BTCUSD" or currentInstrument == "BITCOIN"
            fut_size := math.max(0.1, math.min(max_size, math.round(adjusted_size)))
    else
        fut_size := stk_size

    //DEBUG: Zeige die Werte
    // if barstate.islast
    //     label.new(bar_index, high, 
    //             "Symbol: " + stk_symbol +
    //             "\nInstrument: " + Instrument +
    //             "\nACCOUNT_SIZE: " + str.tostring(ACCOUNT_SIZE, '0.00') +
    //             "\nrisk_amount: " + str.tostring(risk_amount, '0.00') +
    //             //"\nrisk_percent: " + str.tostring(risk_pct, '0.000') +
    //             //"\ncontracts: " + str.tostring(contracts, '0.00') +
    //             "\nstop_points: " + str.tostring(stop_points, '0.00') +
    //             "\nDOLLAR_PER_POINT_FUT: " + str.tostring(DOLLAR_PER_POINT_FUT, '#,##0.0') +
    //             "\nposition_value: " + str.tostring(position_value, '0.0') +
    //             "\nadjusted_size: " + str.tostring(adjusted_size, '0.000') +
    //             "\ntotal_confidence: " + str.tostring(total_confidence, '0.00') +
    //             "\nfut_size: " + str.tostring(fut_size) +
    //             //"\ndrawdown_pct: " + str.tostring(drawdown_pct, '0.00') +
    //             "\navg_vola: " + str.tostring(curr_vola * 100, '0.00') + "%" +
    //             "\nlimit_ask: " + str.tostring(limit_ask, '0.000'),
    //             color=color.blue, size=size.normal)
                
    // ----------------------------------------------------------------------------------------------------------------

    [fut_size, limit_ask, limit_bid, calc_adaption, adaptive_sl, adaptive_tp, trail_points, trl_offset]

[fut_size, limit_ask, limit_bid, calc_adaption, adaptive_sl, adaptive_tp, trail_points, trl_offset] = calculateAdaptivePositionSize()

// if we have more than one future, stk_size must be adjusted
if MIRROR_TRD == "YES"
    stk_size := stk_size * fut_size

bars_since_entry = bar_index - lastEntryBar

// ====================================================================================================================================================================================================================================
// Utility functions
// ====================================================================================================================================================================================================================================
// calc position sizes for direct roundturn (only for message-string. This function feeds the function calcAlertMessageString)
calcPositionSize(action, possible_switch) =>

    float json_size = 0.0
    string str_json_size = ""
    float limit = 0.0
    string str_limit = ""

    // setting limit for direction
    if action == "BUY"
        limit := limit_ask
    else if action == "SELL"
        limit := limit_bid

    // default json_size je nach Instrument
    if INSTR_TRD == "FUT"
        json_size := fut_size
    else
        json_size := stk_size

    // Anzahl der bisher ausgeführten Pyramid-Einträge
    float pyramid_count = math.abs(strategy.position_size / fut_size)

    // closing direction: close all open pyramided positions
    bool is_closing = (strategy.position_size > 0 and action == "SELL") or (strategy.position_size < 0 and action == "BUY")
    if is_closing and not possible_switch
        // mirror: use exact accumulated stk units (price-locked per entry bar)
        // non-mirror: pyramid_count * json_size cancels to strategy.position_size (algebraically exact)
        json_size := INSTR_TRD != "FUT" ? mirror_stk_open : pyramid_count * json_size

    // switch: close all pyramided positions + open one new in opposite direction
    if strategy.position_size != 0 and possible_switch and ENABLE_SWITCH == "YES"
        json_size := INSTR_TRD != "FUT" ? stk_size + mirror_stk_open : json_size * (1 + pyramid_count)
        
    // we have to adjust the numbers to maximum possible decimals
    if INSTR_TRD == "FUT"
        str_json_size := str.tostring(json_size, '#')
        int fut_step = math.round(math.log10(1 / syminfo.mintick))
        limit := math.round(limit, fut_step)
        str_format_limit = fut_step == 0 ? "#" : fut_step == 1 ? "#.0" : fut_step == 2 ? "#.00" : fut_step == 3 ? "#.000" : "#.0000"
        str_limit := str.tostring(limit, str_format_limit)
    else if INSTR_TRD == "STK"
        limit := math.round(limit, 2)
        str_json_size := str.tostring(json_size, '#')
        str_limit := str.tostring(limit, '#.##')
    else if INSTR_TRD == "CFD"

        if CLIENT_ID == "OANDA"
            [_, dot_step, dot_limit] = mapToOanda(stk_symbol)
            limit := math.round(limit, dot_limit)
            str_format_size = dot_step == 0 ? "0" : dot_step == 1 ? "0.0" : dot_step == 2 ? "0.00" : dot_step == 3 ? "0.000" : "0.0000"
            str_format_limit = dot_limit == 0 ? "#" : dot_limit == 1 ? "#.0" : dot_limit == 2 ? "#.00" : dot_limit == 3 ? "#.000" : "#.0000"
            str_json_size := str.tostring(json_size, str_format_size)
            str_limit := str.tostring(limit, str_format_limit)

        else if CLIENT_ID == "IG_MARKETS"
            [_, dot_step, _, dot_limit] = mapToIG(stk_symbol)
            limit := math.round(limit, dot_limit)
            str_format_size = dot_step == 0 ? "0" : dot_step == 1 ? "0.0" : dot_step == 2 ? "0.00" : dot_step == 3 ? "0.000" : "0.0000"
            str_format_limit = dot_limit == 0 ? "#" : dot_limit == 1 ? "#.0" : dot_limit == 2 ? "#.00" : dot_limit == 3 ? "#.000" : "#.0000"
            str_json_size := str.tostring(json_size, str_format_size)
            str_limit := str.tostring(limit, str_format_limit)

    //DEBUG: Zeige die Werte
    // if barstate.islast
    //     label.new(bar_index, high, 
    //             "Symbol: " + stk_symbol +
    //             "\nInstrument: " + Instrument +
    //             "\naction: " + action +
    //             "\nstr_json_size: " + str_json_size +
    //             "\nfut_size: " + str.tostring(fut_size) +
    //             //"\ndot_limit: " + str.tostring(dot_limit) +
    //             "\nstr_limit: " + str_limit,
    //             color=color.blue, size=size.normal)
                
    [str_limit, str_json_size]

[_, str_stk_size] = calcPositionSize("BUY",true)

calcAlertMessageString(action, str_limit, str_json_size, x_type) =>

    string x_Change = "SMART"
    string x_PriXchange = "SMART"
    string x_ordertype = "LMT"
    string x_outRth = "false"
    string x_tif = "IOC"
    string x_limit = str_limit
    string x_conid = "0"
    string dtim = str.format_time(timenow, "yyyy-MM-dd HH:mm:ss.S", session_timezone)
    string mkt_price = str.tostring(close)

    // Mirror trading
    if INSTR_TRD == "STK"
        mkt_price := str.tostring(otherInstrumentClose)
        x_tif := "DAY"
        x_outRth := "true"
        if na(stk_PrxChange) 
            x_PriXchange := stk_xChange
        else
            x_PriXchange := stk_PrxChange
    else if INSTR_TRD == "CFD" 
        mkt_price := str.tostring(otherInstrumentClose)
    else if INSTR_TRD == "FUT"  
        x_Change := xChange
        x_PriXchange := xChange
        x_conid := str.tostring(conid)

    // only when autotrail close
    if AUTO_TRL and (x_type == 'LX-A-TRL' or x_type == 'SX-A-TRL')
        x_ordertype := "MKT"
        x_limit := "0"

    message_string = ""
    if SIGNAL_GEN == "None"
        message_string := "no json alert"
    else
        message_string := '{"secret":"'+TOKEN_ID+'", "account":"'+CLIENT_ID+'", "conid":'+x_conid+', "secType":"'+INSTR_TRD+'", "symbol":"'+Instrument+'", "currency":"'+INSTR_CURR+'", "side":"'+action+'","orderType":"'+x_ordertype+'", "quantity":'+str_json_size+',"price":'+x_limit+',"tif":"'+x_tif+'", "exchange":"'+x_Change+'","primaryExchange":"'+x_PriXchange+'","outsideRth":'+x_outRth+', "comment":"'+version_title+' '+signal_title+' {{timenow}} '+x_type+' - '+mkt_price+'"}'

    message_string

// === Durchschnittspreis aller offenen Pyramiding-Einstiege ===
avg_entry_price() =>
    var float avg_price = 0.0
    
    if strategy.position_size != 0
        float total = 0.0
        float qty   = 0.0
        for i = 0 to strategy.opentrades - 1
            total := total + strategy.opentrades.entry_price(i) * math.abs(strategy.opentrades.size(i))
            qty   := qty   + math.abs(strategy.opentrades.size(i))
        avg_price := qty != 0 ? (total / qty) : 0.0
        
    avg_price

// ====================================================================================================================================================================================================================================
// EMA Trigger display
// ====================================================================================================================================================================================================================================
maTriggerLnght = 55
maLongLnght = 233
mafast = ta.ema(close, fastLength)
matrigger = ta.ema(close, maTriggerLnght)
maTrend = ta.ema(close, Trendline)
malong = ta.ema(close, maLongLnght)

// ----- graphhis --------------------------------------------------------------------------------------------------------------------------------
shortcolor = matrigger > matrigger[1] ? color.rgb(14, 126, 72) : matrigger < matrigger[1] ? color.rgb(230, 30, 30) : color.blue
longcolor = malong > malong[1] ? color.rgb(14, 126, 72) : malong < malong[1] ? color.rgb(230, 30, 30) : color.blue
fillcolor = malong > malong[1] ? color.rgb(252, 255, 253) : malong < malong[1] ? color.rgb(250, 245, 245) : color.blue
triggercolor = color.purple

// MA trendlines
MA1 = plot(BASE_TRADE and showTriggerLines ? mafast : matrigger, title = 'Short Period Moving Average', style = plot.style_linebr, linewidth = 2, color = shortcolor)
MA2 = plot(BASE_TRADE and showTriggerLines ? maTrend : malong, title = 'Long Period Moving Average', style = plot.style_linebr, linewidth = 2, color = longcolor)

fillcol = BASE_TRADE ? fillcolor : color.rgb(244, 244, 247)
fill(MA1, MA2, color = fillcol)

// MA trend color
TrendingUp() =>
    BASE_TRADE == true ? mafast > matrigger : matrigger > malong
TrendingDown() =>
    BASE_TRADE == true ? mafast < matrigger : matrigger < malong
// MA cross alert
MAcrossing = BASE_TRADE == false ? ta.cross(matrigger, malong) : false
plotshape(MAcrossing, style = shape.cross, size = size.tiny, location = location.abovebar, color = color.black)

// MA cross vertical background color alert
Uptrend() =>
    TrendingUp() and TrendingDown()[1]
Downtrend() =>
    TrendingDown() and TrendingUp()[1]
plotshape(Uptrend() and BASE_TRADE == false, color = color.green, size = size.small, location = location.bottom, style = shape.labelup)
plotshape(Downtrend() and BASE_TRADE == false, color = color.red, size = size.small, location = location.top, style = shape.labeldown)

// ====================================================================================================================================================================================================================================
// TRADE SIGNALS
// ====================================================================================================================================================================================================================================
var float long_pos_count = 0.0
var float short_pos_count = 0.0

// ------------------------------------------------
// EMA distance attribution
var string ema_trend = ""

float ema_dist_at = BASE_TRADE ? math.abs(mafast - maTrend) / atr : math.abs(matrigger - malong) / atr
if ema_dist_at >= 0 and ema_dist_at <= 0.5
    ema_trend := "NOTR"
else if ema_dist_at > 0.5 and ema_dist_at <= 2
    ema_trend := "WEAK"
else if ema_dist_at > 2 and ema_dist_at <= 5.0
    ema_trend := "TREND"
else if ema_dist_at > 5.0 and ema_dist_at <= 7.0
    ema_trend := "EXPAND"
else if ema_dist_at > 7.0
    ema_trend := "EXCESS"    
//
// ------------------------------------------------
//
IsFlat() =>
    strategy.position_size == 0
//
// -- pyramiding logic --------------------------------------------------------------------------------------
//
bool long_can_pyramid = (
    long_pos_count < MAX_PYRAMID
    )
bool short_can_pyramid = (
    short_pos_count < MAX_PYRAMID
    )
bool long_can_trade = (
    BASE_TRADE
    and time >= start_time
    and long_can_pyramid
    and trade_allowed
    )
bool short_can_trade = (
    BASE_TRADE
    and time >= start_time
    and short_can_pyramid
    and trade_allowed
    )

// Debug label
// if barstate.islast
//     txt = "long_can_pyramid: " + str.tostring(long_can_pyramid)  + "\n" +
//           "short_can_pyramid " + str.tostring(short_can_pyramid) + "\n" +    
//           "strategy_position_size: " + str.tostring(strategy.position_size) + "\n" +
//           "short: "    + str.tostring(IsShort()) + "\n" +
//           "long: "    + str.tostring(IsLong()) + "\n" +
//           "MAX_PYRAMID: "   + str.tostring(MAX_PYRAMID)+ "\n" +
//           "pos_switch: "   + str.tostring(pos_switch)+ "\n" +
//           "open trades long: "   + str.tostring(long_pos_count)+ "\n" +
//           "open trades short: "   + str.tostring(short_pos_count)+ "\n" +
//           "open trades real: "   + str.tostring(strategy.opentrades)+ "\n"
//     label.new(bar_index, high, txt, style=label.style_label_left, color=color.blue, textcolor=color.white, size=size.normal)

// ---------------------------------------------------------------------------------------------------------
//

IsTrendRising() => ta.rising(maTrend, BackLength)
IsTrendFalling() => ta.falling(maTrend, BackLength)
IsFastRising() => ta.rising(mafast, 3)
IsFastFalling() => ta.falling(mafast, 3)
IsPriceRising() => ta.rising(high, 3)
IsPriceFalling() => ta.falling(low, 3)

// signal from [V6 2.1]
CrossUp = (mafast[1] < matrigger[1]) and (mafast > matrigger)
CrossDn = (mafast[1] > matrigger[1]) and (mafast < matrigger)
//
// set back logic -------------------------------------------------------------------
//
SetBackLng() =>
    not BASE_SETBACK or (
        low[1] < mafast[1] 
        and close > mafast 
        and mafast > maTrend
    )
SetBackSht() =>
    not BASE_SETBACK or (
        high[1] > mafast[1] 
        and close < mafast 
        and mafast < maTrend
    )
//
// Re Entry logic -------------------------------------------------------------------
//
bool ReLongSig = (
    BASE_REENTRY
    and (BASE_TRL_STOP or BASE_TGT or AUTO_TRL)
    and IsFlat()
    and IsTrendRising()
    and IsFastRising()
    and IsPriceRising()
    and (ema_trend != "EXPAND" and ema_trend != "EXCESS")
    //and (ema_trend == "WEAK" or ema_trend == "TREND")
    and mafast > maTrend
    and mafast[3] > maTrend
    and low[1] < mafast[1]
    and close > mafast
    and barstate.isconfirmed
    and long_can_trade
    )
bool ReShortSig = (
    BASE_REENTRY
    and (BASE_TRL_STOP or BASE_TGT or AUTO_TRL)
    and IsFlat()
    and IsTrendFalling()
    and IsFastFalling()
    and IsPriceFalling()
    and (ema_trend != "EXPAND" and ema_trend != "EXCESS")
    //and (ema_trend == "WEAK" or ema_trend == "TREND")
    and mafast < maTrend
    and mafast[3] < maTrend
    and high[1] > mafast[1]
    and close < mafast
    and barstate.isconfirmed
    and short_can_trade
    )
//
// standard signals from EMA V2.1  --------------------------------------------------
//
bool EMALongSig = (
        IsTrendRising()
        and CrossUp 
        and SetBackLng()
        and barstate.isconfirmed
        and long_can_trade
        ) 
bool EMAShortSig = (
        IsTrendFalling()
        and CrossDn
        and SetBackSht()
        and barstate.isconfirmed
        and short_can_trade
        )

plotshape(EMALongSig, color = color.green, size = size.small, location = location.bottom, style = shape.labelup)
plotshape(EMAShortSig, color = color.red, size = size.small, location = location.top, style = shape.labeldown)

// ====================================================================================================================================================================================================================================
// TRADE EXECUTION
// ====================================================================================================================================================================================================================================
var float sl_stop = na
var float sl_limit = na
var float ss_stop = na
var float ss_limit = na
var float profit_points = na
var float l_entry = na
var float s_entry = na
var float curr_profit = 0
var float sl_loss = 0
var float ss_loss = 0
var float sl_profit = 0
var float ss_profit = 0
var float l_stop = na
var float s_stop = na
var float trail_stop_long  = na
var float trail_stop_short = na

cached_avg_entry = avg_entry_price()

// === LONG ENTRY (EMA + Re-Entry) ===============================================================================================
if (EMALongSig or ReLongSig)
    s_entry := na
    ss_limit := na
    ss_stop := na
    l_stop := na
    s_stop := na
    bool pos_switch = false
    string entry_message = EMALongSig ? "Long entry" : "Re-Long"

    if strategy.position_size <= 0
        trail_stop_long := na
        l_entry := close
        sl_stop := l_entry - (l_entry * adaptive_sl)
        sl_limit := l_entry + (l_entry * adaptive_tp)
        pos_switch := strategy.position_size < 0 ? true : false
        if LONG_ONLY or SHORT_ONLY
            pos_switch := false

    [limit_price_str, str_json_size] = calcPositionSize("BUY", pos_switch)
    if INSTR_TRD != "FUT" and barstate.isconfirmed
        // barstate.isconfirmed: once per bar only (prevents repeated adds with calc_on_every_tick=true)
        // position_size <= 0: new long or switch from short → reset accumulator
        // position_size  > 0: pyramid long → add to accumulator
        mirror_stk_open := strategy.position_size <= 0 ? stk_size : mirror_stk_open + stk_size

    if not SHORT_ONLY
        strategy.entry(id='buy',
                        direction = strategy.long,
                        qty = fut_size,
                        comment = entry_message,
                        alert_message = calcAlertMessageString("BUY", limit_price_str, str_json_size, entry_message)
                        )
    // oposite signal for short only trades
    else if SHORT_ONLY
        strategy.close(id='sell',
                        qty = fut_size,
                        comment = 'Close short',
                        alert_message = calcAlertMessageString("BUY", limit_price_str, str_json_size, 'close short only')
                        )

    if AUTO_TRL and barstate.isconfirmed
        strategy.exit(id = 'LX_TRL',
                    from_entry = 'buy',
                    comment_profit = "LX TP Hit",
                    comment_loss = "LX STP-A Hit",
                    comment_trailing = EMALongSig ? "LX TRL-A Hit" : na,
                    stop = sl_stop,
                    limit = sl_limit,
                    trail_points = EMALongSig ? trail_points : na,
                    trail_offset = EMALongSig ? trl_offset : na,
                    alert_message = calcAlertMessageString("SELL", "{{strategy.order.price}}", "{{strategy.order.contracts}}", 'LX-A-TRL')
                    )

    lastEntryBar := bar_index
    last_signal_type_entry := signal_type_for_current_bar
    last_weighted_score_entry := weighted_score
    last_atr_close_ratio_entry := close > 0 ? atr / close : 0
    last_entry_hour := bar_hour

// -----------------------------------------------------------------------------------------------------------------------------
// === LONG Position Management ===
if strategy.position_size > 0
    
    // preventing simulated entries from pinescript over the pyramiding limitation (fake trades)         
    long_pos_count := strategy.opentrades <= MAX_PYRAMID ? strategy.opentrades : MAX_PYRAMID
    short_pos_count := 0.0

    l_entry := cached_avg_entry
    profit_points := close - l_entry
    order_action = "SELL"
    
    // 1. Trailing Stop berechnen (falls aktiviert)
    current_stop = sl_stop
    exit_comment = 'STP-LX'
    
    if BASE_TRL_STOP
        if close > l_entry + trail_points
            potential_trail = sl_stop + profit_points
            trail_stop_long := na(trail_stop_long) ? potential_trail : math.max(trail_stop_long, potential_trail)
        if not na(trail_stop_long)
            current_stop := trail_stop_long
            exit_comment := 'TRL-LX'
        
    [limit_price_str, str_json_size] = calcPositionSize(order_action, false)
    
    // 2. Take Profit Check (höchste Priorität)
    if close >= sl_limit and BASE_TGT and not AUTO_TRL and barstate.isconfirmed
        strategy.close(
            id='buy',
            comment='TGT reached',
            immediately=true,
            alert_message=calcAlertMessageString(order_action, limit_price_str, str_json_size, 'LX TGT')
        )

    // 3. Stop Loss / Trailing Stop Check
    else if close <= current_stop and BASE_TRL_STOP and not AUTO_TRL and barstate.isconfirmed
        strategy.close(
            id='buy', 
            comment=exit_comment,
            immediately=true,
            alert_message=calcAlertMessageString(order_action, limit_price_str, str_json_size, exit_comment)
        )
    
    // Variablen für Display/Berechnungen
    l_stop := current_stop
    sl_loss := (l_stop - l_entry) * DOLLAR_PER_POINT
    sl_profit := (sl_limit - l_entry) * DOLLAR_PER_POINT
    x_gain := sl_loss > 0
    
// Keine Position - Reset
else
    trail_stop_long := na
    
// === SHORT ENTRY (EMA + Re-Entry) ===============================================================================================
if (EMAShortSig or ReShortSig)
    l_entry := na
    sl_limit := na
    sl_stop := na
    l_stop := na
    s_stop := na
    bool pos_switch = false
    string entry_message = EMAShortSig ? "Short entry" : "Re-Short"

    if strategy.position_size >= 0
        trail_stop_short := na
        s_entry := close
        ss_stop := s_entry + (s_entry * adaptive_sl)
        ss_limit := s_entry - (s_entry * adaptive_tp)
        pos_switch := strategy.position_size > 0 ? true : false
        if LONG_ONLY or SHORT_ONLY
            pos_switch := false

    [limit_price_str, str_json_size] = calcPositionSize("SELL", pos_switch)
    if INSTR_TRD != "FUT" and barstate.isconfirmed
        // barstate.isconfirmed: once per bar only (prevents repeated adds with calc_on_every_tick=true)
        // position_size >= 0: new short or switch from long → reset accumulator
        // position_size  < 0: pyramid short → add to accumulator
        mirror_stk_open := strategy.position_size >= 0 ? stk_size : mirror_stk_open + stk_size
        
    if not LONG_ONLY
        strategy.entry(id='sell',
                        direction = strategy.short,
                        qty = fut_size,
                        comment = entry_message,
                        alert_message = calcAlertMessageString("SELL", limit_price_str, str_json_size, entry_message)
                        )

    // oposite signal for long only trades
    else if LONG_ONLY
        strategy.close(id='buy',
                        qty = fut_size,
                        comment = 'Close long',
                        alert_message = calcAlertMessageString("BUY", limit_price_str, str_json_size, 'close long only')
                        )

    if AUTO_TRL and barstate.isconfirmed
        strategy.exit(id = 'SX-TRL',
                    from_entry = 'sell',
                    comment_profit = "SX TP Hit",
                    comment_loss = "SX STP-A Hit",
                    comment_trailing = EMAShortSig ? "SX TRL-A Hit" : na,
                    stop = ss_stop,
                    limit = ss_limit,
                    trail_points = EMAShortSig ? trail_points : na,
                    trail_offset = EMAShortSig ? trl_offset : na,
                    alert_message = calcAlertMessageString("BUY", "{{strategy.order.price}}", "{{strategy.order.contracts}}", 'SX-A-TRL')
                    )

    lastEntryBar := bar_index
    last_signal_type_entry := signal_type_for_current_bar
    last_weighted_score_entry := weighted_score
    last_atr_close_ratio_entry := close > 0 ? atr / close : 0
    last_entry_hour := bar_hour

/// === SHORT Position Management ===
if strategy.position_size < 0
    
    // preventing simulated entries from pinescript over the pyramiding limitation (fake trades)         
    short_pos_count := strategy.opentrades <= MAX_PYRAMID ? strategy.opentrades : MAX_PYRAMID
    long_pos_count := 0.0

    s_entry := cached_avg_entry
    profit_points := s_entry - close
    order_action = "BUY"
    
    // 1. Trailing Stop berechnen (falls aktiviert)
    current_stop = ss_stop
    exit_comment = 'STP-SX'
    
    if BASE_TRL_STOP
        if close < s_entry - trail_points
            potential_trail = ss_stop - profit_points
            trail_stop_short := na(trail_stop_short) ? potential_trail : math.min(trail_stop_short, potential_trail)
        if not na(trail_stop_short)
            current_stop := trail_stop_short
            exit_comment := 'TRL-SX'

    [limit_price_str, str_json_size] = calcPositionSize(order_action, false)
    
    // 2. Take Profit Check (höchste Priorität)
    if close <= ss_limit and BASE_TGT and not AUTO_TRL and barstate.isconfirmed
        strategy.close(
            id='sell',
            comment='TGT reached',
            immediately=true,
            alert_message=calcAlertMessageString(order_action, limit_price_str, str_json_size, 'SX TGT')
        )

    // 3. Stop Loss / Trailing Stop Check
    else if close >= current_stop and BASE_TRL_STOP and not AUTO_TRL and barstate.isconfirmed
        strategy.close(
            id='sell', 
            comment=exit_comment,
            immediately=true,
            alert_message=calcAlertMessageString(order_action, limit_price_str, str_json_size, exit_comment)
        )
    
    // Variablen für Display/Berechnungen
    s_stop := current_stop
    ss_loss := (s_entry - s_stop) * DOLLAR_PER_POINT
    ss_profit := (s_entry - ss_limit) * DOLLAR_PER_POINT
    x_gain := ss_loss > 0

if strategy.position_size != 0
    curr_profit := profit_points * DOLLAR_PER_POINT

// Keine Position - Reset
else if strategy.position_size == 0
    trail_stop_short := na
    profit_points := 0
    curr_profit := 0
    long_pos_count := 0.0
    short_pos_count := 0.0

// ====================================================================================================================================================================================================================================
// VISUAL EFFECTS - FRACTAL GRID (Ported from Original)
// ====================================================================================================================================================================================================================================
var array<line> fractalHighLines = array.new<line>()
var array<line> fractalLowLines = array.new<line>()
var array<line> fractalHighGlowLines = array.new<line>()
var array<line> fractalLowGlowLines = array.new<line>()

if showFractalGrid
    fractalHigh1 = ta.highest(high, 10)
    fractalHigh2 = ta.highest(high, 20)
    fractalHigh3 = ta.highest(high, 30)
    fractalHigh4 = ta.highest(high, 40)
    fractalHigh5 = ta.highest(high, 50)

    fractalLow1 = ta.lowest(low, 10)
    fractalLow2 = ta.lowest(low, 20)
    fractalLow3 = ta.lowest(low, 30)
    fractalLow4 = ta.lowest(low, 40)
    fractalLow5 = ta.lowest(low, 50)


    for l in fractalHighLines
        line.delete(l)
    for l in fractalLowLines
        line.delete(l)
    for l in fractalHighGlowLines
        line.delete(l)
    for l in fractalLowGlowLines
        line.delete(l)

    array.clear(fractalHighLines)
    array.clear(fractalLowLines)
    array.clear(fractalHighGlowLines)
    array.clear(fractalLowGlowLines)

    fractalHighs = array.from(fractalHigh1, fractalHigh2, fractalHigh3, fractalHigh4, fractalHigh5)
    fractalLows = array.from(fractalLow1, fractalLow2, fractalLow3, fractalLow4, fractalLow5)

    for i = 0 to 4 by 1
        localFractalAlpha = 60 + i * 8
        localGlowAlpha = 85 + i * 5
        recentFractalHigh = array.get(fractalHighs, i)
        if not na(recentFractalHigh)
            array.push(fractalHighGlowLines, line.new(bar_index - 50, recentFractalHigh, bar_index + 10, recentFractalHigh, color = color.new(primaryBear, localGlowAlpha), width = 3, style = line.style_solid))
            array.push(fractalHighLines, line.new(bar_index - 50, recentFractalHigh, bar_index + 10, recentFractalHigh, color = color.new(primaryBear, localFractalAlpha), width = 1, style = line.style_dashed))
        recentFractalLow = array.get(fractalLows, i)
        if not na(recentFractalLow)
            array.push(fractalLowGlowLines, line.new(bar_index - 50, recentFractalLow, bar_index + 10, recentFractalLow, color = color.new(primaryBull, localGlowAlpha), width = 3, style = line.style_solid))
            array.push(fractalLowLines, line.new(bar_index - 50, recentFractalLow, bar_index + 10, recentFractalLow, color = color.new(primaryBull, localFractalAlpha), width = 1, style = line.style_dashed))

// ========================================
// ENHANCED SIGNAL VISUALIZATION - (show entry signals)
// ========================================
if EMALongSig and not SHORT_ONLY
    for i = 0 to 2 by 1
        label.new(bar_index, low - atr * (0.1 + i * 0.05), '▲', color = color.new(primaryBull, 70 + i * 10), style = label.style_label_up, textcolor = color.new(primaryBull, 20 + i * 20), size = i == 0 ? size.normal : i == 1 ? size.small : size.tiny, tooltip = 'Long Signal\nScore: ' + str.tostring(weighted_score, '#.##') + '\nType: ' + signal_type_for_current_bar)

if EMAShortSig and not LONG_ONLY
    for i = 0 to 2 by 1
        label.new(bar_index, high + atr * (0.1 + i * 0.05), '▼', color = color.new(primaryBear, 70 + i * 10), style = label.style_label_down, textcolor = color.new(primaryBear, 20 + i * 20), size = i == 0 ? size.normal : i == 1 ? size.small : size.tiny, tooltip = 'Short Signal\nScore: ' + str.tostring(weighted_score, '#.##') + '\nType: ' + signal_type_for_current_bar)

// ========================================
// ENHANCED SIGNAL VISUALIZATION - (show Take Profit labels)
// ========================================
if close >= sl_limit and strategy.position_size > 0 and barstate.islastconfirmedhistory 
    for i = 0 to 2 by 1
        label.new(bar_index, low - atr * (0.1 + i * 0.05), '▲', color = color.new(secondaryBull, 70 + i * 10), style = label.style_label_up, textcolor = color.new(secondaryBull, 20 + i * 20), size = i == 0 ? size.normal : i == 1 ? size.small : size.tiny, tooltip = 'Take Profit LX reached')

if close <= ss_limit and strategy.position_size < 0 and barstate.islastconfirmedhistory 
    for i = 0 to 2 by 1
        label.new(bar_index, high + atr * (0.1 + i * 0.05), '▼', color = color.new(secondaryBear, 70 + i * 10), style = label.style_label_down, textcolor = color.new(secondaryBear, 20 + i * 20), size = i == 0 ? size.normal : i == 1 ? size.small : size.tiny, tooltip = 'Take Profit SX reached')

// ========================================
// EXPANDED ADAPTIVE DASHBOARD (Updated for new session logic)
// ========================================
var table dashboard = dashboardSize == 'Small' ? table.new(position.top_right, 5, 20, border_width = 1) : dashboardSize == 'Large' ? table.new(position.top_right, 6, 35, border_width = 1) : table.new(position.top_right, 5, 30, border_width = 1)

//if barstate.islast and barstate.islastconfirmedhistory or barstate.isrealtime
if barstate.islast or barstate.isrealtime

    [_, str_stk_size] = calcPositionSize("BUY",true)
    table.clear(dashboard, 0, 0)
    dash_text_size = dashboardSize == 'Small' ? size.tiny : dashboardSize == 'Large' ? size.normal : size.small
    header_text_size = dashboardSize == 'Small' ? size.small : dashboardSize == 'Large' ? size.large : size.normal

    c_white = color.white
    c_gray = color.gray
    c_green = color.green
    c_red = color.red
    c_purple = color.purple
    c_aqua = color.aqua
    c_orange = color.orange
    c_yellow = color.yellow
    c_blue = color.blue
    c_black = color.black
    bg_dark = color.new(color.black, 70)
    bg_gray = color.new(#e3e4eb, 40)
    bg_white = color.white
    bg_header = color.new(color.black, 30)

    //string session_status = trade_allowed ? 'ACTIVE' : 'INACTIVE'
    //color session_color = trade_allowed ? c_green : c_red

    int _now_hour = hour(timenow, session_timezone)
    int _now_dow  = dayofweek(timenow, session_timezone)
    bool _now_in_session  = session_start < session_end ? _now_hour >= session_start and _now_hour < session_end : _now_hour >= session_start or _now_hour < session_end
    bool _now_not_weekend = allow_weekend or (_now_dow != dayofweek.saturday and _now_dow != dayofweek.sunday)
    string session_status = (_now_in_session and _now_not_weekend) ? 'ACTIVE' : 'INACTIVE'
    color  session_color  = (_now_in_session and _now_not_weekend) ? c_green  : c_red

    row = 0
    signal_output = BASE_TRADE ? SIGNAL_GEN : "None"
    table.merge_cells(dashboard, 0, row, 4, row)
    table.cell(dashboard, 0, row, version_title + signal_title+' '+signal_output+' '+param_title+' '+trl_stp_title+'/'+tgt_limit_title+' '+Instrument, text_color = c_white, bgcolor = bg_header, text_size = header_text_size)
    row := row + 1

    table.merge_cells(dashboard, 0, row, 4, row)
    if BASE_TRADE
        table.cell(dashboard, 0, row, '═══   EMA ' + str.tostring(fastLength, '##') +'/' + str.tostring(Trendline, '###') +'/'+ str.tostring(BackLength, '#')+ ' - SB('+ (BASE_SETBACK ? "Y" : "N")+ ') - FSZ('+str.format("{0,number,##0.0}", max_size)+ ') - PD(' +str.tostring(MAX_PYRAMID)+')   ═══', text_color = c_purple, bgcolor = bg_gray, text_size = header_text_size)
    else
        table.cell(dashboard, 0, row, '═══   EMA ' + str.tostring(maTriggerLnght, '##') +'/' + str.tostring(maLongLnght, '###') +'/'+ str.tostring(0, '#')+ ' - SB(NA) - FSZ(NA) - PD(NA)   ═══', text_color = c_purple, bgcolor = bg_gray, text_size = header_text_size)
    row := row + 1
    table.cell(dashboard, 0, row, 'Config Stop:', text_color = c_gray, text_size = dash_text_size)
    table.cell(dashboard, 1, row, str.format("{0,number,#0.0}", BASE_RISK) +' %', text_color = c_red, text_size = dash_text_size)
    table.cell(dashboard, 2, row, 'Config Target:', text_color = c_gray, text_size = dash_text_size)
    table.cell(dashboard, 3, row, str.format("{0,number,#0.0}", BASE_TP) +' %', text_color = c_green, text_size = dash_text_size)
    row := row + 1

    table.merge_cells(dashboard, 0, row, 4, row)
    table.cell(dashboard, 0, row, '═══  MARKET STATE = '+ema_trend+': '+str.format("{0,number,#0.00}",ema_dist_at)+'  ═══', text_color=ema_trend == "NOTR" ? c_black : ema_trend == "WEAK" ? c_gray : ema_trend == "TREND" ? c_green : ema_trend == "EXPAND" ? c_orange : ema_trend == "EXCESS" ? c_red : c_blue, bgcolor = bg_gray, text_size = dash_text_size)
    row := row + 1

    table.cell(dashboard, 0, row, 'Trend', text_color = c_gray, text_size = dash_text_size)
    table.cell(dashboard, 1, row, strong_trend ? uptrend ? 'UPTREND' : 'DOWNTREND' : consolidating_viz ? 'CONSOLIDATING' : 'NEUTRAL', text_color = strong_trend ? uptrend ? c_green : c_red : consolidating_viz ? c_blue : c_gray, text_size = dash_text_size)
    table.cell(dashboard, 2, row, 'ADX', text_color = c_gray, text_size = dash_text_size)
    table.cell(dashboard, 3, row, str.tostring(adx, '#.#'), text_color = adx > 25 ? c_green : c_gray, text_size = dash_text_size)
    row := row + 1

    table.cell(dashboard, 0, row, 'Momentum', text_color = c_gray, text_size = dash_text_size)
    table.cell(dashboard, 1, row, momentum_score > 0.5 ? 'BULL' : momentum_score < -0.5 ? 'BEAR' : 'NEUTRAL', text_color = momentum_score > 0.5 ? c_green : momentum_score < -0.5 ? c_red : c_gray, text_size = dash_text_size)
    table.cell(dashboard, 2, row, 'Score', text_color = c_gray, text_size = dash_text_size)
    table.cell(dashboard, 3, row, str.tostring(momentum_score, '#.##'), text_color = momentum_score > 0 ? c_green : momentum_score < 0 ? c_red : c_gray, text_size = dash_text_size)
    row := row + 1

    table.cell(dashboard, 0, row, 'Volatility', text_color = c_gray, text_size = dash_text_size)
    table.cell(dashboard, 1, row, high_volatility_regime ? 'HIGH' : low_volatility_regime ? 'LOW' : 'NORMAL', text_color = high_volatility_regime ? c_red : low_volatility_regime ? c_blue : c_gray, text_size = dash_text_size)
    table.cell(dashboard, 2, row, 'ATR%', text_color = c_gray, text_size = dash_text_size)
    table.cell(dashboard, 3, row, str.tostring(sh_volatility_pct, '#.##') + '%', text_color = high_volatility_regime ? c_red : low_volatility_regime ? c_blue : c_gray, text_size = dash_text_size)
