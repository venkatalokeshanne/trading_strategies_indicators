//@version=6
indicator("TradeWise Price Action", overlay=true)

// ===== INPUTS =====
swingLen = input.int(10, "Swing Lookback")
minSL = input.float(3.0, "Min SL ($)")
maxSL = input.float(7.0, "Max SL ($)")
rr1 = 1.0
rr2 = 1.5
rr3 = 2.0

// ===== SWINGS =====
swingHigh = ta.highest(high, swingLen)
swingLow  = ta.lowest(low, swingLen)

// ===== LIQUIDITY SWEEPS =====
sweepHigh = high > swingHigh[1]
sweepLow  = low < swingLow[1]

// ===== REJECTION CANDLES =====
bullReject = sweepLow and close > open and close > swingLow[1]
bearReject = sweepHigh and close < open and close < swingHigh[1]

// ===== SIGNALS =====
buySignal = bullReject
sellSignal = bearReject

entry = close

// ===== STOP LOSS =====
buySLraw = low
sellSLraw = high

buyDist = entry - buySLraw
sellDist = sellSLraw - entry

buyDist := math.max(minSL, math.min(buyDist, maxSL))
sellDist := math.max(minSL, math.min(sellDist, maxSL))

buySL = entry - buyDist
sellSL = entry + sellDist

// ===== TAKE PROFITS =====
buyTP1 = entry + buyDist * rr1
buyTP2 = entry + buyDist * rr2
buyTP3 = entry + buyDist * rr3

sellTP1 = entry - sellDist * rr1
sellTP2 = entry - sellDist * rr2
sellTP3 = entry - sellDist * rr3

// ===== SIGNAL MARKERS =====
plotshape(buySignal, style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small)
plotshape(sellSignal, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

// ===== LINES =====
var line eLine = na
var line sLine = na
var line t1 = na
var line t2 = na
var line t3 = na

var label eLabel = na
var label slLabel = na
var label tp1Label = na
var label tp2Label = na
var label tp3Label = na

right = bar_index + 25

// ===== CLEAN FUNCTION =====
clearAll() =>
    line.delete(eLine)
    line.delete(sLine)
    line.delete(t1)
    line.delete(t2)
    line.delete(t3)
    label.delete(eLabel)
    label.delete(slLabel)
    label.delete(tp1Label)
    label.delete(tp2Label)
    label.delete(tp3Label)

// ===== BUY =====
if buySignal
    clearAll()

    eLine := line.new(bar_index, entry, right, entry, color=color.blue, width=2)
    sLine := line.new(bar_index, buySL, right, buySL, color=color.red, width=2)
    t1 := line.new(bar_index, buyTP1, right, buyTP1, color=color.green, width=2)
    t2 := line.new(bar_index, buyTP2, right, buyTP2, color=color.green, width=2)
    t3 := line.new(bar_index, buyTP3, right, buyTP3, color=color.green, width=2)

    eLabel := label.new(right, entry, "ENTRY " + str.tostring(entry, format.mintick), style=label.style_label_left, color=color.blue, textcolor=color.white)
    slLabel := label.new(right, buySL, "SL " + str.tostring(buySL, format.mintick), style=label.style_label_left, color=color.red, textcolor=color.white)
    tp1Label := label.new(right, buyTP1, "TP1 " + str.tostring(buyTP1, format.mintick), style=label.style_label_left, color=color.green, textcolor=color.white)
    tp2Label := label.new(right, buyTP2, "TP2 " + str.tostring(buyTP2, format.mintick), style=label.style_label_left, color=color.green, textcolor=color.white)
    tp3Label := label.new(right, buyTP3, "TP3 " + str.tostring(buyTP3, format.mintick), style=label.style_label_left, color=color.green, textcolor=color.white)

// ===== SELL =====
if sellSignal
    clearAll()

    eLine := line.new(bar_index, entry, right, entry, color=color.blue, width=2)
    sLine := line.new(bar_index, sellSL, right, sellSL, color=color.red, width=2)
    t1 := line.new(bar_index, sellTP1, right, sellTP1, color=color.green, width=2)
    t2 := line.new(bar_index, sellTP2, right, sellTP2, color=color.green, width=2)
    t3 := line.new(bar_index, sellTP3, right, sellTP3, color=color.green, width=2)

    eLabel := label.new(right, entry, "ENTRY " + str.tostring(entry, format.mintick), style=label.style_label_left, color=color.blue, textcolor=color.white)
    slLabel := label.new(right, sellSL, "SL " + str.tostring(sellSL, format.mintick), style=label.style_label_left, color=color.red, textcolor=color.white)
    tp1Label := label.new(right, sellTP1, "TP1 " + str.tostring(sellTP1, format.mintick), style=label.style_label_left, color=color.green, textcolor=color.white)
    tp2Label := label.new(right, sellTP2, "TP2 " + str.tostring(sellTP2, format.mintick), style=label.style_label_left, color=color.green, textcolor=color.white)
    tp3Label := label.new(right, sellTP3, "TP3 " + str.tostring(sellTP3, format.mintick), style=label.style_label_left, color=color.green, textcolor=color.white)