//@version=6
indicator("Velas H6 / H8 / H12 Real em Tempo Real - Aderaldo", overlay=true, max_boxes_count=500)

// --- CONFIGURAÇÕES ---
opcaoTempo   = input.string("12h", "Timeframe", options=["6h", "8h", "12h"])
larguraPavioPercent = input.float(0.20, "Largura do Pavio (%)", minval=0.01, maxval=1.0) 

corCorpoAlta  = input.color(#3CB371, "Cor Corpo Alta")
corCorpoBaixa = input.color(#FF6347, "Cor Corpo Baixa")
corPavioAlta  = input.color(#3CB371, "Cor Pavio Alta")
corPavioBaixa = input.color(#FF6347, "Cor Pavio Baixa")

showM = input.bool(true, "Exibir Indicador")

// --- LÓGICA DOS TIMEFRAMES REAIS ---
tfMinutos = opcaoTempo == "6h" ? "360" : opcaoTempo == "8h" ? "480" : "720"
novoCiclo = timeframe.change(tfMinutos)

// Variáveis de estado para guardar os dados do ciclo
var float abertura = na
var float maxima = na
var float minima = na
var int barraInicio = bar_index

// Variáveis para gerenciar a vela atual em tempo real
var box box_corpo_atual = na
var box box_pavio_sup_atual = na
var box box_pavio_inf_atual = na

// Função auxiliar para calcular dimensões e desenhar uma vela
criarBoxesVela(int i, int f, float ab, float fe, float ma, float mi) =>
    bool eAlta = fe >= ab
    color c_corpo = eAlta ? corCorpoAlta : corCorpoBaixa
    color c_pavio = eAlta ? corPavioAlta : corPavioBaixa
    
    float larguraTotal = (f - i) + 1
    float meio = (i + f) / 2
    float offset = (larguraTotal * larguraPavioPercent) / 2
    int p_esq = math.round(meio - offset)
    int p_dir = math.round(meio + offset)
    
    float corpo_topo = math.max(ab, fe)
    float corpo_base = math.min(ab, fe)

    box p_sup = na
    box p_inf = na
    box corpo = na

    // Pavio Superior
    if ma > corpo_topo
        p_sup := box.new(left=p_esq, top=ma, right=p_dir, bottom=corpo_topo, border_color=na, bgcolor=c_pavio, text_size=size.tiny)
    
    // Pavio Inferior
    if mi < corpo_base
        p_inf := box.new(left=p_esq, top=corpo_base, right=p_dir, bottom=mi, border_color=na, bgcolor=c_pavio, text_size=size.tiny)
    
    // Corpo da Vela
    corpo := box.new(left=i, top=corpo_topo, right=f + 1, bottom=corpo_base, border_color=na, bgcolor=c_corpo, text_size=size.tiny)
    
    [corpo, p_sup, p_inf]

// --- EXECUÇÃO PRINCIPAL ---
if showM
    if na(abertura) or novoCiclo
        if not na(abertura)
            criarBoxesVela(barraInicio, bar_index - 1, abertura, close[1], maxima, minima)
        
        abertura := open
        maxima := high
        minima := low
        barraInicio := bar_index
    else
        maxima := math.max(high, nz(maxima, high))
        minima := math.min(low, nz(minima, low))

// --- LÓGICA DE TEMPO REAL (Vela Atual) ---
if showM and barstate.islast and not na(abertura)
    box.delete(box_corpo_atual)
    box.delete(box_pavio_sup_atual)
    box.delete(box_pavio_inf_atual)

    fechamento_agora = close
    maxima_agora = math.max(high, nz(maxima, high))
    minima_agora = math.min(low, nz(minima, low))

    [c, ps, pi] = criarBoxesVela(barraInicio, bar_index, abertura, fechamento_agora, maxima_agora, minima_agora)
    box_corpo_atual := c
    box_pavio_sup_atual := ps
    box_pavio_inf_atual := pi