     )

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DONCHIAN CHANNELS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

length = input.int(20, minval=1, title="High/Low")
offset = input.int(0, "Offset")

lower = ta.lowest(length)
upper = ta.highest(length)

u = plot(upper, "Upper", color=color.rgb(187, 217, 251), offset=offset)
l = plot(lower, "Lower", color=color.rgb(187, 217, 251), offset=offset)

fill(u, l, color=color.rgb(33, 150, 243, 93), title="Background")
