//@version=6
indicator(
     "TTG Brick Strategy Half Levels DWM Swing",
     overlay = true,
     max_boxes_count = 500,
     max_lines_count = 500
)

//=====================================================================
// TIME ZONE
//=====================================================================
string TZ = "America/New_York"

//=====================================================================
// 1. RANGE SETTINGS
//=====================================================================
groupRanges = "1. RANGE SETTINGS"

showON = input.bool(
     true,
     "Toggle 1 — 4PM → 9:30AM",
     group = groupRanges,
     tooltip = "Measures the high/low from 4:00 PM ET through 9:29 AM ET."
)

showRTH = input.bool(
     false,
     "Toggle 2 — 9:30AM → 4PM",
     group = groupRanges,
     tooltip = "Measures the regular-session high/low from 9:30 AM through 4:00 PM ET."
)

showWeekly = input.bool(
     false,
     "Toggle 3 — Previous Week Swing",
     group = groupRanges,
     tooltip = "Uses the previous completed weekly candle high/low and projects it from the beginning of the current week."
)

showMonthly = input.bool(
     false,
     "Toggle 4 — Previous Month Swing",
     group = groupRanges,
     tooltip = "Uses the previous completed monthly candle high/low and projects it from the beginning of the current month."
)

maxContinuationBricks = input.int(
     6,
     "Max Continuation Bricks Per Side",
     minval = 1,
     maxval = 12,
     group = groupRanges
)

//=====================================================================
// 2. BOX APPEARANCE
//=====================================================================
groupBox = "2. BOX APPEARANCE"

centerColor = input.color(
     color.rgb(205, 235, 245),
     "Center Rectangle",
     group = groupBox
)

upperInactiveColor = input.color(
     color.rgb(185, 215, 190),
     "Upper Rectangle",
     group = groupBox
)

lowerInactiveColor = input.color(
     color.rgb(245, 190, 205),
     "Lower Rectangle",
     group = groupBox
)

upperActiveColor = input.color(
     color.green,
     "Upper ACTIVE Color",
     group = groupBox
)

lowerActiveColor = input.color(
     color.red,
     "Lower ACTIVE Color",
     group = groupBox
)

boxTransparency = input.int(
     78,
     "Normal Transparency",
     minval = 0,
     maxval = 100,
     group = groupBox
)

activeTransparency = input.int(
     68,
     "Active Transparency",
     minval = 0,
     maxval = 100,
     group = groupBox
)

borderColor = input.color(
     color.black,
     "Border Color",
     group = groupBox
)

borderWidth = input.int(
     2,
     "Border Width",
     minval = 1,
     maxval = 5,
     group = groupBox
)

//=====================================================================
// 3. MIDLINE SETTINGS
//=====================================================================
groupMid = "3. MIDLINE"

showMidline = input.bool(
     true,
     "Show 50% Solid Midlines",
     group = groupMid
)

midlineColor = input.color(
     color.red,
     "Midline Color",
     group = groupMid
)

midlineTicks = input.int(
     3,
     "Midline Thickness",
     minval = 1,
     maxval = 20,
     group = groupMid
)

float midThickness = syminfo.mintick * midlineTicks
float halfMidThickness = midThickness / 2.0

//----------------------------------------------------------------------
// DASHED HALF-STEP LINES
// Adds 25% and 75% levels inside every brick.
//----------------------------------------------------------------------
showHalfLines = input.bool(
     true,
     "Show Dashed Half-Step Lines",
     group = groupMid,
     tooltip = "Adds dashed 25% and 75% lines inside every rectangle/continuation brick."
)

halfLineColor = input.color(
     color.gray,
     "Half-Step Line Color",
     group = groupMid
)

halfLineWidth = input.int(
     1,
     "Half-Step Line Width",
     minval = 1,
     maxval = 4,
     group = groupMid
)

//=====================================================================
// 4. ALERT SETTINGS
//=====================================================================
groupAlerts = "4. ALERT SETTINGS"

enableAlerts = input.bool(
     true,
     "Enable Alerts",
     group = groupAlerts
)

alertOnClose = input.bool(
     true,
     "Require Candle Close",
     group = groupAlerts
)

bool alertConfirmed =
     not alertOnClose or
     barstate.isconfirmed

//=====================================================================
// HELPER — DELETE BOX ARRAY
//=====================================================================
f_delete_boxes(array<box> arr) =>
    int count = array.size(arr)

    if count > 0
        for i = 0 to count - 1
            box b = array.get(arr, i)

            if not na(b)
                box.delete(b)

    array.clear(arr)

//=====================================================================
// HELPER — DELETE LINE ARRAY
//=====================================================================
f_delete_lines(array<line> arr) =>
    int count = array.size(arr)

    if count > 0
        for i = 0 to count - 1
            line ln = array.get(arr, i)

            if not na(ln)
                line.delete(ln)

    array.clear(arr)

//=====================================================================
// HELPER — NEW / UPDATE DASHED HALF-STEP LINE
//=====================================================================
f_new_half_line(int leftTime, float level) =>
    line.new(
         x1 = leftTime,
         y1 = level,
         x2 = time,
         y2 = level,
         xloc = xloc.bar_time,
         extend = extend.right,
         color = halfLineColor,
         style = line.style_dashed,
         width = halfLineWidth
    )

f_update_half_line(line ln, int leftTime, float level) =>
    line.set_xy1(ln, leftTime, level)
    line.set_xy2(ln, time, level)
    line.set_extend(ln, extend.right)
    line.set_color(ln, halfLineColor)
    line.set_style(ln, line.style_dashed)
    line.set_width(ln, halfLineWidth)

//=====================================================================
// HELPER — SYNC SIX DASHED HALF-STEP LINES
// IMPORTANT: each dashed line is the midpoint BETWEEN ADJACENT SOLID
// levels: Top↔50% and 50%↔Bottom. This guarantees visual centering.
//=====================================================================
f_sync_base_half_lines(
     array<line> arr,
     int leftTime,
     float upperTop,
     float upperMid,
     float upperBottom,
     float centerTop,
     float centerMid,
     float centerBottom,
     float lowerTop,
     float lowerMid,
     float lowerBottom
) =>
    float upperTopHalf = (upperTop + upperMid) / 2.0
    float upperBottomHalf = (upperMid + upperBottom) / 2.0
    float centerTopHalf = (centerTop + centerMid) / 2.0
    float centerBottomHalf = (centerMid + centerBottom) / 2.0
    float lowerTopHalf = (lowerTop + lowerMid) / 2.0
    float lowerBottomHalf = (lowerMid + lowerBottom) / 2.0

    if array.size(arr) != 6
        f_delete_lines(arr)
        array.push(arr, f_new_half_line(leftTime, upperTopHalf))
        array.push(arr, f_new_half_line(leftTime, upperBottomHalf))
        array.push(arr, f_new_half_line(leftTime, centerTopHalf))
        array.push(arr, f_new_half_line(leftTime, centerBottomHalf))
        array.push(arr, f_new_half_line(leftTime, lowerTopHalf))
        array.push(arr, f_new_half_line(leftTime, lowerBottomHalf))
    else
        f_update_half_line(array.get(arr, 0), leftTime, upperTopHalf)
        f_update_half_line(array.get(arr, 1), leftTime, upperBottomHalf)
        f_update_half_line(array.get(arr, 2), leftTime, centerTopHalf)
        f_update_half_line(array.get(arr, 3), leftTime, centerBottomHalf)
        f_update_half_line(array.get(arr, 4), leftTime, lowerTopHalf)
        f_update_half_line(array.get(arr, 5), leftTime, lowerBottomHalf)

//=====================================================================
// HELPER — SYNC HALF-STEP LINES FROM THE ACTUAL 3 BOXES
// Used for WEEKLY + MONTHLY so the dashed levels are centered from
// the exact visible box geometry and remain fixed to the box left edge.
//=====================================================================
f_sync_three_box_half_lines(
     array<line> arr,
     box upperBox,
     box centerBox,
     box lowerBox
) =>
    if not na(upperBox) and not na(centerBox) and not na(lowerBox)
        int leftTime = box.get_left(centerBox)

        float upperTop = box.get_top(upperBox)
        float upperBottom = box.get_bottom(upperBox)
        float upperMid = (upperTop + upperBottom) / 2.0

        float centerTop = box.get_top(centerBox)
        float centerBottom = box.get_bottom(centerBox)
        float centerMid = (centerTop + centerBottom) / 2.0

        float lowerTop = box.get_top(lowerBox)
        float lowerBottom = box.get_bottom(lowerBox)
        float lowerMid = (lowerTop + lowerBottom) / 2.0

        float upperTopHalf = (upperTop + upperMid) / 2.0
        float upperBottomHalf = (upperMid + upperBottom) / 2.0
        float centerTopHalf = (centerTop + centerMid) / 2.0
        float centerBottomHalf = (centerMid + centerBottom) / 2.0
        float lowerTopHalf = (lowerTop + lowerMid) / 2.0
        float lowerBottomHalf = (lowerMid + lowerBottom) / 2.0

        if array.size(arr) != 6
            f_delete_lines(arr)
            array.push(arr, f_new_half_line(leftTime, upperTopHalf))
            array.push(arr, f_new_half_line(leftTime, upperBottomHalf))
            array.push(arr, f_new_half_line(leftTime, centerTopHalf))
            array.push(arr, f_new_half_line(leftTime, centerBottomHalf))
            array.push(arr, f_new_half_line(leftTime, lowerTopHalf))
            array.push(arr, f_new_half_line(leftTime, lowerBottomHalf))
        else
            f_update_half_line(array.get(arr, 0), leftTime, upperTopHalf)
            f_update_half_line(array.get(arr, 1), leftTime, upperBottomHalf)
            f_update_half_line(array.get(arr, 2), leftTime, centerTopHalf)
            f_update_half_line(array.get(arr, 3), leftTime, centerBottomHalf)
            f_update_half_line(array.get(arr, 4), leftTime, lowerTopHalf)
            f_update_half_line(array.get(arr, 5), leftTime, lowerBottomHalf)

//=====================================================================
// HELPER — SYNC HALF-STEP LINES FOR CONTINUATION BRICKS
// Each continuation brick gets two dashed lines centered between its
// solid midpoint and its top/bottom boundaries.
//=====================================================================
f_sync_extension_half_lines(
     array<box> brickArray,
     array<line> lineArray,
     int leftTime
) =>
    int brickCount = array.size(brickArray)
    int expectedLines = brickCount * 2

    if array.size(lineArray) != expectedLines
        f_delete_lines(lineArray)

        if brickCount > 0
            for i = 0 to brickCount - 1
                box b = array.get(brickArray, i)
                float bTop = box.get_top(b)
                float bBottom = box.get_bottom(b)
                float bMid = (bTop + bBottom) / 2.0
                float bTopHalf = (bTop + bMid) / 2.0
                float bBottomHalf = (bMid + bBottom) / 2.0

                array.push(lineArray, f_new_half_line(leftTime, bTopHalf))
                array.push(lineArray, f_new_half_line(leftTime, bBottomHalf))
    else if brickCount > 0
        for i = 0 to brickCount - 1
            box b = array.get(brickArray, i)
            float bTop = box.get_top(b)
            float bBottom = box.get_bottom(b)
            float bMid = (bTop + bBottom) / 2.0
            float bTopHalf = (bTop + bMid) / 2.0
            float bBottomHalf = (bMid + bBottom) / 2.0

            line topHalf = array.get(lineArray, i * 2)
            line bottomHalf = array.get(lineArray, i * 2 + 1)

            f_update_half_line(topHalf, leftTime, bTopHalf)
            f_update_half_line(bottomHalf, leftTime, bBottomHalf)

//=====================================================================
// SESSION LOGIC
//=====================================================================
int hh = hour(time, TZ)
int mm = minute(time, TZ)

bool after1600 =
     hh >= 16

bool before0930 =
     hh < 9 or
     (hh == 9 and mm < 30)

bool atOrAfter0930 =
     hh > 9 or
     (hh == 9 and mm >= 30)

bool before1600 =
     hh < 16

bool inOvernight =
     after1600 or before0930

bool inRTH =
     atOrAfter0930 and before1600

bool overnightStart =
     inOvernight and not inOvernight[1]

bool rthStart =
     inRTH and not inRTH[1]

bool onRangeLocked =
     showON and not inOvernight

bool rthRangeLocked =
     showRTH and not inRTH and after1600

//=====================================================================
// CURRENT WEEK / MONTH START TIMES
// THIS IS THE IMPORTANT SWING FIX
//=====================================================================
int currentWeekStart =
     time("W")

int currentMonthStart =
     time("M")

bool newWeek =
     ta.change(currentWeekStart) != 0

bool newMonth =
     ta.change(currentMonthStart) != 0

//=====================================================================
// PREVIOUS COMPLETED WEEK
//=====================================================================
float previousWeekHigh =
     request.security(
          syminfo.tickerid,
          "W",
          high[1],
          gaps = barmerge.gaps_off,
          lookahead = barmerge.lookahead_on
     )

float previousWeekLow =
     request.security(
          syminfo.tickerid,
          "W",
          low[1],
          gaps = barmerge.gaps_off,
          lookahead = barmerge.lookahead_on
     )

//=====================================================================
// PREVIOUS COMPLETED MONTH
//=====================================================================
float previousMonthHigh =
     request.security(
          syminfo.tickerid,
          "M",
          high[1],
          gaps = barmerge.gaps_off,
          lookahead = barmerge.lookahead_on
     )

float previousMonthLow =
     request.security(
          syminfo.tickerid,
          "M",
          low[1],
          gaps = barmerge.gaps_off,
          lookahead = barmerge.lookahead_on
     )

//#####################################################################
// TOGGLE 1 VARIABLES
//#####################################################################
var float onHigh = na
var float onLow = na
var int onLeft = na

var box onUpperBox = na
var box onCenterBox = na
var box onLowerBox = na

var box onUpperMidBox = na
var box onCenterMidBox = na
var box onLowerMidBox = na

var array<box> onUpExt = array.new<box>()
var array<box> onDownExt = array.new<box>()

var array<box> onUpMidExt = array.new<box>()
var array<box> onDownMidExt = array.new<box>()

var array<line> onBaseHalfLines = array.new<line>()
var array<line> onUpHalfExt = array.new<line>()
var array<line> onDownHalfExt = array.new<line>()

//#####################################################################
// TOGGLE 2 VARIABLES
//#####################################################################
var float rthHigh = na
var float rthLow = na
var int rthLeft = na

var box rthUpperBox = na
var box rthCenterBox = na
var box rthLowerBox = na

var box rthUpperMidBox = na
var box rthCenterMidBox = na
var box rthLowerMidBox = na

var array<box> rthUpExt = array.new<box>()
var array<box> rthDownExt = array.new<box>()

var array<box> rthUpMidExt = array.new<box>()
var array<box> rthDownMidExt = array.new<box>()

var array<line> rthBaseHalfLines = array.new<line>()
var array<line> rthUpHalfExt = array.new<line>()
var array<line> rthDownHalfExt = array.new<line>()

//#####################################################################
// TOGGLE 3 VARIABLES — WEEKLY
//#####################################################################
var box weekUpperBox = na
var box weekCenterBox = na
var box weekLowerBox = na

var box weekUpperMidBox = na
var box weekCenterMidBox = na
var box weekLowerMidBox = na

var array<box> weekUpExt = array.new<box>()
var array<box> weekDownExt = array.new<box>()

var array<box> weekUpMidExt = array.new<box>()
var array<box> weekDownMidExt = array.new<box>()

var array<line> weekBaseHalfLines = array.new<line>()
var array<line> weekUpHalfExt = array.new<line>()
var array<line> weekDownHalfExt = array.new<line>()

var int storedWeekStart = na

//#####################################################################
// TOGGLE 4 VARIABLES — MONTHLY
//#####################################################################
var box monthUpperBox = na
var box monthCenterBox = na
var box monthLowerBox = na

var box monthUpperMidBox = na
var box monthCenterMidBox = na
var box monthLowerMidBox = na

var array<box> monthUpExt = array.new<box>()
var array<box> monthDownExt = array.new<box>()

var array<box> monthUpMidExt = array.new<box>()
var array<box> monthDownMidExt = array.new<box>()

var array<line> monthBaseHalfLines = array.new<line>()
var array<line> monthUpHalfExt = array.new<line>()
var array<line> monthDownHalfExt = array.new<line>()

var int storedMonthStart = na

//#####################################################################
// TOGGLE 1 — 4PM → 9:30AM
//#####################################################################

//=====================================================================
// RESET OVERNIGHT
//=====================================================================
if overnightStart

    if not na(onUpperBox)
        box.delete(onUpperBox)

    if not na(onCenterBox)
        box.delete(onCenterBox)

    if not na(onLowerBox)
        box.delete(onLowerBox)

    if not na(onUpperMidBox)
        box.delete(onUpperMidBox)

    if not na(onCenterMidBox)
        box.delete(onCenterMidBox)

    if not na(onLowerMidBox)
        box.delete(onLowerMidBox)

    f_delete_boxes(onUpExt)
    f_delete_boxes(onDownExt)
    f_delete_boxes(onUpMidExt)
    f_delete_boxes(onDownMidExt)
    f_delete_lines(onBaseHalfLines)
    f_delete_lines(onUpHalfExt)
    f_delete_lines(onDownHalfExt)

    onUpperBox := na
    onCenterBox := na
    onLowerBox := na

    onUpperMidBox := na
    onCenterMidBox := na
    onLowerMidBox := na

    onHigh := high
    onLow := low
    onLeft := time

//=====================================================================
// MEASURE OVERNIGHT
//=====================================================================
if inOvernight

    if na(onHigh)
        onHigh := high

    if na(onLow)
        onLow := low

    if na(onLeft)
        onLeft := time

    onHigh := math.max(onHigh, high)
    onLow := math.min(onLow, low)

//=====================================================================
// DRAW TOGGLE 1
//=====================================================================
if showON and not na(onHigh) and not na(onLow)

    float onRange =
         onHigh - onLow

    if onRange > 0

        float upperTop =
             onHigh + onRange

        float upperBottom =
             onHigh

        float upperMid =
             onHigh + onRange / 2.0


        float centerTop =
             onHigh

        float centerBottom =
             onLow

        float centerMid =
             onLow + onRange / 2.0


        float lowerTop =
             onLow

        float lowerBottom =
             onLow - onRange

        float lowerMid =
             onLow - onRange / 2.0

        //-------------------------------------------------------------
        // CREATE ORIGINAL 3
        //-------------------------------------------------------------
        if na(onCenterBox)

            onUpperBox := box.new(
                 left = onLeft,
                 top = upperTop,
                 right = time,
                 bottom = upperBottom,
                 xloc = xloc.bar_time,
                 extend = extend.right,
                 border_color = borderColor,
                 border_width = borderWidth,
                 bgcolor = color.new(
                      upperInactiveColor,
                      boxTransparency
                 )
            )

            onCenterBox := box.new(
                 left = onLeft,
                 top = centerTop,
                 right = time,
                 bottom = centerBottom,
                 xloc = xloc.bar_time,
                 extend = extend.right,
                 border_color = borderColor,
                 border_width = borderWidth,
                 bgcolor = color.new(
                      centerColor,
                      boxTransparency
                 )
            )

            onLowerBox := box.new(
                 left = onLeft,
                 top = lowerTop,
                 right = time,
                 bottom = lowerBottom,
                 xloc = xloc.bar_time,
                 extend = extend.right,
                 border_color = borderColor,
                 border_width = borderWidth,
                 bgcolor = color.new(
                      lowerInactiveColor,
                      boxTransparency
                 )
            )

        //-------------------------------------------------------------
        // UPDATE WHILE RANGE DEVELOPS
        //-------------------------------------------------------------
        if inOvernight

            box.set_top(
                 onUpperBox,
                 upperTop
            )

            box.set_bottom(
                 onUpperBox,
                 upperBottom
            )

            box.set_top(
                 onCenterBox,
                 centerTop
            )

            box.set_bottom(
                 onCenterBox,
                 centerBottom
            )

            box.set_top(
                 onLowerBox,
                 lowerTop
            )

            box.set_bottom(
                 onLowerBox,
                 lowerBottom
            )

        //-------------------------------------------------------------
        // MIDLINES
        //-------------------------------------------------------------
        if showMidline

            if na(onUpperMidBox)

                onUpperMidBox := box.new(
                     left = onLeft,
                     top = upperMid + halfMidThickness,
                     right = time,
                     bottom = upperMid - halfMidThickness,
                     xloc = xloc.bar_time,
                     extend = extend.right,
                     border_color = midlineColor,
                     border_width = 1,
                     bgcolor = midlineColor
                )

            else

                box.set_top(
                     onUpperMidBox,
                     upperMid + halfMidThickness
                )

                box.set_bottom(
                     onUpperMidBox,
                     upperMid - halfMidThickness
                )

            if na(onCenterMidBox)

                onCenterMidBox := box.new(
                     left = onLeft,
                     top = centerMid + halfMidThickness,
                     right = time,
                     bottom = centerMid - halfMidThickness,
                     xloc = xloc.bar_time,
                     extend = extend.right,
                     border_color = midlineColor,
                     border_width = 1,
                     bgcolor = midlineColor
                )

            else

                box.set_top(
                     onCenterMidBox,
                     centerMid + halfMidThickness
                )

                box.set_bottom(
                     onCenterMidBox,
                     centerMid - halfMidThickness
                )

            if na(onLowerMidBox)

                onLowerMidBox := box.new(
                     left = onLeft,
                     top = lowerMid + halfMidThickness,
                     right = time,
                     bottom = lowerMid - halfMidThickness,
                     xloc = xloc.bar_time,
                     extend = extend.right,
                     border_color = midlineColor,
                     border_width = 1,
                     bgcolor = midlineColor
                )

            else

                box.set_top(
                     onLowerMidBox,
                     lowerMid + halfMidThickness
                )

                box.set_bottom(
                     onLowerMidBox,
                     lowerMid - halfMidThickness
                )

        //-------------------------------------------------------------
        // DASHED HALF-STEP LINES — 25% + 75% OF EACH BRICK
        //-------------------------------------------------------------
        if showHalfLines
            f_sync_base_half_lines(
                 onBaseHalfLines,
                 onLeft,
                 upperTop,
                 upperMid,
                 upperBottom,
                 centerTop,
                 centerMid,
                 centerBottom,
                 lowerTop,
                 lowerMid,
                 lowerBottom
            )

            f_sync_extension_half_lines(
                 onUpExt,
                 onUpHalfExt,
                 onLeft
            )

            f_sync_extension_half_lines(
                 onDownExt,
                 onDownHalfExt,
                 onLeft
            )
        else
            f_delete_lines(onBaseHalfLines)
            f_delete_lines(onUpHalfExt)
            f_delete_lines(onDownHalfExt)

        //-------------------------------------------------------------
        // COLORS
        //-------------------------------------------------------------
        bool priceInUpper =
             close >= upperBottom and
             close <= upperTop

        bool priceInLower =
             close >= lowerBottom and
             close <= lowerTop

        box.set_bgcolor(
             onUpperBox,
             priceInUpper
                 ? color.new(
                      upperActiveColor,
                      activeTransparency
                   )
                 : color.new(
                      upperInactiveColor,
                      boxTransparency
                   )
        )

        box.set_bgcolor(
             onCenterBox,
             color.new(
                  centerColor,
                  boxTransparency
             )
        )

        box.set_bgcolor(
             onLowerBox,
             priceInLower
                 ? color.new(
                      lowerActiveColor,
                      activeTransparency
                   )
                 : color.new(
                      lowerInactiveColor,
                      boxTransparency
                   )
        )

        //-------------------------------------------------------------
        // AUTO EXTEND UP
        //-------------------------------------------------------------
        if onRangeLocked and alertConfirmed

            int upCount =
                 array.size(onUpExt)

            float nextUpBreak =
                 upperTop +
                 onRange * upCount

            if close > nextUpBreak and
               upCount < maxContinuationBricks

                float newBottom =
                     nextUpBreak

                float newTop =
                     newBottom + onRange

                float newMid =
                     newBottom + onRange / 2.0

                box newBox = box.new(
                     left = onLeft,
                     top = newTop,
                     right = time,
                     bottom = newBottom,
                     xloc = xloc.bar_time,
                     extend = extend.right,
                     border_color = borderColor,
                     border_width = borderWidth,
                     bgcolor = color.new(
                          upperActiveColor,
                          activeTransparency
                     )
                )

                array.push(
                     onUpExt,
                     newBox
                )

                if showMidline

                    box newMidBox = box.new(
                         left = onLeft,
                         top = newMid + halfMidThickness,
                         right = time,
                         bottom = newMid - halfMidThickness,
                         xloc = xloc.bar_time,
                         extend = extend.right,
                         border_color = midlineColor,
                         border_width = 1,
                         bgcolor = midlineColor
                    )

                    array.push(
                         onUpMidExt,
                         newMidBox
                    )

        //-------------------------------------------------------------
        // AUTO EXTEND DOWN
        //-------------------------------------------------------------
        if onRangeLocked and alertConfirmed

            int downCount =
                 array.size(onDownExt)

            float nextDownBreak =
                 lowerBottom -
                 onRange * downCount

            if close < nextDownBreak and
               downCount < maxContinuationBricks

                float newTop =
                     nextDownBreak

                float newBottom =
                     newTop - onRange

                float newMid =
                     newBottom + onRange / 2.0

                box newBox = box.new(
                     left = onLeft,
                     top = newTop,
                     right = time,
                     bottom = newBottom,
                     xloc = xloc.bar_time,
                     extend = extend.right,
                     border_color = borderColor,
                     border_width = borderWidth,
                     bgcolor = color.new(
                          lowerActiveColor,
                          activeTransparency
                     )
                )

                array.push(
                     onDownExt,
                     newBox
                )

                if showMidline

                    box newMidBox = box.new(
                         left = onLeft,
                         top = newMid + halfMidThickness,
                         right = time,
                         bottom = newMid - halfMidThickness,
                         xloc = xloc.bar_time,
                         extend = extend.right,
                         border_color = midlineColor,
                         border_width = 1,
                         bgcolor = midlineColor
                    )

                    array.push(
                         onDownMidExt,
                         newMidBox
                    )

//=====================================================================
// REFRESH OVERNIGHT CONTINUATION HALF-STEP LINES AFTER NEW BRICKS
//=====================================================================
if showHalfLines and showON and not na(onLeft)
    f_sync_extension_half_lines(onUpExt, onUpHalfExt, onLeft)
    f_sync_extension_half_lines(onDownExt, onDownHalfExt, onLeft)

//#####################################################################
// TOGGLE 2 — 9:30AM → 4PM
//#####################################################################

//=====================================================================
// RESET RTH
//=====================================================================
if rthStart

    if not na(rthUpperBox)
        box.delete(rthUpperBox)

    if not na(rthCenterBox)
        box.delete(rthCenterBox)

    if not na(rthLowerBox)
        box.delete(rthLowerBox)

    if not na(rthUpperMidBox)
        box.delete(rthUpperMidBox)

    if not na(rthCenterMidBox)
        box.delete(rthCenterMidBox)

    if not na(rthLowerMidBox)
        box.delete(rthLowerMidBox)

    f_delete_boxes(rthUpExt)
    f_delete_boxes(rthDownExt)
    f_delete_boxes(rthUpMidExt)
    f_delete_boxes(rthDownMidExt)
    f_delete_lines(rthBaseHalfLines)
    f_delete_lines(rthUpHalfExt)
    f_delete_lines(rthDownHalfExt)

    rthUpperBox := na
    rthCenterBox := na
    rthLowerBox := na

    rthUpperMidBox := na
    rthCenterMidBox := na
    rthLowerMidBox := na

    rthHigh := high
    rthLow := low
    rthLeft := time

//=====================================================================
// MEASURE RTH
//=====================================================================
if inRTH

    if na(rthHigh)
        rthHigh := high

    if na(rthLow)
        rthLow := low

    if na(rthLeft)
        rthLeft := time

    rthHigh :=
         math.max(
              rthHigh,
              high
         )

    rthLow :=
         math.min(
              rthLow,
              low
         )

//=====================================================================
// DRAW TOGGLE 2
//=====================================================================
if showRTH and
   not na(rthHigh) and
   not na(rthLow)

    float rthRange =
         rthHigh - rthLow

    if rthRange > 0

        float upperTop =
             rthHigh + rthRange

        float upperBottom =
             rthHigh

        float upperMid =
             rthHigh + rthRange / 2.0


        float centerTop =
             rthHigh

        float centerBottom =
             rthLow

        float centerMid =
             rthLow + rthRange / 2.0


        float lowerTop =
             rthLow

        float lowerBottom =
             rthLow - rthRange

        float lowerMid =
             rthLow - rthRange / 2.0

        //-------------------------------------------------------------
        // CREATE ORIGINAL 3
        //-------------------------------------------------------------
        if na(rthCenterBox)

            rthUpperBox := box.new(
                 left = rthLeft,
                 top = upperTop,
                 right = time,
                 bottom = upperBottom,
                 xloc = xloc.bar_time,
                 extend = extend.right,
                 border_color = borderColor,
                 border_width = borderWidth,
                 bgcolor = color.new(
                      upperInactiveColor,
                      boxTransparency
                 )
            )

            rthCenterBox := box.new(
                 left = rthLeft,
                 top = centerTop,
                 right = time,
                 bottom = centerBottom,
                 xloc = xloc.bar_time,
                 extend = extend.right,
                 border_color = borderColor,
                 border_width = borderWidth,
                 bgcolor = color.new(
                      centerColor,
                      boxTransparency
                 )
            )

            rthLowerBox := box.new(
                 left = rthLeft,
                 top = lowerTop,
                 right = time,
                 bottom = lowerBottom,
                 xloc = xloc.bar_time,
                 extend = extend.right,
                 border_color = borderColor,
                 border_width = borderWidth,
                 bgcolor = color.new(
                      lowerInactiveColor,
                      boxTransparency
                 )
            )

        //-------------------------------------------------------------
        // UPDATE RTH RANGE
        //-------------------------------------------------------------
        if inRTH

            box.set_top(
                 rthUpperBox,
                 upperTop
            )

            box.set_bottom(
                 rthUpperBox,
                 upperBottom
            )

            box.set_top(
                 rthCenterBox,
                 centerTop
            )

            box.set_bottom(
                 rthCenterBox,
                 centerBottom
            )

            box.set_top(
                 rthLowerBox,
                 lowerTop
            )

            box.set_bottom(
                 rthLowerBox,
                 lowerBottom
            )

        //-------------------------------------------------------------
        // MIDLINES
        //-------------------------------------------------------------
        if showMidline

            if na(rthUpperMidBox)

                rthUpperMidBox := box.new(
                     left = rthLeft,
                     top = upperMid + halfMidThickness,
                     right = time,
                     bottom = upperMid - halfMidThickness,
                     xloc = xloc.bar_time,
                     extend = extend.right,
                     border_color = midlineColor,
                     border_width = 1,
                     bgcolor = midlineColor
                )

            else

                box.set_top(
                     rthUpperMidBox,
                     upperMid + halfMidThickness
                )

                box.set_bottom(
                     rthUpperMidBox,
                     upperMid - halfMidThickness
                )

            if na(rthCenterMidBox)

                rthCenterMidBox := box.new(
                     left = rthLeft,
                     top = centerMid + halfMidThickness,
                     right = time,
                     bottom = centerMid - halfMidThickness,
                     xloc = xloc.bar_time,
                     extend = extend.right,
                     border_color = midlineColor,
                     border_width = 1,
                     bgcolor = midlineColor
                )

            else

                box.set_top(
                     rthCenterMidBox,
                     centerMid + halfMidThickness
                )

                box.set_bottom(
                     rthCenterMidBox,
                     centerMid - halfMidThickness
                )

            if na(rthLowerMidBox)

                rthLowerMidBox := box.new(
                     left = rthLeft,
                     top = lowerMid + halfMidThickness,
                     right = time,
                     bottom = lowerMid - halfMidThickness,
                     xloc = xloc.bar_time,
                     extend = extend.right,
                     border_color = midlineColor,
                     border_width = 1,
                     bgcolor = midlineColor
                )

            else

                box.set_top(
                     rthLowerMidBox,
                     lowerMid + halfMidThickness
                )

                box.set_bottom(
                     rthLowerMidBox,
                     lowerMid - halfMidThickness
                )

        //-------------------------------------------------------------
        // DASHED HALF-STEP LINES — 25% + 75% OF EACH BRICK
        //-------------------------------------------------------------
        if showHalfLines
            f_sync_base_half_lines(
                 rthBaseHalfLines,
                 rthLeft,
                 upperTop,
                 upperMid,
                 upperBottom,
                 centerTop,
                 centerMid,
                 centerBottom,
                 lowerTop,
                 lowerMid,
                 lowerBottom
            )

            f_sync_extension_half_lines(
                 rthUpExt,
                 rthUpHalfExt,
                 rthLeft
            )

            f_sync_extension_half_lines(
                 rthDownExt,
                 rthDownHalfExt,
                 rthLeft
            )
        else
            f_delete_lines(rthBaseHalfLines)
            f_delete_lines(rthUpHalfExt)
            f_delete_lines(rthDownHalfExt)

        //-------------------------------------------------------------
        // ACTIVE COLORS
        //-------------------------------------------------------------
        bool priceInUpper =
             close >= upperBottom and
             close <= upperTop

        bool priceInLower =
             close >= lowerBottom and
             close <= lowerTop

        box.set_bgcolor(
             rthUpperBox,
             priceInUpper
                 ? color.new(
                      upperActiveColor,
                      activeTransparency
                   )
                 : color.new(
                      upperInactiveColor,
                      boxTransparency
                   )
        )

        box.set_bgcolor(
             rthCenterBox,
             color.new(
                  centerColor,
                  boxTransparency
             )
        )

        box.set_bgcolor(
             rthLowerBox,
             priceInLower
                 ? color.new(
                      lowerActiveColor,
                      activeTransparency
                   )
                 : color.new(
                      lowerInactiveColor,
                      boxTransparency
                   )
        )

        //-------------------------------------------------------------
        // AUTO EXTEND UP
        //-------------------------------------------------------------
        if rthRangeLocked and alertConfirmed

            int upCount =
                 array.size(rthUpExt)

            float nextUpBreak =
                 upperTop +
                 rthRange * upCount

            if close > nextUpBreak and
               upCount < maxContinuationBricks

                float newBottom =
                     nextUpBreak

                float newTop =
                     newBottom + rthRange

                float newMid =
                     newBottom + rthRange / 2.0

                box newBox = box.new(
                     left = rthLeft,
                     top = newTop,
                     right = time,
                     bottom = newBottom,
                     xloc = xloc.bar_time,
                     extend = extend.right,
                     border_color = borderColor,
                     border_width = borderWidth,
                     bgcolor = color.new(
                          upperActiveColor,
                          activeTransparency
                     )
                )

                array.push(
                     rthUpExt,
                     newBox
                )

                if showMidline

                    box newMidBox = box.new(
                         left = rthLeft,
                         top = newMid + halfMidThickness,
                         right = time,
                         bottom = newMid - halfMidThickness,
                         xloc = xloc.bar_time,
                         extend = extend.right,
                         border_color = midlineColor,
                         border_width = 1,
                         bgcolor = midlineColor
                    )

                    array.push(
                         rthUpMidExt,
                         newMidBox
                    )

        //-------------------------------------------------------------
        // AUTO EXTEND DOWN
        //-------------------------------------------------------------
        if rthRangeLocked and alertConfirmed

            int downCount =
                 array.size(rthDownExt)

            float nextDownBreak =
                 lowerBottom -
                 rthRange * downCount

            if close < nextDownBreak and
               downCount < maxContinuationBricks

                float newTop =
                     nextDownBreak

                float newBottom =
                     newTop - rthRange

                float newMid =
                     newBottom + rthRange / 2.0

                box newBox = box.new(
                     left = rthLeft,
                     top = newTop,
                     right = time,
                     bottom = newBottom,
                     xloc = xloc.bar_time,
                     extend = extend.right,
                     border_color = borderColor,
                     border_width = borderWidth,
                     bgcolor = color.new(
                          lowerActiveColor,
                          activeTransparency
                     )
                )

                array.push(
                     rthDownExt,
                     newBox
                )

                if showMidline

                    box newMidBox = box.new(
                         left = rthLeft,
                         top = newMid + halfMidThickness,
                         right = time,
                         bottom = newMid - halfMidThickness,
                         xloc = xloc.bar_time,
                         extend = extend.right,
                         border_color = midlineColor,
                         border_width = 1,
                         bgcolor = midlineColor
                    )

                    array.push(
                         rthDownMidExt,
                         newMidBox
                    )

//=====================================================================
// REFRESH RTH CONTINUATION HALF-STEP LINES AFTER NEW BRICKS
//=====================================================================
if showHalfLines and showRTH and not na(rthLeft)
    f_sync_extension_half_lines(rthUpExt, rthUpHalfExt, rthLeft)
    f_sync_extension_half_lines(rthDownExt, rthDownHalfExt, rthLeft)

//#####################################################################
// TOGGLE 3 — PREVIOUS WEEK SWING
//#####################################################################

//=====================================================================
// HIDE WEEKLY WHEN TOGGLE OFF
//=====================================================================
if not showWeekly

    if not na(weekUpperBox)
        box.delete(weekUpperBox)
        weekUpperBox := na

    if not na(weekCenterBox)
        box.delete(weekCenterBox)
        weekCenterBox := na

    if not na(weekLowerBox)
        box.delete(weekLowerBox)
        weekLowerBox := na

    if not na(weekUpperMidBox)
        box.delete(weekUpperMidBox)
        weekUpperMidBox := na

    if not na(weekCenterMidBox)
        box.delete(weekCenterMidBox)
        weekCenterMidBox := na

    if not na(weekLowerMidBox)
        box.delete(weekLowerMidBox)
        weekLowerMidBox := na

    f_delete_boxes(weekUpExt)
    f_delete_boxes(weekDownExt)
    f_delete_boxes(weekUpMidExt)
    f_delete_boxes(weekDownMidExt)
    f_delete_lines(weekBaseHalfLines)
    f_delete_lines(weekUpHalfExt)
    f_delete_lines(weekDownHalfExt)
    f_delete_lines(weekBaseHalfLines)
    f_delete_lines(weekUpHalfExt)
    f_delete_lines(weekDownHalfExt)

    storedWeekStart := na

//=====================================================================
// RESET AT ACTUAL START OF CURRENT WEEK
//=====================================================================
bool needNewWeeklyStructure =
     showWeekly and
     (
          na(storedWeekStart) or
          storedWeekStart != currentWeekStart
     )

if needNewWeeklyStructure

    if not na(weekUpperBox)
        box.delete(weekUpperBox)

    if not na(weekCenterBox)
        box.delete(weekCenterBox)

    if not na(weekLowerBox)
        box.delete(weekLowerBox)

    if not na(weekUpperMidBox)
        box.delete(weekUpperMidBox)

    if not na(weekCenterMidBox)
        box.delete(weekCenterMidBox)

    if not na(weekLowerMidBox)
        box.delete(weekLowerMidBox)

    f_delete_boxes(weekUpExt)
    f_delete_boxes(weekDownExt)
    f_delete_boxes(weekUpMidExt)
    f_delete_boxes(weekDownMidExt)

    weekUpperBox := na
    weekCenterBox := na
    weekLowerBox := na

    weekUpperMidBox := na
    weekCenterMidBox := na
    weekLowerMidBox := na

    storedWeekStart :=
         currentWeekStart

//=====================================================================
// DRAW WEEKLY SWING
// CENTER = PREVIOUS WEEK'S ACTUAL HIGH / LOW
// LEFT EDGE = CURRENT WEEK START
//=====================================================================
if showWeekly and
   not na(previousWeekHigh) and
   not na(previousWeekLow)

    float weekRange =
         previousWeekHigh -
         previousWeekLow

    if weekRange > 0

        //-------------------------------------------------------------
        // PREVIOUS WEEK CENTER BRICK
        //-------------------------------------------------------------
        float weekCenterTop =
             previousWeekHigh

        float weekCenterBottom =
             previousWeekLow

        float weekCenterMid =
             previousWeekLow +
             weekRange / 2.0

        //-------------------------------------------------------------
        // IDENTICAL CLONE ABOVE
        //-------------------------------------------------------------
        float weekUpperBottom =
             previousWeekHigh

        float weekUpperTop =
             previousWeekHigh +
             weekRange

        float weekUpperMid =
             previousWeekHigh +
             weekRange / 2.0

        //-------------------------------------------------------------
        // IDENTICAL CLONE BELOW
        //-------------------------------------------------------------
        float weekLowerTop =
             previousWeekLow

        float weekLowerBottom =
             previousWeekLow -
             weekRange

        float weekLowerMid =
             previousWeekLow -
             weekRange / 2.0

        //-------------------------------------------------------------
        // CREATE EXACT 3-BRICK WEEKLY STRUCTURE
        //-------------------------------------------------------------
        if na(weekCenterBox)

            weekUpperBox := box.new(
                 left = currentWeekStart,
                 top = weekUpperTop,
                 right = time,
                 bottom = weekUpperBottom,
                 xloc = xloc.bar_time,
                 extend = extend.right,
                 border_color = borderColor,
                 border_width = borderWidth,
                 bgcolor = color.new(
                      upperInactiveColor,
                      boxTransparency
                 )
            )

            weekCenterBox := box.new(
                 left = currentWeekStart,
                 top = weekCenterTop,
                 right = time,
                 bottom = weekCenterBottom,
                 xloc = xloc.bar_time,
                 extend = extend.right,
                 border_color = borderColor,
                 border_width = borderWidth,
                 bgcolor = color.new(
                      centerColor,
                      boxTransparency
                 )
            )

            weekLowerBox := box.new(
                 left = currentWeekStart,
                 top = weekLowerTop,
                 right = time,
                 bottom = weekLowerBottom,
                 xloc = xloc.bar_time,
                 extend = extend.right,
                 border_color = borderColor,
                 border_width = borderWidth,
                 bgcolor = color.new(
                      lowerInactiveColor,
                      boxTransparency
                 )
            )

        //-------------------------------------------------------------
        // WEEKLY MIDLINES
        //-------------------------------------------------------------
        if showMidline

            if na(weekUpperMidBox)

                weekUpperMidBox := box.new(
                     left = currentWeekStart,
                     top = weekUpperMid + halfMidThickness,
                     right = time,
                     bottom = weekUpperMid - halfMidThickness,
                     xloc = xloc.bar_time,
                     extend = extend.right,
                     border_color = midlineColor,
                     border_width = 1,
                     bgcolor = midlineColor
                )

            if na(weekCenterMidBox)

                weekCenterMidBox := box.new(
                     left = currentWeekStart,
                     top = weekCenterMid + halfMidThickness,
                     right = time,
                     bottom = weekCenterMid - halfMidThickness,
                     xloc = xloc.bar_time,
                     extend = extend.right,
                     border_color = midlineColor,
                     border_width = 1,
                     bgcolor = midlineColor
                )

            if na(weekLowerMidBox)

                weekLowerMidBox := box.new(
                     left = currentWeekStart,
                     top = weekLowerMid + halfMidThickness,
                     right = time,
                     bottom = weekLowerMid - halfMidThickness,
                     xloc = xloc.bar_time,
                     extend = extend.right,
                     border_color = midlineColor,
                     border_width = 1,
                     bgcolor = midlineColor
                )

        else

            if not na(weekUpperMidBox)
                box.delete(weekUpperMidBox)
                weekUpperMidBox := na

            if not na(weekCenterMidBox)
                box.delete(weekCenterMidBox)
                weekCenterMidBox := na

            if not na(weekLowerMidBox)
                box.delete(weekLowerMidBox)
                weekLowerMidBox := na

        //-------------------------------------------------------------
        // WEEKLY DASHED HALF-STEP LINES — 25% + 75%
        //-------------------------------------------------------------
        if showHalfLines
            f_sync_three_box_half_lines(
                 weekBaseHalfLines,
                 weekUpperBox,
                 weekCenterBox,
                 weekLowerBox
            )

            f_sync_extension_half_lines(
                 weekUpExt,
                 weekUpHalfExt,
                 box.get_left(weekCenterBox)
            )

            f_sync_extension_half_lines(
                 weekDownExt,
                 weekDownHalfExt,
                 box.get_left(weekCenterBox)
            )
        else
            f_delete_lines(weekBaseHalfLines)
            f_delete_lines(weekUpHalfExt)
            f_delete_lines(weekDownHalfExt)

        //-------------------------------------------------------------
        // ACTIVE GREEN / RED
        //-------------------------------------------------------------
        bool weekPriceInUpper =
             close >= weekUpperBottom and
             close <= weekUpperTop

        bool weekPriceInLower =
             close >= weekLowerBottom and
             close <= weekLowerTop

        box.set_bgcolor(
             weekUpperBox,
             weekPriceInUpper
                 ? color.new(
                      upperActiveColor,
                      activeTransparency
                   )
                 : color.new(
                      upperInactiveColor,
                      boxTransparency
                   )
        )

        box.set_bgcolor(
             weekCenterBox,
             color.new(
                  centerColor,
                  boxTransparency
             )
        )

        box.set_bgcolor(
             weekLowerBox,
             weekPriceInLower
                 ? color.new(
                      lowerActiveColor,
                      activeTransparency
                   )
                 : color.new(
                      lowerInactiveColor,
                      boxTransparency
                   )
        )

        //-------------------------------------------------------------
        // WEEKLY CONTINUATION UP
        //-------------------------------------------------------------
        if alertConfirmed

            int weekUpCount =
                 array.size(weekUpExt)

            float nextWeekUp =
                 weekUpperTop +
                 weekRange * weekUpCount

            if close > nextWeekUp and
               weekUpCount < maxContinuationBricks

                float newBottom =
                     nextWeekUp

                float newTop =
                     newBottom + weekRange

                float newMid =
                     newBottom + weekRange / 2.0

                box newBox = box.new(
                     left = currentWeekStart,
                     top = newTop,
                     right = time,
                     bottom = newBottom,
                     xloc = xloc.bar_time,
                     extend = extend.right,
                     border_color = borderColor,
                     border_width = borderWidth,
                     bgcolor = color.new(
                          upperActiveColor,
                          activeTransparency
                     )
                )

                array.push(
                     weekUpExt,
                     newBox
                )

                if showMidline

                    box newMidBox = box.new(
                         left = currentWeekStart,
                         top = newMid + halfMidThickness,
                         right = time,
                         bottom = newMid - halfMidThickness,
                         xloc = xloc.bar_time,
                         extend = extend.right,
                         border_color = midlineColor,
                         border_width = 1,
                         bgcolor = midlineColor
                    )

                    array.push(
                         weekUpMidExt,
                         newMidBox
                    )

        //-------------------------------------------------------------
        // WEEKLY CONTINUATION DOWN
        //-------------------------------------------------------------
        if alertConfirmed

            int weekDownCount =
                 array.size(weekDownExt)

            float nextWeekDown =
                 weekLowerBottom -
                 weekRange * weekDownCount

            if close < nextWeekDown and
               weekDownCount < maxContinuationBricks

                float newTop =
                     nextWeekDown

                float newBottom =
                     newTop - weekRange

                float newMid =
                     newBottom + weekRange / 2.0

                box newBox = box.new(
                     left = currentWeekStart,
                     top = newTop,
                     right = time,
                     bottom = newBottom,
                     xloc = xloc.bar_time,
                     extend = extend.right,
                     border_color = borderColor,
                     border_width = borderWidth,
                     bgcolor = color.new(
                          lowerActiveColor,
                          activeTransparency
                     )
                )

                array.push(
                     weekDownExt,
                     newBox
                )

                if showMidline

                    box newMidBox = box.new(
                         left = currentWeekStart,
                         top = newMid + halfMidThickness,
                         right = time,
                         bottom = newMid - halfMidThickness,
                         xloc = xloc.bar_time,
                         extend = extend.right,
                         border_color = midlineColor,
                         border_width = 1,
                         bgcolor = midlineColor
                    )

                    array.push(
                         weekDownMidExt,
                         newMidBox
                    )

        //-------------------------------------------------------------
        // WEEKLY EXTENSION ACTIVE COLORS
        //-------------------------------------------------------------
        int totalWeekUp =
             array.size(weekUpExt)

        if totalWeekUp > 0

            for i = 0 to totalWeekUp - 1

                box b =
                     array.get(
                          weekUpExt,
                          i
                     )

                float bBottom =
                     weekUpperTop +
                     weekRange * i

                float bTop =
                     bBottom +
                     weekRange

                bool inside =
                     close >= bBottom and
                     close <= bTop

                box.set_bgcolor(
                     b,
                     inside
                         ? color.new(
                              upperActiveColor,
                              activeTransparency
                           )
                         : color.new(
                              upperInactiveColor,
                              boxTransparency
                           )
                )

        int totalWeekDown =
             array.size(weekDownExt)

        if totalWeekDown > 0

            for i = 0 to totalWeekDown - 1

                box b =
                     array.get(
                          weekDownExt,
                          i
                     )

                float bTop =
                     weekLowerBottom -
                     weekRange * i

                float bBottom =
                     bTop -
                     weekRange

                bool inside =
                     close >= bBottom and
                     close <= bTop

                box.set_bgcolor(
                     b,
                     inside
                         ? color.new(
                              lowerActiveColor,
                              activeTransparency
                           )
                         : color.new(
                              lowerInactiveColor,
                              boxTransparency
                           )
                )

//=====================================================================
// REFRESH WEEKLY CONTINUATION HALF-STEP LINES AFTER NEW BRICKS
//=====================================================================
if showHalfLines and showWeekly and not na(weekCenterBox)
    f_sync_three_box_half_lines(weekBaseHalfLines, weekUpperBox, weekCenterBox, weekLowerBox)
    f_sync_extension_half_lines(weekUpExt, weekUpHalfExt, box.get_left(weekCenterBox))
    f_sync_extension_half_lines(weekDownExt, weekDownHalfExt, box.get_left(weekCenterBox))

//#####################################################################
// TOGGLE 4 — PREVIOUS MONTH SWING
//#####################################################################

//=====================================================================
// HIDE MONTHLY WHEN TOGGLE OFF
//=====================================================================
if not showMonthly

    if not na(monthUpperBox)
        box.delete(monthUpperBox)
        monthUpperBox := na

    if not na(monthCenterBox)
        box.delete(monthCenterBox)
        monthCenterBox := na

    if not na(monthLowerBox)
        box.delete(monthLowerBox)
        monthLowerBox := na

    if not na(monthUpperMidBox)
        box.delete(monthUpperMidBox)
        monthUpperMidBox := na

    if not na(monthCenterMidBox)
        box.delete(monthCenterMidBox)
        monthCenterMidBox := na

    if not na(monthLowerMidBox)
        box.delete(monthLowerMidBox)
        monthLowerMidBox := na

    f_delete_boxes(monthUpExt)
    f_delete_boxes(monthDownExt)
    f_delete_boxes(monthUpMidExt)
    f_delete_boxes(monthDownMidExt)
    f_delete_lines(monthBaseHalfLines)
    f_delete_lines(monthUpHalfExt)
    f_delete_lines(monthDownHalfExt)
    f_delete_lines(monthBaseHalfLines)
    f_delete_lines(monthUpHalfExt)
    f_delete_lines(monthDownHalfExt)

    storedMonthStart := na

//=====================================================================
// RESET AT ACTUAL START OF CURRENT MONTH
//=====================================================================
bool needNewMonthlyStructure =
     showMonthly and
     (
          na(storedMonthStart) or
          storedMonthStart != currentMonthStart
     )

if needNewMonthlyStructure

    if not na(monthUpperBox)
        box.delete(monthUpperBox)

    if not na(monthCenterBox)
        box.delete(monthCenterBox)

    if not na(monthLowerBox)
        box.delete(monthLowerBox)

    if not na(monthUpperMidBox)
        box.delete(monthUpperMidBox)

    if not na(monthCenterMidBox)
        box.delete(monthCenterMidBox)

    if not na(monthLowerMidBox)
        box.delete(monthLowerMidBox)

    f_delete_boxes(monthUpExt)
    f_delete_boxes(monthDownExt)
    f_delete_boxes(monthUpMidExt)
    f_delete_boxes(monthDownMidExt)

    monthUpperBox := na
    monthCenterBox := na
    monthLowerBox := na

    monthUpperMidBox := na
    monthCenterMidBox := na
    monthLowerMidBox := na

    storedMonthStart :=
         currentMonthStart

//=====================================================================
// DRAW MONTHLY SWING
// CENTER = PREVIOUS MONTH'S ACTUAL HIGH / LOW
// LEFT EDGE = CURRENT MONTH START
//=====================================================================
if showMonthly and
   not na(previousMonthHigh) and
   not na(previousMonthLow)

    float monthRange =
         previousMonthHigh -
         previousMonthLow

    if monthRange > 0

        //-------------------------------------------------------------
        // PREVIOUS MONTH CENTER BRICK
        //-------------------------------------------------------------
        float monthCenterTop =
             previousMonthHigh

        float monthCenterBottom =
             previousMonthLow

        float monthCenterMid =
             previousMonthLow +
             monthRange / 2.0

        //-------------------------------------------------------------
        // IDENTICAL CLONE ABOVE
        //-------------------------------------------------------------
        float monthUpperBottom =
             previousMonthHigh

        float monthUpperTop =
             previousMonthHigh +
             monthRange

        float monthUpperMid =
             previousMonthHigh +
             monthRange / 2.0

        //-------------------------------------------------------------
        // IDENTICAL CLONE BELOW
        //-------------------------------------------------------------
        float monthLowerTop =
             previousMonthLow

        float monthLowerBottom =
             previousMonthLow -
             monthRange

        float monthLowerMid =
             previousMonthLow -
             monthRange / 2.0

        //-------------------------------------------------------------
        // CREATE EXACT 3-BRICK MONTHLY STRUCTURE
        //-------------------------------------------------------------
        if na(monthCenterBox)

            monthUpperBox := box.new(
                 left = currentMonthStart,
                 top = monthUpperTop,
                 right = time,
                 bottom = monthUpperBottom,
                 xloc = xloc.bar_time,
                 extend = extend.right,
                 border_color = borderColor,
                 border_width = borderWidth,
                 bgcolor = color.new(
                      upperInactiveColor,
                      boxTransparency
                 )
            )

            monthCenterBox := box.new(
                 left = currentMonthStart,
                 top = monthCenterTop,
                 right = time,
                 bottom = monthCenterBottom,
                 xloc = xloc.bar_time,
                 extend = extend.right,
                 border_color = borderColor,
                 border_width = borderWidth,
                 bgcolor = color.new(
                      centerColor,
                      boxTransparency
                 )
            )

            monthLowerBox := box.new(
                 left = currentMonthStart,
                 top = monthLowerTop,
                 right = time,
                 bottom = monthLowerBottom,
                 xloc = xloc.bar_time,
                 extend = extend.right,
                 border_color = borderColor,
                 border_width = borderWidth,
                 bgcolor = color.new(
                      lowerInactiveColor,
                      boxTransparency
                 )
            )

        //-------------------------------------------------------------
        // MONTHLY MIDLINES
        //-------------------------------------------------------------
        if showMidline

            if na(monthUpperMidBox)

                monthUpperMidBox := box.new(
                     left = currentMonthStart,
                     top = monthUpperMid + halfMidThickness,
                     right = time,
                     bottom = monthUpperMid - halfMidThickness,
                     xloc = xloc.bar_time,
                     extend = extend.right,
                     border_color = midlineColor,
                     border_width = 1,
                     bgcolor = midlineColor
                )

            if na(monthCenterMidBox)

                monthCenterMidBox := box.new(
                     left = currentMonthStart,
                     top = monthCenterMid + halfMidThickness,
                     right = time,
                     bottom = monthCenterMid - halfMidThickness,
                     xloc = xloc.bar_time,
                     extend = extend.right,
                     border_color = midlineColor,
                     border_width = 1,
                     bgcolor = midlineColor
                )

            if na(monthLowerMidBox)

                monthLowerMidBox := box.new(
                     left = currentMonthStart,
                     top = monthLowerMid + halfMidThickness,
                     right = time,
                     bottom = monthLowerMid - halfMidThickness,
                     xloc = xloc.bar_time,
                     extend = extend.right,
                     border_color = midlineColor,
                     border_width = 1,
                     bgcolor = midlineColor
                )

        else

            if not na(monthUpperMidBox)
                box.delete(monthUpperMidBox)
                monthUpperMidBox := na

            if not na(monthCenterMidBox)
                box.delete(monthCenterMidBox)
                monthCenterMidBox := na

            if not na(monthLowerMidBox)
                box.delete(monthLowerMidBox)
                monthLowerMidBox := na

        //-------------------------------------------------------------
        // MONTHLY DASHED HALF-STEP LINES — 25% + 75%
        //-------------------------------------------------------------
        if showHalfLines
            f_sync_three_box_half_lines(
                 monthBaseHalfLines,
                 monthUpperBox,
                 monthCenterBox,
                 monthLowerBox
            )

            f_sync_extension_half_lines(
                 monthUpExt,
                 monthUpHalfExt,
                 box.get_left(monthCenterBox)
            )

            f_sync_extension_half_lines(
                 monthDownExt,
                 monthDownHalfExt,
                 box.get_left(monthCenterBox)
            )
        else
            f_delete_lines(monthBaseHalfLines)
            f_delete_lines(monthUpHalfExt)
            f_delete_lines(monthDownHalfExt)

        //-------------------------------------------------------------
        // ACTIVE GREEN / RED
        //-------------------------------------------------------------
        bool monthPriceInUpper =
             close >= monthUpperBottom and
             close <= monthUpperTop

        bool monthPriceInLower =
             close >= monthLowerBottom and
             close <= monthLowerTop

        box.set_bgcolor(
             monthUpperBox,
             monthPriceInUpper
                 ? color.new(
                      upperActiveColor,
                      activeTransparency
                   )
                 : color.new(
                      upperInactiveColor,
                      boxTransparency
                   )
        )

        box.set_bgcolor(
             monthCenterBox,
             color.new(
                  centerColor,
                  boxTransparency
             )
        )

        box.set_bgcolor(
             monthLowerBox,
             monthPriceInLower
                 ? color.new(
                      lowerActiveColor,
                      activeTransparency
                   )
                 : color.new(
                      lowerInactiveColor,
                      boxTransparency
                   )
        )

        //-------------------------------------------------------------
        // MONTHLY CONTINUATION UP
        //-------------------------------------------------------------
        if alertConfirmed

            int monthUpCount =
                 array.size(monthUpExt)

            float nextMonthUp =
                 monthUpperTop +
                 monthRange * monthUpCount

            if close > nextMonthUp and
               monthUpCount < maxContinuationBricks

                float newBottom =
                     nextMonthUp

                float newTop =
                     newBottom + monthRange

                float newMid =
                     newBottom + monthRange / 2.0

                box newBox = box.new(
                     left = currentMonthStart,
                     top = newTop,
                     right = time,
                     bottom = newBottom,
                     xloc = xloc.bar_time,
                     extend = extend.right,
                     border_color = borderColor,
                     border_width = borderWidth,
                     bgcolor = color.new(
                          upperActiveColor,
                          activeTransparency
                     )
                )

                array.push(
                     monthUpExt,
                     newBox
                )

                if showMidline

                    box newMidBox = box.new(
                         left = currentMonthStart,
                         top = newMid + halfMidThickness,
                         right = time,
                         bottom = newMid - halfMidThickness,
                         xloc = xloc.bar_time,
                         extend = extend.right,
                         border_color = midlineColor,
                         border_width = 1,
                         bgcolor = midlineColor
                    )

                    array.push(
                         monthUpMidExt,
                         newMidBox
                    )

        //-------------------------------------------------------------
        // MONTHLY CONTINUATION DOWN
        //-------------------------------------------------------------
        if alertConfirmed

            int monthDownCount =
                 array.size(monthDownExt)

            float nextMonthDown =
                 monthLowerBottom -
                 monthRange * monthDownCount

            if close < nextMonthDown and
               monthDownCount < maxContinuationBricks

                float newTop =
                     nextMonthDown

                float newBottom =
                     newTop - monthRange

                float newMid =
                     newBottom + monthRange / 2.0

                box newBox = box.new(
                     left = currentMonthStart,
                     top = newTop,
                     right = time,
                     bottom = newBottom,
                     xloc = xloc.bar_time,
                     extend = extend.right,
                     border_color = borderColor,
                     border_width = borderWidth,
                     bgcolor = color.new(
                          lowerActiveColor,
                          activeTransparency
                     )
                )

                array.push(
                     monthDownExt,
                     newBox
                )

                if showMidline

                    box newMidBox = box.new(
                         left = currentMonthStart,
                         top = newMid + halfMidThickness,
                         right = time,
                         bottom = newMid - halfMidThickness,
                         xloc = xloc.bar_time,
                         extend = extend.right,
                         border_color = midlineColor,
                         border_width = 1,
                         bgcolor = midlineColor
                    )

                    array.push(
                         monthDownMidExt,
                         newMidBox
                    )

        //-------------------------------------------------------------
        // MONTHLY EXTENSION ACTIVE COLORS
        //-------------------------------------------------------------
        int totalMonthUp =
             array.size(monthUpExt)

        if totalMonthUp > 0

            for i = 0 to totalMonthUp - 1

                box b =
                     array.get(
                          monthUpExt,
                          i
                     )

                float bBottom =
                     monthUpperTop +
                     monthRange * i

                float bTop =
                     bBottom +
                     monthRange

                bool inside =
                     close >= bBottom and
                     close <= bTop

                box.set_bgcolor(
                     b,
                     inside
                         ? color.new(
                              upperActiveColor,
                              activeTransparency
                           )
                         : color.new(
                              upperInactiveColor,
                              boxTransparency
                           )
                )

        int totalMonthDown =
             array.size(monthDownExt)

        if totalMonthDown > 0

            for i = 0 to totalMonthDown - 1

                box b =
                     array.get(
                          monthDownExt,
                          i
                     )

                float bTop =
                     monthLowerBottom -
                     monthRange * i

                float bBottom =
                     bTop -
                     monthRange

                bool inside =
                     close >= bBottom and
                     close <= bTop

                box.set_bgcolor(
                     b,
                     inside
                         ? color.new(
                              lowerActiveColor,
                              activeTransparency
                           )
                         : color.new(
                              lowerInactiveColor,
                              boxTransparency
                           )
                )

//=====================================================================
// REFRESH MONTHLY CONTINUATION HALF-STEP LINES AFTER NEW BRICKS
//=====================================================================
if showHalfLines and showMonthly and not na(monthCenterBox)
    f_sync_three_box_half_lines(monthBaseHalfLines, monthUpperBox, monthCenterBox, monthLowerBox)
    f_sync_extension_half_lines(monthUpExt, monthUpHalfExt, box.get_left(monthCenterBox))
    f_sync_extension_half_lines(monthDownExt, monthDownHalfExt, box.get_left(monthCenterBox))

//=====================================================================
// GLOBAL HALF-STEP TOGGLE CLEANUP
//=====================================================================
if not showHalfLines
    f_delete_lines(onBaseHalfLines)
    f_delete_lines(onUpHalfExt)
    f_delete_lines(onDownHalfExt)
    f_delete_lines(rthBaseHalfLines)
    f_delete_lines(rthUpHalfExt)
    f_delete_lines(rthDownHalfExt)
    f_delete_lines(weekBaseHalfLines)
    f_delete_lines(weekUpHalfExt)
    f_delete_lines(weekDownHalfExt)
    f_delete_lines(monthBaseHalfLines)
    f_delete_lines(monthUpHalfExt)
    f_delete_lines(monthDownHalfExt)

//#####################################################################
// ALERT LEVELS
//#####################################################################

//=====================================================================
// T1
//=====================================================================
float onAlertRange =
     not na(onHigh) and not na(onLow)
         ? onHigh - onLow
         : na

float onUpperTopAlert =
     not na(onAlertRange)
         ? onHigh + onAlertRange
         : na

float onLowerBottomAlert =
     not na(onAlertRange)
         ? onLow - onAlertRange
         : na

//=====================================================================
// T2
//=====================================================================
float rthAlertRange =
     not na(rthHigh) and not na(rthLow)
         ? rthHigh - rthLow
         : na

float rthUpperTopAlert =
     not na(rthAlertRange)
         ? rthHigh + rthAlertRange
         : na

float rthLowerBottomAlert =
     not na(rthAlertRange)
         ? rthLow - rthAlertRange
         : na

//=====================================================================
// T3
//=====================================================================
float weekAlertRange =
     previousWeekHigh -
     previousWeekLow

float weekUpperTopAlert =
     previousWeekHigh +
     weekAlertRange

float weekLowerBottomAlert =
     previousWeekLow -
     weekAlertRange

//=====================================================================
// T4
//=====================================================================
float monthAlertRange =
     previousMonthHigh -
     previousMonthLow

float monthUpperTopAlert =
     previousMonthHigh +
     monthAlertRange

float monthLowerBottomAlert =
     previousMonthLow -
     monthAlertRange

//#####################################################################
// ALERT CONDITIONS
//#####################################################################
bool t1BreakUp =
     enableAlerts and
     onRangeLocked and
     alertConfirmed and
     not na(onUpperTopAlert) and
     ta.crossover(
          close,
          onUpperTopAlert
     )

bool t1BreakDown =
     enableAlerts and
     onRangeLocked and
     alertConfirmed and
     not na(onLowerBottomAlert) and
     ta.crossunder(
          close,
          onLowerBottomAlert
     )

bool t2BreakUp =
     enableAlerts and
     rthRangeLocked and
     alertConfirmed and
     not na(rthUpperTopAlert) and
     ta.crossover(
          close,
          rthUpperTopAlert
     )

bool t2BreakDown =
     enableAlerts and
     rthRangeLocked and
     alertConfirmed and
     not na(rthLowerBottomAlert) and
     ta.crossunder(
          close,
          rthLowerBottomAlert
     )

bool t3BreakUp =
     enableAlerts and
     showWeekly and
     alertConfirmed and
     not na(weekUpperTopAlert) and
     ta.crossover(
          close,
          weekUpperTopAlert
     )

bool t3BreakDown =
     enableAlerts and
     showWeekly and
     alertConfirmed and
     not na(weekLowerBottomAlert) and
     ta.crossunder(
          close,
          weekLowerBottomAlert
     )

bool t4BreakUp =
     enableAlerts and
     showMonthly and
     alertConfirmed and
     not na(monthUpperTopAlert) and
     ta.crossover(
          close,
          monthUpperTopAlert
     )

bool t4BreakDown =
     enableAlerts and
     showMonthly and
     alertConfirmed and
     not na(monthLowerBottomAlert) and
     ta.crossunder(
          close,
          monthLowerBottomAlert
     )

//#####################################################################
// ALERTS
//#####################################################################
alertcondition(
     t1BreakUp,
     "T1 Overnight — Break Up",
     "🚀 {{ticker}} | T1 OVERNIGHT BRICK BREAK UP | Price {{close}}"
)

alertcondition(
     t1BreakDown,
     "T1 Overnight — Break Down",
     "🔻 {{ticker}} | T1 OVERNIGHT BRICK BREAK DOWN | Price {{close}}"
)

alertcondition(
     t2BreakUp,
     "T2 RTH — Break Up",
     "🚀 {{ticker}} | T2 RTH BRICK BREAK UP | Price {{close}}"
)

alertcondition(
     t2BreakDown,
     "T2 RTH — Break Down",
     "🔻 {{ticker}} | T2 RTH BRICK BREAK DOWN | Price {{close}}"
)

alertcondition(
     t3BreakUp,
     "T3 Weekly Swing — Break Up",
     "🟢 {{ticker}} | WEEKLY SWING BRICK BREAK UP | Price {{close}}"
)

alertcondition(
     t3BreakDown,
     "T3 Weekly Swing — Break Down",
     "🔴 {{ticker}} | WEEKLY SWING BRICK BREAK DOWN | Price {{close}}"
)

alertcondition(
     t4BreakUp,
     "T4 Monthly Swing — Break Up",
     "🟢 {{ticker}} | MONTHLY SWING BRICK BREAK UP | Price {{close}}"
)

alertcondition(
     t4BreakDown,
     "T4 Monthly Swing — Break Down",
     "🔴 {{ticker}} | MONTHLY SWING BRICK BREAK DOWN | Price {{close}}"
)