int anchorWidth = input.int(2, "Anchor Width", minval = 1, maxval = 4, group = GROUP_VISUALS)
string anchorStyle = input.string(STYLE_SOLID, "Anchor Style", options = [STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], group = GROUP_VISUALS)
int anchorTransparency = input.int(10, "Anchor Transparency", minval = 0, maxval = 100, group = GROUP_VISUALS)
color intermediateColor = input.color(color.rgb(125, 140, 160), "Intermediate Level Color", group = GROUP_VISUALS)
int intermediateWidth = input.int(1, "Intermediate Level Width", minval = 1, maxval = 4, group = GROUP_VISUALS)
string intermediateStyle = input.string(STYLE_DOTTED, "Intermediate Level Style", options = [STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], group = GROUP_VISUALS)
int intermediateTransparency = input.int(55, "Intermediate Level Transparency", minval = 0, maxval = 100, group = GROUP_VISUALS)
color sigma050Color = input.color(color.rgb(90, 145, 205), "0.50σ Color", group = GROUP_VISUALS)
int sigma050Width = input.int(1, "0.50σ Width", minval = 1, maxval = 4, group = GROUP_VISUALS)
string sigma050Style = input.string(STYLE_DASHED, "0.50σ Style", options = [STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], group = GROUP_VISUALS)
int sigma050Transparency = input.int(25, "0.50σ Transparency", minval = 0, maxval = 100, group = GROUP_VISUALS)
