//@version=6
indicator("Refined 1-2-3 by Anirudh", overlay=true, max_boxes_count=10, max_lines_count=10, max_labels_count=10)

// ==============================================================================
// 1. INPUTS & STYLING
// ==============================================================================
wick_pct_in = input.float(1.0, title="Body % to include in Wick Zone", step=0.5) / 100
col_bull = input.color(color.new(color.teal, 75), "Demand Zones (Bullish)")
col_bear = input.color(color.new(color.maroon, 75), "Supply Zones (Bearish)")
col_line = input.color(color.new(color.gray, 50), "Zig-Zag Line Color")

// ==============================================================================
// 2. TIMEFRAME STRING GENERATOR
// ==============================================================================
var string tf_str = ""
if barstate.isfirst
    if timeframe.isintraday
        tf_str := timeframe.multiplier >= 60 ? str.tostring(timeframe.multiplier / 60) + "H" : str.tostring(timeframe.multiplier) + "m"
    else if timeframe.isdaily
        tf_str := "1D"
    else
        tf_str := timeframe.period

// ==============================================================================
// 3. STATE VARIABLES (Strict Tracking)
// ==============================================================================
// Confirmed Swings (Level 1s)
var float c_high_p = na, var int c_high_b = na, var float c_high_o = na, var float c_high_c = na
var float c_low_p = na,  var int c_low_b = na,  var float c_low_o = na,  var float c_low_c = na

// Extreme Trackers (To find Level 2s)
var float t_high_p = high, var int t_high_b = bar_index, var float t_high_o = open, var float t_high_c = close
var float t_low_p = low,   var int t_low_b = bar_index,  var float t_low_o = open,  var float t_low_c = close

// Breakout Trackers (To prevent redrawing)
var int last_bear_break = -1
var int last_bull_break = -1

// Active Drawings
var box bear_b1 = na, var box bear_b2 = na, var line bear_l1 = na, var line bear_l2 = na, var label bear_lb1 = na, var label bear_lb2 = na, var label bear_lb3 = na
var box bull_b1 = na, var box bull_b2 = na, var line bull_l1 = na, var line bull_l2 = na, var label bull_lb1 = na, var label bull_lb2 = na, var label bull_lb3 = na

// ==============================================================================
// 4. CORE ENGINE (2-Candle Rule & Extremes)
// ==============================================================================
// Track running extremes
if high > t_high_p
    t_high_p := high, t_high_b := bar_index, t_high_o := open, t_high_c := close
if low < t_low_p
    t_low_p := low, t_low_b := bar_index, t_low_o := open, t_low_c := close

// Strict 2-Candle Rules
bool red2 = (close[1] < open[1]) and (close[0] < open[0]) and (close[0] < low[1])
bool green2 = (close[1] > open[1]) and (close[0] > open[0]) and (close[0] > high[1])

if red2
    c_high_p := t_high_p, c_high_b := t_high_b, c_high_o := t_high_o, c_high_c := t_high_c
    t_low_p := low, t_low_b := bar_index, t_low_o := open, t_low_c := close // Reset low tracker

if green2
    c_low_p := t_low_p, c_low_b := t_low_b, c_low_o := t_low_o, c_low_c := t_low_c
    t_high_p := high, t_high_b := bar_index, t_high_o := open, t_high_c := close // Reset high tracker

// ==============================================================================
// 5. BREAKOUT & LEVEL 2 DETECTION
// ==============================================================================
// ---------------- BEARISH BREAKOUT ----------------
if not na(c_low_p) and close < c_low_p and last_bear_break != c_low_b
    last_bear_break := c_low_b
    
    // Find Level 2: The absolute highest high between Level 1 and this Breakout
    float l2_p = -999999.0
    int l2_b = bar_index, float l2_o = open, float l2_c = close
    int steps = math.min(bar_index - c_low_b, 500)
    if steps > 0
        for i = 0 to steps
            if high[i] > l2_p
                l2_p := high[i], l2_b := bar_index[i], l2_o := open[i], l2_c := close[i]
                
    // Clean old drawings
    if not na(bear_b1)
        box.delete(bear_b1), box.delete(bear_b2), line.delete(bear_l1), line.delete(bear_l2), label.delete(bear_lb1), label.delete(bear_lb2), label.delete(bear_lb3)

    // Draw Level 1 (Broken Low -> Supply)
    b_bot = math.min(c_low_o, c_low_c)
    b_size = math.abs(c_low_o - c_low_c)
    z1_top = b_bot + (b_size * wick_pct_in)
    bear_b1 := box.new(c_low_b, z1_top, bar_index, c_low_p, bgcolor=col_bear, border_color=color.new(col_bear, 20), text=tf_str + " - 1 Supply", text_color=color.new(color.white, 30), text_size=size.small, text_halign=text.align_right, text_valign=text.align_bottom)

    // Draw Level 2 (Extreme High -> Supply)
    b_top2 = math.max(l2_o, l2_c)
    b_size2 = math.abs(l2_o - l2_c)
    z2_bot = b_top2 - (b_size2 * wick_pct_in)
    bear_b2 := box.new(l2_b, l2_p, bar_index, z2_bot, bgcolor=col_bear, border_color=color.new(col_bear, 20), text=tf_str + " - 2 Supply", text_color=color.new(color.white, 30), text_size=size.small, text_halign=text.align_right, text_valign=text.align_bottom)
    
    // Draw Zig-Zag
    bear_l1 := line.new(c_low_b, c_low_p, l2_b, l2_p, color=col_line, width=2)
    bear_l2 := line.new(l2_b, l2_p, bar_index, close, color=col_line, width=2)
    bear_lb1 := label.new(c_low_b, c_low_p, "(1)", style=label.style_label_up, color=color.new(color.white, 100), textcolor=color.gray, size=size.small)
    bear_lb2 := label.new(l2_b, l2_p, "(2)", style=label.style_label_down, color=color.new(color.white, 100), textcolor=color.gray, size=size.small)
    bear_lb3 := label.new(bar_index, close, "(3)", style=label.style_label_up, color=color.new(color.white, 100), textcolor=color.gray, size=size.small)

// ---------------- BULLISH BREAKOUT ----------------
if not na(c_high_p) and close > c_high_p and last_bull_break != c_high_b
    last_bull_break := c_high_b
    
    // Find Level 2: The absolute lowest low between Level 1 and this Breakout
    float l2_p = 999999.0
    int l2_b = bar_index, float l2_o = open, float l2_c = close
    int steps = math.min(bar_index - c_high_b, 500)
    if steps > 0
        for i = 0 to steps
            if low[i] < l2_p
                l2_p := low[i], l2_b := bar_index[i], l2_o := open[i], l2_c := close[i]
                
    // Clean old drawings
    if not na(bull_b1)
        box.delete(bull_b1), box.delete(bull_b2), line.delete(bull_l1), line.delete(bull_l2), label.delete(bull_lb1), label.delete(bull_lb2), label.delete(bull_lb3)

    // Draw Level 1 (Broken High -> Demand)
    b_top = math.max(c_high_o, c_high_c)
    b_size = math.abs(c_high_o - c_high_c)
    z1_bot = b_top - (b_size * wick_pct_in)
    bull_b1 := box.new(c_high_b, c_high_p, bar_index, z1_bot, bgcolor=col_bull, border_color=color.new(col_bull, 20), text=tf_str + " - 1 Demand", text_color=color.new(color.white, 30), text_size=size.small, text_halign=text.align_right, text_valign=text.align_top)

    // Draw Level 2 (Extreme Low -> Demand)
    b_bot2 = math.min(l2_o, l2_c)
    b_size2 = math.abs(l2_o - l2_c)
    z2_top = b_bot2 + (b_size2 * wick_pct_in)
    bull_b2 := box.new(l2_b, z2_top, bar_index, l2_p, bgcolor=col_bull, border_color=color.new(col_bull, 20), text=tf_str + " - 2 Demand", text_color=color.new(color.white, 30), text_size=size.small, text_halign=text.align_right, text_valign=text.align_top)
    
    // Draw Zig-Zag
    bull_l1 := line.new(c_high_b, c_high_p, l2_b, l2_p, color=col_line, width=2)
    bull_l2 := line.new(l2_b, l2_p, bar_index, close, color=col_line, width=2)
    bull_lb1 := label.new(c_high_b, c_high_p, "(1)", style=label.style_label_down, color=color.new(color.white, 100), textcolor=color.gray, size=size.small)
    bull_lb2 := label.new(l2_b, l2_p, "(2)", style=label.style_label_up, color=color.new(color.white, 100), textcolor=color.gray, size=size.small)
    bull_lb3 := label.new(bar_index, close, "(3)", style=label.style_label_down, color=color.new(color.white, 100), textcolor=color.gray, size=size.small)

// ==============================================================================
// 6. ZONE EXTENSION & INDEPENDENT INVALIDATION
// ==============================================================================
// Extend active Bearish boxes; invalidate if closed above
if not na(bear_b1)
    box.set_right(bear_b1, bar_index)
    if close > box.get_top(bear_b1)
        box.set_bgcolor(bear_b1, color.new(color.gray, 90)), box.set_border_color(bear_b1, color.new(color.gray, 90)), box.set_text(bear_b1, "")
        bear_b1 := na

if not na(bear_b2)
    box.set_right(bear_b2, bar_index)
    if close > box.get_top(bear_b2)
        box.set_bgcolor(bear_b2, color.new(color.gray, 90)), box.set_border_color(bear_b2, color.new(color.gray, 90)), box.set_text(bear_b2, "")
        bear_b2 := na

// Extend active Bullish boxes; invalidate if closed below
if not na(bull_b1)
    box.set_right(bull_b1, bar_index)
    if close < box.get_bottom(bull_b1)
        box.set_bgcolor(bull_b1, color.new(color.gray, 90)), box.set_border_color(bull_b1, color.new(color.gray, 90)), box.set_text(bull_b1, "")
        bull_b1 := na

if not na(bull_b2)
    box.set_right(bull_b2, bar_index)
    if close < box.get_bottom(bull_b2)
        box.set_bgcolor(bull_b2, color.new(color.gray, 90)), box.set_border_color(bull_b2, color.new(color.gray, 90)), box.set_text(bull_b2, "")
        bull_b2 := na