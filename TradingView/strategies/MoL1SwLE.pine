//@version=5
strategy("3策略自动切换综合版 - Range + Trend + Breakout", 
     overlay=true, 
     default_qty_type=strategy.percent_of_equity, 
     default_qty_value=8, 
     initial_capital=10000, 
     commission_type=strategy.commission.percent, 
     commission_value=0.07)

// ==================== 输入参数 ====================
rsiLen     = input.int(14, "RSI长度")
adxLen     = input.int(14, "ADX长度")
bbLen      = input.int(20, "布林带长度")
bbMult     = input.float(2.0, "布林带倍数")
atrLen     = input.int(14, "ATR长度")
riskPct    = input.float(1.0, "单笔风险%", minval=0.5, step=0.1)
rrRatio    = input.float(2.5, "止盈风险比", minval=1.5, step=0.1)

// ==================== 计算指标 ====================
rsi = ta.rsi(close, rsiLen)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
[bbMid, bbUpper, bbLower] = ta.bb(close, bbLen, bbMult)
atr = ta.atr(atrLen)
volMA = ta.sma(volume, 20)
ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)

// ==================== 市场环境判断 ====================
isRanging     = adx < 25 and close > bbLower and close < bbUpper
isTrending    = adx > 25 and close > ema50 and ema50 > ema200
isBreakout    = volume > volMA * 1.8 and ta.crossover(close, bbUpper) and adx > 20

// ==================== 入场条件 ====================
rangeLong     = isRanging and rsi < 35 and close <= bbLower * 1.01 and volume > volMA * 1.2
trendLong     = isTrending and ta.crossover(ema50, ema200) and rsi > 50 and close > bbMid
breakoutLong  = isBreakout and rsi > 50 and close[1] < bbUpper[1]

// ==================== 策略执行 ====================
if rangeLong and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

if trendLong and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

if breakoutLong and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

// ==================== 止损止盈 ====================
if strategy.position_size > 0
    stopLoss = strategy.position_avg_price - atr * 1.5
    takeProfit = strategy.position_avg_price + (strategy.position_avg_price - stopLoss) * rrRatio
    strategy.exit("Exit", "Long", stop=stopLoss, limit=takeProfit)

// ==================== 可视化（已彻底修复） ====================
bgcolor(isRanging ? color.new(color.green, 80) : isTrending ? color.new(color.blue, 80) : isBreakout ? color.new(color.orange, 80) : na, title="市场环境")

// ==================== 信息面板 ====================
var table info = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 75))

table.cell(info, 0, 0, "当前环境", text_color=color.white)
table.cell(info, 1, 0, isRanging ? "区间交易" : isTrending ? "趋势跟踪" : isBreakout ? "突破交易" : "等待信号", text_color=color.yellow)

table.cell(info, 0, 1, "ADX", text_color=color.white)
table.cell(info, 1, 1, str.tostring(adx, "#.##"), text_color=color.white)

table.cell(info, 0, 2, "RSI", text_color=color.white)
table.cell(info, 1, 2, str.tostring(rsi, "#.##"), text_color=color.white)

table.cell(info, 0, 3, "布林位置", text_color=color.white)
table.cell(info, 1, 3, close > bbMid ? "上轨区域" : "下轨区域", text_color=color.white)

table.cell(info, 0, 4, "当前仓位", text_color=color.white)
table.cell(info, 1, 4, strategy.position_size > 0 ? "持有多单" : "空仓", text_color=color.white)