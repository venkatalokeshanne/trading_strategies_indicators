//@version=5
strategy("BB + RSI + Volume + EMA Trend + Smart ADX (Intraday + Dynamic SL + RR + Risk Cap)", 
     overlay=true, 
     default_qty_type=strategy.percent_of_equity, 
     default_qty_value=10)

// ================= Inputs =================
bbLength = input.int(20, "BB Length")
bbMult = input.float(2.0, "BB StdDev")
rsiLength = input.int(14, "RSI Length")
volLength = input.int(20, "Volume MA Length")
emaLength = input.int(200, "EMA Trend Length")
adxLength = input.int(14, "ADX Length")
adxThreshold = input.int(20, "ADX Threshold")

// Risk control
maxRiskPercent = input.float(1.5, "Max Risk % Cap")

// Intraday exit time (customizable)
exitHour = input.int(15, "Exit Hour")
exitMinute = input.int(15, "Exit Minute")

// ================= Bollinger Bands =================
bbBasis = ta.sma(close, bbLength)
bbDev = bbMult * ta.stdev(close, bbLength)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

plot(bbBasis, "BB Basis", color=color.orange)
upperPlot = plot(bbUpper, "Upper BB", color=color.blue)
lowerPlot = plot(bbLower, "Lower BB", color=color.blue)
fill(upperPlot, lowerPlot, color=color.new(color.blue, 90))

prevInsideUpper = close[1] < bbUpper
prevInsideLower = close[1] > bbLower

// ================= RSI =================
rsiValue = ta.rsi(close, rsiLength)

// ================= Volume =================
avgVolume = ta.sma(volume, volLength)
volumeConfirm = volume > avgVolume

// ================= EMA Trend =================
emaTrend = ta.ema(close, emaLength)
plot(emaTrend, "EMA 200", color=color.yellow, linewidth=2)

// ================= ADX =================
[diplus, diminus, adxValue] = ta.dmi(adxLength, adxLength)
adxRising = adxValue > adxValue[1]
strongTrend = adxValue > adxThreshold
bullishTrend = diplus > diminus
bearishTrend = diminus > diplus

// ================= Signals =================
buySignal =
     close >= bbUpper and
     prevInsideUpper and
     rsiValue > 60 and
     volumeConfirm and
     close > emaTrend and
     strongTrend and
     adxRising and
     bullishTrend

sellSignal =
     close <= bbLower and
     prevInsideLower and
     rsiValue < 40 and
     volumeConfirm and
     close < emaTrend and
     strongTrend and
     adxRising and
     bearishTrend

plotshape(buySignal, title="BUY", location=location.belowbar, color=color.green, style=shape.labelup, text="BUY")
plotshape(sellSignal, title="SELL", location=location.abovebar, color=color.red, style=shape.labeldown, text="SELL")

// ================= Entries =================
if buySignal
    strategy.entry("Buy", strategy.long)

if sellSignal
    strategy.entry("Sell", strategy.short)

// ================= Dynamic SL + Risk Cap =================
var float longSL = na
var float shortSL = na

if (buySignal and strategy.position_size == 0)
    longSL := low

if (sellSignal and strategy.position_size == 0)
    shortSL := high

// Long
longEntry = strategy.position_avg_price
longRiskRaw = longEntry - longSL
maxLongRisk = longEntry * maxRiskPercent / 100
longRisk = math.min(longRiskRaw, maxLongRisk)

longSL_final = longEntry - longRisk
longTarget = longEntry + (2 * longRisk)

// Short
shortEntry = strategy.position_avg_price
shortRiskRaw = shortSL - shortEntry
maxShortRisk = shortEntry * maxRiskPercent / 100
shortRisk = math.min(shortRiskRaw, maxShortRisk)

shortSL_final = shortEntry + shortRisk
shortTarget = shortEntry - (2 * shortRisk)

// ================= Exits =================
strategy.exit("Exit Buy", from_entry="Buy", stop=longSL_final, limit=longTarget)
strategy.exit("Exit Sell", from_entry="Sell", stop=shortSL_final, limit=shortTarget)

// ================= Intraday Exit (IMPORTANT) =================
currentHour = hour(time)
currentMinute = minute(time)

// Trigger exit at defined time
isExitTime = (currentHour == exitHour and currentMinute >= exitMinute)

// Close all positions at EOD
if (isExitTime)
    strategy.close_all(comment="EOD Exit")

// ================= Alerts =================
signal = buySignal ? "BUY" : sellSignal ? "SELL" : "NONE"
alertcondition(signal != "NONE", 
     title="Trade Signal Alert", 
     message="Trade Signal: {{signal}}")

// ================= ADX Plots =================
plot(adxValue, "ADX", color=color.purple)
plot(diplus, "+DI", color=color.green)
plot(diminus, "-DI", color=color.red)