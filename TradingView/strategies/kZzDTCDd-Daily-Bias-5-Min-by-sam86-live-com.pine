//@version=6
strategy(
     "Daily-Bias 5-Min Merged Strategy-by sam86@live.com",
     shorttitle      = "DB5M-Merged",
     overlay         = true,
     pyramiding      = 0,
     initial_capital = 10000,
     default_qty_type  = strategy.fixed,
     default_qty_value = 100,
     calc_on_order_fills  = true,
     calc_on_every_tick   = false,
     process_orders_on_close = true,
     max_bars_back    = 2000,
     max_lines_count  = 500,
     max_labels_count = 500,
     max_boxes_count  = 500
)

// ──────────────────────────────────────────────────────────────────
// GROUP LABELS
// ──────────────────────────────────────────────────────────────────
var string G_SESS  = "Session Filter"
var string G_MA    = "MA / DEMA Layer"
var string G_QT    = "Q-Trend Layer"
var string G_UT    = "UT Bot Layer"
var string G_TREND = "HTF Trend Filter (Daily-Bias)"
var string G_SCORE = "Signal Engine / Score"
var string G_TRADE = "Trade Management"
var string G_VWAP  = "VWAP / Opening Range"
var string G_ZONE  = "Supply & Demand Zones"
var string G_VOL   = "Volume / Bubble Logic"
var string G_RISK  = "Risk Guide (ATR SL/TP)"
var string G_VIS   = "Visuals"
var string G_MOM   = "Momentum Shift"

// ══════════════════════════════════════════════════════════════════
// SECTION 1 — SESSION FILTER
// ══════════════════════════════════════════════════════════════════
useSessionFilter = input.bool(true, "Enable Session Filter", group = G_SESS)
tradeSession     = input.session("0930-1130", "Trading Session (EST)", group = G_SESS)
shadeSession     = input.bool(true, "Shade Allowed Session", group = G_SESS)

inSession = not na(time(timeframe.period, tradeSession))
sessOK    = not useSessionFilter or inSession

bgcolor(shadeSession and inSession ? color.new(color.yellow, 92) : na)

// ══════════════════════════════════════════════════════════════════
// SECTION 2 — CORE ATR
// ══════════════════════════════════════════════════════════════════
atrLen = input.int(14, "ATR Length", minval = 1, group = G_TRADE)
atr    = ta.atr(atrLen)

// ══════════════════════════════════════════════════════════════════
// SECTION 3 — HTF DAILY TREND GATE
// ══════════════════════════════════════════════════════════════════
useHTFGate = input.bool(true, "Use Daily Trend Gate", group = G_TREND)
htfTF      = input.timeframe("D", "HTF Timeframe", group = G_TREND)
htfEMALen  = input.int(200, "Daily EMA Length", minval = 10, group = G_TREND)
useADX     = input.bool(true, "Require ADX Trend Strength", group = G_TREND)
adxLen     = input.int(14, "ADX Length", minval = 1, group = G_TREND)
adxThr     = input.float(18, "ADX Threshold", step = 0.5, group = G_TREND)

adxCalc(_len) =>
    upMove   = high - high[1]
    downMove = low[1] - low
    plusDM   = (upMove > downMove and upMove > 0) ? upMove : 0.0
    minusDM  = (downMove > upMove and downMove > 0) ? downMove : 0.0
    trVal    = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
    smTR     = ta.rma(trVal, _len)
    smP      = ta.rma(plusDM, _len)
    smM      = ta.rma(minusDM, _len)
    plusDI   = smTR != 0 ? 100.0 * smP / smTR : 0.0
    minusDI  = smTR != 0 ? 100.0 * smM / smTR : 0.0
    dx       = (plusDI + minusDI != 0) ? 100.0 * math.abs(plusDI - minusDI) / (plusDI + minusDI) : 0.0
    ta.rma(dx, _len)

htfClose  = request.security(syminfo.tickerid, htfTF, close)
htfEMA200 = request.security(syminfo.tickerid, htfTF, ta.ema(close, htfEMALen))
htfADX    = request.security(syminfo.tickerid, htfTF, adxCalc(adxLen))

htfBull     = htfClose > htfEMA200
htfBear     = htfClose < htfEMA200
htfTrending = not useADX or htfADX >= adxThr

dailyLongOK  = not useHTFGate or (htfBull and htfTrending)
dailyShortOK = not useHTFGate or (htfBear and htfTrending)

// ══════════════════════════════════════════════════════════════════
// SECTION 4 — DEMA LAYER
// ══════════════════════════════════════════════════════════════════
demaFastLen = input.int(9, "DEMA Fast Period", minval = 1, group = G_MA)
demaSlowLen = input.int(21, "DEMA Slow Period", minval = 1, group = G_MA)
useMAFilter = input.bool(true, "Require DEMA Confirmation", group = G_MA)

dema(_src, _len) =>
    e1 = ta.ema(_src, _len)
    e2 = ta.ema(e1, _len)
    2.0 * e1 - e2

demaFast = dema(close, demaFastLen)
demaSlow = dema(close, demaSlowLen)

maBuySignal  = ta.crossover(demaFast, demaSlow)
maSellSignal = ta.crossunder(demaFast, demaSlow)
maLongOK     = demaFast > demaSlow
maShortOK    = demaFast < demaSlow

plot(demaFast, "DEMA Fast", color = color.blue, linewidth = 2)
plot(demaSlow, "DEMA Slow", color = color.red, linewidth = 2)

plotshape(maBuySignal and sessOK, title = "DEMA Buy", text = "DEMA↑", style = shape.labelup, location = location.belowbar, color = color.new(color.blue, 0), textcolor = color.white, size = size.tiny)
plotshape(maSellSignal and sessOK, title = "DEMA Sell", text = "DEMA↓", style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 0), textcolor = color.white, size = size.tiny)

// ══════════════════════════════════════════════════════════════════
// SECTION 4B — MOMENTUM SHIFT VISUAL
// ══════════════════════════════════════════════════════════════════
momLen          = input.int(20, "Momentum Length", minval = 2, group = G_MOM)
momSmooth       = input.int(5, "Momentum Smoothing", minval = 1, group = G_MOM)
momAtrLen       = input.int(14, "ATR Length", minval = 1, group = G_MOM)
momStepMult     = input.float(0.6, "Step ATR Multiplier", step = 0.1, group = G_MOM)
momProjBars     = input.int(8, "Projection Bars", minval = 1, maxval = 50, group = G_MOM)
showMomVisual   = input.bool(true, "Show Momentum Visual", group = G_MOM)
showMomLabels   = input.bool(true, "Show Momentum Shift Labels", group = G_MOM)
showMomFill     = input.bool(true, "Show Momentum Fill", group = G_MOM)

// momentum core
momRaw   = close - close[momLen]
momSm    = ta.ema(momRaw, momSmooth)
momAtr   = math.max(ta.atr(momAtrLen), syminfo.mintick)

momBull      = momSm > 0
momBear      = momSm < 0
momShiftUp   = ta.crossover(momSm, 0)
momShiftDown = ta.crossunder(momSm, 0)

// stair-step anchor
var float momBaseLine = na

if na(momBaseLine)
    momBaseLine := close

if momShiftUp
    momBaseLine := low + momAtr * momStepMult

if momShiftDown
    momBaseLine := high - momAtr * momStepMult

momStepLine = momBull ? math.max(nz(momBaseLine), low + momAtr * momStepMult) : math.min(nz(momBaseLine), high - momAtr * momStepMult)

// visual bands
momUpper = momBull ? momStepLine + momAtr * 2.8 : momStepLine + momAtr * 0.8
momLower = momBull ? momStepLine - momAtr * 0.8 : momStepLine - momAtr * 2.8

momLineColor = momBull ? color.new(color.aqua, 0) : color.new(color.red, 0)
momFillColor = momBull ? color.new(color.green, 78) : color.new(color.red, 78)

// main plotted levels
pMomMid = plot(showMomVisual ? momStepLine : na, "Momentum Mid", color = momLineColor, linewidth = 2, style = plot.style_stepline)
pMomUp  = plot(showMomVisual ? momUpper    : na, "Momentum Upper", color = color.new(momLineColor, 40), linewidth = 1, style = plot.style_stepline)
pMomDn  = plot(showMomVisual ? momLower    : na, "Momentum Lower", color = color.new(momLineColor, 40), linewidth = 1, style = plot.style_stepline)

fill(pMomUp, pMomDn, color = showMomFill ? momFillColor : na, title = "Momentum Zone")

// shift labels
plotshape(showMomLabels and momShiftUp, title = "Momentum Shift Up", text = "▲", style = shape.labelup, location = location.belowbar, color = color.new(color.lime, 0), textcolor = color.black, size = size.tiny)
plotshape(showMomLabels and momShiftDown, title = "Momentum Shift Down", text = "▼", style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 0), textcolor = color.white, size = size.tiny)

// ══════════════════════════════════════════════════════════════════
// SECTION 5 — Q-TREND LAYER
// ══════════════════════════════════════════════════════════════════
qtSrc         = input.source(close, "Source", group = G_QT)
qtPeriod      = input.int(100, "Trend Period", group = G_QT, minval = 1)
qtAtrP        = input.int(14, "ATR Period", group = G_QT, minval = 1)
qtMult        = input.float(1.2, "ATR Multiplier", group = G_QT, step = 0.1)
qtMode        = input.string("Type A", "Signal Mode", group = G_QT, options = ["Type A", "Type B"])
qtEmaSmooth   = input.string("No", "Smooth with EMA?", group = G_QT, options = ["Yes", "No"])
qtEmaPeriod   = input.int(3, "EMA Smoother", group = G_QT)
useStrongOnly = input.bool(false, "Strong Signals Only", group = G_QT)
qtColorBars   = input.bool(true, "Color Bars", group = G_QT)
qtShowTL      = input.bool(true, "Show Trend Line", group = G_QT)
qtSignalsView = input.string("All", "Signals to Show", group = G_QT, options = ["All", "Buy/Sell", "Strong", "None"])
qtSigShape    = input.string("Labels", "Signal Shape", group = G_QT, options = ["Labels", "Arrows"])
qtBuyCol      = input.color(color.green, "Buy Colour", group = G_QT, inline = "BS")
qtSellCol     = input.color(color.red, "Sell Colour", group = G_QT, inline = "BS")

srcCalc = qtEmaSmooth == "Yes" ? ta.ema(qtSrc, qtEmaPeriod) : qtSrc

qt_h = ta.highest(srcCalc, qtPeriod)
qt_l = ta.lowest(srcCalc, qtPeriod)
qt_d = qt_h - qt_l

var string qt_ls = ""

qt_m = (qt_h + qt_l) / 2.0
qt_m := bar_index > qtPeriod ? qt_m[1] : qt_m

qt_atr     = ta.atr(qtAtrP)[1]
qt_epsilon = qtMult * qt_atr

qt_change_up   = (qtMode == "Type B" ? ta.cross(srcCalc, qt_m + qt_epsilon) : ta.crossover(srcCalc, qt_m + qt_epsilon)) or srcCalc > qt_m + qt_epsilon
qt_change_down = (qtMode == "Type B" ? ta.cross(srcCalc, qt_m - qt_epsilon) : ta.crossunder(srcCalc, qt_m - qt_epsilon)) or srcCalc < qt_m - qt_epsilon

qt_sb = open < qt_l + qt_d / 8.0 and open >= qt_l
qt_ss = open > qt_h - qt_d / 8.0 and open <= qt_h

qt_strong_buy  = qt_sb or qt_sb[1] or qt_sb[2] or qt_sb[3] or qt_sb[4]
qt_strong_sell = qt_ss or qt_ss[1] or qt_ss[2] or qt_ss[3] or qt_ss[4]

qt_m := (qt_change_up or qt_change_down) and qt_m != qt_m[1] ? qt_m : qt_change_up ? qt_m + qt_epsilon : qt_change_down ? qt_m - qt_epsilon : nz(qt_m[1], qt_m)

qt_prevLs = qt_ls[1]
qt_ls := qt_change_up ? "B" : qt_change_down ? "S" : (na(qt_ls[1]) ? "" : qt_ls[1])

qt_trendColor = qt_ls == "B" ? qtBuyCol : qtSellCol
qt_buyShape   = qtSigShape == "Labels" ? shape.labelup : shape.triangleup
qt_sellShape  = qtSigShape == "Labels" ? shape.labeldown : shape.triangledown

qt_freshBuy  = qt_change_up and qt_prevLs != "B"
qt_freshSell = qt_change_down and qt_prevLs != "S"

qtBuy  = useStrongOnly ? (qt_freshBuy and qt_strong_buy) : qt_freshBuy
qtSell = useStrongOnly ? (qt_freshSell and qt_strong_sell) : qt_freshSell

plot(qtShowTL ? qt_m : na, "Q-Trend Line", qt_trendColor, 3)
barcolor(qtColorBars ? qt_trendColor : na)

plotshape(qtSigShape == "Labels" and (qtSignalsView == "All" or qtSignalsView == "Buy/Sell") and qt_freshBuy and not qt_strong_buy, title = "QT Buy", color = qt_trendColor, style = qt_buyShape, location = location.belowbar, size = size.normal, text = "QT-BUY", textcolor = color.white)
plotshape(qtSigShape == "Labels" and (qtSignalsView == "All" or qtSignalsView == "Buy/Sell") and qt_freshSell and not qt_strong_sell, title = "QT Sell", color = qt_trendColor, style = qt_sellShape, location = location.abovebar, size = size.normal, text = "QT-SELL", textcolor = color.white)
plotshape(qtSigShape == "Labels" and (qtSignalsView == "All" or qtSignalsView == "Strong") and qt_freshBuy and qt_strong_buy, title = "QT Strong Buy", color = qt_trendColor, style = qt_buyShape, location = location.belowbar, size = size.normal, text = "QT STRONG BUY", textcolor = color.white)
plotshape(qtSigShape == "Labels" and (qtSignalsView == "All" or qtSignalsView == "Strong") and qt_freshSell and qt_strong_sell, title = "QT Strong Sell", color = qt_trendColor, style = qt_sellShape, location = location.abovebar, size = size.normal, text = "QT STRONG SELL", textcolor = color.white)

// ══════════════════════════════════════════════════════════════════
// SECTION 6 — UT BOT LAYER
// ══════════════════════════════════════════════════════════════════
utKeyVal = input.float(1.0, "UT Key Value (sensitivity)", minval = 0.1, step = 0.1, group = G_UT)
utAtrP   = input.int(10, "UT ATR Period", minval = 1, group = G_UT)
utUseHA  = input.bool(false, "UT Use Heikin Ashi Source", group = G_UT)

ut_src   = utUseHA ? request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, close, lookahead = barmerge.lookahead_off) : close
ut_xATR  = ta.atr(utAtrP)
ut_nLoss = utKeyVal * ut_xATR

var float ut_trail = na
prevTrail = nz(ut_trail[1], 0.0)

if ut_src > prevTrail and ut_src[1] > prevTrail
    ut_trail := math.max(prevTrail, ut_src - ut_nLoss)
else if ut_src < prevTrail and ut_src[1] < prevTrail
    ut_trail := math.min(prevTrail, ut_src + ut_nLoss)
else if ut_src > prevTrail
    ut_trail := ut_src - ut_nLoss
else
    ut_trail := ut_src + ut_nLoss

var int ut_pos = 0
ut_pos := ut_src[1] < nz(ut_trail[1], 0) and ut_src > nz(ut_trail[1], 0) ? 1 :
          ut_src[1] > nz(ut_trail[1], 0) and ut_src < nz(ut_trail[1], 0) ? -1 : nz(ut_pos[1], 0)

ut_ema1  = ta.ema(ut_src, 1)
ut_above = ta.crossover(ut_ema1, ut_trail)
ut_below = ta.crossover(ut_trail, ut_ema1)

utBuySignal  = ut_src > ut_trail and ut_above
utSellSignal = ut_src < ut_trail and ut_below

ut_barbuy  = ut_src > ut_trail
ut_barsell = ut_src < ut_trail

ut_barCol = ut_pos == -1 ? color.red : ut_pos == 1 ? color.green : color.blue
plot(ut_trail, "UT Trail", color = ut_barCol, linewidth = 1)

plotshape(utBuySignal, title = "UT Buy", text = "UtBot-Buy", style = shape.labelup, location = location.belowbar, color = color.green, textcolor = color.white, size = size.tiny)
plotshape(utSellSignal, title = "UT Sell", text = "UtBot-Sell", style = shape.labeldown, location = location.abovebar, color = color.red, textcolor = color.white, size = size.tiny)

// ══════════════════════════════════════════════════════════════════
// SECTION 7 — VWAP + OPENING RANGE
// ══════════════════════════════════════════════════════════════════
showVWAP = input.bool(true, "Show Session VWAP", group = G_VWAP)
showOR   = input.bool(true, "Show Opening Range", group = G_VWAP)
orAutoK  = input.float(3.0, "OR Auto K × TF min", group = G_VWAP, step = 0.5)
orMin    = input.int(30, "OR Manual minutes", group = G_VWAP, minval = 1)
orMode   = input.string("Auto", "OR Mode", group = G_VWAP, options = ["Auto", "Manual"])

tf_minutes() =>
    float m = na
    if timeframe.isseconds
        m := math.max(1.0, timeframe.multiplier) / 60.0
    else if timeframe.isminutes
        m := timeframe.multiplier
    else if timeframe.isdaily
        m := 1440.0 * timeframe.multiplier
    else if timeframe.isweekly
        m := 10080.0 * timeframe.multiplier
    else
        m := 43200.0 * timeframe.multiplier
    m

float tfMin = tf_minutes()

var float cumPV = na
var float cumV  = na
newSess = ta.change(time("D")) != 0

if newSess or na(cumPV)
    cumPV := 0.0
    cumV  := 0.0

cumPV += hlc3 * volume
cumV  += volume
vwap = cumV > 0 ? cumPV / cumV : na

float orLenMin = orMode == "Auto" ? orAutoK * tfMin : float(orMin)
int orBars = math.max(1, int(math.ceil(orLenMin / math.max(tfMin, 1.0))))

var float orH = na
var float orL = na
var int bfo = 0

if newSess
    orH := na
    orL := na
    bfo := 0

if bfo < orBars
    orH := na(orH) ? high : math.max(orH, high)
    orL := na(orL) ? low : math.min(orL, low)
    bfo += 1

plot(showVWAP ? vwap : na, "VWAP", color = color.new(color.yellow, 0), linewidth = 2)
plot(showOR and bfo > 0 ? orH : na, "OR High", color = color.new(color.orange, 0), linewidth = 2, style = plot.style_linebr)
plot(showOR and bfo > 0 ? orL : na, "OR Low", color = color.new(color.orange, 0), linewidth = 2, style = plot.style_linebr)

vwapBull = close > vwap
vwapBear = close < vwap
orBull   = bfo >= orBars and close > orH
orBear   = bfo >= orBars and close < orL

// ══════════════════════════════════════════════════════════════════
// SECTION 8 — DELTA / VOLUME
// ══════════════════════════════════════════════════════════════════
deltaMode    = input.string("RangeWeighted", "Delta Proxy", group = G_VOL, options = ["RangeWeighted", "CloseVsPrev", "CloseVsOpen"])
volSpikeMult = input.float(1.2, "Volume Spike Multiplier", group = G_VOL, step = 0.1, minval = 0.1)
ultraVolMult = input.float(2.0, "Ultra Volume Multiplier", group = G_VOL, step = 0.1, minval = 0.1)
useVolForSig = input.bool(true, "Require Volume for Signal", group = G_VOL)
showVolLabel = input.bool(true, "Show Volume on Spike Bars", group = G_VOL)
volGapATR    = input.float(0.75, "Volume Label Gap ATR", group = G_VOL, step = 0.05, minval = 0.0)

rng_val = math.max(high - low, syminfo.mintick)
dRW     = rng_val > 0 ? volume * (close - open) / rng_val : 0.0
dCP     = close >= close[1] ? volume : -volume
dCO     = close >= open ? volume : -volume
delta   = deltaMode == "RangeWeighted" ? dRW : deltaMode == "CloseVsOpen" ? dCO : dCP
absDel  = math.abs(delta)

volMA    = ta.sma(volume, 20)
volRatio = volMA > 0 ? volume / volMA : 0.0
volSpike = volume > volMA * volSpikeMult
ultraVol = volume > volMA * ultraVolMult

volConfirm = not useVolForSig or volSpike

if showVolLabel and volSpike
    volStr = volume >= 1000000 ? str.tostring(volume / 1000000, "#.##") + "M" :
             volume >= 1000 ? str.tostring(volume / 1000, "#.##") + "K" :
             str.tostring(volume)
    vCol = ultraVol ? color.new(color.purple, 20) : close >= open ? color.new(color.green, 40) : color.new(color.red, 40)
    label.new(bar_index, high + atr * volGapATR, volStr, style = label.style_label_down, color = vCol, textcolor = color.white, size = size.tiny)

// ══════════════════════════════════════════════════════════════════
// SECTION 9 — SUPPLY & DEMAND ZONES
// ══════════════════════════════════════════════════════════════════
showZones     = input.bool(true, "Show Zones", group = G_ZONE)
zDepth        = input.float(0.6, "Zone Depth × ATR", group = G_ZONE, step = 0.05)
zExtend       = input.int(120, "Extend (bars)", group = G_ZONE, minval = 10)
L1            = input.int(10, "Pivot A Left", group = G_ZONE, minval = 2)
R1            = input.int(10, "Pivot A Right", group = G_ZONE, minval = 2)
L2            = input.int(5, "Pivot B Left", group = G_ZONE, minval = 2)
R2            = input.int(5, "Pivot B Right", group = G_ZONE, minval = 2)
showZoneMid   = input.bool(true, "Show Zone Midline", group = G_ZONE)
onlyTrendZone = input.bool(false, "Only In-Trend Zones", group = G_ZONE)

colSupIn  = color.new(#E57373, 76)
colSupOut = color.new(#E57373, 92)
colDemIn  = color.new(#81C784, 76)
colDemOut = color.new(#81C784, 92)
midCol    = color.new(color.gray, 60)

type PairState
    box sup
    float supTop
    float supBot
    line supMid
    box dem
    float demTop
    float demBot
    line demMid

mkZone(_left, _top, _bot, _isSupply, _inTrend) =>
    fill = _isSupply ? (_inTrend ? colSupIn : colSupOut) : (_inTrend ? colDemIn : colDemOut)
    box.new(_left, _top, _left + zExtend, _bot, xloc = xloc.bar_index, bgcolor = fill, border_color = fill)

makeMidline(_x0, _mid) =>
    line.new(_x0, _mid, _x0 + zExtend, _mid, xloc = xloc.bar_index, extend = extend.none, color = midCol, style = line.style_dashed)

updatePair(_ph, _pl, _r, _state) =>
    supBox = _state.sup
    supTop = _state.supTop
    supBot = _state.supBot
    supMid = _state.supMid
    demBox = _state.dem
    demTop = _state.demTop
    demBot = _state.demBot
    demMid = _state.demMid

    if showZones and not na(_ph)
        left = bar_index - _r
        top  = _ph
        bot  = _ph - atr * zDepth
        inTr = not onlyTrendZone or dailyShortOK
        if not na(supBox)
            box.delete(supBox)
        if not na(supMid)
            line.delete(supMid)
        supBox := mkZone(left, top, bot, true, inTr)
        supTop := top
        supBot := bot
        supMid := showZoneMid ? makeMidline(left, (top + bot) * 0.5) : na

    if showZones and not na(_pl)
        left = bar_index - _r
        top  = _pl + atr * zDepth
        bot  = _pl
        inTr = not onlyTrendZone or dailyLongOK
        if not na(demBox)
            box.delete(demBox)
        if not na(demMid)
            line.delete(demMid)
        demBox := mkZone(left, top, bot, false, inTr)
        demTop := top
        demBot := bot
        demMid := showZoneMid ? makeMidline(left, (top + bot) * 0.5) : na

    PairState.new(supBox, supTop, supBot, supMid, demBox, demTop, demBot, demMid)

var PairState pairA = PairState.new(na, na, na, na, na, na, na, na)
var PairState pairB = PairState.new(na, na, na, na, na, na, na, na)

phA = ta.pivothigh(high, L1, R1)
plA = ta.pivotlow(low, L1, R1)
pairA := updatePair(phA, plA, R1, pairA)

phB = ta.pivothigh(high, L2, R2)
plB = ta.pivotlow(low, L2, R2)
pairB := updatePair(phB, plB, R2, pairB)

extBox(_b) =>
    if not na(_b)
        box.set_right(_b, bar_index + zExtend)

extLn(_l, _y) =>
    if not na(_l)
        line.set_x2(_l, bar_index + zExtend)
        if not na(_y)
            line.set_y1(_l, _y)
            line.set_y2(_l, _y)

extBox(pairA.sup)
extBox(pairA.dem)
extBox(pairB.sup)
extBox(pairB.dem)

extLn(pairA.supMid, na(pairA.supTop) or na(pairA.supBot) ? na : (pairA.supTop + pairA.supBot) * 0.5)
extLn(pairA.demMid, na(pairA.demTop) or na(pairA.demBot) ? na : (pairA.demTop + pairA.demBot) * 0.5)
extLn(pairB.supMid, na(pairB.supTop) or na(pairB.supBot) ? na : (pairB.supTop + pairB.supBot) * 0.5)
extLn(pairB.demMid, na(pairB.demTop) or na(pairB.demBot) ? na : (pairB.demTop + pairB.demBot) * 0.5)

inDemandA = not na(pairA.demTop) and not na(pairA.demBot) and low <= pairA.demTop and high >= pairA.demBot
inDemandB = not na(pairB.demTop) and not na(pairB.demBot) and low <= pairB.demTop and high >= pairB.demBot
inSupplyA = not na(pairA.supTop) and not na(pairA.supBot) and high >= pairA.supBot and low <= pairA.supTop
inSupplyB = not na(pairB.supTop) and not na(pairB.supBot) and high >= pairB.supBot and low <= pairB.supTop
inDemand  = inDemandA or inDemandB
inSupply  = inSupplyA or inSupplyB

// ══════════════════════════════════════════════════════════════════
// SECTION 10 — BUBBLE THRESHOLD
// ══════════════════════════════════════════════════════════════════
showBub   = input.bool(true, "Show Bubbles", group = G_VOL)
useVolBub = input.bool(true, "Require Volume Bubble", group = G_VOL)
qbLen     = input.int(200, "Bubble Lookback", group = G_VOL, minval = 50)
qbPct     = input.float(85, "Bubble Quantile %", group = G_VOL, step = 0.5, minval = 50, maxval = 99.9)

thrBub = ta.percentile_linear_interpolation(absDel, qbLen, qbPct)

strongDeltaUp = delta > 0 and absDel >= math.max(thrBub, 1)
strongDeltaDn = delta < 0 and absDel >= math.max(thrBub, 1)

bubbleBuyReady  = inDemand and strongDeltaUp and (not useVolBub or volSpike)
bubbleSellReady = inSupply and strongDeltaDn and (not useVolBub or volSpike)

bubbleSize(r) =>
    s = size.small
    if r >= 3.0
        s := size.huge
    else if r >= 2.2
        s := size.large
    else if r >= 1.4
        s := size.normal
    s

if showBub and absDel >= math.max(thrBub, 1)
    ratio = absDel / math.max(thrBub, 1)
    bSize = bubbleSize(ratio)
    if bubbleBuyReady
        bCol = ultraVol ? color.new(color.lime, 0) : color.new(color.lime, 15)
        label.new(bar_index, low, "BUY", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_circle, color = bCol, textcolor = color.white, size = bSize)
    if bubbleSellReady
        bCol = ultraVol ? color.new(color.red, 0) : color.new(color.red, 15)
        label.new(bar_index, high, "SELL", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_circle, color = bCol, textcolor = color.white, size = bSize)

// ══════════════════════════════════════════════════════════════════
// SECTION 11 — SCORE-BASED SIGNAL ENGINE
// ══════════════════════════════════════════════════════════════════
//minScore     = input.int(4, "Min Score to Fire (max 8)", group = G_SCORE, minval = 1, maxval = 8)
minScore     = input.int(5, "Min Score to Fire (max 9)", group = G_SCORE, minval = 1, maxval = 9)

cooldownBars = input.int(8, "Cooldown Bars", group = G_SCORE, minval = 1)
useVWAPConf  = input.bool(true, "VWAP Confirmation", group = G_SCORE)
useORConf    = input.bool(true, "OR Breakout Confirmation", group = G_SCORE)
showScore    = input.bool(true, "Show Score in Label", group = G_SCORE)
sigGapATR    = input.float(0.35, "Signal Label Gap ATR", group = G_SCORE, step = 0.05, minval = 0.0)

longScore = 0
longScore += dailyLongOK ? 1 : 0
longScore += maLongOK ? 1 : 0
longScore += qt_ls == "B" ? 1 : 0
longScore += ut_barbuy ? 1 : 0
longScore += inDemand ? 1 : 0
longScore += strongDeltaUp ? 1 : 0
longScore += (not useVWAPConf or vwapBull) ? 1 : 0
longScore += (not useORConf or orBull) ? 1 : 0
longScore += momBull ? 1 : 0

shortScore = 0
shortScore += dailyShortOK ? 1 : 0
shortScore += maShortOK ? 1 : 0
shortScore += qt_ls == "S" ? 1 : 0
shortScore += ut_barsell ? 1 : 0
shortScore += inSupply ? 1 : 0
shortScore += strongDeltaDn ? 1 : 0
shortScore += (not useVWAPConf or vwapBear) ? 1 : 0
shortScore += (not useORConf or orBear) ? 1 : 0
shortScore += momBear ? 1 : 0

var int lastLongBar = na
var int lastShortBar = na

canLong  = na(lastLongBar) or (bar_index - lastLongBar > cooldownBars)
canShort = na(lastShortBar) or (bar_index - lastShortBar > cooldownBars)

longTrigger  = (qtBuy or utBuySignal or maBuySignal) and longScore >= minScore
shortTrigger = (qtSell or utSellSignal or maSellSignal) and shortScore >= minScore

longSignal  = sessOK and canLong and longTrigger and volConfirm and dailyLongOK
shortSignal = sessOK and canShort and shortTrigger and volConfirm and dailyShortOK

if longSignal
    label.new(bar_index, low - atr * sigGapATR, showScore ? "BUY " + str.tostring(longScore) + "/9" : "BUY", style = label.style_label_up, color = color.new(color.lime, 0), textcolor = color.black, size = size.small)
    lastLongBar := bar_index

if shortSignal
    label.new(bar_index, high + atr * sigGapATR, showScore ? "SELL " + str.tostring(shortScore) + "/9" : "SELL", style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.small)
    lastShortBar := bar_index

// ══════════════════════════════════════════════════════════════════
// SECTION 12 — RSI FILTER
// ══════════════════════════════════════════════════════════════════
rsiPeriod     = input.int(14, "RSI Period", group = G_SCORE, minval = 1)
rsiOverbought = input.int(75, "RSI Overbought Gate (no longs above)", group = G_SCORE)
rsiOversold   = input.int(25, "RSI Oversold Gate (no shorts below)", group = G_SCORE)

rsi = ta.rsi(close, rsiPeriod)
rsiLongOK  = rsi < rsiOverbought
rsiShortOK = rsi > rsiOversold

// ══════════════════════════════════════════════════════════════════
// SECTION 13 — STRATEGY EXECUTION
// ══════════════════════════════════════════════════════════════════
qtyShares  = input.int(100, "Fixed Share Qty", group = G_TRADE, minval = 1)
slAtrMult  = input.float(1.2, "Stop Loss ATR Multiplier", group = G_TRADE, step = 0.1, minval = 0.1)
rrRatio    = input.float(2.0, "Reward Ratio (R:R)", group = G_TRADE, step = 0.1, minval = 1.0)
showLevels = input.bool(true, "Show SL/TP Lines", group = G_TRADE)

longEntry  = close
shortEntry = close

longStop  = longEntry - atr * slAtrMult
shortStop = shortEntry + atr * slAtrMult

longRisk  = longEntry - longStop
shortRisk = shortStop - shortEntry

longTP  = longEntry + longRisk * rrRatio
shortTP = shortEntry - shortRisk * rrRatio

finalLong  = longSignal and rsiLongOK
finalShort = shortSignal and rsiShortOK

if finalLong and strategy.position_size <= 0
    strategy.close("Short", comment = "Close Short")
    strategy.entry("Long", strategy.long, qty = qtyShares, alert_message = '{"action":"BUY","side":"long","symbol":"{{ticker}}","qty":100,"price":"{{close}}","token":"YOUR_SECRET"}')

if finalShort and strategy.position_size >= 0
    strategy.close("Long", comment = "Close Long")
    strategy.entry("Short", strategy.short, qty = qtyShares, alert_message = '{"action":"SELL_SHORT","side":"short","symbol":"{{ticker}}","qty":100,"price":"{{close}}","token":"YOUR_SECRET"}')

strategy.exit("Long TP/SL", from_entry = "Long", stop = longStop, limit = longTP, alert_message = '{"action":"EXIT_LONG","symbol":"{{ticker}}","qty":100,"price":"{{close}}","token":"YOUR_SECRET"}')
strategy.exit("Short TP/SL", from_entry = "Short", stop = shortStop, limit = shortTP, alert_message = '{"action":"EXIT_SHORT","symbol":"{{ticker}}","qty":100,"price":"{{close}}","token":"YOUR_SECRET"}')

// ══════════════════════════════════════════════════════════════════
// SECTION 14 — ATR RISK GUIDE
// ══════════════════════════════════════════════════════════════════
slATR_vis = input.float(1.2, "Visual Stop ATR", group = G_RISK, step = 0.1)
tpATR_vis = input.float(2.0, "Visual Target ATR", group = G_RISK, step = 0.1)

if finalLong and showLevels
    line.new(bar_index, close - atr * slATR_vis, bar_index + 14, close - atr * slATR_vis, color = color.new(color.red, 0), width = 1)
    line.new(bar_index, close + atr * tpATR_vis, bar_index + 14, close + atr * tpATR_vis, color = color.new(color.lime, 0), width = 1)

if finalShort and showLevels
    line.new(bar_index, close + atr * slATR_vis, bar_index + 14, close + atr * slATR_vis, color = color.new(color.red, 0), width = 1)
    line.new(bar_index, close - atr * tpATR_vis, bar_index + 14, close - atr * tpATR_vis, color = color.new(color.lime, 0), width = 1)

plot(showLevels and strategy.position_size > 0 ? longStop : na, "Long Stop", color.red, 1, plot.style_linebr)
plot(showLevels and strategy.position_size > 0 ? longTP : na, "Long Target", color.green, 1, plot.style_linebr)
plot(showLevels and strategy.position_size < 0 ? shortStop : na, "Short Stop", color.red, 1, plot.style_linebr)
plot(showLevels and strategy.position_size < 0 ? shortTP : na, "Short Target", color.green, 1, plot.style_linebr)

// ══════════════════════════════════════════════════════════════════
// SECTION 15 — WICK EMPHASIS
// ══════════════════════════════════════════════════════════════════
showWick  = input.bool(true, "Show Wick Emphasis", group = G_VIS)
wickWidth = input.int(3, "Wick Width", minval = 1, group = G_VIS, maxval = 5)

if showWick and (bubbleBuyReady or finalLong)
    line.new(bar_index, low, bar_index, high, color = color.new(color.lime, 0), width = wickWidth)

if showWick and (bubbleSellReady or finalShort)
    line.new(bar_index, low, bar_index, high, color = color.new(color.red, 0), width = wickWidth)

// ══════════════════════════════════════════════════════════════════
// SECTION 16 — ALERTS
// ══════════════════════════════════════════════════════════════════
alertcondition(finalLong, "AUTO_BUY", '{"action":"BUY","side":"long","symbol":"{{ticker}}","qty":100,"price":"{{close}}","token":"YOUR_SECRET"}')
alertcondition(finalShort, "AUTO_SELL", '{"action":"SELL_SHORT","side":"short","symbol":"{{ticker}}","qty":100,"price":"{{close}}","token":"YOUR_SECRET"}')

alertcondition(qt_freshBuy, "Q-Trend BUY", "Q-Trend BUY signal")
alertcondition(qt_freshSell, "Q-Trend SELL", "Q-Trend SELL signal")
alertcondition(utBuySignal, "UT Bot BUY", "UT Bot BUY signal")
alertcondition(utSellSignal, "UT Bot SELL", "UT Bot SELL signal")
alertcondition(maBuySignal and sessOK, "DEMA BUY", "DEMA crossover BUY")
alertcondition(maSellSignal and sessOK, "DEMA SELL", "DEMA crossunder SELL")
alertcondition(bubbleBuyReady, "BUY Bubble", "BUY bubble: zone + delta + volume")
alertcondition(bubbleSellReady, "SELL Bubble", "SELL bubble: zone + delta + volume")
alertcondition(finalLong or finalShort, "Any Signal", "Signal fired (scored + confirmed)")

// ══════════════════════════════════════════════════════════════════
// SECTION 17 — MARKET SENTIMENT  (Next-Candle Bias)
// Derived from LuxAlgo Market Sentiment Technicals
// 11-indicator composite score 0–100
//   > 60  = Bullish bias on next candle
//   < 40  = Bearish bias on next candle
//   40-60 = Neutral
// Displayed as a label on the live bar + oscillator in pane.
// Nothing above this line was changed.
// ══════════════════════════════════════════════════════════════════
var string G_SENT = "Market Sentiment (Next-Candle Bias)"

showSentiment = input.bool(true,     "Show Next-Candle Bias Label", group = G_SENT)
sentBullCol   = input.color(#085def, "Bullish Color",               group = G_SENT)
sentBearCol   = input.color(#f10707, "Bearish Color",               group = G_SENT)
sentOscShow   = input.bool(true,     "Show Sentiment Oscillator",   group = G_SENT)
sentOscH      = input.float(3.5,     "Oscillator Height",           group = G_SENT, step = 0.5, minval = 0.5)

// ── helpers ──────────────────────────────────────────────────────
sInterp(_v, _vH, _vL, _rH, _rL) =>
    _rL + (_v - _vL) * (_rH - _rL) / (_vH - _vL)

sNorm(_buy, _sell, _smooth) =>
    var int   _os = 0
    var float _mx = na
    var float _mn = na
    _os := _buy ? 1 : _sell ? -1 : _os
    _mx := _os > _os[1] ? close : _os < _os[1] ? _mx : math.max(close, nz(_mx, close))
    _mn := _os < _os[1] ? close : _os > _os[1] ? _mn : math.min(close, nz(_mn, close))
    _d  = nz(_mx, close) - nz(_mn, close)
    ta.sma(_d != 0.0 ? (close - nz(_mn, close)) / _d : 0.5, _smooth) * 100.0

// ── 1. RSI ───────────────────────────────────────────────────────
_sRsiRaw = ta.rsi(close, 14)
float sRsi = na
if _sRsiRaw > 70
    sRsi := sInterp(_sRsiRaw, 100, 70, 100, 75)
else if _sRsiRaw > 50
    sRsi := sInterp(_sRsiRaw,  70, 50,  75, 50)
else if _sRsiRaw > 30
    sRsi := sInterp(_sRsiRaw,  50, 30,  50, 25)
else
    sRsi := sInterp(_sRsiRaw,  30,  0,  25,  0)

// ── 2. Stochastic %K ─────────────────────────────────────────────
_sStochRaw = ta.sma(ta.stoch(close, high, low, 14), 3)
float sStoch = na
if _sStochRaw > 80
    sStoch := sInterp(_sStochRaw, 100, 80, 100, 75)
else if _sStochRaw > 50
    sStoch := sInterp(_sStochRaw,  80, 50,  75, 50)
else if _sStochRaw > 20
    sStoch := sInterp(_sStochRaw,  50, 20,  50, 25)
else
    sStoch := sInterp(_sStochRaw,  20,  0,  25,  0)

// ── 3. Stochastic RSI ────────────────────────────────────────────
_sSrsiBase = ta.rsi(close, 14)
_sSrsiRaw  = ta.sma(ta.stoch(_sSrsiBase, _sSrsiBase, _sSrsiBase, 14), 3)
float sStochRsi = na
if _sSrsiRaw > 80
    sStochRsi := sInterp(_sSrsiRaw, 100, 80, 100, 75)
else if _sSrsiRaw > 50
    sStochRsi := sInterp(_sSrsiRaw,  80, 50,  75, 50)
else if _sSrsiRaw > 20
    sStochRsi := sInterp(_sSrsiRaw,  50, 20,  50, 25)
else
    sStochRsi := sInterp(_sSrsiRaw,  20,  0,  25,  0)

// ── 4. CCI ───────────────────────────────────────────────────────
_sCciMa  = ta.sma(hlc3, 20)
_sCciRaw = (hlc3 - _sCciMa) / (0.015 * ta.dev(hlc3, 20))
float sCci = na
if _sCciRaw > 300
    sCci := 100.0
else if _sCciRaw > 100
    sCci := sInterp(_sCciRaw,  300,  100, 100, 75)
else if _sCciRaw >= 0
    sCci := sInterp(_sCciRaw,  100,    0,  75, 50)
else if _sCciRaw < -300
    sCci := 0.0
else if _sCciRaw < -100
    sCci := sInterp(_sCciRaw, -100, -300,  25,  0)
else
    sCci := sInterp(_sCciRaw,    0, -100,  50, 25)

// ── 5. Bull Bear Power ───────────────────────────────────────────
_sBbpRaw = high + low - 2.0 * ta.ema(close, 13)
[_sBbpB, _sBbpU, _sBbpL] = ta.bb(_sBbpRaw, 100, 2)
float sBbp = na
if _sBbpRaw > 1.5 * _sBbpU
    sBbp := 100.0
else if _sBbpRaw > _sBbpU
    sBbp := sInterp(_sBbpRaw, 1.5 * _sBbpU, _sBbpU, 100, 75)
else if _sBbpRaw > 0
    sBbp := sInterp(_sBbpRaw, _sBbpU, 0, 75, 50)
else if _sBbpRaw < 1.5 * _sBbpL
    sBbp := 0.0
else if _sBbpRaw < _sBbpL
    sBbp := sInterp(_sBbpRaw, _sBbpL, 1.5 * _sBbpL, 25, 0)
else
    sBbp := sInterp(_sBbpRaw, 0, _sBbpL, 50, 25)

// ── 6. MA position (SMA 20, normalized) ─────────────────────────
sMa = sNorm(close > ta.sma(close, 20), close < ta.sma(close, 20), 3)

// ── 7. VWAP bands (reuse session cumPV / cumV from Section 7) ────
_sVwapSD = ta.stdev(close, 20)
_sVwapU  = (cumV > 0 ? cumPV / cumV : close) + 2.0 * _sVwapSD
_sVwapLo = (cumV > 0 ? cumPV / cumV : close) - 2.0 * _sVwapSD
sVwap    = sNorm(close > _sVwapU, close < _sVwapLo, 3)

// ── 8. Bollinger Bands (normalized) ──────────────────────────────
_sBbBase = ta.sma(close, 20)
_sBbDev  = 2.0 * ta.stdev(close, 20)
sBb      = sNorm(close > _sBbBase + _sBbDev, close < _sBbBase - _sBbDev, 3)

// ── 9. Supertrend (factor 3, period 10) ──────────────────────────
[_sStLine, _sStDir] = ta.supertrend(3.0, 10)
sSt = sNorm(close > _sStLine, close < _sStLine, 3)

// ── 10. Linear Regression correlation ────────────────────────────
sReg = 50.0 * ta.correlation(close, bar_index, 25) + 50.0

// ── 11. Market Structure (pivot-based, normalized) ────────────────
var float _sPhY = na
var float _sPlY = na
var bool  _sPhX = false
var bool  _sPlX = false
_sMsBull = false
_sMsBear = false
_sMsPh   = ta.pivothigh(5, 5)
_sMsPl   = ta.pivotlow(5, 5)
if not na(_sMsPh)
    _sPhY := _sMsPh
    _sPhX := false
if not na(_sMsPl)
    _sPlY := _sMsPl
    _sPlX := false
if close > nz(_sPhY, close) and not _sPhX
    _sPhX    := true
    _sMsBull := true
if close < nz(_sPlY, close) and not _sPlX
    _sPlX    := true
    _sMsBear := true
sMs = sNorm(_sMsBull, _sMsBear, 3)

// ── Composite score ───────────────────────────────────────────────
sentiment    = math.avg(sRsi, sStoch, sStochRsi, sCci, sBbp, sMa, nz(sVwap, 50), sBb, sSt, sReg, sMs)
sentIsBull   = sentiment > 60.0
sentIsBear   = sentiment < 40.0

// ── Next-candle label (last bar only) ────────────────────────────
_sentArrow = sentIsBull ? "▲" : sentIsBear ? "▼" : "●"
_sentWord  = sentIsBull ? "BULLISH" : sentIsBear ? "BEARISH" : "NEUTRAL"
_sentPct   = str.tostring(math.round(sentiment)) + "%"
_sentCol   = sentIsBull ? sentBullCol : sentIsBear ? sentBearCol : color.gray

var label sentLabel = na
if barstate.islast and showSentiment
    label.delete(sentLabel)
    sentLabel := label.new(
         bar_index + 2,
         high + atr * 1.8,
         "NEXT CANDLE BIAS\n" + _sentArrow + " " + _sentWord + "  " + _sentPct,
         style     = label.style_label_down,
         color     = color.new(_sentCol, 10),
         textcolor = color.white,
         size      = size.normal)

// ── Sentiment oscillator (separate pane) ─────────────────────────
sentOscVal  = sentOscShow ? sentOscH * sentiment / 100.0 : na
sentOscMid  = sentOscShow ? sentOscH * 0.5 : na

sentOscPlot = plot(sentOscVal, "Sentiment Oscillator",
     color.from_gradient(sentiment, 0, 100, sentBearCol, sentBullCol), 2,
     display = display.pane)
sentMidPlot = plot(sentOscMid, "Sentiment Mid",
     color.new(color.gray, 63), 1,
     display = display.pane)

fill(sentOscPlot, sentMidPlot,
     sentOscH * 1.0, sentOscH * 0.5,
     top_color    = color.new(sentBullCol,   0),
     bottom_color = color.new(sentBullCol, 100),
     title = "Sentiment Bull Fill")
fill(sentOscPlot, sentMidPlot,
     sentOscH * 0.5, 0.0,
     top_color    = color.new(sentBearCol, 100),
     bottom_color = color.new(sentBearCol,   0),
     title = "Sentiment Bear Fill")

// ── Sentiment alerts ──────────────────────────────────────────────
alertcondition(sentIsBull, "Sentiment BULLISH", "Market Sentiment > 60 — bullish next candle bias")
alertcondition(sentIsBear, "Sentiment BEARISH", "Market Sentiment < 40 — bearish next candle bias")
