//@version=6

strategy("GOLD EDGE FUND v3 (MTF + SMC + Risk Engine)", overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=1)

// ===================== //
// === TIME FILTER === //
// ===================== //
// London + NY killzones (UTC)
london = (hour >= 7 and hour <= 10)
newyork = (hour >= 13 and hour <= 16)
sessionOK = london or newyork


// ===================== //
// === HIGHER TF BIAS === //
// ===================== //
htfClose = request.security(syminfo.tickerid, "15", close)
htfEMA50 = request.security(syminfo.tickerid, "15", ta.ema(close, 50))
htfEMA200 = request.security(syminfo.tickerid, "15", ta.ema(close, 200))

htfBull = htfClose > htfEMA50 and htfEMA50 > htfEMA200
htfBear = htfClose < htfEMA50 and htfEMA50 < htfEMA200

// ===================== //
// === LOCAL TREND === //
// ===================== //
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)

trendUp = close > ema20 and ema20 > ema50
trendDown = close < ema20 and ema20 < ema50

// ===================== //
// === FVG (IMBALANCE) === //
// ===================== //
bullFVG = low > high[2]
bearFVG = high < low[2]

// ===================== //
// === ORDER BLOCK (REFINED) === //
// ===================== //
bullOB = close > high[1] and open[1] > close[1]
bearOB = close < low[1] and open[1] < close[1]

// ===================== //
// === LIQUIDITY SWEEP === //
// ===================== //
lookback = input.int(10, "Liquidity Lookback")

liqHigh = ta.highest(high, lookback)
liqLow = ta.lowest(low, lookback)

sweepHigh = high > liqHigh[1] and close < liqHigh
sweepLow = low < liqLow[1] and close > liqLow

// ===================== //
// === MOMENTUM FILTER === //
// ===================== //
rsi = ta.rsi(close, 14)

momentumBuy = rsi > 55
momentumSell = rsi < 45

// ===================== //
// === ENTRY LOGIC === //
// ===================== //
// Must align HTF + LTF + SMC
longCond =
     sessionOK and
     htfBull and
     trendUp and
     (sweepLow or bullFVG or bullOB) and
     momentumBuy

shortCond =
     sessionOK and
     htfBear and
     trendDown and
     (sweepHigh or bearFVG or bearOB) and
     momentumSell

// ===================== //
// === RISK ENGINE === //
// ===================== //
atr = ta.atr(14)

// Adaptive stop (volatility aware)
riskATR = input.float(1.3, "ATR Risk Mult")

longSL = close - atr * riskATR
shortSL = close + atr * riskATR

rr = input.float(1.6, "Risk Reward")

longTP = close + atr * riskATR * rr
shortTP = close - atr * riskATR * rr

// ===================== //
// === EXECUTION === //
// ===================== //
if (longCond)
    strategy.entry("BUY", strategy.long)

if (shortCond)
    strategy.entry("SELL", strategy.short)

strategy.exit("EXIT BUY", from_entry="BUY", stop=longSL, limit=longTP)
strategy.exit("EXIT SELL", from_entry="SELL", stop=shortSL, limit=shortTP)

// ===================== //
// === BREAK EVEN === //
// ===================== //
beATR = atr * 0.8

if (strategy.position_size > 0 and close > strategy.position_avg_price + beATR)
    strategy.exit("BE BUY", from_entry="BUY", stop=strategy.position_avg_price)

if (strategy.position_size < 0 and close < strategy.position_avg_price - beATR)
    strategy.exit("BE SELL", from_entry="SELL", stop=strategy.position_avg_price)

// ===================== //
// === TRAILING STOP === //
// ===================== //
trailATR = atr * 1.0

if (strategy.position_size > 0)
    strategy.exit("TRAIL BUY", from_entry="BUY", stop=close - trailATR)

if (strategy.position_size < 0)
    strategy.exit("TRAIL SELL", from_entry="SELL", stop=close + trailATR)

// ===================== //
// === DAILY LOSS LIMIT === //
// ===================== //
maxDailyLoss = input.float(3.0, "Max Daily Loss %")

var float dayStartEquity = na
if (dayofmonth != dayofmonth[1])
    dayStartEquity := strategy.equity

drawdown = 100 * (strategy.equity - dayStartEquity) / dayStartEquity

if (drawdown <= -maxDailyLoss)
    strategy.close_all()

// ===================== //
// === TRADE LIMIT CONTROL === //
// ===================== //
maxTrades = input.int(7, "Max Trades Per Day")

var int tradesToday = 0
if (dayofmonth != dayofmonth[1])
    tradesToday := 0

if (strategy.opentrades > strategy.opentrades[1])
    tradesToday += 1

allowTrade = tradesToday < maxTrades

// Apply trade limiter
if (not allowTrade)
    strategy.cancel_all()

// ===================== //
// === VISUALS === //
// ===================== //
plot(ema20, color=color.blue)
plot(ema50, color=color.red)