//@version=5 
strategy("Volatility Gaussian Bands+AlphaTrend+ST+Cycle KP ",
     shorttitle="Volatility + Trend + cycle + Gaussian",
     overlay = true, max_labels_count = 500,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100)

// ==================== HURST CYCLE CHANNEL CLONE (with overlay bands) ====================
// Inputs
scl_t =  input.int(10,  title="Short Cycle Length?")
mcl_t =  input.int(30,  title="Medium Cycle Length?")
scm    =  input.float(1.0, title="Short Cycle Multiplier?")
mcm    =  input.float(3.0, title="Medium Cycle Multiplier?")
src    =  input.source(close, title="Source")
ebc    =  input.bool(false, title="Enable bar colors")

// --- NEW: entry offsets from mcb / mct ---
entryFromMcbPts = input.float(10.0, "Entry Offset from mcb (pts)", step=0.1)
entryFromMctPts = input.float(10.0, "Entry Offset from mct (pts)", step=0.1)

// Core calcs (same logic as your original)
scl   = scl_t / 2.0
mcl   = mcl_t / 2.0

ma_scl = ta.rma(src, math.max(1, int(scl)))
ma_mcl = ta.rma(src, math.max(1, int(mcl)))

scm_off = scm * ta.atr(math.max(1, int(scl)))
mcm_off = mcm * ta.atr(math.max(1, int(mcl)))

scl_2 = scl / 2.0
mcl_2 = mcl / 2.0

sct = nz(ma_scl[int(scl_2)], src) + scm_off   // short-cycle top (price)
scb = nz(ma_scl[int(scl_2)], src) - scm_off   // short-cycle bottom (price)
mct = nz(ma_mcl[int(mcl_2)], src) + mcm_off   // medium-cycle top (price)
mcb = nz(ma_mcl[int(mcl_2)], src) - mcm_off   // medium-cycle bottom (price)

scmm = (sct + scb) / 2.0                      // short band mid

// oscillator domain 0–1
omed   = (scmm - mcb) / (mct - mcb)
oshort = (src   - mcb) / (mct - mcb)

// === NEW ENTRY LINES based on mct / mcb ===
long_entry_line  = not na(mct) ? mct + entryFromMcbPts : na   // for longs
short_entry_line = not na(mcb) ? mcb - entryFromMctPts : na   // for shorts

// === show Hurst as price bands on chart ===
p_hurst_sct = plot(sct, title="Hurst Short Top",    color=color.new(color.teal, 0),  linewidth=1)
p_hurst_scb = plot(scb, title="Hurst Short Bottom", color=color.new(color.teal, 70), linewidth=1)
fill(p_hurst_sct, p_hurst_scb, color=color.new(color.teal, 90), title="Hurst Short Fill")

p_hurst_mct = plot(mct, title="Hurst Medium Top",    color=color.new(color.orange, 0),  linewidth=1)
p_hurst_mcb = plot(mcb, title="Hurst Medium Bottom", color=color.new(color.orange, 70), linewidth=1)
fill(p_hurst_mct, p_hurst_mcb, color=color.new(color.orange, 90), title="Hurst Medium Fill")

plot(scmm, title="Hurst Midline", color=color.new(color.fuchsia, 0), linewidth=1, style=plot.style_linebr)

// --- plot entry lines (like SL style) ---
plot(long_entry_line,  title="Hurst Long Entry (mcb + pts)",  color=color.new(color.green, 0), style=plot.style_linebr, linewidth=1)
plot(short_entry_line, title="Hurst Short Entry (mct - pts)", color=color.new(color.red,   0), style=plot.style_linebr, linewidth=1)

// === oscillator drawing (kept) ===
ul = plot(1.0,  title="UpperLine (Osc)", color=color.gray)
ml = plot(0.5,  title="MidLine (Osc)",   color=color.gray)
ll = plot(0.0,  title="LowerLine (Osc)", color=color.gray)

// your slow osc
plot(omed,   color=color.green, linewidth=2, title="SlowOsc")

bc = (oshort > 0.5)
     ? (oshort > 1.0 ? color.purple : (oshort > omed ? color.lime : color.green))
     : (oshort < 0    ? color.purple : (oshort < omed ? color.red : color.orange))
barcolor(ebc ? bc : na)

// ==================== SUPER TREND (your part) ====================
grp1 = "Supertrend 1"
atrLen1 = input.int(10,  "ATR Period (ST1)", minval=1, group=grp1)
mult1   = input.float(2, "Factor (ST1)",     minval=0.1, step=0.1, group=grp1)

grp2 = "Supertrend 2"
atrLen2 = input.int(14,  "ATR Period (ST2)", minval=1, group=grp2)
mult2   = input.float(3, "Factor (ST2)",     minval=0.1, step=0.1, group=grp2)

allowShorts = input.bool(true, "Allow Shorts")
// Renko-related inputs
renkoBox    = input.float(10.0, "Renko Box Size (points)", step=0.1, minval=0.0001)
slBricks    = input.float(1.0,  "SL in Renko bricks (can be decimal/negative)", step=0.1, minval=-1000.0)

// convert bricks → price points
sllPts = renkoBox * slBricks

// ST1
atr1   = ta.atr(atrLen1)
upB1   = hl2 - mult1 * atr1
dnB1   = hl2 + mult1 * atr1

var float upT1 = na
var float dnT1 = na
if na(upT1) and not na(atr1)
    upT1 := upB1
if na(dnT1) and not na(atr1)
    dnT1 := dnB1

ready1 = not na(atr1) and not na(upT1) and not na(dnT1)
upPrev1 = ready1 ? nz(upT1[1], upT1) : upB1
dnPrev1 = ready1 ? nz(dnT1[1], dnT1) : dnB1

baseUp1   = close[1] > upPrev1 ? math.max(upB1, upPrev1) : upB1
baseDown1 = close[1] < dnPrev1 ? math.min(dnB1, dnPrev1) : dnB1

if ready1
    upT1 := baseUp1
    dnT1 := baseDown1

var int dir1 = 1
dir1 := ready1 and close > nz(dnT1[1], dnB1) ?  1 : ready1 and close < nz(upT1[1], upB1) ? -1 : nz(dir1[1], 1)

st1 = dir1 == 1 ? upT1 : dnT1

// Renko-sized TSL levels
longSL  = st1 - sllPts
shortSL = st1 + sllPts

// ST2
atr2   = ta.atr(atrLen2)
upB2   = hl2 - mult2 * atr2
dnB2   = hl2 + mult2 * atr2

var float upT2 = na
var float dnT2 = na
if na(upT2) and not na(atr2)
    upT2 := upB2
if na(dnT2) and not na(atr2)
    dnT2 := dnB2

ready2 = not na(atr2) and not na(upT2) and not na(dnT2)
upPrev2 = ready2 ? nz(upT2[1], upT2) : upB2
dnPrev2 = ready2 ? nz(dnT2[1], dnT2) : dnB2

baseUp2   = close[1] > upPrev2 ? math.max(upB2, upPrev2) : upB2
baseDown2 = close[1] < dnPrev2 ? math.min(dnB2, dnPrev2) : dnB2

if ready2
    upT2 := baseUp2
    dnT2 := baseDown2

var int dir2 = 1
dir2 := ready2 and close > nz(dnT2[1], dnB2) ?  1 : ready2 and close < nz(upT2[1], upB2) ? -1 : nz(dir2[1], 1)

st2 = dir2 == 1 ? upT2 : dnT2

inLong  = strategy.position_size > 0
inShort = strategy.position_size < 0

plot(st1, "Supertrend 1", color = dir1==1 ? color.new(color.green, 0) : color.new(color.red, 0), linewidth=2)
plot(inLong ? longSL : na,   "Long SL (Renko)",   color=color.new(color.red, 0),  style=plot.style_linebr)
plot(inShort ? shortSL : na, "Short SL (Renko)",  color=color.new(color.red, 0),  style=plot.style_linebr)

// signals
bothBull = (dir1 == 1) and (dir2 == 1)
bothBear = (dir1 == -1) and (dir2 == -1)

exitLongCond  = close >= longSL
exitShortCond = close >= shortSL

alertcondition(bothBull,      "Both Green (Entry Long)",  "Both Supertrends are GREEN.")
alertcondition(bothBear,      "Both Red (Entry Short)",   "Both Supertrends are RED.")
alertcondition(exitLongCond,  "Exit Long (Price < ST1)",  "Price dropped below Supertrend 1.")
alertcondition(exitShortCond, "Exit Short (Price > ST1)", "Price rose above Supertrend 1.")

// ==================== ALPHATREND (your part) ====================
coeff = input.float(1, 'Multiplier', step=0.1)
AP = input(14, 'Common Period')
ATR = ta.sma(ta.tr, AP)
src1 = input(close)
showsignalsk = input.bool(title='Show Signals?', defval=false)
novolumedata = input.bool(title='Change calculation (no volume data)?', defval=false)
upT = low - ATR * coeff
downT = high + ATR * coeff
AlphaTrend = 0.0
AlphaTrend := (novolumedata ? ta.rsi(src1, AP) >= 50 : ta.mfi(hlc3, AP) >= 50) ? (upT < nz(AlphaTrend[1]) ? nz(AlphaTrend[1]) : upT) : (downT > nz(AlphaTrend[1]) ? nz(AlphaTrend[1]) : downT)

// Exit AlphaTrend
coeff_exit = input.float(1.2, 'Buy Exit Multiplier', step=0.1)
AP_exit   = input.int(14, 'Buy Exit Period')
exit_offset_points = input.float(0.0, 'Buy Exit Offset (points)', step=0.1)

ATR_exit   = ta.sma(ta.tr, AP_exit)
upT_exit   = low - ATR_exit * coeff_exit
downT_exit = high + ATR_exit * coeff_exit

AlphaTrendExit = 0.0
AlphaTrendExit := (novolumedata ? ta.rsi(src1, AP_exit) >= 50 : ta.mfi(hlc3, AP_exit) >= 50) ? (upT_exit < nz(AlphaTrendExit[1]) ? nz(AlphaTrendExit[1]) : upT_exit) : (downT_exit > nz(AlphaTrendExit[1]) ? nz(AlphaTrendExit[1]) : downT_exit)

AlphaTrendExitShift = AlphaTrendExit + exit_offset_points

// ==================== GAUSSIAN / MULTI-TF PART (your original structure) ====================
// (kept inputs, many are unused in current entry logic)
drawchannel = input(true, title='Draw Channel')
displayline = input(true, title='Display Line Extension')
zonetransp = input.int(60, title='Zone Transparency', minval=0, maxval=100)

enable_mtf = input(true, title='Enable Multiple TimeFrame Analysis')
mtf_disp_typ = input.string('On Hover', title='MTF Display Type', options=['Always Display', 'On Hover'])
mtf_typ = input.string('Auto', title='Multiple TimeFrame Type', options=['Auto', 'Custom'])
mtf_lvl1 = input.timeframe('D', title='Custom MTF Level 1')
mtf_lvl2 = input.timeframe('W', title='Custom MTF Level 2')

renko_multiplier = input.float(1.0, title='Renko Bar Multiplier', minval=0.1, maxval=5.0, step=0.1)
use_auto_renko = input(true, title='Auto-detect Renko Bar Size')
manual_renko_size = input.float(0.01, title='Manual Renko Bar Size', minval=0.0001, step=0.0001)

len = input.int(20, "Length", minval = 5)
mode = input.string("AVG", "Type", ["AVG", "MEADIAN", "MODE"])
distance = input.float(1, step = 0.1)
show_retest = input.bool(false, "Retest Signals")

// Strategy Settings (accept negatives)
sl_points = input.float(-50, "Stop Loss (points)", step = 0.1)
tp_points = input.float(-100, "Take Profit (points)", step = 0.1)
hard_sl_points = input.float(0.0, "Hard Stoploss (points from entry)", step=0.1, tooltip="Protective stop based on distance from entry price; set > 0 to enable.")

// normalize
sl_pts = math.abs(sl_points)
tp_pts = math.abs(tp_points)
hard_sl_pts = math.abs(hard_sl_points)

// simple triggers from oscillator
//long_trigger  = oshort > 1.0
//short_trigger = oshort < 0.0

// ==================== STRATEGY LOGIC ====================
var string last_closed_position = "none"
var bool can_open_long = true
var bool can_open_short = true

// detect position closure
previous_position_size = strategy.position_size[1]
current_position_size  = strategy.position_size
if previous_position_size != 0 and current_position_size == 0
    if previous_position_size > 0
        last_closed_position := "long"
    else
        last_closed_position := "short"

// always allow after close (your current behaviour)
can_open_long  := true
can_open_short := true

// base conditions from your signals
//basic_long_condition  = long_trigger
//basic_short_condition = short_trigger

// NEW: require price to cross our entry lines
cross_long_entry  = not na(long_entry_line)  and ta.crossover(close, long_entry_line)
cross_short_entry = not na(short_entry_line) and ta.crossunder(close, short_entry_line)

// final entry conditions
longCondition  = cross_long_entry  and strategy.position_size <= 0 and can_open_long
shortCondition = cross_short_entry and strategy.position_size >= 0 and can_open_short

// exits from ST-based SL
exitBuyCondition  = ta.crossunder(close, longSL)
exitSellCondition = ta.crossover(close, shortSL)

// execute trades
if longCondition
    strategy.close("Short")
    strategy.entry("Long", strategy.long)
    label.new(bar_index, low, "BUY\n@" + str.tostring(close, "#.##"), color=color.green, textcolor=color.white, style=label.style_label_up, size=size.small)

if shortCondition
    strategy.close("Long")
    strategy.entry("Short", strategy.short)
    label.new(bar_index, high, "SELL\n@" + str.tostring(close, "#.##"), color=color.red, textcolor=color.white, style=label.style_label_down, size=size.small)

// exit management
if strategy.position_size > 0
    if exitBuyCondition
        strategy.close("Long", comment="AT+|TP| Exit")

if strategy.position_size < 0
    if exitSellCondition
        strategy.close("Short", comment="AT-|SL| Exit")

// ==================== CRAWLING HARD STOPLOSS (FROM ORDER, LIKE WORKING SCRIPT) ====================
// Re-uses your proven logic from "KP Hurst Cycle + Crawling Hard SL"

// track extremes since entry
var float highestSinceEntry = na
var float lowestSinceEntry  = na

// You already defined:
// inLong  = strategy.position_size > 0
// inShort = strategy.position_size < 0
// previous_position_size = strategy.position_size[1]

// detect fresh entries (from flat or opposite side)
justEnteredLong  = inLong  and previous_position_size <= 0
justEnteredShort = inShort and previous_position_size >= 0

// on new long, reset highest
if justEnteredLong
    highestSinceEntry := high

// on new short, reset lowest
if justEnteredShort
    lowestSinceEntry := low

// keep updating extremes while in position
if inLong
    highestSinceEntry := na(highestSinceEntry) ? high : math.max(highestSinceEntry, high)

if inShort
    lowestSinceEntry := na(lowestSinceEntry) ? low : math.min(lowestSinceEntry, low)

// build trailing SL (only if hard_sl_pts > 0)
longTrailSL  = inLong  and hard_sl_pts > 0 ? highestSinceEntry - hard_sl_pts : na
shortTrailSL = inShort and hard_sl_pts > 0 ? lowestSinceEntry  + hard_sl_pts : na

// apply exits (separate from your Renko / ST exits)
if inLong and not na(longTrailSL)
    strategy.exit("Long Hard SL", from_entry="Long", stop=longTrailSL, comment="HARD SL")

if inShort and not na(shortTrailSL)
    strategy.exit("Short Hard SL", from_entry="Short", stop=shortTrailSL, comment="HARD SL")

// plot the trailing hard SL lines (start from order bar, crawl with trend)
plot(longTrailSL,  title="Long HARD SL (Crawling)",  color=color.new(color.fuchsia, 0), linewidth=1, style=plot.style_linebr)
plot(shortTrailSL, title="Short HARD SL (Crawling)", color=color.new(color.fuchsia, 0), linewidth=1, style=plot.style_linebr)
