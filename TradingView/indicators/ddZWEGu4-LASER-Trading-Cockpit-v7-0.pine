bool showRthVwap1m = input.bool(false, "Show RTH VWAP on 1-minute", group = G_VWAP)
bool showRthVwap5m = input.bool(false, "Show RTH VWAP on 5-minute", group = G_VWAP)
string rthVwapSession = input.session("0830-1500", "NYSE RTH Session", group = G_VWAP)
string sessionTimezone = input.string("America/Chicago", "Session Time Zone", group = G_VWAP)

bool showVwapSdBands = input.bool(true, "Show futures VWAP standard deviation bands", group = G_VWAPSD)
