//@version=6
indicator("Watchlist NY 15m Opening Range Breakout - Trading Trio", overlay=true)

nySession = input.session("0930-0945", title="NY 15m Session Window")

// --- CORE BREAKOUT LOGIC FUNCTION ---
checkBreakout() =>
    var float nyHigh = na
    var float nyLow  = na
    var float stableHigh = na
    var float stableLow  = na
    var bool highBroken = false
    var bool lowBroken = false
    
    inSession = not na(time("1", nySession, "America/New_York"))
    
    sessionStart = inSession and not inSession
    sessionEnd = not inSession and inSession
    
    if sessionStart
        nyHigh := high
        nyLow  := low
        highBroken := false
        lowBroken := false
    else if inSession
        nyHigh := math.max(nyHigh, high)
        nyLow  := math.min(nyLow, low)
        
    if sessionEnd
        stableHigh := nyHigh
        stableLow := nyLow
        
    if sessionStart
        highBroken := false
        lowBroken := false
        
    breakUp   = not inSession and not na(stableHigh) and not highBroken and close > stableHigh
    breakDown = not inSession and not na(stableLow) and not lowBroken and close < stableLow
    
    if breakUp
        highBroken := true
    if breakDown
        lowBroken := true
        
    [breakUp, breakDown]

// --- SECURITY DATA REQUESTS FOR ALL 27 TICKERS ---
[t1Up, t1Down]   = request.security("QQQ", timeframe.period, checkBreakout())
[t2Up, t2Down]   = request.security("SPY", timeframe.period, checkBreakout())
[t3Up, t3Down]   = request.security("AMD", timeframe.period, checkBreakout())
