//@version=6
indicator("Penroute Swing Finder 3A", overlay = true, max_lines_count = 500, max_labels_count = 500)

swingLen = input.int(10,    "Swing strength (bars each side)")
minProm  = input.float(1.0, "Min swing size (x ATR)", step = 0.1)
dedupe   = input.float(0.5, "Merge levels closer than (x ATR)", step = 0.1)
minAgeD  = input.float(0.5, "Min age (days)", step = 0.5)
maxAgeD  = input.float(8.0, "Max age (days)", step = 0.5)
extTol   = input.float(0.25,"Extreme tolerance (x ATR)", step = 0.05)
maxShow  = input.int(6,     "Max swings shown")

atrV = ta.atr(14)

dEma = request.security(syminfo.tickerid, "D", ta.ema(close, 50), lookahead = barmerge.lookahead_off)
wH   = request.security(syminfo.tickerid, "W", high[1], lookahead = barmerge.lookahead_off)
wL   = request.security(syminfo.tickerid, "W", low[1],  lookahead = barmerge.lookahead_off)
mH   = request.security(syminfo.tickerid, "M", high[1], lookahead = barmerge.lookahead_off)
mL   = request.security(syminfo.tickerid, "M", low[1],  lookahead = barmerge.lookahead_off)
upTrend = close > dEma

var array<float> sPrice = array.new_float()
var array<int>   sBar   = array.new_int()
var array<bool>  sHigh  = array.new_bool()

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low,  swingLen, swingLen)

if not na(ph)
    base = ta.lowest(low, swingLen * 2 + 1)
    if ph - base >= atrV * minProm
        array.push(sPrice, ph)
        array.push(sBar,   bar_index - swingLen)
        array.push(sHigh,  true)

if not na(pl)
    top = ta.highest(high, swingLen * 2 + 1)
    if top - pl >= atrV * minProm
        array.push(sPrice, pl)
        array.push(sBar,   bar_index - swingLen)
        array.push(sHigh,  false)

if array.size(sPrice) > 120
    array.shift(sPrice)
    array.shift(sBar)
    array.shift(sHigh)

// unmitigated = price has not traded through the swing since it formed
f_unmitigated(_p, _b, _isHigh) =>
    n   = bar_index - _b
    hit = false
    if n > 0
        for i = 0 to math.min(n - 1, 4999)
            if _isHigh and high[i] > _p
                hit := true
                break
            if not _isHigh and low[i] < _p
                hit := true
                break
    not hit

var array<line>  lns = array.new_line()
var array<label> lbs = array.new_label()

if barstate.islast
    if array.size(lns) > 0
        for i = 0 to array.size(lns) - 1
            line.delete(array.get(lns, i))
        array.clear(lns)
    if array.size(lbs) > 0
        for i = 0 to array.size(lbs) - 1
            label.delete(array.get(lbs, i))
        array.clear(lbs)

    barMs = timeframe.in_seconds() * 1000
    shown = 0
    drawn = array.new_float()

    if array.size(sPrice) > 0
        for i = array.size(sPrice) - 1 to 0
            if shown < maxShow
                p      = array.get(sPrice, i)
                b      = array.get(sBar,   i)
                isHigh = array.get(sHigh,  i)
                ageD   = (bar_index - b) * barMs / 86400000.0

                if ageD >= minAgeD and ageD <= maxAgeD and f_unmitigated(p, b, isHigh)
                    dup = false
                    if array.size(drawn) > 0
                        for j = 0 to array.size(drawn) - 1
                            if math.abs(p - array.get(drawn, j)) < atrV * dedupe
                                dup := true
                                break

                    if not dup
                        withT = isHigh ? not upTrend : upTrend
                        dExt  = math.min(math.min(math.abs(p - wH), math.abs(p - wL)), math.min(math.abs(p - mH), math.abs(p - mL)))
                        ext   = dExt < atrV * extTol

                        s   = 2 + (withT ? 1 : 0) - (ext ? 2 : 0)
                        col = ext ? #A32E2E : s >= 3 ? #96660D : color.gray

                        ln = line.new(b, p, bar_index, p, color = color.new(col, 25), width = ext ? 1 : 2, style = ext ? line.style_dotted : line.style_solid)
                        array.push(lns, ln)

                        txt = "3A " + str.tostring(s) + "   " + (isHigh ? "swing high" : "swing low") + "  " + str.tostring(ageD, "#.#") + "d  unmitigated" + (withT ? "  with-trend" : "  counter") + (ext ? "   OBVIOUS EXTREME -2" : "")
                        lbx = label.new(bar_index, p, txt, style = isHigh ? label.style_label_lower_right : label.style_label_upper_right, color = color.new(col, 82), textcolor = col, size = size.small)
                        array.push(lbs, lbx)

                        array.push(drawn, p)
                        shown += 1

plot(dEma, "Daily 50 EMA", color = color.new(color.gray, 55))