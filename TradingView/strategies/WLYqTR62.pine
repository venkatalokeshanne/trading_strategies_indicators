// ============================================================
//  Price Action Pro 5M – Bitget Futures
//  FINAL v3 | by Daniel
//  ✅ Mehr Trades durch kleinere Pivot-Lookbacks
//  ✅ Pivot SL/TP – echte Marktlevels
//  ✅ Nur 1 Trade gleichzeitig
//  ✅ Bitget Futures-Signal-Bot | USDT-M | One-Way
//  ✅ FIX: TP1/TP2 Ausführung via strategy.exit()
// ============================================================

//@version=6
strategy(title = 'Price Action Pro 5M | Daniel', shorttitle = 'PA-Pro-5M', overlay = true, pyramiding = 0, initial_capital = 1000, default_qty_type = strategy.cash, default_qty_value = 100, commission_type = strategy.commission.percent, commission_value = 0.05, slippage = 2, process_orders_on_close = false)

// ══════════════════════════════════════════════════════════════
// ▶ INPUTS
// ══════════════════════════════════════════════════════════════

grp_sr = '🧱 Support & Resistance'
sr_left = input.int(4, 'Pivot Lookback Links', minval = 2, group = grp_sr)
sr_right = input.int(1, 'Pivot Bestätigung', minval = 1, group = grp_sr)
sr_zone_pct = input.float(0.3, 'Zone Toleranz %', minval = 0.05, step = 0.05, group = grp_sr)

grp_ema = '📈 Trend Filter (EMA)'
use_ema = input.bool(true, 'EMA Trendfilter aktiv', group = grp_ema)
ema_fast_len = input.int(21, 'EMA Fast', minval = 5, group = grp_ema)
ema_slow_len = input.int(50, 'EMA Slow', minval = 10, group = grp_ema)
ema_min_dist = input.float(0.03, 'Min. EMA Abstand %', minval = 0.01, step = 0.01, group = grp_ema)

grp_rsi = '📉 RSI Filter'
use_rsi = input.bool(false, 'RSI Filter aktiv', group = grp_rsi)
rsi_len = input.int(14, 'RSI Periode', minval = 2, group = grp_rsi)
rsi_ob = input.int(75, 'RSI Überkauft', minval = 60, group = grp_rsi)
rsi_os = input.int(25, 'RSI Überverkauft', maxval = 45, group = grp_rsi)

grp_cs = '🕯️ Candlestick Muster'
use_engulfing = input.bool(true, 'Engulfing aktivieren', group = grp_cs)
use_pinbar = input.bool(true, 'Pin Bar aktivieren', group = grp_cs)
use_breakout = input.bool(true, 'Breakout aktivieren', group = grp_cs)
pinbar_ratio = input.float(1.8, 'Pin Bar Docht-Ratio', minval = 1.0, step = 0.1, group = grp_cs)
engulf_min_pct = input.float(90.0, 'Engulfing Mindest %', minval = 50, step = 10, group = grp_cs)

grp_vwap = '💧 VWAP'
use_vwap = input.bool(true, 'VWAP Filter aktivieren', group = grp_vwap)

grp_vol = '📊 Volumen'
use_vol = input.bool(true, 'Volumen Filter aktivieren', group = grp_vol)
vol_len = input.int(10, 'Volumen MA Periode', minval = 5, group = grp_vol)
vol_thresh = input.float(1.3, 'Mindest-Volumen (x MA)', minval = 0.5, step = 0.1, group = grp_vol)

grp_strength = '💪 Stärke Filter'
use_strength_filter = input.bool(true, 'Stärke-Filter aktivieren', group = grp_strength)
min_atr_mult = input.float(0.5, 'Mindest-Bewegung (x ATR)', minval = 0.1, step = 0.1, group = grp_strength)
vol_spike_mult = input.float(1.5, 'Volumen Spike (x MA)', minval = 1.0, step = 0.1, group = grp_strength)
min_body_pct = input.float(30.0, 'Mindest Kerzenkörper %', minval = 10, step = 5, group = grp_strength)
use_confirm_candle = input.bool(false, 'Bestätigungskerze', group = grp_strength)

grp_rm = '⚙️ Risk Management'
atr_len = input.int(14, 'ATR Periode', group = grp_rm)
use_pivot_sl = input.bool(true, 'Pivot SL/TP aktiv', group = grp_rm)
sl_buffer_pct = input.float(0.1, 'SL Puffer %', minval = 0.0, step = 0.05, group = grp_rm)
atr_sl_mult = input.float(1.5, 'ATR SL (Fallback)', minval = 0.5, step = 0.1, group = grp_rm)
atr_tp1_mult = input.float(2.0, 'ATR TP1 Multiplikator', minval = 0.5, step = 0.1, group = grp_rm)
atr_tp2_mult = input.float(4.0, 'ATR TP2 Multiplikator', minval = 1.0, step = 0.1, group = grp_rm)
tp1_qty = input.float(50.0, 'TP1 Schließen %', minval = 1, step = 1, group = grp_rm)

// ══════════════════════════════════════════════════════════════
// ▶ SUPPORT & RESISTANCE
// ══════════════════════════════════════════════════════════════

pivot_h = ta.pivothigh(high, sr_left, sr_right)
pivot_l = ta.pivotlow(low, sr_left, sr_right)

var float ph1 = na
var float ph2 = na
var float pl1 = na
var float pl2 = na

if not na(pivot_h)
    ph2 := ph1
    ph1 := pivot_h
    ph1

if not na(pivot_l)
    pl2 := pl1
    pl1 := pivot_l
    pl1

var float resist = na
var float supprt = na
if not na(pivot_h)
    resist := pivot_h
    resist
if not na(pivot_l)
    supprt := pivot_l
    supprt

resist_upper = resist * (1 + sr_zone_pct / 100)
resist_lower = resist * (1 - sr_zone_pct / 100)
supprt_upper = supprt * (1 + sr_zone_pct / 100)
supprt_lower = supprt * (1 - sr_zone_pct / 100)

near_resist = not na(resist) and high >= resist_lower and high <= resist_upper
near_supprt = not na(supprt) and low >= supprt_lower and low <= supprt_upper
breakout_up = not na(resist) and ta.crossover(close, resist_upper)
breakout_down = not na(supprt) and ta.crossunder(close, supprt_lower)

// ══════════════════════════════════════════════════════════════
// ▶ EMA TREND FILTER
// ══════════════════════════════════════════════════════════════

ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
ema_dist_pct = math.abs(ema_fast - ema_slow) / ema_slow * 100

trend_up = ema_fast > ema_slow and ema_dist_pct >= ema_min_dist
trend_down = ema_fast < ema_slow and ema_dist_pct >= ema_min_dist
trend_flat = ema_dist_pct < ema_min_dist

price_above_ema = close > ema_fast
price_below_ema = close < ema_fast

ema_ok_long = not use_ema or trend_up and price_above_ema and not trend_flat
ema_ok_short = not use_ema or trend_down and price_below_ema and not trend_flat

// ══════════════════════════════════════════════════════════════
// ▶ RSI FILTER
// ══════════════════════════════════════════════════════════════

rsi_val = ta.rsi(close, rsi_len)
rsi_ok_long = not use_rsi or rsi_val < rsi_ob
rsi_ok_short = not use_rsi or rsi_val > rsi_os

// ══════════════════════════════════════════════════════════════
// ▶ VWAP FILTER
// ══════════════════════════════════════════════════════════════

vwap_val = ta.vwap(hlc3)
above_vwap = close > vwap_val
vwap_ok_long = not use_vwap or above_vwap
vwap_ok_short = not use_vwap or not above_vwap

// ══════════════════════════════════════════════════════════════
// ▶ VOLUMEN FILTER
// ══════════════════════════════════════════════════════════════

vol_ma = ta.sma(volume, vol_len)
vol_ok = not use_vol or volume > vol_thresh * vol_ma
up_vol = close >= open ? volume : 0.0
down_vol = close < open ? volume : 0.0
vol_delta = math.sum(up_vol, vol_len) - math.sum(down_vol, vol_len)
vol_ok_long = not use_vol or vol_ok and vol_delta > 0
vol_ok_short = not use_vol or vol_ok and vol_delta < 0

// ══════════════════════════════════════════════════════════════
// ▶ ATR + STÄRKE FILTER
// ══════════════════════════════════════════════════════════════

atr_val = ta.atr(atr_len)
body = math.abs(close - open)
candle_range = high - low
upper_wick = high - math.max(close, open)
lower_wick = math.min(close, open) - low
is_bull = close > open
is_bear = close < open

candle_strong = body >= min_atr_mult * atr_val
body_pct_val = candle_range > 0 ? body / candle_range * 100 : 0
body_ok = body_pct_val >= min_body_pct
vol_spike = volume > vol_spike_mult * vol_ma
confirm_long = not use_confirm_candle or close[1] > open[1]
confirm_short = not use_confirm_candle or close[1] < open[1]

strength_ok_long = not use_strength_filter or candle_strong and body_ok and vol_spike and confirm_long
strength_ok_short = not use_strength_filter or candle_strong and body_ok and vol_spike and confirm_short

// ══════════════════════════════════════════════════════════════
// ▶ CANDLESTICK MUSTER
// ══════════════════════════════════════════════════════════════

bull_pinbar = lower_wick >= body * pinbar_ratio and lower_wick >= upper_wick * 2 and body > 0 and candle_range > 0
bear_pinbar = upper_wick >= body * pinbar_ratio and upper_wick >= lower_wick * 2 and body > 0 and candle_range > 0
prev_body = math.abs(close[1] - open[1])
bull_engulfing = is_bull and not is_bull[1] and close > open[1] and open < close[1] and body >= prev_body * (engulf_min_pct / 100)
bear_engulfing = is_bear and not is_bear[1] and close < open[1] and open > close[1] and body >= prev_body * (engulf_min_pct / 100)

// ══════════════════════════════════════════════════════════════
// ▶ SIGNALE
// ══════════════════════════════════════════════════════════════

long_pattern = use_pinbar and bull_pinbar and near_supprt or use_engulfing and bull_engulfing and near_supprt or use_breakout and breakout_up
short_pattern = use_pinbar and bear_pinbar and near_resist or use_engulfing and bear_engulfing and near_resist or use_breakout and breakout_down

long_signal = long_pattern and ema_ok_long and rsi_ok_long and vwap_ok_long and vol_ok_long and strength_ok_long
short_signal = short_pattern and ema_ok_short and rsi_ok_short and vwap_ok_short and vol_ok_short and strength_ok_short

// ══════════════════════════════════════════════════════════════
// ▶ RISK MANAGEMENT STATE
// ══════════════════════════════════════════════════════════════

var float entry_price = na
var float entry_atr = na
var float sl_level = na
var float tp1_level = na
var float tp2_level = na
var bool tp1_hit = false
var bool in_long = false
var bool in_short = false

// ══════════════════════════════════════════════════════════════
// ▶ ENTRIES
// ══════════════════════════════════════════════════════════════

if long_signal and strategy.position_size == 0
    entry_price := close
    entry_atr := atr_val
    // SL: Pivot Low muss UNTER Entry liegen, sonst ATR-Fallback
    float _sl_l = use_pivot_sl and not na(pl1) and pl1 < close ? pl1 * (1 - sl_buffer_pct / 100) : close - atr_val * atr_sl_mult
    // TP1: Pivot High muss ÜBER Entry liegen, sonst ATR-Fallback
    float _tp1_l = use_pivot_sl and not na(ph1) and ph1 > close ? ph1 : close + atr_val * atr_tp1_mult
    // TP2: Pivot High muss ÜBER TP1 liegen, sonst ATR-Fallback
    float _tp2_l = use_pivot_sl and not na(ph2) and ph2 > _tp1_l ? ph2 : close + atr_val * atr_tp2_mult
    _tp2_l := _tp2_l > _tp1_l ? _tp2_l : close + atr_val * atr_tp2_mult
    sl_level := _sl_l
    tp1_level := _tp1_l
    tp2_level := _tp2_l
    tp1_hit := false
    in_long := true
    in_short := false
    strategy.entry('Long', strategy.long, comment = 'open_long')
    // TP1 Teilschließung
    strategy.exit('Long_TP1', from_entry = 'Long', qty_percent = tp1_qty, limit = _tp1_l, stop = _sl_l, comment = 'tp1_long')
    // TP2 + SL für Rest – stop greift wenn TP1 bereits ausgeführt
    strategy.exit('Long_TP2', from_entry = 'Long', qty_percent = 100, limit = _tp2_l, stop = _sl_l, comment = 'tp2_long')

if short_signal and strategy.position_size == 0
    entry_price := close
    entry_atr := atr_val
    // SL: Pivot High muss ÜBER Entry liegen, sonst ATR-Fallback
    float _sl_s = use_pivot_sl and not na(ph1) and ph1 > close ? ph1 * (1 + sl_buffer_pct / 100) : close + atr_val * atr_sl_mult
    // TP1: Pivot Low muss UNTER Entry liegen, sonst ATR-Fallback
    float _tp1_s = use_pivot_sl and not na(pl1) and pl1 < close ? pl1 : close - atr_val * atr_tp1_mult
    // TP2: Pivot Low muss UNTER TP1 liegen, sonst ATR-Fallback
    float _tp2_s = use_pivot_sl and not na(pl2) and pl2 < _tp1_s ? pl2 : close - atr_val * atr_tp2_mult
    _tp2_s := _tp2_s < _tp1_s ? _tp2_s : close - atr_val * atr_tp2_mult
    sl_level := _sl_s
    tp1_level := _tp1_s
    tp2_level := _tp2_s
    tp1_hit := false
    in_short := true
    in_long := false
    strategy.entry('Short', strategy.short, comment = 'open_short')
    // TP1 Teilschließung
    strategy.exit('Short_TP1', from_entry = 'Short', qty_percent = tp1_qty, limit = _tp1_s, stop = _sl_s, comment = 'tp1_short')
    // TP2 + SL für Rest
    strategy.exit('Short_TP2', from_entry = 'Short', qty_percent = 100, limit = _tp2_s, stop = _sl_s, comment = 'tp2_short')

// ══════════════════════════════════════════════════════════════
// ▶ STATE TRACKING (Quelle der Wahrheit = strategy.position_size)
// ══════════════════════════════════════════════════════════════

// Echten Positionsstatus direkt aus Pine Script lesen
in_long := strategy.position_size > 0
in_short := strategy.position_size < 0

// TP1 visuell getroffen → BE-SL Anzeige aktualisieren
if in_long and not tp1_hit and not na(tp1_level) and close >= tp1_level
    tp1_hit := true
    sl_level := entry_price
    sl_level

if in_short and not tp1_hit and not na(tp1_level) and close <= tp1_level
    tp1_hit := true
    sl_level := entry_price
    sl_level

// Position geschlossen → State zurücksetzen
if not in_long and not in_short
    tp1_hit := false
    tp1_hit

// ══════════════════════════════════════════════════════════════
// ▶ AUTO TRADE-BOX VISUALISIERUNG  ← ORIGINAL (unverändert)
// ══════════════════════════════════════════════════════════════

BOX_EXTEND = 40

if long_signal
    _ep = close
    _tp1 = close + atr_val * atr_tp1_mult
    _tp2 = close + atr_val * atr_tp2_mult
    _sl = close - atr_val * atr_sl_mult
    _bi = bar_index
    box.new(_bi, _tp2, _bi + BOX_EXTEND, _ep, border_color = color.new(#00e676, 20), border_width = 1, bgcolor = color.new(#00e676, 88))
    box.new(_bi, _ep, _bi + BOX_EXTEND, _sl, border_color = color.new(#ff6d00, 20), border_width = 1, bgcolor = color.new(#ff6d00, 88))
    line.new(_bi, _tp1, _bi + BOX_EXTEND, _tp1, color = color.new(#69f0ae, 0), width = 1, style = line.style_dashed)
    label.new(_bi, low * 0.9994, text = '▲ LONG\nEntry: ' + str.tostring(_ep, '#.####') + '\nTP1:   ' + str.tostring(_tp1, '#.####') + '\nTP2:   ' + str.tostring(_tp2, '#.####') + '\nSL:    ' + str.tostring(_sl, '#.####'), style = label.style_label_up, color = color.new(#00e676, 0), textcolor = color.black, size = size.small)

if short_signal
    _ep = close
    _tp1 = close - atr_val * atr_tp1_mult
    _tp2 = close - atr_val * atr_tp2_mult
    _sl = close + atr_val * atr_sl_mult
    _bi = bar_index
    box.new(_bi, _ep, _bi + BOX_EXTEND, _tp2, border_color = color.new(#ff1744, 20), border_width = 1, bgcolor = color.new(#ff1744, 88))
    box.new(_bi, _sl, _bi + BOX_EXTEND, _ep, border_color = color.new(#ff6d00, 20), border_width = 1, bgcolor = color.new(#ff6d00, 88))
    line.new(_bi, _tp1, _bi + BOX_EXTEND, _tp1, color = color.new(#ff5252, 0), width = 1, style = line.style_dashed)
    label.new(_bi, high * 1.0006, text = '▼ SHORT\nEntry: ' + str.tostring(_ep, '#.####') + '\nTP1:   ' + str.tostring(_tp1, '#.####') + '\nTP2:   ' + str.tostring(_tp2, '#.####') + '\nSL:    ' + str.tostring(_sl, '#.####'), style = label.style_label_down, color = color.new(#ff1744, 0), textcolor = color.white, size = size.small)

// ══════════════════════════════════════════════════════════════
// ▶ PLOTS
// ══════════════════════════════════════════════════════════════

plot(vwap_val, 'VWAP', color = color.new(#40c4ff, 0), linewidth = 2)
bgcolor(above_vwap ? color.new(#00bcd4, 97) : color.new(#7c4dff, 97))

ema_col = trend_up ? color.new(#00e676, 10) : trend_down ? color.new(#ff1744, 10) : color.new(#888888, 40)
plot(ema_fast, 'EMA 21', color = ema_col, linewidth = 2)
plot(ema_slow, 'EMA 50', color = color.new(#ff9800, 50), linewidth = 1)

bgcolor(trend_flat ? color.new(#888888, 94) : na, title = '⚠️ Seitwärts – kein Trade')

plot(resist, 'Resistance', color = color.new(#ff1744, 30), style = plot.style_linebr, linewidth = 2, offset = -sr_right)
plot(supprt, 'Support', color = color.new(#00e676, 30), style = plot.style_linebr, linewidth = 2, offset = -sr_right)
r_upper = plot(resist_upper, color = color.new(#ff1744, 85), style = plot.style_linebr, linewidth = 1, offset = -sr_right)
r_lower = plot(resist_lower, color = color.new(#ff1744, 85), style = plot.style_linebr, linewidth = 1, offset = -sr_right)
s_upper = plot(supprt_upper, color = color.new(#00e676, 85), style = plot.style_linebr, linewidth = 1, offset = -sr_right)
s_lower = plot(supprt_lower, color = color.new(#00e676, 85), style = plot.style_linebr, linewidth = 1, offset = -sr_right)
fill(r_upper, r_lower, color = color.new(#ff1744, 92))
fill(s_upper, s_lower, color = color.new(#00e676, 92))

plotshape(not na(pivot_h), 'Pivot High', shape.labeldown, location.abovebar, color = color.new(#ff1744, 20), size = size.tiny, text = 'R', textcolor = color.white, offset = -sr_right)
plotshape(not na(pivot_l), 'Pivot Low', shape.labelup, location.belowbar, color = color.new(#00e676, 20), size = size.tiny, text = 'S', textcolor = color.white, offset = -sr_right)

plot(in_long ? tp1_level : na, 'Long TP1', color = color.new(#69f0ae, 40), style = plot.style_linebr, linewidth = 1)
plot(in_long ? tp2_level : na, 'Long TP2', color = color.new(#00e676, 10), style = plot.style_linebr, linewidth = 2)
plot(in_long ? sl_level : na, 'Long SL/BE', color = color.new(tp1_hit ? #ffd740 : #ff6d00, 20), style = plot.style_linebr, linewidth = 1)
plot(in_short ? tp1_level : na, 'Short TP1', color = color.new(#ff5252, 40), style = plot.style_linebr, linewidth = 1)
plot(in_short ? tp2_level : na, 'Short TP2', color = color.new(#ff1744, 10), style = plot.style_linebr, linewidth = 2)
plot(in_short ? sl_level : na, 'Short SL/BE', color = color.new(tp1_hit ? #ffd740 : #ff6d00, 20), style = plot.style_linebr, linewidth = 1)

// ══════════════════════════════════════════════════════════════
// ▶ INFO TABLE
// ══════════════════════════════════════════════════════════════

var table t = table.new(position.top_right, 2, 16, border_width = 1, bgcolor = color.new(color.black, 70))

if barstate.islast
    table.cell(t, 0, 0, 'PA-Pro-5M FINAL3', text_color = color.yellow, text_size = size.small, bgcolor = color.new(color.navy, 40))
    table.cell(t, 1, 0, 'Status', text_color = color.yellow, text_size = size.small, bgcolor = color.new(color.navy, 40))
    table.cell(t, 0, 1, 'Position', text_color = color.white, text_size = size.small)
    table.cell(t, 1, 1, in_long ? 'LONG 🟢' : in_short ? 'SHORT 🔴' : 'Keine', text_color = in_long ? color.lime : in_short ? color.red : color.gray, text_size = size.small)
    table.cell(t, 0, 2, 'Entry', text_color = color.white, text_size = size.small)
    table.cell(t, 1, 2, na(entry_price) ? '—' : str.tostring(entry_price, '#.####'), text_color = color.yellow, text_size = size.small)
    table.cell(t, 0, 3, 'TP1', text_color = color.white, text_size = size.small)
    table.cell(t, 1, 3, na(tp1_level) ? '—' : str.tostring(tp1_level, '#.####'), text_color = color.new(#69f0ae, 0), text_size = size.small)
    table.cell(t, 0, 4, 'TP2', text_color = color.white, text_size = size.small)
    table.cell(t, 1, 4, na(tp2_level) ? '—' : str.tostring(tp2_level, '#.####'), text_color = color.new(#00e676, 0), text_size = size.small)
    table.cell(t, 0, 5, 'SL / BE', text_color = color.white, text_size = size.small)
    table.cell(t, 1, 5, na(sl_level) ? '—' : str.tostring(sl_level, '#.####') + (tp1_hit ? ' (BE)' : ''), text_color = tp1_hit ? color.new(#ffd740, 0) : color.new(#ff6d00, 0), text_size = size.small)
    table.cell(t, 0, 6, 'Trend EMA', text_color = color.white, text_size = size.small)
    table.cell(t, 1, 6, trend_flat ? '↔ Seitwärts ⚠️' : trend_up ? '↑ Bull 🟢' : '↓ Bear 🔴', text_color = trend_flat ? color.gray : trend_up ? color.lime : color.red, text_size = size.small)
    table.cell(t, 0, 7, 'EMA Abstand', text_color = color.white, text_size = size.small)
    table.cell(t, 1, 7, str.tostring(math.round(ema_dist_pct, 3)) + '%', text_color = trend_flat ? color.red : color.lime, text_size = size.small)
    table.cell(t, 0, 8, 'RSI', text_color = color.white, text_size = size.small)
    table.cell(t, 1, 8, str.tostring(math.round(rsi_val, 1)), text_color = rsi_val > rsi_ob ? color.red : rsi_val < rsi_os ? color.lime : color.yellow, text_size = size.small)
    table.cell(t, 0, 9, 'VWAP', text_color = color.white, text_size = size.small)
    table.cell(t, 1, 9, above_vwap ? 'Über 🟢' : 'Unter 🔴', text_color = above_vwap ? color.lime : color.red, text_size = size.small)
    table.cell(t, 0, 10, 'Volumen Delta', text_color = color.white, text_size = size.small)
    table.cell(t, 1, 10, vol_delta > 0 ? 'Kauf 🟢' : 'Verkauf 🔴', text_color = vol_delta > 0 ? color.lime : color.red, text_size = size.small)
    table.cell(t, 0, 11, 'Support', text_color = color.white, text_size = size.small)
    table.cell(t, 1, 11, na(supprt) ? '—' : str.tostring(supprt, '#.####'), text_color = near_supprt ? color.lime : color.gray, text_size = size.small)
    table.cell(t, 0, 12, 'Resistance', text_color = color.white, text_size = size.small)
    table.cell(t, 1, 12, na(resist) ? '—' : str.tostring(resist, '#.####'), text_color = near_resist ? color.red : color.gray, text_size = size.small)
    table.cell(t, 0, 13, 'ATR', text_color = color.white, text_size = size.small)
    table.cell(t, 1, 13, str.tostring(atr_val, '#.####'), text_color = color.yellow, text_size = size.small)
    table.cell(t, 0, 14, 'Kerze Stärke', text_color = color.white, text_size = size.small)
    table.cell(t, 1, 14, candle_strong ? 'Stark 🟢' : 'Schwach 🔴', text_color = candle_strong ? color.lime : color.red, text_size = size.small)
    table.cell(t, 0, 15, 'Bitget Bot', text_color = color.white, text_size = size.small)
    table.cell(t, 1, 15, '✅ Aktiv', text_color = color.aqua, text_size = size.small)
