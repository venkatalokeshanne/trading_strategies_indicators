valueAreaColor = input.color(
     color.new(color.blue, 35),
     "Value Area Color",
     group = groupColors)

outsideValueColor = input.color(
     color.new(color.gray, 75),
     "Outside Value Color",
     group = groupColors)

pocRowColor = input.color(
     color.new(color.orange, 5),
     "POC Row Color",
     group = groupColors)

profileBorderColor = input.color(
