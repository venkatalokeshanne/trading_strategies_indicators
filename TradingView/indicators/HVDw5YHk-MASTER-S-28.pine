//@version=6
indicator("MASTER S 28", shorttitle="MASTER S 28", overlay=true, max_lines_count=500, max_labels_count=500)

RTH_SESS = "0930-1600"
ON_SESS  = "2000-0400"
PRE_SESS = "1800-0930"
TZ       = "America/New_York"
EXTEND   = 60

C_PDH  = color.green
C_PDL  = #FF5252
C_ONH  = color.blue
C_ONL  = color.orange
C_PREH = color.aqua
C_PREL = #FFEB3B

S_SOLID  = line.style_solid
S_DASHED = line.style_dashed
S_DOTTED = line.style_dotted

inSession(sess) => not na(time(timeframe.period, sess, TZ))

msPerBar = timeframe.in_seconds(timeframe.period) * 1000

isRTH  = inSession(RTH_SESS)
newDay = ta.change(time("D")) != 0

var float todayHigh     = na
var float todayLow      = na
var int   todayHighTime = na
var int   todayLowTime  = na

var float pdh     = na
var float pdl     = na
var int   pdhTime = na
var int   pdlTime = na

if newDay
    pdh     := todayHigh
    pdl     := todayLow
    pdhTime := todayHighTime
    pdlTime := todayLowTime
    todayHigh     := na
    todayLow      := na
    todayHighTime := na
    todayLowTime  := na

if isRTH
    if na(todayHigh) or high > todayHigh
        todayHigh     := high
        todayHighTime := time
    if na(todayLow) or low < todayLow
        todayLow     := low
        todayLowTime := time

isON = inSession(ON_SESS)

isONPrev  = isON[1]
onStarted = isON and not isONPrev
onEnded   = not isON and isONPrev

var float onHighRun     = na
var float onLowRun      = na
var int   onHighRunTime = na
var int   onLowRunTime  = na

var float onhFrozen     = na
var float onlFrozen     = na
var int   onhFrozenTime = na
var int   onlFrozenTime = na

onHighRunPrev     = onHighRun[1]
onLowRunPrev      = onLowRun[1]
onHighRunTimePrev = onHighRunTime[1]
onLowRunTimePrev  = onLowRunTime[1]

if onStarted
    onHighRun     := high
    onLowRun      := low
    onHighRunTime := time
    onLowRunTime  := time
    onhFrozen     := na
    onlFrozen     := na
    onhFrozenTime := na
    onlFrozenTime := na
else if isON
    if na(onHighRun) or high > onHighRun
        onHighRun     := high
        onHighRunTime := time
    if na(onLowRun) or low < onLowRun
        onLowRun     := low
        onLowRunTime := time

if onEnded
    onhFrozen     := onHighRunPrev
    onlFrozen     := onLowRunPrev
    onhFrozenTime := onHighRunTimePrev
    onlFrozenTime := onLowRunTimePrev
    onHighRun     := na
    onLowRun      := na
    onHighRunTime := na
    onLowRunTime  := na

onhDisplay     = isON ? onHighRun     : onhFrozen
onlDisplay     = isON ? onLowRun      : onlFrozen
onhDisplayTime = isON ? onHighRunTime : onhFrozenTime
onlDisplayTime = isON ? onLowRunTime  : onlFrozenTime

isPre = inSession(PRE_SESS)

isPrePrev  = isPre[1]
preStarted = isPre and not isPrePrev
preEnded   = not isPre and isPrePrev

var float preHighRun     = na
var float preLowRun      = na
var int   preHighRunTime = na
var int   preLowRunTime  = na

var float preHFrozen     = na
var float preLFrozen     = na
var int   preHFrozenTime = na
var int   preLFrozenTime = na

preHighRunPrev     = preHighRun[1]
preLowRunPrev      = preLowRun[1]
preHighRunTimePrev = preHighRunTime[1]
preLowRunTimePrev  = preLowRunTime[1]

if preStarted
    preHighRun     := high
    preLowRun      := low
    preHighRunTime := time
    preLowRunTime  := time
    preHFrozen     := na
    preLFrozen     := na
    preHFrozenTime := na
    preLFrozenTime := na
else if isPre
    if na(preHighRun) or high > preHighRun
        preHighRun     := high
        preHighRunTime := time
    if na(preLowRun) or low < preLowRun
        preLowRun     := low
        preLowRunTime := time

if preEnded
    preHFrozen     := preHighRunPrev
    preLFrozen     := preLowRunPrev
    preHFrozenTime := preHighRunTimePrev
    preLFrozenTime := preLowRunTimePrev
    preHighRun     := na
    preLowRun      := na
    preHighRunTime := na
    preLowRunTime  := na

preHDisplay     = isPre ? preHighRun     : preHFrozen
preLDisplay     = isPre ? preLowRun      : preLFrozen
preHDisplayTime = isPre ? preHighRunTime : preHFrozenTime
preLDisplayTime = isPre ? preLowRunTime  : preLFrozenTime

var line  pdhLine = na
var label pdhLbl  = na
var line  pdlLine = na
var label pdlLbl  = na
var line  onhLine = na
var label onhLbl  = na
var line  onlLine = na
var label onlLbl  = na
var line  preHLine = na
var label preHLbl  = na
var line  preLLine = na
var label preLLbl  = na

f_draw(_line, _lbl, _price, _anchorTime, _txt, _col, _style) =>
    line  l = _line
    label b = _lbl
    if not na(_price) and not na(_anchorTime)
        t2 = time + msPerBar * EXTEND
        if na(l)
            l := line.new(_anchorTime, _price, t2, _price, xloc=xloc.bar_time, extend=extend.none, color=_col, style=_style, width=1)
        else
            line.set_xy1(l, _anchorTime, _price)
            line.set_xy2(l, t2, _price)
        txt = _txt + "  " + str.tostring(_price, format.mintick)
        if na(b)
            b := label.new(t2, _price, txt, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 100), textcolor=_col, size=size.small)
        else
            label.set_xy(b, t2, _price)
            label.set_text(b, txt)
    else
        if not na(l)
            line.delete(l)
            l := na
        if not na(b)
            label.delete(b)
            b := na
    [l, b]

if barstate.islast
    [a1, b1] = f_draw(pdhLine, pdhLbl, pdh, pdhTime, "PDH", C_PDH, S_SOLID)
    pdhLine := a1
    pdhLbl  := b1

    [a2, b2] = f_draw(pdlLine, pdlLbl, pdl, pdlTime, "PDL", C_PDL, S_SOLID)
    pdlLine := a2
    pdlLbl  := b2

    [a3, b3] = f_draw(onhLine, onhLbl, onhDisplay, onhDisplayTime, "ONH", C_ONH, S_DASHED)
    onhLine := a3
    onhLbl  := b3

    [a4, b4] = f_draw(onlLine, onlLbl, onlDisplay, onlDisplayTime, "ONL", C_ONL, S_DASHED)
    onlLine := a4
    onlLbl  := b4

    [a5, b5] = f_draw(preHLine, preHLbl, preHDisplay, preHDisplayTime, "PreH", C_PREH, S_DOTTED)
    preHLine := a5
    preHLbl  := b5

    [a6, b6] = f_draw(preLLine, preLLbl, preLDisplay, preLDisplayTime, "PreL", C_PREL, S_DOTTED)
    preLLine := a6
    preLLbl  := b6
