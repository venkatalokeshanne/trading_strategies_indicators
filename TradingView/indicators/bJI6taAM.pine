//@version=6
indicator("RAMO ÇANAK AİLESİ PRO V3.8.3 | STRICT CLASSIFIER + VISIBLE DETECTION TRACE", overlay=true, max_labels_count=120, max_lines_count=400, max_boxes_count=30, max_bars_back=3000)

