//@version=6
indicator("OAT Minervini PRO v5 - Dynamic VCP Pivot", shorttitle="OAT Minervini v5", overlay=true, format=format.price)

//=============================================================================
// OAT MINERVINI PRO v5
// Dynamic VCP Pivot Version
//
// Recommended timeframe: DAILY (1D)
//
// MODULES
// 1. EMA 50 / 150 / 200
// 2. Minervini Trend Template 8/8
// 3. Relative Strength vs Benchmark
// 4. RS Score 0-7
// 5. Base Detection
// 6. 40D -> 20D -> 10D Price Contraction
// 7. ATR Contraction
// 8. Volume Dry-Up
// 9. Dynamic VCP Pivot from confirmed swing high
// 10. Breakout confirmation
// 11. Pivot extension / Do Not Chase
// 12. Leader Bottom First
// 13. Setup Score 0-7
// 14. Phase Detector
// 15. 4-page Dashboard
//
// IMPORTANT:
// RS Score is NOT official IBD RS Rating.
// VCP detection is systematic / rule-based approximation.
//=============================================================================


//=============================================================================
// 01. INPUT GROUPS
//=============================================================================

string GROUP_EMA = "01 - EMA"
string GROUP_TREND = "02 - Minervini Trend"
string GROUP_RS = "03 - Relative Strength"
string GROUP_BASE = "04 - Base and Contraction"
string GROUP_VOLUME = "05 - Volume"
string GROUP_PIVOT = "06 - Dynamic VCP Pivot"
string GROUP_ENTRY = "07 - Entry and Risk"
string GROUP_DASH = "08 - Dashboard"
string GROUP_VISUAL = "09 - Visual"


//=============================================================================
// 02. EMA INPUTS
//=============================================================================

bool showEMA = input.bool(true, "Show EMA", group=GROUP_EMA)

int ema50Len = input.int(50, "EMA 50 Length", minval=1, group=GROUP_EMA)
int ema150Len = input.int(150, "EMA 150 Length", minval=1, group=GROUP_EMA)
int ema200Len = input.int(200, "EMA 200 Length", minval=1, group=GROUP_EMA)

color ema50Color = input.color(color.rgb(33, 150, 243), "EMA 50 Color", group=GROUP_EMA)
color ema150Color = input.color(color.rgb(255, 152, 0), "EMA 150 Color", group=GROUP_EMA)
color ema200Color = input.color(color.rgb(244, 67, 54), "EMA 200 Color", group=GROUP_EMA)

int ema50Width = input.int(2, "EMA 50 Width", minval=1, maxval=5, group=GROUP_EMA)
int ema150Width = input.int(2, "EMA 150 Width", minval=1, maxval=5, group=GROUP_EMA)
int ema200Width = input.int(3, "EMA 200 Width", minval=1, maxval=5, group=GROUP_EMA)


//=============================================================================
// 03. MINERVINI TREND INPUTS
//=============================================================================

int lookback52W = input.int(252, "52 Week Lookback", minval=100, group=GROUP_TREND)

int ema200SlopeDays = input.int(22, "EMA200 Rising Lookback", minval=1, group=GROUP_TREND)

float minAbove52Low = input.float(25.0, "Minimum % Above 52W Low", minval=0.0, step=1.0, group=GROUP_TREND)

float maxBelow52High = input.float(25.0, "Maximum % Below 52W High", minval=0.0, step=1.0, group=GROUP_TREND)


//=============================================================================
// 04. RELATIVE STRENGTH INPUTS
//=============================================================================

string benchmarkSymbol = input.symbol("SET:SET", "Benchmark", group=GROUP_RS)

int rs6WLen = input.int(30, "RS 6 Week Lookback", minval=1, group=GROUP_RS)

int rs13WLen = input.int(65, "RS 13 Week Lookback", minval=1, group=GROUP_RS)

int rsFastLen = input.int(20, "RS Fast EMA", minval=1, group=GROUP_RS)

int rsSlowLen = input.int(50, "RS Slow EMA", minval=1, group=GROUP_RS)

int rsSlopeLen = input.int(10, "RS EMA Rising Lookback", minval=1, group=GROUP_RS)

float rsNearHighPct = input.float(2.0, "RS Near 52W High %", minval=0.0, maxval=20.0, step=0.5, group=GROUP_RS)

string rsMode = input.string("Balanced", "Trend Template RS Mode", options=["Loose", "Balanced", "Strict"], group=GROUP_RS)


//=============================================================================
// 05. BASE / CONTRACTION INPUTS
//=============================================================================

int baseLookback = input.int(50, "Base Lookback", minval=20, group=GROUP_BASE)

float maxBaseDepthPct = input.float(30.0, "Maximum Base Depth %", minval=5.0, maxval=60.0, step=1.0, group=GROUP_BASE)

int contractionLongLen = input.int(40, "Long Contraction Window", minval=20, group=GROUP_BASE)

int contractionMidLen = input.int(20, "Middle Contraction Window", minval=10, group=GROUP_BASE)

int contractionShortLen = input.int(10, "Final Contraction Window", minval=3, group=GROUP_BASE)

float maxFinalRangePct = input.float(8.0, "Maximum Final Contraction Range %", minval=1.0, maxval=30.0, step=0.5, group=GROUP_BASE)

int atrLen = input.int(14, "ATR Length", minval=1, group=GROUP_BASE)

int atrShortSmooth = input.int(5, "ATR Short Average", minval=1, group=GROUP_BASE)

int atrLongSmooth = input.int(20, "ATR Long Average", minval=2, group=GROUP_BASE)

float atrContractionRatio = input.float(0.85, "ATR Contraction Ratio", minval=0.40, maxval=1.20, step=0.05, group=GROUP_BASE)


//=============================================================================
// 06. VOLUME INPUTS
//=============================================================================

int volumeAvgLen = input.int(50, "Volume Average Length", minval=5, group=GROUP_VOLUME)

int volumeDryLen = input.int(5, "Dry-Up Average Length", minval=1, group=GROUP_VOLUME)

float volumeDryRatio = input.float(0.70, "Dry-Up Ratio", minval=0.10, maxval=1.50, step=0.05, group=GROUP_VOLUME)

float breakoutVolumeRatio = input.float(1.40, "Breakout Volume Ratio", minval=1.0, maxval=5.0, step=0.10, group=GROUP_VOLUME)


//=============================================================================
// 07. DYNAMIC VCP PIVOT INPUTS
//=============================================================================

int pivotLeftBars = input.int(3, "Pivot Left Bars", minval=1, maxval=15, group=GROUP_PIVOT)

int pivotRightBars = input.int(3, "Pivot Right Bars", minval=1, maxval=15, group=GROUP_PIVOT)

int maxPivotAge = input.int(35, "Maximum Pivot Age", minval=5, maxval=100, group=GROUP_PIVOT)

float nearPivotPct = input.float(5.0, "Ready Zone % Below Pivot", minval=0.5, maxval=15.0, step=0.5, group=GROUP_PIVOT)

bool allowFallbackPivot = input.bool(false, "Allow Highest-High Fallback", group=GROUP_PIVOT)

int fallbackPivotLookback = input.int(20, "Fallback High Lookback", minval=5, maxval=100, group=GROUP_PIVOT)


//=============================================================================
// 08. ENTRY / RISK INPUTS
//=============================================================================

float idealMaxExtension = input.float(2.0, "Ideal Maximum % Above Pivot", minval=0.0, maxval=10.0, step=0.5, group=GROUP_ENTRY)

float maxChasePct = input.float(5.0, "Do Not Chase Above Pivot %", minval=1.0, maxval=20.0, step=0.5, group=GROUP_ENTRY)

float maxEMA50Extension = input.float(10.0, "Maximum Preferred % Above EMA50", minval=1.0, maxval=50.0, step=1.0, group=GROUP_ENTRY)

int minTrendForVCP = input.int(7, "Minimum Trend Score for VCP", minval=1, maxval=8, group=GROUP_ENTRY)

int minSetupForVCP = input.int(6, "Minimum Setup Score for VCP", minval=1, maxval=7, group=GROUP_ENTRY)


//=============================================================================
// 09. DASHBOARD INPUTS
//=============================================================================

string dashboardPage = input.string("1 - Trend", "Dashboard Page", options=["1 - Trend", "2 - Relative Strength", "3 - VCP Setup", "4 - Pivot and Entry"], group=GROUP_DASH)

string dashboardPosition = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=GROUP_DASH)

string dashboardSize = input.string("Small", "Dashboard Text Size", options=["Tiny", "Small", "Normal"], group=GROUP_DASH)


//=============================================================================
// 10. VISUAL INPUTS
//=============================================================================

bool showPivot = input.bool(true, "Show Dynamic VCP Pivot", group=GROUP_VISUAL)

bool showSignals = input.bool(true, "Show Signals", group=GROUP_VISUAL)

bool highlightQualified = input.bool(true, "Highlight Trend 8/8", group=GROUP_VISUAL)

color pivotColor = input.color(color.rgb(156, 39, 176), "Pivot Color", group=GROUP_VISUAL)


//=============================================================================
// 11. STOCK EMA
//=============================================================================

float ema50 = ta.ema(close, ema50Len)
float ema150 = ta.ema(close, ema150Len)
float ema200 = ta.ema(close, ema200Len)


//=============================================================================
// 12. PLOT EMA
//=============================================================================

plot(showEMA ? ema50 : na, title="EMA 50", color=ema50Color, linewidth=ema50Width)

plot(showEMA ? ema150 : na, title="EMA 150", color=ema150Color, linewidth=ema150Width)

plot(showEMA ? ema200 : na, title="EMA 200", color=ema200Color, linewidth=ema200Width)


//=============================================================================
// 13. 52 WEEK PRICE DATA
//=============================================================================

float high52 = ta.highest(high, lookback52W)

float low52 = ta.lowest(low, lookback52W)

float previousHigh52 = ta.highest(high[1], lookback52W)

float pctAbove52Low = na

if low52 > 0
    pctAbove52Low := ((close / low52) - 1.0) * 100.0


float pctBelow52High = na

if high52 > 0
    pctBelow52High := ((high52 - close) / high52) * 100.0


//=============================================================================
// 14. BENCHMARK
//=============================================================================

float benchmarkClose = request.security(benchmarkSymbol, timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)


//=============================================================================
// 15. RELATIVE STRENGTH LINE
//=============================================================================

float rsLine = na

if not na(benchmarkClose) and benchmarkClose != 0
    rsLine := close / benchmarkClose


//=============================================================================
// 16. RS TREND
//=============================================================================

bool rs6WRising = false

if not na(rsLine[rs6WLen])
    rs6WRising := rsLine > rsLine[rs6WLen]


bool rs13WRising = false

if not na(rsLine[rs13WLen])
    rs13WRising := rsLine > rsLine[rs13WLen]


//=============================================================================
// 17. RS EMA
//=============================================================================

float rsEMA20 = ta.ema(rsLine, rsFastLen)

float rsEMA50 = ta.ema(rsLine, rsSlowLen)

bool rsAboveEMA20 = false

bool rsEMA20Above50 = false

bool rsEMA20Rising = false


if not na(rsLine) and not na(rsEMA20)
    rsAboveEMA20 := rsLine > rsEMA20


if not na(rsEMA20) and not na(rsEMA50)
    rsEMA20Above50 := rsEMA20 > rsEMA50


if not na(rsEMA20[rsSlopeLen])
    rsEMA20Rising := rsEMA20 > rsEMA20[rsSlopeLen]


//=============================================================================
// 18. RS 52 WEEK HIGH
//=============================================================================

float previousRSHigh = ta.highest(rsLine[1], lookback52W)

bool rsNewHigh = false

bool rsNearHigh = false


if not na(previousRSHigh)
    rsNewHigh := rsLine > previousRSHigh


if not na(previousRSHigh)
    rsNearHigh := rsLine >= previousRSHigh * (1.0 - rsNearHighPct / 100.0)


//=============================================================================
// 19. PRICE NEW HIGH / RS LEAD
//=============================================================================

bool priceNewHigh = false

if not na(previousHigh52)
    priceNewHigh := high > previousHigh52


bool rsLeadsPrice = rsNewHigh and not priceNewHigh

bool newRSLead = rsLeadsPrice and not rsLeadsPrice[1]


//=============================================================================
// 20. MINERVINI TREND TEMPLATE
//=============================================================================

bool cond1 = close > ema150 and close > ema200

bool cond2 = ema150 > ema200

bool cond3 = false

if not na(ema200[ema200SlopeDays])
    cond3 := ema200 > ema200[ema200SlopeDays]


bool cond4 = ema50 > ema150 and ema50 > ema200


bool cond5 = false

if not na(pctAbove52Low)
    cond5 := pctAbove52Low >= minAbove52Low


bool cond6 = false

if not na(pctBelow52High)
    cond6 := pctBelow52High <= maxBelow52High


bool cond7Loose = rs6WRising

bool cond7Balanced = rs6WRising and rs13WRising and rsAboveEMA20

bool cond7Strict = rs6WRising and rs13WRising and rsAboveEMA20 and rsEMA20Above50 and rsEMA20Rising

bool cond7 = cond7Balanced


if rsMode == "Loose"
    cond7 := cond7Loose


if rsMode == "Balanced"
    cond7 := cond7Balanced


if rsMode == "Strict"
    cond7 := cond7Strict


bool cond8 = close > ema50


//=============================================================================
// 21. TREND SCORE
//=============================================================================

int trendScore = 0

if cond1
    trendScore += 1

if cond2
    trendScore += 1

if cond3
    trendScore += 1

if cond4
    trendScore += 1

if cond5
    trendScore += 1

if cond6
    trendScore += 1

if cond7
    trendScore += 1

if cond8
    trendScore += 1


bool trendPass = trendScore == 8

bool newTrendPass = trendPass and not trendPass[1]


//=============================================================================
// 22. RS SCORE 0-7
//=============================================================================

int rsScore = 0

if rs6WRising
    rsScore += 1

if rs13WRising
    rsScore += 1

if rsAboveEMA20
    rsScore += 1

if rsEMA20Above50
    rsScore += 1

if rsEMA20Rising
    rsScore += 1

if rsNearHigh
    rsScore += 1

if rsLeadsPrice
    rsScore += 1


bool rsStrong = rsScore >= 5


//=============================================================================
// 23. BASE DETECTOR
//=============================================================================

float baseHigh = ta.highest(high, baseLookback)

float baseLow = ta.lowest(low, baseLookback)

float baseDepthPct = na


if baseHigh > 0
    baseDepthPct := ((baseHigh - baseLow) / baseHigh) * 100.0


bool baseForming = false


if not na(baseDepthPct)
    baseForming := close > ema50 and baseDepthPct <= maxBaseDepthPct and close < baseHigh


//=============================================================================
// 24. PRICE CONTRACTION WINDOWS
//=============================================================================

float longHigh = ta.highest(high, contractionLongLen)

float longLow = ta.lowest(low, contractionLongLen)

float midHigh = ta.highest(high, contractionMidLen)

float midLow = ta.lowest(low, contractionMidLen)

float shortHigh = ta.highest(high, contractionShortLen)

float shortLow = ta.lowest(low, contractionShortLen)


float longRangePct = na

float midRangePct = na

float shortRangePct = na


if longLow > 0
    longRangePct := ((longHigh - longLow) / longLow) * 100.0


if midLow > 0
    midRangePct := ((midHigh - midLow) / midLow) * 100.0


if shortLow > 0
    shortRangePct := ((shortHigh - shortLow) / shortLow) * 100.0


//=============================================================================
// 25. MULTI-CONTRACTION LOGIC
//=============================================================================

bool contraction40to20 = false

bool contraction20to10 = false

bool multiContraction = false

bool finalTight = false


if not na(longRangePct) and not na(midRangePct)
    contraction40to20 := midRangePct < longRangePct


if not na(midRangePct) and not na(shortRangePct)
    contraction20to10 := shortRangePct < midRangePct


multiContraction := contraction40to20 and contraction20to10


if not na(shortRangePct)
    finalTight := shortRangePct <= maxFinalRangePct


//=============================================================================
// 26. ATR CONTRACTION
//=============================================================================

float atrValue = ta.atr(atrLen)

float atrPct = na


if close > 0
    atrPct := atrValue / close * 100.0


float atrShort = ta.sma(atrPct, atrShortSmooth)

float atrLong = ta.sma(atrPct, atrLongSmooth)


bool atrContracting = false


if not na(atrShort) and not na(atrLong)
    atrContracting := atrShort < atrLong * atrContractionRatio


//=============================================================================
// 27. VOLUME DRY-UP
//=============================================================================

float volAvg = ta.sma(volume, volumeAvgLen)

float volDryAvg = ta.sma(volume, volumeDryLen)

float volumeDryPct = na

float currentVolumePct = na


if not na(volAvg) and volAvg > 0
    volumeDryPct := volDryAvg / volAvg * 100.0


if not na(volAvg) and volAvg > 0
    currentVolumePct := volume / volAvg * 100.0


bool volumeDry = false

bool breakoutVolume = false


if not na(volAvg) and volAvg > 0
    volumeDry := volDryAvg < volAvg * volumeDryRatio


if not na(volAvg) and volAvg > 0
    breakoutVolume := volume >= volAvg * breakoutVolumeRatio


//=============================================================================
// 28. DYNAMIC VCP PIVOT
//
// ta.pivothigh confirms a swing only after pivotRightBars have passed.
// We store the most recently confirmed swing high that occurred inside
// the current base lookback.
//=============================================================================

float rawPivotHigh = ta.pivothigh(high, pivotLeftBars, pivotRightBars)

var float dynamicPivot = na

var int dynamicPivotBar = na


if not na(rawPivotHigh)

    int candidatePivotBar = bar_index - pivotRightBars

    int candidateAge = bar_index - candidatePivotBar

    bool candidateInsideBase = candidateAge <= baseLookback

    if candidateInsideBase
        dynamicPivot := rawPivotHigh
        dynamicPivotBar := candidatePivotBar


//=============================================================================
// 29. DYNAMIC PIVOT AGE / VALIDITY
//=============================================================================

int pivotAge = na


if not na(dynamicPivotBar)
    pivotAge := bar_index - dynamicPivotBar


bool dynamicPivotValid = false


if not na(dynamicPivot) and not na(pivotAge)
    dynamicPivotValid := pivotAge <= maxPivotAge


//=============================================================================
// 30. OPTIONAL FALLBACK PIVOT
//=============================================================================

float fallbackPivot = ta.highest(high[1], fallbackPivotLookback)

float activePivot = na

string pivotSource = "NONE"


if dynamicPivotValid
    activePivot := dynamicPivot
    pivotSource := "DYNAMIC SWING"


if not dynamicPivotValid and allowFallbackPivot and not na(fallbackPivot)
    activePivot := fallbackPivot
    pivotSource := "FALLBACK HIGH"


//=============================================================================
// 31. PIVOT RELATIONSHIP
//=============================================================================

float distanceToPivotPct = na


if not na(activePivot) and activePivot > 0
    distanceToPivotPct := ((close - activePivot) / activePivot) * 100.0


bool nearPivot = false


if not na(distanceToPivotPct)
    nearPivot := distanceToPivotPct <= 0 and distanceToPivotPct >= -nearPivotPct


bool abovePivot = false


if not na(activePivot)
    abovePivot := close > activePivot


//=============================================================================
// 32. BREAKOUT
//=============================================================================

bool freshBreakout = false


if not na(activePivot)
    freshBreakout := close > activePivot and close[1] <= activePivot


bool confirmedBreakout = freshBreakout and breakoutVolume


//=============================================================================
// 33. PIVOT EXTENSION
//=============================================================================

float extensionFromPivotPct = na


if not na(activePivot) and activePivot > 0
    extensionFromPivotPct := ((close / activePivot) - 1.0) * 100.0


bool idealBuyZone = false


if abovePivot and not na(extensionFromPivotPct)
    idealBuyZone := extensionFromPivotPct >= 0 and extensionFromPivotPct <= idealMaxExtension


bool extendedFromPivot = false


if abovePivot and not na(extensionFromPivotPct)
    extendedFromPivot := extensionFromPivotPct > maxChasePct


//=============================================================================
// 34. EMA50 EXTENSION
//=============================================================================

float distanceEMA50Pct = na


if ema50 > 0
    distanceEMA50Pct := ((close / ema50) - 1.0) * 100.0


bool ema50TooExtended = false

bool ema50PositionGood = false


if not na(distanceEMA50Pct)
    ema50TooExtended := distanceEMA50Pct > maxEMA50Extension


if not na(distanceEMA50Pct)
    ema50PositionGood := distanceEMA50Pct >= 0 and distanceEMA50Pct <= maxEMA50Extension


//=============================================================================
// 35. SETUP SCORE 0-7
//
// +1 Base forming
// +1 40 -> 20 -> 10 contraction
// +1 ATR contracting
// +1 Final contraction tight
// +1 Volume dry-up
// +1 Near dynamic pivot
// +1 Strong RS
//=============================================================================

int setupScore = 0


if baseForming
    setupScore += 1


if multiContraction
    setupScore += 1


if atrContracting
    setupScore += 1


if finalTight
    setupScore += 1


if volumeDry
    setupScore += 1


if nearPivot
    setupScore += 1


if rsStrong
    setupScore += 1


//=============================================================================
// 36. VCP READY
//=============================================================================

bool pivotReady = dynamicPivotValid or allowFallbackPivot


bool vcpReady = trendScore >= minTrendForVCP and setupScore >= minSetupForVCP and pivotReady and close > ema50 and not ema50TooExtended


bool newVCPReady = vcpReady and not vcpReady[1]


//=============================================================================
// 37. LEADER BOTTOM FIRST
//=============================================================================

int leaderLookback = 60

float previousBenchmarkLow = ta.lowest(benchmarkClose[1], leaderLookback)

float previousStockLow = ta.lowest(low[1], leaderLookback)


bool marketAtNewLow = false

bool stockHoldsLow = false


if not na(previousBenchmarkLow)
    marketAtNewLow := benchmarkClose <= previousBenchmarkLow


if not na(previousStockLow)
    stockHoldsLow := low > previousStockLow


bool leaderBottomFirst = marketAtNewLow and stockHoldsLow and rs6WRising and rsAboveEMA20

bool newLeaderBottom = leaderBottomFirst and not leaderBottomFirst[1]


//=============================================================================
// 38. PHASE DETECTOR
//=============================================================================

string phase = "NOT READY"


if trendScore >= 6
    phase := "TREND ONLY"


if baseForming and trendScore >= 6
    phase := "BASE FORMING"


if baseForming and multiContraction
    phase := "CONTRACTING"


if baseForming and multiContraction and finalTight and volumeDry
    phase := "FINAL CONTRACTION"


if vcpReady
    phase := "VCP READY"


if confirmedBreakout
    phase := "BREAKOUT"


if extendedFromPivot or ema50TooExtended
    phase := "EXTENDED"


//=============================================================================
// 39. ENTRY STATUS
//=============================================================================

string entryStatus = "WAIT"


if nearPivot and vcpReady
    entryStatus := "WATCH PIVOT"


if confirmedBreakout
    entryStatus := "BREAKOUT CONFIRMED"


if idealBuyZone
    entryStatus := "IDEAL BUY ZONE"


if abovePivot and not na(extensionFromPivotPct)
    if extensionFromPivotPct > idealMaxExtension and extensionFromPivotPct <= maxChasePct
        entryStatus := "CAUTION"


if extendedFromPivot
    entryStatus := "DO NOT CHASE"


//=============================================================================
// 40. QUALITY STATUS
//=============================================================================

string qualityStatus = "NOT READY"


if trendScore >= 6 and rsScore >= 4
    qualityStatus := "WATCHLIST"


if trendPass
    qualityStatus := "TREND PASS"


if trendPass and rsScore >= 5
    qualityStatus := "A CANDIDATE"


if trendPass and rsScore >= 6 and setupScore >= minSetupForVCP
    qualityStatus := "A+ SETUP"


//=============================================================================
// 41. PLOT DYNAMIC PIVOT
//=============================================================================

plot(showPivot ? activePivot : na, title="Dynamic VCP Pivot", color=pivotColor, linewidth=2, style=plot.style_linebr)


//=============================================================================
// 42. BACKGROUND
//=============================================================================

color chartBackground = na


if highlightQualified and trendPass
    chartBackground := color.new(color.green, 93)


bgcolor(chartBackground)


//=============================================================================
// 43. SIGNALS
//=============================================================================

plotshape(showSignals and newTrendPass, title="Trend 8/8", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny, text="8/8", textcolor=color.white)

plotshape(showSignals and newRSLead, title="RS Leads Price", style=shape.diamond, location=location.belowbar, color=color.aqua, size=size.tiny, text="RS", textcolor=color.black)

plotshape(showSignals and newVCPReady, title="VCP Ready", style=shape.circle, location=location.belowbar, color=color.yellow, size=size.small, text="VCP", textcolor=color.black)

plotshape(showSignals and confirmedBreakout, title="Confirmed Breakout", style=shape.triangleup, location=location.belowbar, color=color.fuchsia, size=size.small, text="BO", textcolor=color.white)

plotshape(showSignals and newLeaderBottom, title="Leader Bottom First", style=shape.circle, location=location.belowbar, color=color.orange, size=size.tiny, text="L", textcolor=color.black)


//=============================================================================
// 44. ALERTS
//=============================================================================

alertcondition(newTrendPass, title="Minervini 8/8 PASS", message="Stock newly passes Minervini Trend Template 8/8.")

alertcondition(newVCPReady, title="VCP Ready", message="Stock entered VCP READY phase near a confirmed dynamic swing pivot.")

alertcondition(confirmedBreakout, title="Confirmed Dynamic Pivot Breakout", message="Stock broke the dynamic VCP pivot with expanding volume.")

alertcondition(newRSLead, title="RS Leads Price", message="Relative Strength made a new high before stock price.")

alertcondition(newLeaderBottom, title="Leader Bottom First", message="Possible Leader Bottom First behavior detected.")


//=============================================================================
// 45. DASHBOARD COLORS
//=============================================================================

color passColor = color.rgb(0, 145, 90)

color failColor = color.rgb(190, 55, 55)

color warningColor = color.rgb(210, 135, 0)

color neutralColor = color.rgb(90, 95, 105)

color strongColor = color.rgb(0, 165, 155)

color purpleColor = color.rgb(120, 80, 180)

color blueColor = color.rgb(40, 125, 180)

color headerColor = color.rgb(25, 30, 40)

color sectionColor = color.rgb(45, 55, 70)


//=============================================================================
// 46. DASHBOARD POSITION
//=============================================================================

string dashPos = position.top_right


if dashboardPosition == "Top Left"
    dashPos := position.top_left


if dashboardPosition == "Top Right"
    dashPos := position.top_right


if dashboardPosition == "Bottom Left"
    dashPos := position.bottom_left


if dashboardPosition == "Bottom Right"
    dashPos := position.bottom_right


//=============================================================================
// 47. DASHBOARD TEXT SIZE
//=============================================================================

string dashTextSize = size.small


if dashboardSize == "Tiny"
    dashTextSize := size.tiny


if dashboardSize == "Small"
    dashTextSize := size.small


if dashboardSize == "Normal"
    dashTextSize := size.normal


//=============================================================================
// 48. TABLE
//=============================================================================

var table dash = table.new(dashPos, 3, 16, bgcolor=color.new(color.black, 5), frame_color=color.gray, frame_width=1, border_color=color.new(color.gray, 65), border_width=1)


//=============================================================================
// 49. DASHBOARD
//=============================================================================

if barstate.islast

    //---------------------------------------------------------------------
    // CLEAR
    //---------------------------------------------------------------------

    for row = 0 to 15
        for col = 0 to 2
            table.cell(dash, col, row, "", bgcolor=color.new(color.black, 5), text_color=color.white, text_size=dashTextSize)


    //---------------------------------------------------------------------
    // TIMEFRAME
    //---------------------------------------------------------------------

    string tfText = "USE 1D"

    color tfColor = failColor


    if timeframe.isdaily
        tfText := "1D OK"
        tfColor := passColor


    //---------------------------------------------------------------------
    // HEADER
    //---------------------------------------------------------------------

    table.cell(dash, 0, 0, syminfo.ticker, bgcolor=headerColor, text_color=color.white, text_size=dashTextSize)

    table.cell(dash, 1, 0, dashboardPage, bgcolor=headerColor, text_color=color.white, text_size=dashTextSize)

    table.cell(dash, 2, 0, tfText, bgcolor=tfColor, text_color=color.white, text_size=dashTextSize)


    //=========================================================================
    // PAGE 1 - TREND
    //=========================================================================

    if dashboardPage == "1 - Trend"

        table.cell(dash, 0, 1, "MINERVINI TREND", bgcolor=sectionColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 1, trendPass ? "PASS" : "FAIL", bgcolor=trendPass ? passColor : failColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 1, str.tostring(trendScore) + "/8", bgcolor=sectionColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 2, "1 Price > EMA150/200", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 2, cond1 ? "PASS" : "FAIL", bgcolor=cond1 ? passColor : failColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 2, str.tostring(close, format.mintick), text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 3, "2 EMA150 > EMA200", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 3, cond2 ? "PASS" : "FAIL", bgcolor=cond2 ? passColor : failColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 4, "3 EMA200 Rising", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 4, cond3 ? "PASS" : "FAIL", bgcolor=cond3 ? passColor : failColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 4, str.tostring(ema200SlopeDays) + "D", text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 5, "4 EMA50 > EMA150/200", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 5, cond4 ? "PASS" : "FAIL", bgcolor=cond4 ? passColor : failColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 6, "5 Above 52W Low", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 6, cond5 ? "PASS" : "FAIL", bgcolor=cond5 ? passColor : failColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 6, "+" + str.tostring(pctAbove52Low, "#.1") + "%", text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 7, "6 Near 52W High", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 7, cond6 ? "PASS" : "FAIL", bgcolor=cond6 ? passColor : failColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 7, "-" + str.tostring(pctBelow52High, "#.1") + "%", text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 8, "7 Relative Strength", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 8, cond7 ? "PASS" : "FAIL", bgcolor=cond7 ? passColor : failColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 8, rsMode, text_color=color.yellow, text_size=dashTextSize)


        table.cell(dash, 0, 9, "8 Price > EMA50", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 9, cond8 ? "PASS" : "FAIL", bgcolor=cond8 ? passColor : failColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 10, "EMA50", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 10, str.tostring(ema50, format.mintick), text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 11, "EMA150", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 11, str.tostring(ema150, format.mintick), text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 12, "EMA200", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 12, str.tostring(ema200, format.mintick), text_color=color.white, text_size=dashTextSize)


        string emaStatus = "BELOW"

        color emaStatusColor = warningColor


        if ema50PositionGood
            emaStatus := "GOOD"
            emaStatusColor := passColor


        if ema50TooExtended
            emaStatus := "EXTENDED"
            emaStatusColor := failColor


        table.cell(dash, 0, 13, "Price vs EMA50", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 13, emaStatus, bgcolor=emaStatusColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 13, str.tostring(distanceEMA50Pct, "#.1") + "%", text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 14, "52W High Distance", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 14, "-" + str.tostring(pctBelow52High, "#.1") + "%", text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 15, "QUALITY", bgcolor=headerColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 15, qualityStatus, bgcolor=trendPass ? passColor : warningColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 15, str.tostring(trendScore) + "/8", bgcolor=headerColor, text_color=color.white, text_size=dashTextSize)


    //=========================================================================
    // PAGE 2 - RELATIVE STRENGTH
    //=========================================================================

    if dashboardPage == "2 - Relative Strength"

        string rsQuality = "WEAK"

        color rsQualityColor = failColor


        if rsScore >= 4
            rsQuality := "GOOD"
            rsQualityColor := passColor


        if rsScore >= 6
            rsQuality := "STRONG"
            rsQualityColor := strongColor


        table.cell(dash, 0, 1, "RELATIVE STRENGTH", bgcolor=sectionColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 1, rsQuality, bgcolor=rsQualityColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 1, str.tostring(rsScore) + "/7", bgcolor=sectionColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 2, "Benchmark", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 2, benchmarkSymbol, text_color=color.yellow, text_size=dashTextSize)


        table.cell(dash, 0, 3, "RS 6 Weeks", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 3, rs6WRising ? "UP" : "DOWN", bgcolor=rs6WRising ? passColor : failColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 4, "RS 13 Weeks", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 4, rs13WRising ? "UP" : "DOWN", bgcolor=rs13WRising ? passColor : failColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 5, "RS > EMA20", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 5, rsAboveEMA20 ? "PASS" : "FAIL", bgcolor=rsAboveEMA20 ? passColor : failColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 6, "RS EMA20 > EMA50", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 6, rsEMA20Above50 ? "PASS" : "FAIL", bgcolor=rsEMA20Above50 ? passColor : failColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 7, "RS EMA20 Rising", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 7, rsEMA20Rising ? "YES" : "NO", bgcolor=rsEMA20Rising ? passColor : failColor, text_color=color.white, text_size=dashTextSize)


        string rsHighStatus = "NO"

        color rsHighColor = neutralColor


        if rsNearHigh
            rsHighStatus := "NEAR HIGH"
            rsHighColor := passColor


        if rsNewHigh
            rsHighStatus := "NEW HIGH"
            rsHighColor := strongColor


        table.cell(dash, 0, 8, "RS 52W High", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 8, rsHighStatus, bgcolor=rsHighColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 9, "RS Leads Price", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 9, rsLeadsPrice ? "YES" : "NO", bgcolor=rsLeadsPrice ? strongColor : neutralColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 10, "Leader Bottom First", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 10, leaderBottomFirst ? "DETECTED" : "NO", bgcolor=leaderBottomFirst ? strongColor : neutralColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 11, "RS Line", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 11, str.tostring(rsLine, "#.######"), text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 12, "RS Mode", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 12, rsMode, text_color=color.yellow, text_size=dashTextSize)


        table.cell(dash, 0, 13, "Trend Score", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 13, str.tostring(trendScore) + "/8", bgcolor=trendPass ? passColor : warningColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 14, "RS Score", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 14, str.tostring(rsScore) + "/7", bgcolor=rsQualityColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 15, "RS STATUS", bgcolor=headerColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 15, rsStrong ? "LEADER" : "NOT LEADER", bgcolor=rsStrong ? strongColor : neutralColor, text_color=color.white, text_size=dashTextSize)


    //=========================================================================
    // PAGE 3 - VCP SETUP
    //=========================================================================

    if dashboardPage == "3 - VCP Setup"

        color phaseColor = warningColor


        if phase == "NOT READY"
            phaseColor := neutralColor


        if phase == "TREND ONLY"
            phaseColor := warningColor


        if phase == "BASE FORMING"
            phaseColor := warningColor


        if phase == "CONTRACTING"
            phaseColor := blueColor


        if phase == "FINAL CONTRACTION"
            phaseColor := passColor


        if phase == "VCP READY"
            phaseColor := strongColor


        if phase == "BREAKOUT"
            phaseColor := purpleColor


        if phase == "EXTENDED"
            phaseColor := failColor


        table.cell(dash, 0, 1, "VCP SETUP", bgcolor=sectionColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 1, phase, bgcolor=phaseColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 1, str.tostring(setupScore) + "/7", bgcolor=sectionColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 2, "Base Forming", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 2, baseForming ? "YES" : "NO", bgcolor=baseForming ? passColor : neutralColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 2, str.tostring(baseDepthPct, "#.1") + "%", text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 3, "40D Range", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 3, str.tostring(longRangePct, "#.1") + "%", text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 4, "20D Range", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 4, str.tostring(midRangePct, "#.1") + "%", text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 5, "10D Range", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 5, str.tostring(shortRangePct, "#.1") + "%", bgcolor=finalTight ? passColor : neutralColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 6, "40 > 20 > 10", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 6, multiContraction ? "YES" : "NO", bgcolor=multiContraction ? passColor : neutralColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 7, "Final Tightness", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 7, finalTight ? "TIGHT" : "WIDE", bgcolor=finalTight ? passColor : neutralColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 8, "ATR Contracting", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 8, atrContracting ? "YES" : "NO", bgcolor=atrContracting ? passColor : neutralColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 8, str.tostring(atrShort, "#.2") + "%", text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 9, "Volume Dry-Up", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 9, volumeDry ? "YES" : "NO", bgcolor=volumeDry ? passColor : neutralColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 9, str.tostring(volumeDryPct, "#") + "%", text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 10, "Near Pivot", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 10, nearPivot ? "YES" : "NO", bgcolor=nearPivot ? passColor : neutralColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 11, "RS Strong", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 11, rsStrong ? "YES" : "NO", bgcolor=rsStrong ? passColor : neutralColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 11, str.tostring(rsScore) + "/7", text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 12, "Setup Score", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 12, str.tostring(setupScore) + "/7", bgcolor=setupScore >= minSetupForVCP ? strongColor : warningColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 13, "Trend Score", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 13, str.tostring(trendScore) + "/8", bgcolor=trendScore >= minTrendForVCP ? passColor : warningColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 14, "VCP Ready", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 14, vcpReady ? "YES" : "NO", bgcolor=vcpReady ? strongColor : neutralColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 15, "PHASE", bgcolor=headerColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 15, phase, bgcolor=phaseColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 15, str.tostring(setupScore) + "/7", bgcolor=headerColor, text_color=color.white, text_size=dashTextSize)


    //=========================================================================
    // PAGE 4 - PIVOT AND ENTRY
    //=========================================================================

    if dashboardPage == "4 - Pivot and Entry"

        string pivotStatus = "NO PIVOT"

        color pivotStatusColor = neutralColor


        if dynamicPivotValid
            pivotStatus := "CONFIRMED"
            pivotStatusColor := passColor


        if not dynamicPivotValid and allowFallbackPivot and not na(activePivot)
            pivotStatus := "FALLBACK"
            pivotStatusColor := warningColor


        table.cell(dash, 0, 1, "DYNAMIC VCP PIVOT", bgcolor=sectionColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 1, pivotStatus, bgcolor=pivotStatusColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 1, pivotSource, bgcolor=sectionColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 2, "Pivot Price", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 2, str.tostring(activePivot, format.mintick), text_color=color.yellow, text_size=dashTextSize)


        table.cell(dash, 0, 3, "Pivot Age", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 3, str.tostring(pivotAge) + " bars", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 3, "Max " + str.tostring(maxPivotAge), text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 4, "Distance to Pivot", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 4, str.tostring(distanceToPivotPct, "#.2") + "%", bgcolor=nearPivot ? passColor : neutralColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 5, "Near Pivot", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 5, nearPivot ? "YES" : "NO", bgcolor=nearPivot ? passColor : neutralColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 6, "Breakout Volume", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 6, breakoutVolume ? "EXPANDING" : "NO", bgcolor=breakoutVolume ? strongColor : neutralColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 6, str.tostring(currentVolumePct, "#") + "% AVG", text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 7, "Breakout", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 7, confirmedBreakout ? "CONFIRMED" : "NO", bgcolor=confirmedBreakout ? purpleColor : neutralColor, text_color=color.white, text_size=dashTextSize)


        string pivotExtensionStatus = "BELOW"

        color pivotExtensionColor = neutralColor


        if abovePivot
            pivotExtensionStatus := "ABOVE"
            pivotExtensionColor := warningColor


        if idealBuyZone
            pivotExtensionStatus := "IDEAL"
            pivotExtensionColor := strongColor


        if extendedFromPivot
            pivotExtensionStatus := "DO NOT CHASE"
            pivotExtensionColor := failColor


        table.cell(dash, 0, 8, "Pivot Extension", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 8, pivotExtensionStatus, bgcolor=pivotExtensionColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 8, str.tostring(extensionFromPivotPct, "#.2") + "%", text_color=color.white, text_size=dashTextSize)


        string emaEntryStatus = "BELOW"

        color emaEntryColor = warningColor


        if ema50PositionGood
            emaEntryStatus := "GOOD"
            emaEntryColor := passColor


        if ema50TooExtended
            emaEntryStatus := "EXTENDED"
            emaEntryColor := failColor


        table.cell(dash, 0, 9, "Price vs EMA50", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 9, emaEntryStatus, bgcolor=emaEntryColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 9, str.tostring(distanceEMA50Pct, "#.1") + "%", text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 10, "VCP Ready", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 10, vcpReady ? "YES" : "NO", bgcolor=vcpReady ? strongColor : neutralColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 11, "Trend / RS", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 11, str.tostring(trendScore) + "/8", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 11, "RS " + str.tostring(rsScore) + "/7", text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 12, "Setup", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 12, str.tostring(setupScore) + "/7", bgcolor=setupScore >= minSetupForVCP ? strongColor : warningColor, text_color=color.white, text_size=dashTextSize)


        table.cell(dash, 0, 13, "Quality", text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 13, qualityStatus, bgcolor=qualityStatus == "A+ SETUP" ? strongColor : warningColor, text_color=color.white, text_size=dashTextSize)


        color entryColor = neutralColor


        if entryStatus == "WATCH PIVOT"
            entryColor := passColor


        if entryStatus == "BREAKOUT CONFIRMED"
            entryColor := purpleColor


        if entryStatus == "IDEAL BUY ZONE"
            entryColor := strongColor


        if entryStatus == "CAUTION"
            entryColor := warningColor


        if entryStatus == "DO NOT CHASE"
            entryColor := failColor


        table.cell(dash, 0, 14, "ENTRY STATUS", bgcolor=sectionColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 14, entryStatus, bgcolor=entryColor, text_color=color.white, text_size=dashTextSize)


        string actionText = "WAIT"

        color actionColor = neutralColor


        if vcpReady
            actionText := "WATCH BREAKOUT"
            actionColor := passColor


        if confirmedBreakout
            actionText := "CHECK ENTRY"
            actionColor := purpleColor


        if idealBuyZone
            actionText := "IDEAL BUY ZONE"
            actionColor := strongColor


        if extendedFromPivot
            actionText := "NO CHASE"
            actionColor := failColor


        table.cell(dash, 0, 15, "ACTION", bgcolor=headerColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 1, 15, actionText, bgcolor=actionColor, text_color=color.white, text_size=dashTextSize)

        table.cell(dash, 2, 15, phase, bgcolor=headerColor, text_color=color.white, text_size=dashTextSize)