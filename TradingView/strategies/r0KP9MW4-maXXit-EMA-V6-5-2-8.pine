    if dashboardSize == 'Large'
        table.merge_cells(dashboard, 0, row, 4, row)
        table.cell(dashboard, 0, row, '═══  PERFORMANCE  ═══', text_color = c_blue, bgcolor = bg_gray, text_formatting = text.format_bold, text_size = dash_text_size)
