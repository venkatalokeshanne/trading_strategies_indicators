//@version=6
indicator("EURUSD Bullish / Bearish Indicator", overlay=true)

// Settings
emaFastLength = input.int(50, "EMA 50")
emaSlowLength = input.int(200, "EMA 200")
rsiLength = input.int(14, "RSI Length")

macdFast = input.int(12, "MACD Fast")
macdSlow = input.int(26, "MACD Slow")
macdSignal = input.int(9, "MACD Signal")

// Indicators
ema50 = ta.ema(close, emaFastLength)
ema200 = ta.ema(close, emaSlowLength)
rsi = ta.rsi(close, rsiLength)

[macdLine, signalLine, hist] = ta.macd(close, macdFast, macdSlow, macdSignal)

// Scoring
int bullScore = 0
int bearScore = 0

if ema50 > ema200
    bullScore := bullScore + 1
else
    bearScore := bearScore + 1

if close > ema50
    bullScore := bullScore + 1
else
    bearScore := bearScore + 1

if rsi > 50
    bullScore := bullScore + 1
else
    bearScore := bearScore + 1

if macdLine > signalLine
    bullScore := bullScore + 1
else
    bearScore := bearScore + 1

if hist > 0
    bullScore := bullScore + 1
else
    bearScore := bearScore + 1

// Market direction
bullish = bullScore >= 4
bearish = bearScore >= 4

// Background
bgcolor(bullish ? color.new(color.green, 90) : bearish ? color.new(color.red, 90) : color.new(color.gray, 92))

// EMA plots
plot(ema50, title="EMA 50", color=color.orange, linewidth=2)
plot(ema200, title="EMA 200", color=color.blue, linewidth=2)

// Dashboard
var table dashboard = table.new(position.top_right, 2, 5, border_width=1)

if barstate.islast
    table.cell(dashboard, 0, 0, "EURUSD", bgcolor=color.black, text_color=color.white)
    table.cell(dashboard, 1, 0, "MARKET BIAS", bgcolor=color.black, text_color=color.white)

    string direction = "⚪ NEUTRAL"
    color directionColor = color.gray

    if bullish
        direction := "🟢 BULLISH"
        directionColor := color.green
    else if bearish
        direction := "🔴 BEARISH"
        directionColor := color.red

    table.cell(dashboard, 0, 1, "Direction", bgcolor=color.rgb(40, 40, 40), text_color=color.white)
    table.cell(dashboard, 1, 1, direction, bgcolor=directionColor, text_color=color.white)

    table.cell(dashboard, 0, 2, "Bull Score", bgcolor=color.rgb(40, 40, 40), text_color=color.white)
    table.cell(dashboard, 1, 2, str.tostring(bullScore) + " / 5", text_color=color.green)

    table.cell(dashboard, 0, 3, "Bear Score", bgcolor=color.rgb(40, 40, 40), text_color=color.white)
    table.cell(dashboard, 1, 3, str.tostring(bearScore) + " / 5", text_color=color.red)

    table.cell(dashboard, 0, 4, "RSI", bgcolor=color.rgb(40, 40, 40), text_color=color.white)
    table.cell(dashboard, 1, 4, str.tostring(rsi, "#.0"), text_color=rsi > 50 ? color.green : color.red)

// Alerts
bullishChange = bullish and not bullish[1]
bearishChange = bearish and not bearish[1]

alertcondition(bullishChange, title="EURUSD BULLISH", message="EURUSD has turned BULLISH.")
alertcondition(bearishChange, title="EURUSD BEARISH", message="EURUSD has turned BEARISH.")
