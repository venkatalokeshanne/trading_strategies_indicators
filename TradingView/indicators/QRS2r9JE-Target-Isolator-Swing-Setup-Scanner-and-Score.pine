//@version=6
// Target Isolator — standalone swing-setup scanner (needs no other indicator).
// Funnel: strong sector/industry -> relative strength -> 4-MA swing -> HTF confirm -> liquidity -> Score
// Use on a chart for the dashboard, OR add to the Pine Screener and sort by "Score" desc (filter Pass = 1).
// v19.1 (2026-08-12) — Score pane scales to the Score. Screener columns moved to data window /
// status line only, so they no longer feed the pane's auto-scale. Liquidity row rolls to "B".
indicator("Target Isolator", "Isolator", overlay = false)

// ─────────────────────────────  INPUTS  ─────────────────────────────
grpRS  = "Relative Strength"
benchSym = input.symbol("AMEX:SPY", "Benchmark", group = grpRS)
rsLen    = input.int(60, "RS lookback (bars)", minval = 5, group = grpRS)
useIndustry = input.bool(true, "Use sharp industry ETF when available (SMH, IGV, XBI…)", group = grpRS)

grpSTS = "4-MA Ribbon"
maType = input.string("EMA", "MA type", options = ["EMA", "SMA"], group = grpSTS)
l1 = input.int(10,  "MA1 Fast", minval = 1, group = grpSTS)
l2 = input.int(20,  "MA2",      minval = 1, group = grpSTS)
l3 = input.int(50,  "MA3",      minval = 1, group = grpSTS)
l4 = input.int(100, "MA4 Slow", minval = 1, group = grpSTS)

grpMTF = "Higher-Timeframe Confirm"
useMTF = input.bool(true, "Require HTF trend up", group = grpMTF)
htfTF  = input.timeframe("W", "Higher timeframe", group = grpMTF)

grpLIQ = "Liquidity Filter (swing-quality preset)"
minPrice = input.float(10.0, "Min price $", minval = 0, group = grpLIQ)
minDV    = input.float(50.0, "Min avg $-volume (millions)", minval = 0, group = grpLIQ)
dvLen    = input.int(20, "Avg $-vol lookback", minval = 1, group = grpLIQ)

grpW = "Composite Weights (sum ~1.0)"
wSector = input.float(0.30, "Group strength", minval = 0, maxval = 1, step = 0.05, group = grpW)
wStock  = input.float(0.30, "Stock RS",       minval = 0, maxval = 1, step = 0.05, group = grpW)
wSTS    = input.float(0.40, "Swing setup",    minval = 0, maxval = 1, step = 0.05, group = grpW)

grpDash = "Dashboard"
showTable = input.bool(true, "Show table on chart", group = grpDash)
tablePos  = input.string("Top Left", "Table position", options = ["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group = grpDash)
tableSize = input.string("Normal", "Table text size", options = ["Tiny", "Small", "Normal", "Large"], group = grpDash)
showETFrows = input.bool(false, "Show ETF mapping rows (Sector/Hot Group ETF)", group = grpDash)

grpTheme = "Theme & Colors"
darkMode = input.bool(true,  "Dark theme (uncheck for light charts)", group = grpTheme)
colGood  = input.color(#089981, "Bullish", group = grpTheme, inline = "c1")
colWarn  = input.color(#ff9800, "Neutral", group = grpTheme, inline = "c1")
colBad   = input.color(#f23645, "Bearish", group = grpTheme, inline = "c1")
colAccent = input.color(#4789d1, "Accent (BlueBeck blue)", group = grpTheme)

// ───────────  SYMBOL OVERRIDE  (fix TradingView misclassifications)  ─
symOverride = switch syminfo.ticker
    "AMAT" => "SMH"
    "LRCX" => "SMH"
    "KLAC" => "SMH"
    "ASML" => "SMH"
    "TER"  => "SMH"
    "ENTG" => "SMH"
    "MKSI" => "SMH"
    "AMKR" => "SMH"
    "ONTO" => "SMH"
    "COHR" => "SMH"
    "ARM"  => "SMH"
    => ""

// ─────────────────────  SECTOR → BROAD SPDR ETF  ────────────────────
sectorETF = switch syminfo.sector
    "Technology Services"    => "AMEX:XLK"
    "Electronic Technology"  => "AMEX:XLK"
    "Communications"         => "AMEX:XLC"
    "Finance"                => "AMEX:XLF"
    "Health Technology"      => "AMEX:XLV"
    "Health Services"        => "AMEX:XLV"
    "Energy Minerals"        => "AMEX:XLE"
    "Utilities"              => "AMEX:XLU"
    "Consumer Durables"      => "AMEX:XLY"
    "Consumer Services"      => "AMEX:XLY"
    "Retail Trade"           => "AMEX:XLY"
    "Consumer Non-Durables"  => "AMEX:XLP"
    "Producer Manufacturing" => "AMEX:XLI"
    "Industrial Services"    => "AMEX:XLI"
    "Commercial Services"    => "AMEX:XLI"
    "Distribution Services"  => "AMEX:XLI"
    "Transportation"         => "AMEX:XLI"
    "Process Industries"     => "AMEX:XLB"
    "Non-Energy Minerals"    => "AMEX:XLB"
    => "AMEX:SPY"

// ─────────────────  INDUSTRY → SHARP THEMATIC ETF  ──────────────────
industryETF = switch syminfo.industry
    "Semiconductors"             => "SMH"
    "Electronic Components"      => "SMH"
    "Electronic Production Equipment" => "SMH"
    "Packaged Software"          => "IGV"
    "Internet Software/Services" => "IGV"
    "Information Technology Services" => "IGV"
    "Major Banks"                => "KBE"
    "Regional Banks"             => "KRE"
    "Biotechnology"              => "XBI"
    "Pharmaceuticals: Major"     => "XPH"
    "Medical Specialties"        => "IHI"
    "Oil & Gas Production"       => "XOP"
    "Oilfield Services/Equipment"=> "OIH"
    "Oil & Gas Pipelines"        => "AMLP"
    "Homebuilding"               => "XHB"
    "Aerospace & Defense"        => "ITA"
    "Airlines"                   => "JETS"
    "Internet Retail"            => "XRT"
    "Specialty Stores"           => "XRT"
    "Apparel/Footwear Retail"    => "XRT"
    "Gold"                       => "GDX"
    "Precious Metals"            => "GDX"
    "Steel"                      => "SLX"
    "Other Metals/Minerals"      => "XME"
    "Alternative Power Generation" => "TAN"
    => sectorETF

groupETF = symOverride != "" ? symOverride : (useIndustry ? industryETF : sectorETF)

// ───────────────────────────  DATA PULLS  ───────────────────────────
spyClose = request.security(benchSym,  timeframe.period, close)
secClose = request.security(sectorETF, timeframe.period, close)
grpClose = request.security(groupETF,  timeframe.period, close)

roc(src, len) => na(src[len]) or src[len] == 0 ? na : (src - src[len]) / src[len] * 100.0
stockRoc = roc(close,    rsLen)
spyRoc   = roc(spyClose, rsLen)
secRoc   = roc(secClose, rsLen)
grpRoc   = roc(grpClose, rsLen)

sectorRS = secRoc   - spyRoc
groupRS  = grpRoc   - spyRoc
stockRSm = stockRoc - spyRoc
stockRSg = stockRoc - grpRoc

// ───────────────────────────  4-MA RIBBON  ──────────────────────────
ma(src, len) => maType == "EMA" ? ta.ema(src, len) : ta.sma(src, len)
m1 = ma(close, l1), m2 = ma(close, l2), m3 = ma(close, l3), m4 = ma(close, l4)

bullStack = m1 > m2 and m2 > m3 and m3 > m4
stsBuy = bullStack and close > m1
stsDip = bullStack and close <= m1 and close > m3
stsNum = stsBuy ? 2 : stsDip ? 1 : bullStack ? 0.5 : -1
stsTxt = stsBuy ? "BUY" : stsDip ? "DIP" : bullStack ? "HOLD" : "AVOID"

// ─────────────────────  HIGHER-TIMEFRAME CONFIRM  ───────────────────
htfStack = request.security(syminfo.tickerid, htfTF, bullStack, lookahead = barmerge.lookahead_off)
htfBuy   = request.security(syminfo.tickerid, htfTF, stsBuy,    lookahead = barmerge.lookahead_off)
mtfOK    = not useMTF or htfStack
htfTxt   = htfBuy ? "BUY" : htfStack ? "UP" : "—"

// ───────────  FRESHNESS  ─────────────────────────────────────────────
buyStart  = stsBuy and not stsBuy[1]
ageBars   = ta.barssince(buyStart)

// ─────────────────────────  LIQUIDITY FILTER  ───────────────────────
avgDV  = ta.sma(close * volume, dvLen)
dvM    = avgDV / 1e6
liquid = close >= minPrice and avgDV >= minDV * 1e6

// ─────────────────────────  COMPOSITE SCORE  ────────────────────────
scale(x, lo, hi) => 100.0 * (math.min(math.max(x, lo), hi) - lo) / (hi - lo)
groupScore = scale(groupRS, -8, 8)
stockScore = (scale(stockRSm, -15, 15) + scale(stockRSg, -15, 15)) / 2.0
stsScore   = stsBuy ? 100.0 : stsDip ? 70.0 : bullStack ? 50.0 : 15.0
stsScoreMtf = stsScore * (not useMTF ? 1.0 : htfStack ? 1.0 : 0.5)
wSum  = wSector + wStock + wSTS
score = (wSector * groupScore + wStock * stockScore + wSTS * stsScoreMtf) / (wSum == 0 ? 1 : wSum)

// Group RS uses a per-symbol dynamic ETF lookup (sector/industry -> ETF) that the Pine
// Screener does not resolve correctly — it silently falls back to SPY for every symbol,
// which would make Pass impossible to ever hit inside the Screener. Group RS still counts
// toward the Score and still shows correctly on the chart dashboard; it's just not part of
// the strict Pass gate, so Pass stays meaningful in both places.
pass = liquid and stsBuy and mtfOK and stockRSm > 0 ? 1 : 0

// ──────────────────────  SCREENER COLUMNS (plots)  ──────────────────
// Only Score draws in the pane. The rest are Pine Screener / data-window columns:
// `color = na` hides the LINE but the series still counts toward the pane's auto-scale,
// and the unbounded ones ($Vol in the 1000s, BUY age in the 100s) stretched the axis until
// Score and the 50 mid-line collapsed to a hairline — and did it differently per symbol.
// `display.data_window + display.status_line` keeps them readable and keeps them as screener
// columns, while removing them from the pane scale.
colsOnly = display.data_window + display.status_line
plot(score,    "Score",      color = colAccent)
plot(pass,     "Pass",       color = na, display = colsOnly)
plot(groupRS,  "Group RS",   color = na, display = colsOnly)
plot(stockRSm, "Stock RS",   color = na, display = colsOnly)
plot(stockRSg, "Stock vs Group", color = na, display = colsOnly)
plot(stsNum,   "Swing",      color = na, display = colsOnly)
plot(htfStack ? 1 : 0, "HTF up", color = na, display = colsOnly)
plot(ageBars,  "BUY age (bars)", color = na, display = colsOnly)
plot(dvM,      "$Vol (M)",   color = na, display = colsOnly)
hline(50, "Mid", color = color.new(color.gray, 60))

// ──────────────────────────  THEME  ─────────────────────────────────
// BlueBeck brand: navy #0a1527 · gold #c0a571 · blue #4789d1
c_navy   = #0a1527
c_gold   = #c0a571
c_bodyBg = darkMode ? color.new(#0e1a2f, 6)  : color.new(#ffffff, 4)
c_lbl    = darkMode ? #9aa4b2 : #5b6470
c_txt    = darkMode ? #e8e8ec : #0a1527
c_grid   = darkMode ? color.new(#2a3950, 0)  : color.new(#d0d4dc, 0)

// ──────────────────────────  DASHBOARD TABLE  ───────────────────────
// force_overlay = true → the dashboard renders on the MAIN price chart,
// while the Score plot stays in its own pane below.
f_col(x, lo, hi) => x >= hi ? colGood : x <= lo ? colBad : colWarn
strip(s) => str.replace(s, "AMEX:", "")
tpos = switch tablePos
    "Top Left"      => position.top_left
    "Top Center"    => position.top_center
    "Top Right"     => position.top_right
    "Middle Left"   => position.middle_left
    "Middle Center" => position.middle_center
    "Middle Right"  => position.middle_right
    "Bottom Left"   => position.bottom_left
    "Bottom Center" => position.bottom_center
    =>                 position.bottom_right
tsz = switch tableSize
    "Tiny"  => size.tiny
    "Small" => size.small
    "Large" => size.large
    =>         size.normal

if showTable and barstate.islast
    var table t = table.new(tpos, 2, 13, border_width = 1, border_color = c_grid, frame_color = c_gold, frame_width = 1, force_overlay = true)
    table.set_position(t, tpos)
    row = 0
    table.cell(t, 0, row, "TARGET ISOLATOR", text_color = c_gold, bgcolor = c_navy, text_size = tsz)
    table.cell(t, 1, row, syminfo.ticker, text_color = color.white, bgcolor = c_navy, text_size = tsz)
    row += 1
    table.cell(t, 0, row, "Sector", text_color = c_lbl, bgcolor = c_bodyBg, text_size = tsz)
    table.cell(t, 1, row, na(syminfo.sector) ? "—" : syminfo.sector, text_color = c_txt, bgcolor = c_bodyBg, text_size = tsz)
    row += 1
    table.cell(t, 0, row, "Industry", text_color = c_lbl, bgcolor = c_bodyBg, text_size = tsz)
    table.cell(t, 1, row, na(syminfo.industry) ? "—" : syminfo.industry, text_color = c_txt, bgcolor = c_bodyBg, text_size = tsz)
    row += 1
    if showETFrows
        table.cell(t, 0, row, "Sector ETF", text_color = c_lbl, bgcolor = c_bodyBg, text_size = tsz)
        table.cell(t, 1, row, strip(sectorETF), text_color = c_txt, bgcolor = c_bodyBg, text_size = tsz)
        row += 1
        table.cell(t, 0, row, "Hot Group ETF", text_color = c_lbl, bgcolor = c_bodyBg, text_size = tsz)
        table.cell(t, 1, row, strip(groupETF), text_color = groupETF != sectorETF ? colAccent : c_txt, bgcolor = c_bodyBg, text_size = tsz)
        row += 1
    table.cell(t, 0, row, "Group RS", text_color = c_lbl, bgcolor = c_bodyBg, text_size = tsz)
    table.cell(t, 1, row, str.tostring(groupRS, "#.0") + "%", text_color = f_col(groupRS, -2, 2), bgcolor = c_bodyBg, text_size = tsz)
    row += 1
    table.cell(t, 0, row, "Stock RS vs SPY", text_color = c_lbl, bgcolor = c_bodyBg, text_size = tsz)
    table.cell(t, 1, row, str.tostring(stockRSm, "#.0") + "%", text_color = f_col(stockRSm, -2, 2), bgcolor = c_bodyBg, text_size = tsz)
    row += 1
    table.cell(t, 0, row, "Stock vs Group", text_color = c_lbl, bgcolor = c_bodyBg, text_size = tsz)
    table.cell(t, 1, row, str.tostring(stockRSg, "#.0") + "%", text_color = f_col(stockRSg, -2, 2), bgcolor = c_bodyBg, text_size = tsz)
    row += 1
    table.cell(t, 0, row, "Swing setup", text_color = c_lbl, bgcolor = c_bodyBg, text_size = tsz)
    table.cell(t, 1, row, stsTxt, text_color = color.white, bgcolor = stsBuy ? colGood : stsDip ? colWarn : bullStack ? color.new(color.gray, 20) : colBad, text_size = tsz)
    row += 1
    table.cell(t, 0, row, "HTF " + htfTF, text_color = c_lbl, bgcolor = c_bodyBg, text_size = tsz)
    table.cell(t, 1, row, htfTxt, text_color = color.white, bgcolor = htfBuy ? colGood : htfStack ? color.new(colGood, 45) : colBad, text_size = tsz)
    row += 1
    table.cell(t, 0, row, "BUY age (bars)", text_color = c_lbl, bgcolor = c_bodyBg, text_size = tsz)
    table.cell(t, 1, row, na(ageBars) ? "—" : str.tostring(ageBars), text_color = na(ageBars) ? c_lbl : ageBars <= 5 ? colGood : ageBars <= 15 ? colWarn : c_lbl, bgcolor = c_bodyBg, text_size = tsz)
    row += 1
    table.cell(t, 0, row, "Liquidity", text_color = c_lbl, bgcolor = c_bodyBg, text_size = tsz)
    dvTxt = dvM >= 1000 ? str.tostring(dvM / 1000.0, "0.00") + "B" : str.tostring(dvM, "0.0") + "M"
    table.cell(t, 1, row, (liquid ? "OK " : "LOW ") + dvTxt, text_color = liquid ? colGood : colBad, bgcolor = c_bodyBg, text_size = tsz)
    row += 1
    table.cell(t, 0, row, "SCORE", text_color = c_gold, bgcolor = c_navy, text_size = tsz)
    table.cell(t, 1, row, str.tostring(score, "#.0") + (pass == 1 ? "  ✓" : ""), text_color = color.white, bgcolor = f_col(score, 40, 65), text_size = tsz)

// ────────────────────────────  ALERTS  ──────────────────────────────
alertcondition(buyStart and pass == 1, "Fresh swing", "Target Isolator: {{ticker}} — new HTF-confirmed swing BUY, liquid and outperforming SPY")
