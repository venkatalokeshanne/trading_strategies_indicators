    table.cell(dashboard, 0, row, 'VPT Flow', text_color = c_gray, text_size = dash_text_size)
    table.cell(dashboard, 1, row, volume_bullish ? 'BULLISH' : volume_bearish ? 'BEARISH' : 'NEUTRAL', text_color = volume_bullish ? c_green : volume_bearish ? c_red : c_gray, text_size = dash_text_size)
    table.cell(dashboard, 2, row, 'Volume', text_color = c_gray, text_size = dash_text_size)
    table.cell(dashboard, 3, row, high_volume ? 'HIGH' : volume < vol_ma * 0.7 ? 'LOW' : 'NORMAL', text_color = high_volume ? c_orange : c_gray, text_size = dash_text_size)
    //table.cell(dashboard, 4, row, str.tostring(relative_volume_viz, '#.x'), text_color = c_gray, text_size = dash_text_size)
