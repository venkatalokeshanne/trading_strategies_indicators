//@version=6
indicator("ORB 15m Range Breakout - Trading Trio", overlay=true)

// --- INPUT SETTINGS ---
g_session  = "Session Settings"
nySession  = input.session("0930-0945", title="NY Opening Window", group=g_session)
nyCloseStr = input.string("1600", title="NY Session Close Time (HHMM)", group=g_session)

g_style    = "Display Style Settings"
lineStyle  = input.string("Solid", title="Line Style", options=["Solid", "Dashed"], group=g_style)
lineWidth  = input.int(2, title="Line Width", minval=1, maxval=5, group=g_style)
hiColor    = input.color(color.green, title="15m High Line Color", group=g_style) // Restored color picker
loColor    = input.color(color.red, title="15m Low Line Color", group=g_style)   // Restored color picker
showShapes = input.bool(true, title="Show Breakout Triangles", group=g_style)

// Convert input choice to native line style
chosenStyle = lineStyle == "Solid" ? line.style_solid : line.style_dashed

// --- TIME BOUNDARY CHECKS ---
inSession = not na(time("1", nySession, "America/New_York"))

// Parse the close time string into integer values
var int closeHour = int(str.tonumber(str.substring(nyCloseStr, 0, 2)))
var int closeMin  = int(str.tonumber(str.substring(nyCloseStr, 2, 4)))

currentHour = hour(time, "America/New_York")
currentMin  = minute(time, "America/New_York")
isPastClose = currentHour > closeHour or (currentHour == closeHour and currentMin >= closeMin)

// Corrected Session Edge Detection
sessionStart = inSession and not inSession[1]
sessionEnd   = not inSession and inSession[1]

// --- TRACKING CORE VARIABLES ---
var float nyHigh = na
var float nyLow  = na
var float stableHigh = na
var float stableLow  = na
var bool highBroken = false
var bool lowBroken = false

// Persistent references for drawing tracking lines
var line hiLine = na
var line loLine = na

if sessionStart
    nyHigh := high
    nyLow  := low
    highBroken := false
    lowBroken := false
    // Generate new lines using user custom input colors
    hiLine := line.new(x1=bar_index, y1=high, x2=bar_index, y2=high, color=hiColor, style=chosenStyle, width=lineWidth)
    loLine := line.new(x1=bar_index, y1=low, x2=bar_index, y2=low, color=loColor, style=chosenStyle, width=lineWidth)
else if inSession
    nyHigh := math.max(nyHigh, high)
    nyLow  := math.min(nyLow, low)
    // Expand the line coordinates live during the initial 15 minutes
    line.set_y1(hiLine, nyHigh)
    line.set_y2(hiLine, nyHigh)
    line.set_x2(hiLine, bar_index)
    line.set_y1(loLine, nyLow)
    line.set_y2(loLine, nyLow)
    line.set_x2(loLine, bar_index)

if sessionEnd
    stableHigh := nyHigh
    stableLow := nyLow

// Extend the lines forward throughout the day until NY market close hits
if not inSession and not na(stableHigh) and not isPastClose
    line.set_x2(hiLine, bar_index)
    line.set_x2(loLine, bar_index)

// --- BREAKOUT DETECTION SYSTEM ---
breakUp   = not inSession and not isPastClose and not na(stableHigh) and not highBroken and close > stableHigh
breakDown = not inSession and not isPastClose and not na(stableLow) and not lowBroken and close < stableLow

if breakUp
    highBroken := true
if breakDown
    lowBroken := true

// --- VISUAL SIGNALS ---
plotshape(showShapes and breakUp, title="Bullish Break Close", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(showShapes and breakDown, title="Bearish Break Close", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

// --- LIVE BROADCAST ALERTS ---
if breakUp
    alert("Bullish Breakout: " + syminfo.ticker + " closed above the 15m high!", alert.freq_once_per_bar_close)
if breakDown
    alert("Bearish Breakout: " + syminfo.ticker + " closed below the 15m low!", alert.freq_once_per_bar_close)