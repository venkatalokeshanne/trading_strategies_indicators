//@version=6
indicator("6 Indicator Master V5 - Fuel Zone 70-80%", shorttitle="6X V5", overlay=true)

//==================================================
// SETTINGS
//==================================================
slopeLookback = input.int(5, "Slope Lookback", minval=1)
minSlope = input.float(0.20, "Minimum Slope Strength", minval=0.01, step=0.01)
maxSlope = input.float(2.00, "Maximum Slope Strength", minval=0.01, step=0.01)

stRestBars = input.int(3, "Supertrend Rest Bars", minval=1)
stFlatATR = input.float(0.15, "Supertrend Flatness ATR", minval=0.01, step=0.01)
stResumeATR = input.float(0.20, "Supertrend Resume Strength ATR", minval=0.01, step=0.01)

showDashboard = input.bool(true, "Show Dashboard")
showSignals = input.bool(true, "Show BUY/SELL Signals")
showRestZone = input.bool(true, "Show Rest Zone")
showProbability = input.bool(true, "Show 70-80% Setup")

//==================================================
// 1. CM MACD
//==================================================
macdFast = ta.ema(close, 12)
macdSlow = ta.ema(close, 26)
macdLine = macdFast - macdSlow
macdSignal = ta.sma(macdLine, 9)
macdHist = macdLine - macdSignal

macdBear = macdLine < macdSignal and macdHist <= 0
macdBull = macdLine > macdSignal and macdHist >= 0

//==================================================
// 2. SQUEEZE MOMENTUM
//==================================================
sqLen = 20

sqHigh = ta.highest(high, sqLen)
sqLow = ta.lowest(low, sqLen)
sqAverage = ta.sma(close, sqLen)

sqSource = close - ((sqHigh + sqLow) / 2 + sqAverage) / 2
sqValue = ta.linreg(sqSource, sqLen, 0)

sqBear = sqValue < 0 and sqValue < sqValue[1]
sqBull = sqValue > 0 and sqValue > sqValue[1]

//==================================================
// 3. WAVETREND
//==================================================
wtN1 = 10
wtN2 = 21

wtAP = hlc3
wtESA = ta.ema(wtAP, wtN1)
wtD = ta.ema(math.abs(wtAP - wtESA), wtN1)

wtCI = wtD != 0 ? (wtAP - wtESA) / (0.015 * wtD) : 0

wt1 = ta.ema(wtCI, wtN2)
wt2 = ta.sma(wt1, 4)

wtBear = wt1 < wt2
wtBull = wt1 > wt2

//==================================================
// 4. BULL BEAR POWER TREND
//==================================================
bullTrend = (close - ta.lowest(low, 50)) / ta.atr(5)
bearTrend = (ta.highest(high, 50) - close) / ta.atr(5)

bbTrend = bullTrend - bearTrend

bbBear = bbTrend < 0
bbBull = bbTrend > 0

//==================================================
// 5. SUPERTREND
//==================================================
[stLine, stDirection] = ta.supertrend(3.0, 10)

stBear = stDirection > 0
stBull = stDirection < 0

//==================================================
// 6. TRADE PRO REJECTION ZONE
//==================================================
fastMA = ta.ema(close, 20)
slowMA = ta.ema(close, 50)

rzBear = fastMA < slowMA
rzBull = fastMA > slowMA

//==================================================
// 6/6 COUNT
//==================================================
bearCount = 0
bearCount := bearCount + (macdBear ? 1 : 0)
bearCount := bearCount + (sqBear ? 1 : 0)
bearCount := bearCount + (wtBear ? 1 : 0)
bearCount := bearCount + (bbBear ? 1 : 0)
bearCount := bearCount + (stBear ? 1 : 0)
bearCount := bearCount + (rzBear ? 1 : 0)

bullCount = 0
bullCount := bullCount + (macdBull ? 1 : 0)
bullCount := bullCount + (sqBull ? 1 : 0)
bullCount := bullCount + (wtBull ? 1 : 0)
bullCount := bullCount + (bbBull ? 1 : 0)
bullCount := bullCount + (stBull ? 1 : 0)
bullCount := bullCount + (rzBull ? 1 : 0)

allBear = bearCount == 6
allBull = bullCount == 6

//==================================================
// PRICE ACTION
//==================================================
bullPriceAction = close > high[1]
bearPriceAction = close < low[1]

//==================================================
// REJECTION ZONE SLOPE
//==================================================
atrValue = ta.atr(14)

fastSlopeRaw = fastMA - fastMA[slopeLookback]
slowSlopeRaw = slowMA - slowMA[slopeLookback]

fastSlope = atrValue != 0 ? math.abs(fastSlopeRaw) / atrValue : 0
slowSlope = atrValue != 0 ? math.abs(slowSlopeRaw) / atrValue : 0

fastUp = fastSlopeRaw > 0
fastDown = fastSlopeRaw < 0

slowUp = slowSlopeRaw > 0
slowDown = slowSlopeRaw < 0

fastSlopeValid = fastSlope >= minSlope and fastSlope <= maxSlope
slowSlopeValid = slowSlope >= minSlope and slowSlope <= maxSlope

// BOTH LINES MUST SLOPE TOGETHER
rzBullSlope = fastUp and slowUp and fastSlopeValid and slowSlopeValid
rzBearSlope = fastDown and slowDown and fastSlopeValid and slowSlopeValid

//==================================================
// SUPERTREND REST / FUEL ZONE
//==================================================
stMove = math.abs(stLine - stLine[1])

stMoveATR = atrValue != 0 ? stMove / atrValue : 0

stFlat = stMoveATR <= stFlatATR

var int restCount = 0

if stFlat
    restCount := restCount + 1
else
    restCount := 0

stRest = restCount >= stRestBars

//==================================================
// PREVIOUS TREND DIRECTION
//==================================================
stWasUp = stLine > stLine[stRestBars]
stWasDown = stLine < stLine[stRestBars]

//==================================================
// SUPERTREND RESUMPTION
//==================================================
stUpResume = stLine > stLine[1] and stMoveATR >= stResumeATR
stDownResume = stLine < stLine[1] and stMoveATR >= stResumeATR

//==================================================
// FUEL CONDITIONS
//==================================================
bullFuel = stRest[1] and stWasUp and stUpResume
bearFuel = stRest[1] and stWasDown and stDownResume

//==================================================
// 70-80% SETUP ZONE
//==================================================
//
// IMPORTANT:
// This is a SETUP LABEL, not a mathematically proven
// 70-80% win probability until backtested.
//

bullProbabilitySetup =
     stRest and
     rzBullSlope and
     allBull

bearProbabilitySetup =
     stRest and
     rzBearSlope and
     allBear

//==================================================
// FINAL V5 SIGNAL
//==================================================

// BUY only when everything agrees
bullSetup =
     allBull and
     bullPriceAction and
     rzBullSlope and
     bullFuel and
     stUpResume

// SELL only when everything agrees
bearSetup =
     allBear and
     bearPriceAction and
     rzBearSlope and
     bearFuel and
     stDownResume

bullTrigger = bullSetup and not bullSetup[1]
bearTrigger = bearSetup and not bearSetup[1]

//==================================================
// 70-80% LABELS
//==================================================
//
// They appear ONLY inside the qualifying flat area.
// Nothing is printed for other conditions.
//

plotshape(
     showProbability and bullProbabilitySetup,
     title="Bullish 70-80 Setup",
     style=shape.labelup,
     location=location.belowbar,
     text="70-80% ↑",
     color=color.green,
     textcolor=color.white,
     size=size.tiny)

plotshape(
     showProbability and bearProbabilitySetup,
     title="Bearish 70-80 Setup",
     style=shape.labeldown,
     location=location.abovebar,
     text="70-80% ↓",
     color=color.red,
     textcolor=color.white,
     size=size.tiny)

//==================================================
// FINAL BUY / SELL SIGNAL
//==================================================
plotshape(
     showSignals and bullTrigger,
     title="V5 BUY",
     style=shape.labelup,
     location=location.belowbar,
     text="V5 BUY",
     color=color.green,
     textcolor=color.white,
     size=size.small)

plotshape(
     showSignals and bearTrigger,
     title="V5 SELL",
     style=shape.labeldown,
     location=location.abovebar,
     text="V5 SELL",
     color=color.red,
     textcolor=color.white,
     size=size.small)

//==================================================
// SUPERTREND REST ZONE
//==================================================
plot(
     showRestZone and stRest ? stLine : na,
     title="Supertrend Rest Zone",
     color=color.orange,
     linewidth=4,
     style=plot.style_linebr)

//==================================================
// ALERTS
//==================================================
alertcondition(
     bullTrigger,
     title="V5 BUY - FULL ALIGNMENT",
     message="V5 BUY: 6/6 + PRICE ACTION + REJECTION ZONE UP SLOPE + SUPERTREND REST/UP RESUME")

alertcondition(
     bearTrigger,
     title="V5 SELL - FULL ALIGNMENT",
     message="V5 SELL: 6/6 + PRICE ACTION + REJECTION ZONE DOWN SLOPE + SUPERTREND REST/DOWN RESUME")

alertcondition(
     bullProbabilitySetup,
     title="V5 70-80% BULLISH SETUP",
     message="V5 BULLISH SETUP: QUALIFYING SUPERTREND REST + 6/6 BULLISH + REJECTION ZONE UP SLOPE")

alertcondition(
     bearProbabilitySetup,
     title="V5 70-80% BEARISH SETUP",
     message="V5 BEARISH SETUP: QUALIFYING SUPERTREND REST + 6/6 BEARISH + REJECTION ZONE DOWN SLOPE")

//==================================================
// DASHBOARD
//==================================================
var table dash = table.new(position.top_right, 3, 15, border_width=1)

if barstate.islast and showDashboard

    table.cell(dash, 0, 0, "#", bgcolor=color.black, text_color=color.white)
    table.cell(dash, 1, 0, "INDICATOR", bgcolor=color.black, text_color=color.white)
    table.cell(dash, 2, 0, "STATUS", bgcolor=color.black, text_color=color.white)

    table.cell(dash, 0, 1, "1")
    table.cell(dash, 1, 1, "MACD")
    table.cell(dash, 2, 1,
         macdBear ? "BEAR" : macdBull ? "BULL" : "NEUTRAL",
         bgcolor=macdBear ? color.red : macdBull ? color.green : color.gray,
         text_color=color.white)

    table.cell(dash, 0, 2, "2")
    table.cell(dash, 1, 2, "SQUEEZE")
    table.cell(dash, 2, 2,
         sqBear ? "BEAR" : sqBull ? "BULL" : "NEUTRAL",
         bgcolor=sqBear ? color.red : sqBull ? color.green : color.gray,
         text_color=color.white)

    table.cell(dash, 0, 3, "3")
    table.cell(dash, 1, 3, "WAVETREND")
    table.cell(dash, 2, 3,
         wtBear ? "BEAR" : wtBull ? "BULL" : "NEUTRAL",
         bgcolor=wtBear ? color.red : wtBull ? color.green : color.gray,
         text_color=color.white)

    table.cell(dash, 0, 4, "4")
    table.cell(dash, 1, 4, "BBPT")
    table.cell(dash, 2, 4,
         bbBear ? "BEAR" : bbBull ? "BULL" : "NEUTRAL",
         bgcolor=bbBear ? color.red : bbBull ? color.green : color.gray,
         text_color=color.white)

    table.cell(dash, 0, 5, "5")
    table.cell(dash, 1, 5, "SUPERTREND")
    table.cell(dash, 2, 5,
         stBear ? "BEAR" : stBull ? "BULL" : "NEUTRAL",
         bgcolor=stBear ? color.red : stBull ? color.green : color.gray,
         text_color=color.white)

    table.cell(dash, 0, 6, "6")
    table.cell(dash, 1, 6, "REJECTION")
    table.cell(dash, 2, 6,
         rzBear ? "BEAR" : rzBull ? "BULL" : "NEUTRAL",
         bgcolor=rzBear ? color.red : rzBull ? color.green : color.gray,
         text_color=color.white)

    table.cell(dash, 1, 7, "BEAR COUNT")
    table.cell(dash, 2, 7,
         str.tostring(bearCount) + " / 6",
         bgcolor=allBear ? color.red : color.gray,
         text_color=color.white)

    table.cell(dash, 1, 8, "BULL COUNT")
    table.cell(dash, 2, 8,
         str.tostring(bullCount) + " / 6",
         bgcolor=allBull ? color.green : color.gray,
         text_color=color.white)

    table.cell(dash, 1, 9, "BLUE SLOPE")
    table.cell(dash, 2, 9,
         fastUp ? "UP" : fastDown ? "DOWN" : "FLAT",
         bgcolor=fastUp ? color.green : fastDown ? color.red : color.gray,
         text_color=color.white)

    table.cell(dash, 1, 10, "RED SLOPE")
    table.cell(dash, 2, 10,
         slowUp ? "UP" : slowDown ? "DOWN" : "FLAT",
         bgcolor=slowUp ? color.green : slowDown ? color.red : color.gray,
         text_color=color.white)

    table.cell(dash, 1, 11, "ST REST")
    table.cell(dash, 2, 11,
         stRest ? "REST" : "MOVING",
         bgcolor=stRest ? color.orange : color.gray,
         text_color=color.white)

    table.cell(dash, 1, 12, "ST RESUME")
    table.cell(dash, 2, 12,
         stUpResume ? "UP" : stDownResume ? "DOWN" : "WAIT",
         bgcolor=stUpResume ? color.green : stDownResume ? color.red : color.gray,
         text_color=color.white)

    table.cell(dash, 1, 13, "SETUP")
    table.cell(dash, 2, 13,
         bullProbabilitySetup ? "70-80% ↑" :
         bearProbabilitySetup ? "70-80% ↓" : "WAIT",
         bgcolor=bullProbabilitySetup ? color.green :
         bearProbabilitySetup ? color.red : color.gray,
         text_color=color.white)

    table.cell(dash, 1, 14, "V5 STATUS")
    table.cell(dash, 2, 14,
         bullTrigger ? "🟢 BUY" :
         bearTrigger ? "🔴 SELL" : "WAIT",
         bgcolor=bullTrigger ? color.green :
         bearTrigger ? color.red : color.gray,
         text_color=color.white)