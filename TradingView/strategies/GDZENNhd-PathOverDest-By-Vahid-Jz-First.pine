strategy("PathOverDest (By Vahid.Jz) First", overlay=true, process_orders_on_close=true, initial_capital=1000, currency=currency.NONE, default_qty_type=strategy.cash, max_lines_count=500, max_boxes_count=500, max_bars_back=1000, pyramiding=100000)
//@version=5
// === تنظیمات عمومی ===
groupGeneral = "████████ ⚙️ تنظیمات عمومی ████████"
calculationBars = input.int(500, "بازه محاسباتی کندل", minval=1, maxval=5000, step=1, group=groupGeneral)
// گروه (عنوان گروه فارسی)
groupRM = "████████ 💰 مدیریت سرمایه ████████"

// ردیف 1
pip_size       = input.float(0.1, "اندازه پیپ (پیپ)", step=0.01, group=groupRM, inline="r1")
position_cash  = input.float(10, "مبلغ نقدی هر پوزیشن (پول/پوزیشن)", group=groupRM, inline="r1")

// ردیف 2
num_positions  = input.int(1, "تعداد پوزیشن‌ها برای باز کردن در سیگنال", minval=1, group=groupRM, inline="r2")
use_multiple_tp= input.bool(true, "فعال‌سازی 3 حد سود (3 حدسود)", group=groupRM, inline="r2")

// ردیف 3 (حد سودها)
tp1_pips       = input.float(30.0, "حد سود ۱ (پیپ)", group=groupRM, inline="r3")
tp2_pips       = input.float(60.0, "حد سود ۲ (پیپ)", group=groupRM, inline="r3")
tp3_pips       = input.float(90.0, "حد سود ۳ (پیپ)", group=groupRM, inline="r3")


// ردیف 4 (تعداد بستن در هر حد سود)
tp1_close_num  = input.int(1, "تعداد پوزیشن بسته‌شدن در حد سود ۱", minval=0, group=groupRM, inline="r4")
tp2_close_num  = input.int(1, "تعداد پوزیشن بسته‌شدن در حد سود ۲", minval=0, group=groupRM, inline="r4")
tp3_close_num  = input.int(1, "تعداد پوزیشن بسته‌شدن در حد سود ۳", minval=0, group=groupRM, inline="r4")

// ردیف 5 (نوع حد ضرر)
sl_type        = input.string("ثابت", "نوع حد ضرر", options=["ثابت", "ریسک فری", "تریلینگ"], group=groupRM, inline="r5")
risk_free_pips = input.float(20.0, "پیپ برای ریسک فری ", group=groupRM, inline="r5")
trail_pips     = input.float(10.0, "پیپ برای تریلینگ ", group=groupRM, inline="r5")

// مثال نمایش متغیرها در پنجرهٔ کانسول (اختیاری)
var table t = table.new(position.top_right, 1, 1)
if barstate.islast
    table.cell(t, 0, 0, str.format("pip:{0} cash:{1} TP:{2}/{3}/{4}", pip_size, position_cash, tp1_pips, tp2_pips, tp3_pips))

// === تنظیمات هشدار ===
groupAlerts = "████████ 🔔 تنظیمات هشدار ████████"
longEntryAlert = input.string("ورود خرید {{close}}", "هشدار ورود خرید", group=groupAlerts)
longCloseAlert = input.string("خروج خرید {{close}}", "هشدار خروج خرید", group=groupAlerts)
shortEntryAlert = input.string("ورود فروش {{close}}", "هشدار ورود فروش", group=groupAlerts)
shortCloseAlert = input.string("خروج فروش {{close}}", "هشدار خروج فروش", group=groupAlerts)
// === تنظیمات حد سود و حد ضرر ===
groupTPSL = "████████ 🎯 حد سود و حد ضرر ████████"
LongTp = input.bool(false, "حد سود خرید", inline="longTp", group=groupTPSL)
LongTpType = input.string("Price", "نوع", ["Price", "Currency", "%", "ATR"], inline="longTp", group=groupTPSL)
LongTpValue = input.float(0, "مقدار", inline="longTp", group=groupTPSL)
LongSl = input.bool(false, "حد ضرر خرید", inline="longSl", group=groupTPSL)
LongSlType = input.string("Price", "نوع", ["Price", "Currency", "%", "ATR"], inline="longSl", group=groupTPSL)
LongSlValue = input.float(0, "مقدار", inline="longSl", group=groupTPSL)
ShortTp = input.bool(false, "حد سود فروش", inline="shortTp", group=groupTPSL)
ShortTpType = input.string("Price", "نوع", ["Price", "Currency", "%", "ATR"], inline="shortTp", group=groupTPSL)
ShortTpValue = input.float(0, "مقدار", inline="shortTp", group=groupTPSL)
ShortSl = input.bool(false, "حد ضرر فروش", inline="shortSl", group=groupTPSL)
ShortSlType = input.string("Price", "نوع", ["Price", "Currency", "%", "ATR"], inline="shortSl", group=groupTPSL)
ShortSlValue = input.float(0, "مقدار", inline="shortSl", group=groupTPSL)
// === استپ‌های ورود خرید (لانگ) ===
groupLongSteps = "████████  📈 شرایط ورود به خرید ████████"
// استپ 1
enableLongCond1 = input.bool(false, "فعال", inline="longStep1", group=groupLongSteps)
inputLong1_1 = input.source(close, "منبع 1", inline="longStep1", group=groupLongSteps)
longCond1 = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی با", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "نا مساوی", "قطع به بالا", "قطع به پایین", "تلاقی"], inline="longStep1", group=groupLongSteps)
inputLong1_2Source = input.source(close, "منبع 2", inline="longStep1", group=groupLongSteps)
enableFloatLong1_2 = input.bool(false, "عدد ثابت", inline="longStep1", group=groupLongSteps)
inputLong1_2Float = input.float(0.0, "", inline="longStep1", group=groupLongSteps)
logicalOperator12Long = input.string("و", "ترکیب", options=["و", "یا"], inline="longStep1", group=groupLongSteps)

// استپ 2
enableLongCond2 = input.bool(false, "فعال", inline="longStep2", group=groupLongSteps)
inputLong2_1 = input.source(close, "منبع 1", inline="longStep2", group=groupLongSteps)
longCond2 = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی با", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "نا مساوی", "قطع به بالا", "قطع به پایین", "تلاقی"], inline="longStep2", group=groupLongSteps)
inputLong2_2Source = input.source(close, "منبع 2", inline="longStep2", group=groupLongSteps)
enableFloatLong2_2 = input.bool(false, "عدد ثابت", inline="longStep2", group=groupLongSteps)
inputLong2_2Float = input.float(0.0, "", inline="longStep2", group=groupLongSteps)
logicalOperator23Long = input.string("و", "ترکیب", options=["و", "یا"], inline="longStep2", group=groupLongSteps)

// استپ 3
enableLongCond3 = input.bool(false, "فعال", inline="longStep3", group=groupLongSteps)
inputLong3_1 = input.source(close, "منبع 1", inline="longStep3", group=groupLongSteps)
longCond3 = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی با", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "نا مساوی", "قطع به بالا", "قطع به پایین", "تلاقی"], inline="longStep3", group=groupLongSteps)
inputLong3_2Source = input.source(close, "منبع 2", inline="longStep3", group=groupLongSteps)
enableFloatLong3_2 = input.bool(false, "عدد ثابت", inline="longStep3", group=groupLongSteps)
inputLong3_2Float = input.float(0.0, "", inline="longStep3", group=groupLongSteps)
logicalOperator34Long = input.string("و", "ترکیب", options=["و", "یا"], inline="longStep3", group=groupLongSteps)

// استپ 4
enableLongCond4 = input.bool(false, "فعال", inline="longStep4", group=groupLongSteps)
inputLong4_1 = input.source(close, "منبع 1", inline="longStep4", group=groupLongSteps)
longCond4 = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی با", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "نا مساوی", "قطع به بالا", "قطع به پایین", "تلاقی"], inline="longStep4", group=groupLongSteps)
inputLong4_2Source = input.source(close, "منبع 2", inline="longStep4", group=groupLongSteps)
enableFloatLong4_2 = input.bool(false, "عدد ثابت", inline="longStep4", group=groupLongSteps)
inputLong4_2Float = input.float(0.0, "", inline="longStep4", group=groupLongSteps)

// === استپ‌های خروج خرید (لانگ) ===
groupLongCloseSteps = "████████  📉 شرایط خروج از خرید ████████"

// استپ 1
enableCloseLongCond1 = input.bool(false, "فعال", inline="longCloseStep1", group=groupLongCloseSteps)
inputCloseLong1_1 = input.source(close, "منبع 1", inline="longCloseStep1", group=groupLongCloseSteps)
longCloseCond1 = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی با", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "نا مساوی", "قطع به بالا", "قطع به پایین", "تلاقی"], inline="longCloseStep1", group=groupLongCloseSteps)
inputCloseLong1_2Source = input.source(close, "منبع 2", inline="longCloseStep1", group=groupLongCloseSteps)
enableFloatCloseLong1_2 = input.bool(false, "عدد ثابت", inline="longCloseStep1", group=groupLongCloseSteps)
inputCloseLong1_2Float = input.float(0.0, "", inline="longCloseStep1", group=groupLongCloseSteps)
logicalOperator12CloseLong = input.string("و", "ترکیب", options=["و", "یا"], inline="longCloseStep1", group=groupLongCloseSteps)

// استپ 2
enableCloseLongCond2 = input.bool(false, "فعال", inline="longCloseStep2", group=groupLongCloseSteps)
inputCloseLong2_1 = input.source(close, "منبع 1", inline="longCloseStep2", group=groupLongCloseSteps)
longCloseCond2 = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی با", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "نا مساوی", "قطع به بالا", "قطع به پایین", "تلاقی"], inline="longCloseStep2", group=groupLongCloseSteps)
inputCloseLong2_2Source = input.source(close, "منبع 2", inline="longCloseStep2", group=groupLongCloseSteps)
enableFloatCloseLong2_2 = input.bool(false, "عدد ثابت", inline="longCloseStep2", group=groupLongCloseSteps)
inputCloseLong2_2Float = input.float(0.0, "", inline="longCloseStep2", group=groupLongCloseSteps)

// === استپ‌های ورود فروش (شورت) ===
groupShortSteps = "████████  📉 شرایط ورود به فروش ████████"

// استپ 1
enableShortCond1 = input.bool(false, "فعال", inline="shortStep1", group=groupShortSteps)
inputShort1_1 = input.source(close, "منبع 1", inline="shortStep1", group=groupShortSteps)
shortCond1 = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی با", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "نا مساوی", "قطع به بالا", "قطع به پایین", "تلاقی"], inline="shortStep1", group=groupShortSteps)
inputShort1_2Source = input.source(close, "منبع 2", inline="shortStep1", group=groupShortSteps)
enableFloatShort1_2 = input.bool(false, "عدد ثابت", inline="shortStep1", group=groupShortSteps)
inputShort1_2Float = input.float(0.0, "", inline="shortStep1", group=groupShortSteps)
logicalOperator12Short = input.string("و", "ترکیب", options=["و", "یا"], inline="shortStep1", group=groupShortSteps)

// استپ 2
enableShortCond2 = input.bool(false, "فعال", inline="shortStep2", group=groupShortSteps)
inputShort2_1 = input.source(close, "منبع 1", inline="shortStep2", group=groupShortSteps)
shortCond2 = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی با", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "نا مساوی", "قطع به بالا", "قطع به پایین", "تلاقی"], inline="shortStep2", group=groupShortSteps)
inputShort2_2Source = input.source(close, "منبع 2", inline="shortStep2", group=groupShortSteps)
enableFloatShort2_2 = input.bool(false, "عدد ثابت", inline="shortStep2", group=groupShortSteps)
inputShort2_2Float = input.float(0.0, "", inline="shortStep2", group=groupShortSteps)
logicalOperator23Short = input.string("و", "ترکیب", options=["و", "یا"], inline="shortStep2", group=groupShortSteps)

// استپ 3
enableShortCond3 = input.bool(false, "فعال", inline="shortStep3", group=groupShortSteps)
inputShort3_1 = input.source(close, "منبع 1", inline="shortStep3", group=groupShortSteps)
shortCond3 = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی با", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "نا مساوی", "قطع به بالا", "قطع به پایین", "تلاقی"], inline="shortStep3", group=groupShortSteps)
inputShort3_2Source = input.source(close, "منبع 2", inline="shortStep3", group=groupShortSteps)
enableFloatShort3_2 = input.bool(false, "عدد ثابت", inline="shortStep3", group=groupShortSteps)
inputShort3_2Float = input.float(0.0, "", inline="shortStep3", group=groupShortSteps)
logicalOperator34Short = input.string("و", "ترکیب", options=["و", "یا"], inline="shortStep3", group=groupShortSteps)

// استپ 4
enableShortCond4 = input.bool(false, "فعال", inline="shortStep4", group=groupShortSteps)
inputShort4_1 = input.source(close, "منبع 1", inline="shortStep4", group=groupShortSteps)
shortCond4 = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی با", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "نا مساوی", "قطع به بالا", "قطع به پایین", "تلاقی"], inline="shortStep4", group=groupShortSteps)
inputShort4_2Source = input.source(close, "منبع 2", inline="shortStep4", group=groupShortSteps)
enableFloatShort4_2 = input.bool(false, "عدد ثابت", inline="shortStep4", group=groupShortSteps)
inputShort4_2Float = input.float(0.0, "", inline="shortStep4", group=groupShortSteps)

// === استپ‌های خروج فروش (شورت) ===
groupShortCloseSteps = "████████  📈 شرایط خروج از فروش ████████"

// استپ 1
enableCloseShortCond1 = input.bool(false, "فعال", inline="shortCloseStep1", group=groupShortCloseSteps)
inputCloseShort1_1 = input.source(close, "منبع 1", inline="shortCloseStep1", group=groupShortCloseSteps)
shortCloseCond1 = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی با", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "نا مساوی", "قطع به بالا", "قطع به پایین", "تلاقی"], inline="shortCloseStep1", group=groupShortCloseSteps)
inputCloseShort1_2Source = input.source(close, "منبع 2", inline="shortCloseStep1", group=groupShortCloseSteps)
enableFloatCloseShort1_2 = input.bool(false, "عدد ثابت", inline="shortCloseStep1", group=groupShortCloseSteps)
inputCloseShort1_2Float = input.float(0.0, "", inline="shortCloseStep1", group=groupShortCloseSteps)
logicalOperator12CloseShort = input.string("و", "ترکیب", options=["و", "یا"], inline="shortCloseStep1", group=groupShortCloseSteps)

// استپ 2
enableCloseShortCond2 = input.bool(false, "فعال", inline="shortCloseStep2", group=groupShortCloseSteps)
inputCloseShort2_1 = input.source(close, "منبع 1", inline="shortCloseStep2", group=groupShortCloseSteps)
shortCloseCond2 = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی با", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "نا مساوی", "قطع به بالا", "قطع به پایین", "تلاقی"], inline="shortCloseStep2", group=groupShortCloseSteps)
inputCloseShort2_2Source = input.source(close, "منبع 2", inline="shortCloseStep2", group=groupShortCloseSteps)
enableFloatCloseShort2_2 = input.bool(false, "عدد ثابت", inline="shortCloseStep2", group=groupShortCloseSteps)
inputCloseShort2_2Float = input.float(0.0, "", inline="shortCloseStep2", group=groupShortCloseSteps)

// === متغیرهای کمکی برای TP/SL ===
var float buyClose = 0
var float buyTakeProfitLevel = 0
var float buyStopLevel = 0
var float sellClose = 0
var float sellTakeProfitLevel = 0
var float sellStopLevel = 0
var bool BullEntry = na
var float long_trailing_sl = na
var float short_trailing_sl = na

// === توابع کمکی ===
evaluateCondition(input1, cond, input2) =>
    result = false
    if cond == "بزرگ‌تر از"
        result := input1 > input2
    else if cond == "کوچک‌تر از"
        result := input1 < input2
    else if cond == "مساوی با"
        result := input1 == input2
    else if cond == "بزرگ‌تر یا مساوی"
        result := input1 >= input2
    else if cond == "کوچک‌تر یا مساوی"
        result := input1 <= input2
    else if cond == "نا مساوی"
        result := input1 != input2
    else if cond == "قطع به بالا"
        result := ta.crossover(input1, input2)
    else if cond == "قطع به پایین"
        result := ta.crossunder(input1, input2)  
    else if cond == "تلاقی"    
        result := ta.cross(input1, input2)

// تابع انتخاب مقدار ورودی
getInputValue(enableFloat, inputSource, inputFloat) =>
    enableFloat ? inputFloat : inputSource

// تابع جایگزینی Placeholderها
replacePlaceholders(template, closePrice, timeStr) =>
    result = template
    result := str.replace_all(result, "{{close}}", str.tostring(closePrice))
    result := str.replace_all(result, "{{time}}", timeStr)
    result

// === تنظیم زمان با استفاده از تایم‌زون چارت ===
chartTimezone = syminfo.timezone
localHour = hour(time, chartTimezone)
localMinute = minute(time, chartTimezone)
timeStr = str.format("{0, number, 00}:{1, number, 00}", localHour, localMinute)

// === ارزیابی شرایط ورود خرید ===
longInput1_2 = getInputValue(enableFloatLong1_2, inputLong1_2Source, inputLong1_2Float)
bool longCondition1 = enableLongCond1 ? evaluateCondition(inputLong1_1, longCond1, longInput1_2) : false

longInput2_2 = getInputValue(enableFloatLong2_2, inputLong2_2Source, inputLong2_2Float)
bool longCondition2 = enableLongCond2 ? evaluateCondition(inputLong2_1, longCond2, longInput2_2) : false

longInput3_2 = getInputValue(enableFloatLong3_2, inputLong3_2Source, inputLong3_2Float)
bool longCondition3 = enableLongCond3 ? evaluateCondition(inputLong3_1, longCond3, longInput3_2) : false

longInput4_2 = getInputValue(enableFloatLong4_2, inputLong4_2Source, inputLong4_2Float)
bool longCondition4 = enableLongCond4 ? evaluateCondition(inputLong4_1, longCond4, longInput4_2) : false

// ترکیب شرط‌های ورود خرید (اصلاح‌شده: sequential بدون var و nesting)
bool longEntryCondition = false
int num_enabled_long = 0
bool current_long = false

if enableLongCond1
    current_long := longCondition1
    num_enabled_long += 1

if enableLongCond2
    if num_enabled_long == 0
        current_long := longCondition2
    else
        string op = logicalOperator12Long
        current_long := op == "یا" ? (current_long or longCondition2) : (current_long and longCondition2)
    num_enabled_long += 1

if enableLongCond3
    if num_enabled_long == 0
        current_long := longCondition3
    else
        string op = logicalOperator23Long
        current_long := op == "یا" ? (current_long or longCondition3) : (current_long and longCondition3)
    num_enabled_long += 1

if enableLongCond4
    if num_enabled_long == 0
        current_long := longCondition4
    else
        string op = logicalOperator34Long
        current_long := op == "یا" ? (current_long or longCondition4) : (current_long and longCondition4)
    num_enabled_long += 1

longEntryCondition := num_enabled_long > 0 ? current_long : false

// === ارزیابی شرایط خروج خرید ===
longCloseInput1_2 = getInputValue(enableFloatCloseLong1_2, inputCloseLong1_2Source, inputCloseLong1_2Float)
bool longCloseCondition1 = enableCloseLongCond1 ? evaluateCondition(inputCloseLong1_1, longCloseCond1, longCloseInput1_2) : false

longCloseInput2_2 = getInputValue(enableFloatCloseLong2_2, inputCloseLong2_2Source, inputCloseLong2_2Float)
bool longCloseCondition2 = enableCloseLongCond2 ? evaluateCondition(inputCloseLong2_1, longCloseCond2, longCloseInput2_2) : false

// ترکیب شرط‌های خروج خرید (اصلاح‌شده: sequential)
bool longCloseCondition = false
int num_enabled_long_close = 0
bool current_long_close = false

if enableCloseLongCond1
    current_long_close := longCloseCondition1
    num_enabled_long_close += 1

if enableCloseLongCond2
    if num_enabled_long_close == 0
        current_long_close := longCloseCondition2
    else
        string op = logicalOperator12CloseLong
        current_long_close := op == "یا" ? (current_long_close or longCloseCondition2) : (current_long_close and longCloseCondition2)
    num_enabled_long_close += 1

longCloseCondition := num_enabled_long_close > 0 ? current_long_close : false

// === ارزیابی شرایط ورود فروش ===
shortInput1_2 = getInputValue(enableFloatShort1_2, inputShort1_2Source, inputShort1_2Float)
bool shortCondition1 = enableShortCond1 ? evaluateCondition(inputShort1_1, shortCond1, shortInput1_2) : false

shortInput2_2 = getInputValue(enableFloatShort2_2, inputShort2_2Source, inputShort2_2Float)
bool shortCondition2 = enableShortCond2 ? evaluateCondition(inputShort2_1, shortCond2, shortInput2_2) : false

shortInput3_2 = getInputValue(enableFloatShort3_2, inputShort3_2Source, inputShort3_2Float)
bool shortCondition3 = enableShortCond3 ? evaluateCondition(inputShort3_1, shortCond3, shortInput3_2) : false

shortInput4_2 = getInputValue(enableFloatShort4_2, inputShort4_2Source, inputShort4_2Float)
bool shortCondition4 = enableShortCond4 ? evaluateCondition(inputShort4_1, shortCond4, shortInput4_2) : false

// ترکیب شرط‌های ورود فروش (اصلاح‌شده: sequential)
bool shortEntryCondition = false
int num_enabled_short = 0
bool current_short = false

if enableShortCond1
    current_short := shortCondition1
    num_enabled_short += 1

if enableShortCond2
    if num_enabled_short == 0
        current_short := shortCondition2
    else
        string op = logicalOperator12Short
        current_short := op == "یا" ? (current_short or shortCondition2) : (current_short and shortCondition2)
    num_enabled_short += 1

if enableShortCond3
    if num_enabled_short == 0
        current_short := shortCondition3
    else
        string op = logicalOperator23Short
        current_short := op == "یا" ? (current_short or shortCondition3) : (current_short and shortCondition3)
    num_enabled_short += 1

if enableShortCond4
    if num_enabled_short == 0
        current_short := shortCondition4
    else
        string op = logicalOperator34Short
        current_short := op == "یا" ? (current_short or shortCondition4) : (current_short and shortCondition4)
    num_enabled_short += 1

shortEntryCondition := num_enabled_short > 0 ? current_short : false

// === ارزیابی شرایط خروج فروش ===
shortCloseInput1_2 = getInputValue(enableFloatCloseShort1_2, inputCloseShort1_2Source, inputCloseShort1_2Float)
bool shortCloseCondition1 = enableCloseShortCond1 ? evaluateCondition(inputCloseShort1_1, shortCloseCond1, shortCloseInput1_2) : false

shortCloseInput2_2 = getInputValue(enableFloatCloseShort2_2, inputCloseShort2_2Source, inputCloseShort2_2Float)
bool shortCloseCondition2 = enableCloseShortCond2 ? evaluateCondition(inputCloseShort2_1, shortCloseCond2, shortCloseInput2_2) : false

// ترکیب شرط‌های خروج فروش (اصلاح‌شده: sequential)
bool shortCloseCondition = false
int num_enabled_short_close = 0
bool current_short_close = false

if enableCloseShortCond1
    current_short_close := shortCloseCondition1
    num_enabled_short_close += 1

if enableCloseShortCond2
    if num_enabled_short_close == 0
        current_short_close := shortCloseCondition2
    else
        string op = logicalOperator12CloseShort
        current_short_close := op == "یا" ? (current_short_close or shortCloseCondition2) : (current_short_close and shortCloseCondition2)
    num_enabled_short_close += 1

shortCloseCondition := num_enabled_short_close > 0 ? current_short_close : false

// === محاسبات حد سود و حد ضرر ===
// محاسبه ATR برای نوع ATR
atrValue = ta.atr(10)

// ثبت قیمت بسته شدن هنگام ورود به معامله
if longEntryCondition
    buyClose := close
if shortEntryCondition
    sellClose := close

// به‌روزرسانی BullEntry
if longEntryCondition
    BullEntry := true
else if shortEntryCondition
    BullEntry := false
else
    BullEntry := BullEntry
// === محاسبه TP/SL سفارشی (نسخه جایگزین) ===
// اطمینان: متغیر atrValue باید قبل از این‌ها تعریف شده باشد (atrValue = ta.atr(...))

calcTP(type, price, value, isLong) =>
    switch type
        "Currency" => isLong ? price + value : price - value
        "%"        => isLong ? price * (1 + value / 100) : price * (1 - value / 100)
        "ATR"      => isLong ? price + atrValue * value : price - atrValue * value
        // Price در این نسخه به عنوان قیمت مطلق در نظر گرفته می‌شود (مانند کد اصلی شما)
        "Price"    => value
        => na

calcSL(type, price, value, isLong) =>
    switch type
        "Currency" => isLong ? price - value : price + value
        "%"        => isLong ? price * (1 - value / 100) : price * (1 + value / 100)
        "ATR"      => isLong ? price - atrValue * value : price + atrValue * value
        // Price در SL نیز به عنوان قیمت مطلق
        "Price"    => value
        => na

// --- محاسبات سطوح TP/SL برای خرید (Long) ---
buyTakeProfitLevel := na
buyStopLevel := na

if LongTp
    buyTakeProfitLevel := calcTP(LongTpType, buyClose, LongTpValue, true)
else
    buyTakeProfitLevel := na

if LongSl
    buyStopLevel := calcSL(LongSlType, buyClose, LongSlValue, true)
else
    buyStopLevel := na

// --- محاسبات سطوح TP/SL برای فروش (Short) ---
sellTakeProfitLevel := na
sellStopLevel := na

if ShortTp
    sellTakeProfitLevel := calcTP(ShortTpType, sellClose, ShortTpValue, false)
else
    sellTakeProfitLevel := na

if ShortSl
    sellStopLevel := calcSL(ShortSlType, sellClose, ShortSlValue, false)
else
    sellStopLevel := na

// ریست تریلینگ اس ال وقتی پوزیشن بسته است
if strategy.position_size == 0
    long_trailing_sl := na
    short_trailing_sl := na

// === اجرای استراتژی و TP/SL ===
if longEntryCondition
    strategy.entry("Long", strategy.long, qty = position_cash * num_positions)
    alert(replacePlaceholders(longEntryAlert, close, timeStr), alert.freq_once_per_bar)
    if use_multiple_tp
        if tp1_close_num > 0
            strategy.exit("LongTP1", "Long", qty_percent=(tp1_close_num / num_positions) * 100, limit=buyClose + tp1_pips * pip_size, comment="TP1")
        if tp2_close_num > 0
            strategy.exit("LongTP2", "Long", qty_percent=(tp2_close_num / num_positions) * 100, limit=buyClose + tp2_pips * pip_size, comment="TP2")
        if tp3_close_num > 0
            strategy.exit("LongTP3", "Long", qty_percent=(tp3_close_num / num_positions) * 100, limit=buyClose + tp3_pips * pip_size, comment="TP3")
    else
        if LongTp and not na(buyTakeProfitLevel)
            strategy.exit("LongTP", "Long", limit=buyTakeProfitLevel, comment="TP")
    if LongSl and sl_type == "ثابت" and not na(buyStopLevel)
        strategy.exit("LongSL", "Long", stop=buyStopLevel, comment="SL")
    else if LongSl and not na(buyStopLevel)
        long_trailing_sl := buyStopLevel

if shortEntryCondition
    strategy.entry("Short", strategy.short, qty = position_cash * num_positions)
    alert(replacePlaceholders(shortEntryAlert, close, timeStr), alert.freq_once_per_bar)
    if use_multiple_tp
        if tp1_close_num > 0
            strategy.exit("ShortTP1", "Short", qty_percent=(tp1_close_num / num_positions) * 100, limit=sellClose - tp1_pips * pip_size, comment="TP1")
        if tp2_close_num > 0
            strategy.exit("ShortTP2", "Short", qty_percent=(tp2_close_num / num_positions) * 100, limit=sellClose - tp2_pips * pip_size, comment="TP2")
        if tp3_close_num > 0
            strategy.exit("ShortTP3", "Short", qty_percent=(tp3_close_num / num_positions) * 100, limit=sellClose - tp3_pips * pip_size, comment="TP3")
    else
        if ShortTp and not na(sellTakeProfitLevel)
            strategy.exit("ShortTP", "Short", limit=sellTakeProfitLevel, comment="TP")
    if ShortSl and sl_type == "ثابت" and not na(sellStopLevel)
        strategy.exit("ShortSL", "Short", stop=sellStopLevel, comment="SL")
    else if ShortSl and not na(sellStopLevel)
        short_trailing_sl := sellStopLevel


if longCloseCondition
    strategy.close("Long", comment="Close")
    long_trailing_sl := na
    alert(replacePlaceholders(longCloseAlert, close, timeStr), alert.freq_once_per_bar)

if shortCloseCondition
    strategy.close("Short", comment="Close")
    short_trailing_sl := na
    alert(replacePlaceholders(shortCloseAlert, close, timeStr), alert.freq_once_per_bar)

// === منطق تریلینگ استاپ ===
if strategy.position_size > 0
    pos_price = strategy.position_avg_price
    profit_pips = (close - pos_price) / pip_size
    if LongSl and sl_type != "ثابت" and not na(long_trailing_sl)
        if profit_pips >= risk_free_pips
            long_trailing_sl := math.max(long_trailing_sl, pos_price)
        if sl_type == "تریلینگ"
            long_trailing_sl := math.max(long_trailing_sl, close - trail_pips * pip_size)
        if close < long_trailing_sl
            strategy.close("Long", comment="SL Trailing")
            alert(replacePlaceholders(longCloseAlert, close, timeStr), alert.freq_once_per_bar)
            long_trailing_sl := na
else if strategy.position_size < 0
    pos_price = strategy.position_avg_price
    profit_pips = (pos_price - close) / pip_size
    if ShortSl and sl_type != "ثابت" and not na(short_trailing_sl)
        if profit_pips >= risk_free_pips
            short_trailing_sl := math.min(short_trailing_sl, pos_price)
        if sl_type == "تریلینگ"
            short_trailing_sl := math.min(short_trailing_sl, close + trail_pips * pip_size)
        if close > short_trailing_sl
            strategy.close("Short", comment="SL Trailing")
            alert(replacePlaceholders(shortCloseAlert, close, timeStr), alert.freq_once_per_bar)
            short_trailing_sl := na

//---------------------------------------------------------------------------------------------------------------------}