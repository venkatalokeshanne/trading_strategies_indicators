//@version=6
indicator("AquaBlu 7.0 Replay-Calibrated ICT Selector [NQ1! 1m -> MNQ]", overlay = true, max_lines_count = 500, max_labels_count = 500)

// AQUABLU 7.0 — REPLAY-CALIBRATED ICT SELECTOR
//
// Calibrated on direct CME NQ one-minute OHLCV from 2026-03-01 through
// 2026-08-07. The selector uses confirmed-close, causal features only:
// opening range, RTH VWAP/delivery, displacement/MSS, FVG, liquidity-event
// memory, momentum, efficiency, volatility, and fixed-stop geometry.
//
// Online policy:
//   1) Build the 09:30-09:34 New York opening range.
//   2) Score long and short after every confirmed close from 09:35.
//   3) Take the first side reaching the calibrated probability threshold.
//   4) If neither qualifies, choose the stronger side at 10:45.
//   5) Lock the day after exactly one signal.
//
// This is an in-sample historical calibration, not a promise of future
// performance. Generate signals on NQ1! one-minute standard candles and
// execute the displayed levels with MNQ micros.


// INPUTS

groupSession = "1. New York AM"
tz = input.string("America/New_York", "Timezone", group = groupSession)
mapSession = input.session("0700-0929", "Pre-open liquidity map", group = groupSession)
openingRangeSession = input.session("0930-0935", "Opening range observation", group = groupSession)
entrySession = input.session("0935-1046", "Calibrated signal window", group = groupSession)
deadlineSession = input.session("1045-1047", "Required daily decision", group = groupSession)
probabilityThreshold = input.float(0.95, "Replay qualification threshold", minval = 0.50, maxval = 1.00, step = 0.01, group = groupSession,
     tooltip = "Keep this at 0.95 to reproduce the supplied-data calibration.")
requireConfirmedClose = input.bool(true, "Signal only on confirmed candle close", group = groupSession)
enforceNQChart = input.bool(true, "Require NQ chart for signals", group = groupSession)
enforceStandardChart = input.bool(true, "Require standard OHLC chart", group = groupSession)

groupSequence = "2. Calibrated ICT Features"
atrLen = input.int(14, "ATR length", minval = 5, maxval = 50, group = groupSequence)
mssLookback = input.int(4, "Protected micro-structure lookback", minval = 2, maxval = 12, group = groupSequence)
dispATR = input.float(0.55, "Displacement range x ATR", minval = 0.35, maxval = 2.00, step = 0.05, group = groupSequence)
dispBodyMin = input.float(0.50, "Displacement body/range", minval = 0.35, maxval = 0.90, step = 0.05, group = groupSequence)
dispCloseEdge = input.float(0.65, "Displacement close at edge", minval = 0.55, maxval = 0.95, step = 0.01, group = groupSequence)
liquidityMemoryBars = input.int(30, "Named-liquidity event memory", minval = 5, maxval = 60, group = groupSequence)

groupRisk = "3. MNQ Risk and Target"
mnqQty = input.int(12, "MNQ contracts", minval = 1, maxval = 100, group = groupRisk)
riskDollars = input.float(1000.0, "Risk dollars", minval = 1.0, step = 25.0, group = groupRisk)
mnqPointValue = input.float(2.0, "MNQ dollars per point", minval = 0.01, step = 0.25, group = groupRisk)
tickSize = input.float(0.25, "NQ tick size", minval = 0.01, step = 0.25, group = groupRisk)
rr = input.float(1.50, "Target R multiple", minval = 0.50, maxval = 5.00, step = 0.25, group = groupRisk)

groupTracker = "4. Validation"
trackOutcomes = input.bool(true, "Track stop/target outcomes", group = groupTracker)
quickWinnerMinutes = input.int(10, "Quick winner threshold (minutes)", minval = 1, maxval = 60, group = groupTracker)

groupVisual = "5. Visuals and Alerts"
cleanCanvas = input.bool(true, "Clean canvas", group = groupVisual)
showDashboard = input.bool(true, "Show compact dashboard", group = groupVisual)
showSignalDetails = input.bool(true, "Show calibration details in signal label", group = groupVisual)
onlyLatestLines = input.bool(false, "Keep only latest entry lines", group = groupVisual)
lineBars = input.int(90, "Entry line length (bars)", minval = 15, maxval = 300, group = groupVisual)
labelOffsetATR = input.float(1.10, "Signal-label offset x ATR", minval = 0.25, maxval = 5.00, step = 0.05, group = groupVisual)


// HELPERS

f_inSession(string session) =>
    not na(time(timeframe.period, session, tz))

f_round(float price) =>
    math.round(price / tickSize) * tickSize

f_roundUp(float price) =>
    math.ceil(price / tickSize) * tickSize

f_price(float price) =>
    str.tostring(price, format.mintick)

f_recent(int eventBar, int lifeBars) =>
    not na(eventBar) and bar_index >= eventBar and bar_index - eventBar <= lifeBars

f_stopPoints() =>
    f_round(riskDollars / math.max(mnqQty * mnqPointValue, 0.01))

f_efficiency(int length) =>
    path = ta.sma(math.abs(close - close[1]), length) * length
    (close - close[length]) / math.max(path, tickSize)

f_deleteLine(line id) =>
    if not na(id)
        line.delete(id)


// CLOCK AND CHART GATES

inMap = f_inSession(mapSession)
mapStart = inMap and not inMap[1]
inOpeningRange = f_inSession(openingRangeSession)
inEntry = f_inSession(entrySession)
inDeadline = f_inSession(deadlineSession)
inRth = f_inSession("0930-1600")
newDay = ta.change(time("D", "0000-2359", tz)) != 0
newRth = inRth and (not inRth[1] or newDay)
deadlineBar = inDeadline and not inDeadline[1]

isOneMinute = timeframe.isminutes and timeframe.multiplier == 1
isNQ = str.upper(syminfo.root) == "NQ"
isStandardChart = chart.is_standard
chartReady = isOneMinute and (not enforceNQChart or isNQ) and (not enforceStandardChart or isStandardChart)
barEligible = chartReady and (not requireConfirmedClose or barstate.isconfirmed)


// NON-REPAINTING COMPLETED HIGHER-TIMEFRAME DATA

pdHigh = request.security(syminfo.tickerid, "D", high[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
pdLow = request.security(syminfo.tickerid, "D", low[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
fiveOpen = request.security(syminfo.tickerid, "5", open[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
fiveClose = request.security(syminfo.tickerid, "5", close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)


// SESSION MAP, OPENING RANGE, AND VWAP

var float mapHigh = na
var float mapLow = na
var float orHigh = na
var float orLow = na
var float rthOpen = na
var float rthHigh = na
var float rthLow = na
var float rthPV = 0.0
var float rthVolume = 0.0

if newDay
    mapHigh := na
    mapLow := na

if mapStart
    mapHigh := high
    mapLow := low
else if inMap
    mapHigh := na(mapHigh) ? high : math.max(mapHigh, high)
    mapLow := na(mapLow) ? low : math.min(mapLow, low)

barVolume = math.max(nz(volume, 1.0), 1.0)

if newRth
    orHigh := high
    orLow := low
    rthOpen := open
    rthHigh := high
    rthLow := low
    rthPV := hlc3 * barVolume
    rthVolume := barVolume
else
    if inOpeningRange
        orHigh := na(orHigh) ? high : math.max(orHigh, high)
        orLow := na(orLow) ? low : math.min(orLow, low)
    if inRth
        rthHigh := na(rthHigh) ? high : math.max(rthHigh, high)
        rthLow := na(rthLow) ? low : math.min(rthLow, low)
        rthPV += hlc3 * barVolume
        rthVolume += barVolume

orReady = inRth and not inOpeningRange and not na(orHigh) and not na(orLow)
orRange = orReady ? orHigh - orLow : na
orMid = orReady ? (orHigh + orLow) / 2.0 : na
rthVwap = rthVolume > 0.0 ? rthPV / rthVolume : na
rthRange = not na(rthHigh) and not na(rthLow) ? rthHigh - rthLow : na
rthPosition = not na(rthRange) and rthRange > tickSize ? (close - rthLow) / rthRange : 0.50


// CAUSAL CALIBRATION FEATURES

atr = ta.atr(atrLen)
stopPoints = f_stopPoints()
targetPoints = f_roundUp(stopPoints * rr)
barRange = math.max(high - low, tickSize)
bodySigned = (close - open) / barRange
bodyRatio = math.abs(close - open) / barRange
closePosition = (close - low) / barRange

bullDisplacement = close > open and barRange >= atr * dispATR and bodyRatio >= dispBodyMin and closePosition >= dispCloseEdge
bearDisplacement = close < open and barRange >= atr * dispATR and bodyRatio >= dispBodyMin and closePosition <= 1.0 - dispCloseEdge
bullShiftNow = bullDisplacement and close > ta.highest(high, mssLookback)[1]
bearShiftNow = bearDisplacement and close < ta.lowest(low, mssLookback)[1]
bullFlowNow = close > open and close > close[1] and close > high[1]
bearFlowNow = close < open and close < close[1] and close < low[1]
bullFvgNow = low >= high[2] + tickSize
bearFvgNow = high <= low[2] - tickSize

// The replay model used a fixed two-tick breach of any named pool.
dataRaidBuffer = 2.0 * tickSize
dataLowRaidNow = inRth and ((orReady and low <= orLow - dataRaidBuffer) or (not na(mapLow) and low <= mapLow - dataRaidBuffer) or (not na(pdLow) and low <= pdLow - dataRaidBuffer))
dataHighRaidNow = inRth and ((orReady and high >= orHigh + dataRaidBuffer) or (not na(mapHigh) and high >= mapHigh + dataRaidBuffer) or (not na(pdHigh) and high >= pdHigh + dataRaidBuffer))
var int lastDataLowRaidBar = na
var int lastDataHighRaidBar = na
if newRth
    lastDataLowRaidBar := na
    lastDataHighRaidBar := na
if dataLowRaidNow
    lastDataLowRaidBar := bar_index
if dataHighRaidNow
    lastDataHighRaidBar := bar_index
recentDataLowRaid = f_recent(lastDataLowRaidBar, liquidityMemoryBars)
recentDataHighRaid = f_recent(lastDataHighRaidBar, liquidityMemoryBars)

rthReturnR = (close - rthOpen) / math.max(stopPoints, tickSize)
orPositionR = (close - orMid) / math.max(stopPoints, tickSize)
vwapDistanceR = (close - rthVwap) / math.max(stopPoints, tickSize)
fiveBodyR = (fiveClose - fiveOpen) / math.max(stopPoints, tickSize)
vwapSlopeR = (rthVwap - rthVwap[3]) / math.max(stopPoints, tickSize)
mom2R = (close - close[2]) / math.max(stopPoints, tickSize)
mom3R = (close - close[3]) / math.max(stopPoints, tickSize)
mom5R = (close - close[5]) / math.max(stopPoints, tickSize)
mom10R = (close - close[10]) / math.max(stopPoints, tickSize)
mom15R = (close - close[15]) / math.max(stopPoints, tickSize)
eff5 = f_efficiency(5)
eff10 = f_efficiency(10)
eff20 = f_efficiency(20)
barRangeAtr = barRange / math.max(atr, tickSize)
volumeMedian20 = ta.median(barVolume, 20)
volumeRatio20 = barVolume / math.max(volumeMedian20, 1.0)
orRangeAtr = orRange / math.max(atr, tickSize)
rthRangeAtr = rthRange / math.max(atr, tickSize)
minuteFromOpen = hour(time, tz) * 60 + minute(time, tz) - 570


// Generated by analysis/build_replay_tree.py. Do not hand-edit.
// Features (zero based):
// 0: side_rth_return_r
// 1: side_or_position_r
// 2: side_vwap_distance_r
// 3: side_five_body_r
// 4: side_vwap_slope3
// 5: side_mom_2
// 6: side_mom_3
// 7: side_mom_5
// 8: side_mom_10
// 9: side_mom_15
// 10: side_eff_5
// 11: side_eff_10
// 12: side_eff_20
// 13: side_body_signed
// 14: minute_from_open
// 15: atr14
// 16: bar_range_atr
// 17: volume_ratio20
// 18: or_range_atr
// 19: rth_range_atr
// 20: range_pos
// 21: side_close_edge
// 22: side_or_break_r
// 23: side_shift
// 24: side_flow
// 25: side_fvg
// 26: opposite_raid_recent
// 27: same_side_raid_recent

