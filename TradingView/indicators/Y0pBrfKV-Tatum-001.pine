//@version=6
//@version=6
indicator("8 AM & Asia ORB | 30T, 100T & 200T", overlay=true, max_boxes_count=20, max_lines_count=60, max_labels_count=60)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// GENERAL SETTINGS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

string TZ = "America/New_York"

bool showMorning = input.bool(true, "Show 8 AM ORB", group="General")
bool showAsia = input.bool(true, "Show Asia ORB", group="General")
bool showLabels = input.bool(true, "Show Labels", group="General")

int extensionMinutes = input.int(
     10,
     "Visual Extension (Minutes)",
     minval=0,
     maxval=120,
     group="General"
)

int labelOffsetMinutes = input.int(
     5,
     "Label Offset (Minutes)",
     minval=0,
     maxval=60,
     group="General"
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 8 AM ORB SETTINGS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

int morning30 = input.int(
     30,
     "30 Tick Buffer",
     minval=1,
     group="8 AM ORB Settings"
)

int morning100 = input.int(
     100,
     "100 Tick Buffer",
     minval=1,
     group="8 AM ORB Settings"
)

int morning200 = input.int(
     100,
     "Additional 100 Ticks",
     minval=1,
     group="8 AM ORB Settings"
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 8 AM BOX SETTINGS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

color morningFill = input.color(
     color.blue,
     "Fill Color",
     group="8 AM ORB Box"
)

int morningTransparency = input.int(
     85,
     "Fill Transparency",
     minval=0,
     maxval=100,
     group="8 AM ORB Box"
)

bool showMorningBorder = input.bool(
     true,
     "Show Border",
     group="8 AM ORB Box"
)

color morningBorder = input.color(
     color.blue,
     "Border Color",
     group="8 AM ORB Box"
)

int morningBorderWidth = input.int(
     2,
     "Border Width",
     minval=1,
     maxval=5,
     group="8 AM ORB Box"
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 8 AM 30T LINE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

color morning30Color = input.color(
     color.yellow,
     "30T Color",
     group="8 AM 30T Lines"
)

int morning30Width = input.int(
     1,
     "30T Width",
     minval=1,
     maxval=5,
     group="8 AM 30T Lines"
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 8 AM 100T LINE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

color morning100Color = input.color(
     color.red,
     "100T Color",
     group="8 AM 100T Lines"
)

int morning100Width = input.int(
     1,
     "100T Width",
     minval=1,
     maxval=5,
     group="8 AM 100T Lines"
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 8 AM 200T LINE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

color morning200Color = input.color(
     color.orange,
     "200T Color",
     group="8 AM 200T Lines"
)

int morning200Width = input.int(
     1,
     "200T Width",
     minval=1,
     maxval=5,
     group="8 AM 200T Lines"
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 8 AM LABELS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

color morningLabelColor = input.color(
     color.blue,
     "ORB Label Background",
     group="8 AM Labels"
)

color morningLabelText = input.color(
     color.white,
     "ORB Label Text",
     group="8 AM Labels"
)

color morning30Label = input.color(
     color.yellow,
     "30T Label Background",
     group="8 AM Labels"
)

color morning30Text = input.color(
     color.black,
     "30T Label Text",
     group="8 AM Labels"
)

color morning100Label = input.color(
     color.red,
     "100T Label Background",
     group="8 AM Labels"
)

color morning100Text = input.color(
     color.white,
     "100T Label Text",
     group="8 AM Labels"
)

color morning200Label = input.color(
     color.orange,
     "200T Label Background",
     group="8 AM Labels"
)

color morning200Text = input.color(
     color.white,
     "200T Label Text",
     group="8 AM Labels"
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ASIA ORB SETTINGS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

int asia30 = input.int(
     30,
     "30 Tick Buffer",
     minval=1,
     group="Asia ORB Settings"
)

int asia100 = input.int(
     100,
     "100 Tick Buffer",
     minval=1,
     group="Asia ORB Settings"
)

int asia200 = input.int(
     100,
     "Additional 100 Ticks",
     minval=1,
     group="Asia ORB Settings"
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ASIA BOX SETTINGS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

color asiaFill = input.color(
     color.purple,
     "Fill Color",
     group="Asia ORB Box"
)

int asiaTransparency = input.int(
     85,
     "Fill Transparency",
     minval=0,
     maxval=100,
     group="Asia ORB Box"
)

bool showAsiaBorder = input.bool(
     true,
     "Show Border",
     group="Asia ORB Box"
)

color asiaBorder = input.color(
     color.purple,
     "Border Color",
     group="Asia ORB Box"
)

int asiaBorderWidth = input.int(
     2,
     "Border Width",
     minval=1,
     maxval=5,
     group="Asia ORB Box"
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ASIA 30T LINE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

color asia30Color = input.color(
     color.aqua,
     "30T Color",
     group="Asia 30T Lines"
)

int asia30Width = input.int(
     1,
     "30T Width",
     minval=1,
     maxval=5,
     group="Asia 30T Lines"
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ASIA 100T LINE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

color asia100Color = input.color(
     color.fuchsia,
     "100T Color",
     group="Asia 100T Lines"
)

int asia100Width = input.int(
     1,
     "100T Width",
     minval=1,
     maxval=5,
     group="Asia 100T Lines"
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ASIA 200T LINE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

color asia200Color = input.color(
     color.white,
     "200T Color",
     group="Asia 200T Lines"
)

int asia200Width = input.int(
     1,
     "200T Width",
     minval=1,
     maxval=5,
     group="Asia 200T Lines"
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ASIA LABELS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

color asiaLabelColor = input.color(
     color.purple,
     "ORB Label Background",
     group="Asia Labels"
)

color asiaLabelText = input.color(
     color.white,
     "ORB Label Text",
     group="Asia Labels"
)

color asia30Label = input.color(
     color.aqua,
     "30T Label Background",
     group="Asia Labels"
)

color asia30Text = input.color(
     color.black,
     "30T Label Text",
     group="Asia Labels"
)

color asia100Label = input.color(
     color.fuchsia,
     "100T Label Background",
     group="Asia Labels"
)

color asia100Text = input.color(
     color.white,
     "100T Label Text",
     group="Asia Labels"
)

color asia200Label = input.color(
     color.white,
     "200T Label Background",
     group="Asia Labels"
)

color asia200Text = input.color(
     color.black,
     "200T Label Text",
     group="Asia Labels"
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TIME CONDITIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bool morningRange =
     hour(time, TZ) == 8 and
     minute(time, TZ) >= 0 and
     minute(time, TZ) < 5

bool morningFinish =
     hour(time, TZ) == 8 and
     minute(time, TZ) == 5

bool asiaRange =
     hour(time, TZ) == 18 and
     minute(time, TZ) >= 0 and
     minute(time, TZ) < 5

bool asiaFinish =
     hour(time, TZ) == 18 and
     minute(time, TZ) == 5

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MORNING VARIABLES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var float mHigh = na
var float mLow = na
var bool mComplete = false

var box mBox = na

var line m30HighLine = na
var line m30LowLine = na
var line m100HighLine = na
var line m100LowLine = na
var line m200HighLine = na
var line m200LowLine = na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ASIA VARIABLES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var float aHigh = na
var float aLow = na
var bool aComplete = false
var int asiaCutoffTime = na

var box aBox = na

var line a30HighLine = na
var line a30LowLine = na
var line a100HighLine = na
var line a100LowLine = na
var line a200HighLine = na
var line a200LowLine = na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// NEW DAY RESET
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bool newDay = ta.change(dayofmonth(time, TZ)) != 0

if newDay
    mHigh := na
    mLow := na
    mComplete := false

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ASIA RESET
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bool asiaStart = asiaRange and not asiaRange[1]

if asiaStart
    aHigh := na
    aLow := na
    aComplete := false
    asiaCutoffTime := na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BUILD MORNING ORB
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if morningRange and showMorning
    mHigh := na(mHigh) ? high : math.max(mHigh, high)
    mLow := na(mLow) ? low : math.min(mLow, low)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BUILD ASIA ORB
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if asiaRange and showAsia
    aHigh := na(aHigh) ? high : math.max(aHigh, high)
    aLow := na(aLow) ? low : math.min(aLow, low)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CREATE MORNING ORB
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if morningFinish and showMorning and not mComplete and not na(mHigh) and not na(mLow)

    mComplete := true

    float m30H = mHigh + morning30 * syminfo.mintick
    float m30L = mLow - morning30 * syminfo.mintick

    float m100H = mHigh + morning100 * syminfo.mintick
    float m100L = mLow - morning100 * syminfo.mintick

    float m200H = m100H + morning200 * syminfo.mintick
    float m200L = m100L - morning200 * syminfo.mintick

    int ext = extensionMinutes * 60 * 1000
    int labelOffset = labelOffsetMinutes * 60 * 1000

    int leftTime = time - ext
    int labelTime = leftTime - labelOffset

    int morningCutoffTime = timestamp(
         TZ,
         year(time, TZ),
         month(time, TZ),
         dayofmonth(time, TZ),
         9,
         30
     )

    int rightTime = math.min(
         time + ext,
         morningCutoffTime
     )

    // BOX
    mBox := box.new(
         left=leftTime,
         top=mHigh,
         right=rightTime,
         bottom=mLow,
         xloc=xloc.bar_time,
         border_color=showMorningBorder ? morningBorder : na,
         border_width=showMorningBorder ? morningBorderWidth : 0,
         bgcolor=color.new(morningFill, morningTransparency)
     )

    // +30T
    m30HighLine := line.new(
         leftTime, m30H,
         rightTime, m30H,
         xloc=xloc.bar_time,
         color=morning30Color,
         width=morning30Width
     )

    // -30T
    m30LowLine := line.new(
         leftTime, m30L,
         rightTime, m30L,
         xloc=xloc.bar_time,
         color=morning30Color,
         width=morning30Width
     )

    // +100T
    m100HighLine := line.new(
         leftTime, m100H,
         rightTime, m100H,
         xloc=xloc.bar_time,
         color=morning100Color,
         width=morning100Width
     )

    // -100T
    m100LowLine := line.new(
         leftTime, m100L,
         rightTime, m100L,
         xloc=xloc.bar_time,
         color=morning100Color,
         width=morning100Width
     )

    // +200T
    m200HighLine := line.new(
         leftTime, m200H,
         rightTime, m200H,
         xloc=xloc.bar_time,
         color=morning200Color,
         width=morning200Width
     )

    // -200T
    m200LowLine := line.new(
         leftTime, m200L,
         rightTime, m200L,
         xloc=xloc.bar_time,
         color=morning200Color,
         width=morning200Width
     )

    //━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // MORNING LABELS
    //━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    if showLabels

        label.new(
             labelTime,
             mHigh,
             "8:00–8:05 ORB",
             xloc=xloc.bar_time,
             style=label.style_label_right,
             color=morningLabelColor,
             textcolor=morningLabelText,
             size=size.small
         )

        label.new(
             labelTime,
             m30H,
             "+30T",
             xloc=xloc.bar_time,
             style=label.style_label_right,
             color=morning30Label,
             textcolor=morning30Text,
             size=size.small
         )

        label.new(
             labelTime,
             m30L,
             "-30T",
             xloc=xloc.bar_time,
             style=label.style_label_right,
             color=morning30Label,
             textcolor=morning30Text,
             size=size.small
         )

        label.new(
             labelTime,
             m100H,
             "+100T",
             xloc=xloc.bar_time,
             style=label.style_label_right,
             color=morning100Label,
             textcolor=morning100Text,
             size=size.small
         )

        label.new(
             labelTime,
             m100L,
             "-100T",
             xloc=xloc.bar_time,
             style=label.style_label_right,
             color=morning100Label,
             textcolor=morning100Text,
             size=size.small
         )

        label.new(
             labelTime,
             m200H,
             "+200T",
             xloc=xloc.bar_time,
             style=label.style_label_right,
             color=morning200Label,
             textcolor=morning200Text,
             size=size.small
         )

        label.new(
             labelTime,
             m200L,
             "-200T",
             xloc=xloc.bar_time,
             style=label.style_label_right,
             color=morning200Label,
             textcolor=morning200Text,
             size=size.small
         )

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CREATE ASIA ORB
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if asiaFinish and showAsia and not aComplete and not na(aHigh) and not na(aLow)

    aComplete := true

    float a30H = aHigh + asia30 * syminfo.mintick
    float a30L = aLow - asia30 * syminfo.mintick

    float a100H = aHigh + asia100 * syminfo.mintick
    float a100L = aLow - asia100 * syminfo.mintick

    float a200H = a100H + asia200 * syminfo.mintick
    float a200L = a100L - asia200 * syminfo.mintick

    // HARD 7:30 PM ET CUTOFF
    asiaCutoffTime := timestamp(
         TZ,
         year(time, TZ),
         month(time, TZ),
         dayofmonth(time, TZ),
         19,
         30
     )

    int ext = extensionMinutes * 60 * 1000
    int labelOffset = labelOffsetMinutes * 60 * 1000

    int leftTime = time - ext
    int labelTime = leftTime - labelOffset

    int rightTime = math.min(
         time + ext,
         asiaCutoffTime
     )

    // BOX
    aBox := box.new(
         left=leftTime,
         top=aHigh,
         right=rightTime,
         bottom=aLow,
         xloc=xloc.bar_time,
         border_color=showAsiaBorder ? asiaBorder : na,
         border_width=showAsiaBorder ? asiaBorderWidth : 0,
         bgcolor=color.new(asiaFill, asiaTransparency)
     )

    // +30T
    a30HighLine := line.new(
         leftTime, a30H,
         rightTime, a30H,
         xloc=xloc.bar_time,
         color=asia30Color,
         width=asia30Width
     )

    // -30T
    a30LowLine := line.new(
         leftTime, a30L,
         rightTime, a30L,
         xloc=xloc.bar_time,
         color=asia30Color,
         width=asia30Width
     )

    // +100T
    a100HighLine := line.new(
         leftTime, a100H,
         rightTime, a100H,
         xloc=xloc.bar_time,
         color=asia100Color,
         width=asia100Width
     )

    // -100T
    a100LowLine := line.new(
         leftTime, a100L,
         rightTime, a100L,
         xloc=xloc.bar_time,
         color=asia100Color,
         width=asia100Width
     )

    // +200T
    a200HighLine := line.new(
         leftTime, a200H,
         rightTime, a200H,
         xloc=xloc.bar_time,
         color=asia200Color,
         width=asia200Width
     )

    // -200T
    a200LowLine := line.new(
         leftTime, a200L,
         rightTime, a200L,
         xloc=xloc.bar_time,
         color=asia200Color,
         width=asia200Width
     )

    //━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // ASIA LABELS
    //━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    if showLabels

        label.new(
             labelTime,
             aHigh,
             "6:00–6:05 PM ASIA",
             xloc=xloc.bar_time,
             style=label.style_label_right,
             color=asiaLabelColor,
             textcolor=asiaLabelText,
             size=size.small
         )

        label.new(
             labelTime,
             a30H,
             "+30T",
             xloc=xloc.bar_time,
             style=label.style_label_right,
             color=asia30Label,
             textcolor=asia30Text,
             size=size.small
         )

        label.new(
             labelTime,
             a30L,
             "-30T",
             xloc=xloc.bar_time,
             style=label.style_label_right,
             color=asia30Label,
             textcolor=asia30Text,
             size=size.small
         )

        label.new(
             labelTime,
             a100H,
             "+100T",
             xloc=xloc.bar_time,
             style=label.style_label_right,
             color=asia100Label,
             textcolor=asia100Text,
             size=size.small
         )

        label.new(
             labelTime,
             a100L,
             "-100T",
             xloc=xloc.bar_time,
             style=label.style_label_right,
             color=asia100Label,
             textcolor=asia100Text,
             size=size.small
         )

        label.new(
             labelTime,
             a200H,
             "+200T",
             xloc=xloc.bar_time,
             style=label.style_label_right,
             color=asia200Label,
             textcolor=asia200Text,
             size=size.small
         )

        label.new(
             labelTime,
             a200L,
             "-200T",
             xloc=xloc.bar_time,
             style=label.style_label_right,
             color=asia200Label,
             textcolor=asia200Text,
             size=size.small
         )

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MORNING — HARD STOP AT 9:30 AM ET
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if mComplete

    int morningCutoffTime = timestamp(
         TZ,
         year(time, TZ),
         month(time, TZ),
         dayofmonth(time, TZ),
         9,
         30
     )

    int morningEnd = math.min(
         time + extensionMinutes * 60 * 1000,
         morningCutoffTime
     )

    if not na(mBox)
        box.set_right(mBox, morningEnd)

    if not na(m30HighLine)
        line.set_x2(m30HighLine, morningEnd)

    if not na(m30LowLine)
        line.set_x2(m30LowLine, morningEnd)

    if not na(m100HighLine)
        line.set_x2(m100HighLine, morningEnd)

    if not na(m100LowLine)
        line.set_x2(m100LowLine, morningEnd)

    if not na(m200HighLine)
        line.set_x2(m200HighLine, morningEnd)

    if not na(m200LowLine)
        line.set_x2(m200LowLine, morningEnd)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ASIA — HARD STOP AT EXACTLY 7:30 PM ET
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if aComplete and not na(asiaCutoffTime)

    if not na(aBox)
        box.set_right(aBox, asiaCutoffTime)

    if not na(a30HighLine)
        line.set_x2(a30HighLine, asiaCutoffTime)

    if not na(a30LowLine)
        line.set_x2(a30LowLine, asiaCutoffTime)

    if not na(a100HighLine)
        line.set_x2(a100HighLine, asiaCutoffTime)

    if not na(a100LowLine)
        line.set_x2(a100LowLine, asiaCutoffTime)

    if not na(a200HighLine)
        line.set_x2(a200HighLine, asiaCutoffTime)

    if not na(a200LowLine)
        line.set_x2(a200LowLine, asiaCutoffTime)
plot(close)
