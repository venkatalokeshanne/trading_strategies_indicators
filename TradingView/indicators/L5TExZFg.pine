c3BearRaw = c3valid and ta.crossunder(c3fast, c3slow)

c3Bull = crossModule and cross3Enabled and c3BullRaw and (not cross3Close or barstate.isconfirmed)
c3Bear = crossModule and cross3Enabled and c3BearRaw and (not cross3Close or barstate.isconfirmed)

