//@version=6
indicator("Options Oracle Pro", shorttitle="Oracle Pro", overlay=true, max_lines_count=100, max_labels_count=50)

// ══════════════════════════════════════════════════════════════
// SETTINGS
// ══════════════════════════════════════════════════════════════
grpEM = "════ Expected Move ════"
emLength     = input.int(14, "Volatility Length", minval=1, group=grpEM)
emMult       = input.float(1.0, "EM Multiplier", step=0.1, group=grpEM)
showEMZone   = input.bool(true, "Show Expected Move Zone", group=grpEM)

grpLevels = "════ Auto Levels ════"
lookback     = input.int(50, "Levels Lookback", minval=20, group=grpLevels)
minDistance  = input.float(1.5, "Min Distance (ATR)", step=0.1, group=grpLevels)
showWalls    = input.bool(true, "Show Auto Walls", group=grpLevels)
showMaxPain  = input.bool(true, "Show Auto Max Pain", group=grpLevels)
showTargets  = input.bool(true, "Show Targets", group=grpLevels)

grpStyle = "════ Style ════"
emColor      = input.color(color.new(color.teal, 0), "Expected Move Color", group=grpStyle)
maxPainColor = input.color(color.orange, "Max Pain Color", group=grpStyle)
callColor    = input.color(color.red, "Call Wall Color", group=grpStyle)
putColor     = input.color(color.green, "Put Wall Color", group=grpStyle)

// ══════════════════════════════════════════════════════════════
// CALCULATIONS - Expected Move
// ══════════════════════════════════════════════════════════════
atr = ta.atr(emLength)
expectedMove = atr * emMult

upperEM = close + expectedMove
lowerEM = close - expectedMove

// ══════════════════════════════════════════════════════════════
// CALCULATIONS - Auto Call Wall & Put Wall
// ══════════════════════════════════════════════════════════════
highestHigh = ta.highest(high, lookback)
lowestLow   = ta.lowest(low, lookback)

ph = ta.pivothigh(high, 8, 8)
pl = ta.pivotlow(low, 8, 8)

var float callWall = na
var float putWall  = na
var float callStrength = 0.0
var float putStrength  = 0.0

if not na(ph)
    if ph > close + atr * minDistance
        callWall := ph
        callStrength := 3.0
    else if ph > close + atr * 0.8
        callWall := ph
        callStrength := 2.0

if not na(pl)
    if pl < close - atr * minDistance
        putWall := pl
        putStrength := 3.0
    else if pl < close - atr * 0.8
        putWall := pl
        putStrength := 2.0

if na(callWall) or callWall < close
    callWall := highestHigh
    callStrength := 1.5

if na(putWall) or putWall > close
    putWall := lowestLow
    putStrength := 1.5

callWall := math.max(callWall, close + atr * minDistance)
putWall  := math.min(putWall, close - atr * minDistance)

// ══════════════════════════════════════════════════════════════
// CALCULATIONS - Auto Max Pain
// ══════════════════════════════════════════════════════════════
vwapVal   = ta.vwap(hlc3)
midRange  = (highestHigh + lowestLow) / 2
emaFast   = ta.ema(close, 21)

autoMaxPain = (vwapVal * 0.45 + midRange * 0.35 + emaFast * 0.20)

// ══════════════════════════════════════════════════════════════
// CALCULATIONS - Fixed Targets (Less sticky to Walls)
// ══════════════════════════════════════════════════════════════
var float targetUp   = na
var float targetDown = na

maxAllowedDist = expectedMove * 3.5

// Target Up - mild influence from Call Wall
needNewUp = na(targetUp) or close >= targetUp or (targetUp - close) > maxAllowedDist or targetUp < close
if needNewUp
    targetUp := close + expectedMove * 1.618
    // Only pull toward Call Wall if it's reasonably close
    if callStrength >= 2.5 and callWall < targetUp + expectedMove * 0.6
        targetUp := (targetUp * 0.7 + callWall * 0.3)

// Target Down - mild influence from Put Wall
needNewDown = na(targetDown) or close <= targetDown or (close - targetDown) > maxAllowedDist or targetDown > close
if needNewDown
    targetDown := close - expectedMove * 1.618
    // Only pull toward Put Wall if it's reasonably close
    if putStrength >= 2.5 and putWall > targetDown - expectedMove * 0.6
        targetDown := (targetDown * 0.7 + putWall * 0.3)

// Final safety
targetUp   := math.max(targetUp, close + atr * 1.2)
targetDown := math.min(targetDown, close - atr * 1.2)

// ══════════════════════════════════════════════════════════════
// CALCULATIONS - Probability %
// ══════════════════════════════════════════════════════════════
calcProb(target) =>
    dist = math.abs(target - close)
    z = expectedMove > 0 ? dist / expectedMove : 2.0
    prob = 100 - (z * 28)
    math.max(12, math.min(88, prob))

probUp   = calcProb(targetUp)
probDown = calcProb(targetDown)

probUpText   = str.tostring(math.round(probUp)) + "%"
probDownText = str.tostring(math.round(probDown)) + "%"

probUpColor   = probUp >= 60 ? color.lime : probUp >= 40 ? color.yellow : color.orange
probDownColor = probDown >= 60 ? color.lime : probDown >= 40 ? color.yellow : color.orange

// ══════════════════════════════════════════════════════════════
// CALCULATIONS - Options Bias
// ══════════════════════════════════════════════════════════════
biasScore = 0
biasScore += close > autoMaxPain ? 1 : -1
biasScore += close > vwapVal ? 1 : -1
biasScore += close > emaFast ? 1 : -1
biasScore += close > (callWall + putWall) / 2 ? 1 : -1

biasText  = biasScore >= 2 ? "Bullish" : biasScore <= -2 ? "Bearish" : "Neutral"
biasColor = biasScore >= 2 ? color.lime : biasScore <= -2 ? color.red : color.yellow

callStrText = callStrength >= 2.5 ? "Strong" : callStrength >= 1.8 ? "Medium" : "Weak"
putStrText  = putStrength  >= 2.5 ? "Strong" : putStrength  >= 1.8 ? "Medium" : "Weak"

// ══════════════════════════════════════════════════════════════
// CALCULATIONS - Suggested Side
// ══════════════════════════════════════════════════════════════
suggestedSide = "Neutral / Wait"
sideColor     = color.yellow
sideReason    = "No clear edge"

if biasScore >= 2 and close > autoMaxPain and probUp >= probDown
    suggestedSide := "Prefer Call"
    sideColor     := color.lime
    sideReason    := "Bullish + Above Max Pain"
else if biasScore <= -2 and close < autoMaxPain and probDown >= probUp
    suggestedSide := "Prefer Put"
    sideColor     := color.red
    sideReason    := "Bearish + Below Max Pain"
else if biasScore >= 2 and probUp > probDown + 8
    suggestedSide := "Prefer Call"
    sideColor     := color.lime
    sideReason    := "Strong Bullish Bias"
else if biasScore <= -2 and probDown > probUp + 8
    suggestedSide := "Prefer Put"
    sideColor     := color.red
    sideReason    := "Strong Bearish Bias"
else if close > autoMaxPain and probUp > 55
    suggestedSide := "Lean Call"
    sideColor     := color.new(color.lime, 20)
    sideReason    := "Above Max Pain"
else if close < autoMaxPain and probDown > 55
    suggestedSide := "Lean Put"
    sideColor     := color.new(color.red, 20)
    sideReason    := "Below Max Pain"

// ══════════════════════════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════════════════════════
emUpperPlot = plot(showEMZone ? upperEM : na, "EM Upper", color=color.new(emColor, 75), linewidth=1)
emLowerPlot = plot(showEMZone ? lowerEM : na, "EM Lower", color=color.new(emColor, 75), linewidth=1)
fill(emUpperPlot, emLowerPlot, color=color.new(emColor, 90), title="Expected Move Zone")

plot(showMaxPain ? autoMaxPain : na, "Max Pain", color=maxPainColor, linewidth=2)
plot(showWalls ? callWall : na, "Call Wall", color=callColor, linewidth=2)
plot(showWalls ? putWall : na, "Put Wall", color=putColor, linewidth=2)

plot(showTargets ? targetUp : na, "Target Up", color=color.new(color.lime, 45), linewidth=1, style=plot.style_linebr)
plot(showTargets ? targetDown : na, "Target Down", color=color.new(color.red, 45), linewidth=1, style=plot.style_linebr)

// ══════════════════════════════════════════════════════════════
// DASHBOARD
// ══════════════════════════════════════════════════════════════
var table dash = table.new(position.top_right, 2, 16, 
     bgcolor = color.new(#0B0E11, 5),
     border_color = color.new(#30363D, 50),
     border_width = 1,
     frame_color = color.new(#30363D, 60),
     frame_width = 1)

if barstate.islast
    table.cell(dash, 0, 0, "OPTIONS ORACLE PRO", text_color=color.white, text_size=size.normal, bgcolor=color.new(#1F6FEB, 25))
    table.merge_cells(dash, 0, 0, 1, 0)
    
    table.cell(dash, 0, 1, "Current Price", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(close, format.mintick), text_color=color.white, text_size=size.normal)
    
    table.cell(dash, 0, 2, "Expected Move", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(expectedMove, format.mintick), text_color=color.teal, text_size=size.normal)
    
    table.cell(dash, 0, 3, "Target Up", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(targetUp, format.mintick) + "   " + probUpText, text_color=probUpColor, text_size=size.normal)
    
    table.cell(dash, 0, 4, "Target Down", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(targetDown, format.mintick) + "   " + probDownText, text_color=probDownColor, text_size=size.normal)
    
    table.cell(dash, 0, 5, "Max Pain (Auto)", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 5, str.tostring(autoMaxPain, format.mintick), text_color=color.orange, text_size=size.normal)
    
    table.cell(dash, 0, 6, "Call Wall (Auto)", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(callWall, format.mintick) + "  (" + callStrText + ")", text_color=color.red, text_size=size.normal)
    
    table.cell(dash, 0, 7, "Put Wall (Auto)", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 7, str.tostring(putWall, format.mintick) + "  (" + putStrText + ")", text_color=color.green, text_size=size.normal)
    
    table.cell(dash, 0, 8, "──────────", text_color=color.gray, text_size=size.tiny)
    table.merge_cells(dash, 0, 8, 1, 8)
    
    table.cell(dash, 0, 9, "Options Bias", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 9, biasText, text_color=biasColor, text_size=size.normal)
    
    table.cell(dash, 0, 10, "Suggested Side", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 10, suggestedSide, text_color=sideColor, text_size=size.normal)
    
    table.cell(dash, 0, 11, "Reason", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 11, sideReason, text_color=color.white, text_size=size.small)
    
    table.cell(dash, 0, 12, "Fixed Targets + Auto", text_color=color.new(color.gray, 30), text_size=size.tiny)
    table.merge_cells(dash, 0, 12, 1, 12)
    
    table.cell(dash, 0, 13, "Made with sulaman", text_color=color.new(color.gray, 50), text_size=size.tiny)
    table.merge_cells(dash, 0, 13, 1, 13)