//@version=6
indicator("Universal OANDA ADR Panel + Current Day Range", overlay=true)

string SRC = syminfo.tickerid

// Current day live range
todayHigh = request.security(SRC, "D", high, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
todayLow  = request.security(SRC, "D", low, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
todayRange = todayHigh - todayLow

// Completed daily candles
yH1 = request.security(SRC, "D", high[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
yL1 = request.security(SRC, "D", low[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
yH2 = request.security(SRC, "D", high[2], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
yL2 = request.security(SRC, "D", low[2], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
yH3 = request.security(SRC, "D", high[3], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
yL3 = request.security(SRC, "D", low[3], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
yH4 = request.security(SRC, "D", high[4], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
yL4 = request.security(SRC, "D", low[4], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
yH5 = request.security(SRC, "D", high[5], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
yL5 = request.security(SRC, "D", low[5], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
yH6 = request.security(SRC, "D", high[6], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
yL6 = request.security(SRC, "D", low[6], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

yesterdayRange = yH1 - yL1
range2 = yH2 - yL2
range3 = yH3 - yL3
range4 = yH4 - yL4
range5 = yH5 - yL5
range6 = yH6 - yL6

adr3 = (range2 + range3 + range4) / 3.0
adr5 = (range2 + range3 + range4 + range5 + range6) / 5.0

break3 = yesterdayRange > adr3
break5 = yesterdayRange > adr5

// Display always cuts decimals down; calculations keep full precision.
fmt(float v) =>
    str.tostring(math.floor(v), "#")

statusText(bool isBreak) =>
    isBreak ? "BREAK" : "NO BREAK"

statusColor(bool isBreak) =>
    isBreak ? color.red : color.green

var table t = table.new(position.top_right, 3, 7, frame_width=1)

if barstate.islast
    table.cell(t, 0, 0, syminfo.ticker, text_color=color.white, bgcolor=color.rgb(31, 78, 121), text_size=size.small, text_formatting=text.format_bold)
    table.cell(t, 1, 0, "VALUE", text_color=color.white, bgcolor=color.rgb(31, 78, 121), text_size=size.small, text_formatting=text.format_bold)
    table.cell(t, 2, 0, "STATUS", text_color=color.white, bgcolor=color.rgb(31, 78, 121), text_size=size.small, text_formatting=text.format_bold)

    // Live current-day range
    table.cell(t, 0, 1, "TODAY RANGE", text_size=size.small, text_formatting=text.format_bold)
    table.cell(t, 1, 1, "$" + fmt(todayRange), text_size=size.small, text_formatting=text.format_bold)
    table.cell(t, 2, 1, "LIVE", bgcolor=color.rgb(55, 55, 55), text_color=color.white, text_size=size.small, text_formatting=text.format_bold)

    table.cell(t, 0, 2, "YESTERDAY RANGE", text_size=size.small, text_formatting=text.format_bold)
    table.cell(t, 1, 2, "$" + fmt(yesterdayRange), text_size=size.small, text_formatting=text.format_bold)
    table.cell(t, 2, 2, "—", text_size=size.small, text_formatting=text.format_bold)

    table.cell(t, 0, 3, "3D ADR", text_size=size.small, text_formatting=text.format_bold)
    table.cell(t, 1, 3, "$" + fmt(adr3), text_size=size.small, text_formatting=text.format_bold)
    table.cell(t, 2, 3, statusText(break3), bgcolor=statusColor(break3), text_color=color.white, text_size=size.small, text_formatting=text.format_bold)

    table.cell(t, 0, 4, "5D ADR", text_size=size.small, text_formatting=text.format_bold)
    table.cell(t, 1, 4, "$" + fmt(adr5), text_size=size.small, text_formatting=text.format_bold)
    table.cell(t, 2, 4, statusText(break5), bgcolor=statusColor(break5), text_color=color.white, text_size=size.small, text_formatting=text.format_bold)

    table.cell(t, 0, 5, "3D INPUTS", bgcolor=color.rgb(55, 55, 55), text_color=color.white, text_size=size.small, text_formatting=text.format_bold)
    table.cell(t, 1, 5, "$" + fmt(range2) + " + $" + fmt(range3) + " + $" + fmt(range4), bgcolor=color.rgb(55, 55, 55), text_color=color.white, text_size=size.small, text_formatting=text.format_bold)
    table.cell(t, 2, 5, "", bgcolor=color.rgb(55, 55, 55))

    table.cell(t, 0, 6, "5D INPUTS", bgcolor=color.rgb(55, 55, 55), text_color=color.white, text_size=size.small, text_formatting=text.format_bold)
    table.cell(t, 1, 6, "$" + fmt(range2) + " + $" + fmt(range3) + " + $" + fmt(range4) + " + $" + fmt(range5) + " + $" + fmt(range6), bgcolor=color.rgb(55, 55, 55), text_color=color.white, text_size=size.small, text_formatting=text.format_bold)
    table.cell(t, 2, 6, "", bgcolor=color.rgb(55, 55, 55))

plot(todayRange, "Today Range", display=display.data_window)
plot(yesterdayRange, "Yesterday Range", display=display.data_window)
plot(adr3, "3D ADR", display=display.data_window)
plot(adr5, "5D ADR", display=display.data_window)
