             10,
             "30m",
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             1,
             10,
             trendText(bull30m, bear30m),
             bgcolor = trendColor(bull30m, bear30m),
             text_color = color.white,
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             0,
             11,
             "1H",
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             1,
             11,
             trendText(bull1h, bear1h),
