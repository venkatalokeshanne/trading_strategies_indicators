    lblStyle = labelMode == "Texte seul" ? label.style_none : label.style_label_left

    yPos1 = ma1 * (1 + y1 / 100)
    yPos2 = ma2 * (1 + y2 / 100)
    yPos3 = ma3 * (1 + y3 / 100)
    yPos4 = ma4 * (1 + y4 / 100)
    yPos5 = ma5 * (1 + y5 / 100)
    yPos6 = ma6 * (1 + y6 / 100)

    if show1
