        string aVWAPText = "BELOW"

        if aPrice > aVWAP
            aVWAPText := "ABOVE"


        table.cell(dash, 0, 15, "Axis Bank", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

