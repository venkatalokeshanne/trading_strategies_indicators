//@version=6
indicator(title = '多周期EMA', overlay = true, shorttitle = 'Multi-EMA', precision = 2)

// 定义所有EMA周期（5、10、20、30、60、90、180）
ema5 = ta.ema(close, 5)
ema10 = ta.ema(close, 10)
ema20 = ta.ema(close, 20)
ema30 = ta.ema(close, 30)
ema60 = ta.ema(close, 60)
ema90 = ta.ema(close, 90)
ema180 = ta.ema(close, 180)

// 绘制所有EMA，使用不同颜色区分，添加线宽和标签
plot(ema5, color = color.new(color.red, 0), title = 'EMA 5', linewidth = 1)
plot(ema10, color = color.new(color.orange, 0), title = 'EMA 10', linewidth = 1)
plot(ema20, color = color.new(color.aqua, 0), title = 'EMA 20', linewidth = 1)
plot(ema30, color = color.new(color.blue, 0), title = 'EMA 30', linewidth = 1)
plot(ema60, color = color.new(color.purple, 0), title = 'EMA 60', linewidth = 1)
plot(ema90, color = color.new(color.fuchsia, 0), title = 'EMA 90', linewidth = 1)
plot(ema180, color = color.new(color.teal, 0), title = 'EMA 180', linewidth = 1)

// 可选：添加图例说明（默认图表会自动生成图例，此部分可根据需要保留或删除）
// legend("EMA 5 (红), EMA 10 (橙), EMA 20 (青), EMA 30 (蓝), EMA 60 (紫), EMA 90 (品红), EMA 180 (深青)")
