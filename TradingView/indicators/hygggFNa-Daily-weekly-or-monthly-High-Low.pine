//@version=6
//@version=6
//@version=6
indicator(title="Higher Timeframe High/Low (Current Repainting)", shorttitle="HTF HL (Current)", overlay=true)

// Inputs
show_chart = input.bool(true, title="Show On Chart")
timeframe_option = input.string("Daily", title="Timeframe", options=["Daily", "Weekly", "Monthly"])

// Determine the resolution string based on user selection
tf = switch timeframe_option
    "Daily"   => "D"
    "Weekly"  => "W"
    "Monthly" => "M"
    => "D"

// Fetch high and low for the CURRENT period using request.security() with lookahead ON
// This allows the values to update (repaint) historically for the active period as new highs/lows form.
htf_high = request.security(syminfo.tickerid, tf, high, barmerge.gaps_off, barmerge.lookahead_on)
htf_low  = request.security(syminfo.tickerid, tf, low, barmerge.gaps_off, barmerge.lookahead_on)

// Plots
plot(show_chart ? htf_high : na, title="HTF Current High", style=plot.style_linebr, linewidth=1, color=color.rgb(140, 156, 141))
plot(show_chart ? htf_low  : na, title="HTF Current Low",  style=plot.style_linebr, linewidth=1, color=color.rgb(206, 183, 183))
