//@version=6
indicator("HTF Accumulation / Distribution Overlay", overlay=true, max_boxes_count=300, max_lines_count=500)

//─────────────────────────────────────────────
// GENERAL SETTINGS
//─────────────────────────────────────────────
groupGeneral = "General Settings"

showOverlay = input.bool(
     true,
     "Enable HTF Overlay",
     group=groupGeneral)

//─────────────────────────────────────────────
// 1H SETTINGS
//─────────────────────────────────────────────
group1H = "1H Candles"

show1H = input.bool(
     true,
     "Show 1H",
     group=group1H)

history1H = input.int(
     75,
     "1H Candles to Display",
     minval=10,
     maxval=100,
     group=group1H)

bodyTransparency1H = input.int(
     80,
     "Body Transparency",
     minval=0,
     maxval=100,
     group=group1H)

wickTransparency1H = input.int(
     35,
     "Wick Transparency",
     minval=0,
     maxval=100,
     group=group1H)

borderTransparency1H = input.int(
     55,
     "Border Transparency",
     minval=0,
     maxval=100,
     group=group1H)

wickWidth1H = input.int(
     10,
     "Wick Width",
     minval=1,
     maxval=10,
     group=group1H)

accumulation1H = input.color(
     color.white,
     "Accumulation / Bullish",
     group=group1H)

distribution1H = input.color(
     color.blue,
     "Distribution / Bearish",
     group=group1H)

//─────────────────────────────────────────────
// 4H SETTINGS
//─────────────────────────────────────────────
group4H = "4H Candles"

show4H = input.bool(
     false,
     "Show 4H",
     group=group4H)

history4H = input.int(
     40,
     "4H Candles to Display",
     minval=10,
     maxval=75,
     group=group4H)

bodyTransparency4H = input.int(
     85,
     "Body Transparency",
     minval=0,
     maxval=100,
     group=group4H)

wickTransparency4H = input.int(
     40,
     "Wick Transparency",
     minval=0,
     maxval=100,
     group=group4H)

borderTransparency4H = input.int(
     60,
     "Border Transparency",
     minval=0,
     maxval=100,
     group=group4H)

wickWidth4H = input.int(
     10,
     "Wick Width",
     minval=1,
     maxval=10,
     group=group4H)

accumulation4H = input.color(
     color.white,
     "Accumulation / Bullish",
     group=group4H)

distribution4H = input.color(
     color.blue,
     "Distribution / Bearish",
     group=group4H)

//─────────────────────────────────────────────
// DAILY SETTINGS
//─────────────────────────────────────────────
groupDaily = "Daily Candles"

showDaily = input.bool(
     false,
     "Show Daily",
     group=groupDaily)

historyDaily = input.int(
     25,
     "Daily Candles to Display",
     minval=10,
     maxval=50,
     group=groupDaily)

bodyTransparencyDaily = input.int(
     88,
     "Body Transparency",
     minval=0,
     maxval=100,
     group=groupDaily)

wickTransparencyDaily = input.int(
     45,
     "Wick Transparency",
     minval=0,
     maxval=100,
     group=groupDaily)

borderTransparencyDaily = input.int(
     65,
     "Border Transparency",
     minval=0,
     maxval=100,
     group=groupDaily)

wickWidthDaily = input.int(
     10,
     "Wick Width",
     minval=1,
     maxval=10,
     group=groupDaily)

accumulationDaily = input.color(
     color.white,
     "Accumulation / Bullish",
     group=groupDaily)

distributionDaily = input.color(
     color.blue,
     "Distribution / Bearish",
     group=groupDaily)

//─────────────────────────────────────────────
// STORAGE — 1H
//─────────────────────────────────────────────
var box[] bodies1H = array.new_box()
var line[] upper1H = array.new_line()
var line[] lower1H = array.new_line()

//─────────────────────────────────────────────
// STORAGE — 4H
//─────────────────────────────────────────────
var box[] bodies4H = array.new_box()
var line[] upper4H = array.new_line()
var line[] lower4H = array.new_line()

//─────────────────────────────────────────────
// STORAGE — DAILY
//─────────────────────────────────────────────
var box[] bodiesDaily = array.new_box()
var line[] upperDaily = array.new_line()
var line[] lowerDaily = array.new_line()

//─────────────────────────────────────────────
// FUNCTION — DRAW / UPDATE HTF CANDLE
//─────────────────────────────────────────────
f_updateCandle(
     string timeframe,
     bool enabled,
     int history,
     color bullColour,
     color bearColour,
     int bodyTrans,
     int wickTrans,
     int borderTrans,
     int wickWidth,
     box[] bodies,
     line[] uppers,
     line[] lowers) =>

    [t, tClose, o, hi, lo, c] = request.security(
         syminfo.tickerid,
         timeframe,
         [time, time_close, open, high, low, close],
         gaps=barmerge.gaps_off,
         lookahead=barmerge.lookahead_off)

    newCandle = ta.change(t) != 0

    //─────────────────────────────────────────
    // CREATE NEW CANDLE
    //─────────────────────────────────────────
    if enabled and newCandle

        candleColour = c >= o ? bullColour : bearColour

        bodyColour = color.new(
             candleColour,
             bodyTrans)

        wickColour = color.new(
             candleColour,
             wickTrans)

        borderColour = color.new(
             candleColour,
             borderTrans)

        bodyTop = math.max(o, c)
        bodyBottom = math.min(o, c)

        centre = t + (tClose - t) / 2

        // Upper wick: HIGH → BODY
        upper = line.new(
             centre,
             hi,
             centre,
             bodyTop,
             xloc=xloc.bar_time,
             color=wickColour,
             width=wickWidth)

        // Lower wick: BODY → LOW
        lower = line.new(
             centre,
             bodyBottom,
             centre,
             lo,
             xloc=xloc.bar_time,
             color=wickColour,
             width=wickWidth)

        // Body: OPEN → CLOSE
        body = box.new(
             t,
             bodyTop,
             tClose,
             bodyBottom,
             xloc=xloc.bar_time,
             bgcolor=bodyColour,
             border_color=borderColour,
             border_width=1)

        array.push(bodies, body)
        array.push(uppers, upper)
        array.push(lowers, lower)

        // Remove oldest candle
        if array.size(bodies) > history

            oldBody = array.shift(bodies)
            oldUpper = array.shift(uppers)
            oldLower = array.shift(lowers)

            box.delete(oldBody)
            line.delete(oldUpper)
            line.delete(oldLower)

    //─────────────────────────────────────────
    // UPDATE CURRENT CANDLE
    //─────────────────────────────────────────
    if enabled and array.size(bodies) > 0

        index = array.size(bodies) - 1

        body = array.get(
             bodies,
             index)

        upper = array.get(
             uppers,
             index)

        lower = array.get(
             lowers,
             index)

        candleColour = c >= o ? bullColour : bearColour

        bodyColour = color.new(
             candleColour,
             bodyTrans)

        wickColour = color.new(
             candleColour,
             wickTrans)

        borderColour = color.new(
             candleColour,
             borderTrans)

        bodyTop = math.max(o, c)
        bodyBottom = math.min(o, c)

        centre = t + (tClose - t) / 2

        //─────────────────────────────────────
        // UPDATE BODY
        //─────────────────────────────────────
        box.set_left(
             body,
             t)

        box.set_right(
             body,
             tClose)

        box.set_top(
             body,
             bodyTop)

        box.set_bottom(
             body,
             bodyBottom)

        box.set_bgcolor(
             body,
             bodyColour)

        box.set_border_color(
             body,
             borderColour)

        //─────────────────────────────────────
        // UPDATE UPPER WICK
        // HIGH → BODY
        //─────────────────────────────────────
        line.set_x1(
             upper,
             centre)

        line.set_x2(
             upper,
             centre)

        line.set_y1(
             upper,
             hi)

        line.set_y2(
             upper,
             bodyTop)

        line.set_color(
             upper,
             wickColour)

        line.set_width(
             upper,
             wickWidth)

        //─────────────────────────────────────
        // UPDATE LOWER WICK
        // BODY → LOW
        //─────────────────────────────────────
        line.set_x1(
             lower,
             centre)

        line.set_x2(
             lower,
             centre)

        line.set_y1(
             lower,
             bodyBottom)

        line.set_y2(
             lower,
             lo)

        line.set_color(
             lower,
             wickColour)

        line.set_width(
             lower,
             wickWidth)

//─────────────────────────────────────────────
// 1H
//─────────────────────────────────────────────
if showOverlay

    f_updateCandle(
         "60",
         show1H,
         history1H,
         accumulation1H,
         distribution1H,
         bodyTransparency1H,
         wickTransparency1H,
         borderTransparency1H,
         wickWidth1H,
         bodies1H,
         upper1H,
         lower1H)

//─────────────────────────────────────────────
// 4H
//─────────────────────────────────────────────
if showOverlay

    f_updateCandle(
         "240",
         show4H,
         history4H,
         accumulation4H,
         distribution4H,
         bodyTransparency4H,
         wickTransparency4H,
         borderTransparency4H,
         wickWidth4H,
         bodies4H,
         upper4H,
         lower4H)

//─────────────────────────────────────────────
// DAILY
//─────────────────────────────────────────────
if showOverlay

    f_updateCandle(
         "D",
         showDaily,
         historyDaily,
         accumulationDaily,
         distributionDaily,
         bodyTransparencyDaily,
         wickTransparencyDaily,
         borderTransparencyDaily,
         wickWidthDaily,
         bodiesDaily,
         upperDaily,
         lowerDaily)