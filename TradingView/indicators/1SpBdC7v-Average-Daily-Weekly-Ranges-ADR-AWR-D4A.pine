// © dub4art

//@version=6
indicator('ADR & AWR Ranges','ADWRT', overlay = true, max_lines_count = 500, max_labels_count = 500)

var gADRP = "ADR & AWR - Daily & Weekly Ranges Widget & Lines"
time_interval = input.string('5', "Lookback Range (Days & Weeks)", inline = '11', options = ['5','10','20'], group = gADRP, tooltip = "How many previous days (Daily ADR) and weeks (Weekly ADR) should be used for calculation")
coll = input.color(color.new(color.silver, 0), '  Low', inline = 'lvl1', group = gADRP) // low 
cola = input.color(color.rgb(38, 166, 154,0), 'Average', inline = 'lvl1', group = gADRP) // average teal
colh = input.color(color.new(color.orange, 0), 'High', inline = 'lvl1', group = gADRP) // high orange
colvh = input.color(color.new(color.red, 0), 'Very High', inline = 'lvl1', group = gADRP) // very high red
bg_transparency = input.int(85, maxval = 100, minval = 0, title = '  BG Transparency', group = gADRP)
use_colors = input.bool(false, '', inline = 'lvl2', group = gADRP)
main_c = input.color(color.new(#9076c9,0), "Don't Color Grade, Use One Color", inline = 'lvl2', group = gADRP)
daily_gain = input.bool(true, "Show Today's Price %", inline = 'lvl3', group = gADRP)
weekly_gain = input.bool(true, "Show Week's Price %", inline = 'lvl3b', group = gADRP)
gain_c = input.color(color.new(color.green, 0), '  Up', inline = 'lvl4', group = gADRP)
loss_c = input.color(color.new(color.red, 0), 'Down', inline = 'lvl4', group = gADRP)
even_c = input.color(color.new(color.silver, 0), 'Even', inline = 'lvl4', group = gADRP)
yPos = input.string('bottom', 'Widget location', inline = '12', options = ['top', 'middle', 'bottom'], group = gADRP)
xPos = input.string('center', '', inline = '12', options = ['left', 'center', 'right'], group = gADRP)

show_adr_lines = input.bool(true, "Show Current Average Day Range Marker Lines (ADR)", group = gADRP)
show_adr_history = input.bool(false, "  Show Historical Daily Lines (true day extent)", group = gADRP)
adr_line_color = input.color(color.new(color.yellow, 0), "  High/Low", inline = 'adrl', group = gADRP)
adr_style = input.string(defval = line.style_solid, options = [line.style_dashed, line.style_dotted, line.style_solid], inline = 'adrl', title = '', group=gADRP)
adr_line_width = input.int(1, "", minval = 1, maxval = 4, inline = 'adrl', group = gADRP)

adr13_line_color = input.color(color.new(color.yellow, 0), "  1/3 High/Low", inline = 'adr2', group = gADRP)
adr_style2 = input.string(defval = line.style_dashed, options = [line.style_dashed, line.style_dotted, line.style_solid], inline = 'adr2', title = '', group=gADRP)
adr_line_width2 = input.int(1, "", minval = 1, maxval = 4, inline = 'adr2', group = gADRP)
offset_d_left = input.int(10, "  Offset Left", minval = 0, inline = 'adr3', group = gADRP)
offset_d_right = input.int(8, "  Offset Right", minval = 0, inline = 'adr3', group = gADRP)

show_wadr_lines = input.bool(true, "Show Current Average Week Range Marker Lines (AWR)", group = gADRP)
show_wadr_history = input.bool(false, "  Show Historical Weekly Lines (true week extent)", group = gADRP)
adr_wline_color = input.color(color.new(color.green, 0), "  High/Low", inline = 'wadrl', group = gADRP)
adr_wstyle = input.string(defval = line.style_solid, options = [line.style_dashed, line.style_dotted, line.style_solid], inline = 'wadrl', title = '', group=gADRP)
adr_wline_width = input.int(2, "", minval = 1, maxval = 4, inline = 'wadrl', group = gADRP)

adr13_wline_color = input.color(color.new(color.green, 0), "  1/3 High/Low", inline = 'wadr2', group = gADRP)
adr_wstyle2 = input.string(defval = line.style_dashed, options = [line.style_dashed, line.style_dotted, line.style_solid], inline = 'wadr2', title = '', group=gADRP)
adr_wline_width2 = input.int(2, "", minval = 1, maxval = 4, inline = 'wadr2', group = gADRP)
offset_w_left = input.int(20, "  Offset Left", minval = 0, inline = 'wadr3', group = gADRP)
offset_w_right = input.int(8, "  Offset Right", minval = 0, inline = 'wadr3', group = gADRP)

show_label = input.bool(true, "Labels  ", inline = 'lbl1', group = gADRP)
labelSize = input.int(13, title = 'Size', inline = 'lbl1', group = gADRP)
offset_l_right = input.int(14, "  Offset", minval = 0, inline = 'lbl1', group = gADRP)

frx = syminfo.type == "forex" ? 1 / (syminfo.mintick * 10) : 1
dr = high - low // day or weekly range

[_r1,_r2,_r3,_r4,_r5,_r6,_r7,_r8,_r9,_r10,_r11,_r12,_r13,_r14,_r15,_r16,_r17,_r18,_r19,_r20] = request.security(syminfo.tickerid, 'D', [dr[1],dr[2],dr[3],dr[4],dr[5],dr[6],dr[7],dr[8],dr[9],dr[10],dr[11],dr[12],dr[13],dr[14],dr[15],dr[16],dr[17],dr[18],dr[19],dr[20]])
[_w1,_w2,_w3,_w4,_w5,_w6,_w7,_w8,_w9,_w10,_w11,_w12,_w13,_w14,_w15,_w16,_w17,_w18,_w19,_w20] = request.security(syminfo.tickerid, 'W', [dr[1],dr[2],dr[3],dr[4],dr[5],dr[6],dr[7],dr[8],dr[9],dr[10],dr[11],dr[12],dr[13],dr[14],dr[15],dr[16],dr[17],dr[18],dr[19],dr[20]])
[_high, _low] = request.security(syminfo.tickerid, 'D', [high, low])
_open = request.security(syminfo.tickerid, 'D', open, lookahead = barmerge.lookahead_on)
_wopen = request.security(syminfo.tickerid, 'W', open, lookahead = barmerge.lookahead_on)
[_whigh, _wlow] = request.security(syminfo.tickerid, 'W', [high, low])

todayrange = (_high - _low) * frx
weekrange = (_whigh - _wlow) * frx
gain_loss = (close - _open) * 100 / _open
wgain_loss = (close - _wopen) * 100 / _wopen

adr_5 = (_r1 + _r2 + _r3 + _r4 + _r5) / 5
adr_10 = (_r1 + _r2 + _r3 + _r4 + _r5 + _r6 + _r7 + _r8 + _r9 + _r10) / 10
adr_20 = (_r1 + _r2 + _r3 + _r4 + _r5 + _r6 + _r7 + _r8 + _r9 + _r10 + _r11 + _r12 + _r13 + _r14 + _r15 + _r16 + _r17 + _r18 + _r19 + _r20) / 20

wadr_5 = (_w1 + _w2 + _w3 + _w4 + _w5) / 5
wadr_10 = (_w1 + _w2 + _w3 + _w4 + _w5 + _w6 + _w7 + _w8 + _w9 + _w10) / 10
wadr_20 = (_w1 + _w2 + _w3 + _w4 + _w5 + _w6 + _w7 + _w8 + _w9 + _w10 + _w11 + _w12 + _w13 + _w14 + _w15 + _w16 + _w17 + _w18 + _w19 + _w20) / 20

_adr = 0.0
_wadr = 0.0
day_adr_range = 0.0
week_adr_range = 0.0
if time_interval == '5'
    _adr := todayrange / adr_5 / frx * 100 // _open * 100
    _wadr := weekrange / wadr_5 / frx * 100
    day_adr_range := adr_5
    week_adr_range := wadr_5
else if time_interval == '10'
    _adr := todayrange / adr_10 / frx * 100 // ADR % - more meaningful number
    _wadr := weekrange / wadr_10 / frx * 100
    day_adr_range := adr_10
    week_adr_range := wadr_10
else if time_interval == '20'
    _adr := todayrange / adr_20 / frx * 100
    _wadr := weekrange / wadr_20 / frx * 100
    day_adr_range := adr_20
    week_adr_range := wadr_20

// ADR Projection Lines - drawn for the current day, anchored off today's open
lookback_n = int(str.tonumber(time_interval))

var line adrTopLine = na
var line adrBotLine = na
var line adrTop13Line = na
var line adrBot13Line = na
var label adr_top_lbl = na
var label adr_bot_lbl = na
var label adr_top13_lbl = na
var label adr_bot13_lbl = na
var array<line> adrHistTop = array.new<line>()
var array<line> adrHistBot = array.new<line>()
var array<line> adrHistTop13 = array.new<line>()
var array<line> adrHistBot13 = array.new<line>()

var line wadrTopLine = na
var line wadrBotLine = na
var line wadrTop13Line = na
var line wadrBot13Line = na
var label wadr_top_lbl = na
var label wadr_bot_lbl = na
var label wadr_top13_lbl = na
var label wadr_bot13_lbl = na
var array<line> wadrHistTop = array.new<line>()
var array<line> wadrHistBot = array.new<line>()
var array<line> wadrHistTop13 = array.new<line>()
var array<line> wadrHistBot13 = array.new<line>()

newDay = ta.change(time("D")) != 0
newWeek = ta.change(time("W")) != 0

// --------------------- Day Lines----------------------------------
if newDay and not na(day_adr_range)
    if not na(adr_top_lbl)
        label.delete(adr_top_lbl)
        label.delete(adr_bot_lbl)
        label.delete(adr_top13_lbl)
        label.delete(adr_bot13_lbl)
    if not show_adr_history and not na(adrTopLine)
        line.delete(adrTopLine)
        line.delete(adrBotLine)
        line.delete(adrTop13Line)
        line.delete(adrBot13Line)
    if show_adr_lines
        adrTopLine := line.new(bar_index, _open + day_adr_range, bar_index, _open + day_adr_range, extend = extend.none, color = adr_line_color, width = adr_line_width, style = adr_style)
        adrBotLine := line.new(bar_index, _open - day_adr_range, bar_index, _open - day_adr_range, extend = extend.none, color = adr_line_color, width = adr_line_width, style = adr_style)
        adrTop13Line := line.new(bar_index, _open + day_adr_range / 3, bar_index, _open + day_adr_range / 3, extend = extend.none, color = adr13_line_color, width = adr_line_width2, style = adr_style2)
        adrBot13Line := line.new(bar_index, _open - day_adr_range / 3, bar_index, _open - day_adr_range / 3, extend = extend.none, color = adr13_line_color, width = adr_line_width2, style = adr_style2)
        if show_adr_history
            array.push(adrHistTop, adrTopLine)
            array.push(adrHistBot, adrBotLine)
            array.push(adrHistTop13, adrTop13Line)
            array.push(adrHistBot13, adrBot13Line)
            if array.size(adrHistTop) > lookback_n
                line.delete(array.shift(adrHistTop))
                line.delete(array.shift(adrHistBot))
                line.delete(array.shift(adrHistTop13))
                line.delete(array.shift(adrHistBot13))
        if show_label
            adr_top_lbl := label.new(bar_index, _open + day_adr_range, text = 'ADR+', xloc = xloc.bar_index, size = labelSize, textalign = text.align_left, textcolor = adr_line_color, color = na, style = label.style_label_left)
            adr_bot_lbl := label.new(bar_index, _open - day_adr_range, text = 'ADR-', xloc = xloc.bar_index, size = labelSize, textalign = text.align_left, textcolor = adr_line_color, color = na, style = label.style_label_left)
            adr_top13_lbl := label.new(bar_index, _open + day_adr_range / 3, text = '1/3 ADR+', xloc = xloc.bar_index, size = labelSize, textalign = text.align_left, textcolor = adr_line_color, color = na, style = label.style_label_left)
            adr_bot13_lbl := label.new(bar_index, _open - day_adr_range / 3, text = '1/3 ADR-', xloc = xloc.bar_index, size = labelSize, textalign = text.align_left, textcolor = adr_line_color, color = na, style = label.style_label_left)

if show_adr_lines and not newDay
    if show_adr_history
        line.set_x2(adrTopLine, bar_index)
        line.set_x2(adrBotLine, bar_index)
        line.set_x2(adrTop13Line, bar_index)
        line.set_x2(adrBot13Line, bar_index)
    else
        line.set_x1(adrTopLine, bar_index - offset_d_left)
        line.set_x1(adrBotLine, bar_index - offset_d_left)
        line.set_x1(adrTop13Line, bar_index - offset_d_left)
        line.set_x1(adrBot13Line, bar_index - offset_d_left)
        line.set_x2(adrTopLine, bar_index + offset_d_right)
        line.set_x2(adrBotLine, bar_index + offset_d_right)
        line.set_x2(adrTop13Line, bar_index + offset_d_right)
        line.set_x2(adrBot13Line, bar_index + offset_d_right)
    label.set_x(adr_top_lbl, bar_index + offset_l_right)
    label.set_x(adr_bot_lbl, bar_index + offset_l_right)
    label.set_x(adr_top13_lbl, bar_index + offset_l_right)
    label.set_x(adr_bot13_lbl, bar_index + offset_l_right)

if not show_adr_lines and not na(adrTopLine)
    line.delete(adrTopLine)
    line.delete(adrBotLine)
    line.delete(adrTop13Line)
    line.delete(adrBot13Line)
    label.delete(adr_top_lbl)
    label.delete(adr_bot_lbl)
    label.delete(adr_top13_lbl)
    label.delete(adr_bot13_lbl)

// --------------------- Week Lines----------------------------------
if newWeek and not na(week_adr_range)
    if not na(wadr_top_lbl)
        label.delete(wadr_top_lbl)
        label.delete(wadr_bot_lbl)
        label.delete(wadr_top13_lbl)
        label.delete(wadr_bot13_lbl)
    if not show_wadr_history and not na(wadrTopLine)
        line.delete(wadrTopLine)
        line.delete(wadrBotLine)
        line.delete(wadrTop13Line)
        line.delete(wadrBot13Line)
    if show_wadr_lines
        wadrTopLine := line.new(bar_index, _wopen + week_adr_range, bar_index, _wopen + week_adr_range, extend = extend.none, color = adr_wline_color, width = adr_wline_width, style = adr_wstyle)
        wadrBotLine := line.new(bar_index, _wopen - week_adr_range, bar_index, _wopen - week_adr_range, extend = extend.none, color = adr_wline_color, width = adr_wline_width, style = adr_wstyle)
        wadrTop13Line := line.new(bar_index, _wopen + week_adr_range / 3, bar_index, _wopen + week_adr_range / 3, extend = extend.none, color = adr13_wline_color, width = adr_wline_width2, style = adr_wstyle2)
        wadrBot13Line := line.new(bar_index, _wopen - week_adr_range / 3, bar_index, _wopen - week_adr_range / 3, extend = extend.none, color = adr13_wline_color, width = adr_wline_width2, style = adr_wstyle2)
        if show_wadr_history
            array.push(wadrHistTop, wadrTopLine)
            array.push(wadrHistBot, wadrBotLine)
            array.push(wadrHistTop13, wadrTop13Line)
            array.push(wadrHistBot13, wadrBot13Line)
            if array.size(wadrHistTop) > lookback_n
                line.delete(array.shift(wadrHistTop))
                line.delete(array.shift(wadrHistBot))
                line.delete(array.shift(wadrHistTop13))
                line.delete(array.shift(wadrHistBot13))
        if show_label
            wadr_top_lbl := label.new(bar_index, _wopen + week_adr_range, text = 'AWR+', xloc = xloc.bar_index, size = labelSize, textalign = text.align_left, textcolor = adr_wline_color, color = na, style = label.style_label_left)
            wadr_bot_lbl := label.new(bar_index, _wopen - week_adr_range, text = 'AWR-', xloc = xloc.bar_index, size = labelSize, textalign = text.align_left, textcolor = adr_wline_color, color = na, style = label.style_label_left)
            wadr_top13_lbl := label.new(bar_index, _wopen + week_adr_range / 3, text = '1/3 AWR+', xloc = xloc.bar_index, size = labelSize, textalign = text.align_left, textcolor = adr_wline_color, color = na, style = label.style_label_left)
            wadr_bot13_lbl := label.new(bar_index, _wopen - week_adr_range / 3, text = '1/3 AWR-', xloc = xloc.bar_index, size = labelSize, textalign = text.align_left, textcolor = adr_wline_color, color = na, style = label.style_label_left)

if show_wadr_lines and not newWeek
    if show_wadr_history
        line.set_x2(wadrTopLine, bar_index)
        line.set_x2(wadrBotLine, bar_index)
        line.set_x2(wadrTop13Line, bar_index)
        line.set_x2(wadrBot13Line, bar_index)
    else
        line.set_x1(wadrTopLine, bar_index - offset_w_left)
        line.set_x1(wadrBotLine, bar_index - offset_w_left)
        line.set_x1(wadrTop13Line, bar_index - offset_w_left)
        line.set_x1(wadrBot13Line, bar_index - offset_w_left)
        line.set_x2(wadrTopLine, bar_index + offset_w_right)
        line.set_x2(wadrBotLine, bar_index + offset_w_right)
        line.set_x2(wadrTop13Line, bar_index + offset_w_right)
        line.set_x2(wadrBot13Line, bar_index + offset_w_right)
    label.set_x(wadr_top_lbl, bar_index + offset_l_right)
    label.set_x(wadr_bot_lbl, bar_index + offset_l_right)
    label.set_x(wadr_top13_lbl, bar_index + offset_l_right)
    label.set_x(wadr_bot13_lbl, bar_index + offset_l_right)

if not show_wadr_lines and not na(wadrTopLine)
    line.delete(wadrTopLine)
    line.delete(wadrBotLine)
    line.delete(wadrTop13Line)
    line.delete(wadrBot13Line)
    label.delete(wadr_top_lbl)
    label.delete(wadr_bot_lbl)
    label.delete(wadr_top13_lbl)
    label.delete(wadr_bot13_lbl)

adr_color = _adr < 50.0 and _adr > 0.0 ? coll : 49.0 < _adr and _adr < 100.0 ? cola : 99 < _adr and _adr < 150 ? colh : _adr > 149 ? colvh : na
rng_fmt = "#.#####"
_adrText = 'ADR: ' + str.tostring(_adr, '#.#') + " %" + " : " + str.tostring(todayrange, rng_fmt) + " | " + "Week: " + str.tostring(_wadr, '#.#') + " %" + " : " + str.tostring(weekrange, rng_fmt)
_gain = str.tostring(gain_loss, "#.##") + "%"
_wgain = str.tostring(wgain_loss, "#.##") + "%"

if barstate.islast
    var table _table = table.new(yPos + '_' + xPos, 3, 1, border_width = 1)
    table.cell(_table, 0, 0, _adrText, bgcolor = not use_colors ? color.new(adr_color, bg_transparency) : color.new(main_c, bg_transparency), text_color = not use_colors ? adr_color : main_c, text_size = size.normal, tooltip = "Avg ADR" + str.tostring(time_interval) + ": " + str.tostring(day_adr_range * frx, rng_fmt) + " | " + "Avg AWR" + str.tostring(time_interval) + ": " + str.tostring(week_adr_range * frx, rng_fmt))
    if daily_gain
        table.cell(_table, 1, 0, _gain, bgcolor = gain_loss > 0 ? color.new(gain_c,80) : gain_loss < 0 ? color.new(loss_c,80) : color.new(even_c,80), text_color = gain_loss > 0 ? color.new(gain_c,0) : gain_loss < 0 ? color.new(loss_c,0) : color.new(even_c,0), text_size = size.normal)
    if weekly_gain
        table.cell(_table, 2, 0, _wgain, bgcolor = wgain_loss > 0 ? color.new(gain_c,80) : wgain_loss < 0 ? color.new(loss_c,80) : color.new(even_c,80), text_color = wgain_loss > 0 ? color.new(gain_c,0) : wgain_loss < 0 ? color.new(loss_c,0) : color.new(even_c,0), text_size = size.normal)