//@version=6
indicator("NIFTY Option Battle - CE vs PE", overlay=false, max_labels_count=500)

//====================================================
// 1. OPTION PREMIUM SYMBOLS
//====================================================

ceSymbol = input.symbol("NSE:NIFTY", "CALL / CE Premium", group="OPTION PREMIUM")
peSymbol = input.symbol("NSE:NIFTY", "PUT / PE Premium", group="OPTION PREMIUM")

//====================================================
// 2. SETTINGS
//====================================================

rsiLength = input.int(14, "RSI Length", minval=2, group="RSI SETTINGS")
rsiSmooth = input.int(3, "RSI Smoothing", minval=1, group="RSI SETTINGS")

battleThreshold = input.float(10.0, "Battle Threshold", minval=1.0, step=0.5, group="BATTLE SETTINGS")
strongThreshold = input.float(20.0, "Strong Battle Threshold", minval=5.0, step=0.5, group="BATTLE SETTINGS")

pivotLeft = input.int(3, "Pivot Left", minval=1, group="DIVERGENCE")
pivotRight = input.int(3, "Pivot Right", minval=1, group="DIVERGENCE")

showSignals = input.bool(true, "Show CALL / PUT Signals", group="DISPLAY")
showDivergence = input.bool(true, "Show Divergence", group="DISPLAY")
showBackground = input.bool(true, "Show Battle Background", group="DISPLAY")
showDashboard = input.bool(true, "Show Dashboard", group="DISPLAY")

//====================================================
// 3. GET CALL PREMIUM DATA
//====================================================

ceOpen = request.security(ceSymbol, timeframe.period, open)
ceHigh = request.security(ceSymbol, timeframe.period, high)
ceLow = request.security(ceSymbol, timeframe.period, low)
ceClose = request.security(ceSymbol, timeframe.period, close)
ceVolume = request.security(ceSymbol, timeframe.period, volume)

//====================================================
// 4. GET PUT PREMIUM DATA
//====================================================

peOpen = request.security(peSymbol, timeframe.period, open)
peHigh = request.security(peSymbol, timeframe.period, high)
peLow = request.security(peSymbol, timeframe.period, low)
peClose = request.security(peSymbol, timeframe.period, close)
peVolume = request.security(peSymbol, timeframe.period, volume)

//====================================================
// 5. RSI
//====================================================

ceRSI_raw = ta.rsi(ceClose, rsiLength)
peRSI_raw = ta.rsi(peClose, rsiLength)

ceRSI = ta.sma(ceRSI_raw, rsiSmooth)
peRSI = ta.sma(peRSI_raw, rsiSmooth)

//====================================================
// 6. RSI BATTLE
//====================================================

battleDifference = ceRSI - peRSI

battleScore = battleDifference * 2.0

if battleScore > 100
    battleScore := 100

if battleScore < -100
    battleScore := -100

//====================================================
// 7. CALL / PUT DOMINANCE
//====================================================

callDominance = battleDifference > battleThreshold
putDominance = battleDifference < -battleThreshold

strongCall = battleDifference > strongThreshold
strongPut = battleDifference < -strongThreshold

//====================================================
// 8. PREMIUM MOMENTUM
//====================================================

ceMomentum = ceClose - ceClose[1]
peMomentum = peClose - peClose[1]

ceMomentumPercent = 0.0
peMomentumPercent = 0.0

if ceClose[1] != 0
    ceMomentumPercent := (ceClose - ceClose[1]) / ceClose[1] * 100

if peClose[1] != 0
    peMomentumPercent := (peClose - peClose[1]) / peClose[1] * 100

//====================================================
// 9. MOMENTUM BATTLE
//====================================================

callMomentumStrong = ceMomentum > 0 and peMomentum < 0
putMomentumStrong = peMomentum > 0 and ceMomentum < 0

//====================================================
// 10. CALL RSI DIVERGENCE
//====================================================

cePriceLow = ta.pivotlow(ceClose, pivotLeft, pivotRight)
cePriceHigh = ta.pivothigh(ceClose, pivotLeft, pivotRight)

ceRSILow = ta.pivotlow(ceRSI, pivotLeft, pivotRight)
ceRSIHigh = ta.pivothigh(ceRSI, pivotLeft, pivotRight)

var float previousCEPriceLow = na
var float previousCERSILow = na

var float previousCEPriceHigh = na
var float previousCERSIHigh = na

ceBullishDivergence = false
ceBearishDivergence = false

if not na(cePriceLow) and not na(ceRSILow)

    if not na(previousCEPriceLow) and not na(previousCERSILow)

        if cePriceLow < previousCEPriceLow and ceRSILow > previousCERSILow
            ceBullishDivergence := true

    previousCEPriceLow := cePriceLow
    previousCERSILow := ceRSILow

if not na(cePriceHigh) and not na(ceRSIHigh)

    if not na(previousCEPriceHigh) and not na(previousCERSIHigh)

        if cePriceHigh > previousCEPriceHigh and ceRSIHigh < previousCERSIHigh
            ceBearishDivergence := true

    previousCEPriceHigh := cePriceHigh
    previousCERSIHigh := ceRSIHigh

//====================================================
// 11. PUT RSI DIVERGENCE
//====================================================

pePriceLow = ta.pivotlow(peClose, pivotLeft, pivotRight)
pePriceHigh = ta.pivothigh(peClose, pivotLeft, pivotRight)

peRSILow = ta.pivotlow(peRSI, pivotLeft, pivotRight)
peRSIHigh = ta.pivothigh(peRSI, pivotLeft, pivotRight)

var float previousPEPriceLow = na
var float previousPERSILow = na

var float previousPEPriceHigh = na
var float previousPERSIHigh = na

peBullishDivergence = false
peBearishDivergence = false

if not na(pePriceLow) and not na(peRSILow)

    if not na(previousPEPriceLow) and not na(previousPERSILow)

        if pePriceLow < previousPEPriceLow and peRSILow > previousPERSILow
            peBullishDivergence := true

    previousPEPriceLow := pePriceLow
    previousPERSILow := peRSILow

if not na(pePriceHigh) and not na(peRSIHigh)

    if not na(previousPEPriceHigh) and not na(previousPERSIHigh)

        if pePriceHigh > previousPEPriceHigh and peRSIHigh < previousPERSIHigh
            peBearishDivergence := true

    previousPEPriceHigh := pePriceHigh
    previousPERSIHigh := peRSIHigh

//====================================================
// 12. OPTION BATTLE SIGNAL
//====================================================

// Basic CALL battle
callBattle = callDominance and callMomentumStrong

// Basic PUT battle
putBattle = putDominance and putMomentumStrong

// CALL divergence confirmation
callDivergenceBattle = ceBullishDivergence and putDominance

// PUT divergence confirmation
putDivergenceBattle = peBullishDivergence and callDominance

// Final signals
callSignal = callBattle or callDivergenceBattle
putSignal = putBattle or putDivergenceBattle

//====================================================
// 13. RSI PLOTS
//====================================================

plot(
     ceRSI,
     title="CALL RSI",
     color=color.green,
     linewidth=2
)

plot(
     peRSI,
     title="PUT RSI",
     color=color.red,
     linewidth=2
)

//====================================================
// 14. BATTLE DIFFERENCE
//====================================================

plot(
     battleDifference,
     title="CALL - PUT RSI",
     color=battleDifference >= 0 ? color.lime : color.red,
     linewidth=3
)

//====================================================
// 15. REFERENCE LEVELS
//====================================================

hline(
     70,
     title="RSI 70",
     color=color.gray
)

hline(
     50,
     title="RSI 50",
     color=color.gray
)

hline(
     30,
     title="RSI 30",
     color=color.gray
)

hline(
     0,
     title="Battle Zero",
     color=color.white
)

hline(
     battleThreshold,
     title="CALL Battle Level",
     color=color.new(color.green, 50)
)

hline(
     -battleThreshold,
     title="PUT Battle Level",
     color=color.new(color.red, 50)
)

//====================================================
// 16. BACKGROUND
//====================================================

color battleBackground = na

if showBackground

    if strongCall
        battleBackground := color.new(color.green, 85)

    else if strongPut
        battleBackground := color.new(color.red, 85)

    else if callDominance
        battleBackground := color.new(color.green, 93)

    else if putDominance
        battleBackground := color.new(color.red, 93)

    else
        battleBackground := na

bgcolor(battleBackground)

//====================================================
// 17. CALL SIGNAL
//====================================================

plotshape(
     showSignals and callSignal,
     title="BUY CALL",
     style=shape.labelup,
     location=location.bottom,
     color=color.green,
     text="BUY CALL",
     textcolor=color.white,
     size=size.small
)

//====================================================
// 18. PUT SIGNAL
//====================================================

plotshape(
     showSignals and putSignal,
     title="BUY PUT",
     style=shape.labeldown,
     location=location.top,
     color=color.red,
     text="BUY PUT",
     textcolor=color.white,
     size=size.small
)

//====================================================
// 19. CE DIVERGENCE
//====================================================

plotshape(
     showDivergence and ceBullishDivergence,
     title="CE Bullish Divergence",
     style=shape.triangleup,
     location=location.bottom,
     color=color.lime,
     text="CE DIV",
     textcolor=color.white,
     size=size.tiny
)

plotshape(
     showDivergence and ceBearishDivergence,
     title="CE Bearish Divergence",
     style=shape.triangledown,
     location=location.top,
     color=color.orange,
     text="CE DIV",
     textcolor=color.white,
     size=size.tiny
)

//====================================================
// 20. PE DIVERGENCE
//====================================================

plotshape(
     showDivergence and peBullishDivergence,
     title="PE Bullish Divergence",
     style=shape.triangleup,
     location=location.bottom,
     color=color.aqua,
     text="PE DIV",
     textcolor=color.white,
     size=size.tiny
)

plotshape(
     showDivergence and peBearishDivergence,
     title="PE Bearish Divergence",
     style=shape.triangledown,
     location=location.top,
     color=color.orange,
     text="PE DIV",
     textcolor=color.white,
     size=size.tiny
)

//====================================================
// 21. DASHBOARD
//====================================================

var table dashboard = table.new(
     position.top_right,
     2,
     10,
     border_width=1
)

if barstate.islast and showDashboard

    table.cell(
         dashboard,
         0,
         0,
         "NIFTY OPTION BATTLE",
         bgcolor=color.black,
         text_color=color.white
    )

    table.cell(
         dashboard,
         1,
         0,
         "LIVE",
         bgcolor=color.black,
         text_color=color.yellow
    )

    table.cell(
         dashboard,
         0,
         1,
         "CE PREMIUM",
         text_color=color.white
    )

    table.cell(
         dashboard,
         1,
         1,
         str.tostring(ceClose, "#.##"),
         text_color=color.green
    )

    table.cell(
         dashboard,
         0,
         2,
         "PE PREMIUM",
         text_color=color.white
    )

    table.cell(
         dashboard,
         1,
         2,
         str.tostring(peClose, "#.##"),
         text_color=color.red
    )

    table.cell(
         dashboard,
         0,
         3,
         "CE RSI",
         text_color=color.white
    )

    table.cell(
         dashboard,
         1,
         3,
         str.tostring(ceRSI, "#.##"),
         text_color=color.green
    )

    table.cell(
         dashboard,
         0,
         4,
         "PE RSI",
         text_color=color.white
    )

    table.cell(
         dashboard,
         1,
         4,
         str.tostring(peRSI, "#.##"),
         text_color=color.red
    )

    table.cell(
         dashboard,
         0,
         5,
         "BATTLE SCORE",
         text_color=color.white
    )

    table.cell(
         dashboard,
         1,
         5,
         str.tostring(battleScore, "#.##"),
         text_color=battleScore >= 0 ? color.green : color.red
    )

    table.cell(
         dashboard,
         0,
         6,
         "CE MOMENTUM",
         text_color=color.white
    )

    table.cell(
         dashboard,
         1,
         6,
         str.tostring(ceMomentumPercent, "#.##") + "%",
         text_color=ceMomentumPercent >= 0 ? color.green : color.red
    )

    table.cell(
         dashboard,
         0,
         7,
         "PE MOMENTUM",
         text_color=color.white
    )

    table.cell(
         dashboard,
         1,
         7,
         str.tostring(peMomentumPercent, "#.##") + "%",
         text_color=peMomentumPercent >= 0 ? color.green : color.red
    )

    string battleStatus = "NEUTRAL"
    color statusColor = color.gray

    if strongCall
        battleStatus := "STRONG CALL"
        statusColor := color.green

    else if strongPut
        battleStatus := "STRONG PUT"
        statusColor := color.red

    else if callDominance
        battleStatus := "CALL DOMINANCE"
        statusColor := color.green

    else if putDominance
        battleStatus := "PUT DOMINANCE"
        statusColor := color.red

    table.cell(
         dashboard,
         0,
         8,
         "STATUS",
         text_color=color.white
    )

    table.cell(
         dashboard,
         1,
         8,
         battleStatus,
         bgcolor=statusColor,
         text_color=color.white
    )

    string finalSignal = "WAIT"
    color signalColor = color.gray

    if callSignal
        finalSignal := "BUY CALL"
        signalColor := color.green

    else if putSignal
        finalSignal := "BUY PUT"
        signalColor := color.red

    table.cell(
         dashboard,
         0,
         9,
         "SIGNAL",
         text_color=color.white
    )

    table.cell(
         dashboard,
         1,
         9,
         finalSignal,
         bgcolor=signalColor,
         text_color=color.white
    )

//====================================================
// 22. ALERTS
//====================================================

alertcondition(
     callSignal,
     title="NIFTY BUY CALL",
     message="NIFTY Option Battle: BUY CALL signal detected."
)

alertcondition(
     putSignal,
     title="NIFTY BUY PUT",
     message="NIFTY Option Battle: BUY PUT signal detected."
)

alertcondition(
     strongCall,
     title="Strong CALL Dominance",
     message="NIFTY Option Battle: Strong CALL dominance detected."
)

alertcondition(
     strongPut,
     title="Strong PUT Dominance",
     message="NIFTY Option Battle: Strong PUT dominance detected."
)

alertcondition(
     ceBullishDivergence,
     title="CALL Bullish Divergence",
     message="NIFTY Option Battle: CALL premium bullish RSI divergence detected."
)

alertcondition(
     peBullishDivergence,
     title="PUT Bullish Divergence",
     message="NIFTY Option Battle: PUT premium bullish RSI divergence detected."
)//====================================================
