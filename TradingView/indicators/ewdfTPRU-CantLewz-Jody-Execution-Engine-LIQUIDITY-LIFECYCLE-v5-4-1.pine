//@version=6
indicator(
     "CantLewz Jody Execution Engine [LIQUIDITY LIFECYCLE v5.4.1]",
     overlay=true,
     max_boxes_count=50,
     max_labels_count=500,
     max_lines_count=500
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
htf = input.timeframe("60", "HTF Zone TF")

overnightCalcTF = input.timeframe(
     "5",
     "Overnight Calculation TF"
)

overnightSess = input.session(
     "1600-0929",
     "Postmarket + Premarket Session"
)

nySess = input.session(
     "0930-1600",
     "NY Session"
)

tz = input.string(
     "America/New_York",
     "Session Timezone"
)

usePrevDay = input.bool(
     true,
     "Show PDH / MID / PDL"
)

showPrevClose = input.bool(
     false,
     "Show Previous Close"
)

showOvernight = input.bool(
     true,
     "Show PMH / PML"
)

showLiquidityTag = input.bool(
     true,
     "Show Liquidity Names"
)

showLabels = input.bool(
     true,
     "Show Trinity Labels"
)

currentLiquidityWidth = input.int(
     5,
     "Current Blue Level Width",
     minval=2,
     maxval=8
)

yesterdayLiquidityWidth = input.int(
     4,
     "Yesterday Unmitigated Width",
     minval=2,
     maxval=7
)

olderLiquidityWidth = input.int(
     2,
     "Older Unmitigated Width",
     minval=1,
     maxval=5
)

overnightLiquidityWidth = input.int(
     3,
     "PMH / PML Width",
     minval=1,
     maxval=6
)

liquidityTransparency = input.int(
     5,
     "Liquidity Transparency",
     minval=0,
     maxval=90
)

maximumDailyLevels = input.int(
     90,
     "Maximum Stored Daily Levels",
     minval=6,
     maxval=200
)

atrLen = input.int(
     14,
     "ATR Length"
)

dispMult = input.float(
     1.2,
     "Displacement ATR Multiplier",
     step=0.1
)

maxTradesPerDay = input.int(
     2,
     "Max Alerts Per Day"
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DAILY DATA
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
atr = ta.atr(atrLen)

prevHigh = request.security(
     syminfo.tickerid,
     "D",
     high[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on
)

prevLow = request.security(
     syminfo.tickerid,
     "D",
     low[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on
)

prevClose = request.security(
     syminfo.tickerid,
     "D",
     close[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on
)

prevDayTime = request.security(
     syminfo.tickerid,
     "D",
     time[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on
)

dailyMid = (
     prevHigh +
     prevLow
) / 2.0

inNY = not na(
     time(
         timeframe.period,
         nySess,
         tz
     )
)

newDay = ta.change(
     time(
         "D",
         "0000-2359",
         tz
     )
) != 0

nyClose =
     not inNY and
     inNY[1]

isToday =
     year(time, tz) == year(timenow, tz) and
     month(time, tz) == month(timenow, tz) and
     dayofmonth(time, tz) == dayofmonth(timenow, tz)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// COLORS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
currentLevelColor = color.new(
     color.blue,
     liquidityTransparency
)

yesterdayHighLowColor = color.new(
     color.orange,
     liquidityTransparency
)

yesterdayMidColor = color.new(
     color.rgb(184, 134, 11),
     liquidityTransparency
)

olderLevelColor = color.new(
     color.yellow,
     20
)

overnightColor = color.new(
     color.purple,
     liquidityTransparency
)

pdcColor = color.new(
     color.aqua,
     20
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LOWER-TIMEFRAME OVERNIGHT ENGINE
//
// Calculates PMH/PML internally from 5-minute candles.
//
// Range:
// Previous day 4:00 PM ET through current day 9:29 AM ET.
//
// The finished line ends at 9:30 AM ET.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
f_overnightEngine() =>
    bool inRange = not na(
         time(
             timeframe.period,
             overnightSess,
             tz
         )
    )

    bool rangeStart =
         inRange and
         not inRange[1]

    bool rangeEnd =
         not inRange and
         inRange[1]

    var float buildingHigh = na
    var float buildingLow = na

    var int buildingStartTime = na

    var float completedHigh = na
    var float completedLow = na

    var int completedStartTime = na
    var int completedEndTime = na

    if rangeStart
        buildingHigh := high
        buildingLow := low
        buildingStartTime := time

    if inRange
        buildingHigh := na(buildingHigh) ?
             high :
             math.max(
                 buildingHigh,
                 high
             )

        buildingLow := na(buildingLow) ?
             low :
             math.min(
                 buildingLow,
                 low
             )

    if rangeEnd
        completedHigh := buildingHigh
        completedLow := buildingLow

        completedStartTime := buildingStartTime

        // First 5-minute bar outside the overnight session
        // begins at exactly 9:30 AM Eastern.
        completedEndTime := time

    float displayedHigh =
         inRange ?
         buildingHigh :
         completedHigh

    float displayedLow =
         inRange ?
         buildingLow :
         completedLow

    int displayedStart =
         inRange ?
         buildingStartTime :
         completedStartTime

    int displayedEnd =
         inRange ?
         time_close :
         completedEndTime

    [displayedHigh, displayedLow, displayedStart, displayedEnd, inRange]

[overnightHigh, overnightLow, overnightStartTime, overnightEndTime, overnightBuilding] = request.security(
     syminfo.tickerid,
     overnightCalcTF,
     f_overnightEngine(),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off
)

newOvernightRange =
     not na(overnightStartTime) and
     (
         na(overnightStartTime[1]) or
         overnightStartTime != overnightStartTime[1]
     )

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PMH / PML OBJECTS
//
// Uses time coordinates instead of chart-bar coordinates.
// Lines end at NY open and never extend beyond 9:30 AM.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var line pmhLine = na
var line pmlLine = na

var label pmhTag = na
var label pmlTag = na

if newOvernightRange
    if not na(pmhLine)
        line.delete(pmhLine)

    if not na(pmlLine)
        line.delete(pmlLine)

    if not na(pmhTag)
        label.delete(pmhTag)

    if not na(pmlTag)
        label.delete(pmlTag)

    pmhLine := na
    pmlLine := na

    pmhTag := na
    pmlTag := na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PMH
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if showOvernight and
     not na(overnightHigh) and
     not na(overnightStartTime) and
     not na(overnightEndTime)

    if na(pmhLine)
        pmhLine := line.new(
             x1=overnightStartTime,
             y1=overnightHigh,
             x2=overnightEndTime,
             y2=overnightHigh,
             xloc=xloc.bar_time,
             extend=extend.none,
             color=overnightColor,
             width=overnightLiquidityWidth,
             style=line.style_solid
        )
    else
        line.set_x1(
             pmhLine,
             overnightStartTime
        )

        line.set_y1(
             pmhLine,
             overnightHigh
        )

        line.set_x2(
             pmhLine,
             overnightEndTime
        )

        line.set_y2(
             pmhLine,
             overnightHigh
        )

        line.set_extend(
             pmhLine,
             extend.none
        )

        line.set_color(
             pmhLine,
             overnightColor
        )

        line.set_width(
             pmhLine,
             overnightLiquidityWidth
        )

    if showLiquidityTag
        if na(pmhTag)
            pmhTag := label.new(
                 x=overnightEndTime,
                 y=overnightHigh,
                 text="PMH",
                 xloc=xloc.bar_time,
                 style=label.style_label_left,
                 color=color.new(
                     color.purple,
                     45
                 ),
                 textcolor=color.white,
                 size=size.normal
            )
        else
            label.set_xy(
                 pmhTag,
                 overnightEndTime,
                 overnightHigh
            )

            label.set_text(
                 pmhTag,
                 "PMH"
            )

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PML
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if showOvernight and
     not na(overnightLow) and
     not na(overnightStartTime) and
     not na(overnightEndTime)

    if na(pmlLine)
        pmlLine := line.new(
             x1=overnightStartTime,
             y1=overnightLow,
             x2=overnightEndTime,
             y2=overnightLow,
             xloc=xloc.bar_time,
             extend=extend.none,
             color=overnightColor,
             width=overnightLiquidityWidth,
             style=line.style_solid
        )
    else
        line.set_x1(
             pmlLine,
             overnightStartTime
        )

        line.set_y1(
             pmlLine,
             overnightLow
        )

        line.set_x2(
             pmlLine,
             overnightEndTime
        )

        line.set_y2(
             pmlLine,
             overnightLow
        )

        line.set_extend(
             pmlLine,
             extend.none
        )

        line.set_color(
             pmlLine,
             overnightColor
        )

        line.set_width(
             pmlLine,
             overnightLiquidityWidth
        )

    if showLiquidityTag
        if na(pmlTag)
            pmlTag := label.new(
                 x=overnightEndTime,
                 y=overnightLow,
                 text="PML",
                 xloc=xloc.bar_time,
                 style=label.style_label_left,
                 color=color.new(
                     color.purple,
                     45
                 ),
                 textcolor=color.white,
                 size=size.normal
            )
        else
            label.set_xy(
                 pmlTag,
                 overnightEndTime,
                 overnightLow
            )

            label.set_text(
                 pmlTag,
                 "PML"
            )

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PREVIOUS CLOSE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var line pdcLine = na
var label pdcTag = na

if newDay
    if not na(pdcLine)
        line.delete(pdcLine)

    if not na(pdcTag)
        label.delete(pdcTag)

    pdcLine := na
    pdcTag := na

if showPrevClose and
     isToday and
     not na(prevClose)

    if na(pdcLine)
        pdcLine := line.new(
             x1=bar_index,
             y1=prevClose,
             x2=bar_index + 1,
             y2=prevClose,
             extend=extend.right,
             color=pdcColor,
             width=2,
             style=line.style_dotted
        )
    else
        line.set_y1(
             pdcLine,
             prevClose
        )

        line.set_y2(
             pdcLine,
             prevClose
        )

    if showLiquidityTag
        if na(pdcTag)
            pdcTag := label.new(
                 x=bar_index + 3,
                 y=prevClose,
                 text="PDC",
                 style=label.style_label_left,
                 color=color.new(
                     color.aqua,
                     45
                 ),
                 textcolor=color.black,
                 size=size.normal
            )
        else
            label.set_xy(
                 pdcTag,
                 bar_index + 3,
                 prevClose
            )

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DAILY LIQUIDITY ARRAYS
//
// TYPE:
// 1 = PDH
// 2 = MID
// 3 = PDL
//
// AGE:
// 0 = Current blue previous-day level
// 1 = Yesterday's carried unmitigated level
// 2+ = Older carried unmitigated level
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var array<float> levelPrices = array.new_float()
var array<int> levelTypes = array.new_int()
var array<int> levelCreatedBars = array.new_int()
var array<int> levelSourceTimes = array.new_int()
var array<int> levelAges = array.new_int()
var array<bool> levelWasTouched = array.new_bool()
var array<line> levelLines = array.new_line()
var array<label> levelLabels = array.new_label()

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LEVEL FUNCTIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
f_levelName(int levelType) =>
    levelType == 1 ?
         "PDH" :
     levelType == 2 ?
         "MID" :
         "PDL"

f_levelDate(int sourceTime) =>
    str.tostring(
         month(
             sourceTime,
             tz
         )
    ) +
     "/" +
     str.tostring(
         dayofmonth(
             sourceTime,
             tz
         )
     )

f_levelText(
     int levelType,
     int sourceTime,
     int levelAge
) =>
    levelAge == 0 ?
         "CURRENT " +
         f_levelName(levelType) :
         f_levelName(levelType) +
         " " +
         f_levelDate(sourceTime)

f_levelColor(
     int levelType,
     int levelAge
) =>
    levelAge == 0 ?
         currentLevelColor :
     levelAge == 1 ?
         (
             levelType == 2 ?
             yesterdayMidColor :
             yesterdayHighLowColor
         ) :
         olderLevelColor

f_levelWidth(int levelAge) =>
    levelAge == 0 ?
         currentLiquidityWidth :
     levelAge == 1 ?
         yesterdayLiquidityWidth :
         olderLiquidityWidth

f_addLevel(
     float levelPrice,
     int levelType,
     int sourceTime
) =>
    line newLine = line.new(
         x1=bar_index,
         y1=levelPrice,
         x2=bar_index + 1,
         y2=levelPrice,
         extend=extend.right,
         color=currentLevelColor,
         width=currentLiquidityWidth,
         style=line.style_solid
    )

    label newLabel = label.new(
         x=bar_index + 3,
         y=levelPrice,
         text=showLiquidityTag ?
             f_levelText(
                 levelType,
                 sourceTime,
                 0
             ) :
             "",
         style=label.style_label_left,
         color=showLiquidityTag ?
             color.new(
                 color.blue,
                 35
             ) :
             color.new(
                 color.blue,
                 100
             ),
         textcolor=showLiquidityTag ?
             color.white :
             color.new(
                 color.white,
                 100
             ),
         size=size.normal
    )

    array.push(
         levelPrices,
         levelPrice
    )

    array.push(
         levelTypes,
         levelType
    )

    array.push(
         levelCreatedBars,
         bar_index
    )

    array.push(
         levelSourceTimes,
         sourceTime
    )

    array.push(
         levelAges,
         0
    )

    array.push(
         levelWasTouched,
         false
    )

    array.push(
         levelLines,
         newLine
    )

    array.push(
         levelLabels,
         newLabel
    )

    true

f_deleteLevel(int index) =>
    line levelLine = array.get(
         levelLines,
         index
    )

    label levelLabel = array.get(
         levelLabels,
         index
    )

    line.delete(levelLine)
    label.delete(levelLabel)

    array.remove(
         levelPrices,
         index
    )

    array.remove(
         levelTypes,
         index
    )

    array.remove(
         levelCreatedBars,
         index
    )

    array.remove(
         levelSourceTimes,
         index
    )

    array.remove(
         levelAges,
         index
    )

    array.remove(
         levelWasTouched,
         index
    )

    array.remove(
         levelLines,
         index
    )

    array.remove(
         levelLabels,
         index
    )

    true

f_clearLevels() =>
    bool cleared = false

    if array.size(levelLines) > 0
        for i = array.size(levelLines) - 1 to 0
            line.delete(
                 array.get(
                     levelLines,
                     i
                 )
            )

            label.delete(
                 array.get(
                     levelLabels,
                     i
                 )
            )

            cleared := true

    array.clear(levelPrices)
    array.clear(levelTypes)
    array.clear(levelCreatedBars)
    array.clear(levelSourceTimes)
    array.clear(levelAges)
    array.clear(levelWasTouched)
    array.clear(levelLines)
    array.clear(levelLabels)

    cleared

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SESSION FINALIZATION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
f_finalizeSession() =>
    bool changed = false

    if array.size(levelPrices) > 0
        for i = array.size(levelPrices) - 1 to 0
            int levelAge = array.get(
                 levelAges,
                 i
            )

            bool wasTouched = array.get(
                 levelWasTouched,
                 i
            )

            if levelAge == 0
                if wasTouched
                    f_deleteLevel(i)
                    changed := true
                else
                    array.set(
                         levelAges,
                         i,
                         1
                    )

                    array.set(
                         levelWasTouched,
                         i,
                         false
                    )

                    changed := true
            else
                array.set(
                     levelAges,
                     i,
                     levelAge + 1
                )

                changed := true

    changed

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PREVENT DOUBLE FINALIZATION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var int lastFinalizedSessionKey = na

previousBarSessionKey =
     year(time[1], tz) * 10000 +
     month(time[1], tz) * 100 +
     dayofmonth(time[1], tz)

if usePrevDay and nyClose
    if na(lastFinalizedSessionKey) or
         lastFinalizedSessionKey != previousBarSessionKey

        f_finalizeSession()

        lastFinalizedSessionKey :=
             previousBarSessionKey

if usePrevDay and newDay
    if na(lastFinalizedSessionKey) or
         lastFinalizedSessionKey != previousBarSessionKey

        f_finalizeSession()

        lastFinalizedSessionKey :=
             previousBarSessionKey

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CREATE CURRENT PDH / MID / PDL
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if usePrevDay and
     newDay and
     not na(prevHigh) and
     not na(prevLow) and
     not na(prevDayTime)

    f_addLevel(
         prevHigh,
         1,
         prevDayTime
    )

    f_addLevel(
         dailyMid,
         2,
         prevDayTime
    )

    f_addLevel(
         prevLow,
         3,
         prevDayTime
    )

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MITIGATION TRACKING
//
// Current blue levels remain through the NY session.
//
// Historical levels disappear immediately when price
// actually trades at the level.
//
// A gap over a level does not count as mitigation.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if usePrevDay and
     array.size(levelPrices) > 0

    for i = array.size(levelPrices) - 1 to 0
        float activePrice = array.get(
             levelPrices,
             i
        )

        int createdBar = array.get(
             levelCreatedBars,
             i
        )

        int levelAge = array.get(
             levelAges,
             i
        )

        bool laterBar =
             bar_index > createdBar

        bool tradedAtLevel =
             laterBar and
             high >= activePrice and
             low <= activePrice

        if tradedAtLevel
            if levelAge == 0
                array.set(
                     levelWasTouched,
                     i,
                     true
                )
            else
                f_deleteLevel(i)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// UPDATE LEVEL APPEARANCE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if array.size(levelPrices) > 0
    for i = 0 to array.size(levelPrices) - 1
        float activePrice = array.get(
             levelPrices,
             i
        )

        int activeType = array.get(
             levelTypes,
             i
        )

        int sourceTime = array.get(
             levelSourceTimes,
             i
        )

        int levelAge = array.get(
             levelAges,
             i
        )

        color activeColor = f_levelColor(
             activeType,
             levelAge
        )

        int activeWidth = f_levelWidth(
             levelAge
        )

        string activeText = f_levelText(
             activeType,
             sourceTime,
             levelAge
        )

        line activeLine = array.get(
             levelLines,
             i
        )

        label activeLabel = array.get(
             levelLabels,
             i
        )

        line.set_y1(
             activeLine,
             activePrice
        )

        line.set_y2(
             activeLine,
             activePrice
        )

        line.set_color(
             activeLine,
             activeColor
        )

        line.set_width(
             activeLine,
             activeWidth
        )

        label.set_xy(
             activeLabel,
             bar_index + 3,
             activePrice
        )

        label.set_text(
             activeLabel,
             showLiquidityTag ?
                 activeText :
                 ""
        )

        label.set_color(
             activeLabel,
             showLiquidityTag ?
                 color.new(
                     activeColor,
                     levelAge == 0 ?
                         35 :
                         45
                 ) :
                 color.new(
                     activeColor,
                     100
                 )
        )

        label.set_textcolor(
             activeLabel,
             showLiquidityTag ?
                 (
                     levelAge == 0 ?
                     color.white :
                     color.black
                 ) :
                 color.new(
                     color.white,
                     100
                 )
        )

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// OBJECT SAFETY LIMIT
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
while array.size(levelPrices) >
     maximumDailyLevels

    line oldestLine = array.shift(
         levelLines
    )

    label oldestLabel = array.shift(
         levelLabels
    )

    line.delete(oldestLine)
    label.delete(oldestLabel)

    array.shift(levelPrices)
    array.shift(levelTypes)
    array.shift(levelCreatedBars)
    array.shift(levelSourceTimes)
    array.shift(levelAges)
    array.shift(levelWasTouched)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INPUT CLEANUP
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if not showOvernight
    if not na(pmhLine)
        line.delete(pmhLine)
        pmhLine := na

    if not na(pmlLine)
        line.delete(pmlLine)
        pmlLine := na

    if not na(pmhTag)
        label.delete(pmhTag)
        pmhTag := na

    if not na(pmlTag)
        label.delete(pmlTag)
        pmlTag := na

if not showPrevClose
    if not na(pdcLine)
        line.delete(pdcLine)
        pdcLine := na

    if not na(pdcTag)
        label.delete(pdcTag)
        pdcTag := na

if not usePrevDay
    f_clearLevels()

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// HTF SUPPLY / DEMAND
// SUPPLY = GREEN
// DEMAND = RED
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
htfHigh = request.security(
     syminfo.tickerid,
     htf,
     high
)

htfLow = request.security(
     syminfo.tickerid,
     htf,
     low
)

htfOpen = request.security(
     syminfo.tickerid,
     htf,
     open
)

htfClose = request.security(
     syminfo.tickerid,
     htf,
     close
)

htfATR = request.security(
     syminfo.tickerid,
     htf,
     ta.atr(atrLen)
)

htfBearDisp =
     htfClose < htfOpen and
     math.abs(
         htfClose -
         htfOpen
     ) > htfATR * dispMult

htfBullDisp =
     htfClose > htfOpen and
     math.abs(
         htfClose -
         htfOpen
     ) > htfATR * dispMult

supplyCreated = htfBearDisp
demandCreated = htfBullDisp

var float supplyTop = na
var float supplyBot = na
var float demandTop = na
var float demandBot = na

var box supplyBox = na
var box demandBox = na

var bool supplyMitigated = false
var bool demandMitigated = false

if supplyCreated
    supplyTop := htfHigh

    supplyBot := math.max(
         htfOpen,
         htfClose
    )

    supplyMitigated := false

    if not na(supplyBox)
        box.delete(supplyBox)

    supplyBox := box.new(
         left=bar_index,
         top=supplyTop,
         right=bar_index + 100,
         bottom=supplyBot,
         bgcolor=color.new(
             color.green,
             82
         ),
         border_color=color.green
    )

if demandCreated
    demandTop := math.min(
         htfOpen,
         htfClose
    )

    demandBot := htfLow
    demandMitigated := false

    if not na(demandBox)
        box.delete(demandBox)

    demandBox := box.new(
         left=bar_index,
         top=demandTop,
         right=bar_index + 100,
         bottom=demandBot,
         bgcolor=color.new(
             color.red,
             82
         ),
         border_color=color.red
    )

if not na(supplyBox)
    box.set_right(
         supplyBox,
         bar_index + 100
    )

if not na(demandBox)
    box.set_right(
         demandBox,
         bar_index + 100
    )

inSupply =
     not na(supplyTop) and
     high >= supplyBot and
     low <= supplyTop

inDemand =
     not na(demandBot) and
     low <= demandTop and
     high >= demandBot

if inSupply
    supplyMitigated := true

if inDemand
    demandMitigated := true

if nyClose
    if supplyMitigated and
         not na(supplyBox)

        box.delete(supplyBox)

        supplyBox := na
        supplyTop := na
        supplyBot := na
        supplyMitigated := false

    if demandMitigated and
         not na(demandBox)

        box.delete(demandBox)

        demandBox := na
        demandTop := na
        demandBot := na
        demandMitigated := false

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LIQUIDITY SWEEP LOGIC
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
sweepPMHigh =
     not na(overnightHigh) and
     high > overnightHigh and
     close < overnightHigh

sweepPMLow =
     not na(overnightLow) and
     low < overnightLow and
     close > overnightLow

breakPMHighHold =
     not na(overnightHigh) and
     close > overnightHigh

breakPMLowHold =
     not na(overnightLow) and
     close < overnightLow

sweepPrevHigh =
     usePrevDay and
     not na(prevHigh) and
     high > prevHigh and
     close < prevHigh

sweepPrevLow =
     usePrevDay and
     not na(prevLow) and
     low < prevLow and
     close > prevLow

bearTrap =
     sweepPMHigh or
     sweepPrevHigh

bullTrap =
     sweepPMLow or
     sweepPrevLow

trendUp =
     breakPMHighHold

trendDown =
     breakPMLowHold

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TRINITY LOGIC
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
bullOBC =
     (
         inDemand or
         bullTrap
     ) and
     close > open

bearOBC =
     (
         inSupply or
         bearTrap
     ) and
     close < open

bullDC =
     close > open and
     (
         close -
         open
     ) > atr * dispMult and
     close > high[1]

bearDC =
     close < open and
     (
         open -
         close
     ) > atr * dispMult and
     close < low[1]

var float bullOBC_Low = na
var float bearOBC_High = na

var bool bullDCSeen = false
var bool bearDCSeen = false

if bullOBC
    bullOBC_Low := low
    bullDCSeen := false

if bearOBC
    bearOBC_High := high
    bearDCSeen := false

if bullDC and
     not na(bullOBC_Low)

    bullDCSeen := true

if bearDC and
     not na(bearOBC_High)

    bearDCSeen := true

bullCBC1 =
     bullDCSeen and
     not na(bullOBC_Low) and
     low > bullOBC_Low and
     close > open

bearCBC1 =
     bearDCSeen and
     not na(bearOBC_High) and
     high < bearOBC_High and
     close < open

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TRADE FILTERS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var int tradeCount = 0

if newDay
    tradeCount := 0

canTrade =
     tradeCount <
     maxTradesPerDay and
     inNY

longSetup =
     canTrade and
     bullCBC1 and
     (
         inDemand or
         bullTrap or
         trendUp
     ) and
     not inSupply

shortSetup =
     canTrade and
     bearCBC1 and
     (
         inSupply or
         bearTrap or
         trendDown
     ) and
     not inDemand

if longSetup
    tradeCount += 1

if shortSetup
    tradeCount += 1

longStop =
     bullOBC_Low

shortStop =
     bearOBC_High

longTarget =
     not na(supplyBot) ?
         supplyBot :
         prevHigh

shortTarget =
     not na(demandTop) ?
         demandTop :
         prevLow

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TRINITY LABELS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if showLabels and bullOBC
    label.new(
         bar_index,
         low,
         "OBC",
         style=label.style_label_up,
         color=color.new(
             color.red,
             55
         ),
         textcolor=color.white,
         size=size.tiny
    )

if showLabels and bearOBC
    label.new(
         bar_index,
         high,
         "OBC",
         style=label.style_label_down,
         color=color.new(
             color.green,
             55
         ),
         textcolor=color.white,
         size=size.tiny
    )

if showLabels and bullDC
    label.new(
         bar_index,
         low,
         "DC",
         style=label.style_label_up,
         color=color.new(
             color.teal,
             55
         ),
         textcolor=color.white,
         size=size.tiny
    )

if showLabels and bearDC
    label.new(
         bar_index,
         high,
         "DC",
         style=label.style_label_down,
         color=color.new(
             color.orange,
             55
         ),
         textcolor=color.white,
         size=size.tiny
    )

if showLabels and longSetup
    label.new(
         bar_index,
         low,
         "CBC1 BUY",
         style=label.style_label_up,
         color=color.new(
             color.lime,
             35
         ),
         textcolor=color.black
    )

if showLabels and shortSetup
    label.new(
         bar_index,
         high,
         "CBC1 SELL",
         style=label.style_label_down,
         color=color.new(
             color.red,
             35
         ),
         textcolor=color.white
    )

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ALERT CONDITIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
alertcondition(
     bullOBC,
     "Bullish OBC Formed",
     "CantLewz Bullish OBC formed"
)

alertcondition(
     bearOBC,
     "Bearish OBC Formed",
     "CantLewz Bearish OBC formed"
)

alertcondition(
     bullDC,
     "Bullish DC Formed",
     "CantLewz Bullish Displacement Candle formed"
)

alertcondition(
     bearDC,
     "Bearish DC Formed",
     "CantLewz Bearish Displacement Candle formed"
)

alertcondition(
     longSetup,
     "LONG CBC1 Entry",
     "CantLewz LONG CBC1 entry confirmed"
)

alertcondition(
     shortSetup,
     "SHORT CBC1 Entry",
     "CantLewz SHORT CBC1 entry confirmed"
)

if longSetup
    alert(
         '{"system":"CantLewz","event":"ENTRY","side":"LONG","symbol":"' +
         syminfo.ticker +
         '","price":"' +
         str.tostring(close) +
         '","stop":"' +
         str.tostring(longStop) +
         '","target":"' +
         str.tostring(longTarget) +
         '","logic":"HTF_DEMAND_OR_SWEEP_PLUS_TRINITY_CBC1"}',
         alert.freq_once_per_bar_close
    )

if shortSetup
    alert(
         '{"system":"CantLewz","event":"ENTRY","side":"SHORT","symbol":"' +
         syminfo.ticker +
         '","price":"' +
         str.tostring(close) +
         '","stop":"' +
         str.tostring(shortStop) +
         '","target":"' +
         str.tostring(shortTarget) +
         '","logic":"HTF_SUPPLY_OR_SWEEP_PLUS_TRINITY_CBC1"}',
         alert.freq_once_per_bar_close
    )
