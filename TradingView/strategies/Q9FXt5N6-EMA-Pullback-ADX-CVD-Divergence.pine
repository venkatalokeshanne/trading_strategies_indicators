//@version=5
strategy("EMA Pullback + ADX + CVD Divergence", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// ===== INPUTS =====
adxLen = input.int(14, "ADX Length")
adxThreshold = input.int(25, "ADX Threshold")
rr = input.float(3.0, "RR")
lookback = input.int(10, "Divergence Lookback")

// ===== EMA =====
ema9 = ta.ema(close, 9)
ema20 = ta.ema(close, 20)

// ===== ADX =====
[plusDI, minusDI, adx] = ta.dmi(adxLen, adxLen)

// ===== CVD (Proxy) =====
delta = close > open ? volume : close < open ? -volume : 0
cvd = ta.cum(delta)

// ===== DIVERGENCE =====
// Bullish: price LL, CVD HL
priceLL = low < ta.lowest(low[1], lookback)
cvdHL = cvd > ta.lowest(cvd[1], lookback)
bullDiv = priceLL and cvdHL

// Bearish: price HH, CVD LH
priceHH = high > ta.highest(high[1], lookback)
cvdLH = cvd < ta.highest(cvd[1], lookback)
bearDiv = priceHH and cvdLH

// ===== TREND =====
bullCross = ta.crossover(ema9, ema20)
bearCross = ta.crossunder(ema9, ema20)

var bool waitBuy = false
var bool waitSell = false

if bullCross
    waitBuy := true
    waitSell := false

if bearCross
    waitSell := true
    waitBuy := false

// ===== PULLBACK =====
pullbackBuy = waitBuy and (low <= ema9 or low <= ema20)
pullbackSell = waitSell and (high >= ema9 or high >= ema20)

// ===== FINAL CONDITIONS =====
strongTrend = adx > adxThreshold

buySignal = pullbackBuy and strongTrend and bullDiv and close > open
sellSignal = pullbackSell and strongTrend and bearDiv and close < open

// Reset
if buySignal
    waitBuy := false
if sellSignal
    waitSell := false

// ===== SL / TP =====
swingLow = ta.lowest(low, 5)
swingHigh = ta.highest(high, 5)

buySL = swingLow
sellSL = swingHigh

buyRisk = close - buySL
sellRisk = sellSL - close

buyTP = close + (buyRisk * rr)
sellTP = close - (sellRisk * rr)

// ===== EXECUTION =====
if buySignal
    strategy.entry("BUY", strategy.long)
    strategy.exit("BUY EXIT", from_entry="BUY", stop=buySL, limit=buyTP)

if sellSignal
    strategy.entry("SELL", strategy.short)
    strategy.exit("SELL EXIT", from_entry="SELL", stop=sellSL, limit=sellTP)

// ===== PLOTS =====
plot(ema9, color=color.green)
plot(ema20, color=color.red)

plotshape(buySignal, location=location.belowbar, color=color.green, style=shape.labelup, text="BUY")
plotshape(sellSignal, location=location.abovebar, color=color.red, style=shape.labeldown, text="SELL")

// ===== ALERTS =====
alertcondition(buySignal, title="BUY ALERT", message="BUY with CVD Divergence")
alertcondition(sellSignal, title="SELL ALERT", message="SELL with CVD Divergence")