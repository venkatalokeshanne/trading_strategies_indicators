
// Input format: comma-separated levels, e.g. "6300 (major), 6285-88, 6270"
//   - "(major)" after a level marks it major (case-insensitive)
//   - "6285-88" is a zone; a short right-hand side inherits the left side's leading digits
// Line styles, labels, and colors are configurable in settings.
// Copy and Paste ES Levels from DailyTrader
//@version=6

indicator('ES Levels', overlay = true, max_lines_count = 500, max_labels_count = 500)

supports    = input.string('', 'Supports')
resistances = input.string('', 'Resistances')
lineWidth   = input.int(2, 'Line Width', minval = 1)

majorStyleIn = input.string('Solid',  'Major Support/Resistance Line Style', options = ['Solid', 'Dashed', 'Dotted'])
minorStyleIn = input.string('Dotted', 'Minor Support/Resistance Line Style', options = ['Solid', 'Dashed', 'Dotted'])

showLabels  = input.bool(true, 'Show Price Labels')
labelOffset = input.int(30, 'Label Offset')

majorSupportColor    = input.color(color.new(color.green, 30), 'Major Support Color')
minorSupportColor    = input.color(color.new(color.green, 30), 'Minor Support Color')
majorResistanceColor = input.color(color.new(color.red, 30),   'Major Resistance Color')
minorResistanceColor = input.color(color.new(color.red, 30),   'Minor Resistance Color')

majorSupportRangeFillColor    = input.color(color.new(color.green, 80),              'Major Support Range Fill Color')
minorSupportRangeFillColor    = input.color(color.new(color.olive, 90),              'Minor Support Range Fill Color')
majorResistanceRangeFillColor = input.color(color.new(color.rgb(220, 20, 60), 80),   'Major Resistance Range Fill Color')
minorResistanceRangeFillColor = input.color(color.new(color.red, 90),                'Minor Resistance Range Fill Color')
majorRangeLineColor           = input.color(color.new(color.yellow, 75),             'Major Range Line Color')
minorRangeLineColor           = input.color(color.new(color.yellow, 50),             'Minor Range Line Color')

// Requires one alert set up in TradingView on this indicator with
// condition "Any alert() function call" — see notes at bottom of script.
enableSupportAlerts = input.bool(true, 'Alert on Major Support Break/Reclaim', group = 'Alerts')
approachDistance    = input.float(0.0, 'Approach Alert Distance (points, 0 = off)', minval = 0, group = 'Alerts')

styleOf(name) =>
    name == 'Solid' ? line.style_solid : name == 'Dashed' ? line.style_dashed : line.style_dotted

majorLineStyle = styleOf(majorStyleIn)
minorLineStyle = styleOf(minorStyleIn)

// All drawings live in these arrays. On the last bar everything is wiped and
// redrawn from the inputs, so stale objects never accumulate and no
// size-based pruning is needed.
var allLines  = array.new<line>()
var allFills  = array.new<linefill>()
var allLabels = array.new<label>()

clear_drawings() =>
    for l in allLines
        line.delete(l)
    for f in allFills
        linefill.delete(f)
    for lb in allLabels
        label.delete(lb)
    array.clear(allLines)
    array.clear(allFills)
    array.clear(allLabels)

new_level_line(float y, color lineColor, string lineStyle) =>
    l = line.new(bar_index, y, bar_index + 1, y, extend = extend.both, width = lineWidth, color = lineColor, style = lineStyle)
    allLines.push(l)
    l

new_price_label(float y, color textColor, color bgColor) =>
    if showLabels
        allLabels.push(label.new(bar_index + labelOffset, y, str.tostring(y), style = label.style_label_center, textcolor = textColor, color = bgColor))

// "6285-88" → [6285, 6288]: when the right-hand side has fewer digits than the
// left, it inherits the left side's leading digits. "6285-6288" works as-is.
parse_range(string token) =>
    parts       = str.split(token, '-')
    topToken    = parts.get(0)
    bottomToken = parts.size() > 1 ? parts.get(1) : ''
    top     = str.tonumber(topToken)
    lenDiff = str.length(topToken) - str.length(bottomToken)
    bottom  = lenDiff > 0 ? str.tonumber(str.substring(topToken, 0, lenDiff) + bottomToken) : str.tonumber(bottomToken)
    [top, bottom]

draw_levels(string inputStr, bool isSupport) =>
    tokens = str.split(str.replace_all(str.lower(inputStr), ' ', ''), ',')
    for token in tokens
        isMajor    = str.contains(token, '(major)')
        cleaned    = str.replace_all(token, '(major)', '')
        levelColor = isSupport ? (isMajor ? majorSupportColor : minorSupportColor) : (isMajor ? majorResistanceColor : minorResistanceColor)
        lineStyle  = isMajor ? majorLineStyle : minorLineStyle
        if str.contains(cleaned, '-')
            [top, bottom] = parse_range(cleaned)
            if not na(top) and not na(bottom)
                rangeLineColor = isMajor ? majorRangeLineColor : minorRangeLineColor
                topLine    = new_level_line(top, rangeLineColor, lineStyle)
                bottomLine = new_level_line(bottom, rangeLineColor, lineStyle)
                fillColor  = isSupport ? (isMajor ? majorSupportRangeFillColor : minorSupportRangeFillColor) : (isMajor ? majorResistanceRangeFillColor : minorResistanceRangeFillColor)
                allFills.push(linefill.new(topLine, bottomLine, fillColor))
                // label the edge traders act on: bottom of support zones, top of resistance zones
                new_price_label(isSupport ? bottom : top, levelColor, color.new(chart.bg_color, 100))
        else
            level = str.tonumber(cleaned)
            if not na(level)
                new_level_line(level, levelColor, lineStyle)
                new_price_label(level, levelColor, chart.bg_color)

// Major support levels used for alerts: standalone major levels, plus the
// bottom edge of major support zones (the edge a break actually violates).
collect_major_supports() =>
    result = array.new<float>()
    tokens = str.split(str.replace_all(str.lower(supports), ' ', ''), ',')
    for token in tokens
        if str.contains(token, '(major)')
            cleaned = str.replace_all(token, '(major)', '')
            if str.contains(cleaned, '-')
                [_, bottom] = parse_range(cleaned)
                if not na(bottom)
                    result.push(bottom)
            else
                level = str.tonumber(cleaned)
                if not na(level)
                    result.push(level)
    result

// Inputs are constant for the life of the script, so parse once on the first bar.
var majorSupportLevels = collect_major_supports()
// Per-level re-arm state for approach alerts: fire on entering the band, not every bar inside it.
var wasNearLevel = array.new<bool>(majorSupportLevels.size(), false)

if enableSupportAlerts
    for [i, level] in majorSupportLevels
        if close[1] >= level and close < level
            alert(syminfo.ticker + ': major support ' + str.tostring(level) + ' BROKEN, price ' + str.tostring(close), alert.freq_once_per_bar)
        if close[1] <= level and close > level
            alert(syminfo.ticker + ': major support ' + str.tostring(level) + ' reclaimed, price ' + str.tostring(close), alert.freq_once_per_bar)
        if approachDistance > 0
            isNear = close > level and close - level <= approachDistance
            if isNear and not wasNearLevel.get(i)
                alert(syminfo.ticker + ': approaching major support ' + str.tostring(level) + ', price ' + str.tostring(close), alert.freq_once_per_bar)
            wasNearLevel.set(i, isNear)

if barstate.islast
    clear_drawings()
    draw_levels(supports, true)
    draw_levels(resistances, false)

// ALERT SETUP (one-time, per chart):
//   1. Add this indicator to the chart and fill in the Supports input.
//   2. Open the Alert dialog, pick "Mancini Levels" as the condition,
//      and choose "Any alert() function call".
//   3. Set expiration/notification channel (app push, email, webhook) as desired.
// The alert messages are generated dynamically, so this single TradingView
// alert covers every major support level — no need to recreate alerts when
// you paste in new levels each morning (editing inputs keeps the alert alive;
// levels are read from the indicator settings the alert was created with,
// so re-save the alert if you change the Supports input).
