        table.cell(dash, 6, 12, lVWAPText, text_color=highlightTextColor, bgcolor=lPrice > lVWAP ? color.green : color.red, text_size=textSize)


        //============================================================
        // SBI
        //============================================================

        string sVWAPText = "BELOW"

        if sPrice > sVWAP
            sVWAPText := "ABOVE"


        table.cell(dash, 0, 13, "SBI", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

        table.cell(dash, 1, 13, str.tostring(sScore, "#.0"), text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

