            table.cell(tbl, 2, row, "", bgcolor=tableBackground, text_color=tableValue, text_size=tableSize)
            table.cell(tbl, 3, row, str.tostring(ma1, format.mintick), bgcolor=tableBackground, text_color=tableValue, text_size=tableSize)
