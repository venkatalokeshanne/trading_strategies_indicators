//@version=6
indicator("High Volume Alert (Above Average)", overlay=false)

// Length of lookback period
lookback = input.int(20, title="Lookback Period (candles)", minval=1)

// Average volume of the last 20 candles (excluding current, still-forming candle)
avgVol = ta.sma(volume[1], lookback)

// Condition: current volume greater than average of last 20 candles
volumeSpike = volume > avgVol

// Plot volume as columns, colored when spike occurs
volColor = volumeSpike ? color.new(color.red, 0) : color.new(color.gray, 0)
plot(volume, title="Volume", style=plot.style_columns, color=volColor)

// Plot the average volume line
plot(avgVol, title="Average Volume (Last 20)", color=color.orange, linewidth=1)

// Plot shape marker on chart when spike occurs
plotshape(volumeSpike, title="Volume Spike", style=shape.triangleup, location=location.top, color=color.red, size=size.tiny)

// Alert condition (for the "Create Alert" dialog)
alertcondition(volumeSpike, title="Volume Above Average Alert", message="Volume is greater than the average of the last 20 candles!")

// Direct alert call
if volumeSpike
    alert("Volume spike detected: current volume exceeds the " + str.tostring(lookback) + "-candle average", alert.freq_once_per_bar_close)
