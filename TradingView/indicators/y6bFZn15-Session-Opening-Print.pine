//@version=6
indicator("Session Opening Print", overlay=true, max_lines_count=500, max_labels_count=500)

sessionHour = input.int(9, "Open Hour", minval=0, maxval=23)
sessionMinute = input.int(30, "Open Minute", minval=0, maxval=59)
sessionTimezone = input.string("America/New_York", "Timezone", options=["America/New_York", "America/Chicago", "America/Los_Angeles", "UTC", "Europe/London", "Asia/Tokyo"])
lineColor = input.color(color.yellow, "Line Color")
lineWidth = input.int(1, "Line Width", minval=1, maxval=5)
lineStyle = input.string("Solid", "Line Style", options=["Solid", "Dashed", "Dotted"])
extendRight = input.bool(true, "Extend Line to Right Edge")
showLabel = input.bool(true, "Show Price Label")
newLineEachDay = input.bool(true, "New Line Each Day (uncheck for one persistent line)")

f_lineStyle(styleInput) =>
    result = line.style_solid
    if styleInput == "Dashed"
        result := line.style_dashed
    else if styleInput == "Dotted"
        result := line.style_dotted
    result

var line openLine = na
var label openLabel = na
var float openPrice = na
var int openBarIndex = na
var int lastSessionDay = na

sessionTimeStr = str.format("{0}:{1}", sessionHour, sessionMinute)
inSessionBar = hour(time, sessionTimezone) == sessionHour and minute(time, sessionTimezone) == sessionMinute
currentDay = dayofmonth(time, sessionTimezone)

if inSessionBar and (na(lastSessionDay) or currentDay != lastSessionDay)
    openPrice := open
    openBarIndex := bar_index
    lastSessionDay := currentDay

    if newLineEachDay
        if not na(openLine) and not extendRight
            line.set_extend(openLine, extend.none)
        openLine := line.new(x1=openBarIndex, y1=openPrice, x2=openBarIndex + 1, y2=openPrice, color=lineColor, width=lineWidth, style=f_lineStyle(lineStyle), extend=extendRight ? extend.right : extend.none)
        if showLabel
            openLabel := label.new(x=openBarIndex, y=openPrice, text=str.tostring(openPrice, format.mintick), style=label.style_label_left, color=color.new(lineColor, 80), textcolor=lineColor, size=size.small)
    else
        if na(openLine)
            openLine := line.new(x1=openBarIndex, y1=openPrice, x2=openBarIndex + 1, y2=openPrice, color=lineColor, width=lineWidth, style=f_lineStyle(lineStyle), extend=extendRight ? extend.right : extend.none)
        else
            line.set_xy1(openLine, openBarIndex, openPrice)
            line.set_xy2(openLine, openBarIndex + 1, openPrice)
        if showLabel
            if na(openLabel)
                openLabel := label.new(x=openBarIndex, y=openPrice, text=str.tostring(openPrice, format.mintick), style=label.style_label_left, color=color.new(lineColor, 80), textcolor=lineColor, size=size.small)
            else
                label.set_xy(openLabel, openBarIndex, openPrice)
                label.set_text(openLabel, str.tostring(openPrice, format.mintick))