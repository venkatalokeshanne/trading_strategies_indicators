//@version=6
strategy("Gold HFT - Hybrid MT5 Final", overlay=true, initial_capital=50000, currency=currency.CAD, default_qty_type=strategy.fixed, default_qty_value=1)

// --- YOUR CONFIG ---
var string LICENSE_ID = "8919306666197"
var string SYMBOL     = "XAUUSD" // Change to "XAUUSD.r" if Eightcap needs it

// --- Logic Settings (Your Best Performers) ---
tp = 5.0
sl = 3.0
trail_act = 3.0
trail_off = 1.5

// --- Hybrid Session (London Open to NY Close) ---
is_session = not na(time(timeframe.period, "0700-2000:23456"))

// --- Indicators ---
ema_fast = ta.ema(close, 9)
ema_slow = ta.ema(close, 21)
[_, _, adx_val] = ta.dmi(14, 14)

// --- PineConnector Syntax (Hardcoded 0.01 Lots for Real Money) ---
long_msg  = LICENSE_ID + ",buy,"  + SYMBOL + ",vol_lots=0.1,sl_price=" + str.tostring(close - sl) + ",tp_price=" + str.tostring(close + tp) + ",trail_step=" + str.tostring(trail_off) + ",trail_price=" + str.tostring(close + trail_act)
short_msg = LICENSE_ID + ",sell," + SYMBOL + ",vol_lots=0.1,sl_price=" + str.tostring(close + sl) + ",tp_price=" + str.tostring(close - tp) + ",trail_step=" + str.tostring(trail_off) + ",trail_price=" + str.tostring(close - trail_act)

// --- Entry Triggers ---
if ta.crossover(ema_fast, ema_slow) and adx_val > 15 and is_session
    strategy.entry("L", strategy.long, alert_message=long_msg)

if ta.crossunder(ema_fast, ema_slow) and adx_val > 15 and is_session
    strategy.entry("S", strategy.short, alert_message=short_msg)

// --- Exit Engine ---
ts = syminfo.mintick
strategy.exit("XL", "L", limit=strategy.position_avg_price + tp, stop=strategy.position_avg_price - sl, trail_points=trail_act/ts, trail_offset=trail_off/ts)
strategy.exit("XS", "S", limit=strategy.position_avg_price - tp, stop=strategy.position_avg_price + sl, trail_points=trail_act/ts, trail_offset=trail_off/ts)