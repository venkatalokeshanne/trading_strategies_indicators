//@version=6
strategy(
     "EMA 5/13/26 Cross + Volume + Dynamic SL + Smart RR + Intraday Exit",
     overlay = true,
     initial_capital = 100000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     process_orders_on_close = true
)

// ================= Inputs =================
ema5_len  = input.int(5,  title="EMA 5 Length")
ema13_len = input.int(13, title="EMA 13 Length")
ema26_len = input.int(26, title="EMA 26 Length")
vol_len   = input.int(20, title="Volume MA Length")

// Risk Cap
maxRiskPercent = input.float(1.0, "Max Risk %")

// Intraday Exit Time
exitHour   = input.int(23, "Exit Hour")
exitMinute = input.int(10, "Exit Minute")

src = input(close, "Source")

// ================= EMA =================
ema5  = ta.ema(src, ema5_len)
ema13 = ta.ema(src, ema13_len)
ema26 = ta.ema(src, ema26_len)

// ================= Volume =================
avgVolume = ta.sma(volume, vol_len)
volumeCondition = volume > avgVolume

// ================= Plot =================
plot(ema5,  color=color.red,    title="EMA 5")
plot(ema13, color=color.blue,   title="EMA 13")
plot(ema26, color=color.purple, title="EMA 26")

// ================= CONDITIONS =================

// Long Entry
buyCondition =
     ema5[1] < ema13[1] and ema5[1] < ema26[1] and
     ema5 > ema13 and ema5 > ema26 and
     volumeCondition

// Short Entry
sellCondition =
     ema5[1] > ema13[1] and ema5[1] > ema26[1] and
     ema5 < ema13 and ema5 < ema26 and
     volumeCondition

// ================= SL STORAGE =================
var float longSL = na
var float shortSL = na
var float longSignalHigh = na
var float longSignalLow = na
var float shortSignalHigh = na
var float shortSignalLow = na

if (buyCondition and strategy.position_size == 0)
    longSL := low
    longSignalHigh := high
    longSignalLow := low

if (sellCondition and strategy.position_size == 0)
    shortSL := high
    shortSignalHigh := high
    shortSignalLow := low

// ================= ENTRIES =================

// Long
if buyCondition
    strategy.close("Short")
    strategy.entry("Long", strategy.long)

// Short
if sellCondition
    strategy.close("Long")
    strategy.entry("Short", strategy.short)

// ================= RISK CALCULATION =================

// ---- LONG ----
longEntry = strategy.position_avg_price
longRiskRaw = longEntry - longSL

// Risk Cap
maxLongRisk = longEntry * maxRiskPercent / 100
longRisk = math.min(longRiskRaw, maxLongRisk)

// Signal candle size %
longCandlePerc = (longSignalHigh - longSignalLow) / longSignalLow * 100

// RR logic
longRR = longCandlePerc > 1 ? 1 : 2

longSL_final = longEntry - longRisk
longTarget = longEntry + (longRR * longRisk)

// ---- SHORT ----
shortEntry = strategy.position_avg_price
shortRiskRaw = shortSL - shortEntry

// Risk Cap
maxShortRisk = shortEntry * maxRiskPercent / 100
shortRisk = math.min(shortRiskRaw, maxShortRisk)

// Signal candle size %
shortCandlePerc = (shortSignalHigh - shortSignalLow) / shortSignalLow * 100

// RR logic
shortRR = shortCandlePerc > 1 ? 1 : 2

shortSL_final = shortEntry + shortRisk
shortTarget = shortEntry - (shortRR * shortRisk)

// ================= EXITS =================

// Long Exit
strategy.exit("Exit Long", 
     from_entry="Long", 
     stop=longSL_final, 
     limit=longTarget)

// Short Exit
strategy.exit("Exit Short", 
     from_entry="Short", 
     stop=shortSL_final, 
     limit=shortTarget)

// ================= INTRADAY EXIT =================
currentHour = hour(time)
currentMinute = minute(time)

isExitTime = (currentHour == exitHour and currentMinute >= exitMinute)

if (isExitTime)
    strategy.close_all(comment="Intraday Exit")

// ================= ALERTS =================
if buyCondition
    alert("BUY: EMA bullish crossover with volume", alert.freq_once_per_bar_close)

if sellCondition
    alert("SELL: EMA bearish crossover with volume", alert.freq_once_per_bar_close)