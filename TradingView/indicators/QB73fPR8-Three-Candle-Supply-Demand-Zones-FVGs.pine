//@version=6
indicator(
     "Three-Candle Supply/Demand Zones + FVGs",
     overlay = true,
     max_boxes_count = 500,
     max_lines_count = 500
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Display and lifecycle
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

groupDisplay = "Display and Lifecycle"

showDemandZones = input.bool(
     true,
     "Show Bullish Demand Zones",
     tooltip = "Displays demand zones created by bullish three-candle formations.",
     group = groupDisplay
)

showSupplyZones = input.bool(
     true,
     "Show Bearish Supply Zones",
     tooltip = "Displays supply zones created by bearish three-candle formations.",
     group = groupDisplay
)

showBullishFVGs = input.bool(
     true,
     "Show Bullish FVGs",
     tooltip = "Displays fair value gaps created by bullish three-candle formations.",
     group = groupDisplay
)

showBearishFVGs = input.bool(
     true,
     "Show Bearish FVGs",
     tooltip = "Displays fair value gaps created by bearish three-candle formations.",
     group = groupDisplay
)

removeTouchedSD = input.bool(
     false,
     "Remove Touched Supply / Demand Zones",
     tooltip = "Deletes a supply or demand zone when a future wick first penetrates it.",
     group = groupDisplay
)

removeTouchedFVG = input.bool(
     false,
     "Remove Touched FVGs",
     tooltip = "Deletes a fair value gap when a future wick first penetrates it.",
     group = groupDisplay
)

