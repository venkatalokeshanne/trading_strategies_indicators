//@version=6
// Author: tyjkot
// Meow
indicator("Distance from 200 DMA", overlay=false, max_bars_back=5000)

// User-selectable price source
srcOption = input.string("Close", "Price Source", options=["Close", "Open", "High", "Low", "HL2", "HLC3", "OHLC4"])

src = switch srcOption
    "Close" => close
    "Open"  => open
    "High"  => high
    "Low"   => low
    "HL2"   => hl2
    "HLC3"  => hlc3
    "OHLC4" => ohlc4

// Always fetch the 200-period Daily SMA of the selected source, regardless of chart timeframe
dailySMA200 = request.security(syminfo.tickerid, "D", ta.sma(src, 200), lookahead=barmerge.lookahead_off)

// Distance from current bar’s selected source to the 200 Daily SMA (in %)
distance = (src - dailySMA200) / dailySMA200 * 100

// Simple moving average of the distance (for the signal line)
lenMA = input.int(15, "MA Length of Distance", minval=1)
distMA = ta.sma(distance, lenMA)

// Color the MA line based on whether distance is increasing or decreasing
maColor = distMA > distMA[1] ? color.lime : color.purple

// Plot histogram (teal) – height = distance from 200 DMA
plot(distance, title="Distance to 200 DMA", style=plot.style_histogram, color=#00bcd4, linewidth=1)

// Plot the MA of the distance with dynamic color
plot(distMA, title="MA of Distance", color=maColor, linewidth=2)

// Zero line
hline(0, "Zero", color=color.gray, linestyle=hline.style_dotted)