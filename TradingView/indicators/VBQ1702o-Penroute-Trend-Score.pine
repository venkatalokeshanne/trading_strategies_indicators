//@version=6
indicator("Penroute Trend Score", overlay = true)

// ---- thresholds
adxLen    = input.int(14,     "ADX length")
adxTh     = input.float(25,   "ADX above")
erLen     = input.int(20,     "Efficiency lookback")
erTh      = input.float(0.55, "Efficiency above", step = 0.01)
emaLen    = input.int(50,     "EMA length")
emaLook   = input.int(10,     "EMA closes lookback")
emaNeed   = input.int(8,      "Closes needed same side")
sweepLook = input.int(20,     "Sweep lookback")
sweepTh   = input.float(0.40, "Reversion rate below", step = 0.01)
atrFast   = input.int(5,      "ATR fast")
atrSlow   = input.int(20,     "ATR slow")
atrTh     = input.float(1.30, "ATR ratio above", step = 0.05)

// ---- 1. ADX
[_dip, _dim, adxVal] = ta.dmi(adxLen, adxLen)
c1 = adxVal > adxTh

// ---- 2. directional efficiency
netMove  = math.abs(close - close[erLen])
pathMove = math.sum(math.abs(close - close[1]), erLen)
effRatio = pathMove > 0 ? netMove / pathMove : 0.0
c2 = effRatio > erTh

// ---- 3. closes vs EMA
emaVal   = ta.ema(close, emaLen)
above    = math.sum(close > emaVal ? 1 : 0, emaLook)
sameSide = math.max(above, emaLook - above)
c3 = sameSide >= emaNeed

// ---- 4. sweep reversion rate
brokeHigh = high > high[1]
brokeLow  = low  < low[1]
broke     = brokeHigh or brokeLow
reverted  = brokeHigh and brokeLow ? close <= high[1] and close >= low[1] : brokeHigh ? close <= high[1] : brokeLow ? close >= low[1] : false
breaks    = math.sum(broke    ? 1 : 0, sweepLook)
reverts   = math.sum(reverted ? 1 : 0, sweepLook)
revRate   = breaks > 0 ? reverts / breaks : na
c4 = not na(revRate) and breaks >= 5 and revRate < sweepTh

// ---- 5. ATR ratio
atrRatio = ta.atr(atrSlow) > 0 ? ta.atr(atrFast) / ta.atr(atrSlow) : 0.0
c5 = atrRatio > atrTh

// ---- score
score   = (c1 ? 1 : 0) + (c2 ? 1 : 0) + (c3 ? 1 : 0) + (c4 ? 1 : 0) + (c5 ? 1 : 0)
verdict = score >= 3 ? "TREND" : score <= 1 ? "RANGE" : "MIXED"
method  = score >= 3 ? "Sweep and continuation" : score <= 1 ? "Reversal, original" : "No clear read"
vCol    = score >= 3 ? color.new(#96660D, 0) : score <= 1 ? color.new(#2F6F62, 0) : color.new(#98A2AC, 0)

// ---- panel
var table p = table.new(position.top_right, 3, 8, border_width = 1)
bg = color.new(color.gray, 90)

f_row(_r, _lab, _val, _pass) =>
    table.cell(p, 0, _r, _lab,  text_size = size.small, text_halign = text.align_left,  bgcolor = bg, text_color = color.gray)
    table.cell(p, 1, _r, _val,  text_size = size.small, text_halign = text.align_right, bgcolor = bg, text_color = color.gray)
    table.cell(p, 2, _r, _pass ? "YES" : "no", text_size = size.small, bgcolor = bg, text_color = _pass ? #96660D : color.gray)

if barstate.islast
    table.cell(p, 0, 0, syminfo.ticker + "  " + verdict, text_size = size.normal, text_color = color.white, bgcolor = vCol)
    table.cell(p, 1, 0, str.tostring(score) + "/5",      text_size = size.normal, text_color = color.white, bgcolor = vCol)
    table.cell(p, 2, 0, "", bgcolor = vCol)
    f_row(1, "ADX",             str.tostring(adxVal, "#.0"), c1)
    f_row(2, "Efficiency",      str.tostring(effRatio, "#.00"), c2)
    f_row(3, "Closes vs EMA",   str.tostring(sameSide) + "/" + str.tostring(emaLook), c3)
    f_row(4, "Sweep reversion", na(revRate) ? "n/a" : str.tostring(revRate * 100, "#") + "% (" + str.tostring(breaks) + ")", c4)
    f_row(5, "ATR ratio",       str.tostring(atrRatio, "#.00"), c5)
    table.cell(p, 0, 6, "Method", text_size = size.small, text_halign = text.align_left, bgcolor = bg, text_color = color.gray)
    table.cell(p, 1, 6, method,   text_size = size.small, text_halign = text.align_right, bgcolor = bg, text_color = vCol)
    table.cell(p, 2, 6, "", bgcolor = bg)
    if not timeframe.isdaily
        table.cell(p, 0, 7, "NOT DAILY CHART", text_size = size.small, text_color = color.white, bgcolor = color.new(#A32E2E, 0))
        table.cell(p, 1, 7, "", bgcolor = color.new(#A32E2E, 0))
        table.cell(p, 2, 7, "", bgcolor = color.new(#A32E2E, 0))

plot(emaVal, "50 EMA", color = color.new(color.gray, 40))