//@version=6
indicator("Custom Session Price Lines (GMT+8)", overlay=true)

// Timezone input set to GMT+8 by default
tzInput = input.string("GMT+8", title="Timezone", tooltip="Using GMT+8 for calculations. Adjust if necessary.")

// Helper function to check if the current candle matches a specific hour and minute
isTime(h, m, tz) =>
    hour(time, tz) == h and minute(time, tz) == m

// Persistent variables to store candle indices and prices
var int open0604Index = na
var float open0604Price = na

// --- 1. White Line Logic (06:00 Open to 19:59) ---
if isTime(6, 04, tzInput)
    open0604Index := bar_index
    open0604Price := open

// Check if we are past 06:00 but haven't exceeded 19:59
isInWhiteSession = (hour(time, tzInput) > 6 or (hour(time, tzInput) == 6 and minute(time, tzInput) >= 0)) and 
                   (hour(time, tzInput) < 19 or (hour(time, tzInput) == 19 and minute(time, tzInput) <= 59))

// Dynamically draw/update the white line as the day progresses
var line whiteLine = na
if isInWhiteSession and not na(open0604Index)
    if na(whiteLine) or line.get_x1(whiteLine) != open0604Index
        whiteLine := line.new(x1=open0604Index, y1=open0604Price, x2=bar_index, y2=open0604Price, 
                              xloc=xloc.bar_index, color=color.white, style=line.style_dashed, width=1)
    else
        line.set_x2(whiteLine, bar_index)

// --- 2. Orange Line Logic (06:00 to 16:59 Close) ---
if isTime(16, 59, tzInput) and not na(open0604Index)
    // Draw backwards from 16:59 bar back to the 06:00 bar index
    line.new(x1=open0604Index, y1=close, x2=bar_index, y2=close, 
             xloc=xloc.bar_index, color=color.orange, style=line.style_dashed, width=1)

// --- 3. Blue Line Logic (17:00 to 19:59 Close) ---
var int open1700Index = na
if isTime(17, 0, tzInput)
    open1700Index := bar_index

if isTime(19, 59, tzInput) and not na(open1700Index)
    // Draw backwards from 19:59 bar back to the 17:00 bar index
    line.new(x1=open1700Index, y1=close, x2=bar_index, y2=close, 
             xloc=xloc.bar_index, color=color.blue, style=line.style_dashed, width=1)
