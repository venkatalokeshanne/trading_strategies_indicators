//@version=6
indicator("5-6 PM Chicago Gold Model", overlay=true, max_lines_count=100, max_labels_count=50, max_boxes_count=250)

historicalDays = input.int(3, "Historical Days", minval=1, maxval=5, group="Range")
highlightRange = input.bool(false, "Highlight Range", group="Range")
rangeColor = input.color(color.blue, "Highlight Color", group="Range")
rangeTransparency = input.int(88, "Highlight Transparency", minval=0, maxval=100, group="Range")
showLabels = input.bool(true, "Show Labels", group="Range")

showHigh = input.bool(true, "Show HIGH", group="HIGH")
highColor = input.color(color.lime, "Color", group="HIGH")
highWidth = input.int(2, "Width", minval=1, maxval=4, group="HIGH")
highStyle = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], group="HIGH")
extendHigh = input.bool(true, "Extend Right", group="HIGH")

showLow = input.bool(true, "Show LOW", group="LOW")
lowColor = input.color(color.red, "Color", group="LOW")
lowWidth = input.int(2, "Width", minval=1, maxval=4, group="LOW")
lowStyle = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], group="LOW")
extendLow = input.bool(true, "Extend Right", group="LOW")

showEq = input.bool(true, "Show EQ", group="EQ")
eqColor = input.color(color.yellow, "Color", group="EQ")
eqWidth = input.int(1, "Width", minval=1, maxval=4, group="EQ")
eqStyle = input.string("Dashed", "Style", options=["Solid", "Dashed", "Dotted"], group="EQ")
extendEq = input.bool(true, "Extend Right", group="EQ")

show25 = input.bool(true, "Show 25%", group="25% / 75%")
color25 = input.color(color.gray, "25% Color", group="25% / 75%")
width25 = input.int(1, "25% Width", minval=1, maxval=4, group="25% / 75%")
style25 = input.string("Dotted", "25% Style", options=["Solid", "Dashed", "Dotted"], group="25% / 75%")
extend25 = input.bool(true, "Extend 25% Right", group="25% / 75%")

show75 = input.bool(true, "Show 75%", group="25% / 75%")
color75 = input.color(color.gray, "75% Color", group="25% / 75%")
width75 = input.int(1, "75% Width", minval=1, maxval=4, group="25% / 75%")
style75 = input.string("Dotted", "75% Style", options=["Solid", "Dashed", "Dotted"], group="25% / 75%")
extend75 = input.bool(true, "Extend 75% Right", group="25% / 75%")

enableFvg = input.bool(true, "Enable Bullish FVGs", group="Fair Value Gaps")
fvgTimeframe = input.string("Both", "FVG Timeframe", options=["5 Minute", "15 Minute", "Both"], group="Fair Value Gaps")
bullFvgColor = input.color(color.teal, "Bullish FVG Color", group="Fair Value Gaps")
fvgTransparency = input.int(82, "Transparency", minval=0, maxval=100, group="Fair Value Gaps")

enableIfvg = input.bool(true, "Enable Bearish IFVGs", group="Inverse FVGs")
ifvgTimeframe = input.string("Both", "IFVG Timeframe", options=["5 Minute", "15 Minute", "Both"], group="Inverse FVGs")
bearIfvgColor = input.color(color.orange, "Bearish IFVG Color", group="Inverse FVGs")
ifvgTransparency = input.int(78, "Transparency", minval=0, maxval=100, group="Inverse FVGs")

enableOb = input.bool(true, "Enable Order Blocks", group="Order Blocks")
obTimeframe = input.string("Both", "Order Block Timeframe", options=["5 Minute", "15 Minute", "Both"], group="Order Blocks")
bullObColor = input.color(color.green, "Bullish OB Color", group="Order Blocks")
bearObColor = input.color(color.red, "Bearish OB Color", group="Order Blocks")
obTransparency = input.int(86, "Transparency", minval=0, maxval=100, group="Order Blocks")

nearbyOnly = input.bool(false, "Show Only Nearby Confluences", group="Confluence")
confluenceDistance = input.float(40.0, "Confluence Distance", minval=0.0, step=0.01, group="Confluence")

type RangeObject
    float hi
    float lo
    float eq
    line hiLine
    line loLine
    line eqLine
    line line25
    line line75
    label hiLabel
    label loLabel
    label eqLabel
    box fillBox

type ZoneObject
    box zoneBox
    float top
    float bottom
    int direction
    int zoneType
    int sourceTf

var ranges = array.new<RangeObject>()
var fvgs = array.new<ZoneObject>()
var ifvgs = array.new<ZoneObject>()
var obs = array.new<ZoneObject>()

f_style(string styleName) =>
    styleName == "Dashed" ? line.style_dashed : styleName == "Dotted" ? line.style_dotted : line.style_solid

f_tfAllowed(int sourceTf, string selectedTf) =>
    selectedTf == "Both" or selectedTf == "5 Minute" and sourceTf == 5 or selectedTf == "15 Minute" and sourceTf == 15

f_deleteRange(RangeObject r) =>
    line.delete(r.hiLine)
    line.delete(r.loLine)
    line.delete(r.eqLine)
    line.delete(r.line25)
    line.delete(r.line75)
    label.delete(r.hiLabel)
    label.delete(r.loLabel)
    label.delete(r.eqLabel)
    box.delete(r.fillBox)

f_deleteZone(ZoneObject z) =>
    box.delete(z.zoneBox)

f_isNearRange(float top, float bottom) =>
    bool result = false
    int count = array.size(ranges)
    if count > 0
        for i = 0 to count - 1
            RangeObject r = array.get(ranges, i)
            bool nearHi = bottom <= r.hi + confluenceDistance and top >= r.hi - confluenceDistance
            bool nearLo = bottom <= r.lo + confluenceDistance and top >= r.lo - confluenceDistance
            bool nearEq = bottom <= r.eq + confluenceDistance and top >= r.eq - confluenceDistance
            result := result or nearHi or nearLo or nearEq
    result

f_zoneVisible(ZoneObject z) =>
    bool enabled = z.zoneType == 1 ? enableFvg and f_tfAllowed(z.sourceTf, fvgTimeframe) : z.zoneType == 2 ? enableIfvg and f_tfAllowed(z.sourceTf, ifvgTimeframe) : enableOb and f_tfAllowed(z.sourceTf, obTimeframe)
    enabled and (not nearbyOnly or f_isNearRange(z.top, z.bottom))

f_styleZone(ZoneObject z) =>
    color zoneColor = z.zoneType == 1 ? bullFvgColor : z.zoneType == 2 ? bearIfvgColor : z.direction == 1 ? bullObColor : bearObColor
    int opacity = z.zoneType == 1 ? fvgTransparency : z.zoneType == 2 ? ifvgTransparency : obTransparency
    bool visible = f_zoneVisible(z)
    box.set_bgcolor(z.zoneBox, visible ? color.new(zoneColor, opacity) : color.new(zoneColor, 100))
    box.set_border_color(z.zoneBox, visible ? color.new(zoneColor, 10) : color.new(zoneColor, 100))
    box.set_extend(z.zoneBox, extend.right)

f_addZone(array<ZoneObject> storage, float top, float bottom, int direction, int zoneType, int sourceTf, int eventTime, int limit) =>
    if not na(top) and not na(bottom) and top > bottom
        box newBox = box.new(left=eventTime, top=top, right=eventTime, bottom=bottom, xloc=xloc.bar_time, extend=extend.right, border_width=1)
        ZoneObject newZone = ZoneObject.new(newBox, top, bottom, direction, zoneType, sourceTf)
        array.push(storage, newZone)
        f_styleZone(newZone)
        while array.size(storage) > limit
            ZoneObject oldZone = array.shift(storage)
            f_deleteZone(oldZone)

f_updateZones(float currentHigh, float currentLow, int eventTime) =>
    int fvgCount = array.size(fvgs)
    if fvgCount > 0
        for i = fvgCount - 1 to 0
            ZoneObject z = array.get(fvgs, i)
            if currentLow <= z.bottom
                f_deleteZone(z)
                array.remove(fvgs, i)
                if enableIfvg and f_tfAllowed(z.sourceTf, ifvgTimeframe)
                    f_addZone(ifvgs, z.top, z.bottom, -1, 2, z.sourceTf, eventTime, 60)

    int ifvgCount = array.size(ifvgs)
    if ifvgCount > 0
        for i = ifvgCount - 1 to 0
            ZoneObject z = array.get(ifvgs, i)
            if currentHigh >= z.top
                f_deleteZone(z)
                array.remove(ifvgs, i)

    int obCount = array.size(obs)
    if obCount > 0
        for i = obCount - 1 to 0
            ZoneObject z = array.get(obs, i)
            bool swept = z.direction == 1 ? currentLow <= z.bottom : currentHigh >= z.top
            if swept
                f_deleteZone(z)
                array.remove(obs, i)

f_addRange(float rangeHigh, float rangeLow, int startTime, int endTime) =>
    float eqValue = (rangeHigh + rangeLow) * 0.5
    float value25 = rangeLow + (rangeHigh - rangeLow) * 0.25
    float value75 = rangeLow + (rangeHigh - rangeLow) * 0.75
    line hiLine = line.new(startTime, rangeHigh, endTime, rangeHigh, xloc=xloc.bar_time, color=showHigh ? highColor : na, width=highWidth, style=f_style(highStyle), extend=extendHigh ? extend.right : extend.none)
    line loLine = line.new(startTime, rangeLow, endTime, rangeLow, xloc=xloc.bar_time, color=showLow ? lowColor : na, width=lowWidth, style=f_style(lowStyle), extend=extendLow ? extend.right : extend.none)
    line eqLine = line.new(startTime, eqValue, endTime, eqValue, xloc=xloc.bar_time, color=showEq ? eqColor : na, width=eqWidth, style=f_style(eqStyle), extend=extendEq ? extend.right : extend.none)
    line line25 = line.new(startTime, value25, endTime, value25, xloc=xloc.bar_time, color=show25 ? color25 : na, width=width25, style=f_style(style25), extend=extend25 ? extend.right : extend.none)
    line line75 = line.new(startTime, value75, endTime, value75, xloc=xloc.bar_time, color=show75 ? color75 : na, width=width75, style=f_style(style75), extend=extend75 ? extend.right : extend.none)
    label hiLabel = label.new(endTime, rangeHigh, "HIGH", xloc=xloc.bar_time, style=label.style_none, textcolor=showLabels and showHigh ? highColor : na, size=size.small)
    label loLabel = label.new(endTime, rangeLow, "LOW", xloc=xloc.bar_time, style=label.style_none, textcolor=showLabels and showLow ? lowColor : na, size=size.small)
    label eqLabel = label.new(endTime, eqValue, "EQ", xloc=xloc.bar_time, style=label.style_none, textcolor=showLabels and showEq ? eqColor : na, size=size.small)
    box fillBox = box.new(left=startTime, top=rangeHigh, right=endTime, bottom=rangeLow, xloc=xloc.bar_time, border_width=0, bgcolor=highlightRange ? color.new(rangeColor, rangeTransparency) : color.new(rangeColor, 100))
    RangeObject newRange = RangeObject.new(rangeHigh, rangeLow, eqValue, hiLine, loLine, eqLine, line25, line75, hiLabel, loLabel, eqLabel, fillBox)
    array.push(ranges, newRange)
    while array.size(ranges) > historicalDays
        RangeObject oldRange = array.shift(ranges)
        f_deleteRange(oldRange)

f_processPattern(bool bullFvg, bool bullOb, bool bearOb, float fvgTop, float fvgBottom, float obTop, float obBottom, int sourceTf, int eventTime) =>
    if enableFvg and bullFvg and f_tfAllowed(sourceTf, fvgTimeframe)
        f_addZone(fvgs, fvgTop, fvgBottom, 1, 1, sourceTf, eventTime, 60)
    if enableOb and bullOb and f_tfAllowed(sourceTf, obTimeframe)
        f_addZone(obs, obTop, obBottom, 1, 3, sourceTf, eventTime, 40)
    if enableOb and bearOb and f_tfAllowed(sourceTf, obTimeframe)
        f_addZone(obs, obTop, obBottom, -1, 3, sourceTf, eventTime, 40)

inChicagoRange = not na(time(timeframe.period, "1700-1800:1234567", "America/Chicago"))
rangeFinished = not inChicagoRange and inChicagoRange[1]

var float buildingHigh = na
var float buildingLow = na
var int buildingStart = na

if barstate.isconfirmed
    if inChicagoRange
        if not inChicagoRange[1]
            buildingHigh := high
            buildingLow := low
            buildingStart := time
        else
            buildingHigh := math.max(buildingHigh, high)
            buildingLow := math.min(buildingLow, low)
    if rangeFinished and not na(buildingHigh)
        f_addRange(buildingHigh, buildingLow, buildingStart, time_close[1])
        buildingHigh := na
        buildingLow := na
        buildingStart := na

bullFvg = high[2] < low
strongBull = close > open and close - open > high[1] - low[1]
strongBear = close < open and open - close > high[1] - low[1]
bullOb = strongBull and close[1] < open[1]
bearOb = strongBear and close[1] > open[1]

chartSeconds = timeframe.in_seconds()

if chartSeconds == 300 and barstate.isconfirmed
    f_updateZones(high, low, time)
    f_processPattern(bullFvg, bullOb, bearOb, low, high[2], high[1], low[1], 5, time)

if chartSeconds == 900 and barstate.isconfirmed
    f_updateZones(high, low, time)
    f_processPattern(bullFvg, bullOb, bearOb, low, high[2], high[1], low[1], 15, time)

if chartSeconds == 300
    [bull15, bullOb15, bearOb15, fvgTop15, fvgBottom15, obTop15, obBottom15, time15] = request.security(syminfo.tickerid, "15", [high[2] < low, close > open and close - open > high[1] - low[1] and close[1] < open[1], close < open and open - close > high[1] - low[1] and close[1] > open[1], low, high[2], high[1], low[1], time], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
    if not na(time15)
        f_processPattern(bull15, bullOb15, bearOb15, fvgTop15, fvgBottom15, obTop15, obBottom15, 15, time15)

if barstate.islast
    int rangeCount = array.size(ranges)
    if rangeCount > 0
        for i = 0 to rangeCount - 1
            RangeObject r = array.get(ranges, i)
            line.set_color(r.hiLine, showHigh ? highColor : na)
            line.set_width(r.hiLine, highWidth)
            line.set_style(r.hiLine, f_style(highStyle))
            line.set_extend(r.hiLine, extendHigh ? extend.right : extend.none)
            line.set_color(r.loLine, showLow ? lowColor : na)
            line.set_width(r.loLine, lowWidth)
            line.set_style(r.loLine, f_style(lowStyle))
            line.set_extend(r.loLine, extendLow ? extend.right : extend.none)
            line.set_color(r.eqLine, showEq ? eqColor : na)
            line.set_width(r.eqLine, eqWidth)
            line.set_style(r.eqLine, f_style(eqStyle))
            line.set_extend(r.eqLine, extendEq ? extend.right : extend.none)
            line.set_color(r.line25, show25 ? color25 : na)
            line.set_width(r.line25, width25)
            line.set_style(r.line25, f_style(style25))
            line.set_extend(r.line25, extend25 ? extend.right : extend.none)
            line.set_color(r.line75, show75 ? color75 : na)
            line.set_width(r.line75, width75)
            line.set_style(r.line75, f_style(style75))
            line.set_extend(r.line75, extend75 ? extend.right : extend.none)
            label.set_textcolor(r.hiLabel, showLabels and showHigh ? highColor : na)
            label.set_textcolor(r.loLabel, showLabels and showLow ? lowColor : na)
            label.set_textcolor(r.eqLabel, showLabels and showEq ? eqColor : na)
            box.set_bgcolor(r.fillBox, highlightRange ? color.new(rangeColor, rangeTransparency) : color.new(rangeColor, 100))

    int fvgCount = array.size(fvgs)
    if fvgCount > 0
        for i = 0 to fvgCount - 1
            f_styleZone(array.get(fvgs, i))

    int ifvgCount = array.size(ifvgs)
    if ifvgCount > 0
        for i = 0 to ifvgCount - 1
            f_styleZone(array.get(ifvgs, i))

    int obCount = array.size(obs)
    if obCount > 0
        for i = 0 to obCount - 1
            f_styleZone(array.get(obs, i))