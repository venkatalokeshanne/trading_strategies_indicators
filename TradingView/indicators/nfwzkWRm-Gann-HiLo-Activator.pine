//@version=6
indicator(title="Gann HiLo Activator", shorttitle="HiLo Activator", overlay=true)

// ─────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────
HILO = input.int(3, "Length", step=1, minval=1, group="Gann HiLo Activator")
mode = input.string("End of Day", "Mode", options=["End of Day", "Real Time"], group="Gann HiLo Activator")
plot_offset = mode == "End of Day" ? 1 : 0

// ─────────────────────────────────────────────
// HiLo calculation
// ─────────────────────────────────────────────
var float hl = na

hi = ta.sma(high, HILO)
lo = ta.sma(low, HILO)

hl := close > hi ? 1 : close < lo ? -1 : hl[1]
ghla = hl == -1 ? hi : lo

// ─────────────────────────────────────────────
// Plot
// ─────────────────────────────────────────────
plot(hl > 0 ? ghla : na, color=color.new(color.green, 25), style=plot.style_steplinebr, offset=plot_offset, title="HiLo (Up)")
plot(hl < 0 ? ghla : na, color=color.new(color.red, 25), style=plot.style_steplinebr, offset=plot_offset, title="HiLo (Down)")
