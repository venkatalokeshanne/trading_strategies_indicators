//@version=6
strategy("EMA Cross Optimized", overlay=true)

// === INPUTS ===
fastLength = input.int(9, title="Fast EMA")
slowLength = input.int(21, title="Slow EMA")

// === EMAs ===
emaFast = ta.ema(close, fastLength)
emaSlow = ta.ema(close, slowLength)

// === Cross Conditions ===
bullCross = ta.crossover(emaFast, emaSlow)
bearCross = ta.crossunder(emaFast, emaSlow)

// === Stop Loss (based on crossover candle) ===
longStop = low
shortStop = high

// === Entries ===
if (bullCross)
    strategy.entry("Long", strategy.long)
    strategy.exit("Long SL", from_entry="Long", stop=longStop)

if (bearCross)
    strategy.entry("Short", strategy.short)
    strategy.exit("Short SL", from_entry="Short", stop=shortStop)

// === Exit Logic (maximize profits) ===
// Option 1: Fast EMA crosses back
exitLong = ta.crossunder(emaFast, emaSlow)
exitShort = ta.crossover(emaFast, emaSlow)

// Option 2: Slow EMA turns (backup exit)
emaTurningDown = emaSlow < emaSlow[1]
emaTurningUp = emaSlow > emaSlow[1]

if (strategy.position_size > 0 and (exitLong or emaTurningDown))
    strategy.close("Long")

if (strategy.position_size < 0 and (exitShort or emaTurningUp))
    strategy.close("Short")

// === Plot ===
plot(emaFast, color=color.blue, linewidth=2, title="Fast EMA")
plot(emaSlow, color=color.orange, linewidth=2, title="Slow EMA")

// Mark entries
plotshape(bullCross, location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small)
plotshape(bearCross, location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small)