//@version=6
indicator("Dashboard Tendance Multi-UT (2 EMA)", overlay=true)

// ==========================================
// PARAMÈTRES D'ENTRÉE (INPUTS)
// ==========================================

// Paramètres des EMA
group_ema = "Paramètres des EMA"
lenFast   = input.int(20, title="Période EMA Court Terme", minval=1, group=group_ema)
lenSlow   = input.int(50, title="Période EMA Long Terme", minval=1, group=group_ema)
showEma   = input.bool(true, title="Afficher les EMA sur le graphique", group=group_ema)
colFast   = input.color(color.green, title="Couleur EMA Court Terme", group=group_ema)
colSlow   = input.color(color.red, title="Couleur EMA Long Terme", group=group_ema)

// Paramètres du Dashboard (Tableau)
group_dash = "Personnalisation du Dashboard"
posString  = input.string("Haut Droit", title="Position du Dashboard", 
             options=["Haut Droit", "Bas Droit", "Haut Gauche", "Bas Gauche", "Centre Haut", "Centre Bas"], group=group_dash)
bgHeader   = input.color(color.rgb(30, 34, 45), title="Couleur Entête", group=group_dash)
textColor  = input.color(color.white, title="Couleur du Texte", group=group_dash)

// ==========================================
// CALCUL DES EMA SUR L'UT COURANTE (POUR TRAÇAGE)
// ==========================================

emaFastCurrent = ta.ema(close, lenFast)
emaSlowCurrent = ta.ema(close, lenSlow)

plot(showEma ? emaFastCurrent : na, title="EMA Court Terme", color=colFast, linewidth=2)
plot(showEma ? emaSlowCurrent : na, title="EMA Long Terme", color=colSlow, linewidth=2)

// ==========================================
// FONCTIONS DE DÉTERMINATION DE LA TENDANCE
// ==========================================

// Calcul de la tendance selon la règle : 
// Prix > EMA Courte > EMA Longue = HAUSSIER
// Prix < EMA Courte < EMA Longue = BAISSIER
getTrend(price, emaF, emaS) =>
    if price > emaF and emaF > emaS
        "HAUSSIER"
    else if price < emaF and emaF < emaS
        "BAISSIER"
    else
        "NEUTRE"

getTrendColor(trend) =>
    switch trend
        "HAUSSIER" => color.rgb(38, 166, 154) // Vert
        "BAISSIER" => color.rgb(239, 83, 80)   // Rouge
        => color.rgb(120, 123, 134)             // Gris (Neutre / Consolidation)

// ==========================================
// RÉCUPÉRATION DES DONNÉES MULTI-UT
// ==========================================

// Fonction de calcul EMA globale
calcEmaFast(src) => ta.ema(src, lenFast)
calcEmaSlow(src) => ta.ema(src, lenSlow)

// Weekly (Semaine)
[close_W, emaF_W, emaS_W]   = request.security(syminfo.tickerid, "W", [close, calcEmaFast(close), calcEmaSlow(close)], barmerge.gaps_off, barmerge.lookahead_off)
trend_W                     = getTrend(close_W, emaF_W, emaS_W)

// Daily (Jour)
[close_D, emaF_D, emaS_D]   = request.security(syminfo.tickerid, "D", [close, calcEmaFast(close), calcEmaSlow(close)], barmerge.gaps_off, barmerge.lookahead_off)
trend_D                     = getTrend(close_D, emaF_D, emaS_D)

// H4 (4 Heures)
[close_H4, emaF_H4, emaS_H4] = request.security(syminfo.tickerid, "240", [close, calcEmaFast(close), calcEmaSlow(close)], barmerge.gaps_off, barmerge.lookahead_off)
trend_H4                    = getTrend(close_H4, emaF_H4, emaS_H4)

// ==========================================
// CONSTRACTION DU DASHBOARD (TABLE)
// ==========================================

// Mappage de la position
tablePos = switch posString
    "Haut Droit"   => position.top_right
    "Bas Droit"    => position.bottom_right
    "Haut Gauche"  => position.top_left
    "Bas Gauche"   => position.bottom_left
    "Centre Haut"  => position.top_center
    "Centre Bas"   => position.bottom_center
    => position.top_right

// Création de la table uniquement sur la dernière bougie
var table dash = table.new(position=tablePos, columns=2, rows=4, bgcolor=color.black, border_width=1, border_color=color.gray)

if barstate.islast
    // Entête du Tableau
    table.cell(dash, 0, 0, "UT", bgcolor=bgHeader, text_color=textColor, text_size=size.small)
    table.cell(dash, 1, 0, "TENDANCE", bgcolor=bgHeader, text_color=textColor, text_size=size.small)

    // Ligne Weekly
    table.cell(dash, 0, 1, "Weekly", bgcolor=color.rgb(42, 46, 57), text_color=textColor, text_size=size.small)
    table.cell(dash, 1, 1, trend_W, bgcolor=getTrendColor(trend_W), text_color=color.white, text_size=size.small)

    // Ligne Daily
    table.cell(dash, 0, 2, "Daily", bgcolor=color.rgb(42, 46, 57), text_color=textColor, text_size=size.small)
    table.cell(dash, 1, 2, trend_D, bgcolor=getTrendColor(trend_D), text_color=color.white, text_size=size.small)

    // Ligne H4
    table.cell(dash, 0, 3, "H4", bgcolor=color.rgb(42, 46, 57), text_color=textColor, text_size=size.small)
    table.cell(dash, 1, 3, trend_H4, bgcolor=getTrendColor(trend_H4), text_color=color.white, text_size=size.small)