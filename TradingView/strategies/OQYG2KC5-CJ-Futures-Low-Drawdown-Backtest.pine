//@version=5
strategy("CJ Futures Low-Drawdown Backtest", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=0.5)

// Inputs
emaLength = input.int(50, "EMA Length")
trendTf = input.timeframe("240", "Trend Timeframe")
setupTf = input.timeframe("60", "Setup Timeframe")
rr = input.float(2.0, "Risk Reward", step=0.1)
swingLookback = input.int(5, "Swing Lookback", minval=1)
useVolumeFilter = input.bool(true, "Use Volume Filter")
volumeLength = input.int(20, "Volume SMA Length")
sessionInput = input.session("0830-1130", "Main Session")

// Current timeframe EMA
ema = ta.ema(close, emaLength)
plot(ema, color=color.orange, title="EMA 50")

// Higher timeframe filters
trendClose = request.security(syminfo.tickerid, trendTf, close)
trendEma = request.security(syminfo.tickerid, trendTf, ta.ema(close, emaLength))

setupClose = request.security(syminfo.tickerid, setupTf, close)
setupEma = request.security(syminfo.tickerid, setupTf, ta.ema(close, emaLength))

bullTrend = trendClose > trendEma and setupClose > setupEma
bearTrend = trendClose < trendEma and setupClose < setupEma

// Session filter
inSession = not na(time(timeframe.period, sessionInput))

// Volume filter
volSma = ta.sma(volume, volumeLength)
goodVolume = not useVolumeFilter or volume > volSma

// Pullback + trigger
pullbackBuy = low <= ema and bullTrend
pullbackSell = high >= ema and bearTrend

bullConfirm = close > open and close > high[1]
bearConfirm = close < open and close < low[1]

buySignal = inSession and goodVolume and pullbackBuy and bullConfirm
sellSignal = inSession and goodVolume and pullbackSell and bearConfirm

// Stops and targets
buySL = ta.lowest(low, swingLookback)
sellSL = ta.highest(high, swingLookback)

buyRisk = close - buySL
sellRisk = sellSL - close

buyTP = close + (buyRisk * rr)
sellTP = close - (sellRisk * rr)

// Entries
if buySignal and buyRisk > 0 and strategy.position_size <= 0
    strategy.entry("Buy", strategy.long)
    strategy.exit("Buy Exit", from_entry="Buy", stop=buySL, limit=buyTP)

if sellSignal and sellRisk > 0 and strategy.position_size >= 0
    strategy.entry("Sell", strategy.short)
    strategy.exit("Sell Exit", from_entry="Sell", stop=sellSL, limit=sellTP)

// Visuals
plotshape(buySignal, title="Buy Signal", text="BUY", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, size=size.small)
plotshape(sellSignal, title="Sell Signal", text="SELL", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.small)
