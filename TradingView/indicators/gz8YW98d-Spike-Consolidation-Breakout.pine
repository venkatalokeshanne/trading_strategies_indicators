//@version=6
indicator("Spike Consolidation Breakout V3.4 Diagnostic", shorttitle="SpikeBreak", overlay=true)

// =====================================================
// SETTINGS
// =====================================================

spikeMinPct = input.float(8.0, "Minimum Spike %", minval=1.0, step=0.5)
spikeLookback = input.int(10, "Spike Lookback", minval=2, maxval=20)

minConsolidation = input.int(2, "Minimum Consolidation Days", minval=2, maxval=10)
maxConsolidation = input.int(10, "Maximum Consolidation Days", minval=3, maxval=10)

maxRangePct = input.float(7.0, "Maximum Consolidation Range %", minval=1.0, step=0.5)

maLength = input.int(9, "Moving Average Length", minval=3, maxval=30)
maxAboveMA = input.float(4.0, "Maximum % Above 9-Day MA", minval=0.5, step=0.25)

breakoutBuffer = input.float(0.25, "Breakout Confirmation %", minval=0.0, step=0.05)

volumeLength = input.int(20, "Average Volume Length", minval=5, maxval=50)
maxRelativeVolume = input.float(1.25, "Maximum Relative Volume", minval=0.5, step=0.05)

atrLength = input.int(14, "ATR Length", minval=5, maxval=30)
stopATR = input.float(1.5, "ATR Stop Multiplier", minval=0.5, step=0.25)

target1RR = input.float(2.0, "Target 1 Risk/Reward", minval=1.0, step=0.25)
target2RR = input.float(3.0, "Target 2 Risk/Reward", minval=1.0, step=0.25)

minimumScore = input.float(75.0, "Minimum READY Score", minval=0, maxval=100, step=1)

showDiagnostics = input.bool(true, "Show Diagnostic Panel")
showTradeLevels = input.bool(true, "Show Trade Levels")

// =====================================================
// CORE INDICATORS
// =====================================================

ma9 = ta.sma(close, maLength)
atr = ta.atr(atrLength)
avgVolume = ta.sma(volume, volumeLength)

maRising = ma9 > ma9[3]

distanceAboveMA = ((close / ma9) - 1.0) * 100.0

priceAboveMA = close >= ma9
priceNearMA = priceAboveMA and distanceAboveMA <= maxAboveMA

// =====================================================
// SPIKE
// =====================================================

spikeLow = ta.lowest(close, spikeLookback)
spikeHigh = ta.highest(close, spikeLookback)

spikePct = ((spikeHigh / spikeLow) - 1.0) * 100.0

// No maximum spike percentage.
// Any spike >= the minimum qualifies.
spikePass = spikePct >= spikeMinPct

// =====================================================
// CONSOLIDATION WINDOWS
// =====================================================

high2 = ta.highest(high, 2)
low2 = ta.lowest(low, 2)
range2 = ((high2 - low2) / low2) * 100.0

high3 = ta.highest(high, 3)
low3 = ta.lowest(low, 3)
range3 = ((high3 - low3) / low3) * 100.0

high4 = ta.highest(high, 4)
low4 = ta.lowest(low, 4)
range4 = ((high4 - low4) / low4) * 100.0

high5 = ta.highest(high, 5)
low5 = ta.lowest(low, 5)
range5 = ((high5 - low5) / low5) * 100.0

high6 = ta.highest(high, 6)
low6 = ta.lowest(low, 6)
range6 = ((high6 - low6) / low6) * 100.0

high7 = ta.highest(high, 7)
low7 = ta.lowest(low, 7)
range7 = ((high7 - low7) / low7) * 100.0

high8 = ta.highest(high, 8)
low8 = ta.lowest(low, 8)
range8 = ((high8 - low8) / low8) * 100.0

high9 = ta.highest(high, 9)
low9 = ta.lowest(low, 9)
range9 = ((high9 - low9) / low9) * 100.0

high10 = ta.highest(high, 10)
low10 = ta.lowest(low, 10)
range10 = ((high10 - low10) / low10) * 100.0

// =====================================================
// SELECT CONSOLIDATION
// =====================================================

float consolidationHigh = na
float consolidationLow = na
float consolidationRange = na
int consolidationDays = 0

if minConsolidation <= 2 and maxConsolidation >= 2 and range2 <= maxRangePct
    consolidationHigh := high2
    consolidationLow := low2
    consolidationRange := range2
    consolidationDays := 2

if minConsolidation <= 3 and maxConsolidation >= 3 and range3 <= maxRangePct
    consolidationHigh := high3
    consolidationLow := low3
    consolidationRange := range3
    consolidationDays := 3

if minConsolidation <= 4 and maxConsolidation >= 4 and range4 <= maxRangePct
    consolidationHigh := high4
    consolidationLow := low4
    consolidationRange := range4
    consolidationDays := 4

if minConsolidation <= 5 and maxConsolidation >= 5 and range5 <= maxRangePct
    consolidationHigh := high5
    consolidationLow := low5
    consolidationRange := range5
    consolidationDays := 5

if minConsolidation <= 6 and maxConsolidation >= 6 and range6 <= maxRangePct
    consolidationHigh := high6
    consolidationLow := low6
    consolidationRange := range6
    consolidationDays := 6

if minConsolidation <= 7 and maxConsolidation >= 7 and range7 <= maxRangePct
    consolidationHigh := high7
    consolidationLow := low7
    consolidationRange := range7
    consolidationDays := 7

if minConsolidation <= 8 and maxConsolidation >= 8 and range8 <= maxRangePct
    consolidationHigh := high8
    consolidationLow := low8
    consolidationRange := range8
    consolidationDays := 8

if minConsolidation <= 9 and maxConsolidation >= 9 and range9 <= maxRangePct
    consolidationHigh := high9
    consolidationLow := low9
    consolidationRange := range9
    consolidationDays := 9

if minConsolidation <= 10 and maxConsolidation >= 10 and range10 <= maxRangePct
    consolidationHigh := high10
    consolidationLow := low10
    consolidationRange := range10
    consolidationDays := 10

consolidationPass = consolidationDays > 0

// =====================================================
// VOLUME
// =====================================================

consolidationVolume = ta.sma(volume, maxConsolidation)

relativeVolume = avgVolume > 0 ? consolidationVolume / avgVolume : na

volumePass = not na(relativeVolume) and relativeVolume <= maxRelativeVolume

// =====================================================
// PRICE LOCATION
// =====================================================

nearHighPass = false
supportPass = false

if consolidationPass
    nearHighPass := close >= consolidationHigh * 0.95 and close <= consolidationHigh
    supportPass := close >= consolidationLow * 0.98

// =====================================================
// SPIKE RETENTION
// =====================================================

spikeRange = spikeHigh - spikeLow

retentionLevel = spikeLow + spikeRange * 0.40

retentionPass = close >= retentionLevel

// =====================================================
// SCORE
// =====================================================

float score = 0.0

// Spike score
if spikePass
    score += 15

if spikePct >= 12
    score += 5

if spikePct >= 18
    score += 5

if spikePct >= 25
    score += 5

// Consolidation score
if consolidationPass
    score += 10

if consolidationRange <= 5
    score += 10

if consolidationRange <= 3
    score += 5

// Moving average score
if maRising
    score += 10

if distanceAboveMA >= 0 and distanceAboveMA <= 2
    score += 10
else if priceNearMA
    score += 5

// Volume score
if volumePass
    score += 5

// Spike retention score
if retentionPass
    score += 10

// Near high score
if nearHighPass
    score += 5

patternScore = math.min(score, 100)

// =====================================================
// FINAL STATUS
// =====================================================

allCriteriaPass =
     spikePass and
     consolidationPass and
     maRising and
     priceNearMA and
     volumePass and
     nearHighPass and
     retentionPass and
     supportPass

readySetup = allCriteriaPass and patternScore >= minimumScore

highQualitySetup = allCriteriaPass and patternScore >= 85

// =====================================================
// BREAKOUT PRICE
// =====================================================

float breakoutPrice = na

if consolidationPass
    breakoutPrice := consolidationHigh * (1.0 + breakoutBuffer / 100.0)

// =====================================================
// STOP
// =====================================================

float stopPrice = na

if consolidationPass and not na(breakoutPrice)
    atrStop = breakoutPrice - atr * stopATR
    structuralStop = consolidationLow
    stopPrice := math.max(structuralStop, atrStop)

// =====================================================
// RISK
// =====================================================

float riskPerShare = na

if not na(breakoutPrice) and not na(stopPrice)
    riskPerShare := breakoutPrice - stopPrice

// =====================================================
// TARGETS
// =====================================================

float target1 = na
float target2 = na

if not na(riskPerShare) and riskPerShare > 0
    target1 := breakoutPrice + riskPerShare * target1RR
    target2 := breakoutPrice + riskPerShare * target2RR

// =====================================================
// BREAKOUT CONFIRMATION
// =====================================================

breakoutConfirmed =
     not na(breakoutPrice) and
     close >= breakoutPrice and
     volume > avgVolume

// =====================================================
// MAIN CHART
// =====================================================

plot(
     ma9,
     title="9-Day SMA",
     color=color.orange,
     linewidth=2
)

// =====================================================
// TRADE LEVELS
// =====================================================

plot(
     showTradeLevels and readySetup ? breakoutPrice : na,
     title="Ideal Breakout",
     color=color.green,
     linewidth=2,
     style=plot.style_linebr
)

plot(
     showTradeLevels and readySetup ? stopPrice : na,
     title="Stop",
     color=color.red,
     linewidth=2,
     style=plot.style_linebr
)

plot(
     showTradeLevels and readySetup ? target1 : na,
     title="Target 1",
     color=color.blue,
     linewidth=2,
     style=plot.style_linebr
)

plot(
     showTradeLevels and readySetup ? target2 : na,
     title="Target 2",
     color=color.purple,
     linewidth=2,
     style=plot.style_linebr
)

// =====================================================
// CHART SIGNALS
// =====================================================

plotshape(
     readySetup,
     title="READY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.green,
     text="READY",
     textcolor=color.white,
     size=size.small
)

plotshape(
     highQualitySetup,
     title="HIGH QUALITY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.lime,
     text="HIGH QUALITY",
     textcolor=color.black,
     size=size.small
)

plotshape(
     breakoutConfirmed,
     title="BREAKOUT",
     style=shape.labelup,
     location=location.belowbar,
     color=color.blue,
     text="BREAKOUT",
     textcolor=color.white,
     size=size.small
)

// =====================================================
// HIGH-CONTRAST DIAGNOSTIC TABLE
// =====================================================

var table diagnostics = table.new(
     position.top_right,
     3,
     15,
     border_width=2,
     frame_width=2
)

if barstate.islast

    if showDiagnostics

        // HEADER
        table.cell(
             diagnostics, 0, 0,
             "TEST",
             bgcolor=color.rgb(35, 35, 35),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 1, 0,
             "VALUE",
             bgcolor=color.rgb(35, 35, 35),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 2, 0,
             "STATUS",
             bgcolor=color.rgb(35, 35, 35),
             text_color=color.white,
             text_size=size.normal
        )

        // PATTERN SCORE
        table.cell(
             diagnostics, 0, 1,
             "PATTERN SCORE",
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 1, 1,
             str.tostring(patternScore, "#.0"),
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 2, 1,
             patternScore >= minimumScore ? "PASS" : "FAIL",
             bgcolor=patternScore >= minimumScore ? color.green : color.red,
             text_color=color.white,
             text_size=size.normal
        )

        // SPIKE
        table.cell(
             diagnostics, 0, 2,
             "SPIKE",
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 1, 2,
             str.tostring(spikePct, "#.0") + "%",
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 2, 2,
             spikePass ? "PASS" : "FAIL",
             bgcolor=spikePass ? color.green : color.red,
             text_color=color.white,
             text_size=size.normal
        )

        // CONSOLIDATION
        table.cell(
             diagnostics, 0, 3,
             "CONSOLIDATION",
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 1, 3,
             str.tostring(consolidationDays) + " DAYS",
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 2, 3,
             consolidationPass ? "PASS" : "FAIL",
             bgcolor=consolidationPass ? color.green : color.red,
             text_color=color.white,
             text_size=size.normal
        )

        // RANGE
        table.cell(
             diagnostics, 0, 4,
             "CONSOLIDATION RANGE",
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 1, 4,
             str.tostring(consolidationRange, "#.0") + "%",
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 2, 4,
             consolidationRange <= maxRangePct ? "PASS" : "FAIL",
             bgcolor=consolidationRange <= maxRangePct ? color.green : color.red,
             text_color=color.white,
             text_size=size.normal
        )

        // 9-DAY MA
        table.cell(
             diagnostics, 0, 5,
             "9-DAY MA RISING",
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 1, 5,
             maRising ? "YES" : "NO",
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 2, 5,
             maRising ? "PASS" : "FAIL",
             bgcolor=maRising ? color.green : color.red,
             text_color=color.white,
             text_size=size.normal
        )

        // ABOVE MA
        table.cell(
             diagnostics, 0, 6,
             "ABOVE 9-DAY MA",
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 1, 6,
             str.tostring(distanceAboveMA, "#.00") + "%",
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 2, 6,
             priceNearMA ? "PASS" : "FAIL",
             bgcolor=priceNearMA ? color.green : color.red,
             text_color=color.white,
             text_size=size.normal
        )

        // RELATIVE VOLUME
        table.cell(
             diagnostics, 0, 7,
             "RELATIVE VOLUME",
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 1, 7,
             str.tostring(relativeVolume, "#.00") + "X",
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 2, 7,
             volumePass ? "PASS" : "FAIL",
             bgcolor=volumePass ? color.green : color.red,
             text_color=color.white,
             text_size=size.normal
        )

        // NEAR HIGH
        table.cell(
             diagnostics, 0, 8,
             "NEAR CONSOLIDATION HIGH",
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 1, 8,
             nearHighPass ? "YES" : "NO",
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 2, 8,
             nearHighPass ? "PASS" : "FAIL",
             bgcolor=nearHighPass ? color.green : color.red,
             text_color=color.white,
             text_size=size.normal
        )

        // SPIKE RETENTION
        table.cell(
             diagnostics, 0, 9,
             "SPIKE RETENTION",
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 1, 9,
             retentionPass ? "YES" : "NO",
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 2, 9,
             retentionPass ? "PASS" : "FAIL",
             bgcolor=retentionPass ? color.green : color.red,
             text_color=color.white,
             text_size=size.normal
        )

        // SUPPORT
        table.cell(
             diagnostics, 0, 10,
             "SUPPORT HELD",
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 1, 10,
             supportPass ? "YES" : "NO",
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 2, 10,
             supportPass ? "PASS" : "FAIL",
             bgcolor=supportPass ? color.green : color.red,
             text_color=color.white,
             text_size=size.normal
        )

        // BREAKOUT PRICE
        table.cell(
             diagnostics, 0, 11,
             "BREAKOUT PRICE",
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 1, 11,
             not na(breakoutPrice) ?
             str.tostring(breakoutPrice, "#.##") :
             "N/A",
             bgcolor=color.rgb(25, 25, 25),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 2, 11,
             breakoutConfirmed ? "CONFIRMED" : "WAIT",
             bgcolor=breakoutConfirmed ? color.green : color.orange,
             text_color=color.white,
             text_size=size.normal
        )

        // ALL CRITERIA
        table.cell(
             diagnostics, 0, 12,
             "ALL CRITERIA",
             bgcolor=color.rgb(10, 10, 10),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 1, 12,
             allCriteriaPass ? "YES" : "NO",
             bgcolor=color.rgb(10, 10, 10),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 2, 12,
             allCriteriaPass ? "PASS" : "FAIL",
             bgcolor=allCriteriaPass ? color.green : color.red,
             text_color=color.white,
             text_size=size.normal
        )

        // READY
        table.cell(
             diagnostics, 0, 13,
             "READY",
             bgcolor=color.rgb(10, 10, 10),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 1, 13,
             readySetup ? "YES" : "NO",
             bgcolor=color.rgb(10, 10, 10),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 2, 13,
             readySetup ? "READY" : "NOT READY",
             bgcolor=readySetup ? color.green : color.red,
             text_color=color.white,
             text_size=size.normal
        )

        // HIGH QUALITY
        table.cell(
             diagnostics, 0, 14,
             "HIGH QUALITY",
             bgcolor=color.rgb(10, 10, 10),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 1, 14,
             highQualitySetup ? "YES" : "NO",
             bgcolor=color.rgb(10, 10, 10),
             text_color=color.white,
             text_size=size.normal
        )

        table.cell(
             diagnostics, 2, 14,
             highQualitySetup ? "YES" : "NO",
             bgcolor=highQualitySetup ? color.green : color.red,
             text_color=color.white,
             text_size=size.normal
        )

    else
        table.clear(diagnostics, 0, 0, 2, 14)

// =====================================================
// PINE SCREENER OUTPUTS
// =====================================================

plot(patternScore, "Pattern Score", display=display.none)

plot(spikePct, "Spike %", display=display.none)

plot(consolidationDays, "Consolidation Days", display=display.none)

plot(consolidationRange, "Consolidation Range %", display=display.none)

plot(distanceAboveMA, "Distance Above 9-Day MA %", display=display.none)

plot(relativeVolume, "Relative Volume", display=display.none)

plot(readySetup ? 1 : 0, "READY", display=display.none)

plot(allCriteriaPass ? 1 : 0, "ALL Criteria Pass", display=display.none)

plot(breakoutPrice, "Ideal Breakout Price", display=display.none)

plot(stopPrice, "Stop Price", display=display.none)

plot(target1, "Target 1", display=display.none)

plot(target2, "Target 2", display=display.none)

// =====================================================
// ALERTS
// =====================================================

alertcondition(
     readySetup,
     title="READY Setup",
     message="READY setup detected on {{ticker}} at {{close}}"
)

alertcondition(
     highQualitySetup,
     title="High Quality Setup",
     message="HIGH QUALITY setup detected on {{ticker}} at {{close}}"
)

alertcondition(
     breakoutConfirmed,
     title="Breakout Confirmed",
     message="BREAKOUT confirmed on {{ticker}} at {{close}}"
)