//@version=6
indicator("3x MTF MA Zones [josseliani]", shorttitle="3x MTF MA Zones [josseliani]", overlay=true, max_bars_back=5000, max_lines_count=100)
//====================================================
// GENERAL
//====================================================
groupGeneral = "General"
useConfirmedHTF = input.bool(
     true,
     "Use Confirmed HTF Values",
     tooltip="When a higher timeframe is selected, uses the last completed higher-timeframe MA value. This keeps the HTF line stable until the next higher-timeframe bar is confirmed.",
     group=groupGeneral)
//====================================================
// MA FUNCTIONS
//====================================================
f_ma(_src, _len, _type) =>
    switch _type
        "EMA" => ta.ema(_src, _len)
        "SMA" => ta.sma(_src, _len)
        "WMA" => ta.wma(_src, _len)
        => ta.rma(_src, _len)
f_mtf_ma(_src, _len, _type, _tf) =>
    string tfFinal = _tf == "" ? timeframe.period : _tf
    float chartMa = f_ma(_src, _len, _type)
    float chartSeconds = timeframe.in_seconds(timeframe.period)
    float requestedSeconds = timeframe.in_seconds(tfFinal)
    bool higherTf = not na(chartSeconds) and not na(requestedSeconds) and requestedSeconds > chartSeconds
    float htfConfirmed = request.security(
         syminfo.tickerid,
         tfFinal,
         f_ma(_src, _len, _type)[1],
         gaps=barmerge.gaps_off,
         lookahead=barmerge.lookahead_on)
    float htfLive = request.security(
         syminfo.tickerid,
         tfFinal,
         f_ma(_src, _len, _type),
         gaps=barmerge.gaps_off,
         lookahead=barmerge.lookahead_off)
    higherTf ? (useConfirmedHTF ? htfConfirmed : htfLive) : chartMa
//====================================================
// MA 1
//====================================================
groupMA1 = "MA 1"
showMA1 = input.bool(true, "Show MA 1", group=groupMA1)
srcMA1 = input.source(close, "Source", group=groupMA1)
typeMA1 = input.string("SMMA", "Type", options=["EMA", "SMA", "WMA", "SMMA"], group=groupMA1)
lenMA1 = input.int(50, "Length", minval=1, group=groupMA1)
tfMA1 = input.timeframe(
     "",
     "Timeframe",
     tooltip="Select the timeframe used to calculate this MA. Leave empty to use the current chart timeframe.",
     group=groupMA1)
colorMA1 = input.color(color.aqua, "Color", group=groupMA1)
widthMA1 = input.int(2, "Width", minval=1, maxval=5, group=groupMA1)
//====================================================
// MA 2
//====================================================
groupMA2 = "MA 2"
showMA2 = input.bool(true, "Show MA 2", group=groupMA2)
srcMA2 = input.source(close, "Source", group=groupMA2)
typeMA2 = input.string("SMMA", "Type", options=["EMA", "SMA", "WMA", "SMMA"], group=groupMA2)
lenMA2 = input.int(100, "Length", minval=1, group=groupMA2)
tfMA2 = input.timeframe(
     "",
     "Timeframe",
     tooltip="Select the timeframe used to calculate this MA. Leave empty to use the current chart timeframe.",
     group=groupMA2)
colorMA2 = input.color(color.orange, "Color", group=groupMA2)
widthMA2 = input.int(2, "Width", minval=1, maxval=5, group=groupMA2)
//====================================================
// MA 3
//====================================================
groupMA3 = "MA 3"
showMA3 = input.bool(true, "Show MA 3", group=groupMA3)
srcMA3 = input.source(close, "Source", group=groupMA3)
typeMA3 = input.string("SMMA", "Type", options=["EMA", "SMA", "WMA", "SMMA"], group=groupMA3)
lenMA3 = input.int(200, "Length", minval=1, group=groupMA3)
tfMA3 = input.timeframe(
     "",
     "Timeframe",
     tooltip="Select the timeframe used to calculate this MA. Leave empty to use the current chart timeframe.",
     group=groupMA3)
colorMA3 = input.color(color.fuchsia, "Color", group=groupMA3)
widthMA3 = input.int(2, "Width", minval=1, maxval=5, group=groupMA3)
//====================================================
// CALCULATIONS
//====================================================
ma1 = f_mtf_ma(srcMA1, lenMA1, typeMA1, tfMA1)
ma2 = f_mtf_ma(srcMA2, lenMA2, typeMA2, tfMA2)
ma3 = f_mtf_ma(srcMA3, lenMA3, typeMA3, tfMA3)
//====================================================
// PLOTS
//====================================================
p1 = plot(
     showMA1 ? ma1 : na,
     title="MA 1",
     color=colorMA1,
     linewidth=widthMA1,
     style=plot.style_line)
p2 = plot(
     showMA2 ? ma2 : na,
     title="MA 2",
     color=colorMA2,
     linewidth=widthMA2,
     style=plot.style_line)
p3 = plot(
     showMA3 ? ma3 : na,
     title="MA 3",
     color=colorMA3,
     linewidth=widthMA3,
     style=plot.style_line)
//====================================================
// MA ZONES
//====================================================
groupFill = "MA Zones"
showFill12 = input.bool(false, "Fill between MA 1 and MA 2", group=groupFill)
showFill23 = input.bool(false, "Fill between MA 2 and MA 3", group=groupFill)
fill12Color = input.color(color.new(color.aqua, 88), "MA 1/2 Fill Color", group=groupFill)
fill23Color = input.color(color.new(color.orange, 88), "MA 2/3 Fill Color", group=groupFill)
fill(
     p1,
     p2,
     color=showFill12 ? fill12Color : na,
     title="MA 1/2 Zone")
fill(
     p2,
     p3,
     color=showFill23 ? fill23Color : na,
     title="MA 2/3 Zone")
//====================================================
// MA CROSS
// Two visible MAs → those two.
// Three visible MAs → the two longest by Length.
// Event is the exact crossover. No ATR delay.
//====================================================
groupCross = "MA Cross"
showCrossDivider = input.bool(
     true,
     "Show Vertical Divider",
     tooltip="Draws a thin vertical line through the whole chart at the MA crossover, like the Structural Zones mirror divider.",
     group=groupCross)
showCrossFill = input.bool(
     true,
     "Fill Chart After Cross",
     tooltip="Greens or reds the chart after a crossover, until the opposite crossover.",
     group=groupCross)
showCrossMark = input.bool(true, "Show Cross Mark", group=groupCross)
maxCrossDividers = input.int(20, "Maximum Dividers", minval=1, maxval=50, group=groupCross)
crossBullColor = input.color(color.green, "Bullish Color", group=groupCross)
crossBearColor = input.color(color.red, "Bearish Color", group=groupCross)
crossFillTransp = input.int(90, "Fill Transparency", minval=0, maxval=100, group=groupCross)
crossLineWidth = input.int(1, "Line Width", minval=1, maxval=3, group=groupCross)
shownMACount = (showMA1 ? 1 : 0) + (showMA2 ? 1 : 0) + (showMA3 ? 1 : 0)
crossPair =
     shownMACount == 2 and showMA1 and showMA2 ? "12" :
     shownMACount == 2 and showMA2 and showMA3 ? "23" :
     shownMACount == 2 and showMA1 and showMA3 ? "13" :
     shownMACount == 3 and lenMA1 <= lenMA2 and lenMA1 <= lenMA3 ? "23" :
     shownMACount == 3 and lenMA2 <= lenMA1 and lenMA2 <= lenMA3 ? "13" :
     shownMACount == 3 ? "12" :
     "none"
up12 = ta.crossover(ma1, ma2)
dn12 = ta.crossunder(ma1, ma2)
up23 = ta.crossover(ma2, ma3)
dn23 = ta.crossunder(ma2, ma3)
up13 = ta.crossover(ma1, ma3)
dn13 = ta.crossunder(ma1, ma3)
bullCross =
     crossPair == "12" ? (lenMA1 <= lenMA2 ? up12 : dn12) :
     crossPair == "23" ? (lenMA2 <= lenMA3 ? up23 : dn23) :
     crossPair == "13" ? (lenMA1 <= lenMA3 ? up13 : dn13) :
     false
bearCross =
     crossPair == "12" ? (lenMA1 <= lenMA2 ? dn12 : up12) :
     crossPair == "23" ? (lenMA2 <= lenMA3 ? dn23 : up23) :
     crossPair == "13" ? (lenMA1 <= lenMA3 ? dn13 : up13) :
     false
crossPriceNow =
     crossPair == "12" ? (ma1 + ma2) * 0.5 :
     crossPair == "23" ? (ma2 + ma3) * 0.5 :
     crossPair == "13" ? (ma1 + ma3) * 0.5 :
     na
var int crossTrend = 0
var array<line> crossDividers = array.new_line()
bool newBullCross = false
bool newBearCross = false
if barstate.isconfirmed
    if bullCross
        newBullCross := true
        crossTrend := 1
    else if bearCross
        newBearCross := true
        crossTrend := -1
    if newBullCross or newBearCross
        color crossColor = newBullCross ? crossBullColor : crossBearColor
        if showCrossDivider
            line divider = line.new(
                 time,
                 low,
                 time,
                 high,
                 xloc=xloc.bar_time,
                 extend=extend.both,
                 color=crossColor,
                 style=line.style_dashed,
                 width=crossLineWidth)
            array.push(crossDividers, divider)
            while array.size(crossDividers) > maxCrossDividers
                line.delete(array.shift(crossDividers))
plotshape(
     showCrossMark and newBullCross ? crossPriceNow : na,
     title="Bullish MA Cross",
     style=shape.diamond,
     location=location.absolute,
     color=crossBullColor,
     size=size.tiny)
plotshape(
     showCrossMark and newBearCross ? crossPriceNow : na,
     title="Bearish MA Cross",
     style=shape.diamond,
     location=location.absolute,
     color=crossBearColor,
     size=size.tiny)
bgcolor(
     showCrossFill and crossTrend == 1 ? color.new(crossBullColor, crossFillTransp) : na,
     title="Bullish MA Cross Fill")
bgcolor(
     showCrossFill and crossTrend == -1 ? color.new(crossBearColor, crossFillTransp) : na,
     title="Bearish MA Cross Fill")
//====================================================
// ALERTS
//====================================================
groupAlerts = "Alerts"
cooldownMA1 = input.int(
     10,
     "MA 1 Touch Cooldown Bars",
     minval=0,
     tooltip="Minimum number of bars before another touch alert can trigger for this MA.",
     group=groupAlerts)
cooldownMA2 = input.int(
     10,
     "MA 2 Touch Cooldown Bars",
     minval=0,
     tooltip="Minimum number of bars before another touch alert can trigger for this MA.",
     group=groupAlerts)
cooldownMA3 = input.int(
     10,
     "MA 3 Touch Cooldown Bars",
     minval=0,
     tooltip="Minimum number of bars before another touch alert can trigger for this MA.",
     group=groupAlerts)
var int lastTouchMA1 = na
var int lastTouchMA2 = na
var int lastTouchMA3 = na
touchRawMA1 = showMA1 and not na(ma1) and low <= ma1 and high >= ma1
touchRawMA2 = showMA2 and not na(ma2) and low <= ma2 and high >= ma2
touchRawMA3 = showMA3 and not na(ma3) and low <= ma3 and high >= ma3
canTouchMA1 = na(lastTouchMA1) or bar_index - lastTouchMA1 > cooldownMA1
canTouchMA2 = na(lastTouchMA2) or bar_index - lastTouchMA2 > cooldownMA2
canTouchMA3 = na(lastTouchMA3) or bar_index - lastTouchMA3 > cooldownMA3
touchMA1 = touchRawMA1 and canTouchMA1
touchMA2 = touchRawMA2 and canTouchMA2
touchMA3 = touchRawMA3 and canTouchMA3
if touchMA1
    lastTouchMA1 := bar_index
if touchMA2
    lastTouchMA2 := bar_index
if touchMA3
    lastTouchMA3 := bar_index
alertcondition(
     touchMA1,
     title="MA 1 Touch",
     message="Price touched MA 1 on {{ticker}} | Price: {{close}}")
alertcondition(
     touchMA2,
     title="MA 2 Touch",
     message="Price touched MA 2 on {{ticker}} | Price: {{close}}")
alertcondition(
     touchMA3,
     title="MA 3 Touch",
     message="Price touched MA 3 on {{ticker}} | Price: {{close}}")
alertcondition(
     newBullCross,
     title="Bullish MA Cross",
     message="Bullish MA cross on {{ticker}} | Price: {{close}}")
alertcondition(
     newBearCross,
     title="Bearish MA Cross",
     message="Bearish MA Cross on {{ticker}} | Price: {{close}}")
