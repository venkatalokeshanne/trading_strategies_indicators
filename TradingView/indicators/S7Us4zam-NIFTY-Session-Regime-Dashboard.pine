//====================================================================
// TREND BACKGROUND
//
// bgcolor() is intentionally kept in global scope.
//====================================================================

color backgroundColor = color.new(color.gray, 97)

if trend == "STRONG BULL"
    backgroundColor := color.new(color.green, 92)
else if trend == "BULLISH"
    backgroundColor := color.new(color.green, 96)
else if trend == "STRONG BEAR"
    backgroundColor := color.new(color.red, 92)
else if trend == "BEARISH"
    backgroundColor := color.new(color.red, 96)
else
    backgroundColor := color.new(color.gray, 97)


bgcolor(
     showBackground ? backgroundColor : na)


//====================================================================
// DATA WINDOW
//====================================================================

plot(
     niftyScore,
     title="NIFTY Session Trend Score",
     color=niftyScore >= 0.0 ? color.green : color.red,
     linewidth=2,
     display=display.data_window)


plot(
     trendStrength,
     title="NIFTY Trend Strength",
     color=color.blue,
     linewidth=2,
     display=display.data_window)


plot(
     bullishRating,
     title="Bullish Rating",
     color=color.green,
     display=display.data_window)


plot(
     bearishRating,
     title="Bearish Rating",
     color=color.red,
     display=display.data_window)