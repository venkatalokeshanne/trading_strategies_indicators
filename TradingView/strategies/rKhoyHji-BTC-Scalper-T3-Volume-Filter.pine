//@version=5
strategy("BTC Scalper - T3 + Volume Filter", 
     overlay=true, 
     initial_capital=10000, 
     default_qty_type=strategy.percent_of_equity, 
     default_qty_value=100, 
     commission_value=0.04, 
     commission_type=strategy.commission.percent, 
     slippage=1)

// === USER INPUTS ===
// T3 Moving Average Settings
t3_length = input.int(8, "T3 Length", group="T3 Settings")
t3_factor = input.float(0.7, "Volume Factor (0-1)", minval=0, maxval=1, step=0.1, group="T3 Settings")

// Scalping Filters
use_volume_filter = input.bool(true, "Use Volume Confirmation", group="Filters")
volume_ma_length = input.int(20, "Volume MA Length", group="Filters")

// Risk Management (Scalping Specific)
take_profit_pct = input.float(0.8, "Take Profit %", step=0.1, group="Risk Management")
stop_loss_pct   = input.float(0.5, "Stop Loss %", step=0.1, group="Risk Management")

// === T3 CALCULATION (The Smoothing Engine) ===
// T3 is essentially a 6th-order smoothed EMA designed to reduce lag while eliminating noise.
t3(src, length, vol_factor) =>
    e1 = ta.ema(src, length)
    e2 = ta.ema(e1, length)
    e3 = ta.ema(e2, length)
    e4 = ta.ema(e3, length)
    e5 = ta.ema(e4, length)
    e6 = ta.ema(e5, length)
    
    c1 = -vol_factor * vol_factor * vol_factor
    c2 = 3 * vol_factor * vol_factor + 3 * vol_factor * vol_factor * vol_factor
    c3 = -6 * vol_factor * vol_factor - 3 * vol_factor - 3 * vol_factor * vol_factor * vol_factor
    c4 = 1 + 3 * vol_factor + vol_factor * vol_factor * vol_factor + 3 * vol_factor * vol_factor
    
    c1 * e6 + c2 * e5 + c3 * e4 + c4 * e3

t3_line = t3(close, t3_length, t3_factor)

// === VOLUME FILTER (Critical for avoiding fakeouts) ===
vol_ma = ta.sma(volume, volume_ma_length)
volume_condition = volume > vol_ma

// === ENTRY CONDITIONS ===
// Long Entry: Price crosses ABOVE T3 line (momentum shift up)
long_condition = ta.crossover(close, t3_line)

// Short Entry: Price crosses BELOW T3 line (momentum shift down)
short_condition = ta.crossunder(close, t3_line)

// Apply Volume Filter (Optional - Recommended ON for Bitcoin)
final_long  = use_volume_filter ? long_condition and volume_condition : long_condition
final_short = use_volume_filter ? short_condition and volume_condition : short_condition

// === EXECUTION & RISK MANAGEMENT ===
if (final_long)
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", 
         profit = close * (1 + take_profit_pct/100) / syminfo.mintick, 
         loss   = close * (1 - stop_loss_pct/100) / syminfo.mintick)

if (final_short)
    strategy.entry("Short", strategy.short)
    strategy.exit("XS", "Short", 
         profit = close * (1 - take_profit_pct/100) / syminfo.mintick, 
         loss   = close * (1 + stop_loss_pct/100) / syminfo.mintick)

// === VISUAL ELEMENTS (Chart Overlay) ===
plot(t3_line, color=color.new(color.aqua, 0), linewidth=2, title="T3 Fast Line")

// Plot Background Color when Volume is High (Visual Filter Check)
bgcolor(use_volume_filter and volume_condition ? color.new(color.green, 90) : na)

// Plot Entry/Exit Arrows for Quick Visual Backtest
plotshape(final_long, style=shape.triangleup, location=location.belowbar, 
          color=color.green, size=size.small, title="Buy Signal")
plotshape(final_short, style=shape.triangledown, location=location.abovebar, 
          color=color.red, size=size.small, title="Sell Signal")