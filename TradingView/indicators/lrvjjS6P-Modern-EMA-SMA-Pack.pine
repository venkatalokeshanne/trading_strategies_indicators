//@version=6
indicator("Modern EMA + SMA Pack", overlay=true, max_labels_count=25)

// ============================================================================
// DISPLAY INPUTS
// ============================================================================

// EMAs
showEma9 = input.bool(true, "Show 9 EMA", group="EMAs")
showEma20 = input.bool(true, "Show 20 EMA", group="EMAs")
showEma50 = input.bool(true, "Show 50 EMA", group="EMAs")

// SMAs
showSma9 = input.bool(true, "Show 9 SMA", group="SMAs")
showSma20 = input.bool(true, "Show 20 SMA", group="SMAs")
showSma50 = input.bool(true, "Show 50 SMA", group="SMAs")
showSma100 = input.bool(true, "Show 100 SMA", group="SMAs")
showSma200 = input.bool(true, "Show 200 SMA", group="SMAs")

// Custom EMA
showCustomEma = input.bool(false, "Show custom EMA", group="Custom EMA")
customEmaPeriod = input.int(21, "Custom EMA period", minval=1, group="Custom EMA")
customEmaStyle = input.string(
     "Solid",
     "Custom EMA line type",
     options=["Solid", "Dotted", "Stepline", "Cross"],
     group="Custom EMA")
customEmaWidth = input.int(
     2,
     "Custom EMA line width",
     minval=1,
     maxval=5,
     group="Custom EMA")
customEmaColor = input.color(
     color.rgb(255, 128, 0),
     "Custom EMA color",
     group="Custom EMA")

// Custom SMA
showCustomSma = input.bool(false, "Show custom SMA", group="Custom SMA")
customSmaPeriod = input.int(150, "Custom SMA period", minval=1, group="Custom SMA")
customSmaStyle = input.string(
     "Solid",
     "Custom SMA line type",
     options=["Solid", "Dotted", "Stepline", "Cross"],
     group="Custom SMA")
customSmaWidth = input.int(
     3,
     "Custom SMA line width",
     minval=1,
     maxval=5,
     group="Custom SMA")
customSmaColor = input.color(
     color.rgb(190, 130, 255),
     "Custom SMA color",
     group="Custom SMA")

// VWAP
showVwap = input.bool(true, "Show session VWAP", group="VWAP")
vwapSource = input.source(hlc3, "VWAP source", group="VWAP")

// ============================================================================
// LABEL INPUTS
// ============================================================================

showLabels = input.bool(true, "Show labels", group="Labels")

labelOffset = input.int(
     2,
     "Label offset",
     minval=0,
     maxval=25,
     group="Labels")

labelTransparency = input.int(
     75,
     "Label background transparency",
     minval=0,
     maxval=100,
     group="Labels")

labelColumnSpacing = input.int(
     2,
     "Bars between label columns",
     minval=1,
     maxval=10,
     group="Labels")

labelSizeInput = input.string(
     "Small",
     "Label size",
     options=["Tiny", "Small", "Normal"],
     group="Labels")

// ============================================================================
// SMART LABEL ANTI-OVERLAP
// ============================================================================

antiOverlap = input.bool(
     true,
     "Enable smart label anti-overlap",
     group="Labels - Anti-Overlap")

labelSpacingAtrPct = input.float(
     30.0,
     "Minimum vertical spacing (% of ATR)",
     minval=0.0,
     maxval=200.0,
     step=5.0,
     group="Labels - Anti-Overlap")

labelSpacingTicks = input.int(
     2,
     "Minimum vertical spacing (ticks)",
     minval=0,
     maxval=100,
     group="Labels - Anti-Overlap")

// ============================================================================
// STYLE INPUTS
// ============================================================================

emaWidth = input.int(
     2,
     "EMA line width",
     minval=1,
     maxval=5,
     group="Style")

smaWidth = input.int(
     3,
     "SMA line thickness",
     minval=1,
     maxval=5,
     group="Style")

vwapWidth = input.int(
     2,
     "VWAP line width",
     minval=1,
     maxval=5,
     group="Style")

smaTransparency = input.int(
     35,
     "SMA transparency",
     minval=0,
     maxval=90,
     group="Style")

sma50AutoContrast = input.bool(
     true,
     "50 SMA auto contrast color",
     group="Style - 50/100/200 SMAs")

sma50ManualColor = input.color(
     color.white,
     "50 SMA manual color",
     group="Style - 50/100/200 SMAs")

sma50Width = input.int(
     3,
     "50 SMA line thickness",
     minval=1,
     maxval=5,
     group="Style - 50/100/200 SMAs")

sma100Color = input.color(
     color.rgb(150, 235, 170),
     "100 SMA color",
     group="Style - 50/100/200 SMAs")

sma100Width = input.int(
     3,
     "100 SMA line thickness",
     minval=1,
     maxval=5,
     group="Style - 50/100/200 SMAs")

sma200Color = input.color(
     color.rgb(0, 255, 80),
     "200 SMA color",
     group="Style - 50/100/200 SMAs")

sma200Width = input.int(
     3,
     "200 SMA line thickness",
     minval=1,
     maxval=5,
     group="Style - 50/100/200 SMAs")

// ============================================================================
// COLORS
// ============================================================================

red9 = input.color(
     color.rgb(255, 0, 32),
     "9 period color",
     group="Colors")

blue20 = input.color(
     color.rgb(0, 132, 255),
     "20 period color",
     group="Colors")

autoContrast50 = input.bool(
     true,
     "Auto 50 period contrast color",
     group="Colors")

manual50 = input.color(
     color.white,
     "Manual 50 period color",
     group="Colors")

contrast50 = autoContrast50 ? chart.fg_color : manual50

paleGreen100 = input.color(
     color.rgb(150, 235, 170),
     "100 period color",
     group="Colors")

brightGreen200 = input.color(
     color.rgb(0, 255, 80),
     "200 period color",
     group="Colors")

vwapColor = input.color(
     color.rgb(255, 200, 0),
     "Session VWAP color",
     group="Colors")

sma50Color = sma50AutoContrast ? chart.fg_color : sma50ManualColor

// ============================================================================
// MOVING AVERAGES
// ============================================================================

ema9 = ta.ema(close, 9)
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)

sma9 = ta.sma(close, 9)
sma20 = ta.sma(close, 20)
sma50 = ta.sma(close, 50)
sma100 = ta.sma(close, 100)
sma200 = ta.sma(close, 200)

customEma = ta.ema(close, customEmaPeriod)
customSma = ta.sma(close, customSmaPeriod)

sessionVwap = ta.vwap(vwapSource)

// ATR used by smart label spacing.
atr14 = ta.atr(14)

// ============================================================================
// STANDARD MA PLOTS
// ============================================================================

plot(showEma9 ? ema9 : na, "9 EMA", color=red9, linewidth=emaWidth)
plot(showEma20 ? ema20 : na, "20 EMA", color=blue20, linewidth=emaWidth)
plot(showEma50 ? ema50 : na, "50 EMA", color=contrast50, linewidth=emaWidth)

smaColor(color baseColor) =>
    color.new(baseColor, smaTransparency)

plot(showSma9 ? sma9 : na, "9 SMA", color=smaColor(red9), linewidth=smaWidth)
plot(showSma20 ? sma20 : na, "20 SMA", color=smaColor(blue20), linewidth=smaWidth)
plot(showSma50 ? sma50 : na, "50 SMA", color=smaColor(sma50Color), linewidth=sma50Width)
plot(showSma100 ? sma100 : na, "100 SMA", color=smaColor(sma100Color), linewidth=sma100Width)
plot(showSma200 ? sma200 : na, "200 SMA", color=smaColor(sma200Color), linewidth=sma200Width)

// ============================================================================
// CUSTOM EMA
// ============================================================================

plot(
     showCustomEma and customEmaStyle == "Solid" ? customEma : na,
     "Custom EMA Solid",
     color=customEmaColor,
     linewidth=customEmaWidth)

plot(
     showCustomEma and customEmaStyle == "Dotted" ? customEma : na,
     "Custom EMA Dotted",
     color=customEmaColor,
     linewidth=customEmaWidth,
     style=plot.style_circles)

plot(
     showCustomEma and customEmaStyle == "Stepline" ? customEma : na,
     "Custom EMA Stepline",
     color=customEmaColor,
     linewidth=customEmaWidth,
     style=plot.style_stepline)

plot(
     showCustomEma and customEmaStyle == "Cross" ? customEma : na,
     "Custom EMA Cross",
     color=customEmaColor,
     linewidth=customEmaWidth,
     style=plot.style_cross)

// ============================================================================
// CUSTOM SMA
// ============================================================================

plot(
     showCustomSma and customSmaStyle == "Solid" ? customSma : na,
     "Custom SMA Solid",
     color=customSmaColor,
     linewidth=customSmaWidth)

plot(
     showCustomSma and customSmaStyle == "Dotted" ? customSma : na,
     "Custom SMA Dotted",
     color=customSmaColor,
     linewidth=customSmaWidth,
     style=plot.style_circles)

plot(
     showCustomSma and customSmaStyle == "Stepline" ? customSma : na,
     "Custom SMA Stepline",
     color=customSmaColor,
     linewidth=customSmaWidth,
     style=plot.style_stepline)

plot(
     showCustomSma and customSmaStyle == "Cross" ? customSma : na,
     "Custom SMA Cross",
     color=customSmaColor,
     linewidth=customSmaWidth,
     style=plot.style_cross)

// ============================================================================
// VWAP
// ============================================================================

plot(
     showVwap ? sessionVwap : na,
     "Session VWAP",
     color=vwapColor,
     linewidth=vwapWidth)

// ============================================================================
// LABEL SETTINGS
// ============================================================================

labelSizeValue =
     labelSizeInput == "Tiny" ? size.tiny :
     labelSizeInput == "Normal" ? size.normal :
     size.small

labelTextColor(color backgroundColor) =>
    chart.fg_color

// ============================================================================
// SMART ANTI-OVERLAP ENGINE
// ============================================================================
//
// Each MA/VWAP has a permanent numeric ID:
//
// 0  = 9 EMA
// 1  = 20 EMA
// 2  = 50 EMA
// 3  = 9 SMA
// 4  = 20 SMA
// 5  = 50 SMA
// 6  = 100 SMA
// 7  = 200 SMA
// 8  = Custom EMA
// 9  = Custom SMA
// 10 = VWAP
//
// The function:
//
// 1. Collects only visible labels.
// 2. Sorts them by actual price.
// 3. Checks adjacent labels.
// 4. If two are closer than minGap, moves one slightly down
//    and the other slightly up.
// 5. Repeats the process so clusters of 3+ labels spread naturally.
// 6. Maps the adjusted Y positions back to their original labels.
//

resolveLabelPositions(
     array<float> values,
     array<bool> visibility,
     float minGap) =>

    array<float> result = array.new<float>(array.size(values))

    array<float> activeValues = array.new<float>()
    array<int> activeIds = array.new<int>()

    // Collect visible labels.
    for i = 0 to array.size(values) - 1

        float currentValue = array.get(values, i)
        bool currentVisible = array.get(visibility, i)

        if showLabels and currentVisible and not na(currentValue)
            array.push(activeValues, currentValue)
            array.push(activeIds, i)

    int activeCount = array.size(activeValues)

    if activeCount > 0

        // Sort labels from lowest price to highest price without
        // changing their original IDs.
        array<int> sortedIndices =
             array.sort_indices(activeValues, order.ascending)

        array<float> sortedY = array.new<float>(activeCount)
        array<int> sortedIds = array.new<int>(activeCount)

        for rank = 0 to activeCount - 1

            int activeIndex = array.get(sortedIndices, rank)

            array.set(
                 sortedY,
                 rank,
                 array.get(activeValues, activeIndex))

            array.set(
                 sortedIds,
                 rank,
                 array.get(activeIds, activeIndex))

        // Spread crowded labels.
        //
        // Repeated passes allow the displacement to propagate through
        // an entire cluster instead of merely fixing one pair.
        if antiOverlap and activeCount > 1 and minGap > 0

            for pass = 0 to 49

                for j = 1 to activeCount - 1

                    float lowerY = array.get(sortedY, j - 1)
                    float upperY = array.get(sortedY, j)

                    float currentGap = upperY - lowerY

                    if currentGap < minGap

                        float adjustment =
                             (minGap - currentGap) / 2.0

                        array.set(
                             sortedY,
                             j - 1,
                             lowerY - adjustment)

                        array.set(
                             sortedY,
                             j,
                             upperY + adjustment)

        // Put the resolved positions back into the original ID slots.
        for rank = 0 to activeCount - 1

            int originalId = array.get(sortedIds, rank)
            float resolvedY = array.get(sortedY, rank)

            array.set(
                 result,
                 originalId,
                 resolvedY)

    result

// ============================================================================
// CALCULATE SMART LABEL SPACING
// ============================================================================

// ATR-based spacing adapts automatically across stocks and futures.
//
// Example:
// 30% setting + ATR of $0.40 = minimum label spacing of $0.12.
//
// Tick-based spacing provides a minimum floor for very low-volatility
// instruments.

float atrSpacing =
     atr14 * (labelSpacingAtrPct / 100.0)

float tickSpacing =
     syminfo.mintick * labelSpacingTicks

float minimumLabelGap =
     math.max(atrSpacing, tickSpacing)

// ============================================================================
// BUILD LABEL VALUE ARRAYS
// ============================================================================

array<float> labelValues = array.from(
     ema9,
     ema20,
     ema50,
     sma9,
     sma20,
     sma50,
     sma100,
     sma200,
     customEma,
     customSma,
     sessionVwap)

array<bool> labelVisibility = array.from(
     showEma9,
     showEma20,
     showEma50,
     showSma9,
     showSma20,
     showSma50,
     showSma100,
     showSma200,
     showCustomEma,
     showCustomSma,
     showVwap)

// Resolve all label Y positions simultaneously.
array<float> labelY =
     resolveLabelPositions(
         labelValues,
         labelVisibility,
         minimumLabelGap)

// ============================================================================
// LABEL UPDATE FUNCTION
// ============================================================================

upsertLabel(
     label currentLabel,
     bool visible,
     string labelName,
     float actualValue,
     float displayValue,
     color labelColor,
     int xStep) =>

    label nextLabel = currentLabel

    color transparentLabelColor =
         color.new(labelColor, labelTransparency)

    if barstate.islast

        if showLabels and visible and not na(actualValue)

            // If anti-overlap is disabled or a resolved value is unavailable,
            // fall back to the exact MA/VWAP value.
            float finalY =
                 antiOverlap and not na(displayValue)
                 ? displayValue
                 : actualValue

            int x =
                 bar_index +
                 labelOffset +
                 (xStep * labelColumnSpacing)

            if na(nextLabel)

                nextLabel := label.new(
                     x,
                     finalY,
                     labelName,
                     xloc=xloc.bar_index,
                     yloc=yloc.price,
                     style=label.style_label_left,
                     color=transparentLabelColor,
                     textcolor=labelTextColor(labelColor),
                     size=labelSizeValue)

            else

                label.set_xy(
                     nextLabel,
                     x,
                     finalY)

                label.set_text(
                     nextLabel,
                     labelName)

                label.set_color(
                     nextLabel,
                     transparentLabelColor)

                label.set_textcolor(
                     nextLabel,
                     labelTextColor(labelColor))

                label.set_size(
                     nextLabel,
                     labelSizeValue)

        else if not na(nextLabel)

            label.delete(nextLabel)
            nextLabel := na

    nextLabel

// ============================================================================
// LABEL VARIABLES
// ============================================================================

var label ema9Label = na
var label ema20Label = na
var label ema50Label = na

var label sma9Label = na
var label sma20Label = na
var label sma50Label = na
var label sma100Label = na
var label sma200Label = na

var label customEmaLabel = na
var label customSmaLabel = na

var label vwapLabel = na

// ============================================================================
// UPDATE LABELS
// ============================================================================

ema9Label := upsertLabel(
     ema9Label,
     showEma9,
     "9 EMA",
     ema9,
     array.get(labelY, 0),
     red9,
     0)

ema20Label := upsertLabel(
     ema20Label,
     showEma20,
     "20 EMA",
     ema20,
     array.get(labelY, 1),
     blue20,
     1)

ema50Label := upsertLabel(
     ema50Label,
     showEma50,
     "50 EMA",
     ema50,
     array.get(labelY, 2),
     contrast50,
     2)

sma9Label := upsertLabel(
     sma9Label,
     showSma9,
     "9 SMA",
     sma9,
     array.get(labelY, 3),
     red9,
     3)

sma20Label := upsertLabel(
     sma20Label,
     showSma20,
     "20 SMA",
     sma20,
     array.get(labelY, 4),
     blue20,
     4)

sma50Label := upsertLabel(
     sma50Label,
     showSma50,
     "50 SMA",
     sma50,
     array.get(labelY, 5),
     sma50Color,
     5)

sma100Label := upsertLabel(
     sma100Label,
     showSma100,
     "100 SMA",
     sma100,
     array.get(labelY, 6),
     sma100Color,
     6)

sma200Label := upsertLabel(
     sma200Label,
     showSma200,
     "200 SMA",
     sma200,
     array.get(labelY, 7),
     sma200Color,
     7)

customEmaLabel := upsertLabel(
     customEmaLabel,
     showCustomEma,
     str.tostring(customEmaPeriod) + " EMA",
     customEma,
     array.get(labelY, 8),
     customEmaColor,
     8)

customSmaLabel := upsertLabel(
     customSmaLabel,
     showCustomSma,
     str.tostring(customSmaPeriod) + " SMA",
     customSma,
     array.get(labelY, 9),
     customSmaColor,
     9)

vwapLabel := upsertLabel(
     vwapLabel,
     showVwap,
     "VWAP",
     sessionVwap,
     array.get(labelY, 10),
     vwapColor,
     10)