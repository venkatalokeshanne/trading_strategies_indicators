     minval=1,
     maxval=7,
     group=groupDisplay,
     display=display.none)

// ============================================================================
// DIVERGENCE FUNCTIONS
// ============================================================================

bullishDivergence(float oscillator, bool isLowPivot) =>

    previousOscillator = ta.valuewhen(
         isLowPivot,
         oscillator[rightBars],
         1)

    currentOscillator = ta.valuewhen(
         isLowPivot,
         oscillator[rightBars],
         0)

    previousPrice = ta.valuewhen(
         isLowPivot,
         low[rightBars],
         1)

    currentPrice = ta.valuewhen(
         isLowPivot,
         low[rightBars],
         0)

    previousBar = ta.valuewhen(
         isLowPivot,
         bar_index[rightBars],
         1)

    currentBar = ta.valuewhen(
         isLowPivot,
         bar_index[rightBars],
         0)

    validData =
         not na(previousOscillator) and
         not na(currentOscillator) and
         not na(previousPrice) and
         not na(currentPrice) and
         not na(previousBar) and
         not na(currentBar)

    distanceOK =
         validData and
         currentBar - previousBar <= maxBars

    distanceOK and
         currentPrice < previousPrice and
         currentOscillator > previousOscillator


bearishDivergence(float oscillator, bool isHighPivot) =>

    previousOscillator = ta.valuewhen(
         isHighPivot,
         oscillator[rightBars],
         1)

    currentOscillator = ta.valuewhen(
         isHighPivot,
         oscillator[rightBars],
         0)

    previousPrice = ta.valuewhen(
         isHighPivot,
         high[rightBars],
         1)

    currentPrice = ta.valuewhen(
         isHighPivot,
         high[rightBars],
         0)

    previousBar = ta.valuewhen(
         isHighPivot,
         bar_index[rightBars],
         1)

    currentBar = ta.valuewhen(
         isHighPivot,
         bar_index[rightBars],
         0)

    validData =
         not na(previousOscillator) and
         not na(currentOscillator) and
         not na(previousPrice) and
         not na(currentPrice) and
         not na(previousBar) and
         not na(currentBar)

    distanceOK =
         validData and
         currentBar - previousBar <= maxBars

    distanceOK and
         currentPrice > previousPrice and
         currentOscillator < previousOscillator

// ============================================================================
// DIVERGENCE ENGINE
// ============================================================================

calcDivergence() =>

    rsi = ta.rsi(close, rsiLength)

    [macdLine, macdSignalLine, macdHistogram] =
         ta.macd(
             close,
             macdFast,
             macdSlow,
             macdSignal)

    stochastic =
         ta.stoch(
             close,
             high,
             low,
             stochLength)

    obv = ta.obv

    mfi =
         ta.mfi(
             hlc3,
             mfiLength)

    cci =
         ta.cci(
             hlc3,
             cciLength)

    medianPrice =
         (high + low) / 2.0

    awesomeOscillator =
         ta.sma(medianPrice, aoFast) -
         ta.sma(medianPrice, aoSlow)

    priceLow =
         ta.pivotlow(
             low,
             leftBars,
             rightBars)

    priceHigh =
         ta.pivothigh(
             high,
             leftBars,
             rightBars)

    isLowPivot =
         not na(priceLow)

    isHighPivot =
         not na(priceHigh)

    bullRSI =
         bullishDivergence(rsi, isLowPivot)

    bullMACD =
         bullishDivergence(macdLine, isLowPivot)

    bullStoch =
         bullishDivergence(stochastic, isLowPivot)

    bullOBV =
         bullishDivergence(obv, isLowPivot)

    bullMFI =
         bullishDivergence(mfi, isLowPivot)

    bullCCI =
         bullishDivergence(cci, isLowPivot)

    bullAO =
         bullishDivergence(awesomeOscillator, isLowPivot)

    bearRSI =
         bearishDivergence(rsi, isHighPivot)

    bearMACD =
         bearishDivergence(macdLine, isHighPivot)

    bearStoch =
         bearishDivergence(stochastic, isHighPivot)

    bearOBV =
         bearishDivergence(obv, isHighPivot)

    bearMFI =
         bearishDivergence(mfi, isHighPivot)

    bearCCI =
         bearishDivergence(cci, isHighPivot)

    bearAO =
         bearishDivergence(awesomeOscillator, isHighPivot)

    bullCount =
         (bullRSI ? 1 : 0) +
         (bullMACD ? 1 : 0) +
         (bullStoch ? 1 : 0) +
         (bullOBV ? 1 : 0) +
         (bullMFI ? 1 : 0) +
         (bullCCI ? 1 : 0) +
         (bullAO ? 1 : 0)

    bearCount =
         (bearRSI ? 1 : 0) +
         (bearMACD ? 1 : 0) +
         (bearStoch ? 1 : 0) +
         (bearOBV ? 1 : 0) +
         (bearMFI ? 1 : 0) +
         (bearCCI ? 1 : 0) +
         (bearAO ? 1 : 0)

    [bullCount, bearCount]

// ============================================================================
// TICKER REQUEST
// ============================================================================

calcTicker() =>
    [bullDiv, bearDiv] = calcDivergence()
    [bullDiv, bearDiv, close]

