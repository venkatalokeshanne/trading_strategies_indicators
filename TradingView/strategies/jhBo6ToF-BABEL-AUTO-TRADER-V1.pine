//@version=6
strategy("BABEL AUTO TRADER V1",
     overlay=true,
     pyramiding=0,
     initial_capital=10000,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     process_orders_on_close=true)

//====================================================
// INPUTS
//====================================================

emaLen      = input.int(200, "Trend EMA")
fastLen     = input.int(21, "Fast EMA")
slowLen     = input.int(55, "Slow EMA")

rsiLen      = input.int(14, "RSI Length")
adxLen      = input.int(14, "ADX Length")
adxMin      = input.float(20.0, "Minimum ADX")

atrLen      = input.int(14, "ATR Length")
slATR       = input.float(1.5, "Stop Loss ATR")
rr          = input.float(2.0, "Risk/Reward")

volumeLen   = input.int(20, "Volume Average")
volumeMult  = input.float(1.0, "Volume Multiplier")

scoreNeeded = input.int(8, "Minimum BABEL Score", minval=1, maxval=10)

useLongs    = input.bool(true, "Enable Longs")
useShorts   = input.bool(true, "Enable Shorts")

//====================================================
// CORE INDICATORS
//====================================================

ema200 = ta.ema(close, emaLen)
ema21  = ta.ema(close, fastLen)
ema55  = ta.ema(close, slowLen)

rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)

[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

avgVolume = ta.sma(volume, volumeLen)

//====================================================
// MARKET STRUCTURE
//====================================================

pivotHigh = ta.pivothigh(high, 3, 3)
pivotLow  = ta.pivotlow(low, 3, 3)

var float lastHigh = na
var float lastLow  = na

if not na(pivotHigh)
    lastHigh := pivotHigh

if not na(pivotLow)
    lastLow := pivotLow

bullBOS = not na(lastHigh) and close > lastHigh
bearBOS = not na(lastLow) and close < lastLow

//====================================================
// LIQUIDITY SWEEP
//====================================================

bullSweep = not na(lastLow) and low < lastLow and close > lastLow
bearSweep = not na(lastHigh) and high > lastHigh and close < lastHigh

//====================================================
// TREND CONDITIONS
//====================================================

bullTrend =
     close > ema200 and
     ema21 > ema55 and
     ema55 > ema200

bearTrend =
     close < ema200 and
     ema21 < ema55 and
     ema55 < ema200

//====================================================
// MOMENTUM
//====================================================

bullMomentum =
     rsi > 50 and
     diPlus > diMinus and
     adx >= adxMin

bearMomentum =
     rsi < 50 and
     diMinus > diPlus and
     adx >= adxMin

//====================================================
// VOLUME
//====================================================

volumeConfirm = volume >= avgVolume * volumeMult

//====================================================
// CANDLE CONFIRMATION
//====================================================

bullCandle = close > open
bearCandle = close < open

//====================================================
// BABEL SCORE
//====================================================

longScore = 0

longScore += close > ema200 ? 1 : 0
longScore += ema21 > ema55 ? 1 : 0
longScore += ema55 > ema200 ? 1 : 0
longScore += bullMomentum ? 1 : 0
longScore += volumeConfirm ? 1 : 0
longScore += bullCandle ? 1 : 0
longScore += bullBOS ? 1 : 0
longScore += bullSweep ? 1 : 0
longScore += rsi > 55 ? 1 : 0
longScore += adx >= adxMin ? 1 : 0

shortScore = 0

shortScore += close < ema200 ? 1 : 0
shortScore += ema21 < ema55 ? 1 : 0
shortScore += ema55 < ema200 ? 1 : 0
shortScore += bearMomentum ? 1 : 0
shortScore += volumeConfirm ? 1 : 0
shortScore += bearCandle ? 1 : 0
shortScore += bearBOS ? 1 : 0
shortScore += bearSweep ? 1 : 0
shortScore += rsi < 45 ? 1 : 0
shortScore += adx >= adxMin ? 1 : 0

//====================================================
// ENTRY CONDITIONS
//====================================================

longSignal =
     useLongs and
     bullTrend and
     longScore >= scoreNeeded and
     strategy.position_size == 0

shortSignal =
     useShorts and
     bearTrend and
     shortScore >= scoreNeeded and
     strategy.position_size == 0

//====================================================
// TRADE LEVELS
//====================================================

longSL  = close - atr * slATR
longTP  = close + (close - longSL) * rr

shortSL = close + atr * slATR
shortTP = close - (shortSL - close) * rr

//====================================================
// JSON ALERTS
//====================================================

longMessage =
     '{"bot":"BABEL_V1",' +
     '"action":"BUY",' +
     '"symbol":"' + syminfo.ticker + '",' +
     '"price":' + str.tostring(close) + ',' +
     '"score":' + str.tostring(longScore) + ',' +
     '"sl":' + str.tostring(longSL) + ',' +
     '"tp":' + str.tostring(longTP) + '}'

shortMessage =
     '{"bot":"BABEL_V1",' +
     '"action":"SELL",' +
     '"symbol":"' + syminfo.ticker + '",' +
     '"price":' + str.tostring(close) + ',' +
     '"score":' + str.tostring(shortScore) + ',' +
     '"sl":' + str.tostring(shortSL) + ',' +
     '"tp":' + str.tostring(shortTP) + '}'

//====================================================
// ORDERS
//====================================================

if longSignal
    strategy.entry("BABEL LONG", strategy.long, alert_message=longMessage)

if shortSignal
    strategy.entry("BABEL SHORT", strategy.short, alert_message=shortMessage)

//====================================================
// EXITS
//====================================================

if strategy.position_size > 0
    strategy.exit(
         "LONG EXIT",
         "BABEL LONG",
         stop=longSL,
         limit=longTP)

if strategy.position_size < 0
    strategy.exit(
         "SHORT EXIT",
         "BABEL SHORT",
         stop=shortSL,
         limit=shortTP)

//====================================================
// VISUALS
//====================================================

plot(ema200, "EMA 200", linewidth=2)
plot(ema21, "EMA 21")
plot(ema55, "EMA 55")

plotshape(
     longSignal,
     title="BABEL BUY",
     style=shape.labelup,
     location=location.belowbar,
     text="BABEL BUY")

plotshape(
     shortSignal,
     title="BABEL SELL",
     style=shape.labeldown,
     location=location.abovebar,
     text="BABEL SELL")

bgcolor(
     bullTrend ? color.new(color.green, 92) :
     bearTrend ? color.new(color.red, 92) :
     na)

//====================================================
// ALERT CONDITIONS
//====================================================

alertcondition(
     longSignal,
     title="BABEL BUY",
     message="BABEL BUY SIGNAL")

alertcondition(
     shortSignal,
     title="BABEL SELL",
     message="BABEL SELL SIGNAL")