//=============================================================================
// CROSS 4
//=============================================================================

c4ai = f_maIndex(cross4A) - 1
c4bi = f_maIndex(cross4B) - 1

c4a = array.get(maValues, c4ai)
c4b = array.get(maValues, c4bi)

