//@version=5
strategy("MNQ Midpoint Retest (7x2R + 3xRunner 4R/BE) FINAL", overlay=true,
     default_qty_type=strategy.fixed,
     default_qty_value=10,
     pyramiding=10,
     calc_on_every_tick=true)

// ================= TIME =================
tz = "America/New_York"

rangeSession = not na(time(timeframe.period, "0800-0815", tz))
tradeSession = not na(time(timeframe.period, "0945-1100", tz))

endSession = not tradeSession and tradeSession[1]
killzoneSession = tradeSession

// ================= RESET =================
newDay = ta.change(time("D"))

var float rHigh = na
var float rLow = na
var float mid = na
var bool rangeLocked = false

var float entry = na
var bool lockedForDay = false

var bool longTP1Hit = false
var bool shortTP1Hit = false

if newDay
    rHigh := na
    rLow := na
    mid := na
    rangeLocked := false
    entry := na
    lockedForDay := false
    longTP1Hit := false
    shortTP1Hit := false

// ================= RANGE BUILD =================
if rangeSession and not rangeLocked
    rHigh := na(rHigh) ? high : math.max(rHigh, high)
    rLow := na(rLow) ? low : math.min(rLow, low)

if not rangeSession and not rangeLocked and not na(rHigh) and not na(rLow)
    mid := (rHigh + rLow) / 2
    rangeLocked := true

// ================= FORCE CLOSE =================
if endSession and strategy.position_size != 0
    strategy.close_all(comment="Session End")

// ================= BREAKOUT =================
aboveRange = rangeLocked and close > rHigh
belowRange = rangeLocked and close < rLow

var int breakoutState = 0
if aboveRange
    breakoutState := 1
if belowRange
    breakoutState := -1

// ================= ONE TRADE ONLY =================
oneTradeOnly = strategy.opentrades == 0

// ================= CONDITIONS =================
canTrade = rangeLocked and not lockedForDay and tradeSession

// ===== ORIGINAL ENTRY LOGIC (UNCHANGED) =====
touchLong = canTrade and breakoutState == 1 and low <= mid
touchShort = canTrade and breakoutState == -1 and high >= mid

// ================= ENTRY =================
if touchLong and oneTradeOnly
    strategy.entry("LONG", strategy.long)

if touchShort and oneTradeOnly
    strategy.entry("SHORT", strategy.short)

// ================= ENTRY CAPTURE =================
if strategy.position_size != 0 and strategy.position_size[1] == 0
    entry := strategy.position_avg_price
    longTP1Hit := false
    shortTP1Hit := false

// ================= STOPS =================
longStop = rLow
shortStop = rHigh

// ================= RISK =================
longRisk = na(entry) ? na : entry - longStop
shortRisk = na(entry) ? na : shortStop - entry

// ================= TARGETS =================
longTP1 = na(entry) ? na : entry + (2 * longRisk)
longTP2 = na(entry) ? na : entry + (4 * longRisk)

shortTP1 = na(entry) ? na : entry - (2 * shortRisk)
shortTP2 = na(entry) ? na : entry - (4 * shortRisk)

// ================= TP1 HIT TRACKING =================
if strategy.position_size > 0 and not longTP1Hit and high >= longTP1
    longTP1Hit := true

if strategy.position_size < 0 and not shortTP1Hit and low <= shortTP1
    shortTP1Hit := true

// ================= BREAKEVEN LOGIC =================
beStopLong = longTP1Hit ? entry : longStop
beStopShort = shortTP1Hit ? entry : shortStop

// ================= EXITS =================
strategy.exit("L_TP1", "LONG", qty_percent=70, limit=longTP1, stop=longStop)
strategy.exit("S_TP1", "SHORT", qty_percent=70, limit=shortTP1, stop=shortStop)

strategy.exit("L_RUN", "LONG", qty_percent=30, limit=longTP2, stop=beStopLong)
strategy.exit("S_RUN", "SHORT", qty_percent=30, limit=shortTP2, stop=beStopShort)

// ================= VISUALS =================
plot(rangeLocked ? rHigh : na, "Range High", color=color.green)
plot(rangeLocked ? rLow : na, "Range Low", color=color.red)
plot(rangeLocked ? mid : na, "Mid", color=color.blue)

bgcolor(killzoneSession ? color.new(color.gray, 90) : na)

plotshape(aboveRange, location=location.belowbar, style=shape.triangleup, color=color.green)
plotshape(belowRange, location=location.abovebar, style=shape.triangledown, color=color.red)