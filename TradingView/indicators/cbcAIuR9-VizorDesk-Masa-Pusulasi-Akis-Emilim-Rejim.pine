//@version=6
indicator("VizorDesk Masa Pusulasi - Akis Emilim Rejim", overlay=false, max_labels_count=100)

// ---- Renkler ----
c_green  = #00FF66
c_red    = #FF3355
c_blue   = #7DD3FC
c_purple = #A78BFA
c_amber  = #FFB020
c_bg     = #0A0F1A
c_lbl    = #8593A2

// ---- Inputs ----
lenAvg     = input.int(20,    "Ortalama Pencere (hacim/ATR)", minval=5)
lenFlow    = input.int(8,     "Akis Yumusatma", minval=1)
absVolMult = input.float(1.6, "Emilim - Hacim esigi (x ort)", minval=1.0, step=0.1)
absRngMult = input.float(0.7, "Emilim - Menzil esigi (x ATR)", minval=0.1, step=0.1)
sweepLook  = input.int(20,    "Sweep Lookback", minval=5)
showRegime = input.bool(true, "Rejim arka plani")
showAbsorb = input.bool(true, "Emilim isaretleri")
showSweep  = input.bool(true, "Sweep isaretleri")
showHUD    = input.bool(true, "HUD paneli")
hudPos     = input.string("Alt-Sag", "HUD Konumu", options=["Ust-Sag","Alt-Sag","Ust-Sol","Alt-Sol"])

// ---- AKIS: proxy bar-delta (hacmi mum-ici konuma gore bol) ----
rng     = high - low
buyVol  = rng > 0 ? volume * (close - low) / rng : volume * 0.5
sellVol = rng > 0 ? volume * (high - close) / rng : volume * 0.5
delta   = buyVol - sellVol
volAvg  = ta.sma(volume, lenAvg)
deltaN  = volAvg > 0 ? 100.0 * delta / volAvg : 0.0
flow    = ta.ema(deltaN, lenFlow)

// ---- REJIM: oynaklik sikisma / genisleme ----
atrVal  = ta.atr(lenAvg)
atrBase = ta.sma(atrVal, lenAvg * 3)
regime  = atrBase > 0 ? atrVal / atrBase : 1.0
isExp   = regime > 1.10
isComp  = regime < 0.90

// ---- EMILIM: yuksek hacim + kucuk menzil + guclu tek-yon akis ----
volHot   = volume > absVolMult * volAvg
rngSmall = rng < absRngMult * atrVal
strong   = math.abs(deltaN) > 40.0
absorb   = showAbsorb and volHot and rngSmall and strong
absorbBuySide  = absorb and delta > 0
absorbSellSide = absorb and delta < 0

// ---- SWEEP: likidite supurme ----
hh = ta.highest(high, sweepLook)[1]
ll = ta.lowest(low,  sweepLook)[1]
sweepUp = showSweep and high > hh and close < hh
sweepDn = showSweep and low  < ll and close > ll

// ---- Render ----
colBar = deltaN >= 0 ? color.new(c_green, 25) : color.new(c_red, 25)
plot(deltaN, "Akis Delta", style=plot.style_columns, color=colBar, display=display.pane)
plot(flow, "Akis Yumusak", color=color.new(c_blue, 0), linewidth=2, display=display.pane)
hline(0, "Sifir", color=color.new(color.gray, 60))

color regimeBg = na
if showRegime and isExp
    regimeBg := color.new(c_purple, 90)
else if showRegime and isComp
    regimeBg := color.new(color.gray, 92)
bgcolor(regimeBg)

plotshape(absorbBuySide,  title="Emilim - alim emiliyor",  style=shape.diamond,      location=location.top,    size=size.tiny, color=color.new(c_amber, 0), display=display.pane)
plotshape(absorbSellSide, title="Emilim - satim emiliyor", style=shape.diamond,      location=location.bottom, size=size.tiny, color=color.new(c_amber, 0), display=display.pane)
plotshape(sweepUp, title="Sweep - ust likidite", style=shape.triangledown, location=location.top,    size=size.tiny, color=color.new(c_red, 0), display=display.pane)
plotshape(sweepDn, title="Sweep - alt likidite", style=shape.triangleup,   location=location.bottom, size=size.tiny, color=color.new(c_green, 0), display=display.pane)

// ---- HUD (TEK PANEL - metin + sayi/oran) ----
_pos = hudPos == "Ust-Sag" ? position.top_right : hudPos == "Alt-Sag" ? position.bottom_right : hudPos == "Ust-Sol" ? position.top_left : position.bottom_left

flowR    = math.round(flow)
flowStr  = (flowR >= 0 ? "+" : "") + str.tostring(flowR)
katRatio = volAvg > 0 ? volume / volAvg : 0.0
katStr   = str.tostring(katRatio, "#.0") + "x"
rejStr   = str.tostring(regime, "#.00") + "x"

akisTxt = flow > 20 ? "ALICI" : flow < -20 ? "SATICI" : "DENGE"
katTxt  = volume > 1.2 * volAvg ? "GERCEK" : "DUSUK"
emilTxt = absorbBuySide ? "ALIM emiliyor" : absorbSellSide ? "SATIM emiliyor" : "yok"
rejTxt  = isExp ? "GENISLEME" : isComp ? "SIKISMA" : "NORMAL"

akisVal = flowStr + "  " + akisTxt
katVal  = katStr + "  " + katTxt
rejVal  = rejStr + "  " + rejTxt

color akisCol = flow > 20 ? c_green : flow < -20 ? c_red : color.new(color.white, 15)
color katCol  = volume > 1.2 * volAvg ? c_green : color.new(color.white, 40)
color emilCol = absorb ? c_amber : color.new(color.white, 40)
color rejCol  = isExp ? c_purple : isComp ? c_blue : color.new(color.white, 25)

var table hud = table.new(_pos, 2, 6, bgcolor=color.new(c_bg, 6), frame_color=color.new(c_green, 55), frame_width=1, border_color=color.new(#1E2836, 25), border_width=1)
if barstate.islast and showHUD
    table.cell(hud, 0, 0, " VIZORDESK", text_color=c_green, text_size=size.normal, text_halign=text.align_left)
    table.cell(hud, 1, 0, "Masa Pusulasi ", text_color=color.new(color.white, 40), text_size=size.small, text_halign=text.align_right)
    table.cell(hud, 0, 1, " AKIS", text_color=c_lbl, text_size=size.small, text_halign=text.align_left)
    table.cell(hud, 1, 1, akisVal + " ", text_color=akisCol, text_size=size.small, text_halign=text.align_right)
    table.cell(hud, 0, 2, " KATILIM", text_color=c_lbl, text_size=size.small, text_halign=text.align_left)
    table.cell(hud, 1, 2, katVal + " ", text_color=katCol, text_size=size.small, text_halign=text.align_right)
    table.cell(hud, 0, 3, " EMILIM", text_color=c_lbl, text_size=size.small, text_halign=text.align_left)
    table.cell(hud, 1, 3, emilTxt + " ", text_color=emilCol, text_size=size.small, text_halign=text.align_right)
    table.cell(hud, 0, 4, " REJIM", text_color=c_lbl, text_size=size.small, text_halign=text.align_left)
    table.cell(hud, 1, 4, rejVal + " ", text_color=rejCol, text_size=size.small, text_halign=text.align_right)
    table.cell(hud, 0, 5, " vizordesk.com", text_color=color.new(color.white, 50), text_size=size.small, text_halign=text.align_left)
    table.cell(hud, 1, 5, "sinyal degil, gozlem ", text_color=color.new(color.white, 60), text_size=size.small, text_halign=text.align_right)

// ---- Alarmlar (durum, sinyal degil) ----
alertcondition(absorb, "Emilim tespit", "VizorDesk: Emilim tespit edildi.")
alertcondition(sweepUp or sweepDn, "Likidite sweep", "VizorDesk: Likidite supurme tespit edildi.")
