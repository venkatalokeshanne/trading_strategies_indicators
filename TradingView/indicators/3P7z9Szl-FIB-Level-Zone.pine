//@version=6
indicator('FIB_Level_Zone', overlay = true, max_lines_count = 100, max_labels_count = 100)

// ───────────────────────────────
// User input
Par = input.string('Week', options = ['Quarter', 'Month', 'Week', 'Day'], title = 'Period')
ext = input.int(200, 'Line forward length (bars)', minval = 1, maxval = 500, group = 'Display')  // TV hard limit = bar_index + 500

// ── Zone / fill settings ──
showFills   = input.bool(true,          'Show zone fills',                     group = 'Zones')
fillTransp  = input.int(88,             'Fill transparency',   minval = 0, maxval = 100, group = 'Zones')
upZoneCol   = input.color(color.orange, 'Upper zones  (R3-R4, R5-R6)',         group = 'Zones')
dnZoneCol   = input.color(color.aqua,   'Lower zones  (F3-F4, F5-F6)',         group = 'Zones')
showMidFill = input.bool(false,         'Fill Sbull–Sbear band',               group = 'Zones')
midZoneCol  = input.color(color.gray,   'Sbull–Sbear fill colour',             group = 'Zones')
tintLines   = input.bool(true,          'Colour boundary lines to match zones',group = 'Zones')
brdStyle    = input.string('Dashed',    'Zone boundary style', options = ['Solid', 'Dashed', 'Dotted'], group = 'Zones')

brdLineStyle = brdStyle == 'Solid' ? line.style_solid : brdStyle == 'Dashed' ? line.style_dashed : line.style_dotted

// ───────────────────────────────
// Pre-fetch all timeframes

// Quarterly
qh = request.security(syminfo.tickerid, '3M', high[1])
ql = request.security(syminfo.tickerid, '3M', low[1])
qc = request.security(syminfo.tickerid, '3M', open)
qh0 = request.security(syminfo.tickerid, '3M', high)
ql0 = request.security(syminfo.tickerid, '3M', low)

// Monthly
mh = request.security(syminfo.tickerid, 'M', high[1])
ml = request.security(syminfo.tickerid, 'M', low[1])
mc = request.security(syminfo.tickerid, 'M', open)
mh0 = request.security(syminfo.tickerid, 'M', high)
ml0 = request.security(syminfo.tickerid, 'M', low)

// Weekly
wh = request.security(syminfo.tickerid, 'W', high[1])
wl = request.security(syminfo.tickerid, 'W', low[1])
wc = request.security(syminfo.tickerid, 'W', open)
wh0 = request.security(syminfo.tickerid, 'W', high)
wl0 = request.security(syminfo.tickerid, 'W', low)

// Daily
dh = request.security(syminfo.tickerid, 'D', high[1])
dl = request.security(syminfo.tickerid, 'D', low[1])
dc = request.security(syminfo.tickerid, 'D', open)
dh0 = request.security(syminfo.tickerid, 'D', high)
dl0 = request.security(syminfo.tickerid, 'D', low)

// ───────────────────────────────
// Select timeframe values
MHg = Par == 'Quarter' ? qh : Par == 'Month' ? mh : Par == 'Week' ? wh : dh
MLw = Par == 'Quarter' ? ql : Par == 'Month' ? ml : Par == 'Week' ? wl : dl
MCl = Par == 'Quarter' ? qc : Par == 'Month' ? mc : Par == 'Week' ? wc : dc
MHg0 = Par == 'Quarter' ? qh0 : Par == 'Month' ? mh0 : Par == 'Week' ? wh0 : dh0
MLw0 = Par == 'Quarter' ? ql0 : Par == 'Month' ? ml0 : Par == 'Week' ? wl0 : dl0

// ───────────────────────────────
// Calculations
MRng = MHg - MLw
Sbull = math.round((MCl + MRng * 0.073) / 0.05) * 0.05
Sbear = math.round((MCl - MRng * 0.073) / 0.05) * 0.05

Rchnl3 = math.round((MCl + MRng * 0.3820) / 0.05) * 0.05
Rchnl4 = math.round((MCl + MRng * 0.6180) / 0.05) * 0.05
Rchnl5 = math.round((MCl + MRng * 1.0000) / 0.05) * 0.05
Rchnl6 = math.round((MCl + MRng * 1.2720) / 0.05) * 0.05

Fchnl3 = math.round((MCl - MRng * 0.3820) / 0.05) * 0.05
Fchnl4 = math.round((MCl - MRng * 0.6180) / 0.05) * 0.05
Fchnl5 = math.round((MCl - MRng * 1.0000) / 0.05) * 0.05
Fchnl6 = math.round((MCl - MRng * 1.2720) / 0.05) * 0.05

// ───────────────────────────────
// Period change detection
isNewWeek = ta.change(time('W'))
isNewMonth = ta.change(time('M'))
isNewQuarter = ta.change(time('3M'))
isNewDay = ta.change(time('D'))

condWeek = Par == 'Week' and bool(isNewWeek)
condMonth = Par == 'Month' and bool(isNewMonth)
condQuarter = Par == 'Quarter' and bool(isNewQuarter)
condDay = Par == 'Day' and bool(isNewDay)

newPeriod = condWeek or condMonth or condQuarter or condDay

// ───────────────────────────────
// Drawing containers (one set per active period)
var array<line>     lines = array.new_line()
var array<label>    lbls  = array.new_label()
var array<linefill> fills = array.new<linefill>()      // ← NEW: zone shading
var int periodStartBar = na

// clear helper (deletes fills, lines and labels)
f_clear_all() =>
    // delete linefills FIRST (they are attached to the lines)
    if array.size(fills) > 0
        k = array.size(fills) - 1
        while k >= 0
            linefill.delete(array.get(fills, k))
            k := k - 1
        array.clear(fills)
    // delete lines
    if array.size(lines) > 0
        i = array.size(lines) - 1
        while i >= 0
            line.delete(array.get(lines, i))
            i := i - 1
        array.clear(lines)
    // delete labels
    if array.size(lbls) > 0
        j = array.size(lbls) - 1
        while j >= 0
            label.delete(array.get(lbls, j))
            j := j - 1
        array.clear(lbls)

// values array (order: Sbull, Sbear, R3,R4,R5,R6, F3,F4,F5,F6)
f_values_array(sbull_val, sbear_val) =>
    vals = array.new_float()
    array.push(vals, sbull_val)   // 0
    array.push(vals, sbear_val)   // 1
    array.push(vals, Rchnl3)      // 2
    array.push(vals, Rchnl4)      // 3
    array.push(vals, Rchnl5)      // 4
    array.push(vals, Rchnl6)      // 5
    array.push(vals, Fchnl3)      // 6
    array.push(vals, Fchnl4)      // 7
    array.push(vals, Fchnl5)      // 8
    array.push(vals, Fchnl6)      // 9
    vals

// helper to return a text name for an index
f_name_for_index(i) =>
    s = "?"
    if i == 0
        s := "Sbull"
    else if i == 1
        s := "Sbear"
    else if i == 2
        s := "Rchnl3"
    else if i == 3
        s := "Rchnl4"
    else if i == 4
        s := "Rchnl5"
    else if i == 5
        s := "Rchnl6"
    else if i == 6
        s := "Fchnl3"
    else if i == 7
        s := "Fchnl4"
    else if i == 8
        s := "Fchnl5"
    else if i == 9
        s := "Fchnl6"
    s

// ── NEW: shade the band between two already-created lines ──
f_add_fill(i1, i2, col) =>
    if array.size(lines) > math.max(i1, i2)
        lf = linefill.new(array.get(lines, i1), array.get(lines, i2), color.new(col, fillTransp))
        array.push(fills, lf)

// create lines + labels + fills for the new period
f_create_period(startBar, sbull_val, sbear_val) =>
    vals = f_values_array(sbull_val, sbear_val)
    n = array.size(vals)
    for i = 0 to n - 1
        v = array.get(vals, i)
        // inline style selection (no tuple returned)
        ln_color = color.gray
        ln_width = 1
        ln_style = brdLineStyle
        lbl_bg = color.new(color.black, 70)
        lbl_txt = color.white
        if i == 0
            ln_color := color.new(color.green, 0)
            ln_width := 2
            ln_style := line.style_solid
            lbl_bg := color.new(color.green, 60)
        else if i == 1
            ln_color := color.new(color.red, 0)
            ln_width := 2
            ln_style := line.style_solid
            lbl_bg := color.new(color.red, 60)
        else if i >= 2 and i <= 5
            ln_color := tintLines ? color.new(upZoneCol, 0) : color.new(color.blue, 30 + (i - 2) * 10)
            ln_width := 1
            lbl_bg := color.new(tintLines ? upZoneCol : color.blue, 70)
        else
            ln_color := tintLines ? color.new(dnZoneCol, 0) : color.new(color.orange, 30 + (i - 6) * 10)
            ln_width := 1
            lbl_bg := color.new(tintLines ? dnZoneCol : color.orange, 70)

        // create line (x1 clamped: TV rejects x-coords below bar_index - 10000)
        l = line.new(x1 = math.max(startBar, bar_index - 9999), y1 = v, x2 = bar_index + ext, y2 = v,
                     xloc = xloc.bar_index, extend = extend.none, color = ln_color, width = ln_width, style = ln_style)
        array.push(lines, l)

        // create label on current price bar
        txt = f_name_for_index(i) + " " + str.tostring(v, format.mintick)
        lb = label.new(bar_index, v, text = txt, xloc = xloc.bar_index, yloc = yloc.price,
                       style = label.style_label_right, color = lbl_bg, textcolor = lbl_txt, size = size.small)
        array.push(lbls, lb)

    // ── NEW: light fills between the paired levels (AmiBroker-style bands) ──
    if showFills
        f_add_fill(2, 3, upZoneCol)   // Rchnl3 → Rchnl4   (lower resistance band)
        f_add_fill(4, 5, upZoneCol)   // Rchnl5 → Rchnl6   (upper resistance band)
        f_add_fill(6, 7, dnZoneCol)   // Fchnl3 → Fchnl4   (upper support band)
        f_add_fill(8, 9, dnZoneCol)   // Fchnl5 → Fchnl6   (lower support band)
        if showMidFill
            f_add_fill(1, 0, midZoneCol)  // Sbear → Sbull  (pivot band)

// update lines + labels each bar
// (linefills are bound to their lines, so they stretch/move automatically)
f_update_period(startBar, sbull_val, sbear_val) =>
    vals = f_values_array(sbull_val, sbear_val)
    // update lines
    n = math.min(array.size(vals), array.size(lines))
    for i = 0 to n - 1
        l = array.get(lines, i)
        v = array.get(vals, i)
        line.set_xy1(l, math.max(startBar, bar_index - 9999), v)
        line.set_xy2(l, bar_index + ext, v)
    // update labels
    m = math.min(array.size(lbls), array.size(vals))
    for i = 0 to m - 1
        lb = array.get(lbls, i)
        v = array.get(vals, i)
        label.set_xy(lb, bar_index, v)
        label.set_text(lb, f_name_for_index(i) + " " + str.tostring(v, format.mintick))

// On detection of new period -> recreate everything
if newPeriod
    periodStartBar := bar_index
    f_clear_all()
    f_create_period(periodStartBar, Sbull, Sbear)
else
    if not na(periodStartBar) and array.size(lines) >= 1
        f_update_period(periodStartBar, Sbull, Sbear)
