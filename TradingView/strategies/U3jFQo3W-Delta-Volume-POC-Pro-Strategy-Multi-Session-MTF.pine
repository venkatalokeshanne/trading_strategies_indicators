//@version=6
strategy("Delta Volume & POC Pro Strategy - Multi-Session MTF", shorttitle="Pro Delta AllSessions", overlay=true, max_boxes_count=500, max_lines_count=100, max_labels_count=150, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, max_bars_back=1000)

// --- Groups ---
string G_SESS  = "Session & Time Filtering"
string G_BACK  = "Strategy Backtest Settings"
string G_TRAIL = "Trailing Stop Loss"
string G_PROF  = "Price-Level Delta Profile"
string G_POC   = "POC Cluster Zones"
string G_SFP   = "Swing Failure Patterns (SFP)"

// --- Inputs: Sessions ---
bool   useSession   = input.bool(false, "Filter by Sessions (Uncheck to trade 24/7)", group=G_SESS)
bool   useLondon    = input.bool(true, "Trade London Session", group=G_SESS)
string londonSess   = input.session("0300-1200", "London Time", group=G_SESS)
bool   useNY        = input.bool(true, "Trade NY Session", group=G_SESS)
string nySess       = input.session("0800-1700", "NY Time", group=G_SESS)
bool   useAsia      = input.bool(true, "Trade Asia Session", group=G_SESS)
string asiaSess     = input.session("1900-0400", "Asia Time", group=G_SESS)
bool   showSessColor= input.bool(true, "Highlight Sessions on Chart", group=G_SESS)

// --- Inputs: Strategy ---
int    orderQty     = input.int(1, "Order Quantity", minval=1, group=G_BACK)
float  stopLossPct  = input.float(1.0, "Initial Stop Loss %", minval=0.01, step=0.01, group=G_BACK)
float  takeProfitPct = input.float(2.0, "Fixed Take Profit %", minval=0.01, step=0.01, group=G_BACK)
bool   showDash     = input.bool(true, "Show Performance Dashboard", group=G_BACK)
bool   showExits    = input.bool(true, "Show SL/TP Lines", group=G_BACK)

// --- Inputs: Trailing Stop ---
bool   useTrailing  = input.bool(false, "Enable Trailing Stop", group=G_TRAIL)
float  trailPct     = input.float(0.5, "Trailing Activation %", minval=0.01, step=0.01, group=G_TRAIL, tooltip="Price must move this % into profit to activate trailing.")
float  trailOffPct  = input.float(0.2, "Trailing Offset %", minval=0.01, step=0.01, group=G_TRAIL, tooltip="Distance to trail behind the price peak.")

// --- Inputs: Logic Toggles ---
bool   showProfile  = input.bool(true, "Show Delta Profile", group=G_PROF)
int    profLookback = input.int(100, "Profile Lookback", group=G_PROF)
bool   showPOCZones = input.bool(true, "Show POC Cluster Zones", group=G_POC)
string sfpTimeframe = input.timeframe("", "Signal Analysis Timeframe", group=G_SFP)
bool   useTrendFilt = input.bool(true, "EMA 200 Trend Filter", group=G_SFP)

// --- Constants ---
color REDC = #f23645
color GRNC = #089981

// --- Session Logic ---
inSession(sessStr) => not na(time(timeframe.period, sessStr, syminfo.timezone))
isLondon = useLondon and inSession(londonSess)
isNY     = useNY and inSession(nySess)
isAsia   = useAsia and inSession(asiaSess)
canTrade = not useSession or isLondon or isNY or isAsia

bgcolor(showSessColor and isLondon ? color.new(color.orange, 90) : na, title="London Highlight")
bgcolor(showSessColor and isNY     ? color.new(color.blue, 90)   : na, title="NY Highlight")
bgcolor(showSessColor and isAsia   ? color.new(color.purple, 90) : na, title="Asia Highlight")

// --- Core Logic: Intrabar Delta & POC ---
calcDeltaAndPOC() =>
    float bV = 0.0, float sV = 0.0, float maxV = 0.0, float pP = na
    [ltfC, ltfV, ltfH, ltfL] = request.security_lower_tf(syminfo.tickerid, "1", [close, volume, high, low])
    int sz = array.size(ltfC)
    if sz > 0
        for i = 0 to sz - 1
            float c = array.get(ltfC, i), float v = array.get(ltfV, i), float h = array.get(ltfH, i), float l = array.get(ltfL, i)
            if not na(c) and not na(v)
                float prevC = i == 0 ? nz(close[1], open) : array.get(ltfC, i - 1)
                if c > prevC
                    bV += v
                else if c < prevC
                    sV += v
                else
                    bV += v * 0.5, sV += v * 0.5
                if v > maxV
                    maxV := v, pP := (h + l) / 2
    [bV - sV, pP]

[delta, pocPrice] = calcDeltaAndPOC()

// POC Clustering Logic
var float[] pHist = array.new_float()
var int[] dHist = array.new_int()
if not na(pocPrice)
    array.unshift(pHist, pocPrice), array.unshift(dHist, delta >= 0 ? 1 : -1)
if array.size(pHist) > 50
    array.pop(pHist), array.pop(dHist)

var box[] pocBoxes = array.new_box()
if showPOCZones and barstate.isconfirmed and array.size(pHist) >= 5
    int mCount = 0, float avgP = 0.0, float curP = array.get(pHist, 0), int curD = array.get(dHist, 0)
    for i = 0 to 4
        p = array.get(pHist, i), d = array.get(dHist, i)
        if d == curD and math.abs(p - curP) <= (syminfo.mintick * 10)
            mCount += 1, avgP += p
    if mCount >= 3
        avgP /= mCount
        array.push(pocBoxes, box.new(bar_index - 5, avgP + (syminfo.mintick * 2), bar_index + 10, avgP - (syminfo.mintick * 2), bgcolor=color.new(#5b9cf6, 70), border_color=color.new(#5b9cf6, 0)))
    if array.size(pocBoxes) > 10
        box.delete(array.shift(pocBoxes))

// --- Price-Level Delta Profile ---
float tickSize = syminfo.mintick * 5
roundedPrice(p) => math.round(p / tickSize) * tickSize
var map<float, float> dMap = map.new<float, float>()
var box[] profBoxes = array.new<box>()

if showProfile and barstate.islast
    dMap.clear()
    int lookback = math.min(profLookback, bar_index)
    for i = 0 to lookback - 1
        float rp = roundedPrice(nz(close[i])), float r = nz(high[i]) - nz(low[i])
        float bP = r == 0 ? 0 : (close[i] - low[i]) / r * volume[i]
        float sP = r == 0 ? 0 : (high[i] - close[i]) / r * volume[i]
        exist = dMap.get(rp)
        dMap.put(rp, (na(exist) ? 0 : exist) + (bP - sP))
    for b in profBoxes
        box.delete(b)
    array.clear(profBoxes)
    float maxAbsD = 0.0, float[] pKeys = dMap.keys()
    for k in pKeys
        maxAbsD := math.max(maxAbsD, math.abs(dMap.get(k)))
    for k in pKeys
        v = dMap.get(k)
        if v != 0
            int xS = bar_index, int xE = bar_index + int((v / maxAbsD) * 50)
            color bc = v > 0 ? color.new(GRNC, 40) : color.new(REDC, 40)
            array.push(profBoxes, box.new(math.min(xS, xE), k + (tickSize / 2), math.max(xS, xE), k - (tickSize / 2), bgcolor=bc, border_color=color.new(bc, 60)))

// --- SFP Logic & Execution ---
getSFP() =>
    lowestL  = ta.lowest(low[1], 10)
    highestH = ta.highest(high[1], 10)
    [low < lowestL and close > lowestL, high > highestH and close < highestH]

[bSFP_raw, sSFP_raw] = request.security(syminfo.tickerid, sfpTimeframe, getSFP(), lookahead=barmerge.lookahead_on)
bool bSFP = bSFP_raw and barstate.isconfirmed
bool sSFP = sSFP_raw and barstate.isconfirmed

float ema200 = ta.ema(close, 200)
bool bullTrendOk = not useTrendFilt or close > ema200
bool bearTrendOk = not useTrendFilt or close < ema200

if bSFP and bullTrendOk and canTrade
    strategy.entry("Long", strategy.long, qty=orderQty, comment="★SFP Bull")
if sSFP and bearTrendOk and canTrade
    strategy.entry("Short", strategy.short, qty=orderQty, comment="★SFP Bear")

float slLevel = na
float tpLevel = na
if strategy.position_size > 0
    slLevel := strategy.position_avg_price * (1 - stopLossPct/100)
    tpLevel := strategy.position_avg_price * (1 + takeProfitPct/100)
    int tPoints = int((strategy.position_avg_price * trailPct / 100) / syminfo.mintick)
    int tOffset = int((strategy.position_avg_price * trailOffPct / 100) / syminfo.mintick)
    strategy.exit("Exit L", "Long", stop=slLevel, limit=tpLevel, trail_points=useTrailing ? tPoints : na, trail_offset=useTrailing ? tOffset : na)
if strategy.position_size < 0
    slLevel := strategy.position_avg_price * (1 + stopLossPct/100)
    tpLevel := strategy.position_avg_price * (1 - takeProfitPct/100)
    int tPoints = int((strategy.position_avg_price * trailPct / 100) / syminfo.mintick)
    int tOffset = int((strategy.position_avg_price * trailOffPct / 100) / syminfo.mintick)
    strategy.exit("Exit S", "Short", stop=slLevel, limit=tpLevel, trail_points=useTrailing ? tPoints : na, trail_offset=useTrailing ? tOffset : na)

// --- Visualization ---
plot(showExits ? slLevel : na, "Stop Loss", REDC, 1, plot.style_linebr)
plot(showExits ? tpLevel : na, "Take Profit", GRNC, 1, plot.style_linebr)

bool showBull = bSFP and bullTrendOk and canTrade
bool showBear = sSFP and bearTrendOk and canTrade
plotshape(showBull, "★SFP Bull", shape.triangleup, location.belowbar, GRNC, text="★SFP", textcolor=GRNC)
plotshape(showBear, "★SFP Bear", shape.triangledown, location.abovebar, REDC, text="★SFP", textcolor=REDC)

if showDash and barstate.islast
    var table perfT = table.new(position.top_right, 2, 5, bgcolor=color.new(chart.bg_color, 10), border_width=1)
    wr = strategy.wintrades / math.max(1, strategy.closedtrades) * 100
    curTF = sfpTimeframe == "" ? timeframe.period : sfpTimeframe
    table.cell(perfT, 0, 0, "Dashboard", text_color=chart.fg_color, text_size=size.small)
    table.cell(perfT, 1, 0, curTF, text_color=#5b9cf6, text_size=size.small)
    table.cell(perfT, 0, 1, "Win Rate", text_color=chart.fg_color)
    table.cell(perfT, 1, 1, str.tostring(wr, "#.##") + "%", text_color=GRNC)
    table.cell(perfT, 0, 2, "Net Profit", text_color=chart.fg_color)
    table.cell(perfT, 1, 2, str.tostring(strategy.netprofit, "#.##"), text_color=strategy.netprofit >= 0 ? GRNC : REDC)
    table.cell(perfT, 0, 3, "Total Trades", text_color=chart.fg_color)
    table.cell(perfT, 1, 3, str.tostring(strategy.closedtrades), text_color=chart.fg_color)
