//@version=6
indicator('Vela Horaria Vertical Configurable', overlay = true)

// ================== Inputs - Vela 1 ==================
hora1 = input.int(19, 'Hora vela 1 (ARG, 0-23)', minval = 0, maxval = 23)
minuto1 = input.int(0, 'Minuto vela 1 (ARG, 0-59)', minval = 0, maxval = 59)
color1 = input.color(color.new(color.blue, 60), 'Color franja 1')
activar1 = input.bool(true, 'Activar franja 1')

// ================== Inputs - Vela 2 ==================
hora2 = input.int(21, 'Hora vela 2 (ARG, 0-23)', minval = 0, maxval = 23)
minuto2 = input.int(0, 'Minuto vela 2 (ARG, 0-59)', minval = 0, maxval = 59)
color2 = input.color(color.new(color.orange, 60), 'Color franja 2')
activar2 = input.bool(true, 'Activar franja 2')

// ================== Construyo el timestamp exacto del ancla para el día de la vela actual (en ARG) ==================
y = year(time, 'America/Argentina/Buenos_Aires')
mo = month(time, 'America/Argentina/Buenos_Aires')
d = dayofmonth(time, 'America/Argentina/Buenos_Aires')

anchorTime1 = timestamp('America/Argentina/Buenos_Aires', y, mo, d, hora1, minuto1)
anchorTime2 = timestamp('America/Argentina/Buenos_Aires', y, mo, d, hora2, minuto2)

// ================== Rango de la vela actual (inicio y fin, en ms) ==================
barStart = time
barEnd = time + timeframe.in_seconds() * 1000

// ================== ¿El ancla cae dentro de esta vela? ==================
esVela1 = activar1 and anchorTime1 >= barStart and anchorTime1 < barEnd
esVela2 = activar2 and anchorTime2 >= barStart and anchorTime2 < barEnd

// ================== Franja vertical de fondo ==================
bgcolor(esVela1 ? color1 : esVela2 ? color2 : na)
