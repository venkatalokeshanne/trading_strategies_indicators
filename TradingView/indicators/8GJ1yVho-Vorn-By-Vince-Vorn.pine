//@version=6
indicator("Vince Vorn", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// All session logic is anchored to New York time regardless of chart timezone
tzNY = "America/New_York"

// ================= GROUPS =================
gTh = "Theme"
gS = "Sessions"
gL = "Key levels"
gT = "Levels table"
gW = "Sweeps"
gM = "Overlays"
gO = "Opening range"
gB = "Volume badge"

// ================= THEME =================
themeIn = input.string("Dark (default)", "Color theme", options=["Dark (default)", "White (classic)"], group=gTh)
paintBg      = input.bool(true, "White theme paints chart background", group=gTh)
paintCandles = input.bool(true, "White theme recolors candles", group=gTh)

isWhite = themeIn == "White (classic)"

// Dark theme = the color inputs below (their defaults ARE the dark scheme, so you can hand-tune it).
// White is a fixed designed palette: white background, classic green/red candles.
f_c(color inp, color wht) =>
    isWhite ? wht : inp

// Base background paint — must be first so session tints layer on top of it
bgcolor(paintBg and isWhite ? color.new(#ffffff, 0) : na)

// bgcolor only paints where bars exist — this box paints the FUTURE area (right of the last candle) white too
var box futBox = na
if barstate.islast
    if paintBg and isWhite
        if na(futBox)
            futBox := box.new(bar_index + 1, close * 3, bar_index + 2, 0, bgcolor=color.new(#ffffff, 0), border_color=color.new(#ffffff, 0), extend=extend.right)
        else
            box.set_lefttop(futBox, bar_index + 1, close * 3)
            box.set_rightbottom(futBox, bar_index + 2, 0)
    else if not na(futBox)
        box.delete(futBox)
        futBox := na

// Candle recolor for White — classic green up / red down
// plotcandle draws complete themed candles (body + wick + border) over the chart's own candles
upCn = #089981
dnCn = #f23645
themedCandles = paintCandles and isWhite
cndCol = close >= open ? upCn : dnCn
plotcandle(themedCandles ? open : na, themedCandles ? high : na, themedCandles ? low : na, themedCandles ? close : na, title="Themed candles", color=cndCol, wickcolor=cndCol, bordercolor=cndCol)
// Fallback: also recolor the chart's NATIVE candles so no wrong color shows even if they render on top
barcolor(themedCandles ? cndCol : na)

// ================= SESSION INPUTS =================
showSess    = input.bool(true, "Show session backgrounds", group=gS)
showSessLbl = input.bool(true, "Show session names (bottom)", group=gS)
sessTextCol = input.color(color.new(color.white, 55), "Session name text color (Dark theme)", group=gS)

sAsia  = input.session("1800-0300", "Asia / overnight", group=gS)
cAsia  = input.color(color.new(#2962ff, 92), "Asia color (Dark theme)", group=gS)
sLdn   = input.session("0300-0830", "London / EU", group=gS)
cLdn   = input.color(color.new(#b39ddb, 92), "London color (Dark theme)", group=gS)
sPre   = input.session("0830-0930", "Pre-market", group=gS)
cPre   = input.color(color.new(#ff9800, 90), "Pre-market color (Dark theme)", group=gS)
sUS    = input.session("0930-1600", "US session (base)", group=gS)
cUS    = input.color(color.new(#26a69a, 94), "US base color (Dark theme)", group=gS)
sZone  = input.session("0930-1130", "Trading zone", group=gS)
cZone  = input.color(color.new(#ccff90, 87), "Trading zone color (Dark theme)", group=gS)
sLunch = input.session("1200-1300", "Lunch", group=gS)
cLunch = input.color(color.new(#ffee58, 92), "Lunch color (Dark theme)", group=gS)
sPower = input.session("1500-1600", "Power hour", group=gS)
cPower = input.color(color.new(#ef5350, 92), "Power hour color (Dark theme)", group=gS)
sPost  = input.session("1600-1800", "Post-market", group=gS)
cPost  = input.color(color.new(#78909c, 93), "Post-market color (Dark theme)", group=gS)

// Themed session colors — White: whisper tints (slightly blue/purple/orange/green) so candles pop
sessTextColT = f_c(sessTextCol, color.new(#475569, 30))
cAsiaT  = f_c(cAsia,  color.new(#60a5fa, 95))
cLdnT   = f_c(cLdn,   color.new(#c084fc, 94))
cPreT   = f_c(cPre,   color.new(#fb923c, 93))
cUST    = f_c(cUS,    color.new(#5eead4, 96))
cZoneT  = f_c(cZone,  color.new(#4ade80, 93))
cLunchT = f_c(cLunch, color.new(#fde047, 93))
cPowerT = f_c(cPower, color.new(#f87171, 94))
cPostT  = f_c(cPost,  color.new(#94a3b8, 95))

inSess(s) => not na(time(timeframe.period, s, tzNY))

bAsia  = inSess(sAsia)
bLdn   = inSess(sLdn)
bPre   = inSess(sPre)
bUS    = inSess(sUS)
bZone  = inSess(sZone)
bLunch = inSess(sLunch)
bPower = inSess(sPower)
bPost  = inSess(sPost)

// Priority: sub-sessions first, US base fills the gaps between them
bgCol = bZone ? cZoneT : bLunch ? cLunchT : bPower ? cPowerT : bUS ? cUST : bPre ? cPreT : bPost ? cPostT : bLdn ? cLdnT : bAsia ? cAsiaT : na
bgcolor(showSess and timeframe.isintraday ? bgCol : na)

// Session names pinned to the bottom edge of the chart pane
noShape = color.new(color.white, 100)
plotshape(showSessLbl and timeframe.isintraday and bAsia and not bAsia[1], "Asia name", style=shape.labelup, location=location.bottom, color=noShape, textcolor=sessTextColT, text="ASIA", size=size.tiny)
plotshape(showSessLbl and timeframe.isintraday and bLdn and not bLdn[1], "London name", style=shape.labelup, location=location.bottom, color=noShape, textcolor=sessTextColT, text="LONDON", size=size.tiny)
plotshape(showSessLbl and timeframe.isintraday and bPre and not bPre[1], "Pre name", style=shape.labelup, location=location.bottom, color=noShape, textcolor=sessTextColT, text="PRE", size=size.tiny)
plotshape(showSessLbl and timeframe.isintraday and bZone and not bZone[1], "Zone name", style=shape.labelup, location=location.bottom, color=noShape, textcolor=sessTextColT, text="TRADE\nZONE", size=size.tiny)
plotshape(showSessLbl and timeframe.isintraday and bLunch and not bLunch[1], "Lunch name", style=shape.labelup, location=location.bottom, color=noShape, textcolor=sessTextColT, text="LUNCH", size=size.tiny)
plotshape(showSessLbl and timeframe.isintraday and bPower and not bPower[1], "Power name", style=shape.labelup, location=location.bottom, color=noShape, textcolor=sessTextColT, text="POWER\nHR", size=size.tiny)
plotshape(showSessLbl and timeframe.isintraday and bPost and not bPost[1], "Post name", style=shape.labelup, location=location.bottom, color=noShape, textcolor=sessTextColT, text="POST", size=size.tiny)

// ================= RTH DETECTION =================
rth = inSess("0930-1600")
rthStart = rth and not rth[1]

// ================= KEY LEVEL INPUTS =================
showLevels = input.bool(true, "Show key level lines", group=gL)
lineLen    = input.int(120, "Line length (bars)", minval=5, maxval=500, group=gL)
showScale  = input.bool(true, "Show level prices on price scale", group=gL)
showPDH  = input.bool(true, "Prev day high", group=gL)
cPDH     = input.color(#ff5252, "PDH color (Dark theme)", group=gL)
showPDL  = input.bool(true, "Prev day low", group=gL)
cPDL     = input.color(#40c4ff, "PDL color (Dark theme)", group=gL)
showPDC  = input.bool(true, "Prev day close", group=gL)
cPDC     = input.color(#e0e0e0, "PDC color (Dark theme)", group=gL)
showONH  = input.bool(true, "Overnight high", group=gL)
cONH     = input.color(#ffab40, "ONH color (Dark theme)", group=gL)
showONL  = input.bool(true, "Overnight low", group=gL)
cONL     = input.color(#b2ff59, "ONL color (Dark theme)", group=gL)
showWO   = input.bool(true, "Weekly open", group=gL)
cWO      = input.color(#ea80fc, "Weekly open color (Dark theme)", group=gL)
show930i = input.bool(true, "9:30 open", group=gL)
c930     = input.color(#ffffff, "9:30 open color (Dark theme)", group=gL)

// Themed level colors — deep saturated hues for white, distinct from the green/red candles
cPDHT = f_c(cPDH, #991b1b)
cPDLT = f_c(cPDL, #0e7490)
cPDCT = f_c(cPDC, #52525b)
cONHT = f_c(cONH, #ea580c)
cONLT = f_c(cONL, #3f6212)
cWOT  = f_c(cWO,  #9333ea)
c930T = f_c(c930, #111827)

// ===== Previous day H/L/C — defined by NY sessions, not the exchange daily candle
pdBasisIn = input.string("RTH (9:30-16:00 NY)", "Prev day basis", options=["RTH (9:30-16:00 NY)", "Full session (18:00-17:00 NY)"], group=gL)
pdSess = pdBasisIn == "RTH (9:30-16:00 NY)" ? "0930-1600" : "1800-1700"
inPD = inSess(pdSess)
var float pdRunH = na
var float pdRunL = na
var int pdRunHbar = na
var int pdRunLbar = na
var float pdh = na
var float pdl = na
var float pdc = na
var int pdhBar = na
var int pdlBar = na
var int pdcBar = na
if inPD and not inPD[1]
    pdRunH := high
    pdRunHbar := bar_index
    pdRunL := low
    pdRunLbar := bar_index
else if inPD
    if high > pdRunH
        pdRunH := high
        pdRunHbar := bar_index
    if low < pdRunL
        pdRunL := low
        pdRunLbar := bar_index
if not inPD and inPD[1]
    pdh := pdRunH
    pdhBar := pdRunHbar
    pdl := pdRunL
    pdlBar := pdRunLbar
    pdc := close[1]
    pdcBar := bar_index - 1

// ===== Weekly open with origin bar
wNew = ta.change(time("W")) != 0
var float wo = na
var int woBar = na
if wNew
    wo := open
    woBar := bar_index

// ===== Overnight H/L (18:00 -> 09:30 NY) with origin bars, frozen at the open
onSessIn = input.session("1800-0930", "Overnight session window", group=gL)
inON = inSess(onSessIn)
var float onHrun = na
var float onLrun = na
var int onHbarRun = na
var int onLbarRun = na
var float onH = na
var float onL = na
var int onHbar = na
var int onLbar = na
if inON and not inON[1]
    onHrun := high
    onHbarRun := bar_index
    onLrun := low
    onLbarRun := bar_index
else if inON
    if high > onHrun
        onHrun := high
        onHbarRun := bar_index
    if low < onLrun
        onLrun := low
        onLbarRun := bar_index
if not inON and inON[1]
    onH := onHrun
    onHbar := onHbarRun
    onL := onLrun
    onLbar := onLbarRun

// ===== 9:30 open capture (origin = the 9:30 candle)
var float o930 = na
var int o930bar = na
if rthStart
    o930 := open
    o930bar := bar_index

// ================= OPENING RANGE =================
orOn   = input.bool(true, "Opening range on", group=gO)
orMins = input.int(30, "Opening range minutes", minval=1, maxval=240, group=gO)
cOR    = input.color(#ffd740, "OR color (Dark theme)", group=gO)
orLbls = input.bool(true, "Label OR HIGH / OR LOW on the lines", group=gO)

cORT = f_c(cOR, #ca8a04)

// If OR is on, the 9:30 open line is hidden (no double marking)
show930 = show930i and not orOn

var int rthStartTime = na
if rthStart
    rthStartTime := time
inOR = orOn and rth and not na(rthStartTime) and (time - rthStartTime) < orMins * 60000
var float orH = na
var float orL = na
var int orHbar = na
var int orLbar = na
if rthStart
    orH := high
    orHbar := bar_index
    orL := low
    orLbar := bar_index
else if inOR
    if high > orH
        orH := high
        orHbar := bar_index
    if low < orL
        orL := low
        orLbar := bar_index
orDone = orOn and rth and not inOR and not na(orH)

// ================= LEVEL LINES (origin candle, fixed length) =================
f_lineEnd(int pBar) =>
    pBar + lineLen

f_level(float p, int pBar, color col, bool show) =>
    var line ln = na
    if showLevels and show and timeframe.isintraday and not na(p) and not na(pBar)
        int x2 = f_lineEnd(pBar)
        if na(ln)
            ln := line.new(pBar, p, x2, p, color=col, width=1)
            ln
        else
            line.set_xy1(ln, pBar, p)
            line.set_xy2(ln, x2, p)
            line.set_color(ln, col)
            ln

f_level(pdh, pdhBar, cPDHT, showPDH)
f_level(pdl, pdlBar, cPDLT, showPDL)
f_level(pdc, pdcBar, cPDCT, showPDC)
f_level(onH, onHbar, cONHT, showONH)
f_level(onL, onLbar, cONLT, showONL)
f_level(wo, woBar, cWOT, showWO)
f_level(o930, o930bar, c930T, show930)

// Opening range lines + OR HIGH / OR LOW text
var line orHLn = na
var line orLLn = na
var label orHLb = na
var label orLLb = na
noBg = color.new(color.white, 100)
if rthStart
    if not na(orHLn)
        line.delete(orHLn)
        line.delete(orLLn)
        orHLn := na
        orLLn := na
    if not na(orHLb)
        label.delete(orHLb)
        label.delete(orLLb)
        orHLb := na
        orLLb := na
if orDone and na(orHLn)
    orHLn := line.new(orHbar, orH, f_lineEnd(orHbar), orH, color=cORT, width=1, style=line.style_dashed)
    orLLn := line.new(orLbar, orL, f_lineEnd(orLbar), orL, color=cORT, width=1, style=line.style_dashed)
    if orLbls
        orHLb := label.new(f_lineEnd(orHbar), orH, "OR HIGH", style=label.style_label_down, color=noBg, textcolor=cORT, size=size.small)
        orLLb := label.new(f_lineEnd(orLbar), orL, "OR LOW", style=label.style_label_up, color=noBg, textcolor=cORT, size=size.small)
if not na(orHLn)
    line.set_x2(orHLn, f_lineEnd(orHbar))
    line.set_x2(orLLn, f_lineEnd(orLbar))
if not na(orHLb)
    label.set_x(orHLb, f_lineEnd(orHbar))
    label.set_x(orLLb, f_lineEnd(orLbar))

// ================= LEVEL PRICES ON THE PRICE SCALE =================
plot(showScale and showLevels and showPDH ? pdh : na, "PDH", color=cPDHT, display=display.price_scale)
plot(showScale and showLevels and showPDL ? pdl : na, "PDL", color=cPDLT, display=display.price_scale)
plot(showScale and showLevels and showPDC ? pdc : na, "PDC", color=cPDCT, display=display.price_scale)
plot(showScale and showLevels and showONH ? onH : na, "ONH", color=cONHT, display=display.price_scale)
plot(showScale and showLevels and showONL ? onL : na, "ONL", color=cONLT, display=display.price_scale)
plot(showScale and showLevels and showWO ? wo : na, "wOPEN", color=cWOT, display=display.price_scale)
plot(showScale and showLevels and show930 ? o930 : na, "9:30 open", color=c930T, display=display.price_scale)
plot(showScale and orDone ? orH : na, "ORH", color=cORT, display=display.price_scale)
plot(showScale and orDone ? orL : na, "ORL", color=cORT, display=display.price_scale)

// ================= LEVELS TABLE (top of chart) =================
showTable  = input.bool(true, "Show levels table", group=gT)
showLegend = input.bool(false, "Show full names (legend column)", group=gT)
tblPosIn   = input.string("Top right", "Table position", options=["Top right", "Middle right", "Bottom right", "Top center", "Top left", "Middle left", "Bottom left"], group=gT)
tblSizeIn  = input.string("Normal", "Table text size", options=["Small", "Normal", "Large"], group=gT)
tblBg      = input.color(color.new(color.black, 35), "Table background (Dark theme)", group=gT)

tblBgT  = f_c(tblBg, color.new(#ffffff, 15))
tblBrdT = f_c(color.new(color.white, 85), color.new(#94a3b8, 55))

f_row(table t, int r, string abbr, float p, color col, string full) =>
    txtSz = tblSizeIn == "Large" ? size.large : tblSizeIn == "Normal" ? size.normal : size.small
    table.cell(t, 0, r, abbr, text_color=col, text_size=txtSz, text_halign=text.align_left)
    table.cell(t, 1, r, str.tostring(p, format.mintick), text_color=col, text_size=txtSz, text_halign=text.align_right)
    if showLegend
        table.cell(t, 2, r, full, text_color=color.new(col, 30), text_size=txtSz, text_halign=text.align_left)

var table tbl = na
if showTable and barstate.islast
    if not na(tbl)
        table.delete(tbl)
    tblPos = tblPosIn == "Top right" ? position.top_right : tblPosIn == "Middle right" ? position.middle_right : tblPosIn == "Bottom right" ? position.bottom_right : tblPosIn == "Top center" ? position.top_center : tblPosIn == "Top left" ? position.top_left : tblPosIn == "Middle left" ? position.middle_left : position.bottom_left
    tbl := table.new(tblPos, 3, 12, bgcolor=tblBgT, border_width=1, border_color=tblBrdT)
    int r = 0
    if showPDH and not na(pdh)
        f_row(tbl, r, "PDH", pdh, cPDHT, "Prev day high")
        r += 1
    if showONH and not na(onH)
        f_row(tbl, r, "ONH", onH, cONHT, "Overnight high")
        r += 1
    if orDone
        f_row(tbl, r, "ORH", orH, cORT, "Opening range high")
        r += 1
    if show930 and not na(o930)
        f_row(tbl, r, "9:30", o930, c930T, "Session open")
        r += 1
    if showPDC and not na(pdc)
        f_row(tbl, r, "PDC", pdc, cPDCT, "Prev day close")
        r += 1
    if showWO and not na(wo)
        f_row(tbl, r, "wOPEN", wo, cWOT, "Weekly open")
        r += 1
    if orDone
        f_row(tbl, r, "ORL", orL, cORT, "Opening range low")
        r += 1
    if showONL and not na(onL)
        f_row(tbl, r, "ONL", onL, cONLT, "Overnight low")
        r += 1
    if showPDL and not na(pdl)
        f_row(tbl, r, "PDL", pdl, cPDLT, "Prev day low")
        r += 1

// ================= SWEEPS =================
showSweeps  = input.bool(true, "Show sweeps", group=gW)
sweepSessIn = input.session("0830-1600", "Sweep detection window (NY)", group=gW)
sweepBoxCol = input.color(color.new(#ffab40, 80), "Sweep box fill (Dark theme)", group=gW)
sweepBrdCol = input.color(color.new(#ffab40, 50), "Sweep box border (Dark theme)", group=gW)
sweepLblBg  = input.color(color.new(#ffab40, 15), "Sweep tag background (Dark theme)", group=gW)
sweepLblTx  = input.color(#412402, "Sweep tag text (Dark theme)", group=gW)

sweepBoxColT = f_c(sweepBoxCol, color.new(#f59e0b, 85))
sweepBrdColT = f_c(sweepBrdCol, color.new(#92400e, 50))
sweepLblBgT  = f_c(sweepLblBg, color.new(#b45309, 8))
sweepLblTxT  = f_c(sweepLblTx, #ffffff)

inSweep = inSess(sweepSessIn)
sweepStart = inSweep and not inSweep[1]
strictSweeps = input.bool(true, "Strict sweeps (skip if price already closed beyond the level)", group=gW)

f_sweepHi(float lvl, string nm, bool allow) =>
    var bool done = false
    var bool broke = false
    if sweepStart
        done := false
        broke := false
    bool trig = showSweeps and allow and not done and not (strictSweeps and broke) and not na(lvl) and high > lvl and close < lvl
    if trig
        done := true
    if allow and not na(lvl) and close > lvl
        broke := true
    trig ? nm + " " + str.tostring(lvl, format.mintick) : ""

f_sweepLo(float lvl, string nm, bool allow) =>
    var bool done = false
    var bool broke = false
    if sweepStart
        done := false
        broke := false
    bool trig = showSweeps and allow and not done and not (strictSweeps and broke) and not na(lvl) and low < lvl and close > lvl
    if trig
        done := true
    if allow and not na(lvl) and close < lvl
        broke := true
    trig ? nm + " " + str.tostring(lvl, format.mintick) : ""

// PDH/PDL can be swept any time in the window; ONH/ONL only after the overnight session is complete
hi1 = f_sweepHi(pdh, "PDH", inSweep)
hi2 = f_sweepHi(onH, "ONH", inSweep and not inON)
lo1 = f_sweepLo(pdl, "PDL", inSweep)
lo2 = f_sweepLo(onL, "ONL", inSweep and not inON)

// --- Volume context for sweeps
volLen     = input.int(20, "Volume avg length", group=gW)
volSpike   = input.float(1.5, "Volume spike threshold (x avg)", step=0.1, group=gW)
volDryX    = input.float(0.7, "Volume dry-up threshold (x avg)", step=0.1, group=gW)
dryBars    = input.int(3, "Bars to confirm dry-up after sweep", minval=1, maxval=20, group=gW)
showDry    = input.bool(true, "Mark volume dry-up after high-volume sweep", group=gW)
sweepHotBg = input.color(color.new(#ff5252, 10), "High-volume sweep tag background (Dark theme)", group=gW)

sweepHotBgT = f_c(sweepHotBg, color.new(#991b1b, 5))

avgVol = ta.sma(volume, volLen)
dryAvg = ta.sma(volume, dryBars)
rvol   = avgVol > 0 ? volume / avgVol : na
hotBar = not na(rvol) and rvol >= volSpike
rvolTxt = not na(rvol) ? " | " + str.tostring(rvol, "#.#") + "x vol" : ""

var int lastSweepBar = na
var int lastSweepDir = 0
var bool lastSweepHot = false

hiTxt = hi1 + (hi1 != "" and hi2 != "" ? "+" : "") + hi2
if hiTxt != ""
    float boxBot = high
    if hi1 != ""
        boxBot := math.min(boxBot, pdh)
    if hi2 != ""
        boxBot := math.min(boxBot, onH)
    box.new(bar_index - 1, high, bar_index + 1, boxBot, bgcolor=sweepBoxColT, border_color=sweepBrdColT)
    label.new(bar_index, high, "SWEEP " + hiTxt + rvolTxt, style=label.style_label_down, color=hotBar ? sweepHotBgT : sweepLblBgT, textcolor=hotBar ? color.white : sweepLblTxT, size=size.small)
    lastSweepBar := bar_index
    lastSweepDir := 1
    lastSweepHot := hotBar

loTxt = lo1 + (lo1 != "" and lo2 != "" ? "+" : "") + lo2
if loTxt != ""
    float boxTop = low
    if lo1 != ""
        boxTop := math.max(boxTop, pdl)
    if lo2 != ""
        boxTop := math.max(boxTop, onL)
    box.new(bar_index - 1, boxTop, bar_index + 1, low, bgcolor=sweepBoxColT, border_color=sweepBrdColT)
    label.new(bar_index, low, "SWEEP " + loTxt + rvolTxt, style=label.style_label_up, color=hotBar ? sweepHotBgT : sweepLblBgT, textcolor=hotBar ? color.white : sweepLblTxT, size=size.small)
    lastSweepBar := bar_index
    lastSweepDir := -1
    lastSweepHot := hotBar

// Spike sweep followed by fading volume = potential exhaustion / reversal context
if showDry and not na(lastSweepBar) and lastSweepHot and bar_index == lastSweepBar + dryBars
    if dryAvg < avgVol * volDryX
        if lastSweepDir > 0
            label.new(bar_index, high, "VOL DRY", style=label.style_label_down, color=color.new(color.gray, 35), textcolor=color.white, size=size.tiny)
        else
            label.new(bar_index, low, "VOL DRY", style=label.style_label_up, color=color.new(color.gray, 35), textcolor=color.white, size=size.tiny)

// ================= HIGH-VOLUME BADGE (middle right, only when volume is elevated) =================
showVolBadge = input.bool(true, "Show high-volume badge", group=gB)
volExt       = input.float(2.5, "Extreme threshold (x avg)", step=0.1, group=gB)
badgeHighBg  = input.color(color.new(#ffab40, 15), "High volume badge color (Dark theme)", group=gB)
badgeExtBg   = input.color(color.new(#ff5252, 10), "Extreme volume badge color (Dark theme)", group=gB)

badgeHighBgT = f_c(badgeHighBg, color.new(#b45309, 8))
badgeExtBgT  = f_c(badgeExtBg, color.new(#991b1b, 5))

var table volBadge = na
if barstate.islast
    if not na(volBadge)
        table.delete(volBadge)
        volBadge := na
    if showVolBadge and hotBar
        bool extNow = not na(rvol) and rvol >= volExt
        volBadge := table.new(position.middle_right, 1, 1, bgcolor=extNow ? badgeExtBgT : badgeHighBgT)
        table.cell(volBadge, 0, 0, (extNow ? "EXTREME VOL " : "HIGH VOL ") + str.tostring(rvol, "#.#") + "x  (" + str.tostring(volume, format.volume) + ")", text_color=color.white, text_size=size.normal)

// ================= VWAP / MAs =================
showVwap  = input.bool(true, "VWAP", group=gM)
cVwap     = input.color(#ff6d00, "VWAP color (Dark theme)", group=gM)
showMa50  = input.bool(true, "MA 50", group=gM)
cMa50     = input.color(#00b0ff, "MA 50 color (Dark theme)", group=gM)
showMa200 = input.bool(true, "MA 200", group=gM)
cMa200    = input.color(#d500f9, "MA 200 color (Dark theme)", group=gM)

cVwapT  = f_c(cVwap, #2563eb)
cMa50T  = f_c(cMa50, #7c3aed)
cMa200T = f_c(cMa200, #78350f)

vwapVal = ta.vwap(hlc3)
ma50    = ta.sma(close, 50)
ma200   = ta.sma(close, 200)

plot(showVwap ? vwapVal : na, "VWAP", color=cVwapT, linewidth=2)
plot(showMa50 ? ma50 : na, "MA 50", color=cMa50T, linewidth=1)
plot(showMa200 ? ma200 : na, "MA 200", color=cMa200T, linewidth=1)