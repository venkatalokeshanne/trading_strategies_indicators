//@version=6
strategy("Strategy D - HH/HL Visual + Entry Zones", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=1, commission_type=strategy.commission.cash_per_order, commission_value=0.5, slippage=1)

// ════════════════════════════════════════════════════════════════════════════════
// INPUTS
// ════════════════════════════════════════════════════════════════════════════════
// Swing Detection
swingLength = input.int(5, "Swing Length (bars)", minval=2, maxval=20)
minSwingSize = input.float(10.0, "Minimum Swing Size ($)", minval=1)

// Visual Settings
showHHHL = input.bool(true, "Show HH/HL Lines")
showLLLH = input.bool(true, "Show LL/LH Lines (Downtrend)")
showEntryZone = input.bool(true, "Show Entry Zone (Rectangle)")
showSLLine = input.bool(true, "Show SL Line (Red)")
showSwingLabels = input.bool(true, "Show Swing Labels")

// Entry Settings
entryLookback = input.int(3, "Entry Bars After Swing", minval=1, maxval=10)
zoneWidthBars = input.int(5, "Entry Zone Width (bars)", minval=3, maxval=20)
zoneHeightPips = input.float(5.0, "Entry Zone Height (pips)", minval=2)

// Risk Management
accountRisk = input.float(1.0, "Account Risk %", minval=0.1, maxval=5, step=0.1)
useTrailingSL = input.bool(true, "Use Trailing SL (Swing Based)")

// ════════════════════════════════════════════════════════════════════════════════
// SWING HIGH/LOW DETECTION
// ════════════════════════════════════════════════════════════════════════════════
pivotHighValue = ta.pivothigh(high, swingLength, swingLength)
pivotLowValue = ta.pivotlow(low, swingLength, swingLength)

var float lastSwingHigh = na
var float lastSwingLow = na
var int lastSwingHighBar = na
var int lastSwingLowBar = na
var int swingHighCount = 0
var int swingLowCount = 0

if not na(pivotHighValue)
    lastSwingHigh := pivotHighValue
    lastSwingHighBar := bar_index[swingLength]
    swingHighCount += 1

if not na(pivotLowValue)
    lastSwingLow := pivotLowValue
    lastSwingLowBar := bar_index[swingLength]
    swingLowCount += 1

// ════════════════════════════════════════════════════════════════════════════════
// TREND DETERMINATION (HH/HL vs LH/LL)
// ════════════════════════════════════════════════════════════════════════════════
var float prevSwingHigh = na
var float prevSwingLow = na
var int trendDirection = 0  // 1 = uptrend, -1 = downtrend, 0 = undefined

if not na(lastSwingHigh) and not na(prevSwingHigh)
    if lastSwingHigh > prevSwingHigh
        trendDirection := 1  // Higher High = Uptrend
    else if lastSwingHigh < prevSwingHigh
        trendDirection := -1  // Lower High = Downtrend

if not na(lastSwingLow) and not na(prevSwingLow)
    if lastSwingLow > prevSwingLow and trendDirection != -1
        trendDirection := 1  // Higher Low confirms uptrend
    else if lastSwingLow < prevSwingLow and trendDirection != 1
        trendDirection := -1  // Lower Low confirms downtrend

if not na(pivotHighValue)
    prevSwingHigh := pivotHighValue

if not na(pivotLowValue)
    prevSwingLow := pivotLowValue

// ════════════════════════════════════════════════════════════════════════════════
// HH/HL LINE DRAWINGS (BLACK LINES LIKE YOUR PICTURE)
// ════════════════════════════════════════════════════════════════════════════════
var line[] hhLines = array.new_line()
var line[] hlLines = array.new_line()
var line[] lhLines = array.new_line()
var line[] llLines = array.new_line()

var float lastHH = na
var float lastHL = na
var float lastLH = na
var float lastLL = na
var int lastHHBar = na
var int lastHLBar = na
var int lastLHBar = na
var int lastLLBar = na

// Draw HH/HL lines in uptrend
if trendDirection == 1
    if not na(lastSwingHigh) and (na(lastHH) or lastSwingHigh > lastHH)
        // New Higher High
        if not na(lastHH) and not na(lastHHBar)
            // Draw line from previous HH to new HH
            newHHLine = line.new(lastHHBar, lastHH, bar_index[swingLength], lastSwingHigh, 
                                 color=color.black, width=2, style=line.style_solid)
            array.push(hhLines, newHHLine)
        lastHH := lastSwingHigh
        lastHHBar := bar_index[swingLength]
        
    if not na(lastSwingLow) and (na(lastHL) or lastSwingLow > lastHL)
        // New Higher Low
        if not na(lastHL) and not na(lastHLBar)
            // Draw line from previous HL to new HL
            newHLLine = line.new(lastHLBar, lastHL, bar_index[swingLength], lastSwingLow, 
                                 color=color.black, width=2, style=line.style_solid)
            array.push(hlLines, newHLLine)
        lastHL := lastSwingLow
        lastHLBar := bar_index[swingLength]

// Draw LH/LL lines in downtrend
if trendDirection == -1
    if not na(lastSwingLow) and (na(lastLL) or lastSwingLow < lastLL)
        // New Lower Low
        if not na(lastLL) and not na(lastLLBar)
            newLLLine = line.new(lastLLBar, lastLL, bar_index[swingLength], lastSwingLow, 
                                 color=color.black, width=2, style=line.style_solid)
            array.push(llLines, newLLLine)
        lastLL := lastSwingLow
        lastLLBar := bar_index[swingLength]
        
    if not na(lastSwingHigh) and (na(lastLH) or lastSwingHigh < lastLH)
        // New Lower High
        if not na(lastLH) and not na(lastLHBar)
            newLHLine = line.new(lastLHBar, lastLH, bar_index[swingLength], lastSwingHigh, 
                                 color=color.black, width=2, style=line.style_solid)
            array.push(lhLines, newLHLine)
        lastLH := lastSwingHigh
        lastLHBar := bar_index[swingLength]

// ════════════════════════════════════════════════════════════════════════════════
// ENTRY LOGIC - PULLBACK TO HL/LH
// ════════════════════════════════════════════════════════════════════════════════
// Long Entry: Price near Higher Low in uptrend
longCondition = trendDirection == 1 and not na(lastHL) and low <= lastHL + zoneHeightPips and low >= lastHL - zoneHeightPips and close > lastHL

// Short Entry: Price near Lower High in downtrend
shortCondition = trendDirection == -1 and not na(lastLH) and high >= lastLH - zoneHeightPips and high <= lastLH + zoneHeightPips and close < lastLH

// Check if we're not already in a position
notInPosition = strategy.position_size == 0

// ════════════════════════════════════════════════════════════════════════════════
// ENTRY ZONE & SL VISUALS
// ════════════════════════════════════════════════════════════════════════════════
var box entryZoneBox = na
var line slLine = na

// Draw entry zone for longs
if longCondition and notInPosition and showEntryZone
    // Entry zone rectangle
    zoneTop = lastHL + zoneHeightPips
    zoneBottom = lastHL - zoneHeightPips
    
    if na(entryZoneBox)
        entryZoneBox := box.new(bar_index, zoneTop, bar_index + zoneWidthBars, zoneBottom, 
                                bgcolor=color.new(color.blue, 85), border_color=color.blue, 
                                border_width=2)
    else
        box.set_left(entryZoneBox, bar_index)
        box.set_right(entryZoneBox, bar_index + zoneWidthBars)
        box.set_top(entryZoneBox, zoneTop)
        box.set_bottom(entryZoneBox, zoneBottom)
        box.set_bgcolor(entryZoneBox, color.new(color.blue, 85))

// Draw SL line for longs (thick red)
if longCondition and notInPosition and showSLLine
    slPrice = lastHL - zoneHeightPips
    if na(slLine)
        slLine := line.new(bar_index, slPrice, bar_index + zoneWidthBars, slPrice, 
                           color=color.red, width=3, style=line.style_solid)
    else
        line.set_xy1(slLine, bar_index, slPrice)
        line.set_xy2(slLine, bar_index + zoneWidthBars, slPrice)
        line.set_color(slLine, color.red)
        line.set_width(slLine, 3)

// Draw entry zone for shorts
if shortCondition and notInPosition and showEntryZone
    zoneTop = lastLH + zoneHeightPips
    zoneBottom = lastLH - zoneHeightPips
    
    if na(entryZoneBox)
        entryZoneBox := box.new(bar_index, zoneTop, bar_index + zoneWidthBars, zoneBottom, 
                                bgcolor=color.new(color.red, 85), border_color=color.red, 
                                border_width=2)
    else
        box.set_left(entryZoneBox, bar_index)
        box.set_right(entryZoneBox, bar_index + zoneWidthBars)
        box.set_top(entryZoneBox, zoneTop)
        box.set_bottom(entryZoneBox, zoneBottom)
        box.set_bgcolor(entryZoneBox, color.new(color.red, 85))

// Draw SL line for shorts (thick red)
if shortCondition and notInPosition and showSLLine
    slPrice = lastLH + zoneHeightPips
    if na(slLine)
        slLine := line.new(bar_index, slPrice, bar_index + zoneWidthBars, slPrice, 
                           color=color.red, width=3, style=line.style_solid)
    else
        line.set_xy1(slLine, bar_index, slPrice)
        line.set_xy2(slLine, bar_index + zoneWidthBars, slPrice)
        line.set_color(slLine, color.red)
        line.set_width(slLine, 3)

// ════════════════════════════════════════════════════════════════════════════════
// POSITION SIZING
// ════════════════════════════════════════════════════════════════════════════════
// Calculate position size based on risk
getPositionSize(entryPrice, slPrice) =>
    riskPerShare = math.abs(entryPrice - slPrice)
    accountEquity = strategy.equity
    riskAmount = accountEquity * (accountRisk / 100)
    positionSize = riskPerShare > 0 ? riskAmount / riskPerShare : 0
    math.floor(positionSize)

// ════════════════════════════════════════════════════════════════════════════════
// EXECUTE TRADES
// ════════════════════════════════════════════════════════════════════════════════
if longCondition and notInPosition
    entryPrice = close
    slPrice = lastHL - zoneHeightPips
    qty = getPositionSize(entryPrice, slPrice)
    if qty > 0
        strategy.entry("Long", strategy.long, qty=qty)
        strategy.exit("Long SL", "Long", stop=slPrice, comment="SL")

if shortCondition and notInPosition
    entryPrice = close
    slPrice = lastLH + zoneHeightPips
    qty = getPositionSize(entryPrice, slPrice)
    if qty > 0
        strategy.entry("Short", strategy.short, qty=qty)
        strategy.exit("Short SL", "Short", stop=slPrice, comment="SL")

// ════════════════════════════════════════════════════════════════════════════════
// TRAILING SL LOGIC (Move to next swing low/high)
// ════════════════════════════════════════════════════════════════════════════════
if useTrailingSL and strategy.position_size > 0
    // For longs - trail under most recent higher low
    if strategy.position_size > 0 and trendDirection == 1 and not na(lastHL)
        newSL = lastHL - zoneHeightPips
        currentSL = strategy.position_avg_price - (strategy.position_avg_price - strategy.position_avg_price)
        if newSL > currentSL
            strategy.exit("Long Trail", "Long", stop=newSL, comment="Trail")
    
    // For shorts - trail above most recent lower high
    if strategy.position_size < 0 and trendDirection == -1 and not na(lastLH)
        newSL = lastLH + zoneHeightPips
        currentSL = strategy.position_avg_price + (strategy.position_avg_price - strategy.position_avg_price)
        if newSL < currentSL
            strategy.exit("Short Trail", "Short", stop=newSL, comment="Trail")

// ════════════════════════════════════════════════════════════════════════════════
// TP LOGIC - Structure Break (Opposite swing taken out)
// ════════════════════════════════════════════════════════════════════════════════
// Close long if price takes out recent swing high (structure broken for next leg)
if strategy.position_size > 0 and not na(lastHH)
    if high > lastHH
        strategy.close("Long", comment="TP - HH Taken")

// Close short if price takes out recent swing low
if strategy.position_size < 0 and not na(lastLL)
    if low < lastLL
        strategy.close("Short", comment="TP - LL Taken")

// ════════════════════════════════════════════════════════════════════════════════
// LABELS FOR SWINGS
// ════════════════════════════════════════════════════════════════════════════════
if showSwingLabels and not na(pivotHighValue)
    label.new(bar_index[swingLength], high[swingLength], "HH" , 
              color=color.black, textcolor=color.white, size=size.small, 
              style=label.style_label_down)

if showSwingLabels and not na(pivotLowValue)
    label.new(bar_index[swingLength], low[swingLength], "HL", 
              color=color.black, textcolor=color.white, size=size.small,
              style=label.style_label_up)

// ════════════════════════════════════════════════════════════════════════════════
// INFO PANEL
// ════════════════════════════════════════════════════════════════════════════════
var table infoPanel = table.new(position.top_right, 2, 5, bgcolor=color.black, 
                                border_width=1, border_color=color.gray)

if barstate.islast
    table.cell(infoPanel, 0, 0, "Trend:", text_color=color.white, text_size=size.small)
    trendText = trendDirection == 1 ? "UPTREND" : trendDirection == -1 ? "DOWNTREND" : "UNDEFINED"
    trendColor = trendDirection == 1 ? color.green : trendDirection == -1 ? color.red : color.gray
    table.cell(infoPanel, 1, 0, trendText, text_color=trendColor, text_size=size.small)
    
    table.cell(infoPanel, 0, 1, "Last HL:", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 1, str.tostring(lastHL, "#.##"), text_color=color.green, text_size=size.small)
    
    table.cell(infoPanel, 0, 2, "Last HH:", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 2, str.tostring(lastHH, "#.##"), text_color=color.green, text_size=size.small)
    
    table.cell(infoPanel, 0, 3, "Last LH:", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 3, str.tostring(lastLH, "#.##"), text_color=color.red, text_size=size.small)
    
    table.cell(infoPanel, 0, 4, "Last LL:", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 4, str.tostring(lastLL, "#.##"), text_color=color.red, text_size=size.small)

// ════════════════════════════════════════════════════════════════════════════════
// PLOT SIGNALS
// ════════════════════════════════════════════════════════════════════════════════
plotshape(longCondition and notInPosition, title="Long Entry", location=location.belowbar, 
          color=color.green, style=shape.triangleup, size=size.small, text="BUY")

plotshape(shortCondition and notInPosition, title="Short Entry", location=location.abovebar, 
          color=color.red, style=shape.triangledown, size=size.small, text="SELL")
