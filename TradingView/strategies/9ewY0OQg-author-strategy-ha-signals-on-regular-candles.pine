//@version=5
strategy("Author Strategy - HA signals on regular candles", overlay=true, pyramiding=0, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.04)

//====================================================
// INPUTS
//====================================================
atrPeriod     = input.int(1, "Chandelier ATR Period", minval=1)
atrMultiplier = input.float(2.0, "Chandelier ATR Multiplier", step=0.1)
smmaLength    = input.int(50, "ZLSMA Length", minval=1)

showLabels    = input.bool(true, "Show Buy/Sell Labels")
showZLSMMA    = input.bool(true, "Show ZL SMMA")

//====================================================
// HEIKIN ASHI DATA FOR SIGNALS
//====================================================
haTicker = ticker.heikinashi(syminfo.tickerid)

haOpen  = request.security(haTicker, timeframe.period, open)
haHigh  = request.security(haTicker, timeframe.period, high)
haLow   = request.security(haTicker, timeframe.period, low)
haClose = request.security(haTicker, timeframe.period, close)

//====================================================
// ZL SMMA
//====================================================
smma(src, length) =>
    var float smmaValue = na
    smmaValue := na(smmaValue[1]) ? ta.sma(src, length) : (smmaValue[1] * (length - 1) + src) / length
    smmaValue

lag = math.max(1, math.floor(smmaLength / 2))
zlSource = haClose + (haClose - haClose[lag])
zlSmma   = smma(zlSource, smmaLength)

//====================================================
// CHANDELIER EXIT ON HEIKIN ASHI
//====================================================
atrHA = ta.atr(atrPeriod)

longStopRawHA  = ta.highest(haHigh, atrPeriod) - atrHA * atrMultiplier
shortStopRawHA = ta.lowest(haLow, atrPeriod) + atrHA * atrMultiplier

var float longStopHA  = na
var float shortStopHA = na
var int dir = 1

longStopHA := haClose[1] > nz(longStopHA[1], longStopRawHA) ? math.max(longStopRawHA, nz(longStopHA[1], longStopRawHA)) : longStopRawHA
shortStopHA := haClose[1] < nz(shortStopHA[1], shortStopRawHA) ? math.min(shortStopRawHA, nz(shortStopHA[1], shortStopRawHA)) : shortStopRawHA

dir := haClose > nz(shortStopHA[1], shortStopHA) ? 1 :
       haClose < nz(longStopHA[1], longStopHA) ? -1 :
       nz(dir[1], 1)

buySignal  = dir == 1 and dir[1] == -1
sellSignal = dir == -1 and dir[1] == 1

//====================================================
// AUTHOR LOGIC
// signals from HA, execution on regular candles
//====================================================
longCondition  = buySignal and haClose > zlSmma
shortCondition = sellSignal and haClose < zlSmma

//====================================================
// STOPS: by signal candle on regular candles
//====================================================
var float longSL  = na
var float shortSL = na

if longCondition and strategy.position_size <= 0
    longSL := low
    strategy.entry("Long", strategy.long)

if shortCondition and strategy.position_size >= 0
    shortSL := high
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0 and not na(longSL)
    strategy.exit("Long SL", "Long", stop=longSL)

if strategy.position_size < 0 and not na(shortSL)
    strategy.exit("Short SL", "Short", stop=shortSL)

//====================================================
// EXIT: reverse cross of ZL SMMA
// use HA close vs HA ZL SMMA, as in author's chart logic
//====================================================
exitLong  = strategy.position_size > 0 and haClose < zlSmma
exitShort = strategy.position_size < 0 and haClose > zlSmma

if exitLong
    strategy.close("Long", comment="MA Exit")

if exitShort
    strategy.close("Short", comment="MA Exit")

if strategy.position_size == 0
    longSL := na
    shortSL := na

//====================================================
// PLOTS
//====================================================
plot(showZLSMMA ? zlSmma : na, title="ZL SMMA", color=color.white, linewidth=2)

plotshape(showLabels and buySignal,  title="Buy",  text="Buy",  style=shape.labelup,   location=location.belowbar, color=color.green, textcolor=color.white, size=size.small)
plotshape(showLabels and sellSignal, title="Sell", text="Sell", style=shape.labeldown, location=location.abovebar, color=color.red,   textcolor=color.white, size=size.small)