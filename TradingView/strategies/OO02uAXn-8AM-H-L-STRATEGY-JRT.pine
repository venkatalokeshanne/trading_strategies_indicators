//@version=6
strategy(
     "Custom Hour High & Low + Sweep Strategy",
     shorttitle="Hour H/L Strategy",
     overlay=true,
     max_lines_count=500,
     max_labels_count=500,
     max_boxes_count=500,
     pyramiding=0,
     process_orders_on_close=true)

// ============================================================================
// TIMEZONE
// ============================================================================

string TZ = "America/New_York"

// ============================================================================
// RANGE SETTINGS
// ============================================================================

groupRange = "Range Settings"

startHour = input.int(
     8,
     "Start Hour",
     minval=0,
     maxval=23,
     group=groupRange)

startMinute = input.int(
     0,
     "Start Minute",
     minval=0,
     maxval=59,
     group=groupRange)

endHour = input.int(
     9,
     "End Hour",
     minval=0,
     maxval=23,
     group=groupRange)

endMinute = input.int(
     0,
     "End Minute",
     minval=0,
     maxval=59,
     group=groupRange)

// ============================================================================
// EXTENSION SETTINGS
// ============================================================================

groupExtension = "Line Extension"

extensionHour = input.int(
     12,
     "Extend Until Hour",
     minval=0,
     maxval=23,
     group=groupExtension)

extensionMinute = input.int(
     0,
     "Extend Until Minute",
     minval=0,
     maxval=59,
     group=groupExtension)

// ============================================================================
// LINE SETTINGS
// ============================================================================

groupStyle = "Line Settings"

highColor = input.color(
     color.black,
     "High Line Color",
     group=groupStyle)

lowColor = input.color(
     color.black,
     "Low Line Color",
     group=groupStyle)

lineWidth = input.int(
     1,
     "Line Thickness",
     minval=1,
     maxval=5,
     group=groupStyle)

lineStyleInput = input.string(
     "Solid",
     "Line Style",
     options=["Solid", "Dashed", "Dotted"],
     group=groupStyle)

lineStyle = switch lineStyleInput
    "Dashed" => line.style_dashed
    "Dotted" => line.style_dotted
    => line.style_solid

// ============================================================================
// SIGNAL SETTINGS
// ============================================================================

groupSignals = "Signal Settings"

showSignals = input.bool(
     true,
     "Show Buy/Sell Signals",
     group=groupSignals)

// -----------------------------------------------------------------------------
// SIGNAL START TIME
// -----------------------------------------------------------------------------

signalStartHour = input.int(
     9,
     "Signal Start Hour",
     minval=0,
     maxval=23,
     group=groupSignals)

signalStartMinute = input.int(
     30,
     "Signal Start Minute",
     minval=0,
     maxval=59,
     group=groupSignals)

// -----------------------------------------------------------------------------
// SIGNAL END TIME
// -----------------------------------------------------------------------------

signalEndHour = input.int(
     11,
     "Signal End Hour",
     minval=0,
     maxval=23,
     group=groupSignals)

signalEndMinute = input.int(
     0,
     "Signal End Minute",
     minval=0,
     maxval=59,
     group=groupSignals)

// -----------------------------------------------------------------------------
// BAR CONFIRMATION
// -----------------------------------------------------------------------------

confirmationBars = input.int(
     1,
     "Bar Confirmation",
     minval=1,
     maxval=20,
     group=groupSignals)

// -----------------------------------------------------------------------------
// TAP TOLERANCE
// -----------------------------------------------------------------------------

signalToleranceTicks = input.int(
     0,
     "Tap Tolerance (Ticks)",
     minval=0,
     maxval=100,
     group=groupSignals)

// -----------------------------------------------------------------------------
// MAXIMUM BUY / SELL SIGNALS
// -----------------------------------------------------------------------------

maxBuySignals = input.int(
     2,
     "Max Buy Signals",
     minval=0,
     maxval=20,
     group=groupSignals,
     tooltip="Maximum number of BUY signals allowed during the selected signal period.")

maxSellSignals = input.int(
     2,
     "Max Sell Signals",
     minval=0,
     maxval=20,
     group=groupSignals,
     tooltip="Maximum number of SELL signals allowed during the selected signal period.")

// ============================================================================
// RANGE PERCENTAGE FILTER
// ============================================================================

groupFilter = "Signal Filters"

useRangeFilter = input.bool(
     false,
     "Use Range Percentage Filter",
     group=groupFilter,
     tooltip="When enabled, BUY signals must occur within the selected percentage from the range LOW, while SELL signals must occur within the selected percentage from the range HIGH.")

rangeFilterPercent = input.float(
     50.0,
     "Range Filter %",
     minval=0.0,
     maxval=100.0,
     step=1.0,
     group=groupFilter,
     tooltip="50% = halfway. 25% = only the closest quarter to the swept line. 100% = essentially no restriction.")

// ============================================================================
// SIGNAL APPEARANCE
// ============================================================================

groupSignalStyle = "Signal Appearance"

buyColor = input.color(
     #006132,
     "Buy Signal Color",
     group=groupSignalStyle)

sellColor = input.color(
     #600000,
     "Sell Signal Color",
     group=groupSignalStyle)

signalSizeInput = input.string(
     "Small",
     "Signal Size",
     options=["Tiny", "Small", "Normal", "Large", "Huge"],
     group=groupSignalStyle)

// ============================================================================
// TRADE MANAGEMENT
// ============================================================================

groupTrade = "Trade Management"

riskReward = input.float(
     0.75,
     "Risk : Reward",
     minval=0.1,
     step=0.1,
     group=groupTrade,
     tooltip="The opposite range line is always the TP. The original SL distance is calculated from the TP distance using this Risk:Reward value.")

// -----------------------------------------------------------------------------
// STOP LOSS ADJUSTMENT
// -----------------------------------------------------------------------------

adjustStopLoss = input.bool(
     true,
     "Adjust SL After TP Progress",
     group=groupTrade,
     tooltip="When enabled, the stop loss is reduced after price reaches the selected percentage of the distance toward the TP.")

slAdjustmentTriggerPercent = input.float(
     80.0,
     "SL Adjustment Trigger %",
     minval=0.0,
     maxval=100.0,
     step=1.0,
     group=groupTrade,
     tooltip="How far price must travel toward the TP before the stop loss is adjusted.")

slRemainingPercent = input.float(
     25.0,
     "SL Remaining %",
     minval=0.0,
     maxval=100.0,
     step=1.0,
     group=groupTrade,
     tooltip="Percentage of the ORIGINAL stop-loss distance that remains after the adjustment. 50% = SL is cut in half. 0% = breakeven. 100% = no SL movement.")

// ============================================================================
// TP / SL BOX SETTINGS
// ============================================================================

groupBoxes = "TP / SL Boxes"

showTradeBoxes = input.bool(
     true,
     "Show TP / SL Boxes",
     group=groupBoxes)

tpColor = input.color(
     color.new(#006132, 80),
     "TP Box Color",
     group=groupBoxes)

slColor = input.color(
     color.new(#600000, 80),
     "SL Box Color",
     group=groupBoxes)

// ============================================================================
// TIME CALCULATIONS
// ============================================================================

int currentHour = hour(time, TZ)
int currentMinute = minute(time, TZ)

int currentMinutes = currentHour * 60 + currentMinute

int startMinutes = startHour * 60 + startMinute
int endMinutes = endHour * 60 + endMinute

int extensionMinutes = extensionHour * 60 + extensionMinute

int signalStartMinutes = signalStartHour * 60 + signalStartMinute
int signalEndMinutes = signalEndHour * 60 + signalEndMinute

// ============================================================================
// DAY TRACKING
// ============================================================================

int currentDay =
     year(time, TZ) * 10000 +
     month(time, TZ) * 100 +
     dayofmonth(time, TZ)

bool newDay = ta.change(currentDay) != 0

// ============================================================================
// RANGE VARIABLES
// ============================================================================

var float rangeHigh = na
var float rangeLow = na

var int rangeStartBar = na
var int rangeEndBar = na

var line highLine = na
var line lowLine = na

// ============================================================================
// SIGNAL VARIABLES
// ============================================================================

var int buySignalCount = 0
var int sellSignalCount = 0

var bool bullishSetup = false
var bool bearishSetup = false

var int bullishSetupBar = na
var int bearishSetupBar = na

// ============================================================================
// TRADE VARIABLES
// ============================================================================

var float activeEntry = na
var float activeTP = na
var float activeSL = na
var float originalSLDistance = na

var int activeTradeBar = na
var int activeTradeDirection = 0

var bool slAdjusted = false

var box activeTPBox = na
var box activeSLBox = na

// ============================================================================
// RESET EACH DAY
// ============================================================================

if newDay

    rangeHigh := na
    rangeLow := na

    rangeStartBar := na
    rangeEndBar := na

    highLine := na
    lowLine := na

    buySignalCount := 0
    sellSignalCount := 0

    bullishSetup := false
    bearishSetup := false

    bullishSetupBar := na
    bearishSetupBar := na

// ============================================================================
// RANGE DETECTION
// ============================================================================

bool inRange =
     startMinutes < endMinutes ?
     currentMinutes >= startMinutes and currentMinutes < endMinutes :
     currentMinutes >= startMinutes or currentMinutes < endMinutes

// ============================================================================
// BUILD RANGE
// ============================================================================

if inRange

    if na(rangeHigh)

        rangeHigh := high
        rangeLow := low
        rangeStartBar := bar_index

    else

        rangeHigh := math.max(rangeHigh, high)
        rangeLow := math.min(rangeLow, low)

    rangeEndBar := bar_index

// ============================================================================
// RANGE JUST ENDED
// ============================================================================

bool rangeJustEnded =
     not inRange and
     inRange[1]

// ============================================================================
// CREATE RANGE LINES
// ============================================================================

if rangeJustEnded and
   not na(rangeHigh) and
   not na(rangeLow)

    highLine := line.new(
         x1=rangeStartBar,
         y1=rangeHigh,
         x2=bar_index,
         y2=rangeHigh,
         xloc=xloc.bar_index,
         extend=extend.none,
         color=highColor,
         style=lineStyle,
         width=lineWidth)

    lowLine := line.new(
         x1=rangeStartBar,
         y1=rangeLow,
         x2=bar_index,
         y2=rangeLow,
         xloc=xloc.bar_index,
         extend=extend.none,
         color=lowColor,
         style=lineStyle,
         width=lineWidth)

// ============================================================================
// EXTEND RANGE LINES
// ============================================================================

if not na(highLine) and
   not na(lowLine) and
   not inRange

    if currentMinutes <= extensionMinutes

        line.set_x2(highLine, bar_index)
        line.set_x2(lowLine, bar_index)

// ============================================================================
// LINE SETTINGS
// ============================================================================

if not na(highLine)

    line.set_color(highLine, highColor)
    line.set_width(highLine, lineWidth)
    line.set_style(highLine, lineStyle)

if not na(lowLine)

    line.set_color(lowLine, lowColor)
    line.set_width(lowLine, lineWidth)
    line.set_style(lowLine, lineStyle)

// ============================================================================
// SIGNAL WINDOW
// ============================================================================

bool signalWindow =
     currentMinutes >= signalStartMinutes and
     currentMinutes < signalEndMinutes

// ============================================================================
// LEVELS READY
// ============================================================================

bool levelsReady =
     not na(rangeHigh) and
     not na(rangeLow)

// ============================================================================
// RANGE PERCENTAGE CALCULATIONS
// ============================================================================

float rangeSize =
     levelsReady ?
     rangeHigh - rangeLow :
     na

float buyFilterLevel =
     levelsReady ?
     rangeLow + rangeSize * (rangeFilterPercent / 100.0) :
     na

float sellFilterLevel =
     levelsReady ?
     rangeHigh - rangeSize * (rangeFilterPercent / 100.0) :
     na

// ============================================================================
// RANGE FILTER
// ============================================================================

bool buyRangeOK =
     not useRangeFilter or
     (levelsReady and close <= buyFilterLevel)

bool sellRangeOK =
     not useRangeFilter or
     (levelsReady and close >= sellFilterLevel)

// ============================================================================
// TOLERANCE
// ============================================================================

float tolerance =
     signalToleranceTicks * syminfo.mintick

// ============================================================================
// LOW INTERACTION
// ============================================================================

bool lowSweep =
     levelsReady and
     signalWindow and
     low < rangeLow and
     close > rangeLow

bool lowTap =
     levelsReady and
     signalWindow and
     low <= rangeLow + tolerance and
     low >= rangeLow - tolerance

// ============================================================================
// HIGH INTERACTION
// ============================================================================

bool highSweep =
     levelsReady and
     signalWindow and
     high > rangeHigh and
     close < rangeHigh

bool highTap =
     levelsReady and
     signalWindow and
     high >= rangeHigh - tolerance and
     high <= rangeHigh + tolerance

// ============================================================================
// BULLISH SETUP
// ============================================================================

if buySignalCount < maxBuySignals and
   (lowSweep or lowTap)

    bullishSetup := true
    bullishSetupBar := bar_index

// ============================================================================
// BEARISH SETUP
// ============================================================================

if sellSignalCount < maxSellSignals and
   (highSweep or highTap)

    bearishSetup := true
    bearishSetupBar := bar_index

// ============================================================================
// SETUP EXPIRATION
// ============================================================================

if bullishSetup and
   not na(bullishSetupBar)

    if bar_index - bullishSetupBar > confirmationBars

        bullishSetup := false
        bullishSetupBar := na

if bearishSetup and
   not na(bearishSetupBar)

    if bar_index - bearishSetupBar > confirmationBars

        bearishSetup := false
        bearishSetupBar := na

// ============================================================================
// DISPLACEMENT
// ============================================================================

bool bullishDisplacement =
     close > open and
     close > high[1]

bool bearishDisplacement =
     close < open and
     close < low[1]

// ============================================================================
// CONFIRMATION
// ============================================================================

bool bullishConfirmation =
     bullishSetup and
     not na(bullishSetupBar) and
     bar_index - bullishSetupBar >= confirmationBars

bool bearishConfirmation =
     bearishSetup and
     not na(bearishSetupBar) and
     bar_index - bearishSetupBar >= confirmationBars

// ============================================================================
// FINAL SIGNALS
// ============================================================================

bool finalBuy =
     showSignals and
     signalWindow and
     bullishConfirmation and
     bullishDisplacement and
     buyRangeOK and
     buySignalCount < maxBuySignals

bool finalSell =
     showSignals and
     signalWindow and
     bearishConfirmation and
     bearishDisplacement and
     sellRangeOK and
     sellSignalCount < maxSellSignals

// ============================================================================
// REGISTER BUY SIGNAL
// ============================================================================

if finalBuy

    buySignalCount += 1

    bullishSetup := false
    bullishSetupBar := na

// ============================================================================
// REGISTER SELL SIGNAL
// ============================================================================

if finalSell

    sellSignalCount += 1

    bearishSetup := false
    bearishSetupBar := na

// ============================================================================
// BUY SIGNALS
// ============================================================================

plotshape(
     finalBuy and signalSizeInput == "Tiny",
     title="BUY Tiny",
     style=shape.labelup,
     location=location.belowbar,
     color=buyColor,
     text="BUY",
     textcolor=color.white,
     size=size.tiny)

plotshape(
     finalBuy and signalSizeInput == "Small",
     title="BUY Small",
     style=shape.labelup,
     location=location.belowbar,
     color=buyColor,
     text="BUY",
     textcolor=color.white,
     size=size.small)

plotshape(
     finalBuy and signalSizeInput == "Normal",
     title="BUY Normal",
     style=shape.labelup,
     location=location.belowbar,
     color=buyColor,
     text="BUY",
     textcolor=color.white,
     size=size.normal)

plotshape(
     finalBuy and signalSizeInput == "Large",
     title="BUY Large",
     style=shape.labelup,
     location=location.belowbar,
     color=buyColor,
     text="BUY",
     textcolor=color.white,
     size=size.large)

plotshape(
     finalBuy and signalSizeInput == "Huge",
     title="BUY Huge",
     style=shape.labelup,
     location=location.belowbar,
     color=buyColor,
     text="BUY",
     textcolor=color.white,
     size=size.huge)

// ============================================================================
// SELL SIGNALS
// ============================================================================

plotshape(
     finalSell and signalSizeInput == "Tiny",
     title="SELL Tiny",
     style=shape.labeldown,
     location=location.abovebar,
     color=sellColor,
     text="SELL",
     textcolor=color.white,
     size=size.tiny)

plotshape(
     finalSell and signalSizeInput == "Small",
     title="SELL Small",
     style=shape.labeldown,
     location=location.abovebar,
     color=sellColor,
     text="SELL",
     textcolor=color.white,
     size=size.small)

plotshape(
     finalSell and signalSizeInput == "Normal",
     title="SELL Normal",
     style=shape.labeldown,
     location=location.abovebar,
     color=sellColor,
     text="SELL",
     textcolor=color.white,
     size=size.normal)

plotshape(
     finalSell and signalSizeInput == "Large",
     title="SELL Large",
     style=shape.labeldown,
     location=location.abovebar,
     color=sellColor,
     text="SELL",
     textcolor=color.white,
     size=size.large)

plotshape(
     finalSell and signalSizeInput == "Huge",
     title="SELL Huge",
     style=shape.labeldown,
     location=location.abovebar,
     color=sellColor,
     text="SELL",
     textcolor=color.white,
     size=size.huge)

// ============================================================================
// BUY TRADE
// ============================================================================

if finalBuy and
   strategy.position_size == 0 and
   not na(rangeHigh)

    activeEntry := close
    activeTP := rangeHigh

    float tpDistance = activeTP - activeEntry

    activeSL := activeEntry - (tpDistance / riskReward)

    originalSLDistance := math.abs(activeEntry - activeSL)

    activeTradeBar := bar_index
    activeTradeDirection := 1
    slAdjusted := false

    if activeTP > activeEntry and
       activeSL < activeEntry

        strategy.entry(
             "BUY",
             strategy.long)

        strategy.exit(
             "BUY EXIT",
             from_entry="BUY",
             limit=activeTP,
             stop=activeSL)

        if showTradeBoxes

            activeTPBox := box.new(
                 left=bar_index,
                 top=activeTP,
                 right=bar_index,
                 bottom=activeEntry,
                 bgcolor=tpColor,
                 border_color=color.new(tpColor, 0))

            activeSLBox := box.new(
                 left=bar_index,
                 top=activeEntry,
                 right=bar_index,
                 bottom=activeSL,
                 bgcolor=slColor,
                 border_color=color.new(slColor, 0))

// ============================================================================
// SELL TRADE
// ============================================================================

if finalSell and
   strategy.position_size == 0 and
   not na(rangeLow)

    activeEntry := close
    activeTP := rangeLow

    float tpDistance = activeEntry - activeTP

    activeSL := activeEntry + (tpDistance / riskReward)

    originalSLDistance := math.abs(activeEntry - activeSL)

    activeTradeBar := bar_index
    activeTradeDirection := -1
    slAdjusted := false

    if activeTP < activeEntry and
       activeSL > activeEntry

        strategy.entry(
             "SELL",
             strategy.short)

        strategy.exit(
             "SELL EXIT",
             from_entry="SELL",
             limit=activeTP,
             stop=activeSL)

        if showTradeBoxes

            activeTPBox := box.new(
                 left=bar_index,
                 top=activeEntry,
                 right=bar_index,
                 bottom=activeTP,
                 bgcolor=tpColor,
                 border_color=color.new(tpColor, 0))

            activeSLBox := box.new(
                 left=bar_index,
                 top=activeSL,
                 right=bar_index,
                 bottom=activeEntry,
                 bgcolor=slColor,
                 border_color=color.new(slColor, 0))

// ============================================================================
// STOP LOSS ADJUSTMENT
// ============================================================================

bool inLongTrade =
     strategy.position_size > 0 and
     activeTradeDirection == 1

bool inShortTrade =
     strategy.position_size < 0 and
     activeTradeDirection == -1

// ============================================================================
// BUY STOP ADJUSTMENT
// ============================================================================

if adjustStopLoss and
   inLongTrade and
   not slAdjusted and
   not na(activeEntry) and
   not na(activeTP) and
   not na(originalSLDistance)

    float buyTPDistance = activeTP - activeEntry

    float buyTriggerPrice =
         activeEntry +
         buyTPDistance *
         (slAdjustmentTriggerPercent / 100.0)

    if high >= buyTriggerPrice

        float newSLDistance =
             originalSLDistance *
             (slRemainingPercent / 100.0)

        activeSL :=
             activeEntry - newSLDistance

        slAdjusted := true

// ============================================================================
// SELL STOP ADJUSTMENT
// ============================================================================

if adjustStopLoss and
   inShortTrade and
   not slAdjusted and
   not na(activeEntry) and
   not na(activeTP) and
   not na(originalSLDistance)

    float sellTPDistance = activeEntry - activeTP

    float sellTriggerPrice =
         activeEntry -
         sellTPDistance *
         (slAdjustmentTriggerPercent / 100.0)

    if low <= sellTriggerPrice

        float newSLDistance =
             originalSLDistance *
             (slRemainingPercent / 100.0)

        activeSL :=
             activeEntry + newSLDistance

        slAdjusted := true

// ============================================================================
// UPDATE BUY EXIT
// ============================================================================

if inLongTrade and
   not na(activeTP) and
   not na(activeSL)

    strategy.exit(
         "BUY EXIT",
         from_entry="BUY",
         limit=activeTP,
         stop=activeSL)

// ============================================================================
// UPDATE SELL EXIT
// ============================================================================

if inShortTrade and
   not na(activeTP) and
   not na(activeSL)

    strategy.exit(
         "SELL EXIT",
         from_entry="SELL",
         limit=activeTP,
         stop=activeSL)

// ============================================================================
// TP / SL BOX MANAGEMENT
// ============================================================================

if strategy.position_size != 0

    if not na(activeTPBox)
        box.set_right(activeTPBox, bar_index)

    if not na(activeSLBox)
        box.set_right(activeSLBox, bar_index)

// ============================================================================
// DETECT TRADE EXIT
// ============================================================================

bool tradeJustClosed =
     strategy.position_size == 0 and
     strategy.position_size[1] != 0

// ============================================================================
// STOP BOXES ON EXIT
// ============================================================================

if tradeJustClosed

    if not na(activeTPBox)
        box.set_right(activeTPBox, bar_index)

    if not na(activeSLBox)
        box.set_right(activeSLBox, bar_index)

    activeTPBox := na
    activeSLBox := na

    activeEntry := na
    activeTP := na
    activeSL := na
    originalSLDistance := na

    activeTradeBar := na
    activeTradeDirection := 0

    slAdjusted := false

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(
     finalBuy,
     title="BUY Signal",
     message="BUY: Price interacted with the selected low and confirmed bullish displacement.")

alertcondition(
     finalSell,
     title="SELL Signal",
     message="SELL: Price interacted with the selected high and confirmed bearish displacement.")