//@version=6
// =============================================================================
// Aura Profiles - Light Theme Edition [Pro Series]
// Volume Profile, Weekly Levels & Swing High/Low Structure
// =============================================================================
indicator("Aura Profiles - Light Theme", shorttitle="Aura Light", overlay=true, 
     max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// --------------------------------- INPUTS ------------------------------------
g_pe        = "Volume Profile Settings"
i_period    = input.timeframe("D", "Profile Period", group=g_pe)
i_vaPct     = input.float(70.0, "Value Area %", minval=50, maxval=95, group=g_pe)
i_rows      = input.int(28, "Profile Rows", minval=10, maxval=60, group=g_pe)
i_offset    = input.int(8, "Margin Offset (Bars)", minval=2, maxval=50, group=g_pe)
i_maxWidth  = input.int(35, "Max Profile Width (Bars)", minval=5, maxval=100, group=g_pe)

g_levels    = "Weekly & Swing Levels"
i_showWeek  = input.bool(true, "Show Weekly High / Low Lines", group=g_levels)
i_showSwings= input.bool(true, "Show Swing High / Low Labels", group=g_levels)
i_swingLen  = input.int(7, "Swing Pivot Length", minval=2, maxval=50, group=g_levels)

g_col       = "Light Theme Color Palette"
c_vol       = input.color(#0284C7, "Volume Bars (Sky Blue)", group=g_col)
c_poc       = input.color(#D97706, "POC Line (Amber Gold)", group=g_col)
c_va        = input.color(#4F46E5, "Value Area (Indigo)", group=g_col)
c_wHigh     = input.color(#DC2626, "Weekly High (Crimson)", group=g_col)
c_wLow      = input.color(#16A34A, "Weekly Low (Green)", group=g_col)
c_swHigh    = input.color(#B91C1C, "Swing High Text", group=g_col)
c_swLow     = input.color(#15803D, "Swing Low Text", group=g_col)

// ---------------------------- WEEKLY HIGH & LOW ------------------------------
[wHigh, wLow] = request.security(syminfo.tickerid, "W", [high, low])

var line lineWHigh = na
var line lineWLow  = na
var label lblWHigh = na
var label lblWLow  = na

if i_showWeek and barstate.islast
    line.delete(lineWHigh)
    line.delete(lineWLow)
    label.delete(lblWHigh)
    label.delete(lblWLow)
    
    lineWHigh := line.new(bar_index - 40, wHigh, bar_index + i_offset + i_maxWidth, wHigh, color=c_wHigh, width=2, style=line.style_dashed)
    lineWLow  := line.new(bar_index - 40, wLow, bar_index + i_offset + i_maxWidth, wLow, color=c_wLow, width=2, style=line.style_dashed)
    
    lblWHigh := label.new(bar_index + i_offset + i_maxWidth, wHigh, "Week High: " + str.tostring(wHigh, "#.##"), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c_wHigh, 90), textcolor=c_wHigh, size=size.small)
    lblWLow  := label.new(bar_index + i_offset + i_maxWidth, wLow, "Week Low: " + str.tostring(wLow, "#.##"), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c_wLow, 90), textcolor=c_wLow, size=size.small)

// ---------------------------- SWING HIGH & LOW -------------------------------
pivotH = ta.pivothigh(high, i_swingLen, i_swingLen)
pivotL = ta.pivotlow(low, i_swingLen, i_swingLen)

if i_showSwings
    if not na(pivotH)
        label.new(bar_index - i_swingLen, pivotH, "SH\n" + str.tostring(pivotH, "#.##"), style=label.style_label_down, color=color.new(c_swHigh, 90), textcolor=c_swHigh, size=size.tiny)
    if not na(pivotL)
        label.new(bar_index - i_swingLen, pivotL, "SL\n" + str.tostring(pivotL, "#.##"), style=label.style_label_up, color=color.new(c_swLow, 90), textcolor=c_swLow, size=size.tiny)

// ---------------------------- PROFILE CALCULATION ----------------------------
var float[] profileVol = array.new<float>(i_rows, 0.0)
var float pHigh = na
var float pLow  = na

isNewPeriod = timeframe.change(i_period)

if isNewPeriod or na(pHigh)
    pHigh := high
    pLow  := low
    array.fill(profileVol, 0.0)
else
    pHigh := math.max(pHigh, high)
    pLow  := math.min(pLow, low)

rowStep = (pHigh - pLow) / i_rows

if rowStep > 0
    for i = 0 to i_rows - 1
        bLow  = pLow + i * rowStep
        bHigh = bLow + rowStep
        if low <= bHigh and high >= bLow
            v = volume / i_rows
            array.set(profileVol, i, array.get(profileVol, i) + v)

// ------------------------------ POC & VALUE AREA -----------------------------
float pocPx  = na
float vahPx  = na
float valPx  = na
int   pocIdx = 0

if barstate.islast and rowStep > 0
    maxV = array.max(profileVol)
    if maxV > 0
        pocIdx := array.indexof(profileVol, maxV)
        pocPx  := pLow + pocIdx * rowStep + (rowStep / 2.0)
        
        totVol = array.sum(profileVol)
        target = totVol * (i_vaPct / 100.0)
        
        accVol = maxV
        uIdx   = pocIdx
        dIdx   = pocIdx
        
        while accVol < target and (uIdx < i_rows - 1 or dIdx > 0)
            vUp = uIdx < i_rows - 1 ? array.get(profileVol, uIdx + 1) : -1.0
            vDn = dIdx > 0          ? array.get(profileVol, dIdx - 1) : -1.0
            if vUp >= vDn
                uIdx   += 1
                accVol += math.max(vUp, 0.0)
            else
                dIdx   -= 1
                accVol += math.max(vDn, 0.0)
                
        vahPx := pLow + (uIdx + 1) * rowStep
        valPx := pLow + dIdx * rowStep

// ------------------------------ VISUAL DRAWINGS ------------------------------
var box[] profileBoxes = array.new<box>()
var line  linePoc      = na
var line  lineVah      = na
var line  lineVal      = na

if barstate.islast and not na(pocPx)
    for b in profileBoxes
        box.delete(b)
    array.clear(profileBoxes)
    
    line.delete(linePoc)
    line.delete(lineVah)
    line.delete(lineVal)

    maxVol = array.max(profileVol)
    
    if maxVol > 0
        for i = 0 to i_rows - 1
            vol = array.get(profileVol, i)
            if vol > 0
                wBars = int(math.round((vol / maxVol) * i_maxWidth))
                if wBars > 0
                    bLeft  = bar_index + i_offset
                    bRight = bLeft + wBars
                    bTop   = pLow + (i + 1) * rowStep
                    bBtm   = pLow + i * rowStep
                    
                    bColor = (i == pocIdx) ? color.new(c_poc, 15) : color.new(c_vol, 35)
                    bBox   = box.new(left=bLeft, top=bTop, right=bRight, bottom=bBtm, 
                                     bgcolor=bColor, border_color=color.new(color.black, 90))
                    array.push(profileBoxes, bBox)

    linePoc := line.new(x1=bar_index, y1=pocPx, x2=bar_index + i_offset + i_maxWidth, y2=pocPx, color=c_poc, width=2, style=line.style_solid)
    lineVah := line.new(x1=bar_index, y1=vahPx, x2=bar_index + i_offset + i_maxWidth, y2=vahPx, color=c_va, width=2, style=line.style_dashed)
    lineVal := line.new(x1=bar_index, y1=valPx, x2=bar_index + i_offset + i_maxWidth, y2=valPx, color=c_va, width=2, style=line.style_dashed)

// -------------------------------- DASHBOARD (LIGHT THEME) --------------------
var table db = table.new(position=position.top_right, columns=2, rows=6, bgcolor=color.new(color.white, 0), border_width=1, border_color=color.new(color.gray, 50))
if barstate.islast
    table.cell(db, 0, 0, "Level", text_color=color.black, bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(db, 1, 0, "Price", text_color=color.black, bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(db, 0, 1, "Week High", text_color=c_wHigh, text_size=size.small)
    table.cell(db, 1, 1, str.tostring(wHigh, "#.##"), text_color=color.black, text_size=size.small)
    table.cell(db, 0, 2, "VAH", text_color=c_va, text_size=size.small)
    table.cell(db, 1, 2, str.tostring(vahPx, "#.##"), text_color=color.black, text_size=size.small)
    table.cell(db, 0, 3, "POC", text_color=c_poc, text_size=size.small)
    table.cell(db, 1, 3, str.tostring(pocPx, "#.##"), text_color=color.black, text_size=size.small)
    table.cell(db, 0, 4, "VAL", text_color=c_va, text_size=size.small)
    table.cell(db, 1, 4, str.tostring(valPx, "#.##"), text_color=color.black, text_size=size.small)
    table.cell(db, 0, 5, "Week Low", text_color=c_wLow, text_size=size.small)
    table.cell(db, 1, 5, str.tostring(wLow, "#.##"), text_color=color.black, text_size=size.small)

