// ╔══════════════════════════════════════════════════════════════╗
// ║        CNPS UNIVERSAL BOT TEMPLATE — Pine Script v5          ║
// ║  Áp dụng: VN30F1M | Trend Following                         ║
// ║  Version: CNPS 10 SMA PSAR                                   ║
// ╚══════════════════════════════════════════════════════════════╝
// Tác giả: https://phaisinh.online/
// Nhóm cộng đồng: https://zalo.me/g/jvaykb078

//@version=5
strategy(
     title       = "CNPS 10 SMA PSAR",
     shorttitle  = "CNPS 10",
     overlay     = true,
     initial_capital    = 100000000,
     default_qty_type   = strategy.fixed,
     default_qty_value  = 1
 )


// ════════════════════════════════════════════════════════════════
// SECTION 1: INPUTS
// ════════════════════════════════════════════════════════════════

// ── Cài đặt chỉ báo ─────────────────────────────────────────────
smaLen    = input.int(14,     title="Chu kỳ SMA tín hiệu", minval=1,     group="Cài đặt chỉ báo")
psarStep  = input.float(0.02, title="PSAR Bước (Step)",    minval=0.001, step=0.001, group="Cài đặt chỉ báo")
psarMax   = input.float(0.2,  title="PSAR Tối đa (Max)",   minval=0.01,  step=0.01,  group="Cài đặt chỉ báo")

// ── Chiều giao dịch ─────────────────────────────────────────────
tradeDir = input.string("Cả hai", title="Chiều giao dịch",
             options=["Mua", "Bán", "Cả hai"], group="Chiều giao dịch")

// ── Cắt lỗ / Chốt lời ───────────────────────────────────────────
slPoints = input.float(10.0, title="Cắt lỗ (điểm)",   minval=0.1, step=0.5, group="Cắt lỗ / Chốt lời")
useTP    = input.bool(true,  title="Dùng chốt lời?",              group="Cắt lỗ / Chốt lời")
tpPoints = input.float(30.0, title="Chốt lời (điểm)", minval=0.1, step=0.5, group="Cắt lỗ / Chốt lời")

// ── Bộ lọc giờ ──────────────────────────────────────────────────
useTimeFilter = input.bool(true, title="Dùng bộ lọc giờ?",   group="Bộ lọc giờ")
startHour     = input.int(9,     title="Giờ bắt đầu",  minval=0, maxval=23, group="Bộ lọc giờ")
startMinute   = input.int(0,     title="Phút bắt đầu", minval=0, maxval=59, group="Bộ lọc giờ")
endHour       = input.int(14,    title="Giờ kết thúc", minval=0, maxval=23, group="Bộ lọc giờ")
endMinute     = input.int(30,    title="Phút kết thúc", minval=0, maxval=59, group="Bộ lọc giờ")


// ════════════════════════════════════════════════════════════════
// SECTION 2: INDICATORS
// ════════════════════════════════════════════════════════════════

// ── SMA tín hiệu ────────────────────────────────────────────────
smaVal  = ta.sma(close, smaLen)
smaUp   = smaVal > smaVal[1]    // SMA đang tăng → Bull
smaDown = smaVal < smaVal[1]    // SMA đang giảm → Bear

// ── Parabolic SAR ────────────────────────────────────────────────
psarVal = ta.sar(psarStep, psarStep, psarMax)

// Xác định vị trí giá so với PSAR
priceAbovePsar = close > psarVal   // Giá trên PSAR → Bull
priceBelowPsar = close < psarVal   // Giá dưới PSAR → Bear


// ════════════════════════════════════════════════════════════════
// SECTION 3: SIGNAL LOGIC
// ════════════════════════════════════════════════════════════════

// Tín hiệu xác nhận tại ĐÓNG CỬA nến tín hiệu → Vào lệnh tại MỞ CỬA nến kế tiếp

// Mua: SMA dốc lên VÀ giá trên PSAR
rawLong  = smaUp   and priceAbovePsar
// Bán: SMA dốc xuống VÀ giá dưới PSAR
rawShort = smaDown and priceBelowPsar

// ── Tín hiệu thoát lệnh (OR logic) ──────────────────────────────
// Thoát Long: SMA dốc xuống HOẶC giá dưới PSAR
exitLong  = smaDown or not priceAbovePsar
// Thoát Short: SMA dốc lên HOẶC giá trên PSAR
exitShort = smaUp   or not priceBelowPsar

// ── Áp dụng chiều giao dịch ─────────────────────────────────────
canLongDir  = tradeDir == "Mua"   or tradeDir == "Cả hai"
canShortDir = tradeDir == "Bán"   or tradeDir == "Cả hai"

longSignal  = rawLong  and canLongDir
shortSignal = rawShort and canShortDir


// ════════════════════════════════════════════════════════════════
// SECTION 4: TIME FILTER
// ════════════════════════════════════════════════════════════════

sessionStart   = startHour * 60 + startMinute
sessionEnd     = endHour   * 60 + endMinute
currentMinutes = hour * 60 + minute

inSession = useTimeFilter
             ? (currentMinutes >= sessionStart and currentMinutes < sessionEnd)
             : true

// Phát hiện thời điểm phiên vừa kết thúc (chuyển từ trong phiên → ngoài phiên)
sessionJustEnded = useTimeFilter and not inSession and inSession[1]


// ════════════════════════════════════════════════════════════════
// SECTION 5: ENTRY / EXIT / REVERSE
// ════════════════════════════════════════════════════════════════

// ── Đóng lệnh cuối phiên ────────────────────────────────────────
if sessionJustEnded and strategy.position_size != 0
    strategy.close_all(comment="Hết phiên")

// ── Thoát theo tín hiệu (OR: SMA đảo chiều HOẶC giá vượt PSAR) ──
// Đặt trước entry để tránh xung đột cùng nến
if strategy.position_size > 0 and exitLong
    strategy.close("Mua", comment="Thoát tín hiệu")

if strategy.position_size < 0 and exitShort
    strategy.close("Bán", comment="Thoát tín hiệu")

// ── Điều kiện vào lệnh (chỉ trong phiên + đúng chiều) ───────────
canLong  = longSignal  and inSession
canShort = shortSignal and inSession

// ── Tính mức cắt lỗ / chốt lời từ giá vào lệnh ─────────────────
longSL  = strategy.position_avg_price - slPoints
longTP  = strategy.position_avg_price + tpPoints
shortSL = strategy.position_avg_price + slPoints
shortTP = strategy.position_avg_price - tpPoints

// ── Vào lệnh ────────────────────────────────────────────────────
if canLong
    strategy.entry("Mua", strategy.long)

if canShort
    strategy.entry("Bán", strategy.short)

// ── Thoát lệnh: cắt lỗ / chốt lời ──────────────────────────────
if strategy.position_size > 0
    strategy.exit("Thoát Mua", "Mua",
         stop  = longSL,
         limit = useTP ? longTP : na)

if strategy.position_size < 0
    strategy.exit("Thoát Bán", "Bán",
         stop  = shortSL,
         limit = useTP ? shortTP : na)


// ════════════════════════════════════════════════════════════════
// SECTION 6: PLOTTING
// ════════════════════════════════════════════════════════════════

// ── SMA tín hiệu ────────────────────────────────────────────────
plot(smaVal,
     title     = "SMA tín hiệu",
     color     = smaUp ? color.new(color.blue, 0) : color.new(color.orange, 0),
     linewidth = 2)

// ── Parabolic SAR ────────────────────────────────────────────────
plot(psarVal,
     title     = "Parabolic SAR",
     color     = priceAbovePsar ? color.new(color.teal, 0) : color.new(color.red, 0),
     style     = plot.style_circles,
     linewidth = 1)

// ── Mức cắt lỗ / chốt lời (chỉ hiện khi đang có vị thế) ────────
isLong  = strategy.position_size > 0
isShort = strategy.position_size < 0

plot(isLong  ? longSL  : na, title="Cắt lỗ Mua",   color=color.red,   style=plot.style_linebr, linewidth=1)
plot(isShort ? shortSL : na, title="Cắt lỗ Bán",   color=color.red,   style=plot.style_linebr, linewidth=1)
plot(isLong  and useTP ? longTP  : na, title="Chốt lời Mua", color=color.green, style=plot.style_linebr, linewidth=1)
plot(isShort and useTP ? shortTP : na, title="Chốt lời Bán", color=color.green, style=plot.style_linebr, linewidth=1)

// ── Tín hiệu vào lệnh ───────────────────────────────────────────
plotshape(longSignal  and inSession and canLongDir,
     title    = "Tín hiệu Mua",
     location = location.belowbar,
     color    = color.new(color.green, 0),
     style    = shape.triangleup,
     size     = size.small)

plotshape(shortSignal and inSession and canShortDir,
     title    = "Tín hiệu Bán",
     location = location.abovebar,
     color    = color.new(color.red, 0),
     style    = shape.triangledown,
     size     = size.small)

// ── Nền xám ngoài phiên ─────────────────────────────────────────
bgcolor(useTimeFilter and not inSession ? color.new(color.gray, 90) : na,
     title="Ngoài phiên giao dịch")
