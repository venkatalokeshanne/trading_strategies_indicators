//@version=6
// ============================================================================
//  CRT AMD Multi-Session Precision Indicator  —  v2 (per-session colors, 1:3 RR)
//  Confirmation-based model: CRT / AMD (1-5-9) + liquidity sweep + MTF bias
//  + market structure (CHoCH/BOS) + FVG + supply/demand confluence.
//
//  Per-session colors:  NY = pink | Tokyo/Asian = purple | London = red
//  RR model: signals require >= minimum RR of clean room to opposite liquidity.
//
//  NOT a guarantee of profitability. A selective FILTER for higher-quality
//  setups. Backtest and forward-test before risking capital.
//
//  No repaint: request.security uses lookahead_off; structure uses CONFIRMED
//  pivots; entries gated by barstate.isconfirmed (bar close only).
// ============================================================================
indicator("CRT AMD Multi-Session Precision Indicator", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ============================================================================
//  INPUTS
// ============================================================================
// ---- General ----
tz             = input.string("America/New_York", "Timezone", options = ["America/New_York", "America/Chicago", "Europe/London", "Asia/Tokyo", "UTC"], group = "General")
setupMode      = input.string("Conservative", "Setup Mode", options = ["Conservative", "Balanced", "Aggressive"], group = "General", tooltip = "Conservative = all filters. Balanced = 4H not opposite. Aggressive = sweep + 5M BOS + zone only.")
require15m     = input.bool(true, "Require 15M CHoCH/BOS Confirmation", group = "General")
rrTarget       = input.float(3.0, "Minimum Risk/Reward (1:X)", minval = 1.0, step = 0.5, group = "General", tooltip = "Signal only fires if there is at least this much room to the nearest opposite liquidity, or open space beyond it.")
requireRR      = input.bool(true, "Require RR room to real liquidity target", group = "General")

// ---- Sessions (times editable, timezone-aware) ----
nyEnabled      = input.bool(true, "Enable", inline = "ny", group = "New York Session")
nyRange        = input.session("0930-0945", "Range", inline = "ny", group = "New York Session")
nySignal       = input.session("0950-1600", "Signal window", inline = "ny2", group = "New York Session")

lonEnabled     = input.bool(true, "Enable", inline = "lon", group = "London Session")
lonRange       = input.session("0300-0315", "Range", inline = "lon", group = "London Session")
lonSignal      = input.session("0320-1200", "Signal window", inline = "lon2", group = "London Session")

tokEnabled     = input.bool(true, "Enable", inline = "tok", group = "Tokyo / Asian Session")
tokRange       = input.session("2045-2100", "Range", inline = "tok", group = "Tokyo / Asian Session", tooltip = "Some users prefer 0845-0900. Fully editable.")
tokSignal      = input.session("2105-0400", "Signal window", inline = "tok2", group = "Tokyo / Asian Session")

// ---- Structure / pivots ----
piv4           = input.int(2, "4H pivot length", minval = 1, group = "Structure")
piv1           = input.int(2, "1H pivot length", minval = 1, group = "Structure")
piv15          = input.int(2, "15M pivot length", minval = 1, group = "Structure")
piv5           = input.int(2, "5M pivot length", minval = 1, group = "Structure")
atrLen         = input.int(14, "ATR length", minval = 1, group = "Structure")

// ---- FVG ----
showFVG        = input.bool(true, "Show FVG boxes", group = "FVG")
maxFVG         = input.int(3, "Max FVG per side", minval = 1, maxval = 10, group = "FVG")
fvgAtrMult     = input.float(0.25, "Min FVG size (ATR x)", minval = 0.0, step = 0.05, group = "FVG")
requireDisp    = input.bool(false, "Require displacement candle", group = "FVG")
dispAtrMult    = input.float(0.8, "Displacement body (ATR x)", minval = 0.1, step = 0.1, group = "FVG")

// ---- Supply / Demand ----
showSD         = input.bool(true, "Show Supply/Demand zones", group = "Supply / Demand")
maxSD          = input.int(3, "Max zones per side", minval = 1, maxval = 10, group = "Supply / Demand")

// ---- Liquidity ----
showLiq        = input.bool(true, "Show liquidity (PDH/PDL + external)", group = "Liquidity")
eqTol          = input.float(0.1, "Equal H/L tolerance (ATR x)", minval = 0.0, step = 0.05, group = "Liquidity")

// ---- Visuals ----
showSessions   = input.bool(true, "Show session ranges", group = "Visuals")
showCRT        = input.bool(true, "Show CRT/sweep labels", group = "Visuals")
showRR         = input.bool(true, "Show RR boxes", group = "Visuals")
showSLTP       = input.bool(true, "Show SL/TP labels", group = "Visuals")
showDash       = input.bool(true, "Show dashboard", group = "Visuals")
showOnlyLatest = input.bool(true, "Show only latest setup per session", group = "Visuals")
rangeThick     = input.int(3, "Range ray thickness", minval = 1, group = "Visuals")

// ---- Colors (per-session) ----
nyCol          = input.color(color.new(#ff66b3, 0), "New York session (pink)", group = "Colors")
tokCol         = input.color(color.new(color.purple, 0), "Tokyo / Asian session (purple)", group = "Colors")
lonCol         = input.color(color.new(color.red, 0), "London session (red)", group = "Colors")
bullFvgCol     = input.color(color.new(color.green, 82), "Bullish FVG", group = "Colors")
bearFvgCol     = input.color(color.new(color.red, 82), "Bearish FVG", group = "Colors")
demandCol      = input.color(color.new(color.green, 85), "Demand zone", group = "Colors")
supplyCol      = input.color(color.new(color.red, 85), "Supply zone", group = "Colors")
manipCol       = input.color(color.new(color.orange, 10), "Manipulation label", group = "Colors")
buyCol         = input.color(color.green, "Buy label", group = "Colors")
sellCol        = input.color(color.red, "Sell label", group = "Colors")

// ============================================================================
//  GLOBAL HELPERS
// ============================================================================
atr      = ta.atr(atrLen)
buf      = atr * 0.10
isFiveM  = timeframe.period == "5"
isNewDay = dayofmonth != dayofmonth[1]

// ---- Market structure engine (confirmed pivots => no repaint) ----
f_structure(int len) =>
    ph = ta.pivothigh(len, len)
    pl = ta.pivotlow(len, len)
    var float lastPH = na
    var float lastPL = na
    var int   dir    = 0
    if not na(ph)
        lastPH := ph
    if not na(pl)
        lastPL := pl
    bosUp = not na(lastPH) and ta.crossover(close, lastPH)
    bosDn = not na(lastPL) and ta.crossunder(close, lastPL)
    chochUp = false
    chochDn = false
    if bosUp
        if dir == -1
            chochUp := true
        dir := 1
    if bosDn
        if dir == 1
            chochDn := true
        dir := -1
    [bosUp, bosDn, chochUp, chochDn, dir, lastPH, lastPL]

f_htf4() =>
    [bu, bd, cu, cd, d, lph, lpl] = f_structure(piv4)
    [d, lph, lpl]

f_htf15() =>
    [bu, bd, cu, cd, d, lph, lpl] = f_structure(piv15)
    [bu, bd, cu, cd, d]

f_htf1() =>
    ph = ta.pivothigh(piv1, piv1)
    pl = ta.pivotlow(piv1, piv1)
    var float res = na
    var float sup = na
    if not na(ph)
        res := ph
    if not na(pl)
        sup := pl
    [res, sup]

// ============================================================================
//  MULTI-TIMEFRAME DATA (all lookahead_off => non-repainting context)
// ============================================================================
[bias4, ext4H, ext4L]                = request.security(syminfo.tickerid, "240", f_htf4(),  lookahead = barmerge.lookahead_off)
[bos15u, bos15d, choch15u, choch15d, dir15] = request.security(syminfo.tickerid, "15",  f_htf15(), lookahead = barmerge.lookahead_off)
[res1h, sup1h]                       = request.security(syminfo.tickerid, "60",  f_htf1(),  lookahead = barmerge.lookahead_off)
[pdh, pdl]                           = request.security(syminfo.tickerid, "D",   [high[1], low[1]], lookahead = barmerge.lookahead_off)

[bos5u, bos5d, choch5u, choch5d, dir5, ph5, pl5] = f_structure(piv5)

mid4     = na(ext4H) or na(ext4L) ? na : (ext4H + ext4L) / 2.0
discount = na(mid4) or close <= mid4
premium  = na(mid4) or close >= mid4

zbuf          = atr * 0.5
nearSupport   = (not na(sup1h) and math.abs(close - sup1h) <= zbuf) or (not na(pdl) and math.abs(close - pdl) <= zbuf)
nearResistance= (not na(res1h) and math.abs(close - res1h) <= zbuf) or (not na(pdh) and math.abs(close - pdh) <= zbuf)

// ============================================================================
//  SESSION MODULE  (one function, called 3x => independent state each call)
// ============================================================================
f_session(bool enabled, string rSess, string sSess, string tzStr, color col, int thick, bool show, string tag) =>
    var float rh    = na
    var float rl    = na
    var int   rhBar = na
    var int   rlBar = na
    var line  hiRay = na
    var line  loRay = na
    var label rLbl  = na
    var bool  swH   = false
    var bool  swL   = false
    inRange = enabled and not na(time(timeframe.period, rSess, tzStr))
    sigOK   = enabled and not na(time(timeframe.period, sSess, tzStr))
    rStart  = inRange and not inRange[1]
    rEnd    = not inRange and inRange[1]
    if rStart
        rh := high
        rl := low
        rhBar := bar_index
        rlBar := bar_index
        swH := false
        swL := false
        line.delete(hiRay)
        line.delete(loRay)
        label.delete(rLbl)
    else if inRange
        if high > rh
            rh := high
            rhBar := bar_index
        if low < rl
            rl := low
            rlBar := bar_index
    if rEnd and show and not na(rh) and not na(rl)
        line.delete(hiRay)
        line.delete(loRay)
        label.delete(rLbl)
        hiRay := line.new(rhBar, rh, bar_index + 30, rh, color = col, width = thick)
        loRay := line.new(rlBar, rl, bar_index + 30, rl, color = col, width = thick)
        rLbl  := label.new(rhBar, rh, tag, color = color.new(col, 70), textcolor = col, style = label.style_label_down, size = size.small)
    if not na(hiRay)
        line.set_x2(hiRay, bar_index + 5)
    if not na(loRay)
        line.set_x2(loRay, bar_index + 5)
    if sigOK and not na(rh) and not na(rl)
        if high > rh
            swH := true
        if low < rl
            swL := true
    manipUp = swL and close > rl
    manipDn = swH and close < rh
    [rh, rl, inRange, sigOK, manipUp, manipDn]

[nyRH, nyRL, nyIn, nySig, nyMU, nyMD]       = f_session(nyEnabled,  nyRange,  nySignal,  tz, nyCol,  rangeThick, showSessions, "NY RANGE")
[lonRH, lonRL, lonIn, lonSig, lonMU, lonMD] = f_session(lonEnabled, lonRange, lonSignal, tz, lonCol, rangeThick, showSessions, "LONDON RANGE")
[tokRH, tokRL, tokIn, tokSig, tokMU, tokMD] = f_session(tokEnabled, tokRange, tokSignal, tz, tokCol, rangeThick, showSessions, "TOKYO RANGE")

anySweepUp = (nySig and nyMU) or (lonSig and lonMU) or (tokSig and tokMU)
anySweepDn = (nySig and nyMD) or (lonSig and lonMD) or (tokSig and tokMD)
var bool sweepLblUpDone = false
var bool sweepLblDnDone = false
if isNewDay
    sweepLblUpDone := false
    sweepLblDnDone := false
if showCRT and isFiveM and anySweepUp and not sweepLblUpDone and barstate.isconfirmed
    label.new(bar_index, low, "Sweep ↓ (CRL)", color = color.new(manipCol, 20), textcolor = color.white, style = label.style_label_up, size = size.tiny)
    sweepLblUpDone := true
if showCRT and isFiveM and anySweepDn and not sweepLblDnDone and barstate.isconfirmed
    label.new(bar_index, high, "Sweep ↑ (CRH)", color = color.new(manipCol, 20), textcolor = color.white, style = label.style_label_down, size = size.tiny)
    sweepLblDnDone := true

// ============================================================================
//  FAIR VALUE GAPS  (3-candle imbalance, ATR-filtered)
// ============================================================================
var float bullFvgTop = na
var float bullFvgBot = na
var float bearFvgTop = na
var float bearFvgBot = na
var box[] bullBoxes  = array.new<box>()
var box[] bearBoxes  = array.new<box>()

dispMid    = math.abs(close[1] - open[1]) > atr * dispAtrMult
bullFvgNew = low > high[2] and (low - high[2]) > atr * fvgAtrMult and (not requireDisp or dispMid)
bearFvgNew = high < low[2] and (low[2] - high) > atr * fvgAtrMult and (not requireDisp or dispMid)

if bullFvgNew
    bullFvgTop := low
    bullFvgBot := high[2]
    if showFVG
        b = box.new(bar_index - 2, bullFvgTop, bar_index + 10, bullFvgBot, bgcolor = bullFvgCol, border_color = na)
        array.push(bullBoxes, b)
        if array.size(bullBoxes) > maxFVG
            box.delete(array.shift(bullBoxes))
if bearFvgNew
    bearFvgTop := low[2]
    bearFvgBot := high
    if showFVG
        b = box.new(bar_index - 2, bearFvgTop, bar_index + 10, bearFvgBot, bgcolor = bearFvgCol, border_color = na)
        array.push(bearBoxes, b)
        if array.size(bearBoxes) > maxFVG
            box.delete(array.shift(bearBoxes))

bullFvgRetest = not na(bullFvgTop) and low <= bullFvgTop and high >= bullFvgBot
bearFvgRetest = not na(bearFvgTop) and high >= bearFvgBot and low <= bearFvgTop

// ============================================================================
//  SUPPLY / DEMAND ZONES (origin candle of the impulse that broke structure)
// ============================================================================
var float demTop = na
var float demBot = na
var float supTop = na
var float supBot = na
var box[] demBoxes = array.new<box>()
var box[] supBoxes = array.new<box>()

f_demand() =>
    float zt = na
    float zb = na
    for i = 1 to 2
        if close[i] < open[i]
            zt := high[i]
            zb := low[i]
            break
    [zt, zb]

f_supply() =>
    float zt = na
    float zb = na
    for i = 1 to 20
        if close[i] > open[i]
            zt := high[i]
            zb := low[i]
            break
    [zt, zb]

if bos5u
    [zt, zb] = f_demand()
    if not na(zt)
        demTop := zt
        demBot := zb
        if showSD
            b = box.new(bar_index - 1, demTop, bar_index + 10, demBot, bgcolor = demandCol, border_color = na)
            array.push(demBoxes, b)
            if array.size(demBoxes) > maxSD
                box.delete(array.shift(demBoxes))
if bos5d
    [zt, zb] = f_supply()
    if not na(zt)
        supTop := zt
        supBot := zb
        if showSD
            b = box.new(bar_index - 1, supTop, bar_index + 10, supBot, bgcolor = supplyCol, border_color = na)
            array.push(supBoxes, b)
            if array.size(supBoxes) > maxSD
                box.delete(array.shift(supBoxes))

demRetest = not na(demTop) and low <= demTop and high >= demBot
supRetest = not na(supTop) and high >= supBot and low <= supTop

longZone  = bullFvgRetest or demRetest
shortZone = bearFvgRetest or supRetest

// ============================================================================
//  LIQUIDITY (PDH / PDL lines + equal highs/lows)
// ============================================================================
var line pdhLine = na
var line pdlLine = na
if showLiq and barstate.islast
    line.delete(pdhLine)
    line.delete(pdlLine)
    if not na(pdh)
        pdhLine := line.new(bar_index - 50, pdh, bar_index + 10, pdh, color = color.new(color.blue, 40), style = line.style_dotted)
    if not na(pdl)
        pdlLine := line.new(bar_index - 50, pdl, bar_index + 10, pdl, color = color.new(color.blue, 40), style = line.style_dotted)

eqHigh = not na(ph5) and not na(ext4H) and math.abs(ph5 - ext4H) <= atr * eqTol
eqLow  = not na(pl5) and not na(ext4L) and math.abs(pl5 - ext4L) <= atr * eqTol

// ============================================================================
//  RR ENGINE  (nearest opposite liquidity target + room check)
// ============================================================================
// Nearest liquidity in the direction of the trade (target candidates).
f_target(float entry, bool isLong) =>
    float t = na
    if isLong
        if not na(pdh) and pdh > entry
            t := na(t) ? pdh : math.min(t, pdh)
        if not na(ext4H) and ext4H > entry
            t := na(t) ? ext4H : math.min(t, ext4H)
        if not na(res1h) and res1h > entry
            t := na(t) ? res1h : math.min(t, res1h)
    else
        if not na(pdl) and pdl < entry
            t := na(t) ? pdl : math.max(t, pdl)
        if not na(ext4L) and ext4L < entry
            t := na(t) ? ext4L : math.max(t, ext4L)
        if not na(sup1h) and sup1h < entry
            t := na(t) ? sup1h : math.max(t, sup1h)
    t

// Is there at least minRR of clean room? (open space beyond all liquidity = ok)
f_rrOK(float entry, float sl, bool isLong, float minrr, bool req) =>
    risk = math.abs(entry - sl)
    tgt  = f_target(entry, isLong)
    reward = na(tgt) ? na : (isLong ? tgt - entry : entry - tgt)
    ok = risk > 0 and (na(tgt) or reward / risk >= minrr)
    not req or ok

// TP level: real liquidity if present, else projected minRR distance.
f_tp(float entry, float sl, bool isLong, float minrr) =>
    risk = math.abs(entry - sl)
    tgt  = f_target(entry, isLong)
    isLong ? (na(tgt) ? entry + risk * minrr : tgt) : (na(tgt) ? entry - risk * minrr : tgt)

// ============================================================================
//  ENTRY MODEL  (mode-gated confluence)
// ============================================================================
m15ok  = not require15m or (choch15u or bos15u)
m15okS = not require15m or (choch15d or bos15d)

longCons = bias4 == 1  and nearSupport    and discount and m15ok  and bos5u and longZone
longBal  = bias4 != -1 and m15ok  and bos5u and longZone
longAgg  = bos5u and longZone
longMTF  = setupMode == "Conservative" ? longCons : setupMode == "Balanced" ? longBal : longAgg

shortCons = bias4 == -1 and nearResistance and premium  and m15okS and bos5d and shortZone
shortBal  = bias4 != 1  and m15okS and bos5d and shortZone
shortAgg  = bos5d and shortZone
shortMTF  = setupMode == "Conservative" ? shortCons : setupMode == "Balanced" ? shortBal : shortAgg

// ============================================================================
//  SIGNAL RENDERING + RR VISUALS  (per-call-site state => one latest each)
// ============================================================================
f_signal(bool fire, bool isLong, string prefix, float entry, float slLevel, float tpLevel, color cBuy, color cSell, bool sRR, bool sSLTP, bool onlyLatest) =>
    var label  sigLbl  = na
    var line   eLine   = na
    var line   slLine  = na
    var line   tpLine  = na
    var box    riskBox = na
    var box    rewBox  = na
    if fire
        if onlyLatest
            label.delete(sigLbl)
            line.delete(eLine)
            line.delete(slLine)
            line.delete(tpLine)
            box.delete(riskBox)
            box.delete(rewBox)
        txt = prefix + (isLong ? " BUY CRT" : " SELL CRT")
        sigLbl := label.new(bar_index, isLong ? low : high, txt, color = isLong ? cBuy : cSell, textcolor = color.white, style = isLong ? label.style_label_up : label.style_label_down, size = size.normal)
        if sSLTP
            eLine  := line.new(bar_index, entry,   bar_index + 30, entry,   color = color.gray,  style = line.style_dashed)
            slLine := line.new(bar_index, slLevel, bar_index + 30, slLevel, color = color.red,   style = line.style_dashed)
            tpLine := line.new(bar_index, tpLevel, bar_index + 30, tpLevel, color = color.green, style = line.style_dashed)
        if sRR
            riskBox := box.new(bar_index, entry, bar_index + 30, slLevel, bgcolor = color.new(color.red, 88),   border_color = color.new(color.red, 60))
            rewBox  := box.new(bar_index, entry, bar_index + 30, tpLevel, bgcolor = color.new(color.green, 88), border_color = color.new(color.green, 60))

f_alertMsg(string sess, bool isLong, float entry, float sl, float tp) =>
    rr  = math.abs(entry - sl) > 0 ? math.abs(tp - entry) / math.abs(entry - sl) : na
    dir = isLong ? "BUY" : "SELL"
    syminfo.ticker + " " + sess + " " + dir + " CRT | Entry " + str.tostring(entry) + " | SL " + str.tostring(sl) + " | TP " + str.tostring(tp) + " | RR 1:" + str.tostring(math.round(rr * 10) / 10) + " | 4H " + (isLong ? "bull-bias" : "bear-bias") + ", 15M + 5M confirmed"

// ---- Per-session triggers (one signal per direction per session per day) ----
var bool nyBuyDone = false
var bool nySellDone = false
var bool lonBuyDone = false
var bool lonSellDone = false
var bool tokBuyDone = false
var bool tokSellDone = false
if isNewDay
    nyBuyDone := false
    nySellDone := false
    lonBuyDone := false
    lonSellDone := false
    tokBuyDone := false
    tokSellDone := false

confirmed = isFiveM and barstate.isconfirmed

// SL levels
nySLb  = math.min(nyRL,  na(pl5) ? nyRL  : pl5) - buf
nySLs  = math.max(nyRH,  na(ph5) ? nyRH  : ph5) + buf
lonSLb = math.min(lonRL, na(pl5) ? lonRL : pl5) - buf
lonSLs = math.max(lonRH, na(ph5) ? lonRH : ph5) + buf
tokSLb = math.min(tokRL, na(pl5) ? tokRL : pl5) - buf
tokSLs = math.max(tokRH, na(ph5) ? tokRH : ph5) + buf

// TP levels (nearest opposite liquidity or projected minRR)
nyTPb  = f_tp(close, nySLb, true,  rrTarget)
nyTPs  = f_tp(close, nySLs, false, rrTarget)
lonTPb = f_tp(close, lonSLb, true,  rrTarget)
lonTPs = f_tp(close, lonSLs, false, rrTarget)
tokTPb = f_tp(close, tokSLb, true,  rrTarget)
tokTPs = f_tp(close, tokSLs, false, rrTarget)

// Final fire conditions (confluence + RR room)
nyBuy  = nyEnabled  and nySig  and nyMU  and longMTF  and confirmed and not nyBuyDone   and f_rrOK(close, nySLb,  true,  rrTarget, requireRR)
nySell = nyEnabled  and nySig  and nyMD  and shortMTF and confirmed and not nySellDone  and f_rrOK(close, nySLs,  false, rrTarget, requireRR)
lonBuy = lonEnabled and lonSig and lonMU and longMTF  and confirmed and not lonBuyDone  and f_rrOK(close, lonSLb, true,  rrTarget, requireRR)
lonSell= lonEnabled and lonSig and lonMD and shortMTF and confirmed and not lonSellDone and f_rrOK(close, lonSLs, false, rrTarget, requireRR)
tokBuy = tokEnabled and tokSig and tokMU and longMTF  and confirmed and not tokBuyDone  and f_rrOK(close, tokSLb, true,  rrTarget, requireRR)
tokSell= tokEnabled and tokSig and tokMD and shortMTF and confirmed and not tokSellDone and f_rrOK(close, tokSLs, false, rrTarget, requireRR)

if nyBuy
    f_signal(true, true,  "NY", close, nySLb, nyTPb, buyCol, sellCol, showRR, showSLTP, showOnlyLatest)
    alert(f_alertMsg("NY", true,  close, nySLb, nyTPb), alert.freq_once_per_bar_close)
    nyBuyDone := true
if nySell
    f_signal(true, false, "NY", close, nySLs, nyTPs, buyCol, sellCol, showRR, showSLTP, showOnlyLatest)
    alert(f_alertMsg("NY", false, close, nySLs, nyTPs), alert.freq_once_per_bar_close)
    nySellDone := true
if lonBuy
    f_signal(true, true,  "LONDON", close, lonSLb, lonTPb, buyCol, sellCol, showRR, showSLTP, showOnlyLatest)
    alert(f_alertMsg("LONDON", true,  close, lonSLb, lonTPb), alert.freq_once_per_bar_close)
    lonBuyDone := true
if lonSell
    f_signal(true, false, "LONDON", close, lonSLs, lonTPs, buyCol, sellCol, showRR, showSLTP, showOnlyLatest)
    alert(f_alertMsg("LONDON", false, close, lonSLs, lonTPs), alert.freq_once_per_bar_close)
    lonSellDone := true
if tokBuy
    f_signal(true, true,  "TOKYO", close, tokSLb, tokTPb, buyCol, sellCol, showRR, showSLTP, showOnlyLatest)
    alert(f_alertMsg("TOKYO", true,  close, tokSLb, tokTPb), alert.freq_once_per_bar_close)
    tokBuyDone := true
if tokSell
    f_signal(true, false, "TOKYO", close, tokSLs, tokTPs, buyCol, sellCol, showRR, showSLTP, showOnlyLatest)
    alert(f_alertMsg("TOKYO", false, close, tokSLs, tokTPs), alert.freq_once_per_bar_close)
    tokSellDone := true

// ============================================================================
//  ALERTCONDITIONS
// ============================================================================
alertcondition(tokBuy,  title = "Tokyo Buy CRT",  message = "{{ticker}} TOKYO BUY CRT @ {{close}}")
alertcondition(tokSell, title = "Tokyo Sell CRT", message = "{{ticker}} TOKYO SELL CRT @ {{close}}")
alertcondition(lonBuy,  title = "London Buy CRT", message = "{{ticker}} LONDON BUY CRT @ {{close}}")
alertcondition(lonSell, title = "London Sell CRT",message = "{{ticker}} LONDON SELL CRT @ {{close}}")
alertcondition(nyBuy,   title = "New York Buy CRT",  message = "{{ticker}} NY BUY CRT @ {{close}}")
alertcondition(nySell,  title = "New York Sell CRT", message = "{{ticker}} NY SELL CRT @ {{close}}")
alertcondition(anySweepUp or anySweepDn, title = "Liquidity Sweep Detected", message = "{{ticker}} liquidity sweep detected @ {{close}}")
alertcondition(choch15u or choch15d, title = "15M CHoCH Confirmed", message = "{{ticker}} 15M CHoCH confirmed @ {{close}}")
alertcondition(bos5u or bos5d, title = "5M BOS Confirmed", message = "{{ticker}} 5M BOS confirmed @ {{close}}")
alertcondition(bullFvgRetest or bearFvgRetest, title = "FVG Retest Entry", message = "{{ticker}} FVG retest @ {{close}}")

// ============================================================================
//  DASHBOARD
// ============================================================================
var string m15state = "Neutral"
if choch15u
    m15state := "Bull CHoCH"
else if choch15d
    m15state := "Bear CHoCH"
else if bos15u
    m15state := "Bull BOS"
else if bos15d
    m15state := "Bear BOS"

f_col(string s) => s == "Bullish" or s == "Support" or str.contains(s, "Bull") or s == "Long Ready" ? color.new(color.green, 0) : s == "Bearish" or s == "Resistance" or str.contains(s, "Bear") or s == "Short Ready" ? color.new(color.red, 0) : s == "Waiting" ? color.new(color.orange, 0) : color.new(color.gray, 0)

biasTxt = bias4 == 1 ? "Bullish" : bias4 == -1 ? "Bearish" : "Neutral"
zoneTxt = nearSupport ? "Support" : nearResistance ? "Resistance" : "Neutral"
entryTxt= longMTF ? "Long Ready" : shortMTF ? "Short Ready" : "Waiting"
sessTxt = nyIn or nySig ? "New York" : lonIn or lonSig ? "London" : tokIn or tokSig ? "Tokyo" : "None"

var table dash = table.new(position.bottom_right, 2, 8, border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 1)
if showDash and barstate.islast
    table.cell(dash, 0, 0, "CRT AMD", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
    table.cell(dash, 1, 0, setupMode, text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
    table.cell(dash, 0, 1, "4H Bias", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(dash, 1, 1, biasTxt, text_color = color.white, bgcolor = f_col(biasTxt), text_size = size.small)
    table.cell(dash, 0, 2, "1H Zone", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(dash, 1, 2, zoneTxt, text_color = color.white, bgcolor = f_col(zoneTxt), text_size = size.small)
    table.cell(dash, 0, 3, "15M Struct", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(dash, 1, 3, m15state, text_color = color.white, bgcolor = f_col(m15state), text_size = size.small)
    table.cell(dash, 0, 4, "5M Entry", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(dash, 1, 4, entryTxt, text_color = color.white, bgcolor = f_col(entryTxt), text_size = size.small)
    table.cell(dash, 0, 5, "Session", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(dash, 1, 5, sessTxt, text_color = color.white, bgcolor = color.new(color.gray, 0), text_size = size.small)
    table.cell(dash, 0, 6, "Min RR", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(dash, 1, 6, "1:" + str.tostring(rrTarget), text_color = color.white, bgcolor = color.new(color.gray, 0), text_size = size.small)
    tfWarn = isFiveM ? "On 5M ✓" : "Switch to 5M!"
    table.cell(dash, 0, 7, "Chart TF", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(dash, 1, 7, tfWarn, text_color = color.white, bgcolor = isFiveM ? color.new(color.green, 0) : color.new(color.red, 0), text_size = size.small)