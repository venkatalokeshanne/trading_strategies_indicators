var table dash_table = na


// ═══════════════════════════════════════════════════════════════
// SECTION 4: HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════

// ── Stil-Helfer ────────────────────────────────────────────────

f_session_tz() =>
    session_timezone == "Exchange" ? syminfo.timezone : session_timezone

f_line_style(s) =>
    s == "dashed" ? line.style_dashed : s == "dotted" ? line.style_dotted : line.style_solid

f_label_size(s) =>
    s == "tiny" ? size.tiny : s == "large" ? size.large : s == "normal" ? size.normal : size.small

f_ticker(sym) =>
    parts = str.split(sym, ":")
    array.size(parts) > 1 ? array.get(parts, 1) : sym

f_dash_pos() =>
    dash_pos_str == "Oben Links"   ? position.top_left    :
     dash_pos_str == "Unten Rechts" ? position.bottom_right :
     dash_pos_str == "Unten Links"  ? position.bottom_left  : position.top_right

// ── Session ────────────────────────────────────────────────────

f_delete_session_drawings(st) =>
    result = st
    if not na(result.high_line_ref)
        line.delete(result.high_line_ref)
        result.high_line_ref := na
    if not na(result.low_line_ref)
        line.delete(result.low_line_ref)
        result.low_line_ref := na
    if not na(result.high_label_ref)
        label.delete(result.high_label_ref)
        result.high_label_ref := na
    if not na(result.low_label_ref)
        label.delete(result.low_label_ref)
        result.low_label_ref := na
    result

f_update_level(line_ref, label_ref, price, x1, txt, col, lw, ls, lsize, _extend) =>
    line_result  = line_ref
    label_result = label_ref
    lbl_x = bar_index + 1
    ext = _extend ? extend.right : extend.none
    if na(line_result)
        line_result := line.new(x1, price, lbl_x, price, color=col, width=lw, style=ls, extend=ext)
    else
        line.set_x1(line_result, x1)
        line.set_y1(line_result, price)
        line.set_x2(line_result, lbl_x)
        line.set_y2(line_result, price)
        line.set_color(line_result, col)
        line.set_width(line_result, lw)
        line.set_style(line_result, ls)
        line.set_extend(line_result, ext)
    if na(label_result)
        label_result := label.new(lbl_x, price, txt,
             color=color.new(col, 100), textcolor=col,
             style=label.style_label_left, size=lsize)
    else
        label.set_x(label_result, lbl_x)
        label.set_y(label_result, price)
        label.set_text(label_result, txt)
        label.set_textcolor(label_result, col)
        label.set_size(label_result, lsize)
    [line_result, label_result]

// Wie f_update_level, aber mit extend.both — Label immer nur 1 Bar in die Zukunft,
// kein manueller Extend-Offset nötig. Verhindert TV-Zoom-out durch weit rechts platzierte Labels.
f_update_level_ext(line_ref, label_ref, price, x1, txt, col, lw, ls, lsize, _extend) =>
    line_result  = line_ref
    label_result = label_ref
    lbl_x = bar_index + 1
    ext = _extend ? extend.both : extend.none
    x1_use = _extend ? bar_index : x1
    if na(line_result)
        line_result := line.new(x1_use, price, lbl_x, price, color=col, width=lw, style=ls, extend=ext)
    else
        line.set_x1(line_result, x1_use)
        line.set_y1(line_result, price)
        line.set_x2(line_result, lbl_x)
        line.set_y2(line_result, price)
        line.set_color(line_result, col)
        line.set_width(line_result, lw)
        line.set_style(line_result, ls)
        line.set_extend(line_result, ext)
    if na(label_result)
        label_result := label.new(lbl_x, price, txt,
             color=color.new(col, 100), textcolor=col,
             style=label.style_label_left, size=lsize)
    else
        label.set_x(label_result, lbl_x)
        label.set_y(label_result, price)
        label.set_text(label_result, txt)
        label.set_textcolor(label_result, col)
        label.set_size(label_result, lsize)
    [line_result, label_result]

// Verarbeitet Session-Zustand: Start, High/Low-Akkumulation, Sweep, Zeichnung.
// Farbe bei Sweep wird auf session_swept_alpha gedimmt.
f_process_session(st, enabled, session_time, abbr, base_col, extend_full) =>
    result = st
    if not enabled
        result         := f_delete_session_drawings(result)
        result.high    := na
        result.low     := na
        result.start_idx      := na
        result.was_in_session := false
        result.high_swept     := false
        result.low_swept      := false
        result.in_session     := false
    else
        in_sess     = not na(time(timeframe.period, session_time, f_session_tz()))
        sess_start  = in_sess and not result.was_in_session

        if sess_start
            result              := f_delete_session_drawings(result)
            result.high         := high
            result.low          := low
            result.start_idx    := bar_index
            result.high_idx     := bar_index
            result.low_idx      := bar_index
            result.high_swept   := false
            result.low_swept    := false
        else if in_sess
            if na(result.high) or high > result.high
                result.high     := high
                result.high_idx := bar_index
            if na(result.low) or low < result.low
                result.low      := low
                result.low_idx  := bar_index

        result.in_session := in_sess

        has_data = not na(result.high) and not na(result.low) and not na(result.start_idx)
        if has_data
            sess_ext   = extend_full ? extend.right : extend.none
            right_idx  = bar_index + 1

            // Sweep-Erkennung außerhalb der Session
            if not in_sess
                if not result.high_swept and high >= result.high
                    result.high_swept := true
                if not result.low_swept and low <= result.low
                    result.low_swept := true

            // Farbe dimmen wenn swept
            h_swept_vis = result.high_swept and qs_show_swept
            l_swept_vis = result.low_swept  and qs_show_swept
            h_col = h_swept_vis ? color.new(base_col, session_swept_alpha) : base_col
            l_col = l_swept_vis ? color.new(base_col, session_swept_alpha) : base_col

            // High-Line: hide (transparent) wenn gesweept und qs_show_swept aus
            hide_h = result.high_swept and not qs_show_swept
            draw_h = session_preserve_swept or not result.high_swept
            h_vis_col = hide_h ? color.new(base_col, 100) : h_col
            if draw_h
                h_txt = hide_h ? "" : abbr + " H" + (h_swept_vis ? " ✅" : "")
                if na(result.high_line_ref)
                    result.high_line_ref := line.new(result.high_idx, result.high, right_idx, result.high,
                         color=h_vis_col, width=session_line_width, style=f_line_style(session_line_style_str), extend=sess_ext)
                else
                    line.set_x1(result.high_line_ref, result.high_idx)
                    line.set_y1(result.high_line_ref, result.high)
                    line.set_x2(result.high_line_ref, right_idx)
                    line.set_y2(result.high_line_ref, result.high)
                    line.set_color(result.high_line_ref, h_vis_col)
                    line.set_width(result.high_line_ref, session_line_width)
                    line.set_style(result.high_line_ref, f_line_style(session_line_style_str))
                    line.set_extend(result.high_line_ref, sess_ext)
                if na(result.high_label_ref)
                    result.high_label_ref := label.new(right_idx, result.high, h_txt,
                         color=color.new(h_vis_col, 100), textcolor=h_vis_col,
                         style=label.style_label_left, size=f_label_size(session_label_size_str))
                else
                    label.set_x(result.high_label_ref, right_idx)
                    label.set_y(result.high_label_ref, result.high)
                    label.set_text(result.high_label_ref, h_txt)
                    label.set_textcolor(result.high_label_ref, h_vis_col)
                    label.set_size(result.high_label_ref, f_label_size(session_label_size_str))
            else
                if not na(result.high_line_ref)
                    line.delete(result.high_line_ref)
                    result.high_line_ref := na
                if not na(result.high_label_ref)
                    label.delete(result.high_label_ref)
                    result.high_label_ref := na

            // Low-Line: hide (transparent) wenn gesweept und qs_show_swept aus
            hide_l = result.low_swept and not qs_show_swept
            draw_l = session_preserve_swept or not result.low_swept
            l_vis_col = hide_l ? color.new(base_col, 100) : l_col
            if draw_l
                l_txt = hide_l ? "" : abbr + " L" + (l_swept_vis ? " ✅" : "")
                if na(result.low_line_ref)
                    result.low_line_ref := line.new(result.low_idx, result.low, right_idx, result.low,
                         color=l_vis_col, width=session_line_width, style=f_line_style(session_line_style_str), extend=sess_ext)
                else
                    line.set_x1(result.low_line_ref, result.low_idx)
                    line.set_y1(result.low_line_ref, result.low)
                    line.set_x2(result.low_line_ref, right_idx)
                    line.set_y2(result.low_line_ref, result.low)
                    line.set_color(result.low_line_ref, l_vis_col)
                    line.set_width(result.low_line_ref, session_line_width)
                    line.set_style(result.low_line_ref, f_line_style(session_line_style_str))
                    line.set_extend(result.low_line_ref, sess_ext)
                if na(result.low_label_ref)
                    result.low_label_ref := label.new(right_idx, result.low, l_txt,
                         color=color.new(l_vis_col, 100), textcolor=l_vis_col,
                         style=label.style_label_left, size=f_label_size(session_label_size_str))
                else
                    label.set_x(result.low_label_ref, right_idx)
                    label.set_y(result.low_label_ref, result.low)
                    label.set_text(result.low_label_ref, l_txt)
                    label.set_textcolor(result.low_label_ref, l_vis_col)
                    label.set_size(result.low_label_ref, f_label_size(session_label_size_str))
            else
                if not na(result.low_line_ref)
                    line.delete(result.low_line_ref)
                    result.low_line_ref := na
                if not na(result.low_label_ref)
                    label.delete(result.low_label_ref)
                    result.low_label_ref := na

        result.was_in_session := in_sess
    result

// ── FVG ────────────────────────────────────────────────────────

f_tf_name(tf_str) =>
    tf_str == "1"   ? "M1"  : tf_str == "2"   ? "M2"  : tf_str == "3"   ? "M3"  :
     tf_str == "5"  ? "M5"  : tf_str == "10"  ? "M10" : tf_str == "15"  ? "M15" :
     tf_str == "30" ? "M30" : tf_str == "60"  ? "H1"  : tf_str == "120" ? "H2"  :
     tf_str == "180"? "H3"  : tf_str == "240" ? "H4"  : tf_str == "360" ? "H6"  :
     tf_str == "480"? "H8"  : tf_str == "720" ? "H12" : tf_str == "D"   ? "D1"  :
     tf_str == "W"  ? "W1"  : tf_str == "M"   ? "MN"  : tf_str

f_auto_htf(slot) =>
    s = timeframe.in_seconds()
    if slot == 1
        s <= 60 ? "5" : s <= 300 ? "15" : s <= 900 ? "60" : s <= 3600 ? "240" : "D"
    else if slot == 2
        s <= 60 ? "15" : s <= 300 ? "60" : s <= 900 ? "240" : s <= 3600 ? "D" : "W"
    else
        s <= 60 ? "60" : s <= 300 ? "240" : s <= 900 ? "D" : s <= 3600 ? "W" : "SKIP"

f_fvg_exists(fvg_array, orig_t) =>
    result = false
    n = array.size(fvg_array)
    if n > 0
        for i = 0 to n - 1
            if array.get(fvg_array, i).origin_time == orig_t
                result := true
                break
    result

f_delete_fvg_drawings(fvg) =>
    if not na(fvg.box_ref)
        box.delete(fvg.box_ref)
        fvg.box_ref := na
    if not na(fvg.midline_ref)
        line.delete(fvg.midline_ref)
        fvg.midline_ref := na
    if not na(fvg.label_ref)
        label.delete(fvg.label_ref)
        fvg.label_ref := na

f_cleanup_fvgs(fvg_array) =>
    while array.size(fvg_array) >= max_fvgs_shown
        old = array.shift(fvg_array)
        f_delete_fvg_drawings(old)

// Y-Koordinate basierend auf Label-Position (Oben/Mitte/Unten).
f_fvg_label_y(fvg_top, fvg_bot) =>
    str.contains(fvg_label_pos_str, "Oben")  ? fvg_top :
     str.contains(fvg_label_pos_str, "Unten") ? fvg_bot :
     (fvg_top + fvg_bot) / 2.0

// Pine label-Style basierend auf Position und Platzierung.
// Innerhalb Links/Rechts → style_none am Anker innerhalb der Box.
// Außerhalb → style_label_left am rechten Rand (Text hängt rechts raus).
f_fvg_label_style() =>
    if fvg_label_placement == "Außerhalb"
        label.style_label_left
    else if str.contains(fvg_label_pos_str, "Rechts")
        label.style_label_right   // Anker am rechten Rand, Text geht nach links (innen)
    else
        label.style_none          // Anker am linken Rand, Text steht rechts davon

// LTF: Label-X beim ersten Zeichnen.
// Außerhalb / Rechts → rechte Kante (bar_formed+1), Links → linke Kante (bar_formed-2).
f_fvg_label_x_ltf(fvg) =>
    (fvg_label_placement == "Außerhalb" or str.contains(fvg_label_pos_str, "Rechts"))
         ? fvg.bar_formed + 1
         : fvg.bar_formed - 2

// HTF: Label-X beim ersten Zeichnen (Zeitstempel in ms).
f_fvg_label_x_htf(fvg, dur_ms) =>
    (fvg_label_placement == "Außerhalb" or str.contains(fvg_label_pos_str, "Rechts"))
         ? fvg.t_right
         : fvg.t_left + dur_ms

f_draw_fvg_label(fvg, dur_ms) =>
    if not fvg_label_show
        label(na)
    else
        lbl_txt = fvg_label_text == "" ? fvg.tf_name : fvg_label_text
        lbl_y   = f_fvg_label_y(fvg.top, fvg.bottom)
        lbl_sty = f_fvg_label_style()
        if fvg.is_htf
            label.new(xloc      = xloc.bar_time,
                      x         = f_fvg_label_x_htf(fvg, dur_ms),
                      y         = lbl_y,
                      text      = lbl_txt,
                      color     = fvg_label_bg,
                      textcolor = fvg_label_color,
                      style     = lbl_sty,
                      size      = f_label_size(fvg_label_size_str))
        else
            label.new(x         = f_fvg_label_x_ltf(fvg),
                      y         = lbl_y,
                      text      = lbl_txt,
                      color     = fvg_label_bg,
                      textcolor = fvg_label_color,
                      style     = lbl_sty,
                      size      = f_label_size(fvg_label_size_str))

f_draw_fvg_box_ltf(fvg) =>
    bg_col  = fvg.is_bullish ? fvg_color_bull : fvg_color_bear
    b_col   = fvg_border_show ? (fvg.is_bullish ? fvg_border_bull : fvg_border_bear) : color.new(color.black, 100)
    box.new(left=fvg.bar_formed - 3, top=fvg.top, right=fvg.bar_formed + 1, bottom=fvg.bottom,
         border_color=b_col, border_width=fvg_border_width, bgcolor=bg_col)

f_draw_fvg_midline_ltf(fvg) =>
    mid = (fvg.top + fvg.bottom) / 2.0
    line.new(x1=fvg.bar_formed - 3, y1=mid, x2=fvg.bar_formed + 1, y2=mid,
         color=fvg_midline_color, width=fvg_midline_width, style=line.style_dashed)

// Per-TF Transparenz für HTF-Boxen.
f_htf_alpha(tf_s) =>
    if htf_transp_mode == "Einheitlich"
        htf_transp_uniform
    else
        level = tf_s <= 60 ? 0 : tf_s <= 300 ? 1 : tf_s <= 900 ? 2 : tf_s <= 1800 ? 3 :
                 tf_s <= 3600 ? 4 : tf_s <= 14400 ? 5 : tf_s <= 86400 ? 6 : 7
        if htf_auto_stagger
            math.max(0, math.min(100, htf_transp_1m - level * htf_stagger_step))
        else
            tf_s <= 60    ? htf_transp_1m  : tf_s <= 300   ? htf_transp_5m  :
             tf_s <= 900  ? htf_transp_15m : tf_s <= 1800  ? htf_transp_30m :
             tf_s <= 3600 ? htf_transp_1h  : tf_s <= 14400 ? htf_transp_4h  :
             tf_s <= 86400 ? htf_transp_d  : htf_transp_w

f_htf_fill_color(is_bull, tf_s) =>
    color.new(is_bull ? fvg_color_bull : fvg_color_bear, f_htf_alpha(tf_s))

f_draw_fvg_box_htf(fvg) =>
    b_col = fvg_border_show ? (fvg.is_bullish ? fvg_border_bull : fvg_border_bear) : color.new(color.black, 100)
    box.new(xloc=xloc.bar_time, left=fvg.t_left, top=fvg.top, right=fvg.t_right, bottom=fvg.bottom,
         border_color=b_col, border_width=fvg_border_width,
         bgcolor=f_htf_fill_color(fvg.is_bullish, fvg.tf_secs))

f_draw_fvg_midline_htf(fvg) =>
    mid = (fvg.top + fvg.bottom) / 2.0
    line.new(xloc=xloc.bar_time, x1=fvg.t_left, y1=mid, x2=fvg.t_right, y2=mid,
         color=fvg_midline_color, width=fvg_midline_width, style=line.style_dashed)

f_add_fvg(fvg_array, is_bull) =>
    new_top = is_bull ? low[0]  : low[2]
    new_bot = is_bull ? high[2] : high[0]
    // Spent-Zone-Check (optional): kein neuer FVG wenn Zone mit mitigiertem gleich-direktionalem FVG überschneidet
    spent = false
    if fvg_no_respawn
        n_existing = array.size(fvg_array)
        if n_existing > 0
            for k = 0 to n_existing - 1
                ex = array.get(fvg_array, k)
                if ex.mitigated and ex.is_bullish == is_bull
                    if new_bot < ex.top and new_top > ex.bottom
                        spent := true
                        break
    if not spent
        f_cleanup_fvgs(fvg_array)
        fvg = FVG.new(
             top=new_top, bottom=new_bot,
             bar_formed=bar_index, origin_time=time[1],
             is_bullish=is_bull, mitigated=false,
             is_htf=false, tf_name=f_tf_name(timeframe.period),
             tf_secs=0, hidden=false, hidden_overlap=false,
             t_left=0, t_right=0, box_ref=na, midline_ref=na, label_ref=na)
        fvg.box_ref     := f_draw_fvg_box_ltf(fvg)
        fvg.midline_ref := fvg_midline_show ? f_draw_fvg_midline_ltf(fvg) : na
        fvg.label_ref   := f_draw_fvg_label(fvg, 0)
        array.push(fvg_array, fvg)

// FIFO-Cleanup für HTF-Arrays — nutzt htf_max_per_tf statt LTF-Limit.
f_cleanup_htf_fvgs(fvg_array) =>
    while array.size(fvg_array) >= htf_max_per_tf
        old = array.shift(fvg_array)
        f_delete_fvg_drawings(old)

f_add_htf_fvg(fvg_array, is_bull, t_l, t_r, fvg_top, fvg_bot, tf_name, orig_t, dur_ms, tf_s) =>
    // Spent-Zone-Check (optional): kein neuer HTF-FVG wenn Zone mit mitigiertem gleich-direktionalem FVG überschneidet
    spent = false
    if fvg_no_respawn
        n_existing = array.size(fvg_array)
        if n_existing > 0
            for k = 0 to n_existing - 1
                ex = array.get(fvg_array, k)
                if ex.mitigated and ex.is_bullish == is_bull
                    if fvg_bot < ex.top and fvg_top > ex.bottom
                        spent := true
                        break
    if not spent
        f_cleanup_htf_fvgs(fvg_array)
        fvg = FVG.new(
             top=fvg_top, bottom=fvg_bot, bar_formed=0, origin_time=orig_t,
             is_bullish=is_bull, mitigated=false,
             is_htf=true, tf_name=tf_name,
             tf_secs=tf_s, hidden=false, hidden_overlap=false,
             t_left=t_l, t_right=t_r,
             box_ref=na, midline_ref=na, label_ref=na)
        fvg.box_ref     := f_draw_fvg_box_htf(fvg)
        fvg.midline_ref := fvg_midline_show ? f_draw_fvg_midline_htf(fvg) : na
        fvg.label_ref   := f_draw_fvg_label(fvg, dur_ms)
        array.push(fvg_array, fvg)

// Overlap-Filter: LTF FVGs ausblenden wenn ein HTF FVG (gleiche Richtung) überlappt.
f_apply_ltf_htf_overlap(ltf_arr, htf_arr) =>
    n_ltf = array.size(ltf_arr)
    n_htf = array.size(htf_arr)
    if n_ltf > 0 and n_htf > 0
        invis = color.new(color.black, 100)
        for i = 0 to n_ltf - 1
            fvg_lo = array.get(ltf_arr, i)
            if not fvg_lo.mitigated
                overlaps = false
                for j = 0 to n_htf - 1
                    fvg_hi = array.get(htf_arr, j)
                    if not fvg_hi.mitigated and fvg_hi.is_bullish == fvg_lo.is_bullish
                        if fvg_lo.bottom < fvg_hi.top and fvg_lo.top > fvg_hi.bottom
                            overlaps := true
                            break
                if overlaps and not fvg_lo.hidden_overlap
                    fvg_lo.hidden         := true
                    fvg_lo.hidden_overlap := true
                    if not na(fvg_lo.box_ref)
                        box.set_bgcolor(fvg_lo.box_ref,      invis)
                        box.set_border_color(fvg_lo.box_ref, invis)
                    if not na(fvg_lo.midline_ref)
                        line.set_color(fvg_lo.midline_ref,   invis)
                    if not na(fvg_lo.label_ref)
                        label.set_color(fvg_lo.label_ref,     invis)
                        label.set_textcolor(fvg_lo.label_ref, invis)
                    array.set(ltf_arr, i, fvg_lo)
                else if not overlaps and fvg_lo.hidden_overlap
                    fvg_lo.hidden_overlap := false
                    fvg_lo.hidden         := false
                    if not na(fvg_lo.box_ref)
                        box.set_bgcolor(fvg_lo.box_ref,      fvg_lo.is_bullish ? fvg_color_bull : fvg_color_bear)
                        b_col = fvg_border_show ? (fvg_lo.is_bullish ? fvg_border_bull : fvg_border_bear) : invis
                        box.set_border_color(fvg_lo.box_ref, b_col)
                    if not na(fvg_lo.midline_ref)
                        line.set_color(fvg_lo.midline_ref,   fvg_midline_color)
                    if not na(fvg_lo.label_ref)
                        label.set_color(fvg_lo.label_ref,     fvg_label_bg)
                        label.set_textcolor(fvg_lo.label_ref, fvg_label_color)
                    array.set(ltf_arr, i, fvg_lo)

// Nearest-Filter für LTF-FVGs: zeigt nur die N nächsten bull/bear FVGs.
f_apply_ltf_visibility(arr) =>
    n = array.size(arr)
    if n > 0 and ltf_only_nearest
        dists = array.new<float>(n, na)
        for i = 0 to n - 1
            fvg = array.get(arr, i)
            if not fvg.mitigated
                array.set(dists, i, math.abs(close - (fvg.top + fvg.bottom) / 2.0))
        for i = 0 to n - 1
            fvg = array.get(arr, i)
            if not fvg.mitigated
                my_d = array.get(dists, i)
                closer = 0
                for j = 0 to n - 1
                    if j != i
                        other = array.get(arr, j)
                        d_j   = array.get(dists, j)
                        if not other.mitigated and other.is_bullish == fvg.is_bullish
                             and not na(d_j) and not na(my_d) and d_j < my_d
                            closer += 1
                should_show = closer < ltf_per_direction
                invis = color.new(color.black, 100)
                if should_show and fvg.hidden
                    fvg.hidden := false
                    if not na(fvg.box_ref)
                        box.set_bgcolor(fvg.box_ref,      fvg.is_bullish ? fvg_color_bull : fvg_color_bear)
                        b_col = fvg_border_show ? (fvg.is_bullish ? fvg_border_bull : fvg_border_bear) : invis
                        box.set_border_color(fvg.box_ref, b_col)
                    if not na(fvg.midline_ref)
                        line.set_color(fvg.midline_ref, fvg_midline_color)
                    if not na(fvg.label_ref)
                        label.set_color(fvg.label_ref,     fvg_label_bg)
                        label.set_textcolor(fvg.label_ref, fvg_label_color)
                    array.set(arr, i, fvg)
                else if not should_show and not fvg.hidden
                    fvg.hidden := true
                    if not na(fvg.box_ref)
                        box.set_bgcolor(fvg.box_ref,      invis)
                        box.set_border_color(fvg.box_ref, invis)
                    if not na(fvg.midline_ref)
                        line.set_color(fvg.midline_ref,   invis)
                    if not na(fvg.label_ref)
                        label.set_color(fvg.label_ref,     invis)
                        label.set_textcolor(fvg.label_ref, invis)
                    array.set(arr, i, fvg)

// Nearest-Filter: zeigt nur die N nächsten bull/bear HTF-FVGs. Überlappungs-Check optional danach.
f_apply_htf_visibility(arr, tf_s) =>
    n = array.size(arr)
    if n > 0
        always_show_secs  = timeframe.in_seconds(htf_always_show_tf)
        is_major          = (htf_always_h1 and tf_s == 3600) or
                             (htf_always_h4 and tf_s == 14400) or
                             (htf_always_d1 and tf_s == 86400)
        exempt_from_filter = is_major or tf_s >= always_show_secs
        max_age_ms        = htf_max_age_bars * tf_s * 1000

        // Alters-Filter: zu alte FVGs ausblenden (unabhängig von Nearest-Filter)
        if htf_max_age_enable
            for i = 0 to n - 1
                fvg = array.get(arr, i)
                if not fvg.mitigated and not fvg.hidden_overlap
                    age_ms = timenow - fvg.origin_time
                    too_old = age_ms > max_age_ms
                    if too_old and not fvg.hidden
                        fvg.hidden := true
                        invis = color.new(color.black, 100)
                        if not na(fvg.box_ref)
                            box.set_bgcolor(fvg.box_ref, invis)
                            box.set_border_color(fvg.box_ref, invis)
                        if not na(fvg.midline_ref)
                            line.set_color(fvg.midline_ref, invis)
                        if not na(fvg.label_ref)
                            label.set_color(fvg.label_ref, invis)
                            label.set_textcolor(fvg.label_ref, invis)
                        array.set(arr, i, fvg)
                    else if not too_old and fvg.hidden
                        // Wurde nur wegen Alter versteckt → wieder einblenden
                        fvg.hidden := false
                        if not na(fvg.box_ref)
                            box.set_bgcolor(fvg.box_ref, f_htf_fill_color(fvg.is_bullish, fvg.tf_secs))
                            b_col = fvg_border_show ? (fvg.is_bullish ? fvg_border_bull : fvg_border_bear) : color.new(color.black, 100)
                            box.set_border_color(fvg.box_ref, b_col)
                        if not na(fvg.midline_ref)
                            line.set_color(fvg.midline_ref, fvg_midline_color)
                        if not na(fvg.label_ref)
                            lbl_col = fvg.is_bullish ? fvg_color_bull : fvg_color_bear
                            label.set_color(fvg.label_ref, fvg_label_bg)
                            label.set_textcolor(fvg.label_ref, fvg_label_color)
                        array.set(arr, i, fvg)

        if not htf_only_nearest or exempt_from_filter
            // Alle nicht-mittigierten sichtbar schalten (sofern nicht per Overlap versteckt)
            for i = 0 to n - 1
                fvg = array.get(arr, i)
                if not fvg.mitigated and fvg.hidden and not fvg.hidden_overlap
                    fvg.hidden := false
                    if not na(fvg.box_ref)
                        box.set_bgcolor(fvg.box_ref, f_htf_fill_color(fvg.is_bullish, fvg.tf_secs))
                    if not na(fvg.midline_ref)
                        line.set_color(fvg.midline_ref, fvg_midline_color)
                    array.set(arr, i, fvg)
        else
            // Distanzen zum aktuellen Close berechnen
            dists = array.new<float>(n, na)
            for i = 0 to n - 1
                fvg = array.get(arr, i)
                if not fvg.mitigated
                    array.set(dists, i, math.abs(close - (fvg.top + fvg.bottom) / 2.0))

            // Für jede FVG: Anzahl näherer gleich-direktionaler FVGs zählen
            for i = 0 to n - 1
                fvg = array.get(arr, i)
                if not fvg.mitigated
                    my_d = array.get(dists, i)
                    closer = 0
                    for j = 0 to n - 1
                        if j != i
                            other = array.get(arr, j)
                            d_j   = array.get(dists, j)
                            if not other.mitigated and other.is_bullish == fvg.is_bullish
                                 and not na(d_j) and not na(my_d) and d_j < my_d
                                closer += 1
                    should_show = closer < htf_per_direction

                    // Nur un-hiden wenn nicht per Overlap blockiert
                    if should_show and fvg.hidden and not fvg.hidden_overlap
                        fvg.hidden := false
                        if not na(fvg.box_ref)
                            box.set_bgcolor(fvg.box_ref, f_htf_fill_color(fvg.is_bullish, fvg.tf_secs))
                        if not na(fvg.midline_ref)
                            line.set_color(fvg.midline_ref, fvg_midline_color)
                        array.set(arr, i, fvg)
                    else if not should_show and not fvg.hidden
                        fvg.hidden := true
                        if not na(fvg.box_ref)
                            box.set_bgcolor(fvg.box_ref, color.new(color.black, 100))
                        if not na(fvg.midline_ref)
                            line.set_color(fvg.midline_ref, color.new(color.black, 100))
                        array.set(arr, i, fvg)

// Überlappungs-Filter: versteckt niedrig-TF FVGs wenn ein höher-TF FVG dieselbe Preiszone belegt.
// Overlap-Check: versteckt niedrig-TF FVGs wenn irgendein höher-TF FVG (nicht mitigiert)
// in derselben Preiszone existiert — unabhängig ob der höhere selbst sichtbar ist.
f_apply_htf_overlap(lower_arr, higher_arr, lower_exempt) =>
    n_lo = array.size(lower_arr)
    n_hi = array.size(higher_arr)
    if n_lo > 0 and n_hi > 0 and not lower_exempt
        for i = 0 to n_lo - 1
            fvg_lo = array.get(lower_arr, i)
            if not fvg_lo.mitigated
                overlaps = false
                for j = 0 to n_hi - 1
                    fvg_hi = array.get(higher_arr, j)
                    // Nur prüfen ob höherer TF FVG existiert (nicht mitigiert) — hidden-Status egal
                    if not fvg_hi.mitigated
                        if fvg_lo.bottom < fvg_hi.top and fvg_lo.top > fvg_hi.bottom
                            overlaps := true
                            break
                if overlaps and not fvg_lo.hidden_overlap
                    fvg_lo.hidden         := true
                    fvg_lo.hidden_overlap := true
                    invis = color.new(color.black, 100)
                    if not na(fvg_lo.box_ref)
                        box.set_bgcolor(fvg_lo.box_ref,       invis)
                        box.set_border_color(fvg_lo.box_ref,  invis)
                    if not na(fvg_lo.midline_ref)
                        line.set_color(fvg_lo.midline_ref,    invis)
                    if not na(fvg_lo.label_ref)
                        label.set_color(fvg_lo.label_ref,     invis)
                        label.set_textcolor(fvg_lo.label_ref, invis)
                    array.set(lower_arr, i, fvg_lo)
                else if not overlaps and fvg_lo.hidden_overlap
                    // Overlap ist weg → hidden_overlap zurücksetzen, Visibility-Filter entscheidet dann
                    fvg_lo.hidden_overlap := false
                    fvg_lo.hidden         := false
                    b_col = fvg_border_show ? (fvg_lo.is_bullish ? fvg_border_bull : fvg_border_bear) : color.new(color.black, 100)
                    if not na(fvg_lo.box_ref)
                        box.set_bgcolor(fvg_lo.box_ref,       f_htf_fill_color(fvg_lo.is_bullish, fvg_lo.tf_secs))
                        box.set_border_color(fvg_lo.box_ref,  b_col)
                    if not na(fvg_lo.midline_ref)
                        line.set_color(fvg_lo.midline_ref,    fvg_midline_color)
                    if not na(fvg_lo.label_ref)
                        lbl_col = fvg_lo.is_bullish ? fvg_color_bull : fvg_color_bear
                        label.set_color(fvg_lo.label_ref,     fvg_label_bg)
                        label.set_textcolor(fvg_lo.label_ref, fvg_label_color)
                    array.set(lower_arr, i, fvg_lo)

f_update_fvgs(fvg_array) =>
    n = array.size(fvg_array)
    if n > 0
        tol = syminfo.mintick
        for step = 0 to n - 1
            i = n - 1 - step
            fvg = array.get(fvg_array, i)
            if not fvg.mitigated
                re          = bar_index + 1 + fvg_extend_offset
                // Invertiert: Kerzenschluss schließt komplett durch die Zone (close < Bottom für bull)
                // Guards: nur auf bestätigten Bars, nie auf dem Entstehungsbar selbst
                mitig_now   = barstate.isconfirmed and bar_index > fvg.bar_formed and
                     (fvg.is_bullish ? close < fvg.bottom - tol : close > fvg.top + tol)
                if mitig_now
                    fvg.mitigated := true
                    if hide_mitigated_fvgs
                        f_delete_fvg_drawings(fvg)
                    else
                        if not na(fvg.box_ref)
                            box.set_bgcolor(fvg.box_ref,      color.new(color.gray, 90))
                            box.set_border_color(fvg.box_ref, color.new(color.gray, 70))
                            box.set_right(fvg.box_ref, re)
                        if not na(fvg.midline_ref)
                            line.set_color(fvg.midline_ref, color.new(color.gray, 70))
                            line.set_x2(fvg.midline_ref, re)
                    array.set(fvg_array, i, fvg)
                else if extend_fvg_right
                    if not na(fvg.box_ref)
                        box.set_right(fvg.box_ref, re)
                    if not na(fvg.midline_ref)
                        line.set_x2(fvg.midline_ref, re)
                    // Label-X mitziehen wenn Position am rechten Rand
                    label_follows_right = fvg_label_placement == "Außerhalb" or str.contains(fvg_label_pos_str, "Rechts")
                    if not na(fvg.label_ref) and label_follows_right
                        label.set_x(fvg.label_ref, re)
                    array.set(fvg_array, i, fvg)

f_update_htf_fvgs(fvg_array, htf_close, new_bar) =>
    n = array.size(fvg_array)
    if n > 0
        tol      = syminfo.mintick
        for step = 0 to n - 1
            i = n - 1 - step
            fvg = array.get(fvg_array, i)
            right_ms = time_close + fvg_extend_offset * timeframe.in_seconds() * 1000
            if not fvg.mitigated
                // Mitigation nur auf bestätigtem HTF-Close: neue HTF-Bar muss unter/über der Zone schließen
                mitig_now = new_bar and not na(htf_close) and (fvg.is_bullish
                     ? htf_close < fvg.bottom - tol : htf_close > fvg.top + tol)
                if mitig_now
                    fvg.mitigated := true
                    fvg.t_right   := time
                    if hide_mitigated_fvgs
                        f_delete_fvg_drawings(fvg)
                    else
                        if not na(fvg.box_ref)
                            box.set_bgcolor(fvg.box_ref,      color.new(color.gray, 90))
                            box.set_border_color(fvg.box_ref, color.new(color.gray, 70))
                            box.set_right(fvg.box_ref, time)
                        if not na(fvg.midline_ref)
                            line.set_color(fvg.midline_ref, color.new(color.gray, 70))
                            line.set_x2(fvg.midline_ref, time)
                    array.set(fvg_array, i, fvg)
                else if extend_fvg_right
                    fvg.t_right := right_ms
                    if not na(fvg.box_ref)
                        box.set_right(fvg.box_ref, right_ms)
                    if not na(fvg.midline_ref)
                        line.set_x2(fvg.midline_ref, right_ms)
                    // Label-X mitziehen wenn Position am rechten Rand
                    label_follows_right = fvg_label_placement == "Außerhalb" or str.contains(fvg_label_pos_str, "Rechts")
                    if not na(fvg.label_ref) and label_follows_right
                        label.set_x(fvg.label_ref, right_ms)
                    array.set(fvg_array, i, fvg)

// ── Dashboard ──────────────────────────────────────────────────

// Gibt Status-String und Farbe für eine Session zurück.
// Leichtes Session-Tracking für korrelierendes Asset — nur State, kein Zeichnen.
// h / l = externe High/Low-Werte vom korrelierten Symbol.
f_track_session_smt(st, enabled, session_time, h, l) =>
    result = st
    if not enabled or na(h) or na(l)
        result.high         := na
        result.low          := na
        result.was_in_session := false
        result.high_swept   := false
        result.low_swept    := false
        result.in_session   := false
    else
        in_sess    = not na(time(timeframe.period, session_time, f_session_tz()))
        sess_start = in_sess and not result.was_in_session

        if sess_start
            result.high       := h
            result.low        := l
            result.high_swept := false
            result.low_swept  := false
        else if in_sess
            result.high := na(result.high) ? h : math.max(result.high, h)
            result.low  := na(result.low)  ? l : math.min(result.low,  l)
        else if not na(result.high)
            if not result.high_swept and h >= result.high
                result.high_swept := true
            if not result.low_swept  and l <= result.low
                result.low_swept  := true

        result.was_in_session := in_sess
        result.in_session     := in_sess
    result


f_price_str(p) =>
    na(p) ? "—" : str.tostring(p, format.mintick)

// Sweep-Status mit konfigurierbaren Texten und Farben
f_sweep_status(swept, in_sess, has_data) =>
    if not has_data
        [dash_text_open, color.gray]
    else if in_sess
        ["● aktiv", dash_text_color]
    else if swept
        [dash_text_swept, dash_swept_color]
    else
        [dash_text_open, color.gray]

// SMT-Status für Key-Levels (PDH/PDL/PWH/PWL/PMH/PML): kein Session-Kontext.
f_smt_key(chart_swept, b_swept, b_enabled, b_has_data) =>
    if not b_enabled or not b_has_data
        ["—", color.gray]
    else if b_swept and chart_swept
        ["swept", dash_swept_color]
    else if b_swept and not chart_swept
        ["SMT", smt_color_smt]
    else if not b_swept and chart_swept
        ["SMT", smt_color_smt]
    else
        [dash_text_open, color.gray]

// SMT-Spalte: Sweep-Status des korrelierten Assets.
// SMT-Divergenz (ein Asset swept, das andere nicht) → "SMT" in Rot.
f_smt_level(a_swept, b_swept, a_in_sess, b_in_sess, b_has_data, enabled) =>
    if not enabled or not b_has_data
        ["—", color.gray]
    else if b_in_sess
        ["● aktiv", dash_text_color]
    else
        smt_div = not a_in_sess and a_swept != b_swept
        if smt_div
            ["SMT", smt_color_smt]
        else if b_swept
            ["swept", dash_swept_color]
        else
            [dash_text_open, color.gray]

// Dashboard: bis zu 4 Spalten, Zeilen nur für aktivierte Levels.
f_update_dashboard(tbl, asia_s, london_s, nyam_s, nypm_s,
     smt_a_s, smt_l_s, smt_n_s, smt_p_s,
     smt2_a_s, smt2_l_s, smt2_n_s, smt2_p_s,
     p_pdh_swept, p_pdl_swept, p_pdh_data, p_pdl_data,
     p_pwh_swept, p_pwl_swept, p_pwh_data, p_pwl_data,
     p_pmh_swept, p_pml_swept, p_pmh_data, p_pml_data,
     b_pdh_swept, b_pdl_swept, b_pwh_swept, b_pwl_swept, b_pmh_swept, b_pml_swept,
     c_pdh_swept, c_pdl_swept, c_pwh_swept, c_pwl_swept, c_pmh_swept, c_pml_swept) =>
    if not na(tbl)
        ts      = f_label_size(dash_text_size_str)
        hdr_bg  = dash_hdr_bg_color
        row_bg  = dash_bg_color
        hdr_col = dash_text_color
        show_b  = dash_show_smt_col and smt_enable  and f_ticker(smt_sym)  != syminfo.ticker
        show_c  = dash_show_smt_col and smt2_enable and f_ticker(smt2_sym) != syminfo.ticker
        col_b   = show_b ? 2 : -1
        col_c   = show_c ? (show_b ? 3 : 2) : -1

        // Header
        table.cell(tbl, 0, 0, dash_hdr_text, text_color=hdr_col, bgcolor=hdr_bg, text_size=ts)
        table.cell(tbl, 1, 0, "Sweep",        text_color=hdr_col, bgcolor=hdr_bg, text_size=ts)
        if show_b
            table.cell(tbl, col_b, 0, f_ticker(smt_sym),  text_color=hdr_col, bgcolor=hdr_bg, text_size=ts)
        if show_c
            table.cell(tbl, col_c, 0, f_ticker(smt2_sym), text_color=hdr_col, bgcolor=hdr_bg, text_size=ts)

        // Session-Zeilen
        sess_states  = array.from(asia_s,   london_s,   nyam_s,   nypm_s)
        smt_states   = array.from(smt_a_s,  smt_l_s,    smt_n_s,  smt_p_s)
        smt2_states  = array.from(smt2_a_s, smt2_l_s,   smt2_n_s, smt2_p_s)
        sess_abbrs   = array.from(asia_session_abbr, london_session_abbr, nyam_session_abbr, nypm_session_abbr)
        sess_enabled = array.from(show_asia_session, show_london_session, show_nyam_session, show_nypm_session)
        sess_dash    = array.from(dash_show_asia, dash_show_london, dash_show_nyam, dash_show_nypm)
        sess_cols    = array.from(asia_session_color, london_session_color, nyam_session_color, nypm_session_color)

        row = 1
        for s = 0 to 3
            if array.get(sess_dash, s)
                st       = array.get(sess_states, s)
                smt_st   = array.get(smt_states, s)
                smt2_st  = array.get(smt2_states, s)
                abbr     = array.get(sess_abbrs, s)
                enabled  = array.get(sess_enabled, s)
                has_data = enabled and not na(st.high)
                name_col = enabled ? dash_text_color : color.gray

                [h_txt, h_col] = f_sweep_status(st.high_swept, st.in_session, has_data)
                [l_txt, l_col] = f_sweep_status(st.low_swept,  st.in_session, has_data)

                table.cell(tbl, 0, row,     abbr + " High", text_color=name_col, bgcolor=row_bg, text_size=ts)
                table.cell(tbl, 1, row,     h_txt,           text_color=h_col,    bgcolor=row_bg, text_size=ts)
                table.cell(tbl, 0, row + 1, abbr + " Low",  text_color=name_col, bgcolor=row_bg, text_size=ts)
                table.cell(tbl, 1, row + 1, l_txt,           text_color=l_col,    bgcolor=row_bg, text_size=ts)

                if show_b
                    b_has_data = not na(smt_st.high) or smt_st.in_session
                    [h_b_txt, h_b_col] = f_smt_level(st.high_swept, smt_st.high_swept,
                         st.in_session, smt_st.in_session, b_has_data, enabled)
                    [l_b_txt, l_b_col] = f_smt_level(st.low_swept, smt_st.low_swept,
                         st.in_session, smt_st.in_session, b_has_data, enabled)
                    table.cell(tbl, col_b, row,     h_b_txt, text_color=h_b_col, bgcolor=row_bg, text_size=ts)
                    table.cell(tbl, col_b, row + 1, l_b_txt, text_color=l_b_col, bgcolor=row_bg, text_size=ts)

                if show_c
                    c_has_data = not na(smt2_st.high) or smt2_st.in_session
                    [h_c_txt, h_c_col] = f_smt_level(st.high_swept, smt2_st.high_swept,
                         st.in_session, smt2_st.in_session, c_has_data, enabled)
                    [l_c_txt, l_c_col] = f_smt_level(st.low_swept, smt2_st.low_swept,
                         st.in_session, smt2_st.in_session, c_has_data, enabled)
                    table.cell(tbl, col_c, row,     h_c_txt, text_color=h_c_col, bgcolor=row_bg, text_size=ts)
                    table.cell(tbl, col_c, row + 1, l_c_txt, text_color=l_c_col, bgcolor=row_bg, text_size=ts)

                row += 2

        // PDH
        if dash_show_pdh
            [pdh_txt, pdh_col] = f_sweep_status(p_pdh_swept, false, p_pdh_data)
            pd_col = show_pdh_pdl ? dash_text_color : color.gray
            table.cell(tbl, 0, row, "PDH",   text_color=pd_col,   bgcolor=row_bg, text_size=ts)
            table.cell(tbl, 1, row, pdh_txt, text_color=pdh_col,  bgcolor=row_bg, text_size=ts)
            if show_b
                [b_txt, b_col] = f_smt_key(p_pdh_swept, b_pdh_swept, smt_enable,  p_pdh_data)
                table.cell(tbl, col_b, row, b_txt, text_color=b_col, bgcolor=row_bg, text_size=ts)
            if show_c
                [c_txt, c_col] = f_smt_key(p_pdh_swept, c_pdh_swept, smt2_enable, p_pdh_data)
                table.cell(tbl, col_c, row, c_txt, text_color=c_col, bgcolor=row_bg, text_size=ts)
            row += 1

        // PDL
        if dash_show_pdl
            [pdl_txt, pdl_col] = f_sweep_status(p_pdl_swept, false, p_pdl_data)
            pd_col = show_pdh_pdl ? dash_text_color : color.gray
            table.cell(tbl, 0, row, "PDL",   text_color=pd_col,   bgcolor=row_bg, text_size=ts)
            table.cell(tbl, 1, row, pdl_txt, text_color=pdl_col,  bgcolor=row_bg, text_size=ts)
            if show_b
                [b_txt, b_col] = f_smt_key(p_pdl_swept, b_pdl_swept, smt_enable,  p_pdl_data)
                table.cell(tbl, col_b, row, b_txt, text_color=b_col, bgcolor=row_bg, text_size=ts)
            if show_c
                [c_txt, c_col] = f_smt_key(p_pdl_swept, c_pdl_swept, smt2_enable, p_pdl_data)
                table.cell(tbl, col_c, row, c_txt, text_color=c_col, bgcolor=row_bg, text_size=ts)
            row += 1

        // PWH / PWL
        if dash_show_pw
            pw_name_col = show_pwhl ? dash_text_color : color.gray
            [pwh_txt, pwh_col] = f_sweep_status(p_pwh_swept, false, p_pwh_data)
            [pwl_txt, pwl_col] = f_sweep_status(p_pwl_swept, false, p_pwl_data)
            table.cell(tbl, 0, row,     "PWH",    text_color=pw_name_col, bgcolor=row_bg, text_size=ts)
            table.cell(tbl, 1, row,     pwh_txt,  text_color=pwh_col,     bgcolor=row_bg, text_size=ts)
            table.cell(tbl, 0, row + 1, "PWL",    text_color=pw_name_col, bgcolor=row_bg, text_size=ts)
            table.cell(tbl, 1, row + 1, pwl_txt,  text_color=pwl_col,     bgcolor=row_bg, text_size=ts)
            if show_b
                [bh_txt, bh_col] = f_smt_key(p_pwh_swept, b_pwh_swept, smt_enable,  p_pwh_data)
                [bl_txt, bl_col] = f_smt_key(p_pwl_swept, b_pwl_swept, smt_enable,  p_pwl_data)
                table.cell(tbl, col_b, row,     bh_txt, text_color=bh_col, bgcolor=row_bg, text_size=ts)
                table.cell(tbl, col_b, row + 1, bl_txt, text_color=bl_col, bgcolor=row_bg, text_size=ts)
            if show_c
                [ch_txt, ch_col] = f_smt_key(p_pwh_swept, c_pwh_swept, smt2_enable, p_pwh_data)
                [cl_txt, cl_col] = f_smt_key(p_pwl_swept, c_pwl_swept, smt2_enable, p_pwl_data)
                table.cell(tbl, col_c, row,     ch_txt, text_color=ch_col, bgcolor=row_bg, text_size=ts)
                table.cell(tbl, col_c, row + 1, cl_txt, text_color=cl_col, bgcolor=row_bg, text_size=ts)
            row += 2

        // PMH / PML
        if dash_show_pm
            pm_name_col = show_pmhl ? dash_text_color : color.gray
            [pmh_txt, pmh_col] = f_sweep_status(p_pmh_swept, false, p_pmh_data)
            [pml_txt, pml_col] = f_sweep_status(p_pml_swept, false, p_pml_data)
            table.cell(tbl, 0, row,     "PMH",    text_color=pm_name_col, bgcolor=row_bg, text_size=ts)
            table.cell(tbl, 1, row,     pmh_txt,  text_color=pmh_col,     bgcolor=row_bg, text_size=ts)
            table.cell(tbl, 0, row + 1, "PML",    text_color=pm_name_col, bgcolor=row_bg, text_size=ts)
            table.cell(tbl, 1, row + 1, pml_txt,  text_color=pml_col,     bgcolor=row_bg, text_size=ts)
            if show_b
                [bh_txt, bh_col] = f_smt_key(p_pmh_swept, b_pmh_swept, smt_enable,  p_pmh_data)
                [bl_txt, bl_col] = f_smt_key(p_pml_swept, b_pml_swept, smt_enable,  p_pml_data)
                table.cell(tbl, col_b, row,     bh_txt, text_color=bh_col, bgcolor=row_bg, text_size=ts)
                table.cell(tbl, col_b, row + 1, bl_txt, text_color=bl_col, bgcolor=row_bg, text_size=ts)
            if show_c
                [ch_txt, ch_col] = f_smt_key(p_pmh_swept, c_pmh_swept, smt2_enable, p_pmh_data)
                [cl_txt, cl_col] = f_smt_key(p_pml_swept, c_pml_swept, smt2_enable, p_pml_data)
                table.cell(tbl, col_c, row,     ch_txt, text_color=ch_col, bgcolor=row_bg, text_size=ts)
                table.cell(tbl, col_c, row + 1, cl_txt, text_color=cl_col, bgcolor=row_bg, text_size=ts)


// ═══════════════════════════════════════════════════════════════
// SECTION 5: MAIN LOGIC
// ═══════════════════════════════════════════════════════════════

new_day   = ta.change(time("D")) != 0
new_week  = ta.change(time("W")) != 0
new_month = ta.change(time("M")) != 0

// ── PDH / PDL ──────────────────────────────────────────────────
[prev_day_high, prev_day_low] = request.security(
     syminfo.tickerid, "D", [high[1], low[1]],
     lookahead = barmerge.lookahead_on)

if na(key_daily_start_idx) or new_day
    key_daily_start_idx := bar_index
if na(key_weekly_start_idx) or new_week
    key_weekly_start_idx := bar_index
if na(key_monthly_start_idx) or new_month
    key_monthly_start_idx := bar_index

if new_day
    pdh_anchor_idx    := pd_today_high_idx
    pdl_anchor_idx    := pd_today_low_idx
    pd_today_high     := high
    pd_today_low      := low
    pd_today_high_idx := bar_index
    pd_today_low_idx  := bar_index
else
    if na(pd_today_high) or high > pd_today_high
        pd_today_high     := high
        pd_today_high_idx := bar_index
    if na(pd_today_low) or low < pd_today_low
        pd_today_low      := low
        pd_today_low_idx  := bar_index

bool pdh_swept = not na(prev_day_high) and not na(pd_today_high) and pd_today_high >= prev_day_high
bool pdl_swept = not na(prev_day_low)  and not na(pd_today_low)  and pd_today_low  <= prev_day_low

if show_pdh_pdl
    if not na(prev_day_high) and not na(pdh_anchor_idx)
        pdh_vis_col = (pdh_swept and not qs_show_swept) ? color.new(pdh_color, 100) : pdh_color
        pdh_txt = (pdh_swept and not qs_show_swept) ? "" : pdh_label_text + (pdh_pdl_show_swept and pdh_swept and qs_show_swept ? " ✅" : "")
        [pdh_l, pdh_lbl] = f_update_level(pdh_line_ref, pdh_label_ref, prev_day_high,
             pdh_anchor_idx, pdh_txt, pdh_vis_col,
             key_line_width, f_line_style(key_line_style_str), f_label_size(key_label_size_str), pd_extend_full)
        pdh_line_ref  := pdh_l
        pdh_label_ref := pdh_lbl
    if not na(prev_day_low) and not na(pdl_anchor_idx)
        pdl_vis_col = (pdl_swept and not qs_show_swept) ? color.new(pdl_color, 100) : pdl_color
        pdl_txt = (pdl_swept and not qs_show_swept) ? "" : pdl_label_text + (pdh_pdl_show_swept and pdl_swept and qs_show_swept ? " ✅" : "")
        [pdl_l, pdl_lbl] = f_update_level(pdl_line_ref, pdl_label_ref, prev_day_low,
             pdl_anchor_idx, pdl_txt, pdl_vis_col,
             key_line_width, f_line_style(key_line_style_str), f_label_size(key_label_size_str), pd_extend_full)
        pdl_line_ref  := pdl_l
        pdl_label_ref := pdl_lbl
else
    if not na(pdh_line_ref)
        line.delete(pdh_line_ref)
        pdh_line_ref := na
    if not na(pdh_label_ref)
        label.delete(pdh_label_ref)
        pdh_label_ref := na
    if not na(pdl_line_ref)
        line.delete(pdl_line_ref)
        pdl_line_ref := na
    if not na(pdl_label_ref)
        label.delete(pdl_label_ref)
        pdl_label_ref := na

// ── PWH / PWL ──────────────────────────────────────────────────
[prev_week_high, prev_week_low] = request.security(
     syminfo.tickerid, "W", [high[1], low[1]],
     lookahead = barmerge.lookahead_on)


if new_week
    pwh_anchor_idx    := pw_today_high_idx
    pwl_anchor_idx    := pw_today_low_idx
    pw_today_high     := high
    pw_today_low      := low
    pw_today_high_idx := bar_index
    pw_today_low_idx  := bar_index
else
    if na(pw_today_high) or high > pw_today_high
        pw_today_high     := high
        pw_today_high_idx := bar_index
    if na(pw_today_low) or low < pw_today_low
        pw_today_low      := low
        pw_today_low_idx  := bar_index

bool pwh_swept = not na(prev_week_high) and not na(pw_today_high) and pw_today_high >= prev_week_high
bool pwl_swept = not na(prev_week_low)  and not na(pw_today_low)  and pw_today_low  <= prev_week_low

if show_pwhl
    if not na(prev_week_high)
        pwh_vis_col = (pwh_swept and not qs_show_swept) ? color.new(pw_color, 100) : pw_color
        pwh_txt = (pwh_swept and not qs_show_swept) ? "" : pwh_label_text + (pdh_pdl_show_swept and pwh_swept and qs_show_swept ? " ✅" : "")
        [pwh_l, pwh_lbl] = f_update_level_ext(pwh_line_ref, pwh_label_ref, prev_week_high,
             pwh_anchor_idx, pwh_txt, pwh_vis_col,
             key_line_width, f_line_style(key_line_style_str), f_label_size(key_label_size_str), pw_extend_full)
        pwh_line_ref  := pwh_l
        pwh_label_ref := pwh_lbl
    if not na(prev_week_low)
        pwl_vis_col = (pwl_swept and not qs_show_swept) ? color.new(pw_color, 100) : pw_color
        pwl_txt = (pwl_swept and not qs_show_swept) ? "" : pwl_label_text + (pdh_pdl_show_swept and pwl_swept and qs_show_swept ? " ✅" : "")
        [pwl_l, pwl_lbl] = f_update_level_ext(pwl_line_ref, pwl_label_ref, prev_week_low,
             pwl_anchor_idx, pwl_txt, pwl_vis_col,
             key_line_width, f_line_style(key_line_style_str), f_label_size(key_label_size_str), pw_extend_full)
        pwl_line_ref  := pwl_l
        pwl_label_ref := pwl_lbl
else
    if not na(pwh_line_ref)
        line.delete(pwh_line_ref)
        pwh_line_ref := na
    if not na(pwh_label_ref)
        label.delete(pwh_label_ref)
        pwh_label_ref := na
    if not na(pwl_line_ref)
        line.delete(pwl_line_ref)
        pwl_line_ref := na
    if not na(pwl_label_ref)
        label.delete(pwl_label_ref)
        pwl_label_ref := na

// ── PMH / PML ──────────────────────────────────────────────────
[prev_month_high, prev_month_low] = request.security(
     syminfo.tickerid, "M", [high[1], low[1]],
     lookahead = barmerge.lookahead_on)


if new_month
    pmh_anchor_idx    := pm_today_high_idx
    pml_anchor_idx    := pm_today_low_idx
    pm_today_high     := high
    pm_today_low      := low
    pm_today_high_idx := bar_index
    pm_today_low_idx  := bar_index
else
    if na(pm_today_high) or high > pm_today_high
        pm_today_high     := high
        pm_today_high_idx := bar_index
    if na(pm_today_low) or low < pm_today_low
        pm_today_low      := low
        pm_today_low_idx  := bar_index

bool pmh_swept = not na(prev_month_high) and not na(pm_today_high) and pm_today_high >= prev_month_high
bool pml_swept = not na(prev_month_low)  and not na(pm_today_low)  and pm_today_low  <= prev_month_low

if show_pmhl
    if not na(prev_month_high)
        pmh_vis_col = (pmh_swept and not qs_show_swept) ? color.new(pm_color, 100) : pm_color
        pmh_txt = (pmh_swept and not qs_show_swept) ? "" : pmh_label_text + (pdh_pdl_show_swept and pmh_swept and qs_show_swept ? " ✅" : "")
        [pmh_l, pmh_lbl] = f_update_level_ext(pmh_line_ref, pmh_label_ref, prev_month_high,
             pmh_anchor_idx, pmh_txt, pmh_vis_col,
             key_line_width, f_line_style(key_line_style_str), f_label_size(key_label_size_str), pm_extend_full)
        pmh_line_ref  := pmh_l
        pmh_label_ref := pmh_lbl
    if not na(prev_month_low)
        pml_vis_col = (pml_swept and not qs_show_swept) ? color.new(pm_color, 100) : pm_color
        pml_txt = (pml_swept and not qs_show_swept) ? "" : pml_label_text + (pdh_pdl_show_swept and pml_swept and qs_show_swept ? " ✅" : "")
        [pml_l, pml_lbl] = f_update_level_ext(pml_line_ref, pml_label_ref, prev_month_low,
             pml_anchor_idx, pml_txt, pml_vis_col,
             key_line_width, f_line_style(key_line_style_str), f_label_size(key_label_size_str), pm_extend_full)
        pml_line_ref  := pml_l
        pml_label_ref := pml_lbl
else
    if not na(pmh_line_ref)
        line.delete(pmh_line_ref)
        pmh_line_ref := na
    if not na(pmh_label_ref)
        label.delete(pmh_label_ref)
        pmh_label_ref := na
    if not na(pml_line_ref)
        line.delete(pml_line_ref)
        pml_line_ref := na
    if not na(pml_label_ref)
        label.delete(pml_label_ref)
        pml_label_ref := na

// ── SMT Asset B — Key-Level Sweeps ─────────────────────────────
[smt_b_pdh, smt_b_pdl] = request.security(smt_sym, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[smt_b_pwh, smt_b_pwl] = request.security(smt_sym, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[smt_b_pmh, smt_b_pml] = request.security(smt_sym, "M", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[smt_b_h,   smt_b_l  ] = request.security(smt_sym, timeframe.period, [high, low])

if smt_enable
    if new_day
        smt_b_pd_today_high := smt_b_h
        smt_b_pd_today_low  := smt_b_l
    else
        smt_b_pd_today_high := na(smt_b_pd_today_high) ? smt_b_h : math.max(smt_b_pd_today_high, smt_b_h)
        smt_b_pd_today_low  := na(smt_b_pd_today_low)  ? smt_b_l : math.min(smt_b_pd_today_low,  smt_b_l)
    if new_week
        smt_b_pw_today_high := smt_b_h
        smt_b_pw_today_low  := smt_b_l
    else
        smt_b_pw_today_high := na(smt_b_pw_today_high) ? smt_b_h : math.max(smt_b_pw_today_high, smt_b_h)
        smt_b_pw_today_low  := na(smt_b_pw_today_low)  ? smt_b_l : math.min(smt_b_pw_today_low,  smt_b_l)
    if new_month
        smt_b_pm_today_high := smt_b_h
        smt_b_pm_today_low  := smt_b_l
    else
        smt_b_pm_today_high := na(smt_b_pm_today_high) ? smt_b_h : math.max(smt_b_pm_today_high, smt_b_h)
        smt_b_pm_today_low  := na(smt_b_pm_today_low)  ? smt_b_l : math.min(smt_b_pm_today_low,  smt_b_l)

bool smt_b_pdh_swept = smt_enable and not na(smt_b_pdh) and not na(smt_b_pd_today_high) and smt_b_pd_today_high >= smt_b_pdh
bool smt_b_pdl_swept = smt_enable and not na(smt_b_pdl) and not na(smt_b_pd_today_low)  and smt_b_pd_today_low  <= smt_b_pdl
bool smt_b_pwh_swept = smt_enable and not na(smt_b_pwh) and not na(smt_b_pw_today_high) and smt_b_pw_today_high >= smt_b_pwh
bool smt_b_pwl_swept = smt_enable and not na(smt_b_pwl) and not na(smt_b_pw_today_low)  and smt_b_pw_today_low  <= smt_b_pwl
bool smt_b_pmh_swept = smt_enable and not na(smt_b_pmh) and not na(smt_b_pm_today_high) and smt_b_pm_today_high >= smt_b_pmh
bool smt_b_pml_swept = smt_enable and not na(smt_b_pml) and not na(smt_b_pm_today_low)  and smt_b_pm_today_low  <= smt_b_pml

// ── SMT Asset C — Key-Level Sweeps ─────────────────────────────
[smt_c_pdh, smt_c_pdl] = request.security(smt2_sym, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[smt_c_pwh, smt_c_pwl] = request.security(smt2_sym, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[smt_c_pmh, smt_c_pml] = request.security(smt2_sym, "M", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[smt_c_h,   smt_c_l  ] = request.security(smt2_sym, timeframe.period, [high, low])

if smt2_enable
    if new_day
        smt_c_pd_today_high := smt_c_h
        smt_c_pd_today_low  := smt_c_l
    else
        smt_c_pd_today_high := na(smt_c_pd_today_high) ? smt_c_h : math.max(smt_c_pd_today_high, smt_c_h)
        smt_c_pd_today_low  := na(smt_c_pd_today_low)  ? smt_c_l : math.min(smt_c_pd_today_low,  smt_c_l)
    if new_week
        smt_c_pw_today_high := smt_c_h
        smt_c_pw_today_low  := smt_c_l
    else
        smt_c_pw_today_high := na(smt_c_pw_today_high) ? smt_c_h : math.max(smt_c_pw_today_high, smt_c_h)
        smt_c_pw_today_low  := na(smt_c_pw_today_low)  ? smt_c_l : math.min(smt_c_pw_today_low,  smt_c_l)
    if new_month
        smt_c_pm_today_high := smt_c_h
        smt_c_pm_today_low  := smt_c_l
    else
        smt_c_pm_today_high := na(smt_c_pm_today_high) ? smt_c_h : math.max(smt_c_pm_today_high, smt_c_h)
        smt_c_pm_today_low  := na(smt_c_pm_today_low)  ? smt_c_l : math.min(smt_c_pm_today_low,  smt_c_l)

bool smt_c_pdh_swept = smt2_enable and not na(smt_c_pdh) and not na(smt_c_pd_today_high) and smt_c_pd_today_high >= smt_c_pdh
bool smt_c_pdl_swept = smt2_enable and not na(smt_c_pdl) and not na(smt_c_pd_today_low)  and smt_c_pd_today_low  <= smt_c_pdl
bool smt_c_pwh_swept = smt2_enable and not na(smt_c_pwh) and not na(smt_c_pw_today_high) and smt_c_pw_today_high >= smt_c_pwh
bool smt_c_pwl_swept = smt2_enable and not na(smt_c_pwl) and not na(smt_c_pw_today_low)  and smt_c_pw_today_low  <= smt_c_pwl
bool smt_c_pmh_swept = smt2_enable and not na(smt_c_pmh) and not na(smt_c_pm_today_high) and smt_c_pm_today_high >= smt_c_pmh
bool smt_c_pml_swept = smt2_enable and not na(smt_c_pml) and not na(smt_c_pm_today_low)  and smt_c_pm_today_low  <= smt_c_pml

// ── Session Liquidity ───────────────────────────────────────────
asia_liq   := f_process_session(asia_liq,
     show_session_liquidity and show_asia_session,
     asia_session_time, asia_session_abbr, asia_session_color, session_extend_full)
london_liq := f_process_session(london_liq,
     show_session_liquidity and show_london_session,
     london_session_time, london_session_abbr, london_session_color, session_extend_full)
nyam_liq   := f_process_session(nyam_liq,
     show_session_liquidity and show_nyam_session,
     nyam_session_time, nyam_session_abbr, nyam_session_color, session_extend_full)
nypm_liq   := f_process_session(nypm_liq,
     show_session_liquidity and show_nypm_session,
     nypm_session_time, nypm_session_abbr, nypm_session_color, session_extend_full)

// ── SMT: korrelierende Assets tracken ──────────────────────────
[smt_h, smt_l] = request.security(smt_enable and smt_sym != "" ? smt_sym : syminfo.tickerid,
     timeframe.period, [high, low],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

smt_asia   := f_track_session_smt(smt_asia,   smt_enable and show_asia_session,
     asia_session_time,   smt_h, smt_l)
smt_london := f_track_session_smt(smt_london, smt_enable and show_london_session,
     london_session_time, smt_h, smt_l)
smt_nyam   := f_track_session_smt(smt_nyam,   smt_enable and show_nyam_session,
     nyam_session_time,   smt_h, smt_l)
smt_nypm   := f_track_session_smt(smt_nypm,   smt_enable and show_nypm_session,
     nypm_session_time,   smt_h, smt_l)

[smt2_h, smt2_l] = request.security(smt2_enable and smt2_sym != "" ? smt2_sym : syminfo.tickerid,
     timeframe.period, [high, low],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

smt2_asia   := f_track_session_smt(smt2_asia,   smt2_enable and show_asia_session,
     asia_session_time,   smt2_h, smt2_l)
smt2_london := f_track_session_smt(smt2_london, smt2_enable and show_london_session,
     london_session_time, smt2_h, smt2_l)
smt2_nyam   := f_track_session_smt(smt2_nyam,   smt2_enable and show_nyam_session,
     nyam_session_time,   smt2_h, smt2_l)
smt2_nypm   := f_track_session_smt(smt2_nypm,   smt2_enable and show_nypm_session,
     nypm_session_time,   smt2_h, smt2_l)

// ── Dashboard ──────────────────────────────────────────────────
// Tabelle wird einmalig im Hauptkörper erstellt (Pine v6: var nicht in Funktionen zuweisbar).
// 3 Spalten × 11 Zeilen max (1 Header + 4×2 Sessions + PDH + PDL); nicht genutzte Zeilen bleiben leer.
if show_dashboard and na(dash_table)
    dash_table := table.new(f_dash_pos(), 4, 20,
         border_color = color.new(color.gray, 60),
         border_width = 1,
         frame_color  = color.new(color.gray, 50),
         frame_width  = 1)

if show_dashboard
    f_update_dashboard(dash_table, asia_liq, london_liq, nyam_liq, nypm_liq,
         smt_asia, smt_london, smt_nyam, smt_nypm,
         smt2_asia, smt2_london, smt2_nyam, smt2_nypm,
         pdh_swept, pdl_swept, not na(prev_day_high),  not na(prev_day_low),
         pwh_swept, pwl_swept, not na(prev_week_high), not na(prev_week_low),
         pmh_swept, pml_swept, not na(prev_month_high), not na(prev_month_low),
         smt_b_pdh_swept, smt_b_pdl_swept, smt_b_pwh_swept, smt_b_pwl_swept, smt_b_pmh_swept, smt_b_pml_swept,
         smt_c_pdh_swept, smt_c_pdl_swept, smt_c_pwh_swept, smt_c_pwl_swept, smt_c_pmh_swept, smt_c_pml_swept)

// ── LTF FVG ────────────────────────────────────────────────────
if show_fvg and show_ltf_fvg and barstate.isconfirmed
    if high[2] < low[0] and not f_fvg_exists(active_fvgs, time[1])
        f_add_fvg(active_fvgs, true)
    if low[2] > high[0] and not f_fvg_exists(active_fvgs, time[1])
        f_add_fvg(active_fvgs, false)

if show_fvg and show_ltf_fvg
    f_update_fvgs(active_fvgs)

// ── HTF FVG ────────────────────────────────────────────────────
eff1 = htf_mode == "Auto" ? f_auto_htf(1) : htf_1_tf
eff2 = htf_mode == "Auto" ? f_auto_htf(2) : htf_2_tf
eff3 = htf_mode == "Auto" ? f_auto_htf(3) : htf_3_tf

safe1 = eff1 == "SKIP" ? timeframe.period : eff1
safe2 = eff2 == "SKIP" ? timeframe.period : eff2
safe3 = eff3 == "SKIP" ? timeframe.period : eff3

[h1_hi1, h1_lo1, h1_hi3, h1_lo3, h1_c1, h1_t1, h1_t3] =
     request.security(syminfo.tickerid, safe1,
     [high[1], low[1], high[3], low[3], close[1], time[1], time[3]],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

[h2_hi1, h2_lo1, h2_hi3, h2_lo3, h2_c1, h2_t1, h2_t3] =
     request.security(syminfo.tickerid, safe2,
     [high[1], low[1], high[3], low[3], close[1], time[1], time[3]],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

[h3_hi1, h3_lo1, h3_hi3, h3_lo3, h3_c1, h3_t1, h3_t3] =
     request.security(syminfo.tickerid, safe3,
     [high[1], low[1], high[3], low[3], close[1], time[1], time[3]],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

htf1_ok      = show_fvg and htf_1_enable and eff1 != "SKIP" and timeframe.in_seconds(eff1) > timeframe.in_seconds()
htf1_changed = ta.change(h1_t1) != 0
secs1        = timeframe.in_seconds(safe1)

if htf1_ok and htf1_changed
    dur1 = secs1 * 1000
    if h1_hi3 < h1_lo1 and not f_fvg_exists(htf1_fvgs, h1_t1)
        f_add_htf_fvg(htf1_fvgs, true,  h1_t3, h1_t1 + dur1 * 2, h1_lo1, h1_hi3, f_tf_name(eff1), h1_t1, dur1, secs1)
    if h1_lo3 > h1_hi1 and not f_fvg_exists(htf1_fvgs, h1_t1)
        f_add_htf_fvg(htf1_fvgs, false, h1_t3, h1_t1 + dur1 * 2, h1_lo3, h1_hi1, f_tf_name(eff1), h1_t1, dur1, secs1)

if htf1_ok and (barstate.islast or htf1_changed)
    f_update_htf_fvgs(htf1_fvgs, h1_c1, htf1_changed)

htf2_ok      = show_fvg and htf_2_enable and eff2 != "SKIP" and timeframe.in_seconds(eff2) > timeframe.in_seconds()
htf2_changed = ta.change(h2_t1) != 0
secs2        = timeframe.in_seconds(safe2)

if htf2_ok and htf2_changed
    dur2 = secs2 * 1000
    if h2_hi3 < h2_lo1 and not f_fvg_exists(htf2_fvgs, h2_t1)
        f_add_htf_fvg(htf2_fvgs, true,  h2_t3, h2_t1 + dur2 * 2, h2_lo1, h2_hi3, f_tf_name(eff2), h2_t1, dur2, secs2)
    if h2_lo3 > h2_hi1 and not f_fvg_exists(htf2_fvgs, h2_t1)
        f_add_htf_fvg(htf2_fvgs, false, h2_t3, h2_t1 + dur2 * 2, h2_lo3, h2_hi1, f_tf_name(eff2), h2_t1, dur2, secs2)

if htf2_ok and (barstate.islast or htf2_changed)
    f_update_htf_fvgs(htf2_fvgs, h2_c1, htf2_changed)

htf3_ok      = show_fvg and htf_3_enable and eff3 != "SKIP" and timeframe.in_seconds(eff3) > timeframe.in_seconds()
htf3_changed = ta.change(h3_t1) != 0
secs3        = timeframe.in_seconds(safe3)

if htf3_ok and htf3_changed
    dur3 = secs3 * 1000
    if h3_hi3 < h3_lo1 and not f_fvg_exists(htf3_fvgs, h3_t1)
        f_add_htf_fvg(htf3_fvgs, true,  h3_t3, h3_t1 + dur3 * 2, h3_lo1, h3_hi3, f_tf_name(eff3), h3_t1, dur3, secs3)
    if h3_lo3 > h3_hi1 and not f_fvg_exists(htf3_fvgs, h3_t1)
        f_add_htf_fvg(htf3_fvgs, false, h3_t3, h3_t1 + dur3 * 2, h3_lo3, h3_hi1, f_tf_name(eff3), h3_t1, dur3, secs3)

if htf3_ok and (barstate.islast or htf3_changed)
    f_update_htf_fvgs(htf3_fvgs, h3_c1, htf3_changed)

// Nearest-Filter und Überlappungs-Filter — nur auf dem letzten Bar (Performance).
if show_fvg and barstate.islast
    f_apply_ltf_visibility(active_fvgs)
    if htf1_ok
        f_apply_htf_visibility(htf1_fvgs, secs1)
    if htf2_ok
        f_apply_htf_visibility(htf2_fvgs, secs2)
    if htf3_ok
        f_apply_htf_visibility(htf3_fvgs, secs3)

    // LTF gegen HTF Überlappung (gleiche Richtung): LTF wird ausgeblendet
    if htf_hide_overlap
        if htf1_ok
            f_apply_ltf_htf_overlap(active_fvgs, htf1_fvgs)
        if htf2_ok
            f_apply_ltf_htf_overlap(active_fvgs, htf2_fvgs)
        if htf3_ok
            f_apply_ltf_htf_overlap(active_fvgs, htf3_fvgs)

    // Überlappungs-Check: niedrigere TF-FVGs verstecken wenn höhere TF-FVG überlappen.
    // TFs die "immer anzeigen" gesetzt haben, sind vom Overlap-Filter ausgenommen.
    if htf_hide_overlap
        exempt1 = (htf_always_h1 and secs1 == 3600) or (htf_always_h4 and secs1 == 14400) or (htf_always_d1 and secs1 == 86400)
        exempt2 = (htf_always_h1 and secs2 == 3600) or (htf_always_h4 and secs2 == 14400) or (htf_always_d1 and secs2 == 86400)
        if htf1_ok and htf2_ok
            f_apply_htf_overlap(htf1_fvgs, htf2_fvgs, exempt1)
        if htf1_ok and htf3_ok
            f_apply_htf_overlap(htf1_fvgs, htf3_fvgs, exempt1)
        if htf2_ok and htf3_ok
            f_apply_htf_overlap(htf2_fvgs, htf3_fvgs, exempt2)
