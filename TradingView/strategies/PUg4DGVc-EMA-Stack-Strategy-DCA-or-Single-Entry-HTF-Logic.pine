//@version=6
strategy(
     title               = "EMA Stack Strategy (DCA or Single Entry, HTF Logic, Non Repainting)",
     shorttitle          = "EMA Stack Strat",
     overlay             = true,
     scale               = scale.right,
     pyramiding          = 50,
     initial_capital     = 100000,
     currency            = currency.USD,
     default_qty_type    = strategy.cash,
     default_qty_value   = 1000,
     commission_type     = strategy.commission.percent,
     commission_value    = 0,
     slippage            = 0
)


//──────────────────────────────────────────────────────────────────────────────
// Utilities
//──────────────────────────────────────────────────────────────────────────────
ma(_source, _length, _type) =>
    switch _type
        "SMA"        => ta.sma(_source,  _length)
        "EMA"        => ta.ema(_source,  _length)
        "SMMA (RMA)" => ta.rma(_source,  _length)
        "WMA"        => ta.wma(_source,  _length)
        "VWMA"       => ta.vwma(_source, _length)
        => na


clamp(_x, _min, _max) =>
    math.max(_min, math.min(_max, _x))


timeStrToMinutes(_s) =>
    _parts = str.split(_s, ":")
    _h = array.size(_parts) > 0 ? int(str.tonumber(array.get(_parts, 0))) : 0
    _m = array.size(_parts) > 1 ? int(str.tonumber(array.get(_parts, 1))) : 0
    _h * 60 + _m


inWindowHHMM(_enabled, _startHHMM, _endHHMM, _tz) =>
    if not _enabled
        false
    else
        _nowH = hour(time, _tz)
        _nowM = minute(time, _tz)
        _now  = _nowH * 60 + _nowM
        _st   = timeStrToMinutes(_startHHMM)
        _en   = timeStrToMinutes(_endHHMM)
        _st <= _en ? (_now >= _st and _now <= _en) : (_now >= _st or _now <= _en)


// Distance helper (returns absolute PRICE distance)
distPrice(_mode, _anchorPrice, _unitSize, _units, _pct, _atr, _atrMult) =>
    switch _mode
        "Units"   => (_units * _unitSize)
        "Percent" => (_anchorPrice * (_pct / 100.0))
        "ATR"     => (_atr * _atrMult)
        => na


isLastBar = barstate.isrealtime or barstate.islastconfirmedhistory
execConfirmed = barstate.isconfirmed


