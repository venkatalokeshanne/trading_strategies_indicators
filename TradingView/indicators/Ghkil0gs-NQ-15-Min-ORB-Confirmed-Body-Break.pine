//@version=6
indicator("NQ 15-Min ORB - Confirmed Body Break (9:00-9:15 Range, 9:30 Trigger)", overlay=true)

// ───────────────────────────── Inputs ─────────────────────────────
rangeSessionInput   = input.session("0900-0915", "Opening Range Window (New York Time)", tooltip="Set chart timezone to America/New_York for this to line up correctly.")
tradingStartInput   = input.time(timestamp("2024-01-01 09:30 -0500"), "Earliest Time Signals Can Fire (Market Open)", tooltip="No signals will be considered before this time, even if price breaks the range earlier.")
useLongs            = input.bool(true,  "Show Buy Signals")
useShorts           = input.bool(true,  "Show Sell Signals")
onlyOneSignalPerDay = input.bool(true, "Only One Signal Per Direction Per Day")
requireFullBody     = input.bool(true, "Require Full Candle Body Beyond Level (filters wick-only pokes)")
minBodyPct          = input.float(30.0, "Minimum Body Size (% of candle range)", minval=0, maxval=100, step=5, tooltip="Filters out doji/indecision candles even if body technically clears the level.")
extendLines          = input.bool(true, "Extend Range Lines Through the Day")
showBackground        = input.bool(true, "Shade Opening Range Window")

// ───────────────────────────── Session / Range Tracking ─────────────────────────────
inORBSession = not na(time(timeframe.period, rangeSessionInput))

// Extract just hour/minute from the time input so it applies every day, not just the literal date entered
tradingStartHour   = hour(tradingStartInput)
tradingStartMinute = minute(tradingStartInput)
pastOpenTime       = (hour >= tradingStartHour) and (minute >= tradingStartMinute) or (hour > tradingStartHour)

newDay = ta.change(time("D")) != 0


var float orbHigh = na
var float orbLow  = na
var bool  orbSet  = false
var bool  longFired  = false
var bool  shortFired = false

if newDay
    orbHigh := na
    orbLow  := na
    orbSet  := false
    longFired  := false
    shortFired := false

if inORBSession
    orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
    orbLow  := na(orbLow)  ? low  : math.min(orbLow, low)
    orbSet  := true

rangeLocked = orbSet and not inORBSession

// ───────────────────────────── Plot the Range ─────────────────────────────
plot(rangeLocked or inORBSession ? orbHigh : na, title="ORB High", color=color.new(color.lime, 0), style=extendLines ? plot.style_linebr : plot.style_circles, linewidth=1)
plot(rangeLocked or inORBSession ? orbLow  : na, title="ORB Low",  color=color.new(color.red, 0),  style=extendLines ? plot.style_linebr : plot.style_circles, linewidth=1)

bgcolor(showBackground and inORBSession ? color.new(color.blue, 90) : na, title="Opening Range Window")

// ───────────────────────────── Candle Body Analysis ─────────────────────────────
bodyHigh   = math.max(open, close)
bodyLow    = math.min(open, close)
bodySize   = math.abs(close - open)
candleSize = high - low
bodyPct    = candleSize > 0 ? (bodySize / candleSize) * 100 : 0

isBullishCandle = close > open
isBearishCandle = close < open
hasEnoughBody   = bodyPct >= minBodyPct

// Full-body break = entire candle body (both open AND close) clears the level, not just a wick or a close poking through
bullishBodyBreak = requireFullBody ? (bodyLow > orbHigh) : (close > orbHigh)
bearishBodyBreak = requireFullBody ? (bodyHigh < orbLow) : (close < orbLow)

// ───────────────────────────── Signal Conditions ─────────────────────────────
// barstate.isconfirmed ensures we only act on a fully CLOSED candle, eliminating repaint/late-signal issues
candleClosed = barstate.isconfirmed

canFireLong  = rangeLocked and pastOpenTime and useLongs  and (not onlyOneSignalPerDay or not longFired)
canFireShort = rangeLocked and pastOpenTime and useShorts and (not onlyOneSignalPerDay or not shortFired)

buySignal  = canFireLong  and candleClosed and isBullishCandle and bullishBodyBreak and hasEnoughBody
sellSignal = canFireShort and candleClosed and isBearishCandle and bearishBodyBreak and hasEnoughBody

if buySignal
    longFired := true
if sellSignal
    shortFired := true

// ───────────────────────────── Plot Signals ─────────────────────────────
plotshape(buySignal,  title="Buy Signal",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime, 0), size=size.small, text="BUY")
plotshape(sellSignal, title="Sell Signal", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0),  size=size.small, text="SELL")

// ───────────────────────────── Alerts ─────────────────────────────
alertcondition(buySignal,  title="ORB Buy Signal",  message="NQ 15-min ORB: CLOSED candle broke ABOVE opening range high with full body — potential long.")
alertcondition(sellSignal, title="ORB Sell Signal", message="NQ 15-min ORB: CLOSED candle broke BELOW opening range low with full body — potential short.")

// ───────────────────────────── Info Table ─────────────────────────────
var table infoTable = table.new(position.top_right, 2, 4, border_width=1)
if barstate.islast
    table.cell(infoTable, 0, 0, "ORB High", text_color=color.white, bgcolor=color.new(color.green, 40))
    table.cell(infoTable, 1, 0, str.tostring(orbHigh, format.mintick), text_color=color.white, bgcolor=color.new(color.green, 40))
    table.cell(infoTable, 0, 1, "ORB Low", text_color=color.white, bgcolor=color.new(color.red, 40))
    table.cell(infoTable, 1, 1, str.tostring(orbLow, format.mintick), text_color=color.white, bgcolor=color.new(color.red, 40))
    table.cell(infoTable, 0, 2, "Range (pts)", text_color=color.white, bgcolor=color.new(color.gray, 40))
    table.cell(infoTable, 1, 2, str.tostring(orbHigh - orbLow, format.mintick), text_color=color.white, bgcolor=color.new(color.gray, 40))
    table.cell(infoTable, 0, 3, "Signals Fired", text_color=color.white, bgcolor=color.new(color.blue, 40))
    table.cell(infoTable, 1, 3, (longFired ? "LONG " : "") + (shortFired ? "SHORT" : "") + (not longFired and not shortFired ? "None" : ""), text_color=color.white, bgcolor=color.new(color.blue, 40))
