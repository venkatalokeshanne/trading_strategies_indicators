// © ITA Trading Tools - itamardrori_
//@version=6
indicator("Premium & Discount Zones [ITA]", overlay=true, max_boxes_count=100, max_labels_count=100, max_lines_count=100)

// ─── INPUTS ──────────────────────────────────────────────────────────────────
pivotLen   = input.int(15, "Range Swing Lookback", minval=5, maxval=60, group="Range", tooltip="Higher = larger, more significant ranges")
autoRange  = input.bool(true, "Auto-detect Range from Swings", group="Range")

showPrem   = input.bool(true,  "Show Premium Zone",  group="Zones")
showDisc   = input.bool(true,  "Show Discount Zone", group="Zones")
showEq     = input.bool(true,  "Show Equilibrium (50%)", group="Zones")
showOTE    = input.bool(true,  "Show OTE Zone (62-79%)", group="Zones", tooltip="Optimal Trade Entry - the retracement band ICT traders watch")

premColor  = input.color(color.new(#f23645, 88), "Premium",  group="Style")
discColor  = input.color(color.new(#089981, 88), "Discount", group="Style")
oteColor   = input.color(color.new(#d29922, 80), "OTE Zone", group="Style")
eqColor    = input.color(color.new(#787b86, 0),  "Equilibrium Line", group="Style")
showLabels = input.bool(true, "Show Labels", group="Style")
lblSizeStr = input.string("Normal", "Label Size", options=["Tiny","Small","Normal","Large"], group="Style")

lblSize = lblSizeStr == "Tiny" ? size.tiny : lblSizeStr == "Small" ? size.small : lblSizeStr == "Large" ? size.large : size.normal

premSolid = #f23645
discSolid = #089981
oteSolid  = #d29922

// ─── RANGE DETECTION ─────────────────────────────────────────────────────────
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,  pivotLen, pivotLen)

var float rangeHigh    = na
var float rangeLow     = na
var int   rangeHighBar = na
var int   rangeLowBar  = na

if autoRange
    if not na(ph)
        rangeHigh := ph
        rangeHighBar := bar_index - pivotLen
    if not na(pl)
        rangeLow := pl
        rangeLowBar := bar_index - pivotLen

hasRange = not na(rangeHigh) and not na(rangeLow) and rangeHigh > rangeLow

// ─── LEVELS ──────────────────────────────────────────────────────────────────
rangeSize = hasRange ? rangeHigh - rangeLow : na
eqLevel   = hasRange ? rangeLow + rangeSize * 0.5  : na
ote1      = hasRange ? rangeLow + rangeSize * 0.62 : na
ote2      = hasRange ? rangeLow + rangeSize * 0.79 : na

// current market state
inPremium  = hasRange and close > eqLevel
inDiscount = hasRange and close < eqLevel
inOTE      = hasRange and close >= ote1 and close <= ote2

// ─── DRAWING ─────────────────────────────────────────────────────────────────
var box   premBox = na
var box   discBox = na
var box   oteBox  = na
var line  eqLine  = na
var label premLbl = na
var label discLbl = na
var label eqLbl   = na

if barstate.islast and hasRange
    leftBar  = math.min(nz(rangeHighBar, bar_index - 50), nz(rangeLowBar, bar_index - 50))
    rightBar = bar_index + 15

    // premium zone: equilibrium to range high
    if showPrem
        if na(premBox)
            premBox := box.new(leftBar, rangeHigh, rightBar, eqLevel, bgcolor=premColor, border_color=color.new(premSolid, 60), border_width=1)
        else
            box.set_lefttop(premBox, leftBar, rangeHigh)
            box.set_rightbottom(premBox, rightBar, eqLevel)
        if showLabels
            if na(premLbl)
                premLbl := label.new(rightBar, rangeHigh, "PREMIUM", style=label.style_label_left, color=color.new(premSolid, 10), textcolor=color.white, size=lblSize)
            else
                label.set_xy(premLbl, rightBar, rangeHigh)

    // discount zone: range low to equilibrium
    if showDisc
        if na(discBox)
            discBox := box.new(leftBar, eqLevel, rightBar, rangeLow, bgcolor=discColor, border_color=color.new(discSolid, 60), border_width=1)
        else
            box.set_lefttop(discBox, leftBar, eqLevel)
            box.set_rightbottom(discBox, rightBar, rangeLow)
        if showLabels
            if na(discLbl)
                discLbl := label.new(rightBar, rangeLow, "DISCOUNT", style=label.style_label_left, color=color.new(discSolid, 10), textcolor=color.white, size=lblSize)
            else
                label.set_xy(discLbl, rightBar, rangeLow)

    // OTE band
    if showOTE
        if na(oteBox)
            oteBox := box.new(leftBar, ote2, rightBar, ote1, bgcolor=oteColor, border_color=color.new(oteSolid, 40), border_width=1)
        else
            box.set_lefttop(oteBox, leftBar, ote2)
            box.set_rightbottom(oteBox, rightBar, ote1)

    // equilibrium line
    if showEq
        if na(eqLine)
            eqLine := line.new(leftBar, eqLevel, rightBar, eqLevel, color=eqColor, style=line.style_dashed, width=2)
        else
            line.set_xy1(eqLine, leftBar, eqLevel)
            line.set_xy2(eqLine, rightBar, eqLevel)
        if showLabels
            if na(eqLbl)
                eqLbl := label.new(rightBar, eqLevel, "EQ 50%", style=label.style_label_left, color=color.new(eqColor, 10), textcolor=color.white, size=lblSize)
            else
                label.set_xy(eqLbl, rightBar, eqLevel)

// ─── ALERTS ──────────────────────────────────────────────────────────────────
enteredPremium  = inPremium  and not inPremium[1]
enteredDiscount = inDiscount and not inDiscount[1]
enteredOTE      = inOTE      and not inOTE[1]

alertcondition(enteredPremium,  "Price Entered Premium",  "Price moved into the premium half of the range")
alertcondition(enteredDiscount, "Price Entered Discount", "Price moved into the discount half of the range")
alertcondition(enteredOTE,      "Price Entered OTE Zone", "Price entered the optimal trade entry band")
