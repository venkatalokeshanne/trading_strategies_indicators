//@version=6
strategy("Full Session Trading System (Clean & Fixed)", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=1)

// ===== INPUTS =====
emaFast = input.int(50, "EMA Fast")
emaSlow = input.int(200, "EMA Slow")
rsiLen  = input.int(14, "RSI Length")

useATR  = input.bool(true, "Use ATR Stop Loss")
atrMult = input.float(1.2, "ATR Multiplier")
rr      = input.float(1.8, "Risk/Reward")

useHTF      = input.bool(true, "Use HTF Filter")
htfTF       = input.timeframe("15", "HTF Timeframe")
useCandle   = input.bool(true, "Use Candle Confirmation")

minConditions = input.int(3, "Trend Min Conditions", minval=1, maxval=5)

// Asia settings
asiaRSIHigh  = input.int(65, "Asia RSI Sell Level")
asiaRSILow   = input.int(35, "Asia RSI Buy Level")

// ===== SESSION =====
hourUTC = hour(time, "UTC")

asia    = hourUTC >= 0 and hourUTC < 6
london  = hourUTC >= 7 and hourUTC < 10
newyork = hourUTC >= 13 and hourUTC < 16

isTrendSession = london or newyork
isAsiaSession  = asia

bgcolor(isAsiaSession ? color.new(color.yellow, 92) : na)
bgcolor(isTrendSession ? color.new(color.blue, 92) : na)

// ===== INDICATORS =====
ema50  = ta.ema(close, emaFast)
ema200 = ta.ema(close, emaSlow)
rsiVal = ta.rsi(close, rsiLen)
atrVal = ta.atr(14)

// HTF FILTER
ema50_htf  = request.security(syminfo.tickerid, htfTF, ta.ema(close, emaFast))
ema200_htf = request.security(syminfo.tickerid, htfTF, ta.ema(close, emaSlow))

// ===== TREND LOGIC =====
upTrend   = ema50 > ema200
downTrend = ema50 < ema200

htfUp   = ema50_htf > ema200_htf
htfDown = ema50_htf < ema200_htf

finalUp   = useHTF ? (upTrend and htfUp) : upTrend
finalDown = useHTF ? (downTrend and htfDown) : downTrend

// ===== TREND ENTRY =====
prevLow  = ta.lowest(low, 10)[1]
prevHigh = ta.highest(high, 10)[1]

sweepLow  = low < prevLow
sweepHigh = high > prevHigh

pullbackBuy  = close < ema50
pullbackSell = close > ema50

rsiBuy  = rsiVal > 50
rsiSell = rsiVal < 50

bull = close > open
bear = close < open

candleBuy  = useCandle ? bull : true
candleSell = useCandle ? bear : true

buyCount =
     (finalUp ? 1 : 0) +
     (sweepLow ? 1 : 0) +
     (rsiBuy ? 1 : 0) +
     (pullbackBuy ? 1 : 0) +
     (candleBuy ? 1 : 0)

sellCount =
     (finalDown ? 1 : 0) +
     (sweepHigh ? 1 : 0) +
     (rsiSell ? 1 : 0) +
     (pullbackSell ? 1 : 0) +
     (candleSell ? 1 : 0)

trendBuy  = buyCount >= minConditions
trendSell = sellCount >= minConditions

// ===== FIXED ASIA RANGE =====
var float asiaHigh = na
var float asiaLow  = na

newAsiaSession = isAsiaSession and not isAsiaSession[1]

if newAsiaSession
    asiaHigh := high
    asiaLow  := low
else if isAsiaSession
    asiaHigh := math.max(asiaHigh, high)
    asiaLow  := math.min(asiaLow, low)

// Range reactions
nearLow  = close <= asiaLow + (atrVal * 0.2)
nearHigh = close >= asiaHigh - (atrVal * 0.2)

asiaBuy  = nearLow and rsiVal < asiaRSILow
asiaSell = nearHigh and rsiVal > asiaRSIHigh

// ===== ✅ CLEAN SIGNAL SYSTEM =====
buySignal =
     (isTrendSession and trendBuy) or
     (isAsiaSession and asiaBuy)

sellSignal =
     (isTrendSession and trendSell) or
     (isAsiaSession and asiaSell)

// Prevent overtrading
noPosition = strategy.position_size == 0

// ===== SL / TP =====
longSL  = useATR ? close - atrVal * atrMult : close - 0.001
longTP  = close + (close - longSL) * rr

shortSL = useATR ? close + atrVal * atrMult : close + 0.001
shortTP = close - (shortSL - close) * rr

// ===== EXECUTION =====
if buySignal and noPosition
    strategy.entry("BUY", strategy.long)
    strategy.exit("BUY EXIT", from_entry="BUY", stop=longSL, limit=longTP)

if sellSignal and noPosition
    strategy.entry("SELL", strategy.short)
    strategy.exit("SELL EXIT", from_entry="SELL", stop=shortSL, limit=shortTP)

// ===== VISUALS =====
plot(ema50, "EMA 50", color=color.blue)
plot(ema200, "EMA 200", color=color.red)

plot(asiaHigh, "Asia High", color=color.orange)
plot(asiaLow, "Asia Low", color=color.orange)

plotshape(buySignal,  location=location.belowbar, color=color.green, style=shape.labelup, text="BUY")
plotshape(sellSignal, location=location.abovebar, color=color.red, style=shape.labeldown, text="SELL")

// ===== ALERTS =====
alertcondition(buySignal, "BUY", "Buy signal")
alertcondition(sellSignal, "SELL", "Sell signal")