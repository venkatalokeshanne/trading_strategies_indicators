//@version=6
indicator("MTF EMA 50 Ribbon - NON REPAINT", overlay=true)

//====================================================
// SETTINGS
//====================================================
emaLength = 50

//====================================================
// TIMEFRAME ON/OFF
//====================================================
showM15 = input.bool(true,  "M15 EMA 50")
showH1  = input.bool(true,  "H1 EMA 50")
showH4  = input.bool(true,  "H4 EMA 50")
showD1  = input.bool(true,  "D1 EMA 50")

showM30 = input.bool(true,  "M30 EMA 50")
showM45 = input.bool(true,  "M45 EMA 50")
showH2  = input.bool(true,  "H2 EMA 50")
showH8  = input.bool(true,  "H8 EMA 50")
showH12 = input.bool(true,  "H12 EMA 50")

//====================================================
// NON-REPAINT MTF EMA 50
// [1] = előző, már lezárt HTF gyertya
// lookahead_on = mindig a megerősített értéket használja
//====================================================

emaM15 = request.security(
     syminfo.tickerid, "15",
     ta.ema(close, emaLength)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

emaH1 = request.security(
     syminfo.tickerid, "60",
     ta.ema(close, emaLength)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

emaH4 = request.security(
     syminfo.tickerid, "240",
     ta.ema(close, emaLength)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

emaD1 = request.security(
     syminfo.tickerid, "D",
     ta.ema(close, emaLength)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

emaM30 = request.security(
     syminfo.tickerid, "30",
     ta.ema(close, emaLength)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

emaM45 = request.security(
     syminfo.tickerid, "45",
     ta.ema(close, emaLength)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

emaH2 = request.security(
     syminfo.tickerid, "120",
     ta.ema(close, emaLength)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

emaH8 = request.security(
     syminfo.tickerid, "480",
     ta.ema(close, emaLength)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

emaH12 = request.security(
     syminfo.tickerid, "720",
     ta.ema(close, emaLength)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

//====================================================
// PLOTS
// ORIGINAL 4 = THICK
// NEW 5 = THIN
//====================================================

plot(showM15 ? emaM15 : na,
     title="M15 EMA 50",
     color=color.black,
     linewidth=3)

plot(showH1 ? emaH1 : na,
     title="H1 EMA 50",
     color=color.red,
     linewidth=3)

plot(showH4 ? emaH4 : na,
     title="H4 EMA 50",
     color=color.orange,
     linewidth=3)

plot(showD1 ? emaD1 : na,
     title="D1 EMA 50",
     color=color.green,
     linewidth=3)

// NEW TIMEFRAMES

plot(showM30 ? emaM30 : na,
     title="M30 EMA 50",
     color=color.blue,
     linewidth=1)

plot(showM45 ? emaM45 : na,
     title="M45 EMA 50",
     color=color.purple,
     linewidth=1)

plot(showH2 ? emaH2 : na,
     title="H2 EMA 50",
     color=color.fuchsia,
     linewidth=1)

plot(showH8 ? emaH8 : na,
     title="H8 EMA 50",
     color=color.aqua,
     linewidth=1)

plot(showH12 ? emaH12 : na,
     title="H12 EMA 50",
     color=color.yellow,
     linewidth=1)

//====================================================
// PRICE TOUCH
// A gyertya teljes HIGH-LOW tartománya érinti az EMA-t
//====================================================

touchM15 = showM15 and high >= emaM15 and low <= emaM15
touchH1  = showH1  and high >= emaH1  and low <= emaH1
touchH4  = showH4  and high >= emaH4  and low <= emaH4
touchD1  = showD1  and high >= emaD1  and low <= emaD1

touchM30 = showM30 and high >= emaM30 and low <= emaM30
touchM45 = showM45 and high >= emaM45 and low <= emaM45
touchH2  = showH2  and high >= emaH2  and low <= emaH2
touchH8  = showH8  and high >= emaH8  and low <= emaH8
touchH12 = showH12 and high >= emaH12 and low <= emaH12

//====================================================
// ALERT MESSAGE
//====================================================

if barstate.isrealtime
    string message = ""

    if touchM15
        message += "M15 EMA 50"

    if touchH1
        message += message == "" ? "H1 EMA 50" : " + H1 EMA 50"

    if touchH4
        message += message == "" ? "H4 EMA 50" : " + H4 EMA 50"

    if touchD1
        message += message == "" ? "D1 EMA 50" : " + D1 EMA 50"

    if touchM30
        message += message == "" ? "M30 EMA 50" : " + M30 EMA 50"

    if touchM45
        message += message == "" ? "M45 EMA 50" : " + M45 EMA 50"

    if touchH2
        message += message == "" ? "H2 EMA 50" : " + H2 EMA 50"

    if touchH8
        message += message == "" ? "H8 EMA 50" : " + H8 EMA 50"

    if touchH12
        message += message == "" ? "H12 EMA 50" : " + H12 EMA 50"

    if message != ""
        alert("PRICE TOUCHED: " + message, alert.freq_once_per_bar)

//====================================================
// INDIVIDUAL ALERT CONDITIONS
//====================================================

alertcondition(
     touchM15,
     title="M15 EMA 50 Touch",
     message="Price touched M15 EMA 50")

alertcondition(
     touchH1,
     title="H1 EMA 50 Touch",
     message="Price touched H1 EMA 50")

alertcondition(
     touchH4,
     title="H4 EMA 50 Touch",
     message="Price touched H4 EMA 50")

alertcondition(
     touchD1,
     title="D1 EMA 50 Touch",
     message="Price touched D1 EMA 50")

alertcondition(
     touchM30,
     title="M30 EMA 50 Touch",
     message="Price touched M30 EMA 50")

alertcondition(
     touchM45,
     title="M45 EMA 50 Touch",
     message="Price touched M45 EMA 50")

alertcondition(
     touchH2,
     title="H2 EMA 50 Touch",
     message="Price touched H2 EMA 50")

alertcondition(
     touchH8,
     title="H8 EMA 50 Touch",
     message="Price touched H8 EMA 50")

alertcondition(
     touchH12,
     title="H12 EMA 50 Touch",
     message="Price touched H12 EMA 50")

//====================================================
// ANY ACTIVE EMA 50 TOUCH
//====================================================

anyTouch =
     touchM15 or
     touchH1 or
     touchH4 or
     touchD1 or
     touchM30 or
     touchM45 or
     touchH2 or
     touchH8 or
     touchH12

alertcondition(
     anyTouch,
     title="ANY ACTIVE EMA 50 Touch",
     message="Price touched one or more active MTF EMA 50 levels")