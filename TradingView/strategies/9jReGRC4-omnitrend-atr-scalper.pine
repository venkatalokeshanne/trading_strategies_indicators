//@version=6
strategy("OmniTrend ATR Scalper", overlay = true, initial_capital = 5000, currency = currency.USD, default_qty_type = strategy.cash, default_qty_value = 250, commission_type = strategy.commission.percent, commission_value = 0.04)

// --- Settings ---
string trade_dir = input.string("Both", "Trades", options = ["Both", "Long Only", "Short Only"])
int    len_fast  = input.int(5, "Fast Step Period")
int    len_slow  = input.int(10, "Slow Step Period")
int    len_atr   = input.int(200, "ATR Period")
float mult_step  = input.float(1.0, "Step Multiplier")
float mult_rev   = input.float(2.0, "Reverse Multiplier")
float sl_mult    = input.float(2.0, "Stop Loss Multiplier")
float tp_mult    = input.float(3.0, "Take Profit Multiplier")

// --- Engine ---
float v_atr = ta.atr(len_atr)
var float t_line = close
var int t_dir = 1
var float t_step = 0.0
var bool is_fast = false

bool sig_l = false
bool sig_s = false

if not na(v_atr)
    float d = close - t_line
    sig_l := t_dir == -1 and d > mult_rev * v_atr
    sig_s := t_dir == 1 and -d > mult_rev * v_atr
    if sig_l
        t_dir := 1
    else if sig_s
        t_dir := -1
    bool s_chk = math.abs(d) > mult_step * v_atr
    if sig_l or sig_s or (s_chk != is_fast) or t_step == 0.0
        is_fast := s_chk
        t_step := is_fast ? v_atr / len_fast : v_atr / len_slow
    t_line := t_line + (t_dir * t_step)

// --- Trade Logic ---
var float sl = na
var float tp = na
bool c_l = (trade_dir == "Both" or trade_dir == "Long Only")
bool c_s = (trade_dir == "Both" or trade_dir == "Short Only")

if sig_l
    sl := close - (v_atr * sl_mult)
    tp := close + (v_atr * tp_mult)
    if c_l
        strategy.entry("L", strategy.long)
    else
        strategy.close("S")
if sig_s
    sl := close + (v_atr * sl_mult)
    tp := close - (v_atr * tp_mult)
    if c_s
        strategy.entry("S", strategy.short)
    else
        strategy.close("L")
        
strategy.exit("Ex", stop=sl, limit=tp)

// --- STATISTICS (HARD RENDER) ---
var int l_w = 0, var int l_t = 0
var int s_w = 0, var int s_t = 0

if strategy.closedtrades > strategy.closedtrades[1]
    bool win = strategy.closedtrades.profit(strategy.closedtrades - 1) > 0
    bool lon = strategy.closedtrades.size(strategy.closedtrades - 1) > 0
    if lon
        l_t += 1
        if win
            l_w += 1
    else
        s_t += 1
        if win
            s_w += 1

// TABLE WITHOUT CONDITIONS (ALWAYS SHOWS)
float wr_l = l_t > 0 ? (float(l_w) / l_t) * 100 : 0
float wr_s = s_t > 0 ? (float(s_w) / s_t) * 100 : 0
float wr_all = strategy.closedtrades > 0 ? (float(l_w + s_w) / strategy.closedtrades) * 100 : 0

table dash = table.new(position.middle_right, 2, 4, bgcolor=color.new(color.black, 0), border_width=2, border_color=color.gray)
table.cell(dash, 0, 0, "SIDE", text_color=color.white, bgcolor=color.gray)
table.cell(dash, 1, 0, "WINRATE", text_color=color.white, bgcolor=color.gray)
table.cell(dash, 0, 1, "LONG (" + str.tostring(l_t) + ")", text_color=#00f2ff, text_halign=text.align_left)
table.cell(dash, 1, 1, str.tostring(wr_l, "#.##") + "%", text_color=color.white)
table.cell(dash, 0, 2, "SHORT (" + str.tostring(s_t) + ")", text_color=#ff00ff, text_halign=text.align_left)
table.cell(dash, 1, 2, str.tostring(wr_s, "#.##") + "%", text_color=color.white)
table.cell(dash, 0, 3, "TOTAL", text_color=color.yellow, text_halign=text.align_left)
table.cell(dash, 1, 3, str.tostring(wr_all, "#.##") + "%", text_color=color.white)

// --- Visuals ---
plot(t_line, "Trend", color=t_dir == 1 ? #00f2ff : #ff00ff, linewidth=3)