//@version=6
indicator("Sagar Volume", overlay=false)

// Inputs
ma1Length = input.int(20, "Volume MA 1", minval=1)
ma2Length = input.int(50, "Volume MA 2", minval=1)

// Manually build the continuous futures symbol string (e.g., "BINANCE:BTCUSD" + "1!" = "BINANCE:BTCUSD1!")
futuresSymbolString = syminfo.prefix + ":" + syminfo.ticker + "1!"

// Request the volume from the constructed futures ticker
futuresVolume = request.security(futuresSymbolString, timeframe.period, volume)

// Plot Futures Volume
plot(futuresVolume, title="Futures Volume", style=plot.style_columns, color=color.black)

// Calculate Moving Averages based on Futures Volume
volMA1 = ta.ema(futuresVolume, ma1Length)
volMA2 = ta.ema(futuresVolume, ma2Length)

// Plot MAs
plot(volMA1, title="Volume EMA 20", linewidth=1, color=color.white)
plot(volMA2, title="Volume EMA 50", linewidth=2, color=color.white)
