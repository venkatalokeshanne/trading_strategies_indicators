// ═══════════════════════════════════════════════════════════════
// SMT AUTO-DETECTION
// ═══════════════════════════════════════════════════════════════

f_autoSMT(t) =>
    string b = ""
    string c = ""
    if t == "MNQ1!"
        b := "MES1!"
        c := "MYM1!"
    else if t == "MES1!"
        b := "MNQ1!"
        c := "MYM1!"
    else if t == "MYM1!"
        b := "MES1!"
        c := "MNQ1!"
    else if t == "M2K1!"
        b := "MES1!"
        c := "MNQ1!"
    else if t == "MGC1!"
        b := "SIL1!"
        c := ""
    else if t == "SIL1!"
        b := "MGC1!"
        c := ""
    else if t == "NQ1!"
        b := "ES1!"
        c := "YM1!"
    else if t == "ES1!"
        b := "NQ1!"
        c := "YM1!"
    else if t == "YM1!"
        b := "ES1!"
        c := "NQ1!"
    else if t == "RTY1!"
        b := "ES1!"
        c := "NQ1!"
    else if t == "GC1!"
        b := "SI1!"
        c := ""
    else if t == "SI1!"
        b := "GC1!"
        c := ""
    [b, c]

[auto_b, auto_c] = f_autoSMT(syminfo.ticker)
smt_sym  = smt_enable  ? (smt_auto  and auto_b != "" ? auto_b : smt_symbol)  : ""
smt2_sym = smt2_enable ? (smt_auto  and auto_c != "" ? auto_c : smt2_symbol) : ""

// ═══════════════════════════════════════════════════════════════
// SECTION 2: TYPES
// ═══════════════════════════════════════════════════════════════

type SessionLiq
    float high
    float low
    int   start_idx
    int   high_idx
    int   low_idx
    bool  was_in_session
    bool  high_swept
    bool  low_swept
    bool  in_session        // aktuell aktiv?
    line  high_line_ref
    line  low_line_ref
    label high_label_ref
    label low_label_ref

type FVG
    float  top
    float  bottom
    int    bar_formed
    int    origin_time
    bool   is_bullish
    bool   mitigated
    bool   is_htf
    string tf_name
    int    tf_secs      // Sekunden des HTF (0 für LTF); für Transparenz-Berechnung
    bool   hidden         // durch Nearest-Filter versteckt
    bool   hidden_overlap // durch Overlap-Filter versteckt (separater Grund)
    int    t_left
    int    t_right
    box    box_ref
    line   midline_ref
    label  label_ref


