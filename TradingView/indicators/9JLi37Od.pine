//@version=6
indicator("Trendline Breakout Lite", shorttitle="Trendline Lite", overlay=true, max_lines_count=10, max_labels_count=300)

// TRENDLINE SETTINGS
groupTrend = "1. Trendlines"

pivotLen = input.int(
     5,
     "Pivot length",
     minval=2,
     maxval=20,
     group=groupTrend)

confirmClose = input.bool(
     true,
     "Confirm at candle close",
     group=groupTrend)

cooldownBars = input.int(
     8,
     "Bars between signals",
     minval=0,
     maxval=100,
     group=groupTrend)

// DIRECTION FILTER
groupBias = "2. Direction filter"

useAutoBias = input.bool(
     true,
     "Automatic bias timeframe",
     group=groupBias)

manualBiasTf = input.timeframe(
     "60",
     "Manual bias timeframe",
     group=groupBias)

useBias = input.bool(
     true,
     "Use direction filter",
     group=groupBias)

emaFastLen = input.int(
     20,
     "Fast EMA",
     minval=2,
     group=groupBias)

emaSlowLen = input.int(
     50,
     "Slow EMA",
     minval=5,
     group=groupBias)

// M1-M5 uses H1.
// M15 uses H4.
// M30-H1 uses H4.
// H4 and higher use Daily.
autoBiasTf = timeframe.isminutes and timeframe.multiplier <= 5 ? "60" : timeframe.isminutes and timeframe.multiplier <= 15 ? "240" : timeframe.isminutes and timeframe.multiplier <= 60 ? "240" : "D"

biasTf = useAutoBias ? autoBiasTf : manualBiasTf

// ENTRY AND TARGETS
groupRisk = "3. Entry and targets"

atrLen = input.int(
     14,
     "ATR length",
     minval=2,
     group=groupRisk)

slAtrBuffer = input.float(
     0.20,
     "Stop ATR buffer",
     minval=0.0,
     step=0.05,
     group=groupRisk)

tp1R = input.float(
     1.0,
     "TP1 R",
     minval=0.25,
     step=0.25,
     group=groupRisk)

tp2R = input.float(
     2.0,
     "TP2 R",
     minval=0.50,
     step=0.25,
     group=groupRisk)

tp3R = input.float(
     3.0,
     "TP3 R",
     minval=0.75,
     step=0.25,
     group=groupRisk)

// HIGHER TIMEFRAME DIRECTION
htfFast = request.security(
     syminfo.tickerid,
     biasTf,
     ta.ema(close, emaFastLen)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

htfSlow = request.security(
     syminfo.tickerid,
     biasTf,
     ta.ema(close, emaSlowLen)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

htfClose = request.security(
     syminfo.tickerid,
     biasTf,
     close[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

bullBias = htfFast > htfSlow and htfClose >= htfFast

bearBias = htfFast < htfSlow and htfClose <= htfFast

// ATR
atr = ta.atr(atrLen)

// PIVOT HIGHS AND LOWS
ph = ta.pivothigh(
     high,
     pivotLen,
     pivotLen)

pl = ta.pivotlow(
     low,
     pivotLen,
     pivotLen)

// LAST TWO PIVOT HIGHS
var int highX1 = na
var int highX2 = na

var float highY1 = na
var float highY2 = na

// LAST TWO PIVOT LOWS
var int lowX1 = na
var int lowX2 = na

var float lowY1 = na
var float lowY2 = na

// SAVE PIVOT HIGH
if not na(ph)
    highX1 := highX2
    highY1 := highY2

    highX2 := bar_index - pivotLen
    highY2 := ph

// SAVE PIVOT LOW
if not na(pl)
    lowX1 := lowX2
    lowY1 := lowY2

    lowX2 := bar_index - pivotLen
    lowY2 := pl

// TRENDLINES
var line sellLine = na
var line buyLine = na

// RED TRENDLINE ON HIGHS
if not na(highX1) and not na(highX2)
    if na(sellLine)
        sellLine := line.new(
             highX1,
             highY1,
             highX2,
             highY2,
             xloc=xloc.bar_index,
             extend=extend.right,
             color=color.red,
             width=2)
    else
        line.set_xy1(
             sellLine,
             highX1,
             highY1)

        line.set_xy2(
             sellLine,
             highX2,
             highY2)

        line.set_extend(
             sellLine,
             extend.right)

// GREEN TRENDLINE ON LOWS
if not na(lowX1) and not na(lowX2)
    if na(buyLine)
        buyLine := line.new(
             lowX1,
             lowY1,
             lowX2,
             lowY2,
             xloc=xloc.bar_index,
             extend=extend.right,
             color=color.lime,
             width=2)
    else
        line.set_xy1(
             buyLine,
             lowX1,
             lowY1)

        line.set_xy2(
             buyLine,
             lowX2,
             lowY2)

        line.set_extend(
             buyLine,
             extend.right)

// CURRENT TRENDLINE PRICES
sellLinePrice = not na(sellLine) ? line.get_price(sellLine, bar_index) : na

buyLinePrice = not na(buyLine) ? line.get_price(buyLine, bar_index) : na

// SIGNAL CONFIRMATION
barOk = not confirmClose or barstate.isconfirmed

var int lastSignalBar = na

cooldownOk = na(lastSignalBar) or bar_index - lastSignalBar > cooldownBars

// BUY:
// Price breaks above the red resistance trendline.
rawBuy = not na(sellLinePrice) and ta.crossover(close, sellLinePrice)

// SELL:
// Price breaks below the green support trendline.
rawSell = not na(buyLinePrice) and ta.crossunder(close, buyLinePrice)

// FINAL BUY AND SELL
buySignal = rawBuy and (not useBias or bullBias) and barOk and cooldownOk

sellSignal = rawSell and (not useBias or bearBias) and barOk and cooldownOk

// ENTRY, STOP LOSS AND TARGETS
var float entryPrice = na
var float stopPrice = na

var float tp1Price = na
var float tp2Price = na
var float tp3Price = na

var int direction = 0

// BUY LEVELS
if buySignal
    entryPrice := close

    stopPrice := nz(
         ta.lowest(
             low,
             pivotLen + 1),
         low) - atr * slAtrBuffer

    buyRisk = math.max(
         entryPrice - stopPrice,
         syminfo.mintick)

    tp1Price := entryPrice + buyRisk * tp1R
    tp2Price := entryPrice + buyRisk * tp2R
    tp3Price := entryPrice + buyRisk * tp3R

    direction := 1
    lastSignalBar := bar_index

// SELL LEVELS
if sellSignal
    entryPrice := close

    stopPrice := nz(
         ta.highest(
             high,
             pivotLen + 1),
         high) + atr * slAtrBuffer

    sellRisk = math.max(
         stopPrice - entryPrice,
         syminfo.mintick)

    tp1Price := entryPrice - sellRisk * tp1R
    tp2Price := entryPrice - sellRisk * tp2R
    tp3Price := entryPrice - sellRisk * tp3R

    direction := -1
    lastSignalBar := bar_index

// BUY AND SELL LABELS
plotshape(
     buySignal,
     title="Trendline BUY",
     text="BUY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.lime,
     textcolor=color.black,
     size=size.small)

plotshape(
     sellSignal,
     title="Trendline SELL",
     text="SELL",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     textcolor=color.white,
     size=size.small)

// ALERTS
alertcondition(
     buySignal,
     "Trendline BUY",
     "Trendline BUY {{ticker}} {{interval}} at {{close}}")

alertcondition(
     sellSignal,
     "Trendline SELL",
     "Trendline SELL {{ticker}} {{interval}} at {{close}}")

// PRICE FORMAT
priceText(value) =>
    na(value) ? "-" : str.tostring(value, format.mintick)

// DIRECTION
directionText = direction == 1 and bullBias ? "BULLISH" : direction == -1 and bearBias ? "BEARISH" : bullBias ? "BULLISH" : bearBias ? "BEARISH" : "NEUTRAL"

// DASHBOARD
var table dashboard = table.new(
     position.top_right,
     2,
     12,
     border_width=1)

if barstate.islast
    table.cell(
         dashboard,
         0,
         0,
         "TRENDLINE",
         bgcolor=color.black,
         text_color=color.white)

    table.cell(
         dashboard,
         1,
         0,
         "LITE",
         bgcolor=color.black,
         text_color=color.yellow)

    table.cell(dashboard, 0, 1, "Chart TF")
    table.cell(dashboard, 1, 1, timeframe.period)

    table.cell(dashboard, 0, 2, "Bias TF")
    table.cell(dashboard, 1, 2, biasTf)

    table.cell(dashboard, 0, 3, "Direction")

    table.cell(
         dashboard,
         1,
         3,
         directionText,
         text_color=directionText == "BULLISH" ? color.lime : directionText == "BEARISH" ? color.red : color.orange)

    table.cell(dashboard, 0, 4, "Signal")

    table.cell(
         dashboard,
         1,
         4,
         direction == 1 ? "BUY" : direction == -1 ? "SELL" : "WAIT",
         text_color=direction == 1 ? color.lime : direction == -1 ? color.red : color.orange)

    table.cell(
         dashboard,
         0,
         5,
         "ENTRY",
         text_color=color.yellow)

    table.cell(
         dashboard,
         1,
         5,
         priceText(entryPrice),
         text_color=color.yellow)

    table.cell(
         dashboard,
         0,
         6,
         "STOP LOSS",
         text_color=color.red)

    table.cell(
         dashboard,
         1,
         6,
         priceText(stopPrice),
         text_color=color.red)

    table.cell(
         dashboard,
         0,
         7,
         "TP1",
         text_color=color.aqua)

    table.cell(
         dashboard,
         1,
         7,
         priceText(tp1Price),
         text_color=color.aqua)

    table.cell(
         dashboard,
         0,
         8,
         "TP2",
         text_color=color.lime)

    table.cell(
         dashboard,
         1,
         8,
         priceText(tp2Price),
         text_color=color.lime)

    table.cell(
         dashboard,
         0,
         9,
         "TP3",
         text_color=color.fuchsia)

    table.cell(
         dashboard,
         1,
         9,
         priceText(tp3Price),
         text_color=color.fuchsia)

    table.cell(dashboard, 0, 10, "Red line")
    table.cell(dashboard, 1, 10, "BUY BREAK")

    table.cell(dashboard, 0, 11, "Green line")
    table.cell(dashboard, 1, 11, "SELL BREAK")