//@version=5
strategy("Top & Bottom Hunter Pro",
     overlay=true,
     pyramiding=999,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=20,
     initial_capital=5000)

//=============================
// INPUTS
//=============================
groupFib = "Fibonacci Settings"
fib_0 = input.float(0.382, "Fib Level 0.382", group=groupFib)
fib_1 = input.float(0.618, "Fib Level 0.618", group=groupFib)

groupRSI = "RSI Settings"
rsi_length = input.int(14, "RSI Length", group=groupRSI)
rsi_overbought = input.int(70, "RSI Overbought", group=groupRSI)
rsi_oversold = input.int(30, "RSI Oversold", group=groupRSI)

groupRisk = "Position Settings"
position_size_pct = input.float(20.0, "Position Size %", minval=1, maxval=100, step=1, group=groupRisk)

groupSession = "Trading Sessions"
session1 = input.session("1000-1130", "Session 1", group=groupSession)
session2 = input.session("1330-1510", "Session 2", group=groupSession)
show_session_bg = input.bool(true, "Highlight Sessions", group=groupSession)

groupVisual = "Visual Settings"
show_signals = input.bool(true, "Show Buy/Sell Labels", group=groupVisual)
show_bar_colors = input.bool(true, "Color Bars", group=groupVisual)
show_table = input.bool(true, "Show Status Table", group=groupVisual)

//=============================
// CALCULATIONS
//=============================
hh = ta.highest(high, 2)
ll = ta.lowest(low, 2)
fib_range = hh - ll

fib_level_0 = hh - fib_range * fib_0
fib_level_1 = hh - fib_range * fib_1

rsi_value = ta.rsi(close, rsi_length)

inSession1 = not na(time(timeframe.period, session1))
inSession2 = not na(time(timeframe.period, session2))
inTradingTime = inSession1 or inSession2

buy_condition = ta.crossover(rsi_value, rsi_oversold) and close > fib_level_1 and inTradingTime
sell_condition = ta.crossunder(rsi_value, rsi_overbought) and close < fib_level_0 and inTradingTime

//=============================
// STRATEGY
//=============================
if buy_condition
    strategy.entry("Buy", strategy.long, qty=position_size_pct)

if sell_condition
    strategy.close_all(comment="Sell signal")

//=============================
// COLORS
//=============================
bullColor = color.rgb(0, 200, 140)
bearColor = color.rgb(255, 82, 82)
neutralColor = color.rgb(130, 130, 150)
fibGreen = color.rgb(46, 204, 113)
fibRed = color.rgb(231, 76, 60)
sessionColor = color.new(color.aqua, 90)

bar_col = close > fib_level_1 ? color.new(bullColor, 0) : close < fib_level_0 ? color.new(bearColor, 0) : color.new(neutralColor, 50)

barcolor(show_bar_colors ? bar_col : na)
bgcolor(show_session_bg and inTradingTime ? sessionColor : na)

//=============================
// PLOTS
//=============================
plot(fib_level_0, title="Fib 0.382", color=fibRed, linewidth=2)
plot(fib_level_1, title="Fib 0.618", color=fibGreen, linewidth=2)

//=============================
// SIGNALS
//=============================
plotshape(show_signals and buy_condition, title="Buy Label", style=shape.labelup, location=location.belowbar, color=bullColor, text="BUY", textcolor=color.white, size=size.small)
plotshape(show_signals and sell_condition, title="Sell Label", style=shape.labeldown, location=location.abovebar, color=bearColor, text="SELL", textcolor=color.white, size=size.small)

plotshape(buy_condition, title="Buy Arrow", style=shape.triangleup, location=location.belowbar, color=bullColor, size=size.tiny)
plotshape(sell_condition, title="Sell Arrow", style=shape.triangledown, location=location.abovebar, color=bearColor, size=size.tiny)

//=============================
// ALERTS
//=============================
alertcondition(buy_condition, title="Buy Alert", message="Top & Bottom Hunter Pro BUY on {{ticker}} at {{close}}")
alertcondition(sell_condition, title="Sell Alert", message="Top & Bottom Hunter Pro SELL on {{ticker}} at {{close}}")

//=============================
// STATUS TABLE
//=============================
var table statusTable = table.new(position.top_right, 2, 5, border_width=1)

if barstate.islast
    if show_table
        table.cell(statusTable, 0, 0, "Top & Bottom", text_color=color.white, bgcolor=color.rgb(30, 30, 45))
        table.cell(statusTable, 1, 0, "PRO", text_color=color.white, bgcolor=color.rgb(0, 120, 255))

        table.cell(statusTable, 0, 1, "RSI", text_color=color.white, bgcolor=color.rgb(40, 40, 55))
        table.cell(statusTable, 1, 1, str.tostring(rsi_value, "#.##"), text_color=color.white, bgcolor=color.rgb(25, 25, 35))

        table.cell(statusTable, 0, 2, "Session", text_color=color.white, bgcolor=color.rgb(40, 40, 55))
        table.cell(statusTable, 1, 2, inTradingTime ? "ACTIVE" : "OFF", text_color=color.white, bgcolor=inTradingTime ? color.new(bullColor, 0) : color.new(bearColor, 0))

        biasText = close > fib_level_1 ? "BULLISH" : close < fib_level_0 ? "BEARISH" : "NEUTRAL"
        biasBg = close > fib_level_1 ? color.new(bullColor, 0) : close < fib_level_0 ? color.new(bearColor, 0) : color.new(neutralColor, 0)
        table.cell(statusTable, 0, 3, "Bias", text_color=color.white, bgcolor=color.rgb(40, 40, 55))
        table.cell(statusTable, 1, 3, biasText, text_color=color.white, bgcolor=biasBg)

        table.cell(statusTable, 0, 4, "Fib 0.618", text_color=color.white, bgcolor=color.rgb(40, 40, 55))
        table.cell(statusTable, 1, 4, str.tostring(fib_level_1), text_color=color.white, bgcolor=color.rgb(25, 25, 35))