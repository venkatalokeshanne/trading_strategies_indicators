import TradingView/ta/12
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © lahonglam
// ATR Trend Strategy with Moving Average
// Combines a Moving Average trend filter with ATR-based breakout signals to identify directional trends.
//
// Features an adaptive TP/SL system based on trend distribution:
// - Take Profit uses the 70th percentile of Maximum Favorable Excursion (MFE)
// - Stop Loss uses the 70th percentile of Maximum Adverse Excursion (MAE)
//
// Includes built-in trend analytics:
// - MFE, MAE, Efficiency, and Volatility tracking
// - Percentile-based distribution (P50 / P70 / P90)
//
// Supports two entry methods:
// - Breakout confirmation
// - Pullback entry via MA cross
//
// Designed as a data-driven, adaptive trend-following strategy
// for backtesting and statistical analysis across different markets and timeframes.
//@version=6
strategy(
    title = "ATR Trend Strategy with Moving Average | Fixed TP/SL version",
    shorttitle = "ATR MA Strategy | Fixed TP/SL",
    overlay = true,
    initial_capital = 10000,
    currency = currency.USD,
    default_qty_type = strategy.percent_of_equity,
    default_qty_value = 10,
    commission_type = strategy.commission.percent,
    commission_value = 0.04,
    slippage = 2,
    pyramiding = 0,
    calc_on_order_fills = false,
    calc_on_every_tick = false
    )
// ===========================
// GROUP
// ===========================
MA = "Moving Average"
ATR = "ATR Signal"
Thresh = "Threshold (%)"
BarsConf = "Number Bars Confirmed"
// ===========================
// MA Input
// ===========================
MAtype = input.string(
    defval = "EMA",
    title = "MA Type",
    options = ["EMA", "SMA", "WMA", "Hull MA", "VWMA", "RMA", "TEMA"],
    group = MA,
    display = display.none
    )
MAlen = input.int(
    defval = 100,
    title = "MA Length",
    group = MA,
    display = display.none
    )
MAsrc = input.source(
    defval = close,
    title = "MA Source",
    group = MA,
    display = display.none
    )
// ===========================
// ATR Input
// ===========================
ATRtype = input.string(
    defval = "RMA",
    title = "ATR Type",
    group = ATR,
    options = ["EMA", "SMA", "WMA", "RMA"],
    display = display.none
    )
ATRmult = input.float(
    defval = 3,
    title = "ATR Multiplier",
    tooltip = "Multiplier applied to ATR to define the distance of trend bands or signal thresholds. Higher values require stronger price movement to confirm trends, reducing noise but delaying signals.",
    minval = 0.1,
    step = 0.1,
    group = ATR,
    display = display.none
    )
ATRlen = input.int(
    defval = 7,
    title = "ATR Length",
    tooltip = "Number of bars used to calculate the Average True Range (ATR). Higher values produce smoother, more stable volatility estimates, while lower values make ATR more responsive to recent price changes.",
    group = ATR,
    display = display.none
    )
useAtrFilter = input.bool(
    defval = false,
    title = "Use ATR Filter",
    tooltip = "Enable a volatility filter using ATR. Trades are only allowed when current ATR is above its moving average, helping avoid low-volatility conditions.",
    group = ATR,
    display = display.none
    )
atrFilterLen = input.int(
    defval = 14,
    title = "ATR Filter Length",
    group = ATR,
    display = display.none,
    active = useAtrFilter
    )
// ===========================
// Trend confirmed input
// ===========================
confirmBars = input.int(
    defval = 2,
    title = "Bars Confirmed",
    tooltip = "Number of consecutive bars required outside the ATR band to confirm a trend. Higher values reduce noise but delay signals.",
    minval = 1,
    step = 1,
    group = BarsConf,
    display = display.none
    )
confirmSrc = input.string(
    defval = "Low/high",
    title = "Source Confirmed",
    options = ["Close", "Low/high"],
    group = BarsConf,
    display = display.none
    )
// ===========================
// Threshold(%) input
// ===========================
entryMethod = input.string(
    defval = "Breakout",
    title = "Entry Method",
    options = ["Breakout", "MA Cross"],
    tooltip = "Select entry logic: Breakout enters on trend confirmation, MA Cross enters on pullbacks within the trend.",
    group = Thresh,
    display = display.none
    )
useAutoTP_SL = input.bool(
    true,
    title = "Use Auto TP/SL",
    group = Thresh,
    tooltip = "Automatically sets TP/SL based on trend distribution (Position 70% of MFE, MAE). Disable to use a fixed manual TP/SL value."
    )
TPinput = input.float(
    defval = 5.0,
    title = "TP (%)",
    minval = 0.1,
    step = 0.1,
    group = Thresh,
    display = display.none,
    active = useAutoTP_SL == false
    )
SLinput = input.float(
    defval = 2.0,
    title = "SL (%)",
    minval = 0.1,
    step = 0.1,
    group = Thresh,
    display = display.none,
    active = useAutoTP_SL == false
    )
// ===========================
// MA and ATR value
// ===========================
MAselect(_source, _lockback, _type) =>
    switch _type
        "EMA" => ta.ema(_source, _lockback)
        "SMA" => ta.sma(_source, _lockback)
        "WMA" => ta.wma(_source, _lockback)
        "Hull MA" => ta.hma(_source, _lockback)
        "VWMA" => ta.vwma(_source, _lockback)
        "RMA" => ta.rma(_source, _lockback)
        "TEMA" => ta.tema(_source, _lockback)
MAtmp = MAselect(MAsrc, MAlen, MAtype)
TR = ta.tr(true)
ATRtmp = MAselect(TR, ATRlen, ATRtype)
ATRfilter = ta.sma(TR, atrFilterLen)
float MAval = MAtmp[1]
float ATRval = ATRtmp[1]
ATRupper = MAval + ATRval * ATRmult
ATRlower = MAval - ATRval * ATRmult
plot(MAval, title = "MA Line", color = color.blue, linewidth = 1)
plotATRupper = plot(ATRupper, title = "ATR Upper", color = color.green, linewidth = 1)
plotATRlower = plot(ATRlower, title = "ATR Lower", color = color.red, linewidth = 1)
// ===========================
// Uptrend Downtrend Zone
// ===========================
var int trend       = 0 // trend = 1 (Uptrend) / = -1 (Downtrend)
breakPoint          = 0 //breakPoint = 1 (Long breakout), = -1 (Short Breakout)
uptrendPrice        = confirmSrc == "Close" ? close : high
downtrendPrice      = confirmSrc == "Close" ? close : low
isUptrendRaw        = uptrendPrice > ATRupper
isDowntrendRaw      = downtrendPrice < ATRlower
isUptrendConfirmed      = ta.barssince(not isUptrendRaw) == confirmBars
isDowntrendConfirmed    = ta.barssince(not isDowntrendRaw) == confirmBars
if isUptrendConfirmed and trend != 1
    trend := 1
    breakPoint := 1
if isDowntrendConfirmed and trend != -1
    trend := -1
    breakPoint := -1
uptrendBg   = color.new(color.green, 80)
downtrendBg = color.new(color.red, 80)
NeutralBg   = color.new(color.gray, 80)
fill(
    plotATRupper,
    plotATRlower,
    color = trend == 1 ? uptrendBg : trend == -1 ? downtrendBg : NeutralBg
    )
// ===========================
// Trend Analytics Panel
// ===========================
newUptrend   = trend == 1  and trend[1] != 1
newDowntrend = trend == -1 and trend[1] != -1
endUptrend   = trend[1] == 1  and trend != 1
endDowntrend = trend[1] == -1 and trend != -1
var int trendBars           = 0
var float startTrendPrice   = na
var float highestTrendPrice = na
var float lowestTrendPrice  = na
var float mfe               = na   // Maximum Favorable Excursion
var float mae               = na   // Maximum Adverse Excursion
var int totalTrend          = 0
var int validTrend          = 0
var int validMae            = 0
var float validTrendPct     = na
var float totalMaePct       = 0
var float totalMfePct       = 0
var float avgMaePct         = na
var float avgMfePct         = na
var float totalEfficiency   = 0
var float avgEfficiency     = na
var float totalVolatility   = 0
var float avgVolatility     = na
var float[] mfeArr          = array.new_float()
var float[] maeArr          = array.new_float()
if endUptrend or endDowntrend // end trend
    totalTrend += 1
    isValid = (ATRval / startTrendPrice) * ATRmult
    if mfe / startTrendPrice > 0
        if mfe / startTrendPrice > isValid
            validTrend += 1
        mfePct = mfe / startTrendPrice * 100
        totalMfePct += mfePct
        array.push(mfeArr, mfePct)
    if mae / startTrendPrice > 0
        validMae += 1
        maePct = mae / startTrendPrice * 100
        totalMaePct += maePct
        array.push(maeArr, maePct)
    trendRange = highestTrendPrice - lowestTrendPrice
    efficiency = trendRange > 0 ? (mfe - mae) / trendRange : 0 // trend có “thẳng” không 0.3/0.5/1
    totalEfficiency += efficiency
    volatility = trendRange / startTrendPrice * 100 // trend có đủ biên độ để trade không
    totalVolatility += volatility
if newUptrend or newDowntrend // new trend start
    startTrendPrice     := close
    highestTrendPrice   := close
    lowestTrendPrice    := close
    mfe := 0
    mae := 0
    trendBars := 0
if trend == 1 or trend == -1 // in trend
    trendBars += 1
else
    trendBars := 0
if trendBars > 1
    highestTrendPrice := math.max(highestTrendPrice, high)
    lowestTrendPrice  := math.min(lowestTrendPrice, low)
    if trend == 1
        mfe := highestTrendPrice - startTrendPrice
        mae := startTrendPrice - lowestTrendPrice
    if trend == -1
        mfe := startTrendPrice - lowestTrendPrice
        mae := highestTrendPrice - startTrendPrice
maxSamples = 500
if array.size(mfeArr) > maxSamples
    array.shift(mfeArr)
float[] sortedMfe = array.copy(mfeArr)
array.sort(sortedMfe)
if array.size(maeArr) > maxSamples
    array.shift(maeArr)
float[] sortedMae = array.copy(maeArr)
array.sort(sortedMae)
f_percentile(arr, p) =>
    size = array.size(arr)
    if size == 0
        na
    else
        idx = (size - 1) * p
        lower = math.floor(idx)
        upper = math.ceil(idx)
        lowerVal = array.get(arr, lower)
        upperVal = array.get(arr, upper)
        lowerVal + (upperVal - lowerVal) * (idx - lower)
mfeP50 = f_percentile(sortedMfe, 0.5)
mfeP70 = f_percentile(sortedMfe, 0.7)
mfeP90 = f_percentile(sortedMfe, 0.9)
maeP50 = f_percentile(sortedMae, 0.5)
maeP70 = f_percentile(sortedMae, 0.7)
maeP90 = f_percentile(sortedMae, 0.9)
plot(avgMfePct, "Avg MFE", display = display.data_window)
plot(mfeP50, "MFE Position 50%", display = display.data_window)
plot(mfeP70, "MFE Position 70%", display = display.data_window)
plot(mfeP90, "MFE Position 90%", display = display.data_window)
plot(avgMaePct, "Avg MAE", display = display.data_window)
plot(maeP50, "MAE Position 50%", display = display.data_window)
plot(maeP70, "MAE Position 70%", display = display.data_window)
plot(maeP90, "MAE Position 90%", display = display.data_window)
plot(avgEfficiency, "Efficiency", display = display.data_window)
plot(avgVolatility, "Volatility", display = display.data_window)
validTrendPct := validTrend / totalTrend * 100
avgMaePct := validMae > 0 ? totalMaePct / validMae : na
avgMfePct := validTrend > 0 ? totalMfePct / validTrend : na
avgEfficiency := totalTrend > 0 ? totalEfficiency / totalTrend : na
avgVolatility := totalTrend > 0 ? totalVolatility / totalTrend : na
var table trendTable = table.new(
    position = position.bottom_right,
    columns = 2,
    rows = 4,
    bgcolor = color.rgb(0, 255, 255, 30),
    border_color = color.black,
    border_width = 2
    )
table.cell(trendTable, 0, 0, "Total Trends")
table.cell(trendTable, 1, 0, str.tostring(totalTrend))
table.cell(trendTable, 0, 1, "Valid Trends")
table.cell(trendTable, 1, 1, str.tostring(validTrend) + "\n" + str.tostring(validTrendPct, "#.##") + "%")
table.cell(trendTable, 0, 2, "Auto TP")
table.cell(trendTable, 1, 2, str.tostring(mfeP70, "#.##") + "%")
table.cell(trendTable, 0, 3, "Auto SL")
table.cell(trendTable, 1, 3, str.tostring(maeP70, "#.##") + "%")
// ===========================
// Long Short positions
// ===========================
offset  = 100 * syminfo.mintick
longSignal  = false, shortSignal = false
crossUnder  = ta.crossunder(low, MAval)
crossOver   = ta.crossover(high, MAval)
var bool crossUsed  = false
positionClosed      = strategy.position_size == 0 and strategy.position_size[1] != 0
if positionClosed
    crossUsed   := false
if entryMethod == "Breakout"
    longSignal  := breakPoint == 1
    shortSignal := breakPoint == -1
if entryMethod == "MA Cross" and not crossUsed
    longSignal  := trend == 1 and crossUnder
    shortSignal := trend == -1 and crossOver
atrfilterActive = ATRval > ATRfilter
if strategy.position_size == 0
    if (longSignal and useAtrFilter) ? atrfilterActive : longSignal
        strategy.entry("Long", strategy.long)
    if (shortSignal and useAtrFilter) ? atrfilterActive : shortSignal
        strategy.entry("Short", strategy.short)
// ===========================
// Long Short label
// ===========================
if ta.barssince(strategy.position_size <= 0) == 1
    label.new(
        x = bar_index,
        y = low - offset,
        text = "Long",
        color = color.green,
        style = label.style_label_up,
        size = size.normal
        )
if ta.barssince(strategy.position_size >= 0) == 1
    label.new(
        x = bar_index,
        y = high + offset,
        text = "Short",
        color = color.red,
        size = size.normal
        )
// ===========================
// TP, SL Zone
// ===========================
TPthresh = useAutoTP_SL ? mfeP70 : TPinput
SLthresh = useAutoTP_SL ? maeP70 : SLinput
longTP  = strategy.position_avg_price * (1 + TPthresh/100)
longSL  = strategy.position_avg_price * (1 - SLthresh/100)
shortTP = strategy.position_avg_price * (1 - TPthresh/100)
shortSL = strategy.position_avg_price * (1 + SLthresh/100)
strategy.exit("Long Exit", "Long", limit = longTP, stop = longSL)
strategy.exit("Short Exit", "Short", limit = shortTP, stop = shortSL)
var box longBox = na
if strategy.position_size > 0 and na(longBox)
    longBox := box.new(
        left = bar_index,
        right = bar_index,
        top = longTP,
        bottom = longSL,
        border_width = 0,
        bgcolor = color.new(color.blue, 80)
        )
if not na(longBox)
    box.set_right(longBox, bar_index)
var box shortBox = na
if strategy.position_size < 0 and na(shortBox)
    shortBox := box.new(
        left = bar_index,
        right = bar_index,
        top = shortSL,
        bottom = shortTP,
        border_width = 0,
        bgcolor = color.new(color.blue, 80)
        )
if not na(shortBox)
    box.set_right(shortBox, bar_index)
if strategy.position_size == 0
    longBox := na
    shortBox := na
// ===========================
// Trade Analytics Panel
// ===========================
var table statsTable = table.new(
    position = position.top_right,
    columns = 2,
    rows = 7,
    bgcolor = color.rgb(0, 255, 255, 30),
    border_color = color.black,
    border_width = 2
    )
totalTrades = strategy.closedtrades
wintrades = strategy.wintrades
lossTrades = strategy.losstrades
netProfit = strategy.netprofit_percent
profitFactor = strategy.grossprofit / math.abs(strategy.grossloss)
winRate = totalTrades > 0 ? (wintrades / totalTrades) * 100 : na
avgWin = wintrades > 0 ? strategy.grossprofit / wintrades : na
avgLoss = lossTrades > 0 ? math.abs(strategy.grossloss) / lossTrades : na
lossRate = 100 - winRate
expectancy = (winRate / 100 * avgWin) - (lossRate / 100 * avgLoss) // trung bình lợi nhuận mỗi trade
avgR = avgWin / avgLoss
maxDDpct = strategy.max_drawdown_percent // % sụt giảm vốn lớn nhất
table.cell(statsTable, 0, 0, "Total Trades")
table.cell(statsTable, 1, 0, str.tostring(totalTrades))
table.cell(statsTable, 0, 1, "Win Rate")
table.cell(statsTable, 1, 1, str.tostring(winRate, "#.##") + "%")
table.cell(statsTable, 0, 2, "Profit Factor")
table.cell(statsTable, 1, 2, str.tostring(profitFactor, "#.##"))
table.cell(statsTable, 0, 3, "Net Profit")
table.cell(statsTable, 1, 3, str.tostring(netProfit, "#.##") + "%")
table.cell(statsTable, 0, 4, "Expectancy")
table.cell(statsTable, 1, 4, str.tostring(expectancy, "#.##"))
table.cell(statsTable, 0, 5, "Avg R")
table.cell(statsTable, 1, 5, str.tostring(avgR, "#.##"))
table.cell(statsTable, 0, 6, "M.Drawdown")
table.cell(statsTable, 1, 6, str.tostring(maxDDpct, "#.##") + "%")