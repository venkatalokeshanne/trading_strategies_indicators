//@version=6
//@version=6
indicator("8 AM EST ORB | 30T & 100T", overlay=true, max_boxes_count=10, max_lines_count=20, max_labels_count=20)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SETTINGS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

string TZ = "America/New_York"

int buffer30  = input.int(30, "30 Tick Buffer", minval=1)
int buffer100 = input.int(100, "100 Tick Buffer", minval=1)

bool showLabels = input.bool(true, "Show Labels")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TIME
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// First 5 minutes of 8:00 AM ET
bool inORB = hour(time, TZ) == 8 and minute(time, TZ) >= 0 and minute(time, TZ) < 5

// We finalize the ORB when the 8:05 candle begins
bool orbFinished = hour(time, TZ) == 8 and minute(time, TZ) == 5

// Stop extending at 9:30 AM ET
bool before930 = (
     hour(time, TZ) < 9 or
     (hour(time, TZ) == 9 and minute(time, TZ) < 30)
)

// New trading day
bool newDay = ta.change(dayofmonth(time, TZ)) != 0

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// VARIABLES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var float orbHigh = na
var float orbLow  = na

var bool orbComplete = false

var box orbBox = na

var line upper30 = na
var line lower30 = na
var line upper100 = na
var line lower100 = na

var label orbLabel = na
var label upper30Label = na
var label lower30Label = na
var label upper100Label = na
var label lower100Label = na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RESET EACH DAY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if newDay
    orbHigh := na
    orbLow := na
    orbComplete := false

    orbBox := na

    upper30 := na
    lower30 := na
    upper100 := na
    lower100 := na

    orbLabel := na
    upper30Label := na
    lower30Label := na
    upper100Label := na
    lower100Label := na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BUILD THE 8:00–8:05 ORB
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if inORB
    orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
    orbLow  := na(orbLow)  ? low  : math.min(orbLow, low)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FINALIZE ORB AT 8:05
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if orbFinished and not orbComplete and not na(orbHigh) and not na(orbLow)

    orbComplete := true

    float level30High = orbHigh + buffer30 * syminfo.mintick
    float level30Low  = orbLow  - buffer30 * syminfo.mintick

    float level100High = orbHigh + buffer100 * syminfo.mintick
    float level100Low  = orbLow  - buffer100 * syminfo.mintick

    //━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // ORB BOX
    //━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    orbBox := box.new(
         left = bar_index - 1,
         top = orbHigh,
         right = bar_index,
         bottom = orbLow,
         border_color = color.blue,
         border_width = 2,
         bgcolor = color.new(color.blue, 85)
     )

    //━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // 30 TICK LINES
    //━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    upper30 := line.new(
         x1 = bar_index,
         y1 = level30High,
         x2 = bar_index,
         y2 = level30High,
         color = color.yellow,
         width = 1
     )

    lower30 := line.new(
         x1 = bar_index,
         y1 = level30Low,
         x2 = bar_index,
         y2 = level30Low,
         color = color.yellow,
         width = 1
     )

    //━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // 100 TICK LINES
    //━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    upper100 := line.new(
         x1 = bar_index,
         y1 = level100High,
         x2 = bar_index,
         y2 = level100High,
         color = color.red,
         width = 1
     )

    lower100 := line.new(
         x1 = bar_index,
         y1 = level100Low,
         x2 = bar_index,
         y2 = level100Low,
         color = color.red,
         width = 1
     )

    //━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // LABELS
    //━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    if showLabels

        orbLabel := label.new(
             x = bar_index,
             y = orbHigh,
             text = "8:00–8:05 ORB",
             style = label.style_label_left,
             color = color.blue,
             textcolor = color.white,
             size = size.small
         )

        upper30Label := label.new(
             x = bar_index,
             y = level30High,
             text = "+30T",
             style = label.style_label_left,
             color = color.yellow,
             textcolor = color.black,
             size = size.small
         )

        lower30Label := label.new(
             x = bar_index,
             y = level30Low,
             text = "-30T",
             style = label.style_label_left,
             color = color.yellow,
             textcolor = color.black,
             size = size.small
         )

        upper100Label := label.new(
             x = bar_index,
             y = level100High,
             text = "+100T",
             style = label.style_label_left,
             color = color.red,
             textcolor = color.white,
             size = size.small
         )

        lower100Label := label.new(
             x = bar_index,
             y = level100Low,
             text = "-100T",
             style = label.style_label_left,
             color = color.red,
             textcolor = color.white,
             size = size.small
         )

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// EXTEND LINES AND BOX UNTIL 9:30
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if orbComplete and before930

    if not na(orbBox)
        box.set_right(orbBox, bar_index)

    if not na(upper30)
        line.set_x2(upper30, bar_index)

    if not na(lower30)
        line.set_x2(lower30, bar_index)

    if not na(upper100)
        line.set_x2(upper100, bar_index)

    if not na(lower100)
        line.set_x2(lower100, bar_index)

    if showLabels

        if not na(orbLabel)
            label.set_x(orbLabel, bar_index)

        if not na(upper30Label)
            label.set_x(upper30Label, bar_index)

        if not na(lower30Label)
            label.set_x(lower30Label, bar_index)

        if not na(upper100Label)
            label.set_x(upper100Label, bar_index)

        if not na(lower100Label)
            label.set_x(lower100Label, bar_index)
plot(close)
