//@version=5
strategy(
     "ST Fast/Slow + SMA DCA Basket",
     overlay=true,
     pyramiding=6,
     initial_capital=20000,
     calc_on_every_tick=true,
     process_orders_on_close=true)

//=== Inputs ===
ST_Fast_ATR  = input.int(10, "ST Fast ATR")
ST_Fast_Mult = input.float(3.0, "ST Fast Mult", step=0.1)
ST_Slow_ATR  = input.int(10, "ST Slow ATR")
ST_Slow_Mult = input.float(6.0, "ST Slow Mult", step=0.1)

MA_Period = input.int(10, "MA Period")

LotSize      = input.float(5.0, "Lot Size (TV)", step=0.1)
MaxOrders    = input.int(6, "Max Orders", minval=1)
DCA_Distance = input.float(12, "DCA Distance") // giữ nguyên input, chưa dùng vì code gốc không dùng
DCA_Delay    = input.int(60, "DCA Delay (seconds)", minval=0)

BasketTP          = input.float(800, "Basket TP")
EquitySL          = input.float(-1000, "Equity SL")
Trailing_Start    = input.float(400, "Trailing Start")
Trailing_Distance = input.float(300, "Trailing Distance")

//=== SuperTrend ===
[stFast, stFastDir] = ta.supertrend(ST_Fast_Mult, ST_Fast_ATR)
[stSlow, stSlowDir] = ta.supertrend(ST_Slow_Mult, ST_Slow_ATR)

maValue = ta.sma(close, MA_Period)

//=== Trend filter ===
// Giữ nguyên logic gốc:
// trendUp   = SupertrendFast() > SupertrendSlow() && Close > SMA
// trendDown = SupertrendFast() < SupertrendSlow() && Close < SMA
trendUp   = (stFast > stSlow) and (close > maValue)
trendDown = (stFast < stSlow) and (close < maValue)

//=== Variables ===
var float basketPeakProfit = na
var int orderCounter = 0
var int lastOrderTimeMs = na

//=== Helpers ===
openTradesCount = strategy.opentrades
totalProfit = strategy.openprofit

enoughDelayPassed = na(lastOrderTimeMs) or (time - lastOrderTimeMs >= DCA_Delay * 1000)

//=== Main logic ===

// 1) Mở lệnh nếu có trend filter
if (trendUp or trendDown)
    // 2) Mở lệnh nếu chưa max orders và đủ delay
    if (openTradesCount < MaxOrders and enoughDelayPassed)
        orderCounter += 1
        entryId = (trendUp ? "BUY_" : "SELL_") + str.tostring(orderCounter)
        strategy.entry(entryId, trendUp ? strategy.long : strategy.short, qty=LotSize)
        lastOrderTimeMs := time

// 3) Tính profit tổng tất cả lệnh mở
// totalProfit = strategy.openprofit

// 4) Basket TP
if (openTradesCount > 0 and totalProfit >= BasketTP)
    strategy.close_all(comment="Basket TP")

// 5) Trailing Basket Profit
if (openTradesCount > 0)
    if totalProfit >= Trailing_Start
        basketPeakProfit := na(basketPeakProfit) ? totalProfit : math.max(basketPeakProfit, totalProfit)

        trailStopProfit = basketPeakProfit - Trailing_Distance
        if totalProfit <= trailStopProfit
            strategy.close_all(comment="Trailing Basket")
    else
        basketPeakProfit := na

// 6) Equity SL
// Trong MQL: AccountEquity() - AccountBalance() <= EquitySL
// Trong TradingView, strategy.openprofit tương đương PnL mở hiện tại
if (openTradesCount > 0 and totalProfit <= EquitySL)
    strategy.close_all(comment="Equity SL")

// Reset basket peak khi không còn lệnh
if openTradesCount == 0
    basketPeakProfit := na

//=== Plot ===
plot(stFast, "SuperTrend Fast", color=color.new(color.red, 0), linewidth=2)
plot(stSlow, "SuperTrend Slow", color=color.new(color.blue, 0), linewidth=2)
plot(maValue, "SMA", color=color.new(color.orange, 0), linewidth=1)