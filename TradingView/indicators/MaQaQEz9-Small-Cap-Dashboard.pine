//@version=6
indicator("Small Cap Dashboard", overlay=true)

//====================================================
// SETTINGS
//====================================================
rvolLength = input.int(10, "RVOL Lookback Days", minval=2)
rsiLength  = input.int(14, "RSI Length", minval=2)
atrLength  = input.int(14, "ATR Length", minval=2)

//====================================================
// DASHBOARD ITEMS
//====================================================
groupDisplay = "Dashboard Items"

showPrice         = input.bool(true, "Price", group=groupDisplay)
showChange        = input.bool(true, "Change %", group=groupDisplay)
showVolume        = input.bool(true, "Volume", group=groupDisplay)
showRVOL          = input.bool(true, "RVOL", group=groupDisplay)
showFreeFloat     = input.bool(true, "Free Float", group=groupDisplay)
showFloatRotation = input.bool(true, "Float Rotation", group=groupDisplay)
showRSI           = input.bool(true, "RSI", group=groupDisplay)
showMACD          = input.bool(true, "MACD", group=groupDisplay)
showVWAP          = input.bool(true, "VWAP", group=groupDisplay)
showTrend         = input.bool(true, "Trend", group=groupDisplay)
showDayHigh       = input.bool(true, "Day High", group=groupDisplay)
showDayLow        = input.bool(true, "Day Low", group=groupDisplay)
showATR           = input.bool(true, "ATR", group=groupDisplay)

//====================================================
// DAILY DATA
//====================================================
prevClose = request.security(
    syminfo.tickerid,
    "D",
    close[1],
    lookahead=barmerge.lookahead_on
)

dayVolume = request.security(
    syminfo.tickerid,
    "D",
    volume
)

dayHigh = request.security(
    syminfo.tickerid,
    "D",
    high
)

dayLow = request.security(
    syminfo.tickerid,
    "D",
    low
)

avgDailyVolume = request.security(
    syminfo.tickerid,
    "D",
    ta.sma(volume, rvolLength)
)

//====================================================
// BASIC DATA
//====================================================
price = close

float changePct = na

if not na(prevClose) and prevClose != 0
    changePct := ((price - prevClose) / prevClose) * 100

//====================================================
// FLOAT / SHARES / MARKET CAP
//====================================================
freeFloat = syminfo.shares_outstanding_float
totalShares = syminfo.shares_outstanding_total

float marketCap = na

if not na(totalShares)
    marketCap := totalShares * price

//====================================================
// RVOL
//====================================================
float rvol = na

if not na(avgDailyVolume) and avgDailyVolume != 0
    rvol := dayVolume / avgDailyVolume

//====================================================
// FLOAT ROTATION
//====================================================
float floatRotation = na

if not na(freeFloat) and freeFloat != 0
    floatRotation := dayVolume / freeFloat

//====================================================
// RSI
//====================================================
rsi = ta.rsi(close, rsiLength)

//====================================================
// MACD
//====================================================
[macdLine, signalLine, macdHist] = ta.macd(close, 12, 26, 9)

macdBullish = macdLine > signalLine

//====================================================
// VWAP
//====================================================
vwap = ta.vwap(hlc3)

aboveVWAP = close >= vwap

//====================================================
// EMAS / TREND
//====================================================
ema9 = ta.ema(close, 9)
ema20 = ta.ema(close, 20)

bullTrend = close > vwap and ema9 > ema20
bearTrend = close < vwap and ema9 < ema20

//====================================================
// ATR
//====================================================
atr = ta.atr(atrLength)

//====================================================
// COLORS
//====================================================
green  = color.rgb(35, 170, 100)
red    = color.rgb(215, 60, 70)
orange = color.rgb(235, 135, 45)
yellow = color.rgb(210, 180, 55)
gray   = color.rgb(75, 80, 90)

dark     = color.rgb(23, 27, 35)
labelBG  = color.rgb(38, 43, 54)
headerBG = color.rgb(30, 35, 46)

white = color.white

//====================================================
// FORMAT LARGE NUMBERS
//====================================================
formatNumber(float value) =>
    string result = "N/A"

    if not na(value)
        if value >= 1000000000
            result := str.tostring(value / 1000000000, "#.##") + "B"
        else if value >= 1000000
            result := str.tostring(value / 1000000, "#.##") + "M"
        else if value >= 1000
            result := str.tostring(value / 1000, "#.##") + "K"
        else
            result := str.tostring(value, "#")

    result

//====================================================
// DISPLAY TEXT
//====================================================
string marketCapText = "N/A"

if not na(marketCap)
    marketCapText := "$" + formatNumber(marketCap)

string changeText = "N/A"

if not na(changePct)
    changeText := str.tostring(changePct, "#.##") + "%"

string rvolText = "N/A"

if not na(rvol)
    rvolText := str.tostring(rvol, "#.##") + "x"

string rotationText = "N/A"

if not na(floatRotation)
    rotationText := str.tostring(floatRotation, "#.##") + "x"

string rsiText = "N/A"

if not na(rsi)
    rsiText := str.tostring(rsi, "#.##")

string atrText = "N/A"

if not na(atr)
    atrText := "$" + str.tostring(atr, format.mintick)

string highText = "N/A"

if not na(dayHigh)
    highText := "$" + str.tostring(dayHigh, format.mintick)

string lowText = "N/A"

if not na(dayLow)
    lowText := "$" + str.tostring(dayLow, format.mintick)

//====================================================
// STATUS TEXT
//====================================================
string macdText = "BEARISH"

if macdBullish
    macdText := "BULLISH"

string vwapText = "BELOW"

if aboveVWAP
    vwapText := "ABOVE"

string trendText = "NEUTRAL"

if bullTrend
    trendText := "BULLISH"

if bearTrend
    trendText := "BEARISH"

//====================================================
// CHANGE COLOR
//====================================================
changeColor = gray

if not na(changePct)
    if changePct >= 0
        changeColor := green
    else
        changeColor := red

//====================================================
// RVOL COLOR
//====================================================
rvolColor = gray

if not na(rvol)
    if rvol >= 10
        rvolColor := red
    else if rvol >= 5
        rvolColor := orange
    else if rvol >= 2
        rvolColor := green

//====================================================
// FREE FLOAT COLOR
//
// UNDER 5M    = GREEN
// 5M - 10M    = GRAY
// ABOVE 10M   = RED
//====================================================
floatColor = gray

if not na(freeFloat)
    if freeFloat < 5000000
        floatColor := green
    else if freeFloat > 10000000
        floatColor := red
    else
        floatColor := gray

//====================================================
// FLOAT ROTATION COLOR
//
// UNDER 1X    = RED
// 1X - 5X     = GRAY
// ABOVE 5X    = GREEN
//====================================================
rotationColor = gray

if not na(floatRotation)
    if floatRotation < 1
        rotationColor := red
    else if floatRotation > 5
        rotationColor := green
    else
        rotationColor := gray

//====================================================
// RSI COLOR
//====================================================
rsiColor = gray

if not na(rsi)
    if rsi >= 70
        rsiColor := red
    else if rsi <= 30
        rsiColor := green

//====================================================
// MACD COLOR
//====================================================
macdColor = red

if macdBullish
    macdColor := green

//====================================================
// VWAP COLOR
//====================================================
vwapColor = red

if aboveVWAP
    vwapColor := green

//====================================================
// TREND COLOR
//====================================================
trendColor = gray

if bullTrend
    trendColor := green

if bearTrend
    trendColor := red

//====================================================
// ARRAYS FOR ENABLED DASHBOARD ITEMS
//====================================================
var metricLabels = array.new_string()
var metricValues = array.new_string()
var metricColors = array.new_color()

//====================================================
// TABLE
// 4 columns
// 8 rows = header + up to 7 metric rows
//====================================================
var table dash = table.new(
    position.top_right,
    4,
    8,
    frame_width=1,
    border_width=1
)

//====================================================
// DASHBOARD
//====================================================
if barstate.islast

    // Clear stored dashboard items
    array.clear(metricLabels)
    array.clear(metricValues)
    array.clear(metricColors)

    // Clear entire visible table
    table.clear(dash, 0, 0, 3, 7)

    //================================================
    // ADD ENABLED ITEMS
    //================================================

    if showPrice
        array.push(metricLabels, "Price")
        array.push(metricValues, "$" + str.tostring(price, format.mintick))
        array.push(metricColors, dark)

    if showChange
        array.push(metricLabels, "Change")
        array.push(metricValues, changeText)
        array.push(metricColors, changeColor)

    if showVolume
        array.push(metricLabels, "Volume")
        array.push(metricValues, formatNumber(dayVolume))
        array.push(metricColors, dark)

    if showRVOL
        array.push(metricLabels, "RVOL")
        array.push(metricValues, rvolText)
        array.push(metricColors, rvolColor)

    if showFreeFloat
        array.push(metricLabels, "Free Float")
        array.push(metricValues, formatNumber(freeFloat))
        array.push(metricColors, floatColor)

    if showFloatRotation
        array.push(metricLabels, "Float Rot.")
        array.push(metricValues, rotationText)
        array.push(metricColors, rotationColor)

    if showRSI
        array.push(metricLabels, "RSI")
        array.push(metricValues, rsiText)
        array.push(metricColors, rsiColor)

    if showMACD
        array.push(metricLabels, "MACD")
        array.push(metricValues, macdText)
        array.push(metricColors, macdColor)

    if showVWAP
        array.push(metricLabels, "VWAP")
        array.push(metricValues, vwapText)
        array.push(metricColors, vwapColor)

    if showTrend
        array.push(metricLabels, "Trend")
        array.push(metricValues, trendText)
        array.push(metricColors, trendColor)

    if showDayHigh
        array.push(metricLabels, "Day High")
        array.push(metricValues, highText)
        array.push(metricColors, dark)

    if showDayLow
        array.push(metricLabels, "Day Low")
        array.push(metricValues, lowText)
        array.push(metricColors, dark)

    if showATR
        array.push(metricLabels, "ATR")
        array.push(metricValues, atrText)
        array.push(metricColors, dark)

    //================================================
    // HEADER
    //================================================

    table.cell(
        dash,
        0,
        0,
        syminfo.ticker,
        bgcolor=headerBG,
        text_color=white,
        text_size=size.normal
    )

    table.cell(
        dash,
        1,
        0,
        "",
        bgcolor=headerBG,
        text_color=white
    )

    table.cell(
        dash,
        2,
        0,
        "Market Cap",
        bgcolor=headerBG,
        text_color=white
    )

    table.cell(
        dash,
        3,
        0,
        marketCapText,
        bgcolor=headerBG,
        text_color=white
    )

    //================================================
    // DRAW ENABLED ITEMS
    //================================================

    metricCount = array.size(metricLabels)

    if metricCount > 0

        for i = 0 to metricCount - 1

            row = int(math.floor(i / 2)) + 1

            bool leftSide = true

            if i % 2 != 0
                leftSide := false

            int labelColumn = 0
            int valueColumn = 1

            if not leftSide
                labelColumn := 2
                valueColumn := 3

            table.cell(
                dash,
                labelColumn,
                row,
                array.get(metricLabels, i),
                bgcolor=labelBG,
                text_color=white
            )

            table.cell(
                dash,
                valueColumn,
                row,
                array.get(metricValues, i),
                bgcolor=array.get(metricColors, i),
                text_color=white
            )

//====================================================
// OPTIONAL VWAP LINE
//====================================================
// plot(vwap, title="VWAP", linewidth=2)