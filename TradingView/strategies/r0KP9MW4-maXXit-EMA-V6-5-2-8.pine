// -----------------------------------------------
// Backtesting config
// Funktion: Berechnet Timestamp X Monate zurück
// -----------------------------------------------
//
get_months_back(int months) =>
    y = year(timenow) - math.floor(months / 12)
    m = month(timenow) - (months % 12)
    if m <= 0
        y := y - 1
        m := m + 12
    timestamp(y, m, 1, 0, 0)

start_time = get_months_back(60)    
if chart_timeframe == '1'
    start_time := get_months_back(2)    
else if chart_timeframe == '5'
    start_time := get_months_back(3)    
else if chart_timeframe == '15'
    start_time := get_months_back(9)    
else if chart_timeframe == '60'
    start_time := get_months_back(18)    
else if chart_timeframe == '240'
    start_time := get_months_back(36)    

