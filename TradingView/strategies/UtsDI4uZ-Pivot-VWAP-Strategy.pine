//@version=5
strategy("Pivot VWAP Strategy", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// ============================================================
// DAILY PIVOT POINTS — P + 5 R/S levels
// ============================================================
prev_high  = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_on)
prev_low   = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_on)
prev_close = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)

dp  = (prev_high + prev_low + prev_close) / 3
dr1 = 2 * dp - prev_low
dr2 = dp + (prev_high - prev_low)
dr3 = prev_high + 2 * (dp - prev_low)
ds1 = 2 * dp - prev_high
ds2 = dp - (prev_high - prev_low)
ds3 = prev_low - 2 * (prev_high - dp)

range1 = dr1 - ds1
dr4 = dr3 + range1
dr5 = dr4 + range1
ds4 = ds3 - range1
ds5 = ds4 - range1

all_pivots = array.from(ds5, ds4, ds3, ds2, ds1, dp, dr1, dr2, dr3, dr4, dr5)

// ============================================================
// VWAP — resets at 9:30am each session
// ============================================================
is_new_session = ta.change(time("D")) != 0 and session.ismarket

var float vwap_num = 0.0
var float vwap_den = 0.0

if is_new_session
    vwap_num := 0.0
    vwap_den := 0.0

if session.ismarket
    vwap_num := vwap_num + hlc3 * volume
    vwap_den := vwap_den + volume

vwap = vwap_den > 0 ? vwap_num / vwap_den : na
vwap_display = session.ismarket ? vwap : na
plot(vwap_display, title="VWAP", color=color.yellow, linewidth=2, style=plot.style_linebr)

// ============================================================
// PIVOT PLOTS
// ============================================================
plot(dp,  title="P",  color=color.white,  linewidth=1, style=plot.style_circles)
plot(dr1, title="R1", color=color.red,    linewidth=1, style=plot.style_circles)
plot(dr2, title="R2", color=color.red,    linewidth=1, style=plot.style_circles)
plot(dr3, title="R3", color=color.red,    linewidth=1, style=plot.style_circles)
plot(dr4, title="R4", color=color.orange, linewidth=1, style=plot.style_circles)
plot(dr5, title="R5", color=color.orange, linewidth=1, style=plot.style_circles)
plot(ds1, title="S1", color=color.green,  linewidth=1, style=plot.style_circles)
plot(ds2, title="S2", color=color.green,  linewidth=1, style=plot.style_circles)
plot(ds3, title="S3", color=color.green,  linewidth=1, style=plot.style_circles)
plot(ds4, title="S4", color=color.lime,   linewidth=1, style=plot.style_circles)
plot(ds5, title="S5", color=color.lime,   linewidth=1, style=plot.style_circles)

// ============================================================
// TIME FILTER — 9:30am to 2:00pm only
// ============================================================
t = time("10", "0930-1400")
in_time = not na(t)

// ============================================================
// DAILY SIGNAL COUNTER — max 2 per day
// ============================================================
var int daily_signals = 0
var int last_signal_day = 0
current_day = dayofmonth

if current_day != last_signal_day
    daily_signals := 0

can_trade = in_time and daily_signals < 2

// ============================================================
// FIND NEXT PIVOT ABOVE AND BELOW ENTRY PRICE
// ============================================================
get_next_pivot_above(entry_price) =>
    result = dr5
    for i = 0 to array.size(all_pivots) - 1
        p = array.get(all_pivots, i)
        if p > entry_price and p < result
            result := p
    result

get_next_pivot_below(entry_price) =>
    result = ds5
    for i = 0 to array.size(all_pivots) - 1
        p = array.get(all_pivots, i)
        if p < entry_price and p > result
            result := p
    result

// ============================================================
// SIGNAL LOGIC
// Long: wick below pivot AND below VWAP, close back above both
// Short: wick above pivot AND above VWAP, close back below both
// Also: breakdown short — close below pivot AND below VWAP
// Also: breakout long — close above pivot AND above VWAP
// ============================================================
check_long_hammer(p) =>
    not na(vwap) and low < p and low < vwap and close > p and close > vwap

check_short_hammer(p) =>
    not na(vwap) and high > p and high > vwap and close < p and close < vwap

check_long_breakout(p) =>
    not na(vwap) and close > p and close > vwap and close[1] < p and close[1] < vwap

check_short_breakdown(p) =>
    not na(vwap) and close < p and close < vwap and close[1] > p and close[1] > vwap

long_signal  = can_trade and (
     check_long_hammer(dp)   or check_long_hammer(dr1)   or check_long_hammer(dr2)   or check_long_hammer(dr3)   or check_long_hammer(dr4)   or check_long_hammer(dr5)   or
     check_long_hammer(ds1)  or check_long_hammer(ds2)   or check_long_hammer(ds3)   or check_long_hammer(ds4)   or check_long_hammer(ds5)   or
     check_long_breakout(dp) or check_long_breakout(dr1) or check_long_breakout(dr2) or check_long_breakout(dr3) or check_long_breakout(dr4) or check_long_breakout(dr5) or
     check_long_breakout(ds1) or check_long_breakout(ds2) or check_long_breakout(ds3) or check_long_breakout(ds4) or check_long_breakout(ds5))

short_signal = can_trade and (
     check_short_hammer(dp)    or check_short_hammer(dr1)    or check_short_hammer(dr2)    or check_short_hammer(dr3)    or check_short_hammer(dr4)    or check_short_hammer(dr5)    or
     check_short_hammer(ds1)   or check_short_hammer(ds2)    or check_short_hammer(ds3)    or check_short_hammer(ds4)    or check_short_hammer(ds5)    or
     check_short_breakdown(dp) or check_short_breakdown(dr1) or check_short_breakdown(dr2) or check_short_breakdown(dr3) or check_short_breakdown(dr4) or check_short_breakdown(dr5) or
     check_short_breakdown(ds1) or check_short_breakdown(ds2) or check_short_breakdown(ds3) or check_short_breakdown(ds4) or check_short_breakdown(ds5))

// ============================================================
// TRACK TARGET PIVOT AT ENTRY
// ============================================================
var float target_pivot_long  = na
var float target_pivot_short = na

if long_signal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    target_pivot_long := get_next_pivot_above(close)
    daily_signals := daily_signals + 1
    last_signal_day := current_day

if short_signal and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    target_pivot_short := get_next_pivot_below(close)
    daily_signals := daily_signals + 1
    last_signal_day := current_day

// ============================================================
// EXITS
// Long: price reaches target pivot above AND close fails below it
//       OR close below VWAP
// Short: price reaches target pivot below AND close fails above it
//        OR close above VWAP
// ============================================================
if strategy.position_size > 0
    pivot_fail_long = not na(target_pivot_long) and high >= target_pivot_long and close < target_pivot_long
    vwap_exit_long  = not na(vwap) and close < vwap
    if pivot_fail_long
        strategy.close("Long", comment="Pivot failure above")
        target_pivot_long := na
    else if vwap_exit_long
        strategy.close("Long", comment="Close below VWAP")
        target_pivot_long := na

if strategy.position_size < 0
    pivot_fail_short = not na(target_pivot_short) and low <= target_pivot_short and close > target_pivot_short
    vwap_exit_short  = not na(vwap) and close > vwap
    if pivot_fail_short
        strategy.close("Short", comment="Pivot failure below")
        target_pivot_short := na
    else if vwap_exit_short
        strategy.close("Short", comment="Close above VWAP")
        target_pivot_short := na

// ============================================================
// VISUALS
// ============================================================
plotshape(long_signal,  location=location.belowbar, color=color.green, style=shape.labelup,   size=size.small, text="L")
plotshape(short_signal, location=location.abovebar, color=color.red,   style=shape.labeldown, size=size.small, text="S")
plot(strategy.position_size > 0  ? target_pivot_long  : na, title="Target Pivot Long",  color=color.green, linewidth=2, style=plot.style_linebr)
plot(strategy.position_size < 0 ? target_pivot_short : na, title="Target Pivot Short", color=color.red,   linewidth=2, style=plot.style_linebr)
bgcolor(strategy.position_size > 0 ? color.new(color.green, 90) : strategy.position_size < 0 ? color.new(color.red, 90) : na)
bgcolor(in_time ? color.new(color.blue, 97) : na, title="Trading Window")