//@version=6
indicator("KOOB Pre-Trade Checklist", overlay=true)

// ─────────────────────────────────────────────
// CHECKLIST INPUTS
// ─────────────────────────────────────────────

groupChecklist = "Pre-Trade Checklist"

biasOK = input.bool(false, "1. Clear Bias + Liquidity Draw", group=groupChecklist)
htfFVGOK = input.bool(false, "2. Higher Timeframe FVG", group=groupChecklist)
sweepSMTOK = input.bool(false, "3. Lower TF Sweep / SMT", group=groupChecklist)
inverseFVGOK = input.bool(false, "4. Inverse FVG", group=groupChecklist)

// Optional final confirmation
entryModelOK = input.bool(false, "5. Entry Model Confirmed", group=groupChecklist)

// ─────────────────────────────────────────────
// TABLE SETTINGS
// ─────────────────────────────────────────────

groupStyle = "Table Settings"

showTable = input.bool(true, "Show Checklist", group=groupStyle)
tablePosition = input.string(
     "Top Right",
     "Table Position",
     options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"],
     group=groupStyle
)

// ─────────────────────────────────────────────
// TABLE POSITION
// ─────────────────────────────────────────────

pos = switch tablePosition
    "Top Right" => position.top_right
    "Top Left" => position.top_left
    "Bottom Right" => position.bottom_right
    => position.bottom_left

// ─────────────────────────────────────────────
// STATUS
// ─────────────────────────────────────────────

allConfirmed = biasOK and htfFVGOK and sweepSMTOK and inverseFVGOK and entryModelOK

confirmedCount =
     (biasOK ? 1 : 0) +
     (htfFVGOK ? 1 : 0) +
     (sweepSMTOK ? 1 : 0) +
     (inverseFVGOK ? 1 : 0) +
     (entryModelOK ? 1 : 0)

// ─────────────────────────────────────────────
// TABLE
// ─────────────────────────────────────────────

var table checklist = table.new(
     pos,
     2,
     8,
     border_width=1
)

if barstate.islast and showTable

    // Header
    table.cell(
         checklist, 0, 0,
         "KOOB TRADE CHECKLIST",
         text_color=color.white,
         bgcolor=color.rgb(25,25,25),
         text_size=size.small
    )

    table.cell(
         checklist, 1, 0,
         str.tostring(confirmedCount) + "/5",
         text_color=color.white,
         bgcolor=color.rgb(25,25,25),
         text_size=size.small
    )

    // Row 1
    table.cell(
         checklist, 0, 1,
         "Clear Bias + Liquidity",
         text_color=color.white,
         bgcolor=color.rgb(35,35,35),
         text_size=size.tiny
    )

    table.cell(
         checklist, 1, 1,
         biasOK ? "✓" : "WAIT",
         text_color=biasOK ? color.lime : color.orange,
         bgcolor=color.rgb(35,35,35),
         text_size=size.small
    )

    // Row 2
    table.cell(
         checklist, 0, 2,
         "HTF FVG",
         text_color=color.white,
         bgcolor=color.rgb(35,35,35),
         text_size=size.tiny
    )

    table.cell(
         checklist, 1, 2,
         htfFVGOK ? "✓" : "WAIT",
         text_color=htfFVGOK ? color.lime : color.orange,
         bgcolor=color.rgb(35,35,35),
         text_size=size.small
    )

    // Row 3
    table.cell(
         checklist, 0, 3,
         "LTF Sweep / SMT",
         text_color=color.white,
         bgcolor=color.rgb(35,35,35),
         text_size=size.tiny
    )

    table.cell(
         checklist, 1, 3,
         sweepSMTOK ? "✓" : "WAIT",
         text_color=sweepSMTOK ? color.lime : color.orange,
         bgcolor=color.rgb(35,35,35),
         text_size=size.small
    )

    // Row 4
    table.cell(
         checklist, 0, 4,
         "Inverse FVG",
         text_color=color.white,
         bgcolor=color.rgb(35,35,35),
         text_size=size.tiny
    )

    table.cell(
         checklist, 1, 4,
         inverseFVGOK ? "✓" : "WAIT",
         text_color=inverseFVGOK ? color.lime : color.orange,
         bgcolor=color.rgb(35,35,35),
         text_size=size.small
    )

    // Row 5
    table.cell(
         checklist, 0, 5,
         "Entry Model Confirmed",
         text_color=color.white,
         bgcolor=color.rgb(35,35,35),
         text_size=size.tiny
    )

    table.cell(
         checklist, 1, 5,
         entryModelOK ? "✓" : "WAIT",
         text_color=entryModelOK ? color.lime : color.orange,
         bgcolor=color.rgb(35,35,35),
         text_size=size.small
    )

    // Divider / final status
    table.cell(
         checklist, 0, 6,
         "STATUS",
         text_color=color.white,
         bgcolor=color.rgb(20,20,20),
         text_size=size.tiny
    )

    table.cell(
         checklist, 1, 6,
         allConfirmed ? "READY" : "NO TRADE",
         text_color=allConfirmed ? color.lime : color.red,
         bgcolor=color.rgb(20,20,20),
         text_size=size.small
    )

    // Reminder
    table.merge_cells(checklist, 0, 7, 1, 7)

    table.cell(
         checklist, 0, 7,
         allConfirmed ? "ALL CONDITIONS MET" : "WAIT FOR CONFIRMATION",
         text_color=allConfirmed ? color.lime : color.orange,
         bgcolor=color.rgb(15,15,15),
         text_size=size.tiny
    )