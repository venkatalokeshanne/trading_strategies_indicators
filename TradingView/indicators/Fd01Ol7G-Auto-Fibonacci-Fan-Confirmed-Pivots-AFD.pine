    [activeOriginPrice, activeOriginTime, activeEndPrice, activeEndTime, activeDirection, activeAtrUnits, activeEfficiency, activeState, activeQualifiedAtTime, qualifiedEventOriginPrice, qualifiedEventOriginTime, qualifiedEventEndPrice, qualifiedEventEndTime, qualifiedEventDirection, qualifiedEventAtrUnits, qualifiedEventEfficiency, qualifiedEventAtTime, invalidatedEventAtTime]

confirmedSourceAnchorState() =>
    [originPrice, originTime, endPrice, endTime, direction, atrUnits, efficiency, state, qualifiedAtTime, eventOriginPrice, eventOriginTime, eventEndPrice, eventEndTime, eventDirection, eventAtrUnits, eventEfficiency, eventQualifiedAtTime, eventInvalidatedAtTime] = sourceAnchorState(true)
    [originPrice[1], originTime[1], endPrice[1], endTime[1], direction[1], atrUnits[1], efficiency[1], state[1], qualifiedAtTime[1], eventOriginPrice[1], eventOriginTime[1], eventEndPrice[1], eventEndTime[1], eventDirection[1], eventAtrUnits[1], eventEfficiency[1], eventQualifiedAtTime[1], eventInvalidatedAtTime[1]]

setStatusCell(table tableId, int column, int row, string value, color valueColor, color backgroundColor, int cellWidth, int cellHeight, string textSize) =>
    table.cell(tableId, column, row, value, width = cellWidth, height = cellHeight, text_color = valueColor, bgcolor = backgroundColor, text_halign = text.align_center, text_valign = text.align_center, text_size = textSize, text_formatting = text.format_bold)

// Timeframe selection, fan lifecycle, and interactions

[localOriginPrice, localOriginTime, localEndPrice, localEndTime, localDirection, localAtrUnits, localEfficiency, localState, localQualifiedAtTime, localEventOriginPrice, localEventOriginTime, localEventEndPrice, localEventEndTime, localEventDirection, localEventAtrUnits, localEventEfficiency, localEventQualifiedAtTime, localEventInvalidatedAtTime] = sourceAnchorState(barstate.isconfirmed)

string requestedTimeframe = anchorTimeframeInput == "" ? timeframe.period : anchorTimeframeInput
int chartSeconds = timeframe.in_seconds()
int requestedSeconds = timeframe.in_seconds(anchorTimeframeInput)
bool comparableTimeframes = not na(chartSeconds) and not na(requestedSeconds)
bool chartSourceSelected = anchorTimeframeInput == ""
bool exactChartTimeframe = requestedTimeframe == timeframe.period
bool equalDurationSource = comparableTimeframes and requestedSeconds == chartSeconds
bool useLocalSource = chartSourceSelected or exactChartTimeframe or equalDurationSource
bool useHigherSource = comparableTimeframes and requestedSeconds > chartSeconds
bool sourceSelectionValid = useLocalSource or useHigherSource
string safeRequestTimeframe = useHigherSource ? requestedTimeframe : timeframe.period
bool lowerSourceTimeframe = comparableTimeframes and requestedSeconds < chartSeconds
bool unknownTimeframeRelation = not useLocalSource and not comparableTimeframes
string timeframeWarning = lowerSourceTimeframe ? "NO FAN · LTF SOURCE UNSUPPORTED" : unknownTimeframeRelation ? "NO FAN · TF NOT COMPARABLE" : ""
string timeframeFix = lowerSourceTimeframe ? "USE CHART OR ≥ " + timeframe.period : unknownTimeframeRelation ? "USE CHART OR STANDARD HIGHER" : ""

var map<int, int> alignmentHighTimes = map.new<int, int>()
var map<int, int> alignmentLowTimes = map.new<int, int>()
var float alignmentHighPrice = na
var float alignmentLowPrice = na
int alignmentBucketTime = useHigherSource ? time(requestedTimeframe) : time
bool newAlignmentBucket = useHigherSource and (na(alignmentBucketTime[1]) or alignmentBucketTime != alignmentBucketTime[1])
if useHigherSource and not na(alignmentBucketTime)
    if newAlignmentBucket or na(alignmentHighPrice) or na(alignmentLowPrice)
        alignmentHighPrice := high
        alignmentLowPrice := low
        map.put(alignmentHighTimes, alignmentBucketTime, time)
        map.put(alignmentLowTimes, alignmentBucketTime, time)
    else
        if high > alignmentHighPrice
            alignmentHighPrice := high
            map.put(alignmentHighTimes, alignmentBucketTime, time)
        if low < alignmentLowPrice
            alignmentLowPrice := low
            map.put(alignmentLowTimes, alignmentBucketTime, time)

[htfOriginPrice, htfOriginTime, htfEndPrice, htfEndTime, htfDirection, htfAtrUnits, htfEfficiency, htfState, htfQualifiedAtTime, htfEventOriginPrice, htfEventOriginTime, htfEventEndPrice, htfEventEndTime, htfEventDirection, htfEventAtrUnits, htfEventEfficiency, htfEventQualifiedAtTime, htfEventInvalidatedAtTime] = request.security(
    symbol = syminfo.tickerid,
    timeframe = safeRequestTimeframe,
    expression = confirmedSourceAnchorState(),
    gaps = barmerge.gaps_off,
    lookahead = barmerge.lookahead_on
)

int selectedState = useHigherSource ? htfState : localState
float selectedEventOriginPrice = useHigherSource ? htfEventOriginPrice : localEventOriginPrice
int selectedEventOriginTime = useHigherSource ? nz(map.get(htfEventDirection == -1 ? alignmentHighTimes : alignmentLowTimes, htfEventOriginTime), htfEventOriginTime) : localEventOriginTime
float selectedEventEndPrice = useHigherSource ? htfEventEndPrice : localEventEndPrice
int selectedEventEndTime = useHigherSource ? nz(map.get(htfEventDirection == 1 ? alignmentHighTimes : alignmentLowTimes, htfEventEndTime), htfEventEndTime) : localEventEndTime
int selectedEventDirection = useHigherSource ? htfEventDirection : localEventDirection
float selectedEventAtrUnits = useHigherSource ? htfEventAtrUnits : localEventAtrUnits
float selectedEventEfficiency = useHigherSource ? htfEventEfficiency : localEventEfficiency
int selectedEventQualifiedAtTime = useHigherSource ? (not na(htfEventQualifiedAtTime) and newAlignmentBucket ? time : na) : localEventQualifiedAtTime
int selectedEventInvalidatedAtTime = useHigherSource ? (not na(htfEventInvalidatedAtTime) and newAlignmentBucket ? time : na) : localEventInvalidatedAtTime

bool qualificationEventDrawable = sourceSelectionValid and not na(selectedEventOriginPrice) and not na(selectedEventOriginTime) and not na(selectedEventEndPrice) and not na(selectedEventEndTime) and not na(selectedEventQualifiedAtTime) and selectedEventOriginTime != selectedEventEndTime and selectedEventOriginPrice != selectedEventEndPrice
string activeLineStyle = lineStyleOf(lineStyleInput)

var array<bool> levelVisible = array.from(showLevel1Input, showLevel2Input, showLevel3Input, showLevel4Input, showLevel5Input)
var array<float> levelRatios = array.from(level1Input, level2Input, level3Input, level4Input, level5Input)
var array<color> customLevelColors = array.from(level1ColorInput, level2ColorInput, level3ColorInput, level4ColorInput, level5ColorInput)

var array<float> fanOriginPrices = array.new_float()
var array<int> fanOriginTimes = array.new_int()
var array<float> fanEndPrices = array.new_float()
var array<int> fanEndTimes = array.new_int()
var array<int> fanDirections = array.new_int()
var array<float> fanAtrUnits = array.new_float()
var array<float> fanEfficiencies = array.new_float()
var array<int> fanQualifiedTimes = array.new_int()
var array<int> fanCutoffTimes = array.new_int()
var bool queueHasCurrent = false
var int lastQualificationEventTime = na
var int lastInvalidationEventTime = na
var array<int> levelStableSides = array.new_int(LEVEL_COUNT, SIDE_TESTING)
var array<int> levelBreakSides = array.new_int(LEVEL_COUNT, SIDE_TESTING)
var array<int> levelInteractionEvents = array.new_int(LEVEL_COUNT, EVENT_NONE)
var array<int> levelInteractionBars = array.new_int(LEVEL_COUNT, na)
var int goldenPocketRelationState = POCKET_STATE_WAITING
var int confirmedChartBarCount = 0
float chartStatusAtr = ta.atr(effectiveAtrLength)
float chartVisualAtr = ta.atr(VISUAL_ATR_LENGTH)

bool qualificationEventChanged = qualificationEventDrawable and (na(lastQualificationEventTime) or selectedEventQualifiedAtTime != lastQualificationEventTime)
if qualificationEventChanged
    int queueSizeBefore = array.size(fanOriginPrices)
    bool revisesCurrent = queueHasCurrent and queueSizeBefore > 0 and array.get(fanOriginTimes, queueSizeBefore - 1) == selectedEventOriginTime and array.get(fanDirections, queueSizeBefore - 1) == selectedEventDirection
    if revisesCurrent
        int currentIndex = queueSizeBefore - 1
        array.set(fanOriginPrices, currentIndex, selectedEventOriginPrice)
        array.set(fanOriginTimes, currentIndex, selectedEventOriginTime)
        array.set(fanEndPrices, currentIndex, selectedEventEndPrice)
        array.set(fanEndTimes, currentIndex, selectedEventEndTime)
        array.set(fanDirections, currentIndex, selectedEventDirection)
        array.set(fanAtrUnits, currentIndex, selectedEventAtrUnits)
        array.set(fanEfficiencies, currentIndex, selectedEventEfficiency)
        array.set(fanQualifiedTimes, currentIndex, selectedEventQualifiedAtTime)
    else
        if queueHasCurrent and queueSizeBefore > 0
            array.set(fanCutoffTimes, queueSizeBefore - 1, selectedEventQualifiedAtTime)
        array.push(fanOriginPrices, selectedEventOriginPrice)
        array.push(fanOriginTimes, selectedEventOriginTime)
        array.push(fanEndPrices, selectedEventEndPrice)
        array.push(fanEndTimes, selectedEventEndTime)
        array.push(fanDirections, selectedEventDirection)
        array.push(fanAtrUnits, selectedEventAtrUnits)
        array.push(fanEfficiencies, selectedEventEfficiency)
        array.push(fanQualifiedTimes, selectedEventQualifiedAtTime)
        array.push(fanCutoffTimes, na)
    lastQualificationEventTime := selectedEventQualifiedAtTime
    queueHasCurrent := true

    if array.size(fanOriginPrices) > fansOnChartInput
        array.shift(fanOriginPrices)
        array.shift(fanOriginTimes)
        array.shift(fanEndPrices)
        array.shift(fanEndTimes)
        array.shift(fanDirections)
        array.shift(fanAtrUnits)
        array.shift(fanEfficiencies)
        array.shift(fanQualifiedTimes)
        array.shift(fanCutoffTimes)

bool invalidationEventChanged = sourceSelectionValid and not na(selectedEventInvalidatedAtTime) and (na(lastInvalidationEventTime) or selectedEventInvalidatedAtTime != lastInvalidationEventTime)
if invalidationEventChanged
