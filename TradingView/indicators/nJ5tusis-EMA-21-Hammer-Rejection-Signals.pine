//@version=6
indicator("EMA 21 Hammer Rejection Signals", overlay=true)

//────────────────────────────────────
// INPUTS
//────────────────────────────────────
emaLength = input.int(21, "EMA Length", minval=1)

wickMultiplier = input.float(
     1.5,
     "Minimum Main Wick × Body",
     minval=0.1,
     step=0.1
)

coveragePercent = input.float(
     60.0,
     "Minimum Candle Coverage %",
     minval=1.0,
     maxval=100.0,
     step=1.0
) / 100.0

showEMA = input.bool(true, "Show EMA")

//────────────────────────────────────
// EMA
//────────────────────────────────────
ema21 = ta.ema(close, emaLength)

plot(
     showEMA ? ema21 : na,
     title="EMA",
     color=color.orange,
     linewidth=2
)

//────────────────────────────────────
// PREVIOUS CANDLE MEASUREMENTS
//────────────────────────────────────
previousBody = math.abs(close[1] - open[1])

previousUpperWick =
     high[1] - math.max(open[1], close[1])

previousLowerWick =
     math.min(open[1], close[1]) - low[1]

//────────────────────────────────────
// HAMMER CONDITIONS
//────────────────────────────────────

// BUY:
// Previous candle is red with a long upper wick
redInvertedHammer =
     close[1] < open[1] and
     previousBody > 0 and
     previousUpperWick >= previousBody * wickMultiplier

// SELL:
// Previous candle is green with a long lower wick
greenHammer =
     close[1] > open[1] and
     previousBody > 0 and
     previousLowerWick >= previousBody * wickMultiplier

//────────────────────────────────────
// EMA TREND FILTER
//────────────────────────────────────

// Both candles must remain on the correct side of EMA
buyTrend =
     close[1] > ema21[1] and
     close > ema21

sellTrend =
     close[1] < ema21[1] and
     close < ema21

//────────────────────────────────────
// CURRENT CONFIRMATION CANDLE
//────────────────────────────────────
greenConfirmation =
     close > open

redConfirmation =
     close < open

//────────────────────────────────────
// MAIN BREAKOUT / BREAKDOWN CONDITIONS
//────────────────────────────────────

// BUY:
// Green candle closes above previous candle's upper wick/high
mainBuy =
     redInvertedHammer and
     greenConfirmation and
     buyTrend and
     close > high[1]

// SELL:
// Red candle closes below previous candle's lower wick/low
mainSell =
     greenHammer and
     redConfirmation and
     sellTrend and
     close < low[1]

//────────────────────────────────────
// 60% COVERAGE CONDITIONS
//────────────────────────────────────
previousRange = high[1] - low[1]

// BUY:
// Current green candle closes at least 60% upward
// through the previous red candle's range
buyCoverageLevel =
     low[1] + previousRange * coveragePercent

coverageBuy =
     redInvertedHammer and
     greenConfirmation and
     buyTrend and
     previousRange > 0 and
     close >= buyCoverageLevel

// SELL:
// Current red candle closes at least 60% downward
// through the previous green candle's range
sellCoverageLevel =
     high[1] - previousRange * coveragePercent

coverageSell =
     greenHammer and
     redConfirmation and
     sellTrend and
     previousRange > 0 and
     close <= sellCoverageLevel

//────────────────────────────────────
// FINAL CONFIRMED SIGNALS
//────────────────────────────────────

// barstate.isconfirmed ensures the signal
// only appears after the candle closes
buySignal =
     barstate.isconfirmed and
     (mainBuy or coverageBuy)

sellSignal =
     barstate.isconfirmed and
     (mainSell or coverageSell)

//────────────────────────────────────
// SIGNAL LABELS
//────────────────────────────────────
plotshape(
     buySignal,
     title="BUY Signal",
     style=shape.labelup,
     location=location.belowbar,
     color=color.green,
     text="BUY",
     textcolor=color.white,
     size=size.small
)

plotshape(
     sellSignal,
     title="SELL Signal",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     text="SELL",
     textcolor=color.white,
     size=size.small
)

//────────────────────────────────────
// ALERTS
//────────────────────────────────────
alertcondition(
     buySignal,
     title="BUY Signal",
     message="BUY setup confirmed on {{ticker}} at {{close}}"
)

alertcondition(
     sellSignal,
     title="SELL Signal",
     message="SELL setup confirmed on {{ticker}} at {{close}}"
)