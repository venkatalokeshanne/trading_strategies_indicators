//@version=6
// =====================================================================================
//  DeFiers-SMC Strategy v0.4.0 — Adaptive Smart Money Concepts (Pine v6)
//  Autores: mmello27 e Claude Code OPUS-4.7
//  Script ID TV: PYbvpIag — https://br.tradingview.com/script/PYbvpIag/
//
// =====================================================================================
//  GLOSSARIO RAPIDO — SIGLAS DO SMC
// =====================================================================================
//
//  SMC   = Smart Money Concepts (metodo institucional de leitura de fluxo)
//  HTF   = Higher Time Frame (timeframe maior, ex: 4h se voce opera 15m)
//  BOS   = Break of Structure (rompimento de estrutura — confirma tendencia)
//  CHoCH = Change of Character (mudanca de carater — reversao de tendencia)
//  MSS   = Market Structure Shift (deslocamento estrutural — variante de CHoCH)
//  OB    = Order Block (bloco de ordens — zona de origem do movimento)
//  FVG   = Fair Value Gap (lacuna de valor justo — gap de liquidez)
//  POI   = Point of Interest (ponto de interesse — OB ou FVG ativo)
//  BSL   = Buy Side Liquidity (liquidez de compra — acima dos topos)
//  SSL   = Sell Side Liquidity (liquidez de venda — abaixo dos fundos)
//  Sweep = Varredura de liquidez (rompe BSL/SSL e volta)
//  OTE   = Optimal Trade Entry (entrada otima — fibo 62/70.5/79)
//  Prem  = Premium (metade superior do range — vende aqui)
//  Disc  = Discount (metade inferior do range — compra aqui)
//  SL    = Stop Loss (parada de perda)
//  TP1   = Take Profit 1 (alvo de lucro parcial — fecha 50%)
//  TP2   = Take Profit 2 (alvo de lucro final — fecha o resto)
//  BE    = Break Even (preco de entrada — SL move para ca apos TP1)
//  MFE   = Maximum Favorable Excursion (maior lucro flutuante de um trade)
//  RR    = Risk:Reward (relacao risco/retorno, ex: RR 1.5 = ganha 1.5x o stop)
//  ATR   = Average True Range (medidor de volatilidade em pontos)
//  MTF   = Multi-Timeframe (analise em varios timeframes simultaneos)
//
// =====================================================================================
//  O QUE ESSA ESTRATEGIA FAZ
// =====================================================================================
//
//  Estrategia automatica baseada em Smart Money Concepts (SMC). Ela identifica
//  zonas onde o "dinheiro institucional" provavelmente esta posicionado e
//  entra a favor dessa direcao, com Stop Loss estrutural e dois alvos de lucro
//  (TP1 + TP2).
//
//  Cinco fatores combinam para decidir se entra ou nao:
//    1. HTF Bias        — direcao no timeframe maior (HTF) bate com a entrada?
//    2. Trend Local     — BOS/CHoCH recente na mesma direcao?
//    3. Liquidity Sweep — varreu liquidez antes (BSL/SSL) e voltou?
//    4. POI             — preco esta dentro de um Order Block ou FVG ativo?
//    5. Premium/Discount— LONG so em DISCOUNT (metade de baixo); SHORT so em PREMIUM.
//
//  Cada fator vira um score (0-100). So entra se o score >= threshold
//  (default 65) E pelo menos 3 dos 5 fatores estiverem ativos.
//
//  Gestao de risco automatica:
//    - SL no swing oposto + buffer ATR (estrutural, nao arbitrario).
//    - TP1 em R:R fixo (default 1.5x stop) — fecha 50% da posicao.
//    - TP2 na proxima liquidez oposta (ou R:R 3x se nao houver) — fecha o resto.
//    - Apos TP1: SL move para break-even e segue HL/LH (trailing estrutural).
//    - Move-to-BE antecipado: se MFE atinge 0.7x stop antes do TP1, SL ja vai pra entry.
//    - Circuit breakers: para de operar se drawdown >25% ou perda intraday >3%.
//
// =====================================================================================
//  COMO USAR (PASSO A PASSO) — v0.4.0
// =====================================================================================
//
//  CAMINHO RAPIDO (recomendado para iniciantes):
//
//  1. ABRIR EM CHART COM PELO MENOS 12 MESES DE HISTORICO
//     - Recomendado: BTCUSDT.P, ETHUSDT.P ou SOLUSDT.P na Binance
//     - Timeframes que funcionam melhor: 15m, 30m, 1h
//     - TF baixo (1m-5m) gera muito ruido; TF alto (4h+) tem poucos trades
//
//  2. ESCOLHER PERFIL DE RISCO (Grupo 11) — NOVIDADE v0.4.0
//     Atalho rapido que configura 10 parametros de uma vez. Voce escolhe um
//     e o resto e automatico. Ideal para quem nao quer mexer em dezenas de
//     campos. Opcoes:
//
//       * Personalizado (default) — usa os valores manuais dos Grupos 4 e 8.
//         Escolha SE voce ja conhece SMC e quer controle total.
//
//       * Conservador — Risco 1% / Pontuacao minima 75 / Exige F1 (HTF) + F4
//         (POI) / Trailing+BE ON / Minimo 4 fatores ativos.
//         IDEAL para quem esta comecando ou tem capital pequeno. Menos trades,
//         maior win-rate, drawdown menor.
//
//       * Equilibrado — Risco 2% / Pontuacao 65 / Sem F obrigatorios /
//         Trailing+BE ON / Minimo 3 fatores. **Defaults da estrategia.**
//         IDEAL para uso geral. Balanco entre numero de trades e win-rate.
//
//       * Agressivo — Risco 3% / Pontuacao 55 / Sem F obrigatorios /
//         Trailing+BE OFF (deixa correr) / Minimo 3 fatores.
//         IDEAL para quem tem >50 trades de baseline com WR >50%. Mais trades,
//         maior R:R medio, mas drawdown maior. Use com cautela.
//
//  3. POSICIONAR DASHBOARDS NA TELA (Grupo 7, OPCIONAL)
//     - HUD principal: top_right (mostra Tendencia, Pontuacao, Saldo, Acerto)
//     - Painel MTF: bottom_right (7 timeframes + Overall)
//     - Tabela Auto-Tuning: middle_right (27 combos para auto-otimizacao)
//
//  4. ATIVAR AUTO-TUNING (Grupo 9, OPCIONAL)
//     - Deixe ligado por algumas semanas observando o chart ao vivo
//     - A linha VERDE da tabela = melhor combinacao no periodo
//     - Voce pode aplicar manualmente os valores do vencedor (Pontuacao,
//       Volume mult, RR minimo) e mudar o Perfil para Personalizado
//
//  CAMINHO AVANCADO (para quem ja conhece SMC):
//
//  1. Mantenha Perfil = Personalizado
//  2. Ajuste manualmente Grupos 4 e 8 conforme estilo de trading
//  3. Use Grupo 10 (Avancado) para tunar presets por timeframe se necessario
//  4. Sempre PAPER TRADE 30+ trades antes de operar live
//
// =====================================================================================
//  COMO AJUSTAR PARA MELHOR PERFORMANCE
// =====================================================================================
//
//  QUER MENOS TRADES MAS MAIS PRECISOS? -> Use Perfil "Conservador" (Grupo 11)
//     Equivalente manual:
//       - Pontuacao minima (G4): 75
//       - Minimo de fatores (G4): 4
//       - F1 (HTF) e F4 (POI): ON (G4)
//       - Trailing + BE antecipado: ON (G8)
//       - Risco por trade: 1% (G8)
//       - Folga do SL: 0.8 ATR (G8)
//
//  QUER MAIS TRADES E MAIOR R:R? -> Use Perfil "Agressivo" (Grupo 11)
//     Equivalente manual:
//       - Pontuacao minima (G4): 55
//       - Minimo de fatores (G4): 3 (default)
//       - F obrigatorios: todos OFF (G4)
//       - Trailing + BE: OFF (G8) — deixa o trade correr
//       - RR minimo (TP1): 2.0 (G8)
//       - Risco por trade: 3% (G8, so se WR ja for >50%)
//
//  AJUSTES POR TIMEFRAME (Grupo 10 Avancado):
//    - Cada TF tem 6 parametros: Swing / FVG min / Vol mult / OB age / Liq % / MSS disp
//    - Mais conservador: aumentar Swing, Vol mult, MSS disp / diminuir Liq %
//    - Mais agressivo: diminuir Swing, Vol mult / aumentar FVG min, Liq %
//    - 1m  (rapido):           valores menores
//    - 15m-1h  (recomendado):  valores intermediarios
//    - 4h-D   (filtrado):      valores maiores
//
//  PARA ATIVO ESPECIFICO:
//    - BTC perp: defaults funcionam bem (happy path para SMC)
//    - ETH perp: ative killzoneMode = "Weight (crypto -30%)" para penalizar off-hours
//    - Acoes B3 (BMFBOVESPA:): ative killzoneMode = "Hard (forex/B3 block)" — bloqueia
//      entrada fora do horario de pregao
//    - Forex: idem B3 (Hard block off-hours)
//
//  COMECE COM PAPER TRADING:
//    - Capital inicial: $10.000 (default)
//    - Comissao: 0.05% (perp tipico)
//    - Slippage: 2 ticks
//    - Pyramiding: 0 (1 trade por vez, sem somar posicoes)
//
//  CRITERIOS DE TIER (alvos):
//    | TIER | PF    | Sharpe | WR    | MaxDD | #Trades |
//    |------|-------|--------|-------|-------|---------|
//    |  C   | >=0.9 | >=-0.5 |  -    | <=30% | >=30    |
//    |  B   | >=1.0 | >= 0.0 | >=25% | <=25% | >=50    |
//    |  A   | >=1.4 | >= 0.8 | >=35% | <=22% | >=70    |
//    |  S   | >=1.6 | >= 1.2 | >=45% | <=20% | >=80    |
//
// =====================================================================================
//  DASHBOARDS NA TELA — O QUE CADA INFO SIGNIFICA
// =====================================================================================
//
//  ┌──────────────────── HUD PRINCIPAL (canto superior direito) ───────────────────┐
//  │                                                                                │
//  │  DSMC v0.4.0 ............. nome do indicador + versao                          │
//  │  Tendencia ............... direcao da tendencia AQUI no TF do chart            │
//  │                            ▲ SUBINDO = alta confirmada (bom para COMPRAR)      │
//  │                            ▼ CAINDO  = baixa confirmada (bom para VENDER)      │
//  │                            — PARADO  = sem direcao clara                       │
//  │                                                                                │
//  │  Tend. Maior <TF> ........ tendencia do timeframe ACIMA (ex: D = diario)       │
//  │                            COMPRA / VENDA / — (alinhe sempre com este)         │
//  │                                                                                │
//  │  Zona Preço .............. onde o preco esta dentro do range atual             │
//  │                            BARATO = metade de baixo  (ideal para COMPRAR)      │
//  │                            CARO   = metade de cima   (ideal para VENDER)       │
//  │                                                                                │
//  │  Volatilidade ............ humor do mercado AGORA                              │
//  │                            CALMO   = pouco volume, range estreito              │
//  │                            NORMAL  = comportamento padrao                      │
//  │                            AGITADO = muito volume, range largo                 │
//  │                                                                                │
//  │  Caça Liquidez ........... ultima vez que o preco foi pegar STOPs de alguem    │
//  │                            "Topo varrido Xb"   = caçou stops de venda          │
//  │                            "Fundo varrido Xb"  = caçou stops de compra         │
//  │                            (b = bars atras)                                    │
//  │                                                                                │
//  │  Horário Quente .......... sessao de pregao ativa em NY/Londres                │
//  │                            (so importa se vc ativar killzone no Group 6)       │
//  │                                                                                │
//  │  Pontos C / V ............ score de COMPRA / score de VENDA  alvo=XX           │
//  │                            quando algum dos dois >= alvo, dispara entrada      │
//  │                            (default alvo = 65)                                 │
//  │                                                                                │
//  │  Operação ................ posicao aberta agora                                │
//  │                            Nenhuma  = sem trade                                │
//  │                            COMPRADO = long ativo                               │
//  │                            VENDIDO  = short ativo                              │
//  │                                                                                │
//  │  Saldo ................... saldo total simulado (paper trading)                │
//  │                                                                                │
//  │  Operações / Acerto ...... total de trades fechados / taxa de acerto %         │
//  │                                                                                │
//  │  Proteção Stop ........... estado do seu stop loss no trade aberto             │
//  │                            ● Sem operação    = nao ha trade                    │
//  │                            ○ Esperando TP1   = stop original (risco normal)    │
//  │                            ◐ Proteção Inicial= mfe atingiu 0.7R, stop em BE    │
//  │                            ◒ Sem Risco       = TP1 bateu, stop em break-even   │
//  │                            ● Seguindo Preço  = TP1 + trailing (lucro travado)  │
//  │                                                                                │
//  └────────────────────────────────────────────────────────────────────────────────┘
//
//  ┌─────────── MTF DASHBOARD CONFLUÊNCIA (canto inferior direito) ───────────────┐
//  │                                                                                │
//  │  Tabela com 7 timeframes (1D, 12H, 4H, 1H, 30M, 15M, 5M) mostrando:            │
//  │                                                                                │
//  │   TF   | Trend     | Sinal  | Conflu                                           │
//  │   1D   | ▲ SOBE    | COMPRA | OK                                               │
//  │   12H  | ▲ SOBE    | COMPRA | OK                                               │
//  │   4H   | — —       |   —    | —                                                │
//  │   ...                                                                          │
//  │   Overall | → COMPRA | OK 5/7 | X 1                                            │
//  │                                                                                │
//  │  Trend  = direcao da media movel no TF (EMA 9 > 21 > 50 = sobe)               │
//  │  Sinal  = COMPRA / VENDA / — (direcao sugerida pelo TF)                        │
//  │  Conflu = OK se TF concorda com seu trade atual, X se vai contra, — se neutro │
//  │  Overall = quantos TFs alinham (5/7 ou mais = ambiente forte)                  │
//  │                                                                                │
//  REGRA DE OURO — COMO USAR O MTF CONFLUENCE (DECISAO RAPIDA):
//
//   ┌─────────────────────────────────────────────────┬─────────────────────────────────────────┐
//   │ Cenario                                         │ O que fazer                             │
//   ├─────────────────────────────────────────────────┼─────────────────────────────────────────┤
//   │ Overall >= 5/7 OK + DSMC da sinal               │ ✅ Entrada com confianca ALTA           │
//   ├─────────────────────────────────────────────────┼─────────────────────────────────────────┤
//   │ Overall 3-4/7 OK                                │ 🟡 Trade com tamanho REDUZIDO (ex 1%)   │
//   ├─────────────────────────────────────────────────┼─────────────────────────────────────────┤
//   │ Overall <= 2/7 OK + 4+ divergencias             │ ❌ NAO entre. Espere o ambiente alinhar │
//   ├─────────────────────────────────────────────────┼─────────────────────────────────────────┤
//   │ Pontos C/V abaixo do alvo (ex 40/65)            │ ⏸️  Sem sinal real — nao importa MTF    │
//   └─────────────────────────────────────────────────┴─────────────────────────────────────────┘
//
//  LIMITACAO DO MTF: usa apenas EMA stack (medias moveis 5/13/21) como proxy de trend.
//                    NAO usa OBs/FVGs/Liquidity/HTF bias completo. Eh um indicador
//                    de DIVERGENCIA/CONFLUENCIA entre TFs — nao substitui DSMC principal.
//                                                                                │
//  └────────────────────────────────────────────────────────────────────────────────┘
//
//  ┌─────────── TABELA SELF-TUNE (canto direito do meio) ─────────────────────────┐
//  │                                                                                │
//  │  27 combinacoes testadas em paralelo. Linha VERDE = vencedor.                  │
//  │  Anote EThr / VMult / RRmin do vencedor e aplique nos inputs principais        │
//  │  (Group 4: Smart Money Score threshold = EThr, Group 8: RR mininum = RRmin).   │
//  │                                                                                │
//  └────────────────────────────────────────────────────────────────────────────────┘
//
//  ┌─────────── LINHAS NO PREÇO ─────────────────────────────────────────────────┐
//  │                                                                                │
//  │  Quando entrada ativa, aparecem 4 linhas com labels mostrando preco e lado:    │
//  │    Entry L/S = preco de entrada (azul=COMPRA, vermelho=VENDA)                  │
//  │    SL    L/S = stop loss (linha vermelha solida)                               │
//  │    TP1   L/S = primeiro alvo (linha verde claro tracejada — fecha metade)      │
//  │    TP2   L/S = segundo alvo  (linha verde escuro tracejada — fecha o resto)    │
//  │                                                                                │
//  │  Sem operação aberta: pode aparecer PREVIEW LONG/SHORT (linhas pontilhadas)    │
//  │  mostrando como seria o proximo trade se as condicoes confirmarem.             │
//  │                                                                                │
//  └────────────────────────────────────────────────────────────────────────────────┘
//
// =====================================================================================
//  GRUPO 10 — PRESETS POR TIMEFRAME (a sua "caixa de tunagem")
// =====================================================================================
//
//  O QUE É O GRUPO 10?
//
//  A estrategia detecta automaticamente em qual timeframe o seu chart esta
//  (1m, 5m, 15m, 1h, 4h ou diario+) e aplica um conjunto diferente de
//  configuracoes pra cada um. Esses conjuntos sao os PRESETS.
//
//  Antes da v0.2.0 esses valores estavam fixos no codigo. Na v0.2.0 eles
//  ficaram editaveis no menu de configuracoes — é o GRUPO 10.
//
//  PARA QUE SERVE?
//
//  Voce nao precisa ser programador pra ajustar a estrategia. Se quer mais
//  ou menos trades, mais ou menos rigor, basta mudar os numeros do Grupo 10.
//
//  COMO ACESSAR?
//
//  1. Clica na engrenagem ⚙ do estudo "DSMC v0.4.0" no canto superior esq.
//  2. Aba "Valores" (vem aberta por default)
//  3. Role ate o final — vai aparecer "10. Presets Adaptativos por TF"
//
//  COMO É A ESTRUTURA?
//
//  Cada timeframe tem 6 parametros editaveis, organizados em 2 linhas:
//
//   Linha A:   swing   |   fvgAtr   |   volMult
//   Linha B:   obAge   |   liqPct   |   mssDisp
//
//  Os 6 buckets de TF sao:
//   1m, 5m, 15m, 1h, 4h, D+ (diario ou maior)
//
//  Total: 6 buckets × 6 parametros = 36 inputs editaveis.
//
//  O QUE CADA PARAMETRO CONTROLA? (linguagem simples)
//
//   ───────────────────────────────────────────────────────────────────────
//   PARAM     | O QUE FAZ                       | AUMENTAR        | DIMINUIR
//   ───────────────────────────────────────────────────────────────────────
//   swing     | Tamanho do "topo/fundo" valido  | menos topos     | mais topos
//             | em quantidade de bars           | (mais confiavel)| (mais sinais)
//   ───────────────────────────────────────────────────────────────────────
//   fvgAtr    | Tamanho minimo de gap (FVG)     | so FVGs grandes | aceita FVG
//             | em multiplos do ATR             |                 | pequenos
//   ───────────────────────────────────────────────────────────────────────
//   volMult   | Volume minimo para validar      | so OBs com      | aceita OBs
//             | um Order Block (OB)             | volume forte    | volume medio
//   ───────────────────────────────────────────────────────────────────────
//   obAge     | Idade maxima do OB ate sumir    | OBs duram mais  | so OBs
//             | em bars                         |                 | recentes
//   ───────────────────────────────────────────────────────────────────────
//   liqPct    | Tolerancia % pra agrupar topos  | agrupa precos   | mais zonas
//             | e fundos parecidos (liquidez)   | distantes       | separadas
//   ───────────────────────────────────────────────────────────────────────
//   mssDisp   | Tamanho do MSS (deslocamento)   | so MSS forte    | aceita MSS
//             | em multiplos do ATR             | (mais raro)     | medio
//   ───────────────────────────────────────────────────────────────────────
//
//  VALORES PADRÃO POR TF (já vem assim — funciona pra BTC)
//
//   TF   | swing | fvgAtr | volMult | obAge | liqPct | mssDisp
//   ─────|───────|────────|─────────|───────|────────|────────
//   1m   |   5   |  0.3   |   1.3   |  100  |  0.05  |   1.5
//   5m   |   7   |  0.4   |   1.5   |   80  |  0.10  |   1.5
//   15m  |  10   |  0.5   |   1.5   |   60  |  0.15  |   1.5
//   1h   |  12   |  0.6   |   1.7   |   50  |  0.20  |   1.5
//   4h   |  15   |  0.7   |   2.0   |   40  |  0.30  |   1.7
//   D+   |  20   |  0.8   |   2.0   |   30  |  0.50  |   2.0
//
//  Quanto maior o TF, mais conservador (numeros maiores, menos sinais).
//  Quanto menor o TF, mais sensivel (numeros menores, mais sinais).
//
//  EXEMPLOS DE AJUSTE (para casos reais)
//
//  CASO 1 — "Tenho muitos trades ruins no 15m. Quero filtrar mais."
//    Vai na linha 15m do Grupo 10 e faz:
//    - swing: 10 -> 14 (so topos/fundos mais maduros)
//    - volMult: 1.5 -> 2.0 (so OBs com volume forte)
//    - mssDisp: 1.5 -> 2.0 (so quebras de estrutura grandes)
//    Resultado: menos trades, qualidade melhor.
//
//  CASO 2 — "Estou no 1h e quase nao aparece sinal. Quero mais."
//    Vai na linha 1h do Grupo 10 e faz:
//    - swing: 12 -> 8 (topos/fundos mais ageis)
//    - fvgAtr: 0.6 -> 0.4 (aceita FVGs menores)
//    - volMult: 1.7 -> 1.4 (aceita OBs com volume medio)
//    Resultado: mais trades, talvez menos confiaveis.
//
//  CASO 3 — "Quero usar so em criptos voláteis tipo SOL/AVAX no 5m."
//    Vai na linha 5m do Grupo 10 e faz:
//    - swing: 7 -> 5 (mais agil em movimentos rapidos)
//    - liqPct: 0.10 -> 0.15 (agrupa precos mais distantes)
//    - obAge: 80 -> 50 (OBs vencem mais rapido)
//
//  CASO 4 — "Estou no D+ pra operar swings de dias. Quero ainda menos ruido."
//    Vai na linha D+ do Grupo 10 e faz:
//    - swing: 20 -> 30 (so swings muito grandes)
//    - volMult: 2.0 -> 2.5 (so OBs muito fortes)
//    - mssDisp: 2.0 -> 2.5 (so quebras gigantes)
//
//  ATALHO PRO TUNING AUTOMATICO
//
//  Em vez de chutar valores, ative o self-tune no Grupo 9 (default ON).
//  Espera o chart carregar todo o historico. A tabela de 27 combos vai
//  aparecer no canto direito do meio. O combo destacado em VERDE é o
//  melhor para o periodo testado. Anote o EThr, VMult e RRmin dele e
//  aplique manualmente nos inputs principais. Depois desliga o self-tune
//  pra usar o setup escolhido em modo "production".
//
//  "OVERRIDE MANUAL" — IGNORANDO O GRUPO 10
//
//  Se voce ja sabe os valores que quer usar e nao quer que o TF mude nada,
//  liga o "Override manual de presets" no Grupo 1. Daí ele usa os campos
//  "Swing length (manual)", "ATR period", "MSS displacement", etc.
//  do Grupo 1, 2 e 3 — IGNORANDO os presets do Grupo 10.
//
//  ⚠️  AVISO: tunar muito reduz a robustez. Se voce ajusta cada TF e cada
//  ativo individualmente, voce esta fazendo overfitting. Tunagem de UM TF/ativo
//  por sessao, com walk-forward (in-sample / out-of-sample), eh o caminho.
//
// =====================================================================================
//  ALERTAS / WEBHOOKS (opcional, avancado)
// =====================================================================================
//
//  A estrategia emite alertas com JSON estruturado para integracao com
//  bot/broker via webhook:
//    - Entry: {"action":"buy/sell","symbol":"...","sl":"...","tp1":"...","tp2":"...","score":...}
//    - Exit:  {"action":"exit_long_tp1","symbol":"...","price":"..."}
//
//  Para usar Self-Tune publish (Group 9):
//    1. Preencha "Webhook secret" no input com o token do seu backend
//    2. Crie um TV alert com "alert() function calls only" + webhook URL
//    3. Backend recebera os 27 combos a cada flip do vencedor
//
// =====================================================================================
//  DISCLAIMER
// =====================================================================================
//
//  Esta estrategia NAO eh garantia de lucro. Backtests em historico NAO se
//  replicam exatamente em live. Sempre comece com PAPER TRADING. Risco e
//  responsabilidade do operador. Os autores nao se responsabilizam por
//  perdas financeiras.
//
//  Use por sua conta e risco. Markets are tough. Trade safe.
//
// =====================================================================================
//  CHANGELOG
// =====================================================================================
//
//  v0.4.0 (2026-05-20) — Perfis de Risco + Menu PT-BR
//    - NOVO Grupo 11: Perfil de Risco (atalho rapido) — dropdown unico que ajusta
//      10 parametros coordenadamente:
//        * Personalizado (default) = usa os valores manuais dos Grupos 4 e 8
//        * Conservador  = risco 1%, pontuacao 75, F1+F4 ON, trailing+BE ON, min 4 fatores
//        * Equilibrado  = risco 2%, pontuacao 65, sem F obrig., trailing+BE ON, min 3 fatores
//        * Agressivo    = risco 3%, pontuacao 55, sem F obrig., trailing+BE OFF, min 3 fatores
//    - Todos os 114 inputs anteriores traduzidos para portugues claro (v0.3.0 mesclada)
//    - Tooltips uniformes em 3 linhas (O que faz / Quando usar / Exemplo)
//    - Glossario SMC no header (24 siglas explicadas)
//    - Defaults, ORDEM de inputs e nomes de variaveis Pine: PRESERVADOS
//      (suas configuracoes existentes MIGRAM automaticamente)
//    - Backend webhook (pubhub): formato JSON INALTERADO
//
//  v0.3.0 — Menu PT-BR (mesclado em v0.4.0, nao publicado isoladamente)
//
//  v0.2.0 (2026-05-19) — UX + Quality
//    - Group 10: presets adaptativos por TF agora editaveis (36 inputs)
//    - Position picker: 9 anchors configuraveis para HUD/MTF/SelfTune
//    - Rays Entry/SL/TP/TP2 com extend.right + labels (price+side)
//    - Dashboard BE com 5 estados claros
//    - Granular factor toggles (5 hard requirements opcionais)
//    - MTF Confluence Dashboard (7 TFs + Overall)
//    - Self-tune shadow simulator agora replica Fix A + Fix B (vencedor confiavel)
//
//  v0.1.4 (2026-04-28) — Diagnostic-Driven Fixes
//    - Fix A: Early move-to-BE @ 0.7R MFE
//    - Fix B: Structural trailing apos TP1
//    - Fix C: Sanity guards em Kelly sizing (skip se SL > 5% close)
//    - Resultado: estrategia virou lucrativa pela 1a vez (PF 1.186, +7.4% em 28 meses)
//
//  v0.1.0..v0.1.3 — Setup inicial + UX (status pin, SL/TP preview)
//
// =====================================================================================
//  IMPLEMENTACAO (notas tecnicas)
// =====================================================================================
//
//  - Heranca CORE: bloco CORE-START..CORE-END eh 1:1 com smc_indicator.pine
//  - Anti-repaint: barstate.isconfirmed + HTF com close[1]+lookahead_on
//  - Self-tune walk-forward: IS 70% / OOS 30%, composite score
//    PF_oos * Sharpe_oos * sqrt(trades) / (1 + MaxDD)
//    com penalty 50% se |PF_is - PF_oos| > 30%
//  - Constraints validos: trades >= 20, MaxDD <= 25%, WR >= 35%, Sharpe >= 0.8
//
// =====================================================================================
strategy(
     title                       = "DeFiers-SMC Strategy por mmello27 e Claude Code OPUS-4.7",
     shorttitle                  = "DSMC-S",
     overlay                     = true,
     initial_capital             = 10000,
     default_qty_type            = strategy.percent_of_equity,
     default_qty_value           = 2,
     commission_type             = strategy.commission.percent,
     commission_value            = 0.05,
     slippage                    = 2,
     pyramiding                  = 0,
     process_orders_on_close     = true,
     calc_on_every_tick          = true,
     max_boxes_count             = 500,
     max_lines_count             = 500,
     max_labels_count            = 500,
     risk_free_rate              = 2.0,
     close_entries_rule          = "FIFO"
 )

// =====================================================================================
// 1. INPUTS — replicacao do indicador + grupos 8 (Risk) e 9 (Self-Tune)
// =====================================================================================

// ---- Group 1: Estrutura de Mercado ---------------------------------------------------
GRP1 = "1. Estrutura de Mercado"
manualOverride       = input.bool(false, "Usar valores manuais (ignorar presets por TF)",
     group = GRP1,
     tooltip = "Quando LIGADO, ignora os presets por timeframe (Grupo 10) e usa os 6 valores manuais abaixo.\nDefault OFF (usa presets adaptativos — recomendado para 95% dos casos).\nLigue so se voce sabe o que esta fazendo.")
manualSwingLen       = input.int(10, "Tamanho do swing (deteccao de topos/fundos)", minval = 2, maxval = 50, group = GRP1,
     tooltip = "Quantidade de barras para identificar um topo ou fundo.\nMaior = topos/fundos mais significativos mas menos sinais.\nDefault 10. TF baixo (1m-5m) 6-8. TF alto (4h+) 14-20.")
atrPeriod            = input.int(14, "Periodo do ATR (medidor de volatilidade)", minval = 5, maxval = 50, group = GRP1,
     tooltip = "Periodo usado para calcular a volatilidade media (ATR).\nUsado em: tamanho de Stop Loss, validacao de FVG, gatilho de regime.\nDefault 14 (padrao da industria). Nao mude sem motivo.")
mssDispMult          = input.float(1.5, "Forca minima do rompimento (MSS em xATR)", minval = 0.5, maxval = 5, step = 0.1, group = GRP1,
     tooltip = "Quao forte tem que ser uma vela para confirmar mudanca de estrutura (MSS/CHoCH).\nMaior = mais rigoroso, menos sinais falsos mas perde rompimentos suaves.\nDefault 1.5. Conservador 2.0. Agressivo 1.0.")
maxPivots            = input.int(20, "Maximo de pivos no historico", minval = 5, maxval = 100, group = GRP1,
     tooltip = "Quantos topos/fundos manter na memoria.\nMaior = mais historico para confluencia, mas mais lento.\nDefault 20. Raramente precisa mudar.")

// ---- Group 2: Order Blocks & FVGs ----------------------------------------------------
GRP2 = "2. Blocos de Ordens (OB) e Lacunas (FVG)"
manualVolMult        = input.float(1.5, "Multiplicador de volume para validar OB", minval = 1.0, maxval = 5.0, step = 0.1, group = GRP2,
     tooltip = "Vela precisa ter volume >= esse multiplicador vezes o volume medio para virar um Bloco de Ordens (OB).\nMaior = OBs mais raros e fortes. Menor = mais OBs mas alguns fracos.\nDefault 1.5x. Conservador 2.0x. Agressivo 1.2x.")
manualFvgMinAtr      = input.float(0.5, "Tamanho minimo do FVG (em xATR)", minval = 0.1, maxval = 3.0, step = 0.1, group = GRP2,
     tooltip = "Lacuna entre velas precisa ser >= esse multiplicador vezes o ATR para virar um FVG valido.\nMaior = filtra lacunas pequenas/irrelevantes.\nDefault 0.5x. Em cripto volatil pode subir para 0.7x.")
manualObMaxAge       = input.int(60, "Idade maxima do OB (em barras)", minval = 10, maxval = 500, group = GRP2,
     tooltip = "Quantas barras um OB permanece valido apos formado.\nApos esse limite o OB e descartado mesmo se nao foi tocado.\nDefault 60 barras. TF baixo 30-50. TF alto 80-120.")
fvgMaxAge            = input.int(80, "Idade maxima do FVG (em barras)", minval = 10, maxval = 500, group = GRP2,
     tooltip = "Quantas barras um FVG permanece valido apos formado.\nDefault 80 barras. Mesmo principio do OB age.")
maxOBs               = input.int(15, "Maximo de OB ativos simultaneos", minval = 3, maxval = 50, group = GRP2,
     tooltip = "Limita quantos Blocos de Ordens podem estar no chart ao mesmo tempo.\nQuando excede, o mais antigo e descartado.\nDefault 15. Limite de performance.")
maxFVGs              = input.int(20, "Maximo de FVG ativos simultaneos", minval = 5, maxval = 50, group = GRP2,
     tooltip = "Limita quantas Lacunas de Valor Justo podem estar no chart ao mesmo tempo.\nDefault 20. Limite de performance.")
obLookback           = input.int(20, "Janela de busca de OB apos rompimento (BOS)", minval = 3, maxval = 50, group = GRP2,
     tooltip = "Apos um rompimento de estrutura (BOS), olha X barras para tras para identificar o OB de origem.\nDefault 20 barras. Raramente precisa mudar.")

// ---- Group 3: Liquidez ---------------------------------------------------------------
GRP3 = "3. Zonas de Liquidez"
manualLiqRangePct    = input.float(0.15, "Tolerancia do agrupamento de liquidez (%)", minval = 0.01, maxval = 1.0, step = 0.01, group = GRP3,
     tooltip = "Topos/fundos a menos de X% de distancia sao agrupados como uma zona de liquidez unica.\nMaior = zonas mais largas e poucas. Menor = mais zonas e fragmentadas.\nDefault 0.15%. BTC em range largo: 0.25%.")
maxLiqLevels         = input.int(15, "Maximo de zonas de liquidez ativas", minval = 3, maxval = 30, group = GRP3,
     tooltip = "Quantas zonas de liquidez (BSL + SSL) manter no chart.\nDefault 15. Limite de performance.")
sweepRecencyBars     = input.int(15, "Janela para varredura de liquidez (barras)", minval = 3, maxval = 100, group = GRP3,
     tooltip = "Quantas barras para tras consideramos uma varredura de liquidez recente o suficiente para contar no fator F3.\nDefault 15 barras. TF baixo 10. TF alto 25.")

// ---- Group 4: Confluencia & Entrada --------------------------------------------------
GRP4 = "4. Filtros de Entrada e Pontuacao"
entryThreshold       = input.int(65, "Pontuacao minima Smart Money (0-100)", minval = 0, maxval = 100, group = GRP4,
     tooltip = "Pontuacao minima Smart Money para abrir trade (0 a 100).\nQuanto maior, mais seletivo: filtra setups fracos mas reduz numero de trades.\nConservador 75. Equilibrado 65 (default). Agressivo 55.")
requireFactors       = input.int(3, "Minimo de fatores ativos (0 a 5)", minval = 1, maxval = 5, group = GRP4,
     tooltip = "Quantos dos 5 fatores SMC precisam estar ativos para entrar.\nOs 5 fatores: F1=HTF alinhado, F2=Tendencia local, F3=Varredura, F4=OB/FVG, F5=Premium/Discount.\nDefault 3. Conservador 4. Muito rigoroso 5.")
htfBiasFilter        = input.bool(true, "Exigir tendencia do timeframe maior alinhada", group = GRP4,
     tooltip = "Quando LIGADO, soh entra LONG se HTF estiver bullish (e SHORT se HTF bearish).\nDefault ON (recomendado).")
htfTimeframe         = input.string("Auto", "Timeframe maior (HTF) — manual ou Auto", options = ["Auto", "15", "60", "240", "D", "W"], group = GRP4,
     tooltip = "Define qual timeframe usar como referencia maior (HTF) para o fator F1.\nAuto = escolhe automaticamente (ex: 15m chart usa 4h HTF; 1h usa Daily).\nForcar manual: 240 = 4h, D = Daily, W = Semanal.")
chochRecencyBars     = input.int(10, "Janela de validade de BOS/CHoCH (barras)", minval = 3, maxval = 50, group = GRP4,
     tooltip = "Quantas barras um sinal de BOS/CHoCH permanece valido para contar no fator F2.\nDefault 10 barras. TF baixo 6-8. TF alto 15-20.")
// Filtros granulares F1-F5: se LIGADO, esse fator vira EXIGENCIA OBRIGATORIA (alem do contador minimo acima)
requireF1HTF         = input.bool(false, "F1 — Exigir alinhamento com HTF",      group = GRP4, inline = "f_req_a",
     tooltip = "F1 — Quando LIGADO, exige que o timeframe maior (HTF) esteja na mesma direcao.\nFiltro forte: aumenta win-rate ~5-10pp mas reduz trades ~20-30%.\nDefault OFF. Ative se voce ja tem >50 trades de baseline.")
requireF2Trend       = input.bool(false, "F2 — Exigir tendencia local (BOS/CHoCH)",    group = GRP4, inline = "f_req_a",
     tooltip = "F2 — Quando LIGADO, exige BOS ou CHoCH recente na direcao do trade.\nFiltra entradas em mercado lateral.\nDefault OFF.")
requireF3Sweep       = input.bool(false, "F3 — Exigir varredura de liquidez",    group = GRP4, inline = "f_req_b",
     tooltip = "F3 — Quando LIGADO, exige varredura de liquidez recente (BSL para SHORT, SSL para LONG).\nFiltro classico de SMC.\nDefault OFF.")
requireF4POI         = input.bool(false, "F4 — Exigir entrada dentro de OB/FVG",      group = GRP4, inline = "f_req_b",
     tooltip = "F4 — Quando LIGADO, preco DEVE estar dentro de um Bloco de Ordens (OB) ou Lacuna (FVG) ativo no momento da entrada.\nDefault OFF.")
requireF5PremDisc    = input.bool(false, "F5 — Exigir zona Premium/Discount correta", group = GRP4, inline = "f_req_c",
     tooltip = "F5 — Quando LIGADO, LONG soh em zona Discount (metade inferior), SHORT soh em Premium (metade superior).\nDefault OFF.")
allowLongs           = input.bool(true, "Permitir trades de compra (LONG)", group = GRP4,
     tooltip = "Quando DESLIGADO, a estrategia nunca abre compras.\nUtil para mercados em downtrend forte. Default ON.")
allowShorts          = input.bool(true, "Permitir trades de venda (SHORT)", group = GRP4,
     tooltip = "Quando DESLIGADO, a estrategia nunca abre vendas.\nUtil para acoes long-only (B3) ou contas spot. Default ON.")

// ---- Group 5: Modo Adaptativo & Regime ----------------------------------------------
GRP5 = "5. Modo Adaptativo (Regime de Volatilidade)"
enableRegime         = input.bool(true, "Ajustar pontuacao conforme volatilidade do mercado", group = GRP5,
     tooltip = "Liga ajuste automatico da pontuacao com base na volatilidade atual.\nVolatilidade ALTA: pontuacao reduzida (mais cuidadoso). Volatilidade BAIXA: pontuacao aumentada (mais permissivo).\nDefault ON. Usa razao ATR atual / ATR medio.")
regimeHi             = input.float(1.5, "Limite de volatilidade ALTA (razao ATR)", minval = 1.1, maxval = 3.0, step = 0.1, group = GRP5,
     tooltip = "Acima desse valor (ATR atual / ATR medio), o regime e considerado ALTO.\nMaior = menos vezes entra em modo cauteloso.\nDefault 1.5.")
regimeLo             = input.float(0.7, "Limite de volatilidade BAIXA (razao ATR)", minval = 0.3, maxval = 0.9, step = 0.1, group = GRP5,
     tooltip = "Abaixo desse valor, o regime e considerado BAIXO.\nMenor = mais vezes entra em modo permissivo.\nDefault 0.7.")
regimeAdjPct         = input.float(20.0, "Intensidade do ajuste (%)", minval = 0, maxval = 50, step = 5, group = GRP5,
     tooltip = "Quanto a pontuacao Smart Money e ajustada pra cima/baixo conforme o regime.\nDefault 20% (sobe ou desce a pontuacao em ate 20 pontos).")

// ---- Group 6: Killzones --------------------------------------------------------------
GRP6 = "6. Horarios de Maior Liquidez (Killzones)"
killzoneMode         = input.string("Off", "Modo de filtro por horario",
     options = ["Off", "Weight (crypto -30%)", "Hard (forex/B3 block)"],
     group = GRP6,
     tooltip = "Filtra trades pelos horarios de alta liquidez (Londres / NY).\nOff = Desligado (ignora horario). Weight = peso F1 reduzido em -30% fora dos horarios (recomendado cripto).\nHard = bloqueia entrada fora dos horarios (recomendado forex / acoes B3).")
kzLondon             = input.session("0200-0500:1234567", "Abertura de Londres", group = GRP6,
     tooltip = "Horario da abertura de Londres no fuso configurado.\nDefault 02:00-05:00 (NY time).")
kzNY                 = input.session("0700-1000:1234567", "Abertura de Nova York", group = GRP6,
     tooltip = "Horario da abertura de NY.\nDefault 07:00-10:00 (NY time).")
kzLondonClose        = input.session("1000-1200:1234567", "Fechamento de Londres", group = GRP6,
     tooltip = "Horario do fechamento de Londres.\nDefault 10:00-12:00 (NY time).")
kzTimezone           = input.string("America/New_York", "Fuso horario de referencia",
     options = ["America/New_York", "Europe/London", "UTC"], group = GRP6,
     tooltip = "Fuso horario usado para interpretar os horarios acima.\nDefault America/New_York (padrao SMC). Mude se voce raciocina em Londres ou UTC.")

// ---- Group 7: Visualizacao -----------------------------------------------------------
GRP7 = "7. Visualizacao e Aparencia"
showOB               = input.bool(true, "Mostrar Blocos de Ordens (OB)", group = GRP7,
     tooltip = "Desenha os retangulos de Blocos de Ordens (zonas institucionais) no chart.\nDefault ON.")
showFVG              = input.bool(true, "Mostrar Lacunas de Valor Justo (FVG)", group = GRP7,
     tooltip = "Desenha os retangulos das Lacunas de Valor Justo (gaps de liquidez) no chart.\nDefault ON.")
showLiq              = input.bool(true, "Mostrar Zonas de Liquidez", group = GRP7,
     tooltip = "Desenha as linhas horizontais de liquidez (topos e fundos institucionais).\nDefault ON.")
showPremDisc         = input.bool(true, "Mostrar zonas Premium/Discount", group = GRP7,
     tooltip = "Desenha as zonas Premium (vermelha) e Discount (azul) — metade superior/inferior do range atual.\nDefault ON.")
showOTE              = input.bool(true, "Mostrar OTE (Entrada Otima) 62/70.5/79", group = GRP7,
     tooltip = "Desenha a zona de Entrada Otima (Optimal Trade Entry) — niveis de Fibo 62/70.5/79.\nDefault ON.")
showStructure        = input.bool(true, "Mostrar etiquetas BOS / CHoCH", group = GRP7,
     tooltip = "Desenha as etiquetas BOS (Quebra de Estrutura) e CHoCH (Mudanca de Carater) nos pontos onde ocorrem.\nDefault ON.")
showSweeps           = input.bool(true, "Mostrar marcadores de varredura de liquidez", group = GRP7,
     tooltip = "Marca com setas as varreduras de liquidez (sweeps) — topos e fundos rompidos e revertidos.\nDefault ON.")
showHUD              = input.bool(true, "Mostrar painel HUD principal", group = GRP7,
     tooltip = "Painel grande no canto com Tendencia, Pontuacao, Zona, Saldo, Acerto e Protecao Stop.\nDefault ON.")
showSLTPLines        = input.bool(true, "Mostrar linhas SL/TP do trade aberto", group = GRP7,
     tooltip = "Quando ha trade aberto, desenha linhas horizontais de Stop, TP1 e TP2 com etiquetas.\nDefault ON.")
showSelfTune         = input.bool(true, "Mostrar tabela do Auto-Tuning", group = GRP7,
     tooltip = "Tabela com 27 combinacoes parametricas e suas metricas (PF, Sharpe, vencedor).\nDefault ON.")
showMTFDash          = input.bool(true, "Mostrar painel MTF (multi-timeframe)", group = GRP7,
     tooltip = "Tabela mostrando Tendencia/Sinal/Confluencia em 7 timeframes (1D/12H/4H/1H/30M/15M/5M) + Overall.\nDefault ON.")

// Posicionamento dos dashboards (Pine v6 ancora em 1 dos 9 anchors — sem floating real)
posOpts              = "top_left|top_center|top_right|middle_left|middle_center|middle_right|bottom_left|bottom_center|bottom_right"
hudPosStr            = input.string("top_right",    "Posicao do painel HUD",        group = GRP7,
     options = ["top_left", "top_center", "top_right", "middle_left", "middle_center", "middle_right", "bottom_left", "bottom_center", "bottom_right"],
     tooltip = "Onde ancorar o HUD principal no chart.\n'top_right' = canto superior direito (default). 'middle_center' simula central.\nNomes em ingles porque sao chaves internas do TradingView.")
mtfDashPosStr        = input.string("bottom_right", "Posicao do painel MTF", group = GRP7,
     options = ["top_left", "top_center", "top_right", "middle_left", "middle_center", "middle_right", "bottom_left", "bottom_center", "bottom_right"],
     tooltip = "Onde ancorar o painel MTF.\nDefault 'bottom_right'.")
tuneTblPosStr        = input.string("middle_right", "Posicao da tabela Auto-Tuning", group = GRP7,
     options = ["top_left", "top_center", "top_right", "middle_left", "middle_center", "middle_right", "bottom_left", "bottom_center", "bottom_right"],
     tooltip = "Onde ancorar a tabela do Auto-Tuning.\nDefault 'middle_right'.")

strToPos(string s) =>
    s == "top_left"      ? position.top_left      :
     s == "top_center"    ? position.top_center    :
     s == "top_right"     ? position.top_right     :
     s == "middle_left"   ? position.middle_left   :
     s == "middle_center" ? position.middle_center :
     s == "middle_right"  ? position.middle_right  :
     s == "bottom_left"   ? position.bottom_left   :
     s == "bottom_center" ? position.bottom_center :
     position.bottom_right

colBull              = input.color(color.new(#00aaff, 0), "Cor de alta (bullish)", group = GRP7)
colBear              = input.color(color.new(#ff3366, 0), "Cor de baixa (bearish)", group = GRP7)
colPOI               = input.color(color.new(#ffaa00, 0), "Cor da zona POI ativa", group = GRP7)
colMit               = input.color(color.new(#888888, 30), "Cor da zona ja mitigada", group = GRP7)
colPrem              = input.color(color.new(#ff3366, 88), "Cor de fundo da zona Premium", group = GRP7)
colDisc              = input.color(color.new(#00aaff, 88), "Cor de fundo da zona Discount", group = GRP7)
colOTE               = input.color(color.new(#ffaa00, 80), "Cor de fundo da zona OTE", group = GRP7)

// ---- Group 8: Risk Engine -----------------------------------------------------------
GRP8 = "8. Gestao de Risco e Posicao"
riskPctPerTrade      = input.float(2.0, "Risco por trade (% do capital)", minval = 0.1, maxval = 10.0, step = 0.1, group = GRP8,
     tooltip = "Porcentagem do capital arriscada em cada trade.\nTamanho da posicao e calculado tal que distancia_stop * qty = capital * %risco.\nConservador 1%. Equilibrado 2% (default). Agressivo 3% (so se WR > 50%).")
useKellySizing       = input.bool(false, "Usar tamanho fracionario de Kelly", group = GRP8,
     tooltip = "Kelly = formula matematica para tamanho otimo de aposta.\nSubstitui Risco por trade % por calculo automatico baseado em win-rate * R-multiplo.\nSO ATIVE quando tiver >30 trades fechados. Default OFF. Sempre use Fracao=0.25 (Kelly cheio quebra capital).")
kellyFraction        = input.float(0.25, "Fracao de Kelly (recomendado 0.25)", minval = 0.05, maxval = 1.0, step = 0.05, group = GRP8,
     tooltip = "Qual fracao do Kelly cheio usar.\n1.0 = Kelly full (PERIGOSO, drawdowns extremos). 0.25 = quarter Kelly (recomendado).\nDefault 0.25.")
kellyMinTrades       = input.int(30, "Trades minimos no historico para ativar Kelly", minval = 10, maxval = 200, group = GRP8,
     tooltip = "Quantos trades fechados sao necessarios antes do Kelly comecar a ser usado.\nAbaixo desse limite, usa Risco por trade % normal.\nDefault 30.")

slBufferAtr          = input.float(0.5, "Folga do Stop Loss (em xATR)", minval = 0.0, maxval = 3.0, step = 0.1, group = GRP8,
     tooltip = "Distancia adicional alem do swing/OB para colocar o Stop Loss.\nMaior = SL mais longe, menos stop-outs mas tamanho de posicao menor.\nDefault 0.5x. Conservador 0.8x.")
useTpLiquidity       = input.bool(true, "Usar liquidez oposta como TP2 (com RR fixo de reserva)", group = GRP8,
     tooltip = "Quando LIGADO, TP2 e colocado na proxima zona de liquidez oposta.\nSe nao houver liquidez identificada, usa RR fixo (TP2 alvo abaixo).\nDefault ON.")
rrTp1                = input.float(1.5, "Risco/Retorno minimo do TP1 (multiplo de SL)", minval = 0.5, maxval = 5.0, step = 0.1, group = GRP8,
     tooltip = "Distancia do TP1 em multiplos da distancia do Stop.\nEx: 1.5 = TP1 a 1.5x a distancia do SL. Ganha 1.5x o stop.\nDefault 1.5. Mais agressivo 2.0.")
rrTp2                = input.float(3.0, "Risco/Retorno alvo do TP2 (multiplo de SL)", minval = 1.0, maxval = 10.0, step = 0.1, group = GRP8,
     tooltip = "Usado apenas como reserva se nao ha liquidez oposta identificada.\nDefault 3.0 (TP2 a 3x a distancia do SL).")
tp1QtyPct            = input.float(50.0, "% da posicao fechada no TP1 (restante vai p/ TP2)", minval = 10, maxval = 100, step = 5, group = GRP8,
     tooltip = "Quanto % da posicao fechar no primeiro alvo (TP1).\nO restante vai para TP2 com trailing estrutural.\nDefault 50%. Conservador 70%.")
useTrailing          = input.bool(true, "Trailing estrutural apos TP1 (segue HL/LH)", group = GRP8,
     tooltip = "Apos TP1 atingido, SL move para break-even (preco de entrada).\nDepois move para cada novo Higher Low (LONG) ou Lower High (SHORT).\nDefault ON.")
useEarlyBE           = input.bool(true, "Mover SL para break-even quando MFE >= gatilho", group = GRP8,
     tooltip = "Move o Stop Loss para o preco de entrada (break-even) ANTES de atingir TP1.\nGatilho: lucro flutuante (MFE) >= gatilho * distancia do Stop.\nReduz risco mas pode tirar voce de trades vencedores prematuramente. Default ON.")
earlyBeRr            = input.float(0.7, "Gatilho do BE antecipado (multiplo de R)", minval = 0.3, maxval = 1.5, step = 0.1, group = GRP8,
     tooltip = "Em que multiplo do Risco o BE antecipado dispara.\nMenor = move pra BE mais cedo (proteje mais, sai mais cedo).\nDefault 0.7.")
maxStopPctClose      = input.float(5.0, "Distancia maxima do Stop (% do preco)", minval = 0.5, maxval = 20.0, step = 0.5, group = GRP8,
     tooltip = "Pula entrada se o Stop estiver a mais de X% do preco atual.\nEvita posicoes minusculas (qty colapsada) e margin calls em ativos super volateis.\nDefault 5%.")
minQty               = input.float(0.001, "Quantidade minima por trade (unidades, ex: 0.001 BTC)", minval = 0.0, step = 0.001, group = GRP8,
     tooltip = "Pula entrada se a quantidade calculada for menor que esse valor.\nEvita posicoes 'dust' (po) que nem cobrem a comissao.\nDefault 0.001 (BTC). Ajuste por ativo.")

useMaxDDcb           = input.bool(true, "Trava de seguranca: drawdown maximo 25%", group = GRP8,
     tooltip = "Trava de seguranca: para de abrir trades novos quando o drawdown total atingir 25%.\nProtege capital em sequencias de losses.\nDefault ON. Recomendado manter ligado.")
useMaxIntraLossCb    = input.bool(false, "Trava de seguranca: perda diaria maxima 3%", group = GRP8,
     tooltip = "Trava de seguranca: para de abrir trades novos no dia se a perda diaria atingir 3% do capital.\nReseta no dia seguinte.\nDefault OFF.")

// ---- Group 9: Self-Tune --------------------------------------------------------------
GRP9 = "9. Auto-Tuning (otimizacao automatica)"
enableSelfTune       = input.bool(true, "Ativar Auto-Tuning (simulador paralelo de 27 combos)", group = GRP9,
     tooltip = "Roda em paralelo 27 combinacoes diferentes (Threshold x Volume x RR) na sombra.\nMostra qual combo tem melhor PF/Sharpe em janela in-sample 70% / out-of-sample 30%.\nPesado: pode atrasar o chart em TFs baixos. Default ON.")
selfTuneIsRatio      = input.float(0.70, "Proporcao de dados para treino (in-sample)", minval = 0.5, maxval = 0.9, step = 0.05, group = GRP9,
     tooltip = "Quanto do historico vai pra IN-SAMPLE (treino) vs OUT-OF-SAMPLE (teste).\nDefault 0.70 = 70% treino, 30% teste. Padrao walk-forward.")
selfTuneAnnualBars   = input.int(35040, "Barras por ano (para anualizar o Sharpe)", minval = 252, maxval = 525600, group = GRP9,
     tooltip = "Quantidade de barras em 1 ano calendarico no TF atual. Usado pra anualizar o Sharpe Ratio.\nDaily = 252 (dias uteis). 1h cripto = 8760. 15m cripto = 35040. 5m = 105120.\nAjuste se mudar de TF.")
selfTuneWebhookSecret = input.string("", "Senha do webhook (TV_WEBHOOK_SECRET) — opcional", group = GRP9,
     tooltip = "Token compartilhado com seu backend FastAPI em /webhook/self_tune.\nPREENCHA AQUI NO CHART (nao no codigo). Deixe vazio para desligar o envio.\nConfigure um alerta TV nesta strategy com alert() function calls only apontando para http(s)://seu-host/webhook/self_tune.")
selfTuneEmitMode      = input.string("On winner change", "Quando emitir alerta de Auto-Tuning", options = ["On winner change", "Every bar close"], group = GRP9,
     tooltip = "On winner change = 1 alerta apenas quando o vencedor muda (recomendado).\nEvery bar close = 1 alerta por barra (gera muito ruido).")

// ---- Group 10: Presets Adaptativos por TF (editaveis) ------------------------------
// Cada bucket de TF (1m / 5m / 15m / 1h / 4h / D+) tem 6 parametros editaveis:
//   swing   = Swing length (pivot detection)
//   fvgAtr  = FVG min size em xATR
//   volMult = Multiplicador de volume para OB validation
//   obAge   = OB max age em bars
//   liqPct  = Liquidity cluster tolerance %
//   mss     = MSS displacement em xATR
//
// Defaults reproducem os valores hardcoded da v0.1.4. Edite para tunar por TF
// sem mexer no codigo. Modo manual override (group 1) ignora estes valores.
GRP10 = "10. Avancado — Presets por Timeframe"

// === 1m bucket (tfSecs <= 60) ===
p1m_swing   = input.int(5,    "1m   | Swing", group = GRP10, inline = "1m_a", minval = 2, maxval = 50,
     tooltip = "Presets do bucket 1m (chart com TF de ate 1 minuto).\nSwing = tamanho do swing. FVG min = tamanho minimo do FVG.\nVol mult = multiplicador de volume para validar OB.")
p1m_fvgAtr  = input.float(0.3,"FVG min",      group = GRP10, inline = "1m_a", minval = 0.1, maxval = 3.0, step = 0.1)
p1m_volMult = input.float(1.3,"Vol mult",     group = GRP10, inline = "1m_a", minval = 1.0, maxval = 5.0, step = 0.1)
p1m_obAge   = input.int(100,  "1m   | OB age",group = GRP10, inline = "1m_b", minval = 10, maxval = 500,
     tooltip = "OB age = idade maxima do OB em barras.\nLiq % = tolerancia do agrupamento de liquidez.\nMSS disp = forca minima do rompimento em xATR.")
p1m_liqPct  = input.float(0.05,"Liq %",       group = GRP10, inline = "1m_b", minval = 0.01, maxval = 1.0, step = 0.01)
p1m_mssDisp = input.float(1.5,"MSS disp",     group = GRP10, inline = "1m_b", minval = 0.5, maxval = 5.0, step = 0.1)

// === 5m bucket (tfSecs <= 300) ===
p5m_swing   = input.int(7,    "5m   | Swing", group = GRP10, inline = "5m_a", minval = 2, maxval = 50,
     tooltip = "Presets do bucket 5m (chart com TF de ate 5 minutos).")
p5m_fvgAtr  = input.float(0.4,"FVG min",      group = GRP10, inline = "5m_a", minval = 0.1, maxval = 3.0, step = 0.1)
p5m_volMult = input.float(1.5,"Vol mult",     group = GRP10, inline = "5m_a", minval = 1.0, maxval = 5.0, step = 0.1)
p5m_obAge   = input.int(80,   "5m   | OB age",group = GRP10, inline = "5m_b", minval = 10, maxval = 500)
p5m_liqPct  = input.float(0.10,"Liq %",       group = GRP10, inline = "5m_b", minval = 0.01, maxval = 1.0, step = 0.01)
p5m_mssDisp = input.float(1.5,"MSS disp",     group = GRP10, inline = "5m_b", minval = 0.5, maxval = 5.0, step = 0.1)

// === 15m bucket (tfSecs <= 900) ===
p15m_swing   = input.int(10,  "15m  | Swing", group = GRP10, inline = "15m_a", minval = 2, maxval = 50,
     tooltip = "Presets do bucket 15m (chart com TF de ate 15 minutos). Mais usado em SMC.")
p15m_fvgAtr  = input.float(0.5,"FVG min",     group = GRP10, inline = "15m_a", minval = 0.1, maxval = 3.0, step = 0.1)
p15m_volMult = input.float(1.5,"Vol mult",    group = GRP10, inline = "15m_a", minval = 1.0, maxval = 5.0, step = 0.1)
p15m_obAge   = input.int(60,  "15m  | OB age",group = GRP10, inline = "15m_b", minval = 10, maxval = 500)
p15m_liqPct  = input.float(0.15,"Liq %",      group = GRP10, inline = "15m_b", minval = 0.01, maxval = 1.0, step = 0.01)
p15m_mssDisp = input.float(1.5,"MSS disp",    group = GRP10, inline = "15m_b", minval = 0.5, maxval = 5.0, step = 0.1)

// === 1h bucket (tfSecs <= 3600) ===
p1h_swing   = input.int(12,   "1h   | Swing", group = GRP10, inline = "1h_a", minval = 2, maxval = 50,
     tooltip = "Presets do bucket 1h (chart com TF de ate 1 hora).")
p1h_fvgAtr  = input.float(0.6,"FVG min",      group = GRP10, inline = "1h_a", minval = 0.1, maxval = 3.0, step = 0.1)
p1h_volMult = input.float(1.7,"Vol mult",     group = GRP10, inline = "1h_a", minval = 1.0, maxval = 5.0, step = 0.1)
p1h_obAge   = input.int(50,   "1h   | OB age",group = GRP10, inline = "1h_b", minval = 10, maxval = 500)
p1h_liqPct  = input.float(0.20,"Liq %",       group = GRP10, inline = "1h_b", minval = 0.01, maxval = 1.0, step = 0.01)
p1h_mssDisp = input.float(1.5,"MSS disp",     group = GRP10, inline = "1h_b", minval = 0.5, maxval = 5.0, step = 0.1)

// === 4h bucket (tfSecs <= 14400) ===
p4h_swing   = input.int(15,   "4h   | Swing", group = GRP10, inline = "4h_a", minval = 2, maxval = 50,
     tooltip = "Presets do bucket 4h (chart com TF de ate 4 horas).")
p4h_fvgAtr  = input.float(0.7,"FVG min",      group = GRP10, inline = "4h_a", minval = 0.1, maxval = 3.0, step = 0.1)
p4h_volMult = input.float(2.0,"Vol mult",     group = GRP10, inline = "4h_a", minval = 1.0, maxval = 5.0, step = 0.1)
p4h_obAge   = input.int(40,   "4h   | OB age",group = GRP10, inline = "4h_b", minval = 10, maxval = 500)
p4h_liqPct  = input.float(0.30,"Liq %",       group = GRP10, inline = "4h_b", minval = 0.01, maxval = 1.0, step = 0.01)
p4h_mssDisp = input.float(1.7,"MSS disp",     group = GRP10, inline = "4h_b", minval = 0.5, maxval = 5.0, step = 0.1)

// === D+ bucket (tfSecs > 14400) ===
pD_swing    = input.int(20,   "D+   | Swing", group = GRP10, inline = "D_a", minval = 2, maxval = 50,
     tooltip = "Presets do bucket D+ (chart com TF de Daily ou superior).")
pD_fvgAtr   = input.float(0.8,"FVG min",      group = GRP10, inline = "D_a", minval = 0.1, maxval = 3.0, step = 0.1)
pD_volMult  = input.float(2.0,"Vol mult",     group = GRP10, inline = "D_a", minval = 1.0, maxval = 5.0, step = 0.1)
pD_obAge    = input.int(30,   "D+   | OB age",group = GRP10, inline = "D_b", minval = 10, maxval = 500)
pD_liqPct   = input.float(0.50,"Liq %",       group = GRP10, inline = "D_b", minval = 0.01, maxval = 1.0, step = 0.01)
pD_mssDisp  = input.float(2.0,"MSS disp",     group = GRP10, inline = "D_b", minval = 0.5, maxval = 5.0, step = 0.1)

// ---- Group 11: Perfil de Risco (atalho rapido) ---------------------------------------
GRP11 = "11. Perfil de Risco (atalho rapido)"
profilePreset        = input.string("Personalizado", "Perfil de risco (sobrescreve varios parametros)",
     options = ["Personalizado", "Conservador", "Equilibrado", "Agressivo"],
     group = GRP11,
     tooltip = "Atalho que sobrescreve varios parametros de uma vez.\nPersonalizado = usa os valores que voce configurou manualmente nos Grupos 4 e 8 (preserva configuracoes existentes).\nConservador = risco 1%, pontuacao 75, F1+F4 ON, trailing+BE ON, min 4 fatores. Menos trades, maior win-rate.\nEquilibrado = risco 2%, pontuacao 65, sem F obrig., trailing+BE ON, min 3 fatores (defaults da estrategia).\nAgressivo = risco 3%, pontuacao 55, sem F obrig., trailing+BE OFF (deixa correr), min 3 fatores. Mais trades, maior R:R medio.")

// Valores efetivos — usados na logic ao inves dos inputs diretos quando perfil != Personalizado
isPersonalizado = profilePreset == "Personalizado"
isConservador   = profilePreset == "Conservador"
isEquilibrado   = profilePreset == "Equilibrado"
isAgressivo     = profilePreset == "Agressivo"

effRiskPct           = isConservador ? 1.0  : isEquilibrado ? 2.0 : isAgressivo ? 3.0 : riskPctPerTrade
effEntryThreshold    = isConservador ? 75   : isEquilibrado ? 65  : isAgressivo ? 55  : entryThreshold
effRequireFactors    = isConservador ? 4    : isEquilibrado ? 3   : isAgressivo ? 3   : requireFactors
effRequireF1HTF      = isConservador ? true : isPersonalizado ? requireF1HTF      : false
effRequireF2Trend    =                       isPersonalizado ? requireF2Trend    : false
effRequireF3Sweep    =                       isPersonalizado ? requireF3Sweep    : false
effRequireF4POI      = isConservador ? true : isPersonalizado ? requireF4POI      : false
effRequireF5PremDisc =                       isPersonalizado ? requireF5PremDisc : false
effUseTrailing       = isAgressivo ? false  : isPersonalizado ? useTrailing       : true
effUseEarlyBE        = isAgressivo ? false  : isPersonalizado ? useEarlyBE        : true

// =====================================================================================
// 2. ADAPTIVE PRESETS
// =====================================================================================

tfSecs = timeframe.in_seconds(timeframe.period)

type Preset
    int   swingLen
    float fvgMinAtr
    float volMult
    int   obMaxAge
    float liqRangePct
    float mssDisp

// Le do Group 10 (presets editaveis). Defaults reproducem v0.1.4 hardcoded.
resolvePreset() =>
    p = Preset.new(p15m_swing, p15m_fvgAtr, p15m_volMult, p15m_obAge, p15m_liqPct, p15m_mssDisp)
    if tfSecs <= 60
        p := Preset.new(p1m_swing,  p1m_fvgAtr,  p1m_volMult,  p1m_obAge,  p1m_liqPct,  p1m_mssDisp)
    else if tfSecs <= 300
        p := Preset.new(p5m_swing,  p5m_fvgAtr,  p5m_volMult,  p5m_obAge,  p5m_liqPct,  p5m_mssDisp)
    else if tfSecs <= 900
        p := Preset.new(p15m_swing, p15m_fvgAtr, p15m_volMult, p15m_obAge, p15m_liqPct, p15m_mssDisp)
    else if tfSecs <= 3600
        p := Preset.new(p1h_swing,  p1h_fvgAtr,  p1h_volMult,  p1h_obAge,  p1h_liqPct,  p1h_mssDisp)
    else if tfSecs <= 14400
        p := Preset.new(p4h_swing,  p4h_fvgAtr,  p4h_volMult,  p4h_obAge,  p4h_liqPct,  p4h_mssDisp)
    else
        p := Preset.new(pD_swing,   pD_fvgAtr,   pD_volMult,   pD_obAge,   pD_liqPct,   pD_mssDisp)
    p

resolveHtfTf() =>
    out = "240"
    if htfTimeframe != "Auto"
        out := htfTimeframe
    else
        if tfSecs <= 60
            out := "15"
        else if tfSecs <= 300
            out := "60"
        else if tfSecs <= 900
            out := "240"
        else if tfSecs <= 3600
            out := "D"
        else if tfSecs <= 14400
            out := "W"
        else
            out := "W"
    out

preset      = resolvePreset()
htfTF       = resolveHtfTf()

swingLen    = manualOverride ? manualSwingLen     : preset.swingLen
fvgMinAtr   = manualOverride ? manualFvgMinAtr    : preset.fvgMinAtr
volMult0    = manualOverride ? manualVolMult      : preset.volMult
obMaxAge    = manualOverride ? manualObMaxAge     : preset.obMaxAge
liqRangePct = manualOverride ? manualLiqRangePct  : preset.liqRangePct

// =====================================================================================
// 3. CORE-START — Detectores reutilizados do smc_indicator.pine
// =====================================================================================
// CORE-START

// ---- 3.1 Indicadores base ------------------------------------------------------------
atrVal       = ta.atr(atrPeriod)
volSma20     = ta.sma(volume, 20)

// ---- 3.2 Regime-aware adjustment -----------------------------------------------------
atrAvg100    = ta.sma(atrVal, 100)
regimeRatio  = atrAvg100 > 0 ? atrVal / atrAvg100 : 1.0

regimeFactor = 0.0
if enableRegime
    if regimeRatio > regimeHi
        regimeFactor := regimeAdjPct / 100.0
    else if regimeRatio < regimeLo
        regimeFactor := -regimeAdjPct / 100.0

volMultEff       = volMult0      * (1 + regimeFactor)
fvgMinAtrEff     = fvgMinAtr     * (1 + regimeFactor)
entryThreshEff   = math.round(effEntryThreshold + (regimeFactor * 25))

// Detection volMult: 1.3 (loosest) quando self-tune ON para permitir post-filter por combo.
// Quando OFF, usa volMultEff (consistente com o indicador).
volMultDetect = enableSelfTune ? 1.3 : volMultEff

// ---- 3.3 UDTs ------------------------------------------------------------------------
type Pivot
    float price
    int   bar
    bool  isHigh

type OB
    box   bx
    label lb
    float top
    float bot
    int   barIdx
    bool  isBull
    bool  mitigated
    float volRatio

type FVG
    box   bx
    float top
    float bot
    int   barIdx
    bool  isBull
    float fillPct
    bool  invertedActive

type LiqLevel
    line  ln
    label lb
    float price
    string kind
    int   touches
    bool  swept
    int   sweepBar

// ---- 3.4 State persistente -----------------------------------------------------------
var array<Pivot>     pivotsArr = array.new<Pivot>()
var array<OB>        obArr     = array.new<OB>()
var array<FVG>       fvgArr    = array.new<FVG>()
var array<LiqLevel>  liqArr    = array.new<LiqLevel>()

var int    trendState = 0
var float  lastHH     = na
var float  lastLL     = na
var int    lastHHbar  = na
var int    lastLLbar  = na
var int    lastBOSbar = na
var int    lastCHCbar = na
var int    lastSwpBar = na
var int    lastSwpDir = 0

var box  premiumBox    = na
var box  discountBox   = na
var box  oteBox        = na
var line equilibLine   = na

// ---- 3.5 Pivots / Estrutura ----------------------------------------------------------
ph = ta.pivothigh(swingLen, swingLen)
pl = ta.pivotlow(swingLen, swingLen)

if not na(ph)
    p = Pivot.new(ph, bar_index - swingLen, true)
    pivotsArr.push(p)
    lastHH    := ph
    lastHHbar := bar_index - swingLen
if not na(pl)
    p = Pivot.new(pl, bar_index - swingLen, false)
    pivotsArr.push(p)
    lastLL    := pl
    lastLLbar := bar_index - swingLen

while pivotsArr.size() > maxPivots
    pivotsArr.shift()

findLastHL() =>
    out = float(na)
    n = pivotsArr.size()
    if n >= 2
        prevLow = float(na)
        for i = 0 to n - 1
            piv = pivotsArr.get(i)
            if not piv.isHigh
                if not na(prevLow) and piv.price > prevLow
                    out := piv.price
                prevLow := piv.price
    out

findLastLH() =>
    out = float(na)
    n = pivotsArr.size()
    if n >= 2
        prevHigh = float(na)
        for i = 0 to n - 1
            piv = pivotsArr.get(i)
            if piv.isHigh
                if not na(prevHigh) and piv.price < prevHigh
                    out := piv.price
                prevHigh := piv.price
    out

lastHL = findLastHL()
lastLH = findLastLH()

// ---- 3.6 BOS / CHoCH / MSS -----------------------------------------------------------
bullBOS    = barstate.isconfirmed and not na(lastHH) and close > lastHH and trendState <= 0
bearBOS    = barstate.isconfirmed and not na(lastLL) and close < lastLL and trendState >= 0
bullCHoCH  = barstate.isconfirmed and trendState == -1 and not na(lastLH) and close > lastLH
bearCHoCH  = barstate.isconfirmed and trendState ==  1 and not na(lastHL) and close < lastHL

bodySize     = math.abs(close - open)
isDisplaced  = bodySize >= mssDispMult * atrVal
bullMSS      = bullCHoCH and isDisplaced
bearMSS      = bearCHoCH and isDisplaced

if bullBOS
    trendState := 1
    lastBOSbar := bar_index
    if showStructure
        line.new(lastHHbar, lastHH, bar_index, lastHH, color = colBull, style = line.style_dashed, width = 1)
        label.new(bar_index, lastHH, "BOS↑", style = label.style_label_down,
              color = color.new(colBull, 70), textcolor = colBull, size = size.normal)
if bearBOS
    trendState := -1
    lastBOSbar := bar_index
    if showStructure
        line.new(lastLLbar, lastLL, bar_index, lastLL, color = colBear, style = line.style_dashed, width = 1)
        label.new(bar_index, lastLL, "BOS↓", style = label.style_label_up,
              color = color.new(colBear, 70), textcolor = colBear, size = size.normal)
if bullCHoCH
    trendState := 1
    lastCHCbar := bar_index
    if showStructure
        label.new(bar_index, lastLH, bullMSS ? "MSS↑" : "CHoCH↑", style = label.style_label_down,
              color = color.new(colBull, 50), textcolor = color.white, size = size.normal)
if bearCHoCH
    trendState := -1
    lastCHCbar := bar_index
    if showStructure
        label.new(bar_index, lastHL, bearMSS ? "MSS↓" : "CHoCH↓", style = label.style_label_up,
              color = color.new(colBear, 50), textcolor = color.white, size = size.normal)

// ---- 3.7 Order Block detection (apos BOS) -------------------------------------------
// Funcoes recebem `trigger` como arg e sao chamadas top-level toda bar (consistencia v6).
findBullOB(bool trigger) =>
    out = false
    if trigger
        for i = 1 to obLookback
            if close[i] < open[i]
                volRatio = volSma20[i] > 0 ? volume[i] / volSma20[i] : 0.0
                if volRatio >= volMultDetect
                    bxLeft  = bar_index - i
                    bxRight = bar_index + 5
                    bxObj   = box.new(bxLeft, high[i], bxRight, low[i],
                                      bgcolor = color.new(colPOI, 75),
                                      border_color = colPOI, border_width = 1)
                    lbObj   = label.new(bxLeft, high[i], "OB↑ v" + str.tostring(volRatio, "#.##"),
                                        style = label.style_label_down,
                                        color = color.new(colPOI, 80),
                                        textcolor = colPOI, size = size.normal)
                    ob = OB.new(bxObj, lbObj, high[i], low[i], bxLeft, true, false, volRatio)
                    obArr.push(ob)
                    out := true
                    break
    out

findBearOB(bool trigger) =>
    out = false
    if trigger
        for i = 1 to obLookback
            if close[i] > open[i]
                volRatio = volSma20[i] > 0 ? volume[i] / volSma20[i] : 0.0
                if volRatio >= volMultDetect
                    bxLeft  = bar_index - i
                    bxRight = bar_index + 5
                    bxObj   = box.new(bxLeft, high[i], bxRight, low[i],
                                      bgcolor = color.new(colPOI, 75),
                                      border_color = colPOI, border_width = 1)
                    lbObj   = label.new(bxLeft, low[i], "OB↓ v" + str.tostring(volRatio, "#.##"),
                                        style = label.style_label_up,
                                        color = color.new(colPOI, 80),
                                        textcolor = colPOI, size = size.normal)
                    ob = OB.new(bxObj, lbObj, high[i], low[i], bxLeft, false, false, volRatio)
                    obArr.push(ob)
                    out := true
                    break
    out

// Top-level: chamadas toda bar; trigger combina showOB com BOS para evitar trabalho desnecessario
findBullOB(showOB and bullBOS)
findBearOB(showOB and bearBOS)

while obArr.size() > maxOBs
    o = obArr.shift()
    o.bx.delete()
    o.lb.delete()

if barstate.isconfirmed
    n = obArr.size()
    if n > 0
        for i = n - 1 to 0
            ob = obArr.get(i)
            if (bar_index - ob.barIdx) > obMaxAge
                ob.bx.delete()
                ob.lb.delete()
                obArr.remove(i)
                continue
            if not ob.mitigated
                if ob.isBull and close <= ob.top and close >= ob.bot
                    ob.mitigated := true
                    ob.bx.set_bgcolor(color.new(colMit, 85))
                    ob.bx.set_border_color(colMit)
                    ob.lb.set_textcolor(colMit)
                if not ob.isBull and close >= ob.bot and close <= ob.top
                    ob.mitigated := true
                    ob.bx.set_bgcolor(color.new(colMit, 85))
                    ob.bx.set_border_color(colMit)
                    ob.lb.set_textcolor(colMit)
            if not ob.mitigated
                ob.bx.set_right(bar_index + 5)

// ---- 3.8 Fair Value Gap detection ---------------------------------------------------
detectBullFVG = barstate.isconfirmed and (low > high[2]) and ((low - high[2]) >= fvgMinAtrEff * atrVal)
detectBearFVG = barstate.isconfirmed and (high < low[2]) and ((low[2] - high) >= fvgMinAtrEff * atrVal)

if showFVG and detectBullFVG
    bxObj = box.new(bar_index - 1, low, bar_index + 5, high[2],
              bgcolor = color.new(colBull, 85),
              border_color = color.new(colBull, 50), border_width = 1)
    fvg = FVG.new(bxObj, low, high[2], bar_index - 1, true, 0.0, false)
    fvgArr.push(fvg)

if showFVG and detectBearFVG
    bxObj = box.new(bar_index - 1, low[2], bar_index + 5, high,
              bgcolor = color.new(colBear, 85),
              border_color = color.new(colBear, 50), border_width = 1)
    fvg = FVG.new(bxObj, low[2], high, bar_index - 1, false, 0.0, false)
    fvgArr.push(fvg)

while fvgArr.size() > maxFVGs
    f = fvgArr.shift()
    f.bx.delete()

if barstate.isconfirmed
    nf = fvgArr.size()
    if nf > 0
        for i = nf - 1 to 0
            fvg = fvgArr.get(i)
            if (bar_index - fvg.barIdx) > fvgMaxAge
                fvg.bx.delete()
                fvgArr.remove(i)
                continue
            if fvg.fillPct < 1.0
                if fvg.isBull
                    if low <= fvg.top and high >= fvg.bot
                        rangeSize = math.max(1e-9, fvg.top - fvg.bot)
                        pen = math.max(0.0, fvg.top - math.max(low, fvg.bot)) / rangeSize
                        fvg.fillPct := math.max(fvg.fillPct, pen)
                        if close < fvg.bot
                            fvg.fillPct := 1.0
                            fvg.invertedActive := true
                else
                    if high >= fvg.bot and low <= fvg.top
                        rangeSize = math.max(1e-9, fvg.top - fvg.bot)
                        pen = math.max(0.0, math.min(high, fvg.top) - fvg.bot) / rangeSize
                        fvg.fillPct := math.max(fvg.fillPct, pen)
                        if close > fvg.top
                            fvg.fillPct := 1.0
                            fvg.invertedActive := true
            transp = int(85 - 30 * fvg.fillPct)
            transp := math.max(50, math.min(95, transp))
            fadeCol = fvg.isBull ? colBull : colBear
            if fvg.fillPct >= 1.0
                fvg.bx.set_bgcolor(color.new(colMit, 90))
                fvg.bx.set_border_color(colMit)
            else
                fvg.bx.set_bgcolor(color.new(fadeCol, transp))
            fvg.bx.set_right(bar_index + 5)

// ---- 3.9 Liquidity Zones (BSL/SSL) --------------------------------------------------
addLiquidityIfCluster(Pivot newPiv) =>
    added = false
    n = pivotsArr.size()
    if n >= 2
        for i = 0 to n - 2
            other = pivotsArr.get(i)
            if other.isHigh == newPiv.isHigh
                tolerance = math.max(liqRangePct * close / 100.0, 0.5 * atrVal)
                if math.abs(newPiv.price - other.price) <= tolerance
                    avgPx = (newPiv.price + other.price) / 2.0
                    duplicate = false
                    nl = liqArr.size()
                    if nl > 0
                        for j = 0 to nl - 1
                            lvl = liqArr.get(j)
                            if math.abs(lvl.price - avgPx) <= tolerance and lvl.kind == (newPiv.isHigh ? "BSL" : "SSL")
                                lvl.touches := lvl.touches + 1
                                duplicate := true
                                break
                    if not duplicate and showLiq
                        leftBar  = math.min(newPiv.bar, other.bar)
                        rightBar = bar_index + 10
                        kind     = newPiv.isHigh ? "BSL" : "SSL"
                        lnObj    = line.new(leftBar, avgPx, rightBar, avgPx,
                                       color = newPiv.isHigh ? colBear : colBull,
                                       style = line.style_dotted, width = 1)
                        lbObj    = label.new(rightBar, avgPx, kind,
                                       style = label.style_label_left,
                                       color = color.new(newPiv.isHigh ? colBear : colBull, 80),
                                       textcolor = color.white, size = size.normal)
                        liqArr.push(LiqLevel.new(lnObj, lbObj, avgPx, kind, 2, false, na))
                        added := true
                    break
    added

if not na(ph)
    addLiquidityIfCluster(Pivot.new(ph, bar_index - swingLen, true))
if not na(pl)
    addLiquidityIfCluster(Pivot.new(pl, bar_index - swingLen, false))

while liqArr.size() > maxLiqLevels
    lvl = liqArr.shift()
    lvl.ln.delete()
    lvl.lb.delete()

sweepBSLnow = false
sweepSSLnow = false
if barstate.isconfirmed
    nl = liqArr.size()
    if nl > 0
        for i = nl - 1 to 0
            lvl = liqArr.get(i)
            if not lvl.swept
                if lvl.kind == "BSL" and high > lvl.price and close < lvl.price
                    lvl.swept    := true
                    lvl.sweepBar := bar_index
                    sweepBSLnow  := true
                    lastSwpBar   := bar_index
                    lastSwpDir   := 1
                    lvl.ln.set_color(color.new(colBear, 50))
                    lvl.ln.set_style(line.style_solid)
                    lvl.lb.set_text("BSL ✗")
                    if showSweeps
                        label.new(bar_index, high, "SWEEP↑",
                              style = label.style_label_down,
                              color = color.new(colBear, 30),
                              textcolor = color.white, size = size.normal)
                if lvl.kind == "SSL" and low < lvl.price and close > lvl.price
                    lvl.swept    := true
                    lvl.sweepBar := bar_index
                    sweepSSLnow  := true
                    lastSwpBar   := bar_index
                    lastSwpDir   := -1
                    lvl.ln.set_color(color.new(colBull, 50))
                    lvl.ln.set_style(line.style_solid)
                    lvl.lb.set_text("SSL ✗")
                    if showSweeps
                        label.new(bar_index, low, "SWEEP↓",
                              style = label.style_label_up,
                              color = color.new(colBull, 30),
                              textcolor = color.white, size = size.normal)
            lvl.ln.set_x2(bar_index + 10)
            lvl.lb.set_x(bar_index + 10)

// ---- 3.10 Premium / Discount + OTE --------------------------------------------------
hasRange   = not na(lastHH) and not na(lastLL)
rangeTop   = hasRange ? math.max(lastHH, lastLL) : na
rangeBot   = hasRange ? math.min(lastHH, lastLL) : na
equilibrium = hasRange ? (rangeTop + rangeBot) / 2.0 : na

fib62  = hasRange ? (trendState >= 0 ? rangeTop - 0.620 * (rangeTop - rangeBot) : rangeBot + 0.620 * (rangeTop - rangeBot)) : na
fib705 = hasRange ? (trendState >= 0 ? rangeTop - 0.705 * (rangeTop - rangeBot) : rangeBot + 0.705 * (rangeTop - rangeBot)) : na
fib79  = hasRange ? (trendState >= 0 ? rangeTop - 0.790 * (rangeTop - rangeBot) : rangeBot + 0.790 * (rangeTop - rangeBot)) : na

if barstate.isconfirmed and hasRange and showPremDisc
    leftBar  = math.min(nz(lastHHbar, bar_index - 50), nz(lastLLbar, bar_index - 50))
    rightBar = bar_index + 10
    if na(premiumBox)
        premiumBox  := box.new(leftBar, rangeTop, rightBar, equilibrium,
                            bgcolor = colPrem, border_color = color.new(colBear, 70))
        discountBox := box.new(leftBar, equilibrium, rightBar, rangeBot,
                            bgcolor = colDisc, border_color = color.new(colBull, 70))
        equilibLine := line.new(leftBar, equilibrium, rightBar, equilibrium,
                            color = color.new(color.gray, 30), style = line.style_dashed, width = 1)
    else
        premiumBox.set_left(leftBar)
        premiumBox.set_right(rightBar)
        premiumBox.set_top(rangeTop)
        premiumBox.set_bottom(equilibrium)
        discountBox.set_left(leftBar)
        discountBox.set_right(rightBar)
        discountBox.set_top(equilibrium)
        discountBox.set_bottom(rangeBot)
        equilibLine.set_xy1(leftBar, equilibrium)
        equilibLine.set_xy2(rightBar, equilibrium)

if barstate.isconfirmed and hasRange and showOTE
    leftBar  = math.min(nz(lastHHbar, bar_index - 50), nz(lastLLbar, bar_index - 50))
    rightBar = bar_index + 10
    oteTop   = math.max(fib62, fib79)
    oteBot   = math.min(fib62, fib79)
    if na(oteBox)
        oteBox := box.new(leftBar, oteTop, rightBar, oteBot,
                            bgcolor = colOTE, border_color = color.new(colPOI, 60), border_width = 1)
    else
        oteBox.set_left(leftBar)
        oteBox.set_right(rightBar)
        oteBox.set_top(oteTop)
        oteBox.set_bottom(oteBot)

// ---- 3.11 HTF Bias ------------------------------------------------------------------
[htfClose, htfEma50] = request.security(syminfo.tickerid, htfTF,
     [close[1], ta.ema(close, 50)[1]],
     lookahead = barmerge.lookahead_on)

htfBullBias = not na(htfClose) and not na(htfEma50) and htfClose > htfEma50
htfBearBias = not na(htfClose) and not na(htfEma50) and htfClose < htfEma50

// ---- 3.12 Killzone (NY tz) -----------------------------------------------------------
inLondonOpen = not na(time(timeframe.period, kzLondon,        kzTimezone))
inNYOpen     = not na(time(timeframe.period, kzNY,            kzTimezone))
inLondonCls  = not na(time(timeframe.period, kzLondonClose,   kzTimezone))
inAnyKZ      = inLondonOpen or inNYOpen or inLondonCls

// ---- 3.13 POI proximity (parametrizada por volMult) --------------------------------
inBullPOIvm(float vmFilter) =>
    out = 0.0
    nob = obArr.size()
    if nob > 0
        for i = nob - 1 to 0
            ob = obArr.get(i)
            if not ob.mitigated and ob.isBull and ob.volRatio >= vmFilter and low <= ob.top and high >= ob.bot
                out := math.max(out, 1.0)
                break
    nf = fvgArr.size()
    if out < 0.7 and nf > 0
        for i = nf - 1 to 0
            fvg = fvgArr.get(i)
            if fvg.isBull and fvg.fillPct < 1.0 and low <= fvg.top and high >= fvg.bot
                out := math.max(out, 0.7)
                break
    if out < 0.5 and not na(fib79) and not na(fib62)
        oteHi = math.max(fib62, fib79)
        oteLo = math.min(fib62, fib79)
        if low <= oteHi and high >= oteLo
            out := math.max(out, 0.5)
    out

inBearPOIvm(float vmFilter) =>
    out = 0.0
    nob = obArr.size()
    if nob > 0
        for i = nob - 1 to 0
            ob = obArr.get(i)
            if not ob.mitigated and not ob.isBull and ob.volRatio >= vmFilter and low <= ob.top and high >= ob.bot
                out := math.max(out, 1.0)
                break
    nf = fvgArr.size()
    if out < 0.7 and nf > 0
        for i = nf - 1 to 0
            fvg = fvgArr.get(i)
            if not fvg.isBull and fvg.fillPct < 1.0 and low <= fvg.top and high >= fvg.bot
                out := math.max(out, 0.7)
                break
    if out < 0.5 and not na(fib79) and not na(fib62)
        oteHi = math.max(fib62, fib79)
        oteLo = math.min(fib62, fib79)
        if low <= oteHi and high >= oteLo
            out := math.max(out, 0.5)
    out

// ---- 3.14 Smart Money Score (real strategy = volMultEff) ---------------------------
barsSinceBOSorCHC = (na(lastBOSbar) ? 9999 : bar_index - lastBOSbar)
bsCHC             = (na(lastCHCbar) ? 9999 : bar_index - lastCHCbar)
barsSinceStruct   = math.min(barsSinceBOSorCHC, bsCHC)

f1Long  = htfBullBias ? 1.0 : 0.0
f1Short = htfBearBias ? 1.0 : 0.0
f2Long  = (trendState ==  1 and barsSinceStruct <= chochRecencyBars) ? 1.0 : 0.0
f2Short = (trendState == -1 and barsSinceStruct <= chochRecencyBars) ? 1.0 : 0.0

barsSinceSwp = na(lastSwpBar) ? 9999 : bar_index - lastSwpBar
f3Long  = (lastSwpDir == -1 and barsSinceSwp <= sweepRecencyBars) ? 1.0 : 0.0
f3Short = (lastSwpDir ==  1 and barsSinceSwp <= sweepRecencyBars) ? 1.0 : 0.0

f4Long  = inBullPOIvm(volMultEff)
f4Short = inBearPOIvm(volMultEff)

f5Long  = (hasRange and close <= equilibrium) ? 1.0 : 0.0
f5Short = (hasRange and close >= equilibrium) ? 1.0 : 0.0

// Killzone weight/block
kzMultiplier = 1.0
kzHardBlock  = false
if killzoneMode == "Weight (crypto -30%)" and not inAnyKZ
    kzMultiplier := 0.7
if killzoneMode == "Hard (forex/B3 block)" and not inAnyKZ
    kzHardBlock := true

scoreLong  = 100 * (0.25 * f1Long  * kzMultiplier + 0.20 * f2Long  + 0.20 * f3Long  + 0.20 * f4Long  + 0.15 * f5Long)
scoreShort = 100 * (0.25 * f1Short * kzMultiplier + 0.20 * f2Short + 0.20 * f3Short + 0.20 * f4Short + 0.15 * f5Short)

countActive(float a1, float a2, float a3, float a4, float a5) =>
    cnt = 0
    cnt := cnt + (a1 >= 1.0 ? 1 : 0)
    cnt := cnt + (a2 >= 1.0 ? 1 : 0)
    cnt := cnt + (a3 >= 1.0 ? 1 : 0)
    cnt := cnt + (a4 >= 0.5 ? 1 : 0)
    cnt := cnt + (a5 >= 1.0 ? 1 : 0)
    cnt

factorsLong  = countActive(f1Long,  f2Long,  f3Long,  f4Long,  f5Long)
factorsShort = countActive(f1Short, f2Short, f3Short, f4Short, f5Short)

htfBlockLong  = htfBiasFilter and htfBearBias
htfBlockShort = htfBiasFilter and htfBullBias

// Granular factor hard requirements (Group 4): se toggle ON, factor obrigatorio
hardFactorOkLong  = (not effRequireF1HTF or f1Long  >= 1.0) and (not effRequireF2Trend or f2Long  >= 1.0) and (not effRequireF3Sweep or f3Long  >= 1.0) and (not effRequireF4POI or f4Long  >= 0.5) and (not effRequireF5PremDisc or f5Long  >= 1.0)
hardFactorOkShort = (not effRequireF1HTF or f1Short >= 1.0) and (not effRequireF2Trend or f2Short >= 1.0) and (not effRequireF3Sweep or f3Short >= 1.0) and (not effRequireF4POI or f4Short >= 0.5) and (not effRequireF5PremDisc or f5Short >= 1.0)

baseEntryLong  = barstate.isconfirmed and allowLongs  and not htfBlockLong  and not kzHardBlock and scoreLong  >= entryThreshEff and factorsLong  >= effRequireFactors and hardFactorOkLong
baseEntryShort = barstate.isconfirmed and allowShorts and not htfBlockShort and not kzHardBlock and scoreShort >= entryThreshEff and factorsShort >= effRequireFactors and hardFactorOkShort

// CORE-END
// =====================================================================================

// =====================================================================================
// 4. RISK ENGINE — SL estrutural + TP1 (fixed RR) + TP2 (liquidez ou fixed RR)
// =====================================================================================

findNearestBSL(float refPrice) =>
    out = float(na)
    nl = liqArr.size()
    if nl > 0
        for i = 0 to nl - 1
            lvl = liqArr.get(i)
            if not lvl.swept and lvl.kind == "BSL" and lvl.price > refPrice
                if na(out) or lvl.price < out
                    out := lvl.price
    out

findNearestSSL(float refPrice) =>
    out = float(na)
    nl = liqArr.size()
    if nl > 0
        for i = 0 to nl - 1
            lvl = liqArr.get(i)
            if not lvl.swept and lvl.kind == "SSL" and lvl.price < refPrice
                if na(out) or lvl.price > out
                    out := lvl.price
    out

// SL estrutural: para LONG = lastLL - bufferATR; para SHORT = lastHH + bufferATR
slLongPx = na(lastLL)  ? close - 2 * atrVal : lastLL - slBufferAtr * atrVal
slShortPx = na(lastHH) ? close + 2 * atrVal : lastHH + slBufferAtr * atrVal

// TP1 sempre por RR fixo
stopDistL  = math.max(close - slLongPx,  atrVal * 0.1)
stopDistS  = math.max(slShortPx - close, atrVal * 0.1)
tp1LongPx  = close + rrTp1 * stopDistL
tp1ShortPx = close - rrTp1 * stopDistS

// TP2: liquidez ou RR fixo
nearestBSL = findNearestBSL(close)
nearestSSL = findNearestSSL(close)
tp2LongPx  = useTpLiquidity and not na(nearestBSL) and nearestBSL > tp1LongPx ? nearestBSL : close + rrTp2 * stopDistL
tp2ShortPx = useTpLiquidity and not na(nearestSSL) and nearestSSL < tp1ShortPx ? nearestSSL : close - rrTp2 * stopDistS

// R:R potencial para gating
rrPotentialLong  = stopDistL > 0 ? (tp2LongPx  - close) / stopDistL  : 0.0
rrPotentialShort = stopDistS > 0 ? (close - tp2ShortPx) / stopDistS : 0.0

entryLong  = baseEntryLong  and rrPotentialLong  >= rrTp1
entryShort = baseEntryShort and rrPotentialShort >= rrTp1

// =====================================================================================
// 5. POSITION SIZING — % equity ou Kelly fracionario
// =====================================================================================
historyTrades = strategy.closedtrades
historyWins   = strategy.wintrades
historyLoss   = strategy.losstrades
historyGP     = strategy.grossprofit
historyGL     = strategy.grossloss

computeKellyQty(float stopDist) =>
    qty = 0.0
    maxAcceptStop = close * (maxStopPctClose / 100.0)
    if stopDist <= 0 or stopDist > maxAcceptStop
        qty := 0.0
    else
        if useKellySizing and historyTrades >= kellyMinTrades and historyLoss > 0 and historyWins > 0
            winRate = float(historyWins) / float(math.max(1, historyTrades))
            avgWin  = historyGP / float(math.max(1, historyWins))
            avgLoss = historyGL / float(math.max(1, historyLoss))
            rRatio  = avgLoss > 0 ? avgWin / avgLoss : 1.0
            kellyPct = rRatio > 0 ? (winRate * rRatio - (1 - winRate)) / rRatio : 0.0
            kellyPct := math.max(0.0, math.min(0.5, kellyPct))
            riskAmt = strategy.equity * kellyPct * kellyFraction
            qty := riskAmt / stopDist
        else
            riskAmt = strategy.equity * (effRiskPct / 100.0)
            qty := riskAmt / stopDist
        if qty < minQty
            qty := 0.0
    qty

qtyLong  = computeKellyQty(stopDistL)
qtyShort = computeKellyQty(stopDistS)

// =====================================================================================
// 6. ORDER LAYER — entries + bracket TP1+TP2 + trailing
// =====================================================================================
var float plannedSL  = na
var float plannedTP1 = na
var float plannedTP2 = na
var bool  tp1Hit     = false
var float prevPosSize = 0.0

// 1. TP1 detection (position reduced but not closed) — uses prevPosSize antes de atualizar
if math.abs(strategy.position_size) > 0 and math.abs(strategy.position_size) < math.abs(prevPosSize) and not tp1Hit
    tp1Hit    := true
    plannedSL := strategy.position_avg_price   // BE move

// 2. Reset trade-state on flat (BEFORE entry, para nao apagar valores recem-setados)
if strategy.position_size == 0 and prevPosSize != 0
    plannedSL  := na
    plannedTP1 := na
    plannedTP2 := na
    tp1Hit     := false

// 3. Entry: only if flat
flatNow = strategy.position_size == 0

if entryLong and flatNow and qtyLong > 0
    strategy.entry("L", strategy.long, qty = qtyLong,
       alert_message = '{"action":"buy","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","price":"' + str.tostring(close, format.mintick) + '","sl":"' + str.tostring(slLongPx, format.mintick) + '","tp1":"' + str.tostring(tp1LongPx, format.mintick) + '","tp2":"' + str.tostring(tp2LongPx, format.mintick) + '","score":' + str.tostring(scoreLong, "#.0") + '}')
    plannedSL  := slLongPx
    plannedTP1 := tp1LongPx
    plannedTP2 := tp2LongPx
    tp1Hit     := false

if entryShort and flatNow and qtyShort > 0
    strategy.entry("S", strategy.short, qty = qtyShort,
       alert_message = '{"action":"sell","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","price":"' + str.tostring(close, format.mintick) + '","sl":"' + str.tostring(slShortPx, format.mintick) + '","tp1":"' + str.tostring(tp1ShortPx, format.mintick) + '","tp2":"' + str.tostring(tp2ShortPx, format.mintick) + '","score":' + str.tostring(scoreShort, "#.0") + '}')
    plannedSL  := slShortPx
    plannedTP1 := tp1ShortPx
    plannedTP2 := tp2ShortPx
    tp1Hit     := false

// Early move-to-BE: antes de TP1, se MFE atinge earlyBeRr*stopDist, move SL para entry
if effUseEarlyBE and not tp1Hit and not na(plannedSL) and strategy.position_size > 0
    entryPx       = strategy.position_avg_price
    initialStop   = entryPx - plannedSL
    if initialStop > 0 and (high - entryPx) >= earlyBeRr * initialStop
        if entryPx > plannedSL
            plannedSL := entryPx
if effUseEarlyBE and not tp1Hit and not na(plannedSL) and strategy.position_size < 0
    entryPx       = strategy.position_avg_price
    initialStop   = plannedSL - entryPx
    if initialStop > 0 and (entryPx - low) >= earlyBeRr * initialStop
        if entryPx < plannedSL
            plannedSL := entryPx

// Structural trailing (after TP1)
if effUseTrailing and tp1Hit and strategy.position_size > 0 and not na(lastHL) and not na(plannedSL)
    if lastHL - slBufferAtr * atrVal > plannedSL
        plannedSL := lastHL - slBufferAtr * atrVal
if effUseTrailing and tp1Hit and strategy.position_size < 0 and not na(lastLH) and not na(plannedSL)
    if lastLH + slBufferAtr * atrVal < plannedSL
        plannedSL := lastLH + slBufferAtr * atrVal

// Update brackets each bar while in position
if strategy.position_size > 0 and not na(plannedSL) and not na(plannedTP2)
    if not tp1Hit and not na(plannedTP1)
        strategy.exit("XTP1", from_entry = "L", qty_percent = tp1QtyPct,
                      limit = plannedTP1, stop = plannedSL,
                      alert_message = '{"action":"exit_long_tp1","symbol":"' + syminfo.ticker + '","price":"{{close}}"}')
    strategy.exit("XTP2", from_entry = "L",
                  limit = plannedTP2, stop = plannedSL,
                  alert_message = '{"action":"exit_long_tp2","symbol":"' + syminfo.ticker + '","price":"{{close}}"}')

if strategy.position_size < 0 and not na(plannedSL) and not na(plannedTP2)
    if not tp1Hit and not na(plannedTP1)
        strategy.exit("XTP1", from_entry = "S", qty_percent = tp1QtyPct,
                      limit = plannedTP1, stop = plannedSL,
                      alert_message = '{"action":"exit_short_tp1","symbol":"' + syminfo.ticker + '","price":"{{close}}"}')
    strategy.exit("XTP2", from_entry = "S",
                  limit = plannedTP2, stop = plannedSL,
                  alert_message = '{"action":"exit_short_tp2","symbol":"' + syminfo.ticker + '","price":"{{close}}"}')

// Update prevPosSize at the end of the bar
prevPosSize := strategy.position_size

// Visual SL/TP/Entry rays + labels (Real_Profit v3.1.8 pattern: extend.right + side+price)
var line  slLine     = na
var line  tp1Line    = na
var line  tp2Line    = na
var line  entryLine  = na
var label slLabel    = na
var label tp1Label   = na
var label tp2Label   = na
var label entryLabel = na

if showSLTPLines
    if strategy.position_size != 0
        entryPxR    = strategy.position_avg_price
        sideTag     = strategy.position_size > 0 ? "L" : "S"
        entryColR   = strategy.position_size > 0 ? colBull : colBear
        if na(slLine)
            slLine    := line.new(bar_index, plannedSL,  bar_index + 5, plannedSL,
                          extend = extend.right, color = color.red,    style = line.style_solid,  width = 2)
            tp1Line   := line.new(bar_index, plannedTP1, bar_index + 5, plannedTP1,
                          extend = extend.right, color = color.lime,   style = line.style_dashed, width = 1)
            tp2Line   := line.new(bar_index, plannedTP2, bar_index + 5, plannedTP2,
                          extend = extend.right, color = color.green,  style = line.style_dashed, width = 1)
            entryLine := line.new(bar_index, entryPxR,   bar_index + 5, entryPxR,
                          extend = extend.right, color = entryColR,    style = line.style_solid,  width = 1)
            slLabel    := label.new(bar_index + 5, plannedSL,
                          "SL "    + sideTag + " " + str.tostring(plannedSL,  format.mintick),
                          xloc = xloc.bar_index, style = label.style_label_left,
                          color = color.new(color.red, 30),   textcolor = color.white, size = size.small)
            tp1Label   := label.new(bar_index + 5, plannedTP1,
                          "TP1 "   + sideTag + " " + str.tostring(plannedTP1, format.mintick),
                          xloc = xloc.bar_index, style = label.style_label_left,
                          color = color.new(color.lime, 30),  textcolor = color.black, size = size.small)
            tp2Label   := label.new(bar_index + 5, plannedTP2,
                          "TP2 "   + sideTag + " " + str.tostring(plannedTP2, format.mintick),
                          xloc = xloc.bar_index, style = label.style_label_left,
                          color = color.new(color.green, 30), textcolor = color.white, size = size.small)
            entryLabel := label.new(bar_index + 5, entryPxR,
                          "Entry " + sideTag + " " + str.tostring(entryPxR,   format.mintick),
                          xloc = xloc.bar_index, style = label.style_label_left,
                          color = color.new(entryColR, 30),   textcolor = color.white, size = size.small)
        else
            slLine.set_xy1(bar_index, plannedSL)
            slLine.set_xy2(bar_index + 5, plannedSL)
            tp1Line.set_xy1(bar_index, plannedTP1)
            tp1Line.set_xy2(bar_index + 5, plannedTP1)
            tp2Line.set_xy1(bar_index, plannedTP2)
            tp2Line.set_xy2(bar_index + 5, plannedTP2)
            entryLine.set_xy1(bar_index, entryPxR)
            entryLine.set_xy2(bar_index + 5, entryPxR)
            slLabel.set_xy(bar_index + 5, plannedSL)
            slLabel.set_text("SL "    + sideTag + " " + str.tostring(plannedSL,  format.mintick))
            tp1Label.set_xy(bar_index + 5, plannedTP1)
            tp1Label.set_text("TP1 "  + sideTag + " " + str.tostring(plannedTP1, format.mintick))
            tp2Label.set_xy(bar_index + 5, plannedTP2)
            tp2Label.set_text("TP2 "  + sideTag + " " + str.tostring(plannedTP2, format.mintick))
            entryLabel.set_xy(bar_index + 5, entryPxR)
            entryLabel.set_text("Entry " + sideTag + " " + str.tostring(entryPxR, format.mintick))
    else
        if not na(slLine)
            slLine.delete()
            tp1Line.delete()
            tp2Line.delete()
            entryLine.delete()
            slLabel.delete()
            tp1Label.delete()
            tp2Label.delete()
            entryLabel.delete()
            slLine     := na
            tp1Line    := na
            tp2Line    := na
            entryLine  := na
            slLabel    := na
            tp1Label   := na
            tp2Label   := na
            entryLabel := na

// =====================================================================================
// 6.1 STATUS PIN (label ancorado no ultimo bar — move com o chart)
// =====================================================================================
var label statusPin = na
if showHUD and barstate.islast
    pinDir   = scoreLong > scoreShort ? "▲" : (scoreShort > scoreLong ? "▼" : "—")
    pinScore = math.max(scoreLong, scoreShort)
    pinSide  = scoreLong > scoreShort ? "L" : "S"
    pinFact  = scoreLong > scoreShort ? factorsLong : factorsShort
    pinReady = pinScore >= entryThreshEff and pinFact >= effRequireFactors
    pinTxt   = pinDir + " " + pinSide + " " + str.tostring(pinScore, "#.0") + "/" + str.tostring(entryThreshEff)
       + "  (" + str.tostring(pinFact) + "/5)"
       + (pinReady ? "  ✓ ENTRY" : "")
    pinCol = pinReady ? (scoreLong > scoreShort ? colBull : colBear) : color.new(color.gray, 0)
    if na(statusPin)
        statusPin := label.new(bar_index, close, pinTxt,
                          xloc = xloc.bar_index,
                          style = label.style_label_left,
                          color = pinCol,
                          textcolor = color.white,
                          size = size.normal)
    else
        statusPin.set_xy(bar_index, close)
        statusPin.set_text(pinTxt)
        statusPin.set_color(pinCol)

// =====================================================================================
// 6.2 SL/TP PREVIEW — projecao dinamica antes de entrar (factors >= 2)
// =====================================================================================
var line previewSlLine  = na
var line previewTp1Line = na
var line previewTp2Line = na
var label previewLbl    = na

showPreviewLong  = strategy.position_size == 0 and factorsLong  >= 2 and not htfBlockLong  and rrPotentialLong  >= rrTp1
showPreviewShort = strategy.position_size == 0 and factorsShort >= 2 and not htfBlockShort and rrPotentialShort >= rrTp1
showPreview      = (showPreviewLong or showPreviewShort) and showSLTPLines

if showPreview and barstate.islast
    pSL  = showPreviewLong ? slLongPx  : slShortPx
    pTP1 = showPreviewLong ? tp1LongPx : tp1ShortPx
    pTP2 = showPreviewLong ? tp2LongPx : tp2ShortPx
    pCol = showPreviewLong ? colBull : colBear
    pTag = showPreviewLong ? "PREVIEW LONG" : "PREVIEW SHORT"
    pSc  = showPreviewLong ? scoreLong : scoreShort
    leftP  = bar_index - 5
    rightP = bar_index + 8
    if na(previewSlLine)
        previewSlLine  := line.new(leftP, pSL,  rightP, pSL,
                              color = color.new(color.red, 30),  style = line.style_dotted, width = 2)
        previewTp1Line := line.new(leftP, pTP1, rightP, pTP1,
                              color = color.new(color.lime, 30), style = line.style_dotted, width = 1)
        previewTp2Line := line.new(leftP, pTP2, rightP, pTP2,
                              color = color.new(color.green, 30),style = line.style_dotted, width = 1)
        previewLbl := label.new(rightP, pTP1, pTag + " | score=" + str.tostring(pSc, "#.0"),
                              style = label.style_label_left,
                              color = color.new(pCol, 30),
                              textcolor = color.white, size = size.normal)
    else
        previewSlLine.set_xy1(leftP, pSL)
        previewSlLine.set_xy2(rightP, pSL)
        previewTp1Line.set_xy1(leftP, pTP1)
        previewTp1Line.set_xy2(rightP, pTP1)
        previewTp2Line.set_xy1(leftP, pTP2)
        previewTp2Line.set_xy2(rightP, pTP2)
        previewLbl.set_xy(rightP, pTP1)
        previewLbl.set_text(pTag + " | score=" + str.tostring(pSc, "#.0"))
        previewLbl.set_color(color.new(pCol, 30))

// Limpa preview se nao deve mostrar
if not showPreview and not na(previewSlLine)
    previewSlLine.delete()
    previewTp1Line.delete()
    previewTp2Line.delete()
    previewLbl.delete()
    previewSlLine  := na
    previewTp1Line := na
    previewTp2Line := na
    previewLbl     := na

// Risk circuit breakers — Pine v6 exige strategy.risk.* em top-level (column zero).
// Quando o toggle do input esta off, passamos um valor "infinitamente alto" (100% nao dispara).
strategy.risk.max_drawdown(useMaxDDcb        ? 25  : 100, strategy.percent_of_equity)
strategy.risk.max_intraday_loss(useMaxIntraLossCb ?  3  : 100, strategy.percent_of_equity)

// =====================================================================================
// 7. SELF-TUNE SHADOW SIMULATOR — 27 combos walk-forward
// =====================================================================================

type Combo
    int    id
    int    eThr
    float  vMult
    float  rrMin
    bool   vOpen
    int    vDir
    float  vEntry
    float  vSL
    float  vTP1
    float  vTP2
    bool   vTp1Hit
    int    vEntryBar
    // IS metrics
    int    trades_is
    int    wins_is
    int    losses_is
    float  gp_is
    float  gl_is
    float  peak_eq_is
    float  curr_eq_is
    float  max_dd_is
    array<float> rets_is
    // OOS metrics
    int    trades_oos
    int    wins_oos
    int    losses_oos
    float  gp_oos
    float  gl_oos
    float  peak_eq_oos
    float  curr_eq_oos
    float  max_dd_oos
    array<float> rets_oos

initCombo(int id, int t, float v, float r) =>
    Combo.new(
       id, t, v, r,
       false, 0, 0.0, 0.0, 0.0, 0.0, false, 0,
       0, 0, 0, 0.0, 0.0, 1000.0, 1000.0, 0.0, array.new<float>(),
       0, 0, 0, 0.0, 0.0, 1000.0, 1000.0, 0.0, array.new<float>())

var array<Combo> combosArr = array.new<Combo>()

if barstate.isfirst
    thresholds = array.from(55, 65, 75)
    vMults     = array.from(1.3, 1.5, 1.8)
    rrMins     = array.from(1.5, 2.0, 3.0)
    cid = 0
    for ti = 0 to 2
        for vi = 0 to 2
            for ri = 0 to 2
                cid := cid + 1
                combosArr.push(initCombo(cid, thresholds.get(ti), vMults.get(vi), rrMins.get(ri)))

// Walk-forward boundary: bar_index relative to last known index (only known on barstate.islast)
// For simulation flow, we use last_bar_index (final bar of dataset) once known.
// During historical execution before islast, we accumulate everything in IS first.
// On barstate.islast, we recompute partition using selfTuneIsRatio and re-bucket if needed.
// SIMPLIFICATION: bucketize each closed virtual trade by ratio (bar_index / last_bar_index) at close-time;
// last_bar_index is series[int] but updates each bar — we use historical perspective with a guard.

barsTotalEst = math.max(last_bar_index, bar_index + 1)
isCutoffBar  = math.round(barsTotalEst * selfTuneIsRatio)

closeVirtualTrade(Combo c, float exitPx) =>
    if c.vOpen
        rawRet = c.vDir > 0 ? (exitPx - c.vEntry) / c.vEntry : (c.vEntry - exitPx) / c.vEntry
        // Se TP1 ja foi parcialmente fechado, o ret restante refere-se a (1 - tp1QtyPct/100) da posicao
        remainingFrac = c.vTp1Hit ? (1 - tp1QtyPct / 100.0) : 1.0
        ret = rawRet * remainingFrac
        // Classificacao: trade conta como win se TP1 foi atingido OU ret remanescente positivo
        // (TP1+BE conta como win do trade, mesmo se remaining qty saiu em zero).
        isWin = c.vTp1Hit or ret > 0
        if bar_index <= isCutoffBar
            if isWin
                c.wins_is := c.wins_is + 1
                c.gp_is   := c.gp_is + (ret > 0 ? ret : 0.0) * 100.0
            else
                c.losses_is := c.losses_is + 1
                c.gl_is     := c.gl_is + math.abs(ret) * 100.0
            c.trades_is := c.trades_is + 1
            c.curr_eq_is := c.curr_eq_is * (1 + ret)
            c.peak_eq_is := math.max(c.peak_eq_is, c.curr_eq_is)
            ddNow = c.peak_eq_is > 0 ? (c.peak_eq_is - c.curr_eq_is) / c.peak_eq_is * 100.0 : 0.0
            c.max_dd_is := math.max(c.max_dd_is, ddNow)
            if c.rets_is.size() < 5000
                c.rets_is.push(ret)
        else
            if isWin
                c.wins_oos := c.wins_oos + 1
                c.gp_oos   := c.gp_oos + (ret > 0 ? ret : 0.0) * 100.0
            else
                c.losses_oos := c.losses_oos + 1
                c.gl_oos     := c.gl_oos + math.abs(ret) * 100.0
            c.trades_oos := c.trades_oos + 1
            c.curr_eq_oos := c.curr_eq_oos * (1 + ret)
            c.peak_eq_oos := math.max(c.peak_eq_oos, c.curr_eq_oos)
            ddNowO = c.peak_eq_oos > 0 ? (c.peak_eq_oos - c.curr_eq_oos) / c.peak_eq_oos * 100.0 : 0.0
            c.max_dd_oos := math.max(c.max_dd_oos, ddNowO)
            if c.rets_oos.size() < 5000
                c.rets_oos.push(ret)
        c.vOpen   := false
        c.vTp1Hit := false
        c.vDir    := 0

// Per-bar simulation per combo
if enableSelfTune and barstate.isconfirmed
    nc = combosArr.size()
    if nc > 0
        for ci = 0 to nc - 1
            c = combosArr.get(ci)
            // Manage existing virtual trade
            if c.vOpen
                // Fix A: Early move-to-BE @ earlyBeRr MFE (antes de TP1)
                if effUseEarlyBE and not c.vTp1Hit and c.vDir > 0
                    initialStopV_L = c.vEntry - c.vSL
                    if initialStopV_L > 0 and (high - c.vEntry) >= earlyBeRr * initialStopV_L
                        if c.vEntry > c.vSL
                            c.vSL := c.vEntry
                if effUseEarlyBE and not c.vTp1Hit and c.vDir < 0
                    initialStopV_S = c.vSL - c.vEntry
                    if initialStopV_S > 0 and (c.vEntry - low) >= earlyBeRr * initialStopV_S
                        if c.vEntry < c.vSL
                            c.vSL := c.vEntry
                // Fix B: Structural trailing apos TP1 hit
                if effUseTrailing and c.vTp1Hit and c.vDir > 0 and not na(lastHL)
                    if lastHL - slBufferAtr * atrVal > c.vSL
                        c.vSL := lastHL - slBufferAtr * atrVal
                if effUseTrailing and c.vTp1Hit and c.vDir < 0 and not na(lastLH)
                    if lastLH + slBufferAtr * atrVal < c.vSL
                        c.vSL := lastLH + slBufferAtr * atrVal
                if c.vDir > 0
                    if low <= c.vSL
                        closeVirtualTrade(c, c.vSL)
                    else
                        if not c.vTp1Hit and high >= c.vTP1
                            // partial close at TP1: book half the trade as TP1 win, then keep half until TP2 or BE
                            ret1 = (c.vTP1 - c.vEntry) / c.vEntry * (tp1QtyPct / 100.0)
                            if bar_index <= isCutoffBar
                                c.gp_is := c.gp_is + ret1 * 100.0
                                c.curr_eq_is := c.curr_eq_is * (1 + ret1)
                                c.peak_eq_is := math.max(c.peak_eq_is, c.curr_eq_is)
                            else
                                c.gp_oos := c.gp_oos + ret1 * 100.0
                                c.curr_eq_oos := c.curr_eq_oos * (1 + ret1)
                                c.peak_eq_oos := math.max(c.peak_eq_oos, c.curr_eq_oos)
                            c.vTp1Hit := true
                            c.vSL := c.vEntry  // BE
                        if c.vTp1Hit and high >= c.vTP2
                            closeVirtualTrade(c, c.vTP2)
                else
                    if high >= c.vSL
                        closeVirtualTrade(c, c.vSL)
                    else
                        if not c.vTp1Hit and low <= c.vTP1
                            ret1 = (c.vEntry - c.vTP1) / c.vEntry * (tp1QtyPct / 100.0)
                            if bar_index <= isCutoffBar
                                c.gp_is := c.gp_is + ret1 * 100.0
                                c.curr_eq_is := c.curr_eq_is * (1 + ret1)
                                c.peak_eq_is := math.max(c.peak_eq_is, c.curr_eq_is)
                            else
                                c.gp_oos := c.gp_oos + ret1 * 100.0
                                c.curr_eq_oos := c.curr_eq_oos * (1 + ret1)
                                c.peak_eq_oos := math.max(c.peak_eq_oos, c.curr_eq_oos)
                            c.vTp1Hit := true
                            c.vSL := c.vEntry
                        if c.vTp1Hit and low <= c.vTP2
                            closeVirtualTrade(c, c.vTP2)
            // Eligibility for new virtual entry (combo-specific score uses combo.vMult for F4)
            if not c.vOpen
                f4cL = inBullPOIvm(c.vMult)
                f4cS = inBearPOIvm(c.vMult)
                cScoreL = 100 * (0.25 * f1Long  * kzMultiplier + 0.20 * f2Long  + 0.20 * f3Long  + 0.20 * f4cL + 0.15 * f5Long)
                cScoreS = 100 * (0.25 * f1Short * kzMultiplier + 0.20 * f2Short + 0.20 * f3Short + 0.20 * f4cS + 0.15 * f5Short)
                cFactL  = countActive(f1Long,  f2Long,  f3Long,  f4cL, f5Long)
                cFactS  = countActive(f1Short, f2Short, f3Short, f4cS, f5Short)
                eligL   = allowLongs  and not htfBlockLong  and not kzHardBlock and cScoreL >= c.eThr and cFactL >= effRequireFactors
                eligS   = allowShorts and not htfBlockShort and not kzHardBlock and cScoreS >= c.eThr and cFactS >= effRequireFactors
                cRRL = stopDistL > 0 ? (tp2LongPx  - close) / stopDistL  : 0.0
                cRRS = stopDistS > 0 ? (close - tp2ShortPx) / stopDistS : 0.0
                if eligL and cRRL >= c.rrMin
                    c.vOpen     := true
                    c.vDir      := 1
                    c.vEntry    := close
                    c.vSL       := slLongPx
                    c.vTP1      := tp1LongPx
                    c.vTP2      := tp2LongPx
                    c.vTp1Hit   := false
                    c.vEntryBar := bar_index
                else if eligS and cRRS >= c.rrMin
                    c.vOpen     := true
                    c.vDir      := -1
                    c.vEntry    := close
                    c.vSL       := slShortPx
                    c.vTP1      := tp1ShortPx
                    c.vTP2      := tp2ShortPx
                    c.vTp1Hit   := false
                    c.vEntryBar := bar_index

// =====================================================================================
// 8. METRICS COMPOSTAS + winner selection (em barstate.islast)
// =====================================================================================

computeSharpe(array<float> rets, int oosBarCount, int annualBars) =>
    out = 0.0
    n = rets.size()
    if n >= 5 and oosBarCount > 0
        m = rets.avg()
        s = rets.stdev()
        if s > 0
            // Anualizacao: sqrt(trades_per_year_estimado)
            // trades_per_year ≈ (n_trades / oosBars) × annualBars
            tradesPerYear = float(n) / float(oosBarCount) * float(annualBars)
            out := m / s * math.sqrt(math.max(1.0, tradesPerYear))
    out

type ComboResult
    int   id
    int   eThr
    float vMult
    float rrMin
    int   nTrades
    float pf
    float winRate
    float maxDD
    float sharpe
    float compositeScore
    bool  valid
    bool  isWinner

var array<ComboResult> resultsArr = array.new<ComboResult>()

evaluateCombos() =>
    resultsArr.clear()
    oosBarCount = math.max(1, barsTotalEst - isCutoffBar)
    nc = combosArr.size()
    if nc > 0
        for ci = 0 to nc - 1
            c = combosArr.get(ci)
            pfIs    = c.gl_is  > 0 ? c.gp_is  / c.gl_is  : (c.gp_is  > 0 ? 999.0 : 0.0)
            pfOos   = c.gl_oos > 0 ? c.gp_oos / c.gl_oos : (c.gp_oos > 0 ? 999.0 : 0.0)
            wrOos   = c.trades_oos > 0 ? float(c.wins_oos) / float(c.trades_oos) : 0.0
            sharpeOos = computeSharpe(c.rets_oos, oosBarCount, selfTuneAnnualBars)
            consistencyPenalty = pfIs > 0 ? math.abs(pfIs - pfOos) / pfIs : 1.0
            base = 0.0
            if c.trades_oos > 0 and pfOos > 0 and sharpeOos > 0
                base := (pfOos * sharpeOos * math.sqrt(float(c.trades_oos))) / (1 + c.max_dd_oos)
            score = consistencyPenalty > 0.30 ? base * 0.5 : base
            valid = c.trades_oos >= 20 and c.max_dd_oos <= 25 and wrOos >= 0.35 and sharpeOos >= 0.8
            if not valid
                score := -1e9
            r = ComboResult.new(c.id, c.eThr, c.vMult, c.rrMin, c.trades_oos,
                                pfOos, wrOos, c.max_dd_oos, sharpeOos, score, valid, false)
            resultsArr.push(r)
        // Mark winner (highest score)
        bestIdx = 0
        bestScore = -2e9
        nr = resultsArr.size()
        for ri = 0 to nr - 1
            rr = resultsArr.get(ri)
            if rr.compositeScore > bestScore
                bestScore := rr.compositeScore
                bestIdx   := ri
        if bestScore > -1e8
            winner = resultsArr.get(bestIdx)
            winner.isWinner := true

if enableSelfTune and barstate.islast
    evaluateCombos()

// =====================================================================================
// 9. HUD + Self-Tune Table
// =====================================================================================
var table hud = table.new(position.top_right, 2, 12,
     bgcolor      = color.new(color.black, 75),
     frame_color  = color.new(color.gray, 50),
     frame_width  = 1,
     border_color = color.new(color.gray, 70),
     border_width = 1)

regimeLabel = regimeRatio > regimeHi ? "AGITADO" : regimeRatio < regimeLo ? "CALMO" : "NORMAL"
trendLabel  = trendState > 0 ? "▲ SUBINDO" : trendState < 0 ? "▼ CAINDO" : "— PARADO"
htfLabel    = htfBullBias ? "COMPRA" : htfBearBias ? "VENDA" : "—"
zoneLabel   = not hasRange ? "—" : (close < equilibrium ? "BARATO" : "CARO")
kzLabel     = inLondonOpen ? "LONDRES ABRE" : inNYOpen ? "NY ABRE" : inLondonCls ? "LONDRES FECHA" : "—"
swpLabel    = na(lastSwpBar) ? "—" : (lastSwpDir > 0 ? "Topo varrido " + str.tostring(barsSinceSwp) + "b" : "Fundo varrido " + str.tostring(barsSinceSwp) + "b")
posLabel    = strategy.position_size == 0 ? "Nenhuma" : strategy.position_size > 0 ? "COMPRADO " + str.tostring(strategy.position_size, "#.####") : "VENDIDO " + str.tostring(math.abs(strategy.position_size), "#.####")

if barstate.islast and showHUD
    table.set_position(hud, strToPos(hudPosStr))
    table.cell(hud, 0, 0,  "DSMC v0.4.0",        text_color = color.white, text_size = size.normal)
    table.cell(hud, 1, 0,  syminfo.ticker + " " + timeframe.period, text_color = colPOI, text_size = size.normal)
    table.cell(hud, 0, 1,  "Tendência",          text_color = color.gray)
    table.cell(hud, 1, 1,  trendLabel,           text_color = trendState > 0 ? colBull : trendState < 0 ? colBear : color.gray)
    table.cell(hud, 0, 2,  "Tend. Maior " + htfTF, text_color = color.gray)
    table.cell(hud, 1, 2,  htfLabel,             text_color = htfBullBias ? colBull : htfBearBias ? colBear : color.gray)
    table.cell(hud, 0, 3,  "Zona Preço",         text_color = color.gray)
    table.cell(hud, 1, 3,  zoneLabel,            text_color = zoneLabel == "BARATO" ? colBull : zoneLabel == "CARO" ? colBear : color.gray)
    table.cell(hud, 0, 4,  "Volatilidade",       text_color = color.gray)
    table.cell(hud, 1, 4,  regimeLabel + " " + str.tostring(regimeRatio, "#.##"),
                                                  text_color = regimeLabel == "NORMAL" ? color.white : colPOI)
    table.cell(hud, 0, 5,  "Caça Liquidez",      text_color = color.gray)
    table.cell(hud, 1, 5,  swpLabel,             text_color = lastSwpDir == -1 ? colBull : lastSwpDir == 1 ? colBear : color.gray)
    table.cell(hud, 0, 6,  "Horário Quente",     text_color = color.gray)
    table.cell(hud, 1, 6,  kzLabel,              text_color = inAnyKZ ? color.yellow : color.gray)
    table.cell(hud, 0, 7,  "Pontos C / V",       text_color = color.gray)
    table.cell(hud, 1, 7,  str.tostring(scoreLong, "#") + "/" + str.tostring(scoreShort, "#") + "  alvo=" + str.tostring(entryThreshEff),
                                                  text_color = color.white)
    table.cell(hud, 0, 8,  "Operação",           text_color = color.gray)
    table.cell(hud, 1, 8,  posLabel,             text_color = strategy.position_size > 0 ? colBull : strategy.position_size < 0 ? colBear : color.gray)
    table.cell(hud, 0, 9,  "Saldo",              text_color = color.gray)
    table.cell(hud, 1, 9,  str.tostring(strategy.equity, "#.##"), text_color = color.white)
    table.cell(hud, 0, 10, "Operações / Acerto", text_color = color.gray)
    wrPct = strategy.closedtrades > 0 ? 100 * float(strategy.wintrades) / strategy.closedtrades : 0.0
    table.cell(hud, 1, 10, str.tostring(strategy.closedtrades) + " / " + str.tostring(wrPct, "#.0") + "%",
                                                  text_color = color.white)
    // BE State Machine (Real_Profit v3.1.8 — 5 estados)
    posSizeBE   = strategy.position_size
    entryPxBE   = strategy.position_avg_price
    isLongBE    = posSizeBE > 0
    isShortBE   = posSizeBE < 0
    slEqEntry   = not na(plannedSL) and not na(entryPxBE) and math.abs(plannedSL - entryPxBE) < syminfo.mintick * 2
    trailingOnBE = tp1Hit and not slEqEntry and not na(plannedSL) and not na(entryPxBE) and ((isLongBE and plannedSL > entryPxBE) or (isShortBE and plannedSL < entryPxBE))
    beStateLabel = "● Sem operação"
    beStateColor = color.gray
    if posSizeBE != 0
        if trailingOnBE
            beStateLabel := "● Seguindo Preço"
            beStateColor := color.new(color.green, 0)
        else if tp1Hit and slEqEntry
            beStateLabel := "◒ Sem Risco"
            beStateColor := color.new(color.aqua, 0)
        else if not tp1Hit and slEqEntry
            beStateLabel := "◐ Proteção Inicial"
            beStateColor := color.new(color.yellow, 0)
        else
            beStateLabel := "○ Esperando TP1"
            beStateColor := color.white
    table.cell(hud, 0, 11, "Proteção Stop",      text_color = color.gray)
    table.cell(hud, 1, 11, beStateLabel,         text_color = beStateColor)

// Self-tune table (28 rows: header + 27 combos)
var table tuneTbl = table.new(position.middle_right, 9, 29,
     bgcolor      = color.new(color.black, 80),
     frame_color  = color.new(color.gray, 50),
     frame_width  = 1,
     border_color = color.new(color.gray, 70),
     border_width = 1)

if barstate.islast and enableSelfTune and showSelfTune
    table.set_position(tuneTbl, strToPos(tuneTblPosStr))
    headerCol = color.new(color.yellow, 0)
    table.cell(tuneTbl, 0, 0, "ID",       text_color = headerCol, text_size = size.normal)
    table.cell(tuneTbl, 1, 0, "EThr",     text_color = headerCol, text_size = size.normal)
    table.cell(tuneTbl, 2, 0, "VMult",    text_color = headerCol, text_size = size.normal)
    table.cell(tuneTbl, 3, 0, "RRmin",    text_color = headerCol, text_size = size.normal)
    table.cell(tuneTbl, 4, 0, "Tr OOS",   text_color = headerCol, text_size = size.normal)
    table.cell(tuneTbl, 5, 0, "PF OOS",   text_color = headerCol, text_size = size.normal)
    table.cell(tuneTbl, 6, 0, "WR%",      text_color = headerCol, text_size = size.normal)
    table.cell(tuneTbl, 7, 0, "DD%",      text_color = headerCol, text_size = size.normal)
    table.cell(tuneTbl, 8, 0, "Score",    text_color = headerCol, text_size = size.normal)
    nr = resultsArr.size()
    if nr > 0
        for ri = 0 to nr - 1
            r = resultsArr.get(ri)
            rowIdx = ri + 1
            txtC   = r.isWinner ? color.new(color.lime, 0) : (r.valid ? color.white : color.new(color.gray, 30))
            table.cell(tuneTbl, 0, rowIdx, str.tostring(r.id),                       text_color = txtC, text_size = size.normal)
            table.cell(tuneTbl, 1, rowIdx, str.tostring(r.eThr),                     text_color = txtC, text_size = size.normal)
            table.cell(tuneTbl, 2, rowIdx, str.tostring(r.vMult, "#.#"),             text_color = txtC, text_size = size.normal)
            table.cell(tuneTbl, 3, rowIdx, str.tostring(r.rrMin, "#.#"),             text_color = txtC, text_size = size.normal)
            table.cell(tuneTbl, 4, rowIdx, str.tostring(r.nTrades),                  text_color = txtC, text_size = size.normal)
            table.cell(tuneTbl, 5, rowIdx, str.tostring(r.pf, "#.##"),               text_color = txtC, text_size = size.normal)
            table.cell(tuneTbl, 6, rowIdx, str.tostring(r.winRate * 100, "#.0"),     text_color = txtC, text_size = size.normal)
            table.cell(tuneTbl, 7, rowIdx, str.tostring(r.maxDD, "#.0"),             text_color = txtC, text_size = size.normal)
            scoreTxt = r.compositeScore < -1e8 ? "—" : str.tostring(r.compositeScore, "#.##")
            table.cell(tuneTbl, 8, rowIdx, scoreTxt,                                  text_color = txtC, text_size = size.normal)

// Winner label (instrucao para uso real)
var label winnerLbl = na
if barstate.islast and enableSelfTune and showSelfTune
    nr = resultsArr.size()
    if nr > 0
        winnerFound = false
        for ri = 0 to nr - 1
            r = resultsArr.get(ri)
            if r.isWinner
                winnerFound := true
                txt = "VENCEDOR ID#" + str.tostring(r.id) +
                      "  | EThr=" + str.tostring(r.eThr) +
                      "  VMult=" + str.tostring(r.vMult, "#.#") +
                      "  RRmin=" + str.tostring(r.rrMin, "#.#") +
                      "  | PF=" + str.tostring(r.pf, "#.##") +
                      "  Sharpe=" + str.tostring(r.sharpe, "#.##") +
                      "  WR=" + str.tostring(r.winRate * 100, "#.0") + "%" +
                      "  DD=" + str.tostring(r.maxDD, "#.0") + "%" +
                      "\nPara uso real: copie estes valores e desligue self-tune."
                if na(winnerLbl)
                    winnerLbl := label.new(bar_index, high, txt,
                                            style = label.style_label_lower_left,
                                            color = color.new(color.lime, 30),
                                            textcolor = color.white,
                                            size = size.normal)
                else
                    winnerLbl.set_xy(bar_index, high)
                    winnerLbl.set_text(txt)
                break
        if not winnerFound
            txt = "Self-tune: nenhum combo passou nos constraints (Tr_oos>=20, DD<=25%, WR>=35%, Sharpe>=0.8). Aumente historico ou afrouxe constraints."
            if na(winnerLbl)
                winnerLbl := label.new(bar_index, high, txt,
                                        style = label.style_label_lower_left,
                                        color = color.new(color.orange, 30),
                                        textcolor = color.white,
                                        size = size.normal)
            else
                winnerLbl.set_xy(bar_index, high)
                winnerLbl.set_text(txt)

// =====================================================================================
// 9c. SELF-TUNE PUBLISH — emit JSON via alert() to FastAPI /webhook/self_tune
//   schema: SelfTunePublish (pipeline/api/server.py:102)
//     {asset, tf, timestamp, winner_id|null, secret, combos:[27]}
//     combo: {id, eThr, vMult, rrMin, pf, sharpe, n_trades, is_winner}
// =====================================================================================
var int prevEmittedWinnerId = -999

if barstate.islast and enableSelfTune and selfTuneWebhookSecret != "" and resultsArr.size() > 0
    int currentWinnerId = -1
    nrW = resultsArr.size()
    for wi = 0 to nrW - 1
        rW = resultsArr.get(wi)
        if rW.isWinner
            currentWinnerId := rW.id
            break

    bool shouldEmit = selfTuneEmitMode == "Every bar close" or currentWinnerId != prevEmittedWinnerId
    if shouldEmit
        prevEmittedWinnerId := currentWinnerId
        string combosJson = ""
        nrJ = resultsArr.size()
        for ji = 0 to nrJ - 1
            rJ = resultsArr.get(ji)
            string sep = ji == 0 ? "" : ","
            combosJson := combosJson + sep +
                 "{\"id\":"        + str.tostring(rJ.id) +
                 ",\"eThr\":"      + str.tostring(rJ.eThr) +
                 ",\"vMult\":"     + str.tostring(rJ.vMult, "#.##") +
                 ",\"rrMin\":"     + str.tostring(rJ.rrMin, "#.##") +
                 ",\"pf\":"        + str.tostring(nz(rJ.pf, 0.0), "#.####") +
                 ",\"sharpe\":"    + str.tostring(nz(rJ.sharpe, 0.0), "#.####") +
                 ",\"n_trades\":"  + str.tostring(rJ.nTrades) +
                 ",\"is_winner\":" + (rJ.isWinner ? "true" : "false") + "}"
        string winnerStr = currentWinnerId >= 0 ? str.tostring(currentWinnerId) : "null"
        string payload = "{\"asset\":\"" + syminfo.ticker + "\"" +
             ",\"tf\":\""        + timeframe.period + "\"" +
             ",\"timestamp\":"   + str.tostring(time) +
             ",\"winner_id\":"   + winnerStr +
             ",\"secret\":\""    + selfTuneWebhookSecret + "\"" +
             ",\"combos\":["     + combosJson + "]}"
        alert(payload, alert.freq_once_per_bar_close)

// =====================================================================================
// G3 GROUNDTRUTH — log.info() each BOS/CHoCH/MSS event for Python parity test
//   format: time_ms,kind,close,ref  (paste from Pine Logs panel into CSV)
// =====================================================================================
if barstate.isconfirmed and (bullBOS or bearBOS or bullCHoCH or bearCHoCH or bullMSS or bearMSS)
    string kindStr = "bear_choch"
    if bullMSS
        kindStr := "bull_mss"
    else if bearMSS
        kindStr := "bear_mss"
    else if bullBOS
        kindStr := "bull_bos"
    else if bearBOS
        kindStr := "bear_bos"
    else if bullCHoCH
        kindStr := "bull_choch"
    isBullEvent = bullBOS or bullMSS or bullCHoCH
    refStr = isBullEvent ? str.tostring(lastHH, format.mintick) : str.tostring(lastLL, format.mintick)
    csvLine = "G3," + str.tostring(time) + "," + kindStr + "," + str.tostring(close, format.mintick) + "," + refStr
    log.info(csvLine)
    if barstate.islast or barstate.isrealtime
        alert(csvLine, alert.freq_once_per_bar_close)

// =====================================================================================
// 10. MTF CONFLUENCE DASHBOARD (Real_Profit v3.1.8 style — bottom-right)
//   Tabela 4-col x 9-row mostrando Trend/Sinal/Confluencia por TF.
//   Trend proxy: EMA 9 vs 21 vs 50 (stacked = trend; entrelaçado = flat).
//   Confluencia: TF.trend igual ao bias do TF atual (sign(scoreLong - scoreShort)).
//   Rows: 1D, 12H, 4H, 1H, 30M, 15M, 5M + Overall com contagem ✓/✗.
// =====================================================================================
type MtfSnap
    int    trend
    string lbl

// EMAs 5/13/21 (em vez de 9/21/50) para caber em historico curto de TFs maiores (1D, 12H)
// quando o chart de TF menor nao puxa 50+ bars do TF requested.
// Guard explicito contra na: se algum EMA for na, retorna 0 (sem direcao).
mtfCalc() =>
    e5  = ta.ema(close, 5)
    e13 = ta.ema(close, 13)
    e21 = ta.ema(close, 21)
    tr  = na(e5) or na(e13) or na(e21) ? 0 : (e5 > e13 and e13 > e21) ? 1 : (e5 < e13 and e13 < e21) ? -1 : 0
    l   = tr == 1 ? "▲ SOBE" : tr == -1 ? "▼ CAI" : "— —"
    MtfSnap.new(tr, l)

// gaps_on (default) forward-fill quando barra do TF maior ainda nao fechou
snap1d  = request.security(syminfo.tickerid, "D",   mtfCalc(), lookahead = barmerge.lookahead_off)
snap12h = request.security(syminfo.tickerid, "720", mtfCalc(), lookahead = barmerge.lookahead_off)
snap4h  = request.security(syminfo.tickerid, "240", mtfCalc(), lookahead = barmerge.lookahead_off)
snap1h  = request.security(syminfo.tickerid, "60",  mtfCalc(), lookahead = barmerge.lookahead_off)
snap30m = request.security(syminfo.tickerid, "30",  mtfCalc(), lookahead = barmerge.lookahead_off)
snap15m = request.security(syminfo.tickerid, "15",  mtfCalc(), lookahead = barmerge.lookahead_off)
snap5m  = request.security(syminfo.tickerid, "5",   mtfCalc(), lookahead = barmerge.lookahead_off)

var table mtfDash = table.new(position.bottom_right, 4, 9,
     bgcolor      = color.new(color.black, 75),
     frame_color  = color.new(color.gray, 50),
     frame_width  = 1,
     border_color = color.new(color.gray, 70),
     border_width = 1)

if barstate.islast and showMTFDash
    table.set_position(mtfDash, strToPos(mtfDashPosStr))
    currBiasDash = scoreLong > scoreShort ? 1 : scoreShort > scoreLong ? -1 : 0

    // Header row
    table.cell(mtfDash, 0, 0, "TF",     text_color = colPOI, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(mtfDash, 1, 0, "Trend",  text_color = colPOI, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(mtfDash, 2, 0, "Sinal",  text_color = colPOI, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(mtfDash, 3, 0, "Conflu", text_color = colPOI, bgcolor = color.new(color.black, 30), text_size = size.small)

    snapsArr = array.from(snap1d, snap12h, snap4h, snap1h, snap30m, snap15m, snap5m)
    tfArr    = array.from("1D", "12H", "4H", "1H", "30M", "15M", "5M")

    int confluCnt = 0
    int divergCnt = 0
    for i = 0 to 6
        s     = snapsArr.get(i)
        tfLbl = tfArr.get(i)
        row   = i + 1
        sigCol = s.trend == 1 ? colBull : s.trend == -1 ? colBear : color.gray
        sigTxt = s.trend == 1 ? "COMPRA" : s.trend == -1 ? "VENDA" : "—"

        confluVal = currBiasDash != 0 and s.trend == currBiasDash ? 1 : currBiasDash != 0 and s.trend == -currBiasDash ? -1 : 0
        if confluVal == 1
            confluCnt := confluCnt + 1
        if confluVal == -1
            divergCnt := divergCnt + 1
        conLbl = confluVal == 1 ? "✓" : confluVal == -1 ? "✗" : "—"
        conCol = confluVal == 1 ? colBull : confluVal == -1 ? colBear : color.gray

        table.cell(mtfDash, 0, row, tfLbl,   text_color = color.white, text_size = size.small)
        table.cell(mtfDash, 1, row, s.lbl,   text_color = sigCol,      text_size = size.small)
        table.cell(mtfDash, 2, row, sigTxt,  text_color = sigCol,      text_size = size.small)
        table.cell(mtfDash, 3, row, conLbl,  text_color = conCol,      text_size = size.small)

    // Overall footer
    overallTxt = currBiasDash == 1 ? "→ COMPRA" : currBiasDash == -1 ? "→ VENDA" : "— Neutro"
    overallCol = currBiasDash == 1 ? colBull : currBiasDash == -1 ? colBear : color.gray

    table.cell(mtfDash, 0, 8, "Overall",                            text_color = colPOI,     bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(mtfDash, 1, 8, overallTxt,                           text_color = overallCol, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(mtfDash, 2, 8, "✓" + str.tostring(confluCnt) + "/7", text_color = colBull,    bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(mtfDash, 3, 8, "✗" + str.tostring(divergCnt),        text_color = colBear,    bgcolor = color.new(color.black, 30), text_size = size.small)
