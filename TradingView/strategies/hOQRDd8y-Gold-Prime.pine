// This Pine Script™ source code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/

//@version=6
strategy("Gold Sniper — Liquidity Sweep + RSI Divergence", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=50, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.01, slippage=2, calc_on_every_tick=false, max_lines_count=500, max_labels_count=500, max_boxes_count=200)


// ══════════════════════════════════════════════════════════════════
//  INPUTS
// ══════════════════════════════════════════════════════════════════

// ── Strategy Selection ──
grpStrat        = "═══ Strategy Selection ═══"
useLiqSweep     = input.bool(true,  "Enable Liquidity Sweep Reversal",  group=grpStrat)
useRSIDiverg    = input.bool(true,  "Enable RSI Divergence Scalp",      group=grpStrat)
tradeDirection  = input.string("Both", "Trade Direction",               options=["Long Only", "Short Only", "Both"], group=grpStrat)

// ── Liquidity Sweep Settings ──
grpLiq          = "═══ Liquidity Sweep Settings ═══"
liqLookback     = input.int(30,     "Lookback Period (bars)",       minval=10, maxval=100, group=grpLiq)
liqBuffer       = input.int(3,      "Buffer Bars Before Sweep",     minval=1,  maxval=10,  group=grpLiq)
liqRR           = input.float(2.0,  "Reward : Risk Ratio",          minval=1.0, maxval=5.0, step=0.1, group=grpLiq)
liqSLMult       = input.float(0.5,  "SL Buffer (× sweep depth)",   minval=0.1, maxval=2.0, step=0.1, group=grpLiq)
liqMaxBars      = input.int(20,     "Max Hold (bars)",              minval=5,  maxval=60,  group=grpLiq)

// ── RSI Divergence Settings ──
grpRSI          = "═══ RSI Divergence Settings ═══"
rsiLen          = input.int(14,     "RSI Length",                   minval=5,  maxval=30,  group=grpRSI)
rsiOversold     = input.float(40.0, "RSI Oversold Threshold",      minval=20, maxval=50,  group=grpRSI)
rsiOverbought   = input.float(60.0, "RSI Overbought Threshold",    minval=50, maxval=80,  group=grpRSI)
rsiDivLookback  = input.int(10,     "Divergence Lookback (bars)",   minval=5,  maxval=30,  group=grpRSI)
rsiRR           = input.float(1.5,  "Reward : Risk Ratio",         minval=1.0, maxval=4.0, step=0.1, group=grpRSI)
rsiATRLen       = input.int(14,     "ATR Length for SL/TP",         minval=5,  maxval=30,  group=grpRSI)
rsiATRMult      = input.float(1.0,  "ATR Multiplier for SL",       minval=0.5, maxval=3.0, step=0.1, group=grpRSI)
rsiMaxBars      = input.int(15,     "Max Hold (bars)",              minval=5,  maxval=40,  group=grpRSI)

// ── Session Filter ──
grpSession      = "═══ Session Filter ═══"
useSessionFilt  = input.bool(true,  "Filter by Trading Session",    group=grpSession)
sessionStart    = input.int(8,      "Session Start Hour (UTC)",     minval=0, maxval=23, group=grpSession)
sessionEnd      = input.int(20,     "Session End Hour (UTC)",       minval=0, maxval=23, group=grpSession)

// ── Risk Management ──
grpRM           = "═══ Risk Management ═══"
riskPct         = input.float(1.0,  "Risk per Trade (%)",           minval=0.1, maxval=5.0, step=0.1, group=grpRM)
maxDailyTrades  = input.int(10,     "Max Trades per Day",           minval=1,  maxval=50,  group=grpRM)

// ── Visual Settings ──
grpVis          = "═══ Visuals ═══"
showSLTP        = input.bool(true,  "Show SL / TP Lines",           group=grpVis)
showSweepZones  = input.bool(true,  "Show Sweep Level Lines",       group=grpVis)
showDashboard   = input.bool(true,  "Show Stats Dashboard",         group=grpVis)
bullColor       = input.color(color.new(#00D26A, 0),  "Bull Signal Color",       group=grpVis)
bearColor       = input.color(color.new(#FF4757, 0),  "Bear Signal Color",       group=grpVis)
rsiDivColor     = input.color(color.new(#B197FC, 0),  "RSI Divergence Color",    group=grpVis)
confColor       = input.color(color.new(#FFD700, 0),  "Confluence Signal Color", group=grpVis)


// ══════════════════════════════════════════════════════════════════
//  SESSION FILTER
// ══════════════════════════════════════════════════════════════════

inSession() =>
    if useSessionFilt
        h = hour(time, "UTC")
        h >= sessionStart and h < sessionEnd
    else
        true

sessionActive = inSession()


// ══════════════════════════════════════════════════════════════════
//  DAILY TRADE COUNTER
// ══════════════════════════════════════════════════════════════════

var int dailyTrades = 0
if ta.change(dayofweek) != 0
    dailyTrades := 0

canTrade = dailyTrades < maxDailyTrades


// ══════════════════════════════════════════════════════════════════
//  CORE CALCULATIONS
// ══════════════════════════════════════════════════════════════════

// ── Shared Indicators ──
rsiVal  = ta.rsi(close, rsiLen)
atrVal  = ta.atr(rsiATRLen)

// ── Liquidity Sweep Detection ──
runHigh = ta.highest(high, liqLookback)[liqBuffer]
runLow  = ta.lowest(low,   liqLookback)[liqBuffer]

bullSweep      = low[1] < runLow and close > runLow and close > close[1]
bearSweep      = high[1] > runHigh and close < runHigh and close < close[1]
bullSweepDepth = runLow - low[1]
bearSweepDepth = high[1] - runHigh

// ── RSI Divergence Detection ──
priceLow  = ta.lowest(close,  rsiDivLookback)
rsiLow    = ta.lowest(rsiVal, rsiDivLookback)
priceHigh = ta.highest(close,  rsiDivLookback)
rsiHigh   = ta.highest(rsiVal, rsiDivLookback)

bullDiv = close < priceLow[3]  and rsiVal > rsiLow[3]  and rsiVal < rsiOversold
bearDiv = close > priceHigh[3] and rsiVal < rsiHigh[3] and rsiVal > rsiOverbought


// ══════════════════════════════════════════════════════════════════
//  SIGNAL FLAGS
// ══════════════════════════════════════════════════════════════════

canLong  = tradeDirection == "Both" or tradeDirection == "Long Only"
canShort = tradeDirection == "Both" or tradeDirection == "Short Only"

liqBuySignal  = useLiqSweep  and bullSweep and bullSweepDepth > 0 and sessionActive and canTrade and canLong
liqSellSignal = useLiqSweep  and bearSweep and bearSweepDepth > 0 and sessionActive and canTrade and canShort

rsiBuySignal  = useRSIDiverg and bullDiv and sessionActive and canTrade and canLong
rsiSellSignal = useRSIDiverg and bearDiv and sessionActive and canTrade and canShort

// Combined flags
anyBuy  = liqBuySignal  or rsiBuySignal
anySell = liqSellSignal or rsiSellSignal

// Confluence: BOTH strategies fire at same time (strongest signal)
confluence_buy  = liqBuySignal  and rsiBuySignal
confluence_sell = liqSellSignal and rsiSellSignal

noPosition = strategy.position_size == 0


// ══════════════════════════════════════════════════════════════════
//  SL / TP CALCULATIONS
// ══════════════════════════════════════════════════════════════════

// ── Liquidity Sweep SL/TP ──
liqBuySL  = low[1]  - bullSweepDepth * liqSLMult
liqBuyTP  = close   + (close - liqBuySL) * liqRR
liqSellSL = high[1] + bearSweepDepth * liqSLMult
liqSellTP = close   - (liqSellSL - close) * liqRR

// ── RSI Divergence SL/TP ──
rsiBuySL  = close - atrVal * rsiATRMult
rsiBuyTP  = close + atrVal * rsiATRMult * rsiRR
rsiSellSL = close + atrVal * rsiATRMult
rsiSellTP = close - atrVal * rsiATRMult * rsiRR


// ══════════════════════════════════════════════════════════════════
//  TRADE EXECUTION (Strategy Engine)
// ══════════════════════════════════════════════════════════════════

var int   entryBar    = 0
var string activeStrat = ""

// ── Liquidity Sweep Entries ──
if liqBuySignal and noPosition
    strategy.entry("Liq Long", strategy.long)
    strategy.exit("Liq Long TP/SL", "Liq Long", stop=liqBuySL, limit=liqBuyTP)
    entryBar    := bar_index
    activeStrat := "liq"
    dailyTrades += 1

if liqSellSignal and noPosition
    strategy.entry("Liq Short", strategy.short)
    strategy.exit("Liq Short TP/SL", "Liq Short", stop=liqSellSL, limit=liqSellTP)
    entryBar    := bar_index
    activeStrat := "liq"
    dailyTrades += 1

// ── RSI Divergence Entries ──
if rsiBuySignal and noPosition
    strategy.entry("RSI Long", strategy.long)
    strategy.exit("RSI Long TP/SL", "RSI Long", stop=rsiBuySL, limit=rsiBuyTP)
    entryBar    := bar_index
    activeStrat := "rsi"
    dailyTrades += 1

if rsiSellSignal and noPosition
    strategy.entry("RSI Short", strategy.short)
    strategy.exit("RSI Short TP/SL", "RSI Short", stop=rsiSellSL, limit=rsiSellTP)
    entryBar    := bar_index
    activeStrat := "rsi"
    dailyTrades += 1

// ── Time-Based Exit ──
maxBarsActive = activeStrat == "liq" ? liqMaxBars : rsiMaxBars
if not noPosition and (bar_index - entryBar) >= maxBarsActive
    strategy.close_all("Time Exit")

// ── End-of-Session Exit ──
if not noPosition and useSessionFilt and not sessionActive
    strategy.close_all("Session End")


// ══════════════════════════════════════════════════════════════════
//  PLOTTING — SIGNAL MARKERS
// ══════════════════════════════════════════════════════════════════

// Liquidity Sweep only (no confluence)
plotshape(liqBuySignal and not rsiBuySignal, title="Sweep BUY",
     style=shape.triangleup, location=location.belowbar,
     color=bullColor, size=size.normal, text="SWEEP\nBUY")

plotshape(liqSellSignal and not rsiSellSignal, title="Sweep SELL",
     style=shape.triangledown, location=location.abovebar,
     color=bearColor, size=size.normal, text="SWEEP\nSELL")

// RSI Divergence only (no confluence)
plotshape(rsiBuySignal and not liqBuySignal, title="RSI BUY",
     style=shape.circle, location=location.belowbar,
     color=rsiDivColor, size=size.normal, text="RSI\nBUY")

plotshape(rsiSellSignal and not liqSellSignal, title="RSI SELL",
     style=shape.circle, location=location.abovebar,
     color=rsiDivColor, size=size.normal, text="RSI\nSELL")

// Confluence — both strategies agree (STRONGEST signal)
plotshape(confluence_buy, title="CONFLUENCE BUY",
     style=shape.diamond, location=location.belowbar,
     color=confColor, size=size.large, text="⚡ BUY")

plotshape(confluence_sell, title="CONFLUENCE SELL",
     style=shape.diamond, location=location.abovebar,
     color=confColor, size=size.large, text="⚡ SELL")


// ══════════════════════════════════════════════════════════════════
//  PLOTTING — SL / TP LINES + LABELS
// ══════════════════════════════════════════════════════════════════

if showSLTP and liqBuySignal and noPosition
    line.new(bar_index, liqBuySL, bar_index + liqMaxBars, liqBuySL,
         color=color.new(#FF4757, 30), width=1, style=line.style_dashed)
    line.new(bar_index, liqBuyTP, bar_index + liqMaxBars, liqBuyTP,
         color=color.new(#00D26A, 30), width=1, style=line.style_dashed)
    label.new(bar_index + liqMaxBars, liqBuySL, "SL " + str.tostring(liqBuySL, "#.##"),
         style=label.style_label_left, color=color.new(#FF4757, 85), textcolor=#FF4757, size=size.tiny)
    label.new(bar_index + liqMaxBars, liqBuyTP, "TP " + str.tostring(liqBuyTP, "#.##"),
         style=label.style_label_left, color=color.new(#00D26A, 85), textcolor=#00D26A, size=size.tiny)

if showSLTP and liqSellSignal and noPosition
    line.new(bar_index, liqSellSL, bar_index + liqMaxBars, liqSellSL,
         color=color.new(#FF4757, 30), width=1, style=line.style_dashed)
    line.new(bar_index, liqSellTP, bar_index + liqMaxBars, liqSellTP,
         color=color.new(#00D26A, 30), width=1, style=line.style_dashed)
    label.new(bar_index + liqMaxBars, liqSellSL, "SL " + str.tostring(liqSellSL, "#.##"),
         style=label.style_label_left, color=color.new(#FF4757, 85), textcolor=#FF4757, size=size.tiny)
    label.new(bar_index + liqMaxBars, liqSellTP, "TP " + str.tostring(liqSellTP, "#.##"),
         style=label.style_label_left, color=color.new(#00D26A, 85), textcolor=#00D26A, size=size.tiny)

if showSLTP and rsiBuySignal and noPosition
    line.new(bar_index, rsiBuySL, bar_index + rsiMaxBars, rsiBuySL,
         color=color.new(#B197FC, 40), width=1, style=line.style_dotted)
    line.new(bar_index, rsiBuyTP, bar_index + rsiMaxBars, rsiBuyTP,
         color=color.new(#B197FC, 40), width=1, style=line.style_dotted)
    label.new(bar_index + rsiMaxBars, rsiBuySL, "SL " + str.tostring(rsiBuySL, "#.##"),
         style=label.style_label_left, color=color.new(#B197FC, 85), textcolor=#B197FC, size=size.tiny)
    label.new(bar_index + rsiMaxBars, rsiBuyTP, "TP " + str.tostring(rsiBuyTP, "#.##"),
         style=label.style_label_left, color=color.new(#B197FC, 85), textcolor=#B197FC, size=size.tiny)

if showSLTP and rsiSellSignal and noPosition
    line.new(bar_index, rsiSellSL, bar_index + rsiMaxBars, rsiSellSL,
         color=color.new(#B197FC, 40), width=1, style=line.style_dotted)
    line.new(bar_index, rsiSellTP, bar_index + rsiMaxBars, rsiSellTP,
         color=color.new(#B197FC, 40), width=1, style=line.style_dotted)
    label.new(bar_index + rsiMaxBars, rsiSellSL, "SL " + str.tostring(rsiSellSL, "#.##"),
         style=label.style_label_left, color=color.new(#B197FC, 85), textcolor=#B197FC, size=size.tiny)
    label.new(bar_index + rsiMaxBars, rsiSellTP, "TP " + str.tostring(rsiSellTP, "#.##"),
         style=label.style_label_left, color=color.new(#B197FC, 85), textcolor=#B197FC, size=size.tiny)


// ══════════════════════════════════════════════════════════════════
//  PLOTTING — SWEEP ZONE LEVELS
// ══════════════════════════════════════════════════════════════════

plot(showSweepZones ? runHigh : na, "Sweep High", color=color.new(#FF4757, 70), linewidth=1, style=plot.style_stepline)
plot(showSweepZones ? runLow  : na, "Sweep Low",  color=color.new(#00D26A, 70), linewidth=1, style=plot.style_stepline)


// ══════════════════════════════════════════════════════════════════
//  BACKGROUND — SESSION SHADING
// ══════════════════════════════════════════════════════════════════

bgcolor(useSessionFilt and not sessionActive ? color.new(#FF4757, 96) : na, title="Out of Session")


// ══════════════════════════════════════════════════════════════════
//  LIVE DASHBOARD (top-right table)
// ══════════════════════════════════════════════════════════════════

if showDashboard and barstate.islast
    var table dash = table.new(position.top_right, 2, 12,
         bgcolor=color.new(#12161C, 10), border_width=1,
         border_color=color.new(#1E242D, 0), frame_width=1,
         frame_color=color.new(#D4A843, 50))

    // Header
    table.cell(dash, 0, 0, "GOLD SNIPER", text_color=#D4A843, text_size=size.small,
         text_halign=text.align_left, bgcolor=color.new(#1A1F28, 0))
    table.cell(dash, 1, 0, "COMBINED", text_color=#8A8F98, text_size=size.tiny,
         text_halign=text.align_right, bgcolor=color.new(#1A1F28, 0))

    // RSI
    rsiColor = rsiVal < rsiOversold ? #00D26A : rsiVal > rsiOverbought ? #FF4757 : #E8E6E3
    table.cell(dash, 0, 1, "RSI (" + str.tostring(rsiLen) + ")", text_color=#8A8F98,
         text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 1, str.tostring(rsiVal, "#.#"), text_color=rsiColor,
         text_size=size.tiny, text_halign=text.align_right)

    // ATR
    table.cell(dash, 0, 2, "ATR (" + str.tostring(rsiATRLen) + ")", text_color=#8A8F98,
         text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 2, str.tostring(atrVal, "#.##"), text_color=#E8E6E3,
         text_size=size.tiny, text_halign=text.align_right)

    // Sweep levels
    table.cell(dash, 0, 3, "Sweep High", text_color=#8A8F98,
         text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 3, str.tostring(runHigh, "#.##"), text_color=#FF4757,
         text_size=size.tiny, text_halign=text.align_right)

    table.cell(dash, 0, 4, "Sweep Low", text_color=#8A8F98,
         text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 4, str.tostring(runLow, "#.##"), text_color=#00D26A,
         text_size=size.tiny, text_halign=text.align_right)

    // Session status
    table.cell(dash, 0, 5, "Session", text_color=#8A8F98,
         text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 5, sessionActive ? "ACTIVE" : "CLOSED",
         text_color=sessionActive ? #00D26A : #FF4757,
         text_size=size.tiny, text_halign=text.align_right)

    // Daily trades
    table.cell(dash, 0, 6, "Trades Today", text_color=#8A8F98,
         text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 6, str.tostring(dailyTrades) + " / " + str.tostring(maxDailyTrades),
         text_color=dailyTrades >= maxDailyTrades ? #FF4757 : #E8E6E3,
         text_size=size.tiny, text_halign=text.align_right)

    // Separator
    table.cell(dash, 0, 7, "──────────", text_color=#1E242D,
         text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 7, "──────────", text_color=#1E242D,
         text_size=size.tiny, text_halign=text.align_right)

    // Liq Sweep signal
    liqStatus = liqBuySignal ? "BUY ▲" : liqSellSignal ? "SELL ▼" : "—"
    liqCol    = liqBuySignal ? #00D26A : liqSellSignal ? #FF4757 : #8A8F98
    table.cell(dash, 0, 8, "Liq Sweep", text_color=#8A8F98,
         text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 8, liqStatus, text_color=liqCol,
         text_size=size.tiny, text_halign=text.align_right)

    // RSI Div signal
    rsiStatus = rsiBuySignal ? "BUY ▲" : rsiSellSignal ? "SELL ▼" : "—"
    rsiSigCol = rsiBuySignal ? #B197FC : rsiSellSignal ? #B197FC : #8A8F98
    table.cell(dash, 0, 9, "RSI Div", text_color=#8A8F98,
         text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 9, rsiStatus, text_color=rsiSigCol,
         text_size=size.tiny, text_halign=text.align_right)

    // Confluence
    confStatus = confluence_buy ? "⚡ BUY" : confluence_sell ? "⚡ SELL" : "—"
    confCol    = confluence_buy or confluence_sell ? #FFD700 : #8A8F98
    table.cell(dash, 0, 10, "Confluence", text_color=#D4A843,
         text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 10, confStatus, text_color=confCol,
         text_size=size.tiny, text_halign=text.align_right)

    // Position
    posText  = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    posColor = strategy.position_size > 0 ? #00D26A : strategy.position_size < 0 ? #FF4757 : #8A8F98
    table.cell(dash, 0, 11, "Position", text_color=#8A8F98,
         text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 11, posText, text_color=posColor,
         text_size=size.tiny, text_halign=text.align_right)


// ══════════════════════════════════════════════════════════════════
//  ALERTS
// ══════════════════════════════════════════════════════════════════

// ── Liquidity Sweep ──
alertcondition(liqBuySignal, title="Liq Sweep — BUY",
     message="🟢 GOLD SNIPER — Liquidity Sweep BUY\nPrice swept session low and reversed bullish.\nEntry: {{close}}\nSL: Below sweep wick\nTP: 2:1 R:R target")

alertcondition(liqSellSignal, title="Liq Sweep — SELL",
     message="🔴 GOLD SNIPER — Liquidity Sweep SELL\nPrice swept session high and reversed bearish.\nEntry: {{close}}\nSL: Above sweep wick\nTP: 2:1 R:R target")

// ── RSI Divergence ──
alertcondition(rsiBuySignal, title="RSI Div — BUY",
     message="🟣 GOLD SNIPER — RSI Divergence BUY\nBullish divergence detected.\nEntry: {{close}}\nSL: 1×ATR below\nTP: 1.5×ATR above")

alertcondition(rsiSellSignal, title="RSI Div — SELL",
     message="🟣 GOLD SNIPER — RSI Divergence SELL\nBearish divergence detected.\nEntry: {{close}}\nSL: 1×ATR above\nTP: 1.5×ATR below")

// ── Confluence (STRONGEST) ──
alertcondition(confluence_buy, title="⚡ CONFLUENCE BUY",
     message="⚡ GOLD SNIPER — CONFLUENCE BUY\nBoth Liq Sweep + RSI Div signal BUY.\nHighest probability setup.\nEntry: {{close}}")

alertcondition(confluence_sell, title="⚡ CONFLUENCE SELL",
     message="⚡ GOLD SNIPER — CONFLUENCE SELL\nBoth Liq Sweep + RSI Div signal SELL.\nHighest probability setup.\nEntry: {{close}}")

// ── Any Signal ──
alertcondition(anyBuy, title="Any BUY Signal",
     message="GOLD SNIPER — BUY on {{ticker}} at {{close}}")

alertcondition(anySell, title="Any SELL Signal",
     message="GOLD SNIPER — SELL on {{ticker}} at {{close}}")
