//@version=6
strategy(
    title            = "SuperTrend Bot v6 — Delta Exchange",
    overlay          = true,
    default_qty_type = strategy.fixed,
    default_qty_value = 1,
    initial_capital  = 100000,
    currency         = currency.USD,
    commission_type  = strategy.commission.percent,
    commission_value = 0.05,
    pyramiding       = 0
)

// ═══════════════════════════════════════════════
//  INPUTS
// ═══════════════════════════════════════════════
int   atrLen  = input.int(10,   "ATR Length",          minval = 1,    group = "SuperTrend Settings")
float factor  = input.float(3.0,"Factor (Multiplier)", minval = 0.1,  step = 0.1, group = "SuperTrend Settings")
int   qty     = input.int(1,    "Order Quantity (Contracts)", minval = 1, group = "Order Settings")
bool  showLabels = input.bool(true, "Show BUY / SELL Labels", group = "Display")

// ═══════════════════════════════════════════════
//  SUPERTREND CALCULATION  (v6 compatible)
// ═══════════════════════════════════════════════
[supertrend, direction] = ta.supertrend(factor, atrLen)

// direction == -1  →  price ABOVE supertrend  →  BULLISH
// direction ==  1  →  price BELOW supertrend  →  BEARISH

bool isBullish = direction == -1
bool isBearish = direction ==  1

// Signal fires ONLY on the flip candle (direction change)
bool buySignal  = isBullish and direction[1] == 1   // flipped bullish this bar
bool sellSignal = isBearish and direction[1] == -1  // flipped bearish this bar

// ═══════════════════════════════════════════════
//  PLOT SUPERTREND LINE
// ═══════════════════════════════════════════════
plot(
    isBullish ? supertrend : na,
    title     = "Uptrend Line",
    color     = color.new(color.green, 0),
    linewidth  = 2,
    style     = plot.style_linebr
)

plot(
    isBearish ? supertrend : na,
    title     = "Downtrend Line",
    color     = color.new(color.red, 0),
    linewidth  = 2,
    style     = plot.style_linebr
)

// ═══════════════════════════════════════════════
//  BUY / SELL LABELS  (v6 plotshape syntax)
// ═══════════════════════════════════════════════
if showLabels
    if buySignal
        label.new(
            bar_index, low,
            text       = "BUY",
            style      = label.style_label_up,
            color      = color.green,
            textcolor  = color.white,
            size       = size.small
        )
    if sellSignal
        label.new(
            bar_index, high,
            text       = "SELL",
            style      = label.style_label_down,
            color      = color.red,
            textcolor  = color.white,
            size       = size.small
        )

// ═══════════════════════════════════════════════
//  BAR COLOURING  (visual trend context)
// ═══════════════════════════════════════════════
barcolor(isBullish ? color.new(color.green, 80) : color.new(color.red, 80))

// ═══════════════════════════════════════════════
//  STRATEGY ORDERS
// ═══════════════════════════════════════════════
if buySignal
    strategy.entry("Long", strategy.long, qty = qty)

if sellSignal
    strategy.entry("Short", strategy.short, qty = qty)

// ═══════════════════════════════════════════════
//  ALERT MESSAGE  (Delta Exchange webhook format)
//  One alert handles both BUY and SELL
// ═══════════════════════════════════════════════
alertcondition(
    buySignal or sellSignal,
    title   = "SuperTrend Signal",
    message = '{"symbol":"{{ticker}}", "side":"{{strategy.order.action}}", "qty":{{strategy.order.contracts}}, "trigger_time":"{{timenow}}"}'
)