//@version=6
indicator("EMA Ribbon [4, 9, 18, 50, 100, 200]", overlay = true)

// ───────────────────────────── Inputs ─────────────────────────────
grp_lengths = "EMA Lengths"
len1 = input.int(4,   "EMA 1", minval = 1, group = grp_lengths)
len2 = input.int(9,   "EMA 2", minval = 1, group = grp_lengths)
len3 = input.int(18,  "EMA 3", minval = 1, group = grp_lengths)
len4 = input.int(50,  "EMA 4", minval = 1, group = grp_lengths)
len5 = input.int(100, "EMA 5", minval = 1, group = grp_lengths)
len6 = input.int(200, "EMA 6", minval = 1, group = grp_lengths)

grp_toggle = "Show / Hide"
show1 = input.bool(true, "Show EMA 4",   group = grp_toggle, inline = "r1")
show2 = input.bool(true, "Show EMA 9",   group = grp_toggle, inline = "r1")
show3 = input.bool(true, "Show EMA 18",  group = grp_toggle, inline = "r2")
show4 = input.bool(true, "Show EMA 50",  group = grp_toggle, inline = "r2")
show5 = input.bool(true, "Show EMA 100", group = grp_toggle, inline = "r3")
show6 = input.bool(true, "Show EMA 200", group = grp_toggle, inline = "r3")

grp_style = "Style"
lineWidth   = input.int(2, "Line Width", minval = 1, maxval = 4, group = grp_style)
srcInput    = input.source(close, "Source", group = grp_style)
showFill    = input.bool(true, "Fill Between Fast/Slow (4 & 9)", group = grp_style)
showTable   = input.bool(true, "Show Status Table (top-right)", group = grp_style)

col1 = input.color(color.new(#00e5ff, 0),  "EMA 4 Color",   group = grp_style)
col2 = input.color(color.new(#2962ff, 0),  "EMA 9 Color",   group = grp_style)
col3 = input.color(color.new(#00c853, 0),  "EMA 18 Color",  group = grp_style)
col4 = input.color(color.new(#ff9800, 0),  "EMA 50 Color",  group = grp_style)
col5 = input.color(color.new(#ff5252, 0),  "EMA 100 Color", group = grp_style)
col6 = input.color(color.new(#9c27b0, 0),  "EMA 200 Color", group = grp_style)

// ───────────────────────────── Calculations ─────────────────────────────
ema1 = ta.ema(srcInput, len1)
ema2 = ta.ema(srcInput, len2)
ema3 = ta.ema(srcInput, len3)
ema4 = ta.ema(srcInput, len4)
ema5 = ta.ema(srcInput, len5)
ema6 = ta.ema(srcInput, len6)

// ───────────────────────────── Plots ─────────────────────────────
p1 = plot(show1 ? ema1 : na, "EMA 4",   color = col1, linewidth = lineWidth)
p2 = plot(show2 ? ema2 : na, "EMA 9",   color = col2, linewidth = lineWidth)
p3 = plot(show3 ? ema3 : na, "EMA 18",  color = col3, linewidth = lineWidth)
p4 = plot(show4 ? ema4 : na, "EMA 50",  color = col4, linewidth = lineWidth)
p5 = plot(show5 ? ema5 : na, "EMA 100", color = col5, linewidth = lineWidth)
p6 = plot(show6 ? ema6 : na, "EMA 200", color = col6, linewidth = lineWidth)

fillColor = ema1 > ema2 ? color.new(color.green, 85) : color.new(color.red, 85)
fill(p1, p2, color = showFill ? fillColor : na, title = "4/9 Fill")

// ───────────────────────────── Alerts ─────────────────────────────
bullCross = ta.crossover(ema1, ema2)
bearCross = ta.crossunder(ema1, ema2)

plotshape(bullCross, title = "Bull Cross 4/9", style = shape.triangleup,   location = location.belowbar, color = color.new(color.green, 0), size = size.tiny)
plotshape(bearCross, title = "Bear Cross 4/9", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0),   size = size.tiny)

alertcondition(bullCross, title = "EMA 4/9 Bullish Cross", message = "{{ticker}}: EMA 4 crossed above EMA 9 on {{interval}}")
alertcondition(bearCross, title = "EMA 4/9 Bearish Cross", message = "{{ticker}}: EMA 4 crossed below EMA 9 on {{interval}}")

// ───────────────────────────── Status Table ─────────────────────────────
var table infoTable = table.new(position.top_right, 2, 7, border_width = 1)

f_trendColor(cond) =>
    cond ? color.new(color.green, 0) : color.new(color.red, 0)

if showTable and barstate.islast
    table.cell(infoTable, 0, 0, "EMA", text_color = color.white, bgcolor = color.new(color.gray, 30))
    table.cell(infoTable, 1, 0, "Price vs EMA", text_color = color.white, bgcolor = color.new(color.gray, 30))

    table.cell(infoTable, 0, 1, "4",   text_color = col1)
    table.cell(infoTable, 1, 1, close > ema1 ? "Above" : "Below", text_color = f_trendColor(close > ema1))

    table.cell(infoTable, 0, 2, "9",   text_color = col2)
    table.cell(infoTable, 1, 2, close > ema2 ? "Above" : "Below", text_color = f_trendColor(close > ema2))

    table.cell(infoTable, 0, 3, "18",  text_color = col3)
    table.cell(infoTable, 1, 3, close > ema3 ? "Above" : "Below", text_color = f_trendColor(close > ema3))

    table.cell(infoTable, 0, 4, "50",  text_color = col4)
    table.cell(infoTable, 1, 4, close > ema4 ? "Above" : "Below", text_color = f_trendColor(close > ema4))

    table.cell(infoTable, 0, 5, "100", text_color = col5)
    table.cell(infoTable, 1, 5, close > ema5 ? "Above" : "Below", text_color = f_trendColor(close > ema5))

    table.cell(infoTable, 0, 6, "200", text_color = col6)
    table.cell(infoTable, 1, 6, close > ema6 ? "Above" : "Below", text_color = f_trendColor(close > ema6))