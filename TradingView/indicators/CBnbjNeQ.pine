//@version=6

//============================================================
// 出来高収縮スキャナー V3
//
// 【何を探す？】
// 最近52週新高値を付けた強い銘柄が、
// 高値圏で出来高と値幅を落として休んでいる状態を探す。
//
// 【主要条件】
// ・直近40日以内に52週新高値
// ・10日平均出来高 <= 50日平均出来高の70%
// ・直近10日値幅 <= 10%
// ・値幅が20日前より収縮
// ・株価 > 50MA / 200MA
// ・200MAが上昇中
//
// 【使い方】
// Scanner = 1 → チャートを目視してセットアップを確認
//============================================================
indicator("出来高＋値幅収縮スキャナー V3", overlay=false)

//========================
// パラメータ
//========================
shortVolLen = input.int(10, "短期出来高平均")
longVolLen  = input.int(50, "長期出来高平均")
volRatioMax = input.float(0.70, "出来高比率上限")

rangeLen    = input.int(10, "値幅計測期間")
rangeMaxPct = input.float(10.0, "最大値幅 %")
compareBars = input.int(20, "値幅比較期間")

newHighLookback = input.int(40, "新高値探索期間")
yearBars        = input.int(252, "52週営業日数")

//========================
// 出来高収縮
//========================
shortVol = ta.sma(volume, shortVolLen)
longVol  = ta.sma(volume, longVolLen)

volRatio = longVol > 0 ? shortVol / longVol : na

volumeDryUp =
     volRatio <= volRatioMax

//========================
// 値幅収縮
//========================
rangeHigh = ta.highest(high, rangeLen)
rangeLow  = ta.lowest(low, rangeLen)

rangePct =
     (rangeHigh - rangeLow) / close * 100

// 現在の値幅が十分狭い
rangeTight =
     rangePct <= rangeMaxPct

// 過去より値幅が縮小
previousRangePct =
     rangePct[compareBars]

rangeContracting =
     not na(previousRangePct) and
     rangePct < previousRangePct

//========================
// 52週新高値
//========================

// 前日までの過去252営業日の最高値
previous52wHigh =
     ta.highest(high[1], yearBars)

// 当日が52週新高値か
newHigh =
     not na(previous52wHigh) and
     high > previous52wHigh

// 直近40営業日以内に新高値があったか
recentNewHigh =
     ta.highest(newHigh ? 1.0 : 0.0, newHighLookback) > 0

// 新高値から何営業日経過したか
barsSinceNewHigh =
     ta.barssince(newHigh)

//========================
// 200日MA
//========================
ma200 = ta.sma(close, 200)

ma200SlopePct =
     (ma200 - ma200[20]) / ma200[20] * 100

// 20営業日前より1%以上高い
ma200SlopeOK =
     ma200SlopePct >= 1.0

// 200日MAが継続的に上向き
ma200Rising =
     ma200 > ma200[5] and
     ma200[5] > ma200[10] and
     ma200[10] > ma200[15] and
     ma200[15] > ma200[20]

//========================
// 50日MA
//========================
ma50 = ta.sma(close, 50)

aboveMA50 =
     close > ma50

aboveMA200 =
     close > ma200

//========================
// 最終条件
//========================
scannerMatch =
     volumeDryUp and
     rangeTight and
     rangeContracting and
     recentNewHigh and
     ma200SlopeOK and
     ma200Rising and
     aboveMA50 and
     aboveMA200

//========================
// Screener出力
//========================
plot(volRatio, title="10D/50D Volume Ratio")

plot(rangePct, title="10D Range %")

plot(rangeTight ? 1 : 0, title="Range Tight")

plot(rangeContracting ? 1 : 0, title="Range Contracting")

plot(recentNewHigh ? 1 : 0, title="Recent 52W High")

plot(barsSinceNewHigh, title="Days Since 52W High")

plot(ma200SlopePct, title="200MA Slope %")

plot(ma200Rising ? 1 : 0, title="200MA Rising")

plot(aboveMA50 ? 1 : 0, title="Above 50MA")

plot(aboveMA200 ? 1 : 0, title="Above 200MA")

plot(scannerMatch ? 1 : 0, title="Scanner")