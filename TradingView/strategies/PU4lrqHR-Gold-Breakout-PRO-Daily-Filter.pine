//@version=6
strategy("Gold Breakout PRO (Daily Filter)", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// === INPUTS ===
rangeLength = input.int(20)
rr = input.float(1.5)

// === DAILY TREND FILTER ===
dailyClose = request.security(syminfo.tickerid, "D", close)
dailyEMA50 = request.security(syminfo.tickerid, "D", ta.ema(close, 50))

dailyUptrend = dailyClose > dailyEMA50
dailyDowntrend = dailyClose < dailyEMA50

// === RANGE ===
highestHigh = ta.highest(high, rangeLength)
lowestLow = ta.lowest(low, rangeLength)

// === BREAKOUT STRENGTH ===
rangeSize = highestHigh - lowestLow
strongMove = (high - low) > (rangeSize * 0.2)

// === MOMENTUM ===
bullBreak = close > highestHigh[1] and close > open
bearBreak = close < lowestLow[1] and close < open

// === ENTRY (WITH DAILY FILTER) ===
longCondition = bullBreak and strongMove and dailyUptrend
shortCondition = bearBreak and strongMove and dailyDowntrend

if (longCondition)
    strategy.entry("Long", strategy.long)

if (shortCondition)
    strategy.entry("Short", strategy.short)

// === SL / TP ===
long_sl = lowestLow
short_sl = highestHigh

long_tp = strategy.position_avg_price + (strategy.position_avg_price - long_sl) * rr
short_tp = strategy.position_avg_price - (short_sl - strategy.position_avg_price) * rr

strategy.exit("Long Exit", from_entry="Long", stop=long_sl, limit=long_tp)
strategy.exit("Short Exit", from_entry="Short", stop=short_sl, limit=short_tp)

// === PLOTS ===
plot(highestHigh, color=color.green)
plot(lowestLow, color=color.red)

// Optional: show daily EMA on chart
plot(dailyEMA50, color=color.blue, title="Daily EMA 50")

plotshape(longCondition, location=location.belowbar, color=color.green, style=shape.labelup, text="BUY")
plotshape(shortCondition, location=location.abovebar, color=color.red, style=shape.labeldown, text="SELL")