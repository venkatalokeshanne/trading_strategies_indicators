//@version=6
indicator(
     "JackTrades NQ 250 Levels",
     shorttitle = "JT NQ 250",
     overlay = true,
     max_lines_count = 500,
     max_labels_count = 500
)

//──────────────────────────────────────────────────────────────────────
// INPUT GROUPS
//──────────────────────────────────────────────────────────────────────

string GROUP_LEVELS = "1. Levels"
string GROUP_LABELS = "2. Labels"
string GROUP_STYLE  = "3. Styling"

//──────────────────────────────────────────────────────────────────────
// LEVEL SETTINGS
//──────────────────────────────────────────────────────────────────────

float interval = input.float(
     250.0,
     "Price interval",
     minval = 1.0,
     step = 1.0,
     group = GROUP_LEVELS
)

int levelsAbove = input.int(
     8,
     "Levels above current price",
     minval = 1,
     maxval = 50,
     group = GROUP_LEVELS
)

int levelsBelow = input.int(
     8,
     "Levels below current price",
     minval = 1,
     maxval = 50,
     group = GROUP_LEVELS
)

//──────────────────────────────────────────────────────────────────────
// LABEL SETTINGS
//──────────────────────────────────────────────────────────────────────

bool showLabels = input.bool(
     true,
     "Show price labels",
     group = GROUP_LABELS
)

int labelHorizontalOffset = input.int(
     5,
     "Horizontal label buffer (bars)",
     minval = -100,
     maxval = 100,
     group = GROUP_LABELS,
     tooltip = "Positive values move the label right. Negative values move it left."
)

float labelVerticalOffset = input.float(
     0.0,
     "Vertical label buffer (points)",
     minval = -100.0,
     maxval = 100.0,
     step = 1.0,
     group = GROUP_LABELS,
     tooltip = "Positive values move the label above the line. Negative values move it below."
)

string labelAlignmentInput = input.string(
     "Centre",
     "Label alignment",
     options = ["Left", "Centre", "Right"],
     group = GROUP_LABELS
)

string labelSizeInput = input.string(
     "Small",
     "Label size",
     options = ["Tiny", "Small", "Normal"],
     group = GROUP_LABELS
)

//──────────────────────────────────────────────────────────────────────
// STYLE SETTINGS
//──────────────────────────────────────────────────────────────────────

color levelColour = input.color(
     color.new(color.gray, 35),
     "250-point line colour",
     group = GROUP_STYLE
)

int levelWidth = input.int(
     1,
     "Line width",
     minval = 1,
     maxval = 4,
     group = GROUP_STYLE
)

string lineStyleInput = input.string(
     "Dotted",
     "Line style",
     options = ["Solid", "Dashed", "Dotted"],
     group = GROUP_STYLE
)

color labelColour = input.color(
     color.new(color.gray, 0),
     "Label text colour",
     group = GROUP_STYLE
)

color labelBackgroundColour = input.color(
     color.new(color.black, 100),
     "Label background",
     group = GROUP_STYLE
)

//──────────────────────────────────────────────────────────────────────
// STYLE FUNCTIONS
//──────────────────────────────────────────────────────────────────────

getLineStyle() =>
    switch lineStyleInput
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        => line.style_dotted

getLabelSize() =>
    switch labelSizeInput
        "Tiny"   => size.tiny
        "Normal" => size.normal
        => size.small

getLabelStyle() =>
    switch labelAlignmentInput
        "Left"  => label.style_label_left
        "Right" => label.style_label_right
        => label.style_none

//──────────────────────────────────────────────────────────────────────
// DRAWING STORAGE
//──────────────────────────────────────────────────────────────────────

var array<line> levelLines = array.new<line>()
var array<label> levelLabels = array.new<label>()

//──────────────────────────────────────────────────────────────────────
// BUILD / REFRESH LEVELS
//──────────────────────────────────────────────────────────────────────

if barstate.islast

    // Delete existing lines.
    if array.size(levelLines) > 0
        for i = 0 to array.size(levelLines) - 1
            line.delete(array.get(levelLines, i))

    // Delete existing labels.
    if array.size(levelLabels) > 0
        for i = 0 to array.size(levelLabels) - 1
            label.delete(array.get(levelLabels, i))

    array.clear(levelLines)
    array.clear(levelLabels)

    //──────────────────────────────────────────────────────────────────
    // FIND THE NEAREST LOWER 250 LEVEL
    //──────────────────────────────────────────────────────────────────

    float baseLevel =
         math.floor(close / interval) * interval

    //──────────────────────────────────────────────────────────────────
    // DRAW EACH LEVEL
    //──────────────────────────────────────────────────────────────────

    for offset = -levelsBelow to levelsAbove

        float levelPrice =
             baseLevel + offset * interval

        // Horizontal 250-point line.
        line newLevel = line.new(
             x1 = bar_index - 1,
             y1 = levelPrice,
             x2 = bar_index,
             y2 = levelPrice,
             xloc = xloc.bar_index,
             extend = extend.both,
             color = levelColour,
             width = levelWidth,
             style = getLineStyle()
        )

        array.push(levelLines, newLevel)

        //──────────────────────────────────────────────────────────────
        // PRICE LABEL
        //──────────────────────────────────────────────────────────────

        if showLabels

            string levelText =
                 str.format(
                      "{0,number,#,###.00}",
                      levelPrice
                 )

            float labelPrice =
                 levelPrice + labelVerticalOffset

            int labelBar =
                 bar_index + labelHorizontalOffset

            label newLabel = label.new(
                 x = labelBar,
                 y = labelPrice,
                 text = levelText,
                 xloc = xloc.bar_index,
                 yloc = yloc.price,
                 style = getLabelStyle(),
                 color = labelBackgroundColour,
                 textcolor = labelColour,
                 size = getLabelSize()
            )

            array.push(levelLabels, newLabel)