//@version=6
// ═══════════════════════════════════════════════════════════════════
//  EMA 5 เส้น + Dashboard   |   Version 1.1   |   2026-08-08
//  เลียนแบบกล่องข้อมูล "EAvg" ของ TradeStation
//  EMA 10 / 25 / 75 / 200 / 300
// ═══════════════════════════════════════════════════════════════════
indicator("EMA 5 เส้น + Dashboard", shorttitle="EMA5+DB", overlay=true, max_lines_count=100)

// ─────────────────────────── ① INPUT : EMA ──────────────────────────
gE = "① เส้น EMA"
src = input.source(close, "แหล่งราคา", group = gE)

sh1  = input.bool(true,  "", group = gE, inline = "e1")
len1 = input.int(10,     "EMA", minval = 1, group = gE, inline = "e1")
col1 = input.color(#00E676, "", group = gE, inline = "e1")
wd1  = input.int(2, "หนา", minval = 1, maxval = 5, group = gE, inline = "e1")

sh2  = input.bool(true,  "", group = gE, inline = "e2")
len2 = input.int(25,     "EMA", minval = 1, group = gE, inline = "e2")
col2 = input.color(#00E5FF, "", group = gE, inline = "e2")
wd2  = input.int(2, "หนา", minval = 1, maxval = 5, group = gE, inline = "e2")

sh3  = input.bool(true,  "", group = gE, inline = "e3")
len3 = input.int(75,     "EMA", minval = 1, group = gE, inline = "e3")
col3 = input.color(#FF1744, "", group = gE, inline = "e3")
wd3  = input.int(2, "หนา", minval = 1, maxval = 5, group = gE, inline = "e3")

sh4  = input.bool(true,  "", group = gE, inline = "e4")
len4 = input.int(200,    "EMA", minval = 1, group = gE, inline = "e4")
col4 = input.color(#E040FB, "", group = gE, inline = "e4")
wd4  = input.int(2, "หนา", minval = 1, maxval = 5, group = gE, inline = "e4")

sh5  = input.bool(true,  "", group = gE, inline = "e5")
len5 = input.int(300,    "EMA", minval = 1, group = gE, inline = "e5")
col5 = input.color(#FFFFFF, "", group = gE, inline = "e5")
wd5  = input.int(2, "หนา", minval = 1, maxval = 5, group = gE, inline = "e5")

// ────────────────────── ② INPUT : DASHBOARD ─────────────────────────
gD = "② Dashboard"
showDB   = input.bool(true, "แสดง Dashboard", group = gD)
dbPosStr = input.string("บนขวา", "ตำแหน่ง", options = ["บนซ้าย", "บนขวา", "กลางขวา", "ล่างซ้าย", "ล่างขวา"], group = gD)
dbSizeStr= input.string("เล็ก", "ขนาดตัวอักษร", options = ["จิ๋ว", "เล็ก", "ปกติ", "ใหญ่"], group = gD)
showDist = input.bool(true, "แสดงคอลัมน์ ระยะห่าง %", group = gD)
dbBg     = input.color(color.new(#000000, 10), "สีพื้นหลัง", group = gD)

// ───────────────────── ③ INPUT : LABEL / ALERT ──────────────────────
gL = "③ ป้ายราคา & สัญญาณ"
showTag   = input.bool(true, "ป้ายราคา EMA ที่ขอบขวา", group = gL)
showCross = input.bool(true, "จุดตัด EMA เร็ว/ช้า (10 x 25)", group = gL)
showRibbon= input.bool(false, "ระบายสีระหว่าง EMA 10 กับ 25", group = gL)

// ───────────────────────── คำนวณค่า EMA ─────────────────────────────
e1 = ta.ema(src, len1)
e2 = ta.ema(src, len2)
e3 = ta.ema(src, len3)
e4 = ta.ema(src, len4)
e5 = ta.ema(src, len5)

// ────────────────────────────── วาดเส้น ─────────────────────────────
p1 = plot(sh1 ? e1 : na, "EMA 1", color = col1, linewidth = wd1)
p2 = plot(sh2 ? e2 : na, "EMA 2", color = col2, linewidth = wd2)
plot(sh3 ? e3 : na, "EMA 3", color = col3, linewidth = wd3)
plot(sh4 ? e4 : na, "EMA 4", color = col4, linewidth = wd4)
plot(sh5 ? e5 : na, "EMA 5", color = col5, linewidth = wd5)

fill(p1, p2, color = showRibbon and sh1 and sh2 ? (e1 > e2 ? color.new(col1, 88) : color.new(col3, 88)) : na, title = "Ribbon")

// ────────────────────── จุดตัด EMA เร็ว / ช้า ───────────────────────
goldenX = ta.crossover(e1, e2)
deathX  = ta.crossunder(e1, e2)

plotshape(showCross and goldenX ? e1 : na, "ตัดขึ้น", shape.triangleup,   location.absolute, color.new(#00E676, 0), size = size.tiny)
plotshape(showCross and deathX  ? e1 : na, "ตัดลง",  shape.triangledown, location.absolute, color.new(#FF1744, 0), size = size.tiny)

alertcondition(goldenX, "EMA เร็วตัดขึ้น", "EMA {{ticker}} : เส้นเร็วตัดขึ้นเหนือเส้นช้า")
alertcondition(deathX,  "EMA เร็วตัดลง",  "EMA {{ticker}} : เส้นเร็วตัดลงใต้เส้นช้า")
alertcondition(ta.crossover(close, e4),  "ราคาตัดขึ้นเหนือ EMA ยาว", "ราคา {{ticker}} ตัดขึ้นเหนือ EMA เส้นที่ 4")
alertcondition(ta.crossunder(close, e4), "ราคาตัดลงใต้ EMA ยาว",   "ราคา {{ticker}} ตัดลงใต้ EMA เส้นที่ 4")

// ───────────────────────── ป้ายราคาขอบขวา ──────────────────────────
mkTag(_show, _val, _col) =>
    if _show and showTag and barstate.islast
        label.new(bar_index + 3, _val, str.tostring(_val, format.mintick), color = _col, textcolor = #000000, style = label.style_label_left, size = size.small)

var label lb1 = na
var label lb2 = na
var label lb3 = na
var label lb4 = na
var label lb5 = na
var label lb0 = na
label.delete(lb1)
label.delete(lb2)
label.delete(lb3)
label.delete(lb4)
label.delete(lb5)
label.delete(lb0)
lb1 := mkTag(sh1, e1, col1)
lb2 := mkTag(sh2, e2, col2)
lb3 := mkTag(sh3, e3, col3)
lb4 := mkTag(sh4, e4, col4)
lb5 := mkTag(sh5, e5, col5)
lb0 := mkTag(true, close, #FFEB3B)

// ──────────────────────────── DASHBOARD ────────────────────────────
dbPos = dbPosStr == "บนซ้าย" ? position.top_left : dbPosStr == "บนขวา" ? position.top_right : dbPosStr == "กลางขวา" ? position.middle_right : dbPosStr == "ล่างซ้าย" ? position.bottom_left : position.bottom_right

dbSize = dbSizeStr == "จิ๋ว" ? size.tiny : dbSizeStr == "เล็ก" ? size.small : dbSizeStr == "ปกติ" ? size.normal : size.large

var table db = table.new(position.top_right, 4, 12, border_width = 1, border_color = color.new(#546E7A, 40))

// ---- ตัวช่วยจัดรูปแบบ ----
f_num(x) => str.tostring(x, format.mintick)
f_pct(p, e) => str.tostring((p - e) / e * 100, "#.##") + "%"
f_side(p, e) => p > e ? "▲ เหนือ" : "▼ ใต้"
f_sideCol(p, e) => p > e ? #00E676 : #FF5252

f_row(int r, string nm, float val, color c, bool on) =>
    if on
        table.cell(db, 0, r, nm, text_color = c, text_size = dbSize, text_halign = text.align_left)
        table.cell(db, 1, r, f_num(val), text_color = c, text_size = dbSize, text_halign = text.align_right)
        table.cell(db, 2, r, f_side(close, val), text_color = f_sideCol(close, val), text_size = dbSize, text_halign = text.align_center)
        if showDist
            table.cell(db, 3, r, f_pct(close, val), text_color = f_sideCol(close, val), text_size = dbSize, text_halign = text.align_right)

if showDB and barstate.islast
    table.clear(db, 0, 0, 3, 11)
    table.set_position(db, dbPos)
    table.set_bgcolor(db, dbBg)

    // แถวหัวข้อ
    table.cell(db, 0, 0, "รายการ", text_color = #B0BEC5, text_size = dbSize, bgcolor = color.new(#263238, 0))
    table.cell(db, 1, 0, "ค่า",     text_color = #B0BEC5, text_size = dbSize, bgcolor = color.new(#263238, 0))
    table.cell(db, 2, 0, "ราคาอยู่", text_color = #B0BEC5, text_size = dbSize, bgcolor = color.new(#263238, 0))
    if showDist
        table.cell(db, 3, 0, "ห่าง %", text_color = #B0BEC5, text_size = dbSize, bgcolor = color.new(#263238, 0))

    // OHLC แบบกล่อง TradeStation
    table.cell(db, 0, 1, "High",  text_color = #FFEB3B, text_size = dbSize, text_halign = text.align_left)
    table.cell(db, 1, 1, f_num(high), text_color = #FFEB3B, text_size = dbSize, text_halign = text.align_right)
    table.cell(db, 0, 2, "Low",   text_color = #FFEB3B, text_size = dbSize, text_halign = text.align_left)
    table.cell(db, 1, 2, f_num(low),  text_color = #FFEB3B, text_size = dbSize, text_halign = text.align_right)
    table.cell(db, 0, 3, "Open",  text_color = #00E676, text_size = dbSize, text_halign = text.align_left)
    table.cell(db, 1, 3, f_num(open), text_color = #00E676, text_size = dbSize, text_halign = text.align_right)
    table.cell(db, 0, 4, "Close", text_color = close >= open ? #00E676 : #FF5252, text_size = dbSize, text_halign = text.align_left)
    table.cell(db, 1, 4, f_num(close), text_color = close >= open ? #00E676 : #FF5252, text_size = dbSize, text_halign = text.align_right)

    // เส้น EMA ทั้ง 5
    f_row(5, "EMA " + str.tostring(len1), e1, col1, sh1)
    f_row(6, "EMA " + str.tostring(len2), e2, col2, sh2)
    f_row(7, "EMA " + str.tostring(len3), e3, col3, sh3)
    f_row(8, "EMA " + str.tostring(len4), e4, col4, sh4)
    f_row(9, "EMA " + str.tostring(len5), e5, col5, sh5)

    // สรุปแนวโน้ม : นับว่าราคายืนเหนือ EMA กี่เส้น
    int score = 0
    int total = 0
    if sh1
        score := score + (close > e1 ? 1 : 0)
        total := total + 1
    if sh2
        score := score + (close > e2 ? 1 : 0)
        total := total + 1
    if sh3
        score := score + (close > e3 ? 1 : 0)
        total := total + 1
    if sh4
        score := score + (close > e4 ? 1 : 0)
        total := total + 1
    if sh5
        score := score + (close > e5 ? 1 : 0)
        total := total + 1

    string tTxt  = total == 0 ? "—" : score == total ? "ขาขึ้นเต็มตัว" : score == 0 ? "ขาลงเต็มตัว" : score * 2 > total ? "เอียงขึ้น" : score * 2 < total ? "เอียงลง" : "ไร้ทิศทาง"
    color  tCol  = total == 0 ? #B0BEC5 : score == total ? #00E676 : score == 0 ? #FF1744 : score * 2 > total ? #AED581 : score * 2 < total ? #FF8A80 : #FFC107

    table.cell(db, 0, 10, "แนวโน้ม", text_color = #B0BEC5, text_size = dbSize, bgcolor = color.new(#263238, 0), text_halign = text.align_left)
    table.cell(db, 1, 10, str.tostring(score) + "/" + str.tostring(total), text_color = tCol, text_size = dbSize, bgcolor = color.new(#263238, 0), text_halign = text.align_right)
    table.cell(db, 2, 10, tTxt, text_color = tCol, text_size = dbSize, bgcolor = color.new(#263238, 0), text_halign = text.align_center)
    if showDist
        table.cell(db, 3, 10, "", bgcolor = color.new(#263238, 0))

    // การเรียงตัวของเส้น (Perfect Order)
    bool bullOrder = e1 > e2 and e2 > e3 and e3 > e4 and e4 > e5
    bool bearOrder = e1 < e2 and e2 < e3 and e3 < e4 and e4 < e5
    string oTxt = bullOrder ? "เรียงสวย ขาขึ้น" : bearOrder ? "เรียงสวย ขาลง" : "เส้นพันกัน"
    color  oCol = bullOrder ? #00E676 : bearOrder ? #FF1744 : #FFC107

    table.cell(db, 0, 11, "การเรียงเส้น", text_color = #B0BEC5, text_size = dbSize, text_halign = text.align_left)
    table.cell(db, 1, 11, oTxt, text_color = oCol, text_size = dbSize, text_halign = text.align_right)
    table.cell(db, 2, 11, "", text_color = oCol, text_size = dbSize)
    if showDist
        table.cell(db, 3, 11, "")
// ═══════════════════════ จบสคริปต์ ════════════════════════════════
