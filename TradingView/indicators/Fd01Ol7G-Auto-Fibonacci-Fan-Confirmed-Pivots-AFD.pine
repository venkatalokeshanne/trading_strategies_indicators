        int currentOriginTime = array.get(fanOriginTimes, currentFanIndex)
        float currentEndPrice = array.get(fanEndPrices, currentFanIndex)
        int currentEndTime = array.get(fanEndTimes, currentFanIndex)
        int previousSpotlightLevel = na
        float previousSpotlightRatio = na
        for orderIndex = 0 to LEVEL_COUNT - 1
