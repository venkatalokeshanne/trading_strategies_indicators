//@version=6
// Thanks to coondawg71 and ChartArt for Great Insights 
// Great for Spotting Tops & Bottoms.
indicator(title = "CM_Laguerre PPO PercentileRank Mkt Tops & Bottoms", shorttitle="CM Lgr PPO", overlay=false, precision=1)

// --- Inputs ---
pctile     = input.int(90, title="Percentile Threshold Extreme Value, Exceeding Creates Colored Histogram")
wrnpctile  = input.int(70, title="Percentile Threshold Warning Value, Exceeding Creates Colored Histogram")
Short      = input.float(0.4, title="PPO Setting")
Long       = input.float(0.8, title="PPO Setting")
lkbT       = input.int(200, title="Look Back Period For 'Tops' Percent Rank is based off of?")
lkbB       = input.int(200, title="Look Back Period For 'Bottoms' Percent Rank is based off of?")
sl         = input.bool(true, title="Show Threshold Line?")
swl        = input.bool(true, title="Show Warning Threshold Line?")

// --- Laguerre PPO Function ---
lag(g, p) => 
    var float L0 = na
    var float L1 = na
    var float L2 = na
    var float L3 = na
    
    L0 := (1 - g) * p + g * nz(L0)
    L1 := -g * L0 + nz(L0) + g * nz(L1)
    L2 := -g * L1 + nz(L1) + g * nz(L2)
    L3 := -g * L2 + nz(L2) + g * nz(L3)
    
    (L0 + 2 * L1 + 2 * L2 + L3) / 6

lmas = lag(Short, hl2)
lmal = lag(Long, hl2)

pctileB    = pctile * -1
wrnpctileB = wrnpctile * -1

// --- PPO Calculations ---
ppoT = (lmas - lmal) / lmal * 100
ppoB = (lmal - lmas) / lmal * 100

// --- PercentRank Transformation ---
pctRankT = ta.percentrank(ppoT, lkbT)
pctRankB = ta.percentrank(ppoB, lkbB) * -1

// --- Dynamic Color Logic ---
colT = pctRankT >= pctile ? color.red : pctRankT >= wrnpctile and pctRankT < pctile ? color.orange : color.gray
colB = pctRankB <= pctileB ? color.lime : pctRankB <= wrnpctileB and pctRankB > pctileB ? color.green : color.silver

// --- Visual Plots ---
plot(pctRankT, title="Percentile Rank Columns (Tops)", color=colT, style=plot.style_columns, linewidth=2)
plot(sl and pctile > 0 ? pctile : na, title="Extreme Move Percentile Threshold Line (Tops)", color=color.red, style=plot.style_linebr, linewidth=4)
plot(swl and wrnpctile > 0 ? wrnpctile : na, title="Warning Percentile Threshold Line (Tops)", color=color.orange, style=plot.style_line, linewidth=4)

plot(pctRankB, title="Percentile Rank Columns (Bottoms)", color=colB, style=plot.style_columns, linewidth=2)
plot(sl and pctileB < 0 ? pctileB : na, title="Extreme Move Percentile Threshold Line (Bottoms)", color=color.lime, style=plot.style_linebr, linewidth=4)
plot(swl and wrnpctileB < 0 ? wrnpctileB : na, title="Warning Percentile Threshold Line (Bottoms)", color=color.green, style=plot.style_line, linewidth=4)

plot(0, title="0 Line Circles Plot", style=plot.style_circles, linewidth=4, color=color.silver)
plot(0, title="0 Line-Line Plot", style=plot.style_linebr, linewidth=4, color=color.gray)
