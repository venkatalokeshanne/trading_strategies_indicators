//@version=5
strategy("river 10 min", overlay=true, 
  initial_capital=10000, 
  default_qty_type=strategy.percent_of_equity, 
  default_qty_value=10, 
  calc_on_every_tick=false,
  process_orders_on_close=true)

// ═══════════════════════════════════════
// ערוץ
// ═══════════════════════════════════════
length = input.int(20, "Channel Length", group="Channel")
mult   = input.float(2.0, "Channel Multiplier", group="Channel")
basis  = ta.ema(close, length)
dev    = mult * ta.atr(10)
upper  = basis + dev
lower  = basis - dev

p_upper = plot(upper, color=color.new(color.orange, 50))
p_lower = plot(lower, color=color.new(color.orange, 50))
fill(p_upper, p_lower, color=color.new(color.orange, 90))

// ═══════════════════════════════════════
// סופרטרנד כניסה
// ═══════════════════════════════════════
st_mult = input.float(3.0, "Trend Multiplier", group="Supertrend Entry")
st_len  = input.int(10,    "Trend Length",     group="Supertrend Entry")
[supertrend, direction] = ta.supertrend(st_mult, st_len)

confirmedDirection = barstate.isconfirmed ? direction : direction[1]
longSignal  = ta.change(confirmedDirection) < 0
shortSignal = ta.change(confirmedDirection) > 0

// ═══════════════════════════════════════
// סטופ לוס — ATR
// ═══════════════════════════════════════
use_sl        = input.bool(true,        "הפעל סטופ לוס",       group="Stop Loss")
sl_atr_len    = input.int(14,           "ATR Length",           group="Stop Loss")
sl_atr_mult   = input.float(2.0,        "ATR מכפיל",            group="Stop Loss", step=0.1)
sl_line_color = input.color(color.red,  "צבע קו סטופ לוס",     group="Stop Loss")

atr_val = ta.atr(sl_atr_len)

var float slLevel = na

if strategy.position_size > 0 and use_sl
    slLevel := strategy.opentrades.entry_price(0) - atr_val * sl_atr_mult
    strategy.exit("SL Long", "Long", stop=slLevel)
else if strategy.position_size < 0 and use_sl
    slLevel := strategy.opentrades.entry_price(0) + atr_val * sl_atr_mult
    strategy.exit("SL Short", "Short", stop=slLevel)
else
    slLevel := na

// ═══════════════════════════════════════
// ברייקאיבן
// ═══════════════════════════════════════
use_be         = input.bool(true,           "הפעל ברייקאיבן",          group="Breakeven")
be_trigger_pct = input.float(1.5,           "% רווח להפעלת ברייקאיבן", group="Breakeven", step=0.1)
be_line_color  = input.color(color.yellow,  "צבע קו ברייקאיבן",        group="Breakeven")

var float entryPrice = na
var bool  be_active  = false
var float beLevel    = na

if strategy.position_size > 0
    entryPrice := strategy.opentrades.entry_price(0)
    if not be_active and use_be
        profit_pct = (close - entryPrice) / entryPrice * 100
        if profit_pct >= be_trigger_pct
            strategy.exit("BE Long", "Long", stop=entryPrice)
            be_active := true
            beLevel   := entryPrice

if strategy.position_size < 0
    entryPrice := strategy.opentrades.entry_price(0)
    if not be_active and use_be
        profit_pct = (entryPrice - close) / entryPrice * 100
        if profit_pct >= be_trigger_pct
            strategy.exit("BE Short", "Short", stop=entryPrice)
            be_active := true
            beLevel   := entryPrice

if strategy.position_size == 0
    be_active  := false
    beLevel    := na

// ═══════════════════════════════════════
// יציאה מוקדמת
// ═══════════════════════════════════════
use_early_exit = input.bool(true,  "הפעל יציאה מוקדמת",   group="Early Exit")
exit_mult      = input.float(1.5,  "מכפיל סופרטרנד יציאה", group="Early Exit", step=0.1)
exit_len       = input.int(7,      "אורך סופרטרנד יציאה",  group="Early Exit")

[_, exitDirection] = ta.supertrend(exit_mult, exit_len)
confirmedExitDir   = barstate.isconfirmed ? exitDirection : exitDirection[1]

earlyExitLong  = use_early_exit and strategy.position_size > 0 and ta.change(confirmedExitDir) > 0
earlyExitShort = use_early_exit and strategy.position_size < 0 and ta.change(confirmedExitDir) < 0

if earlyExitLong
    strategy.close("Long", comment="Early Exit")
if earlyExitShort
    strategy.close("Short", comment="Early Exit")

// ═══════════════════════════════════════
// כניסות
// ═══════════════════════════════════════
if longSignal
    strategy.entry("Long", strategy.long)
if shortSignal
    strategy.entry("Short", strategy.short)

// ═══════════════════════════════════════
// ציור — קווים פעילים בלבד באמצעות line objects
// ═══════════════════════════════════════
var line sl_line = na
var line be_line = na
var label sl_lbl = na
var label be_lbl = na

// סטופ לוס — מחיקה ויצירה מחדש כל נר
if not na(slLevel) and strategy.position_size != 0
    if not na(sl_line)
        line.delete(sl_line)
    sl_line := line.new(bar_index - 50, slLevel, bar_index + 20, slLevel,
      color=sl_line_color, width=2, extend=extend.right, style=line.style_solid)
    if not na(sl_lbl)
        label.delete(sl_lbl)
    sl_lbl := label.new(bar_index, slLevel, "✕ SL",
      color=sl_line_color, textcolor=color.white,
      style=label.style_label_left, size=size.small)
else
    if not na(sl_line)
        line.delete(sl_line)
        sl_line := na
    if not na(sl_lbl)
        label.delete(sl_lbl)
        sl_lbl := na

// ברייקאיבן — רק כשפעיל
if be_active and not na(beLevel)
    if not na(be_line)
        line.delete(be_line)
    be_line := line.new(bar_index - 50, beLevel, bar_index + 20, beLevel,
      color=be_line_color, width=2, extend=extend.right, style=line.style_solid)
    if not na(be_lbl)
        label.delete(be_lbl)
    be_lbl := label.new(bar_index, beLevel, "✓ BE",
      color=be_line_color, textcolor=color.black,
      style=label.style_label_left, size=size.small)
else
    if not na(be_line)
        line.delete(be_line)
        be_line := na
    if not na(be_lbl)
        label.delete(be_lbl)
        be_lbl := na