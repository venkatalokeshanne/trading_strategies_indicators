//@version=6
indicator("CCI Mavi Sarı Kesişim Tarama v6", overlay=false)

// CCI ve Sinyal Hattı Hesaplaması (Kaynak olarak kapanış fiyatı tanımlandı)
cciDegeri = ta.cci(close, 20)
sariCizgi = ta.sma(cciDegeri, 9) // 9 periyotluk basit hareketli ortalama

// Kesişim Sinyalleri
alSinyali = ta.crossover(cciDegeri, sariCizgi)
satSinyali = ta.crossunder(cciDegeri, sariCizgi)

// Grafikte Çizgilerin Gösterimi
plot(cciDegeri, color=color.blue, title="CCI (Mavi)")
plot(sariCizgi, color=color.yellow, title="Sinyal (Sarı)")

// Referans Seviyeleri (+100, 0, -100)
hline(100, "Aşırı Alım", color=color.gray, linestyle=hline.style_dashed)
hline(0, "Denge Çizgisi", color=color.gray, linestyle=hline.style_dotted)
hline(-100, "Aşırı Satım", color=color.gray, linestyle=hline.style_dashed)

// Kesişim gerçekleştiğinde arka planı renklendirme (v6 formatı)
bgcolor(alSinyali ? color.new(color.green, 80) : na, title="Al Sinyali Arka Planı")
bgcolor(satSinyali ? color.new(color.red, 80) : na, title="Sat Sinyali Arka Planı")
