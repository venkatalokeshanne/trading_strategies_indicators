//@version=6
indicator("Serene ORB Strategy Indicator", overlay=true, max_labels_count=500)

// =====================================================
// USER SETTINGS
// =====================================================

orbSession      = input.session("0930-0935", "Opening Range Session")
tradeSession    = input.session("0935-1200", "Trade Signal Session")
timezone        = input.string("America/New_York", "Session Time Zone")

showVWAP        = input.bool(true, "Show VWAP")
useVWAPFilter   = input.bool(true, "Require VWAP Confirmation")
useVolumeFilter = input.bool(true, "Require Volume Confirmation")
volumeLength    = input.int(20, "Volume Average Length", minval=1)
volumeMult      = input.float(1.2, "Volume Multiplier", minval=0.1, step=0.1)

requireClose    = input.bool(true, "Require Candle Close Beyond ORB")
showBreakouts   = input.bool(true, "Show Breakout Signals")
showRetests     = input.bool(true, "Show Retest Signals")

retestTolerance = input.float(0.10, "Retest Tolerance %", minval=0.01, step=0.01)

riskReward1     = input.float(1.0, "Target 1 (R)", step=0.25)
riskReward2     = input.float(2.0, "Target 2 (R)", step=0.25)
riskReward3     = input.float(3.0, "Target 3 (R)", step=0.25)

showTargets     = input.bool(true, "Show Entry / Stop / Targets")

// =====================================================
// SESSION DETECTION
// =====================================================

inORB = not na(time(timeframe.period, orbSession, timezone))
inTradeSession = not na(time(timeframe.period, tradeSession, timezone))

newDay = ta.change(time("D")) != 0

// =====================================================
// OPENING RANGE
// =====================================================

var float orbHigh = na
var float orbLow  = na
var bool orbComplete = false

if newDay
    orbHigh := na
    orbLow := na
    orbComplete := false

if inORB
    orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
    orbLow  := na(orbLow)  ? low  : math.min(orbLow, low)

if not inORB and not na(orbHigh) and not na(orbLow)
    orbComplete := true

// =====================================================
// PLOT ORB LEVELS
// =====================================================

plot(
     orbComplete or inORB ? orbHigh : na,
     title="ORB High",
     color=color.new(color.green, 0),
     linewidth=2,
     style=plot.style_linebr)

plot(
     orbComplete or inORB ? orbLow : na,
     title="ORB Low",
     color=color.new(color.red, 0),
     linewidth=2,
     style=plot.style_linebr)

// =====================================================
// VWAP
// =====================================================

vwapValue = ta.vwap(hlc3)

plot(
     showVWAP ? vwapValue : na,
     title="VWAP",
     color=color.new(color.blue, 0),
     linewidth=2)

// =====================================================
// VOLUME FILTER
// =====================================================

avgVolume = ta.sma(volume, volumeLength)
strongVolume = volume > avgVolume * volumeMult

volumeBullOK = not useVolumeFilter or strongVolume
volumeBearOK = not useVolumeFilter or strongVolume

// =====================================================
// VWAP FILTER
// =====================================================

bullVWAPOK = not useVWAPFilter or close > vwapValue
bearVWAPOK = not useVWAPFilter or close < vwapValue

// =====================================================
// BREAKOUT CONDITIONS
// =====================================================

bullBreakRaw =
     orbComplete and
     inTradeSession and
     not na(orbHigh) and
     high > orbHigh

bearBreakRaw =
     orbComplete and
     inTradeSession and
     not na(orbLow) and
     low < orbLow

bullConfirmation =
     requireClose ?
     close > orbHigh :
     bullBreakRaw

bearConfirmation =
     requireClose ?
     close < orbLow :
     bearBreakRaw

bullBreakout =
     bullBreakRaw and
     bullConfirmation and
     bullVWAPOK and
     volumeBullOK

bearBreakout =
     bearBreakRaw and
     bearConfirmation and
     bearVWAPOK and
     volumeBearOK

// Prevent repeated breakout signals
var bool bullishBreakTriggered = false
var bool bearishBreakTriggered = false

if newDay
    bullishBreakTriggered := false
    bearishBreakTriggered := false

newBullBreakout = bullBreakout and not bullishBreakTriggered
newBearBreakout = bearBreakout and not bearishBreakTriggered

if newBullBreakout
    bullishBreakTriggered := true

if newBearBreakout
    bearishBreakTriggered := true

// =====================================================
// RETEST LOGIC
// =====================================================

bullTolerance = orbHigh * (retestTolerance / 100)
bearTolerance = orbLow  * (retestTolerance / 100)

bullRetestTouch =
     bullishBreakTriggered and
     low <= orbHigh + bullTolerance and
     low >= orbHigh - bullTolerance

bearRetestTouch =
     bearishBreakTriggered and
     high >= orbLow - bearTolerance and
     high <= orbLow + bearTolerance

bullRetest =
     showRetests and
     bullRetestTouch and
     close > orbHigh and
     close > open and
     bullVWAPOK

bearRetest =
     showRetests and
     bearRetestTouch and
     close < orbLow and
     close < open and
     bearVWAPOK

var bool bullRetestTriggered = false
var bool bearRetestTriggered = false

if newDay
    bullRetestTriggered := false
    bearRetestTriggered := false

newBullRetest = bullRetest and not bullRetestTriggered
newBearRetest = bearRetest and not bearRetestTriggered

if newBullRetest
    bullRetestTriggered := true

if newBearRetest
    bearRetestTriggered := true

// =====================================================
// ENTRY / STOP / TARGET CALCULATIONS
// =====================================================

var float entryPrice = na
var float stopPrice = na
var float target1 = na
var float target2 = na
var float target3 = na
var int tradeDirection = 0

// Bullish entry
if newBullBreakout or newBullRetest
    entryPrice := close

    // Structural stop below ORB high / breakout candle low
    stopPrice := math.min(low, orbHigh)

    risk = entryPrice - stopPrice

    target1 := entryPrice + risk * riskReward1
    target2 := entryPrice + risk * riskReward2
    target3 := entryPrice + risk * riskReward3

    tradeDirection := 1

// Bearish entry
if newBearBreakout or newBearRetest
    entryPrice := close

    // Structural stop above ORB low / breakout candle high
    stopPrice := math.max(high, orbLow)

    risk = stopPrice - entryPrice

    target1 := entryPrice - risk * riskReward1
    target2 := entryPrice - risk * riskReward2
    target3 := entryPrice - risk * riskReward3

    tradeDirection := -1

// Reset lines daily
if newDay
    entryPrice := na
    stopPrice := na
    target1 := na
    target2 := na
    target3 := na
    tradeDirection := 0

// =====================================================
// PLOT ENTRY, STOP, TARGETS
// =====================================================

plot(
     showTargets ? entryPrice : na,
     title="Entry",
     color=color.new(color.yellow, 0),
     linewidth=2,
     style=plot.style_linebr)

plot(
     showTargets ? stopPrice : na,
     title="Stop Loss",
     color=color.new(color.red, 20),
     linewidth=2,
     style=plot.style_linebr)

plot(
     showTargets ? target1 : na,
     title="Target 1",
     color=color.new(color.green, 40),
     linewidth=1,
     style=plot.style_linebr)

plot(
     showTargets ? target2 : na,
     title="Target 2",
     color=color.new(color.green, 20),
     linewidth=2,
     style=plot.style_linebr)

plot(
     showTargets ? target3 : na,
     title="Target 3",
     color=color.new(color.green, 0),
     linewidth=2,
     style=plot.style_linebr)

// =====================================================
// BUY / SELL SIGNALS
// =====================================================

plotshape(
     showBreakouts and newBullBreakout,
     title="Bullish ORB Breakout",
     text="ORB CALL",
     style=shape.labelup,
     location=location.belowbar,
     color=color.green,
     textcolor=color.white,
     size=size.small)

plotshape(
     showBreakouts and newBearBreakout,
     title="Bearish ORB Breakdown",
     text="ORB PUT",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     textcolor=color.white,
     size=size.small)

plotshape(
     newBullRetest,
     title="Bullish ORB Retest",
     text="CALL RETEST",
     style=shape.labelup,
     location=location.belowbar,
     color=color.teal,
     textcolor=color.white,
     size=size.small)

plotshape(
     newBearRetest,
     title="Bearish ORB Retest",
     text="PUT RETEST",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.orange,
     textcolor=color.white,
     size=size.small)

// =====================================================
// BACKGROUND HIGHLIGHT DURING ORB
// =====================================================

bgcolor(
     inORB ?
     color.new(color.gray, 90) :
     na,
     title="Opening Range Background")

// =====================================================
// ALERTS
// =====================================================

alertcondition(
     newBullBreakout,
     title="Bullish ORB Breakout",
     message="Bullish ORB breakout confirmed.")

alertcondition(
     newBearBreakout,
     title="Bearish ORB Breakdown",
     message="Bearish ORB breakdown confirmed.")

alertcondition(
     newBullRetest,
     title="Bullish ORB Retest",
     message="Bullish ORB breakout retest confirmed.")

alertcondition(
     newBearRetest,
     title="Bearish ORB Retest",
     message="Bearish ORB breakdown retest confirmed.")