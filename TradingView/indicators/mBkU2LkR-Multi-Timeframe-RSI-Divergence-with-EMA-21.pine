//@version=6
indicator(title="Multi-Timeframe RSI Divergence with EMA 21", format=format.price)

// ---------------- Core RSI inputs ----------------
len         = input.int(title="RSI Period", minval=1, defval=14)
src         = input(title="RSI Source", defval=close)
lbR         = input.int(title="Pivot Lookback Right", defval=5, display=display.data_window)
lbL         = input.int(title="Pivot Lookback Left", defval=5, display=display.data_window)
rangeUpper  = input.int(title="Max of Lookback Range", defval=60, display=display.data_window)
rangeLower  = input.int(title="Min of Lookback Range", defval=5, display=display.data_window)

plotBull        = input.bool(title="Plot Bullish", defval=true, group="Divergence Types")
plotHiddenBull  = input.bool(title="Plot Hidden Bullish", defval=false, group="Divergence Types")
plotBear        = input.bool(title="Plot Bearish", defval=true, group="Divergence Types")
plotHiddenBear  = input.bool(title="Plot Hidden Bearish", defval=false, group="Divergence Types")

// ---------------- Timeframe toggles ----------------
tfG = "Timeframes"
en_5   = input.bool(true,  "5 min",   group=tfG)
en_15  = input.bool(true,  "15 min",  group=tfG)
en_60  = input.bool(true,  "1 hour",  group=tfG)
en_240 = input.bool(false, "4 hour",  group=tfG)
en_D   = input.bool(false, "1 day",   group=tfG)
en_W   = input.bool(false, "1 week",  group=tfG)
en_M   = input.bool(false, "1 month", group=tfG)

// ---------------- Table settings ----------------
tblG        = "Status Table"
showTable   = input.bool(true, "Show Divergence Table", group=tblG)
tablePosInp = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group=tblG)
tableMaxAge = input.int(50, "Forget signal after N bars", minval=1, group=tblG, tooltip="A divergence older than this many bars is shown as 'None' in the table.")

// ---------------- Colors ----------------
bearColor = color.red
bullColor = color.green
textColor = color.white

// ---------------- RSI + EMA on chart timeframe ----------------
osc     = ta.rsi(src, len)
rsi_ema = ta.ema(osc, 21)

plot(osc,     title="RSI",        linewidth=2, color=#2962FF, display=display.pane)
plot(rsi_ema, title="RSI EMA 21", linewidth=2, color=color.orange, display=display.pane)
hline(50, title="Middle Line", color=#787B86, linestyle=hline.style_dotted)
obLevel = hline(70, title="Overbought", color=#787B86, linestyle=hline.style_dotted)
osLevel = hline(30, title="Oversold",   color=#787B86, linestyle=hline.style_dotted)
fill(obLevel, osLevel, title="Background", color=color.rgb(33, 150, 243, 90))

// ---------------- Chart timeframe size (seconds) for comparison ----------------
chartSec = timeframe.in_seconds()

// A requested timeframe is only valid if it is >= chart timeframe.
// Below the chart timeframe we cannot compute it honestly, so suppress it.
tfValid(simple string tf) =>
    timeframe.in_seconds(tf) >= chartSec

// ---------------- Divergence detection ----------------
// NOTE: this function is intended to be evaluated INSIDE request.security so that
// pivots, bar-counts and lookbacks are computed on real bars of the target
// timeframe -- not on the repeated ("staircase") HTF values mapped onto the chart.
_inRange(cond) =>
    bars = ta.barssince(cond == true)
    rangeLower <= bars and bars <= rangeUpper

f_div(float o, float pLow, float pHigh) =>
    plFound = not na(ta.pivotlow(o, lbL, lbR))
    phFound = not na(ta.pivothigh(o, lbL, lbR))
    inRangePl = _inRange(plFound[1])
    inRangePh = _inRange(phFound[1])
    oscHL   = o[lbR] > ta.valuewhen(plFound, o[lbR], 1) and inRangePl
    priceLL = pLow[lbR] < ta.valuewhen(plFound, pLow[lbR], 1)
    bull = priceLL and oscHL and plFound
    oscLL   = o[lbR] < ta.valuewhen(plFound, o[lbR], 1) and inRangePl
    priceHL = pLow[lbR] > ta.valuewhen(plFound, pLow[lbR], 1)
    hBull = priceHL and oscLL and plFound
    oscLH   = o[lbR] < ta.valuewhen(phFound, o[lbR], 1) and inRangePh
    priceHH = pHigh[lbR] > ta.valuewhen(phFound, pHigh[lbR], 1)
    bear = priceHH and oscLH and phFound
    oscHH   = o[lbR] > ta.valuewhen(phFound, o[lbR], 1) and inRangePh
    priceLH = pHigh[lbR] < ta.valuewhen(phFound, pHigh[lbR], 1)
    hBear = priceLH and oscHH and phFound
    [bull, hBull, bear, hBear]

// Run the FULL detection on the requested timeframe (confirmed, no lookahead),
// then bring back only the four boolean results.
// If the timeframe is disabled OR lower than the chart, everything returns false.
f_tf(simple string tf, simple bool enabled) =>
    bool use = enabled and tfValid(tf)
    [b, hb, be, hbe] = request.security(syminfo.tickerid, tf, f_div(ta.rsi(src, len), low, high), lookahead=barmerge.lookahead_off)
    [use and (b == true), use and (hb == true), use and (be == true), use and (hbe == true)]

// ---------------- Evaluate each timeframe ----------------
[b5,   hb5,   be5,   hbe5]   = f_tf("5",   en_5)
[b15,  hb15,  be15,  hbe15]  = f_tf("15",  en_15)
[b60,  hb60,  be60,  hbe60]  = f_tf("60",  en_60)
[b240, hb240, be240, hbe240] = f_tf("240", en_240)
[bD,   hbD,   beD,   hbeD]   = f_tf("D",   en_D)
[bW,   hbW,   beW,   hbeW]   = f_tf("W",   en_W)
[bM,   hbM,   beM,   hbeM]   = f_tf("M",   en_M)

// Gate by divergence-type toggles
g(bool v, bool on) => v and on

// ---------------- Latest-signal state per timeframe (for the table) ----------------
// Remembers the most recent divergence per TF and how many bars ago it fired.
// Old signals (> tableMaxAge bars) fall back to "None".
f_state(bool b, bool hb, bool be, bool hbe, int maxAge) =>
    var string lastType = "None"
    var int    lastBar  = na
    string sig = b ? "Bull" : hb ? "H.Bull" : be ? "Bear" : hbe ? "H.Bear" : na
    if not na(sig)
        lastType := sig
        lastBar  := bar_index
    int ago = na(lastBar) ? na : bar_index - lastBar
    bool fresh = not na(ago) and ago <= maxAge
    [fresh ? lastType : "None", fresh ? ago : na]

[t5,   a5]   = f_state(b5,   hb5,   be5,   hbe5,   tableMaxAge)
[t15,  a15]  = f_state(b15,  hb15,  be15,  hbe15,  tableMaxAge)
[t60,  a60]  = f_state(b60,  hb60,  be60,  hbe60,  tableMaxAge)
[t240, a240] = f_state(b240, hb240, be240, hbe240, tableMaxAge)
[tD,   aD]   = f_state(bD,   hbD,   beD,   hbeD,   tableMaxAge)
[tW,   aW]   = f_state(bW,   hbW,   beW,   hbeW,   tableMaxAge)
[tM,   aM]   = f_state(bM,   hbM,   beM,   hbeM,   tableMaxAge)

// ---------------- Draw the status table ----------------
divColor(string t) =>
    t == "Bull" or t == "H.Bull" ? bullColor : t == "Bear" or t == "H.Bear" ? bearColor : color.new(color.gray, 20)

var table tbl = table.new(position.top_right, 3, 8, border_width=1, border_color=color.new(color.gray, 50))

if barstate.islast and showTable
    // Resolve position each redraw
    tbl_pos = tablePosInp == "Top Left" ? position.top_left : tablePosInp == "Bottom Right" ? position.bottom_right : tablePosInp == "Bottom Left" ? position.bottom_left : tablePosInp == "Middle Right" ? position.middle_right : position.top_right
    table.set_position(tbl, tbl_pos)

    // Clear previous contents so disabled rows don't linger
    for r = 0 to 7
        for c = 0 to 2
            table.cell(tbl, c, r, "", bgcolor=color.new(color.black, 100))

    hdrBg = color.new(#1e222d, 0)
    // Header
    table.cell(tbl, 0, 0, "TF",         text_color=textColor, text_size=size.small, bgcolor=hdrBg)
    table.cell(tbl, 1, 0, "Divergence", text_color=textColor, text_size=size.small, bgcolor=hdrBg)
    table.cell(tbl, 2, 0, "Bars Ago",   text_color=textColor, text_size=size.small, bgcolor=hdrBg)

    names   = array.from("5m", "15m", "1h", "4h", "1D", "1W", "1M")
    enabled = array.from(en_5 and tfValid("5"), en_15 and tfValid("15"), en_60 and tfValid("60"), en_240 and tfValid("240"), en_D and tfValid("D"), en_W and tfValid("W"), en_M and tfValid("M"))
    types   = array.from(t5, t15, t60, t240, tD, tW, tM)
    agos    = array.from(a5, a15, a60, a240, aD, aW, aM)

    rowBgA = color.new(#2a2e39, 0)
    rowBgB = color.new(#22262f, 0)
    row = 1
    for i = 0 to 6
        if array.get(enabled, i)
            string typ = array.get(types, i)
            int    ago = array.get(agos, i)
            color  rbg = row % 2 == 0 ? rowBgA : rowBgB
            table.cell(tbl, 0, row, array.get(names, i), text_color=textColor,        text_size=size.small, bgcolor=rbg)
            table.cell(tbl, 1, row, typ,                 text_color=divColor(typ),    text_size=size.small, bgcolor=rbg)
            table.cell(tbl, 2, row, na(ago) ? "–" : str.tostring(ago), text_color=color.new(color.gray, 0), text_size=size.small, bgcolor=rbg)
            row += 1

// ---------------- Plot (inline, literal const strings for title/text) ----------------
// 5m  (offset 0)
plotshape(g(b5,plotBull)         ? osc + 0  : na, title="5m Bull",   text="5m Bull",   style=shape.labelup,   location=location.absolute, color=bullColor, textcolor=textColor, size=size.tiny)
plotshape(g(hb5,plotHiddenBull)  ? osc + 0  : na, title="5m HBull",  text="5m HBull",  style=shape.labelup,   location=location.absolute, color=bullColor, textcolor=textColor, size=size.tiny)
plotshape(g(be5,plotBear)        ? osc - 0  : na, title="5m Bear",   text="5m Bear",   style=shape.labeldown, location=location.absolute, color=bearColor, textcolor=textColor, size=size.tiny)
plotshape(g(hbe5,plotHiddenBear) ? osc - 0  : na, title="5m HBear",  text="5m HBear",  style=shape.labeldown, location=location.absolute, color=bearColor, textcolor=textColor, size=size.tiny)
// 15m (offset 6)
plotshape(g(b15,plotBull)         ? osc + 6  : na, title="15m Bull",  text="15m Bull",  style=shape.labelup,   location=location.absolute, color=bullColor, textcolor=textColor, size=size.tiny)
plotshape(g(hb15,plotHiddenBull)  ? osc + 6  : na, title="15m HBull", text="15m HBull", style=shape.labelup,   location=location.absolute, color=bullColor, textcolor=textColor, size=size.tiny)
plotshape(g(be15,plotBear)        ? osc - 6  : na, title="15m Bear",  text="15m Bear",  style=shape.labeldown, location=location.absolute, color=bearColor, textcolor=textColor, size=size.tiny)
plotshape(g(hbe15,plotHiddenBear) ? osc - 6  : na, title="15m HBear", text="15m HBear", style=shape.labeldown, location=location.absolute, color=bearColor, textcolor=textColor, size=size.tiny)
// 1h  (offset 12)
plotshape(g(b60,plotBull)         ? osc + 12 : na, title="1h Bull",   text="1h Bull",   style=shape.labelup,   location=location.absolute, color=bullColor, textcolor=textColor, size=size.tiny)
plotshape(g(hb60,plotHiddenBull)  ? osc + 12 : na, title="1h HBull",  text="1h HBull",  style=shape.labelup,   location=location.absolute, color=bullColor, textcolor=textColor, size=size.tiny)
plotshape(g(be60,plotBear)        ? osc - 12 : na, title="1h Bear",   text="1h Bear",   style=shape.labeldown, location=location.absolute, color=bearColor, textcolor=textColor, size=size.tiny)
plotshape(g(hbe60,plotHiddenBear) ? osc - 12 : na, title="1h HBear",  text="1h HBear",  style=shape.labeldown, location=location.absolute, color=bearColor, textcolor=textColor, size=size.tiny)
// 4h  (offset 18)
plotshape(g(b240,plotBull)         ? osc + 18 : na, title="4h Bull",   text="4h Bull",   style=shape.labelup,   location=location.absolute, color=bullColor, textcolor=textColor, size=size.tiny)
plotshape(g(hb240,plotHiddenBull)  ? osc + 18 : na, title="4h HBull",  text="4h HBull",  style=shape.labelup,   location=location.absolute, color=bullColor, textcolor=textColor, size=size.tiny)
plotshape(g(be240,plotBear)        ? osc - 18 : na, title="4h Bear",   text="4h Bear",   style=shape.labeldown, location=location.absolute, color=bearColor, textcolor=textColor, size=size.tiny)
plotshape(g(hbe240,plotHiddenBear) ? osc - 18 : na, title="4h HBear",  text="4h HBear",  style=shape.labeldown, location=location.absolute, color=bearColor, textcolor=textColor, size=size.tiny)
// 1D  (offset 24)
plotshape(g(bD,plotBull)         ? osc + 24 : na, title="1D Bull",   text="1D Bull",   style=shape.labelup,   location=location.absolute, color=bullColor, textcolor=textColor, size=size.tiny)
plotshape(g(hbD,plotHiddenBull)  ? osc + 24 : na, title="1D HBull",  text="1D HBull",  style=shape.labelup,   location=location.absolute, color=bullColor, textcolor=textColor, size=size.tiny)
plotshape(g(beD,plotBear)        ? osc - 24 : na, title="1D Bear",   text="1D Bear",   style=shape.labeldown, location=location.absolute, color=bearColor, textcolor=textColor, size=size.tiny)
plotshape(g(hbeD,plotHiddenBear) ? osc - 24 : na, title="1D HBear",  text="1D HBear",  style=shape.labeldown, location=location.absolute, color=bearColor, textcolor=textColor, size=size.tiny)
// 1W  (offset 30)
plotshape(g(bW,plotBull)         ? osc + 30 : na, title="1W Bull",   text="1W Bull",   style=shape.labelup,   location=location.absolute, color=bullColor, textcolor=textColor, size=size.tiny)
plotshape(g(hbW,plotHiddenBull)  ? osc + 30 : na, title="1W HBull",  text="1W HBull",  style=shape.labelup,   location=location.absolute, color=bullColor, textcolor=textColor, size=size.tiny)
plotshape(g(beW,plotBear)        ? osc - 30 : na, title="1W Bear",   text="1W Bear",   style=shape.labeldown, location=location.absolute, color=bearColor, textcolor=textColor, size=size.tiny)
plotshape(g(hbeW,plotHiddenBear) ? osc - 30 : na, title="1W HBear",  text="1W HBear",  style=shape.labeldown, location=location.absolute, color=bearColor, textcolor=textColor, size=size.tiny)
// 1M  (offset 36)
plotshape(g(bM,plotBull)         ? osc + 36 : na, title="1M Bull",   text="1M Bull",   style=shape.labelup,   location=location.absolute, color=bullColor, textcolor=textColor, size=size.tiny)
plotshape(g(hbM,plotHiddenBull)  ? osc + 36 : na, title="1M HBull",  text="1M HBull",  style=shape.labelup,   location=location.absolute, color=bullColor, textcolor=textColor, size=size.tiny)
plotshape(g(beM,plotBear)        ? osc - 36 : na, title="1M Bear",   text="1M Bear",   style=shape.labeldown, location=location.absolute, color=bearColor, textcolor=textColor, size=size.tiny)
plotshape(g(hbeM,plotHiddenBear) ? osc - 36 : na, title="1M HBear",  text="1M HBear",  style=shape.labeldown, location=location.absolute, color=bearColor, textcolor=textColor, size=size.tiny)

// ---------------- Alerts (any enabled + valid TF) ----------------
anyBull  = plotBull       and (b5 or b15 or b60 or b240 or bD or bW or bM)
anyHBull = plotHiddenBull and (hb5 or hb15 or hb60 or hb240 or hbD or hbW or hbM)
anyBear  = plotBear       and (be5 or be15 or be60 or be240 or beD or beW or beM)
anyHBear = plotHiddenBear and (hbe5 or hbe15 or hbe60 or hbe240 or hbeD or hbeW or hbeM)
alertcondition(anyBull,  title="Bullish Divergence (any TF)",        message="RSI Bullish Divergence on an enabled timeframe")
alertcondition(anyHBull, title="Hidden Bullish Divergence (any TF)", message="RSI Hidden Bullish Divergence on an enabled timeframe")
alertcondition(anyBear,  title="Bearish Divergence (any TF)",        message="RSI Bearish Divergence on an enabled timeframe")
alertcondition(anyHBear, title="Hidden Bearish Divergence (any TF)", message="RSI Hidden Bearish Divergence on an enabled timeframe")