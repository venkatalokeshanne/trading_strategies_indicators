//@version=6
indicator(
    title = "Auto Fibonacci Fan - Confirmed Pivots [AFD]",
    shorttitle = "Auto Fib Fan [AFD]",
    overlay = true,
    max_bars_back = 500,
    max_lines_count = 40
)

// Constants and tooltip copy

