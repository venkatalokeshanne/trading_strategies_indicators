//@version=6
strategy("Rabiah6X - 75% Target High-Probability Pullback", overlay=true, initial_capital=2000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, currency=currency.USDT)

// --- INPUTS ---
// Trend and Pullback Parameters
ma_long_len  = input.int(200, title="Macro Trend Filter MA (200)")
ma_short_len = input.int(21,  title="Short Trend MA (21)")
rsi_len      = input.int(14,  title="RSI Length")
rsi_oversold = input.int(45,  title="RSI Pullback Low Threshold")
rsi_overbought = input.int(70, title="RSI Overbought Cap")

// ADX Filter for Trend Strength
adx_len      = input.int(14, title="ADX Smoothing")
adx_threshold= input.float(20.0, title="Minimum ADX Trend Strength")

// --- CALCULATIONS ---
// Macro & Short Moving Averages
macro_ma = ta.sma(close, ma_long_len)
short_ma = ta.ema(close, ma_short_len)

// ADX (Average Directional Index) Calculation for Trend Strength
diLen = adx_len
dirmov(len) =>
    up = ta.change(high)
    down = -ta.change(low)
    plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
    minusDM = na(down) ? na : (down > plusDM and down > 0 ? down : 0)
    [plusDM, minusDM]

[plusDM, minusDM] = dirmov(diLen)
trur = ta.rma(ta.tr, diLen)
plus = fixnan(100 * ta.rma(plusDM, diLen) / trur)
minus = fixnan(100 * ta.rma(minusDM, diLen) / trur)
sum = plus + minus
adx = 100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), diLen)

// RSI Momentum
rsi = ta.rsi(close, rsi_len)

// --- ENTRY CONDITIONS (High Win-Rate Confluence) ---
// 1. Price must be above the 200 Macro MA (Bull Market Regime)
bool macro_trend_ok = close > macro_ma

// 2. Trend Strength Filter (ADX must show a real trend, not flat chop)
bool trend_strong = adx > adx_threshold

// 3. Pullback Entry: Price dips near or touches the short EMA while RSI pulls back into a value zone
bool pullback_trigger = ta.crossover(close, short_ma) or (close > short_ma and close[1] <= short_ma[1])
bool rsi_filter = rsi >= rsi_oversold and rsi <= rsi_overbought

// Final Buy Confluence
bool buy_signal = macro_trend_ok and trend_strong and pullback_trigger and rsi_filter

if (buy_signal)
    strategy.entry("75% Winrate Long", strategy.long)

// --- RISK MANAGEMENT (Precision Challenge Exit) ---
float atr_val = ta.atr(14)
float stop_loss = close - (atr_val * 1.8)
float take_profit = close + (atr_val * 1.2)

if (strategy.position_size > 0)
    strategy.exit("Managed Exit", "75% Winrate Long", stop=stop_loss, limit=take_profit)

// --- PLOTTING ---
plot(macro_ma, color=color.blue, title="Macro Trend MA (200)")
plot(short_ma, color=color.orange, title="Short Trend MA (21)")
plotshape(buy_signal, title="High Probability Pullback Buy", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)