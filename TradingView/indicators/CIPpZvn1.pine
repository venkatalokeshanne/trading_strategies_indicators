//@version=6
indicator("Sức mạnh tương đối (RS) vs VNINDEX", overlay=false)

// 1. Lấy dữ liệu VNINDEX
reference = "INDEX:VNINDEX" // Thêm tiền tố INDEX để TradingView nhận diện chính xác
vnindex = request.security(reference, timeframe.period, close)

// 2. Tính toán đường RS
rs = close / vnindex

// 3. Tính toán 2 đường trung bình (Nhanh và Chậm)
sig_fast = ta.ema(rs, 9)   // Đường trung bình nhanh (9 phiên)
sig_slow = ta.ema(rs, 20)  // Đường trung bình chậm (20 phiên) - chính là đường 'sig' cũ của bạn

// 4. Vẽ các đường này lên biểu đồ phụ
plot(rs, title="Đường RS", color=color.blue, linewidth=2)
plot(sig_fast, title="EMA Nhanh (9)", color=color.orange, linewidth=1)
plot(sig_slow, title="EMA Chậm (20)", color=color.yellow, linewidth=1)