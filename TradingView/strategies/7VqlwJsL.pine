// strategy_archetype: first_principles
//@version=6
strategy("Auto-Logger Signal Tracker", overlay=true, initial_capital=10000000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, currency=currency.NONE)

// --- Inputs ---
base_win_rate = input.float(10.0, "Bayesian Base Win Rate %", minval=0.0, maxval=100.0) / 100.0
target_rr = input.float(19.0, "Target RR Ratio")
optimism_bias = input.float(0.05, "Optimism Bias Adjustment", minval=0.0, maxval=1.0)

// --- External Signal Mapping (Manual setup for user to link via inputs) ---
// Since we cannot directly "read" variables from other scripts without library exports,
// we use external inputs for the user to map boolean conditions.
group_signals = "Indikator Signal Mapping"
s1_long = input.bool(false, "Trend Signals [UAlgo] Long", group=group_signals)
s1_short = input.bool(false, "Trend Signals [UAlgo] Short", group=group_signals)
s2_long = input.bool(false, "Sniper Entry [KhanSaab] Long", group=group_signals)
s2_short = input.bool(false, "Sniper Entry [KhanSaab] Short", group=group_signals)
s3_long = input.bool(false, "CRT Setup [HTF] Long", group=group_signals)
s3_short = input.bool(false, "CRT Setup [HTF] Short", group=group_signals)
s4_long = input.bool(false, "Trend Targets [AlgoAlpha] Long", group=group_signals)
s4_short = input.bool(false, "Trend Targets [AlgoAlpha] Short", group=group_signals)
s5_long = input.bool(false, "Breakout [AL SULTAN] Long", group=group_signals)
s5_short = input.bool(false, "Breakout [AL SULTAN] Short", group=group_signals)
s6_long = input.bool(false, "Breakout [AlgoAlpha] Long", group=group_signals)
s6_short = input.bool(false, "Breakout [AlgoAlpha] Short", group=group_signals)

// Aggregated Signals
long_signal = s1_long or s2_long or s3_long or s4_long or s5_long or s6_long
short_signal = s1_short or s2_short or s3_short or s4_short or s5_short or s6_short

// --- Strategy Logic ---
if long_signal and strategy.position_size == 0
    float sl = low * 0.99
    float tp = close + (close - sl) * target_rr
    strategy.entry("Long", strategy.long, comment="B:" + str.tostring(close, "#.##"))
    strategy.exit("Exit Long", "Long", stop=sl, limit=tp)

if short_signal and strategy.position_size == 0
    float sl = high * 1.01
    float tp = close - (sl - close) * target_rr
    strategy.entry("Short", strategy.short, comment="S:" + str.tostring(close, "#.##"))
    strategy.exit("Exit Short", "Short", stop=sl, limit=tp)

// --- Statistics & Logging ---
var int total_trades = 0
var int wins = 0
var int losses = 0
var float total_win_amount = 0.0
var float total_loss_amount = 0.0
var int total_duration = 0

// Track closed trades
if strategy.closedtrades > strategy.closedtrades[1]
    total_trades += 1
    float pnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
    int duration = strategy.closedtrades.exit_bar_index(strategy.closedtrades - 1) - strategy.closedtrades.entry_bar_index(strategy.closedtrades - 1)
    total_duration += duration
    
    if pnl > 0
        wins += 1
        total_win_amount += pnl
    else
        losses += 1
        total_loss_amount += math.abs(pnl)

// Calculations
float win_rate = total_trades > 0 ? wins / total_trades : 0.0
float avg_win = wins > 0 ? total_win_amount / wins : 0.0
float avg_loss = losses > 0 ? total_loss_amount / losses : 0.0
float ev = (win_rate * avg_win) - ((1.0 - win_rate) * avg_loss)
float pf = total_loss_amount > 0 ? total_win_amount / total_loss_amount : na
float avg_duration = total_trades > 0 ? float(total_duration) / total_trades : 0.0

// Bayesian Update (Beta Distribution: Prior Alpha=Base*10, Beta=(1-Base)*10)
float alpha_prior = base_win_rate * 10.0
float beta_prior = (1.0 - base_win_rate) * 10.0
float posterior_win_rate = (alpha_prior + wins) / (alpha_prior + beta_prior + total_trades)

// Prospect Theory Utility: U(x) = x^0.88 (Loss Aversion simplified as utility adjustment)
float utility_ev = total_trades > 0 ? (math.pow(avg_win, 0.88) * win_rate) - (math.pow(avg_loss, 0.88) * (1.0 - win_rate)) : 0.0

// Confidence Interval (95% for Win Rate)
float z = 1.96
float ci_margin = total_trades > 0 ? z * math.sqrt((win_rate * (1 - win_rate)) / total_trades) : 0.0

// --- UI Table ---
var table stats_table = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)

f_fill_cell(_table, _column, _row, _title, _value, _color) =>
    table.cell(_table, _column, _row, _title, text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 50))
    table.cell(_table, _column + 1, _row, _value, text_color=_color, text_size=size.small)

if barstate.islast
    f_fill_cell(stats_table, 0, 0, "Total Trades", str.tostring(total_trades), color.white)
    f_fill_cell(stats_table, 0, 1, "Wins / Losses", str.tostring(wins) + " / " + str.tostring(losses), color.white)
    f_fill_cell(stats_table, 0, 2, "Win Rate %", str.tostring(win_rate * 100, "#.##") + "%", color.lime)
    f_fill_cell(stats_table, 0, 3, "Avg Win (IDR)", str.tostring(avg_win, "#,###"), color.lime)
    f_fill_cell(stats_table, 0, 4, "Avg Loss (IDR)", str.tostring(avg_loss, "#,###"), color.red)
    f_fill_cell(stats_table, 0, 5, "Expected Value", str.tostring(ev, "#,###"), ev >= 0 ? color.lime : color.red)
    f_fill_cell(stats_table, 0, 6, "Profit Factor", str.tostring(pf, "#.##"), color.yellow)
    f_fill_cell(stats_table, 0, 7, "Avg Duration (Bars)", str.tostring(avg_duration, "#.##"), color.white)
    f_fill_cell(stats_table, 0, 8, "Bayesian Post. WR", str.tostring(posterior_win_rate * 100, "#.##") + "%", color.aqua)
    f_fill_cell(stats_table, 0, 9, "95% CI WR", "±" + str.tostring(ci_margin * 100, "#.##") + "%", color.gray)
    f_fill_cell(stats_table, 0, 10, "Utility U(x)", str.tostring(utility_ev, "#.##"), color.orange)
    f_fill_cell(stats_table, 0, 11, "Max Drawdown", str.tostring(strategy.max_drawdown / strategy.initial_capital * 100, "#.##") + "%", color.red)
