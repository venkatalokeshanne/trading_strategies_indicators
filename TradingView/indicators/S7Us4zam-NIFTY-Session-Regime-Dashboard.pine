        table.cell(dash, 3, 14, str.tostring(inRSI, "#.0"), text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

        table.cell(dash, 4, 14, str.tostring(in15, "#.2") + "%", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

        table.cell(dash, 5, 14, str.tostring(in60, "#.2") + "%", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

