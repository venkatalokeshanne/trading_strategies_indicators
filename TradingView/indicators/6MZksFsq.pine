//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// HELPER FUNCTIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_position(_vertical, _horizontal) =>
    switch _vertical + "_" + _horizontal
        "top_left"      => position.top_left
        "top_center"    => position.top_center
        "top_right"     => position.top_right
        "middle_left"   => position.middle_left
        "middle_center" => position.middle_center
        "middle_right"  => position.middle_right
        "bottom_left"   => position.bottom_left
        "bottom_center" => position.bottom_center
        "bottom_right"  => position.bottom_right
        => position.top_center


f_size(_size) =>
    switch _size
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        "huge"   => size.huge
        => size.normal


f_alignment(_alignment) =>
    switch _alignment
        "left"   => text.align_left
        "center" => text.align_center
        "right"  => text.align_right
        => text.align_center


f_timeframe_label() =>
    timeframe.isseconds ? timeframe.period + "S" :
     timeframe.isminutes ? timeframe.period + "M" :
     timeframe.isdaily   ? "1D" :
     timeframe.isweekly  ? "1W" :
     timeframe.ismonthly ? "1Mo" :
     timeframe.period


f_date_label(_timestamp, _format) =>
    _day = dayofmonth(_timestamp)
    _month = month(_timestamp)
    _year = year(_timestamp)

    _dayText = _day < 10 ? "0" + str.tostring(_day) : str.tostring(_day)
    _monthText = _month < 10 ? "0" + str.tostring(_month) : str.tostring(_month)

    switch _format
        "D/M/YYYY"    => str.tostring(_day) + "/" + str.tostring(_month) + "/" + str.tostring(_year)
        "DD/MM/YYYY" => _dayText + "/" + _monthText + "/" + str.tostring(_year)
        "YYYY-MM-DD" => str.tostring(_year) + "-" + _monthText + "-" + _dayText
        => str.tostring(_day) + "/" + str.tostring(_month) + "/" + str.tostring(_year)


f_add_part(_base, _part, _separator) =>
    _part == "" ? _base : _base == "" ? _part : _base + _separator + _part


f_status_text(_label, _status) =>
    _status == "Off" or _label == "" ? "" : _label + " " + _status


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TEMPLATE LOGIC
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

isMinimal = templateMode == "Minimal"
isChartNotes = templateMode == "Chart Notes"
isTradingJournal = templateMode == "Trading Journal"
isEducation = templateMode == "Education"
isChecklist = templateMode == "Checklist"
isFooterOnly = templateMode == "Footer Only"
isReviewMode = templateMode == "Review Mode"

templateTitle =
     isMinimal ? "Chart Context" :
     isChartNotes ? "Chart Notes" :
     isTradingJournal ? "Trading Journal" :
     isEducation ? "Education Chart" :
     isChecklist ? "Trade Checklist" :
     isFooterOnly ? "" :
     isReviewMode ? "Trade Review" :
     titleTextInput

templateSubtitle =
     isMinimal ? "" :
     isChartNotes ? "Context | Plan | Observation" :
     isTradingJournal ? "Setup | Session | Execution" :
     isEducation ? "Structure | Liquidity | Execution" :
     isChecklist ? "" :
     isFooterOnly ? "" :
     isReviewMode ? "Observation | Decision | Outcome" :
     subtitleTextInput

templateNote1 =
     isMinimal ? "" :
     isChartNotes ? "Primary note" :
     isTradingJournal ? "Pre-trade note" :
     isEducation ? "Key concept" :
     isChecklist ? "" :
     isFooterOnly ? "" :
     isReviewMode ? "What happened?" :
     noteLine1Input

templateNote2 =
     isMinimal ? "" :
     isChartNotes ? "Secondary note" :
     isTradingJournal ? "Post-trade note" :
     isEducation ? "Chart example" :
     isChecklist ? "" :
     isFooterOnly ? "" :
     isReviewMode ? "What to improve?" :
     noteLine2Input

titleText = useTemplateText ? templateTitle : titleTextInput
subtitleText = useTemplateText ? templateSubtitle : subtitleTextInput
noteLine1Text = useTemplateText ? templateNote1 : noteLine1Input
noteLine2Text = useTemplateText ? templateNote2 : noteLine2Input

topNoteLineText = ""
topNoteLineText := f_add_part(topNoteLineText, noteLine1Text, noteSeparator)
topNoteLineText := f_add_part(topNoteLineText, noteLine2Text, noteSeparator)

showTitle =
     isFooterOnly ? false :
     templateMode == "Custom" ? showTitleInput :
     titleText != ""

showSubtitle =
     isFooterOnly ? false :
     isMinimal ? false :
     templateMode == "Custom" ? showSubtitleInput :
     subtitleText != ""

showNoteLine1 =
     isFooterOnly ? false :
     isMinimal ? false :
     templateMode == "Custom" ? showNoteLine1Input :
     noteLine1Text != ""

showNoteLine2 =
     isFooterOnly ? false :
     isMinimal ? false :
     templateMode == "Custom" ? showNoteLine2Input :
     noteLine2Text != ""

showChecklist =
     isChecklist ? true :
     isTradingJournal ? true :
     isEducation ? true :
     templateMode == "Custom" ? showChecklistInput :
     false

showFooter =
     templateMode == "Custom" ? showFooterInput :
     true

showSession =
     isMinimal ? false :
     isChartNotes ? true :
     isTradingJournal ? true :
     isEducation ? true :
     isChecklist ? true :
     isReviewMode ? true :
     templateMode == "Custom" ? showSessionInput :
     false


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// STYLE LOGIC
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

titleSizeFinal =
     contentMode and titleSizeInput == "normal" ? "large" :
     titleSizeInput

subtitleSizeFinal =
     contentMode and subtitleSizeInput == "normal" ? "large" :
     subtitleSizeInput

noteSizeFinal =
     contentMode and noteSizeInput == "small" ? "normal" :
     noteSizeInput

footerSizeFinal =
     contentMode and footerSizeInput == "large" ? "huge" :
     footerSizeInput

checklistSizeFinal =
     contentMode and checklistSizeInput == "normal" ? "large" :
     checklistSizeInput

titleColor = color.new(titleColorBase, titleTransparency)
subtitleColor = color.new(subtitleColorBase, subtitleTransparency)
noteColor = color.new(noteColorBase, noteTransparency)
checklistColor = color.new(checklistColorBase, checklistTransparency)
footerColor = color.new(footerColorBase, footerTransparency)
footerNoteColor = color.new(footerNoteColorBase, footerNoteTransparency)
backgroundColor = color.new(backgroundColorBase, backgroundTransparency)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SESSION LOGIC
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

inAsia = not na(time(timeframe.period, asiaSession, sessionTimezone))
inLondon = not na(time(timeframe.period, londonSession, sessionTimezone))
inNyAm = not na(time(timeframe.period, nyAmSession, sessionTimezone))
inNyLunch = not na(time(timeframe.period, nyLunchSession, sessionTimezone))
inNyPm = not na(time(timeframe.period, nyPmSession, sessionTimezone))

sessionLabel =
     inNyAm ? "NY AM" :
     inNyLunch ? "NY LUNCH" :
     inNyPm ? "NY PM" :
     inLondon ? "LONDON" :
     inAsia ? "ASIA" :
     showOffSessionLabel ? "OFF SESSION" :
     ""


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TEXT VALUES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

timeframeLabel = f_timeframe_label()

dateTimestamp = footerDateSource == "Today" ? timenow : time
footerDateText = f_date_label(dateTimestamp, footerDateFormat)

symbolBase =
     showFooterExchange and syminfo.prefix != "" ?
     syminfo.prefix + ":" + syminfo.ticker :
     syminfo.ticker

footerSymbolLine = ""
footerSymbolLine := showFooterSymbol ? f_add_part(footerSymbolLine, symbolBase, footerSeparator) : footerSymbolLine
footerSymbolLine := showFooterTimeframe ? f_add_part(footerSymbolLine, timeframeLabel, footerSeparator) : footerSymbolLine
footerSymbolLine := showSession and sessionLabel != "" ? f_add_part(footerSymbolLine, sessionLabel, footerSeparator) : footerSymbolLine

footerDateLine = ""
footerDateLine := showFooterDate ? f_add_part(footerDateLine, footerDateText, footerLineSeparator) : footerDateLine

oneLineFooter = ""
oneLineFooter := showFooterDate ? f_add_part(oneLineFooter, footerDateText, footerLineSeparator) : oneLineFooter
oneLineFooter := footerSymbolLine != "" ? f_add_part(oneLineFooter, footerSymbolLine, footerLineSeparator) : oneLineFooter

checklistItem1Text = f_status_text(checklistItem1Name, checklistItem1Status)
checklistItem2Text = f_status_text(checklistItem2Name, checklistItem2Status)
checklistItem3Text = f_status_text(checklistItem3Name, checklistItem3Status)
checklistItem4Text = f_status_text(checklistItem4Name, checklistItem4Status)
checklistItem5Text = f_status_text(checklistItem5Name, checklistItem5Status)

checklistLine = ""
checklistLine := f_add_part(checklistLine, checklistItem1Text, checklistSeparator)
checklistLine := f_add_part(checklistLine, checklistItem2Text, checklistSeparator)
checklistLine := f_add_part(checklistLine, checklistItem3Text, checklistSeparator)
checklistLine := f_add_part(checklistLine, checklistItem4Text, checklistSeparator)
checklistLine := f_add_part(checklistLine, checklistItem5Text, checklistSeparator)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TABLES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

watermarkPosition = f_position(watermarkVerticalPosition, watermarkHorizontalPosition)
footerPosition = f_position(footerVerticalPosition, footerHorizontalPosition)

maxWatermarkRows = 70
maxFooterRows = 10

var table watermarkTable = table.new(
     watermarkPosition,
     1,
     maxWatermarkRows,
     bgcolor = backgroundColor,
     frame_color = color.new(color.white, 100),
     border_color = color.new(color.white, 100)
)

var table footerTable = table.new(
     footerPosition,
     1,
     maxFooterRows,
     bgcolor = backgroundColor,
     frame_color = color.new(color.white, 100),
     border_color = color.new(color.white, 100)
)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DRAW
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if barstate.islast
    table.clear(watermarkTable, 0, 0, 0, maxWatermarkRows - 1)
    table.clear(footerTable, 0, 0, 0, maxFooterRows - 1)

    currentRow = 0

    if topPaddingRows > 0
        for i = 0 to topPaddingRows - 1
            table.cell(
                 watermarkTable,
                 0,
                 currentRow,
                 " ",
                 width = cellWidth,
                 height = topPaddingRowHeight,
                 text_color = color.new(color.white, 100),
                 bgcolor = backgroundColor
            )
            currentRow += 1

    if showTitle and titleText != ""
        table.cell(
             watermarkTable,
             0,
             currentRow,
             titleText,
             width = cellWidth,
             height = cellHeight,
             text_color = titleColor,
             text_size = f_size(titleSizeFinal),
             text_halign = f_alignment(titleAlignment),
             bgcolor = backgroundColor
        )
        currentRow += 1

    if spacingTitleSubtitle > 0
        for i = 0 to spacingTitleSubtitle - 1
            table.cell(
                 watermarkTable,
                 0,
                 currentRow,
                 " ",
                 width = cellWidth,
                 height = 1,
                 text_color = color.new(color.white, 100),
                 bgcolor = backgroundColor
            )
            currentRow += 1

    if showSubtitle and subtitleText != ""
        table.cell(
             watermarkTable,
             0,
             currentRow,
             subtitleText,
             width = cellWidth,
             height = cellHeight,
             text_color = subtitleColor,
             text_size = f_size(subtitleSizeFinal),
             text_halign = f_alignment(subtitleAlignment),
             bgcolor = backgroundColor
        )
        currentRow += 1

    if spacingSubtitleNotes > 0
        for i = 0 to spacingSubtitleNotes - 1
            table.cell(
                 watermarkTable,
                 0,
                 currentRow,
                 " ",
                 width = cellWidth,
                 height = 1,
                 text_color = color.new(color.white, 100),
                 bgcolor = backgroundColor
            )
            currentRow += 1

    if noteLayout == "One Line"
        if (showNoteLine1 or showNoteLine2) and topNoteLineText != ""
            table.cell(
                 watermarkTable,
                 0,
                 currentRow,
                 topNoteLineText,
                 width = cellWidth,
                 height = cellHeight,
                 text_color = noteColor,
                 text_size = f_size(noteSizeFinal),
                 text_halign = f_alignment(noteAlignment),
                 bgcolor = backgroundColor
            )
            currentRow += 1
    else
        if showNoteLine1 and noteLine1Text != ""
            table.cell(
                 watermarkTable,
                 0,
                 currentRow,
                 noteLine1Text,
                 width = cellWidth,
                 height = cellHeight,
                 text_color = noteColor,
                 text_size = f_size(noteSizeFinal),
                 text_halign = f_alignment(noteAlignment),
                 bgcolor = backgroundColor
            )
            currentRow += 1

        if spacingNoteLines > 0
            for i = 0 to spacingNoteLines - 1
                table.cell(
                     watermarkTable,
                     0,
                     currentRow,
                     " ",
                     width = cellWidth,
                     height = 1,
                     text_color = color.new(color.white, 100),
                     bgcolor = backgroundColor
                )
                currentRow += 1

        if showNoteLine2 and noteLine2Text != ""
            table.cell(
                 watermarkTable,
                 0,
                 currentRow,
                 noteLine2Text,
                 width = cellWidth,
                 height = cellHeight,
                 text_color = noteColor,
                 text_size = f_size(noteSizeFinal),
                 text_halign = f_alignment(noteAlignment),
                 bgcolor = backgroundColor
            )
            currentRow += 1

    if showChecklist and checklistLine != ""
        if spacingBeforeChecklist > 0
            for i = 0 to spacingBeforeChecklist - 1
                table.cell(
                     watermarkTable,
                     0,
                     currentRow,
                     " ",
                     width = cellWidth,
                     height = 1,
                     text_color = color.new(color.white, 100),
                     bgcolor = backgroundColor
                )
                currentRow += 1

        if checklistTitle != ""
            table.cell(
                 watermarkTable,
                 0,
                 currentRow,
                 checklistTitle,
                 width = cellWidth,
                 height = cellHeight,
                 text_color = titleColor,
                 text_size = f_size(titleSizeFinal),
                 text_halign = f_alignment(titleAlignment),
                 bgcolor = backgroundColor
            )
            currentRow += 1

        table.cell(
             watermarkTable,
             0,
             currentRow,
             checklistLine,
             width = cellWidth,
             height = cellHeight,
             text_color = checklistColor,
             text_size = f_size(checklistSizeFinal),
             text_halign = f_alignment(checklistAlignment),
             bgcolor = backgroundColor
        )

    footerRow = 0

    if showFooter
        if footerLayout == "One Line"
            if oneLineFooter != ""
                table.cell(
                     footerTable,
                     0,
                     footerRow,
                     oneLineFooter,
                     width = cellWidth,
                     height = cellHeight,
                     text_color = footerColor,
                     text_size = f_size(footerSizeFinal),
                     text_halign = f_alignment(footerAlignment),
                     bgcolor = backgroundColor
                )
                footerRow += 1
        else
            if footerDateLine != ""
                table.cell(
                     footerTable,
                     0,
                     footerRow,
                     footerDateLine,
                     width = cellWidth,
                     height = cellHeight,
                     text_color = footerColor,
                     text_size = f_size(footerSizeFinal),
                     text_halign = f_alignment(footerAlignment),
                     bgcolor = backgroundColor
                )
                footerRow += 1

            if footerSymbolLine != ""
                table.cell(
                     footerTable,
                     0,
                     footerRow,
                     footerSymbolLine,
                     width = cellWidth,
                     height = cellHeight,
                     text_color = footerColor,
                     text_size = f_size(footerSizeFinal),
                     text_halign = f_alignment(footerAlignment),
                     bgcolor = backgroundColor
                )
                footerRow += 1

        if showFooterNote and footerNoteText != ""
            table.cell(
                 footerTable,
                 0,
                 footerRow,
                 footerNoteText,
                 width = cellWidth,
                 height = cellHeight,
                 text_color = footerNoteColor,
                 text_size = f_size(footerNoteSizeInput),
                 text_halign = f_alignment(footerAlignment),
                 bgcolor = backgroundColor
            )
            footerRow += 1

        if footerBottomPaddingRows > 0
            for i = 0 to footerBottomPaddingRows - 1
                table.cell(
                     footerTable,
                     0,
                     footerRow,
                     " ",
                     width = cellWidth,
                     height = footerPaddingRowHeight,
                     text_color = color.new(color.white, 100),
                     bgcolor = backgroundColor
                )
                footerRow += 1