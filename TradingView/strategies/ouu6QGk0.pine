//@version=5
strategy("NQ 區間突破 (觸價即進場版)", overlay=true, initial_capital=10000, pyramiding=1)

// --- 1. 輸入設定 ---
user_timezone = input.string("Asia/Taipei", "圖表顯示時區", options=["Asia/Taipei", "America/New_York", "UTC"])
start_h       = input.int(11, "區間開始 (小時)", minval=0, maxval=23)
start_m       = input.int(43,  "區間開始 (分鐘)", minval=0, maxval=59)
end_h         = input.int(13, "區進結束 (小時)", minval=0, maxval=23)
end_m         = input.int(33,  "區間結束 (分鐘)", minval=0, maxval=59)

buffer_input  = input.float(38.2, "進場緩衝比例 (%)", minval=0.0, step=0.5)
tp_ratio      = input.float(0.618, "止盈倍數", step=0.01)
sl_at_level   = input.float(0.1,  "止損位於區間水平", step=0.01)
max_range_pct = input.float(1.0, "最大區間比例 (%)", minval=0.1, step=0.1) / 100
min_range_pct = input.float(0.1, "最小區間比例 (%)", minval=0.0, step=0.05) / 100

// --- 2. 時間計算 ---
curr_hour   = hour(time, user_timezone)
curr_minute = minute(time, user_timezone)
curr_time_total = curr_hour * 60 + curr_minute

start_time_total = start_h * 60 + start_m
end_time_total   = end_h * 60 + end_m

// --- 3. 變數與換日重執 ---
var float r_h = na
var float r_l = na
var bool already_traded_today = false

// 換日判定
if ta.change(dayofmonth(time, user_timezone))
    r_h := na
    r_l := na
    already_traded_today := false

// --- 4. 區間定義 ---
in_range = curr_time_total >= start_time_total and curr_time_total < end_time_total
in_trade_window = curr_time_total >= end_time_total

if in_range
    //標記區間高低點
    r_h := na(r_h) ? high : math.max(r_h, high)
    r_l := na(r_l) ? low : math.min(r_l, low)

// --- 4.5 區間大小判斷 (Oversize Filter) ---
// 計算區間佔價格的比例
range_percent = (r_h - r_l) / r_h

// 判斷是否過大 (0.01 即為 1%)
is_oversize = range_percent > max_range_pct
is_undersize = range_percent < min_range_pct 

// --- 5. 核心交易邏輯 (觸價進場) ---
// 只要目前有持倉，或今日平倉單數增加，就標記已交易
if strategy.position_size != 0 or strategy.closedtrades > strategy.closedtrades[1]
    already_traded_today := true

can_trade = in_trade_window and not na(r_h) and not already_traded_today and not is_oversize and not is_undersize


if can_trade
    range_sz  = r_h - r_l
    long_trg  = r_h + (range_sz * (buffer_input / 100))
    short_trg = r_l - (range_sz * (buffer_input / 100))
    
    long_sl   = r_l + (range_sz * sl_at_level)
    short_sl  = r_h - (range_sz * sl_at_level)
    long_tp   = r_h + (range_sz * tp_ratio)
    short_tp  = r_l - (range_sz * tp_ratio)

    // --- 準備發送給 TradeVote 的 JSON 訊息 ---
    // 我們使用 str.tostring() 將算好的動態價位轉為文字
    
    // 多單 JSON：包含進場、止損、止盈
    msg_long = '{"action":"buy", "symbol":"MNQ", "quantity":1, "type":"stop", "price":' + str.tostring(long_trg) + ', "stopLoss":' + str.tostring(long_sl) + ', "takeProfit":' + str.tostring(long_tp) + '}'
    
    // 空單 JSON：包含進場、止損、止盈
    msg_short = '{"action":"sell", "symbol":"MNQ", "quantity":1, "type":"stop", "price":' + str.tostring(short_trg) + ', "stopLoss":' + str.tostring(short_sl) + ', "takeProfit":' + str.tostring(short_tp) + '}'

    // --- 執行下單 (帶入 alert_message) ---
    // 當 TradingView 觸發 stop 價位時，會自動發送對應的 msg
    strategy.entry("Long", strategy.long, stop=long_trg, comment="觸價多", alert_message=msg_long)
    strategy.entry("Short", strategy.short, stop=short_trg, comment="觸價空", alert_message=msg_short)

    // 出場設定 (用於圖表回測顯示)
    strategy.exit("ExL", "Long", limit=long_tp, stop=long_sl, comment_loss="多損", comment_profit="多利")
    strategy.exit("ExS", "Short", limit=short_tp, stop=short_sl, comment_loss="空損", comment_profit="空利")

// 成交後立即撤銷另一邊的掛單
if already_traded_today
    strategy.cancel("Long")
    strategy.cancel("Short")


// --- 6. 繪圖 ---
plot(r_h, "區間高點", color.red, 1, plot.style_linebr)
plot(r_l, "區間低點", color.green, 1, plot.style_linebr)