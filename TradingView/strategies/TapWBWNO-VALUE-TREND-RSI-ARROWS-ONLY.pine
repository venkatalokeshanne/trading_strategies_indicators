//@version=5
strategy("VALUE TREND + RSI (ARROWS ONLY)", overlay=true, pyramiding=10, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// =====================
// RSI
// =====================
rsi14 = ta.rsi(close, 14)

// =====================
// VALUE TREND
// =====================
ma13 = ta.sma(close, 13)
lowest75 = ta.lowest(low, 75)
highest75 = ta.highest(high, 75)
rangeDivider = (highest75 - lowest75) / 100

weightedSma(src, len) =>
    alpha = 1 / len
    var float res = na
    res := na(res) ? src : alpha * src + (1 - alpha) * res

closeNorm = weightedSma((close - lowest75) / rangeDivider, 20)
valueTrend = 3 * closeNorm - 2 * weightedSma(closeNorm, 5)

// =====================
// BUY SIGNAL
// =====================
buySignal = ta.crossover(valueTrend, 25)

// =====================
// STATE LOGIC
// =====================
var bool readyToBuy = false

if (rsi14 < 30)
    readyToBuy := true

entryCondition = readyToBuy and buySignal

// =====================
// ENTRY
// =====================
canEnter = strategy.opentrades == 0

if (entryCondition and canEnter)
    strategy.entry("BUY", strategy.long)
    readyToBuy := false

// =====================
// DCA (-25%)
// =====================
var float lastEntryPrice = na

if (strategy.opentrades > 0)
    lastEntryPrice := strategy.opentrades.entry_price(strategy.opentrades - 1)

dcaCondition = strategy.opentrades > 0 and close <= lastEntryPrice * 0.75

if (dcaCondition)
    strategy.entry("DCA BUY", strategy.long)

// =====================
// EXIT
// =====================
profitBuffer = 1.002
inProfitOrBE = strategy.position_size > 0 and close >= strategy.position_avg_price * profitBuffer

exitZone = rsi14 >= 78 and rsi14 <= 80
exitCondition = exitZone and not exitZone[1] and inProfitOrBE

if (exitCondition)
    strategy.close_all()

// =====================
// ALERTS
// =====================
alertcondition(entryCondition and canEnter, title="BUY SIGNAL", message="🚀 BUY signal triggered")
alertcondition(dcaCondition, title="DCA SIGNAL", message="📉 DCA Buy triggered")
alertcondition(exitCondition, title="EXIT SIGNAL", message="💰 Position closed")