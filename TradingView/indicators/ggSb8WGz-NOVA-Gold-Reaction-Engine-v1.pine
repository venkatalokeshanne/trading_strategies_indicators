//@version=6
indicator(
     "NOVA Gold Reaction Engine v1",
     shorttitle = "NOVA Gold Engine",
     overlay = true,
     max_boxes_count = 100,
     max_labels_count = 500,
     max_lines_count = 100)

//=====================================================================
// NOVA GOLD REACTION ENGINE v1
//
// Intended use:
// - Gold / GC / MGC / XAUUSD
// - 15-minute execution chart
// - 4H confirmed context
//
// PURPOSE:
// 1. Detect supply/demand created before displacement
// 2. Favor zones around Gold round numbers
// 3. Track freshness / retests
// 4. Detect pullback into zone
// 5. Detect liquidity sweep
// 6. Detect rejection/displacement
// 7. Score setup 0-100
// 8. Generate LONG / SHORT reaction alerts
//
// IMPORTANT:
// Score is NOT a claimed probability.
// Forward-test the resulting signals first.
//=====================================================================


//=====================================================================
// INPUTS
//=====================================================================

//-------------------------
// Higher timeframe
//-------------------------
groupHTF = "1. Higher-Timeframe Context"

htf =
     input.timeframe(
         "240",
         "Context timeframe",
         group = groupHTF)

fastLength =
     input.int(
         20,
         "HTF fast EMA",
         minval = 2,
         group = groupHTF)

slowLength =
     input.int(
         50,
         "HTF slow EMA",
         minval = 3,
         group = groupHTF)


//-------------------------
// Supply / Demand
//-------------------------
groupZone = "2. Supply / Demand"

atrLength =
     input.int(
         14,
         "ATR length",
         minval = 2,
         group = groupZone)

baseLookback =
     input.int(
         3,
         "Maximum base candles",
         minval = 1,
         maxval = 6,
         group = groupZone)

displacementATR =
     input.float(
         1.40,
         "Minimum displacement body (ATR)",
         minval = 0.5,
         step = 0.05,
         group = groupZone)

departureATR =
     input.float(
         1.00,
         "Minimum departure range (ATR)",
         minval = 0.5,
         step = 0.05,
         group = groupZone)

maxZoneATR =
     input.float(
         0.80,
         "Maximum zone width (ATR)",
         minval = 0.20,
         step = 0.05,
         group = groupZone)


//-------------------------
// Round numbers
//-------------------------
groupRound = "3. Gold Round Numbers"

roundStep =
     input.float(
         25.0,
         "Round-number interval",
         minval = 1.0,
         step = 1.0,
         group = groupRound,
         tooltip = "25 = XX00, XX25, XX50, XX75")

majorStep =
     input.float(
         100.0,
         "Major round-number interval",
         minval = 25.0,
         step = 25.0,
         group = groupRound)

roundToleranceATR =
     input.float(
         0.30,
         "Round-number tolerance (ATR)",
         minval = 0.05,
         step = 0.05,
         group = groupRound)


//-------------------------
// Structure / liquidity
//-------------------------
groupStructure = "4. Structure & Liquidity"

swingLength =
     input.int(
         5,
         "Swing length",
         minval = 2,
         maxval = 20,
         group = groupStructure)

sweepLookback =
     input.int(
         12,
         "Liquidity sweep lookback",
         minval = 3,
         group = groupStructure)

rejectionWickRatio =
     input.float(
         1.30,
         "Minimum rejection wick/body",
         minval = 0.5,
         step = 0.1,
         group = groupStructure)


//-------------------------
// Signal scoring
//-------------------------
groupScore = "5. Signal Filter"

minimumScore =
     input.int(
         70,
         "Minimum signal score",
         minval = 40,
         maxval = 100,
         group = groupScore)

strongScore =
     input.int(
         85,
         "Strong signal score",
         minval = 60,
         maxval = 100,
         group = groupScore)

maxRetests =
     input.int(
         2,
         "Maximum zone retests",
         minval = 0,
         maxval = 5,
         group = groupScore)


//-------------------------
// Display
//-------------------------
groupDisplay = "6. Display"

showRoundNumbers =
     input.bool(
         true,
         "Show nearest round numbers",
         group = groupDisplay)

showHTFTrend =
     input.bool(
         true,
         "Show HTF trend dashboard",
         group = groupDisplay)

showScores =
     input.bool(
         true,
         "Show signal score labels",
         group = groupDisplay)

showWeakZones =
     input.bool(
         true,
         "Show zones without round-number confluence",
         group = groupDisplay)


//=====================================================================
// CORE CALCULATIONS
//=====================================================================

atr = ta.atr(atrLength)

body =
     math.abs(close - open)

candleRange =
     high - low

upperWick =
     high - math.max(open, close)

lowerWick =
     math.min(open, close) - low

safeBody =
     math.max(body, syminfo.mintick)

bullishCandle =
     close > open

bearishCandle =
     close < open


//=====================================================================
// CONFIRMED 4H CONTEXT
//
// Uses PREVIOUS CONFIRMED HTF candle.
// This intentionally avoids using the still-forming 4H candle.
//=====================================================================

htfClose =
     request.security(
         syminfo.tickerid,
         htf,
         close[1],
         lookahead = barmerge.lookahead_on)

htfFastEMA =
     request.security(
         syminfo.tickerid,
         htf,
         ta.ema(close, fastLength)[1],
         lookahead = barmerge.lookahead_on)

htfSlowEMA =
     request.security(
         syminfo.tickerid,
         htf,
         ta.ema(close, slowLength)[1],
         lookahead = barmerge.lookahead_on)

htfHigh =
     request.security(
         syminfo.tickerid,
         htf,
         high[1],
         lookahead = barmerge.lookahead_on)

htfLow =
     request.security(
         syminfo.tickerid,
         htf,
         low[1],
         lookahead = barmerge.lookahead_on)

htfBull =
     htfFastEMA > htfSlowEMA and
     htfClose > htfFastEMA

htfBear =
     htfFastEMA < htfSlowEMA and
     htfClose < htfFastEMA

htfNeutral =
     not htfBull and
     not htfBear


//=====================================================================
// SWING STRUCTURE
//=====================================================================

pivotHigh =
     ta.pivothigh(
         high,
         swingLength,
         swingLength)

pivotLow =
     ta.pivotlow(
         low,
         swingLength,
         swingLength)

var float lastSwingHigh = na
var float previousSwingHigh = na

var float lastSwingLow = na
var float previousSwingLow = na

if not na(pivotHigh)
    previousSwingHigh := lastSwingHigh
    lastSwingHigh := pivotHigh

if not na(pivotLow)
    previousSwingLow := lastSwingLow
    lastSwingLow := pivotLow

bullStructure =
     not na(lastSwingHigh) and
     not na(previousSwingHigh) and
     not na(lastSwingLow) and
     not na(previousSwingLow) and
     lastSwingHigh > previousSwingHigh and
     lastSwingLow > previousSwingLow

bearStructure =
     not na(lastSwingHigh) and
     not na(previousSwingHigh) and
     not na(lastSwingLow) and
     not na(previousSwingLow) and
     lastSwingHigh < previousSwingHigh and
     lastSwingLow < previousSwingLow


//=====================================================================
// DISPLACEMENT
//=====================================================================

bullDisplacement =
     bullishCandle and
     body >= atr * displacementATR and
     candleRange >= atr * departureATR and
     close > high[1]

bearDisplacement =
     bearishCandle and
     body >= atr * displacementATR and
     candleRange >= atr * departureATR and
     close < low[1]


//=====================================================================
// BASE CANDLE DETECTION
//
// We use the candle immediately before displacement as the primary base.
// Additional filters eliminate excessively large base candles.
//=====================================================================

previousBody =
     math.abs(close[1] - open[1])

previousRange =
     high[1] - low[1]

validBase =
     previousRange <= atr[1] * maxZoneATR

bullBase =
     bullDisplacement and
     validBase

bearBase =
     bearDisplacement and
     validBase


//=====================================================================
// CREATE POTENTIAL ZONES
//
// Demand:
// bottom = base candle low
// top    = upper portion/body of base
//
// Supply:
// top    = base candle high
// bottom = lower portion/body of base
//=====================================================================

newDemandTop =
     math.max(open[1], close[1])

newDemandBottom =
     low[1]

newSupplyTop =
     high[1]

newSupplyBottom =
     math.min(open[1], close[1])


//=====================================================================
// ROUND-NUMBER FUNCTIONS
//=====================================================================

f_nearestRound(float price, float step) =>
    math.round(price / step) * step


f_distanceToRound(float price, float step) =>
    nr = f_nearestRound(price, step)
    math.abs(price - nr)


f_zoneHasRound(float zoneTop, float zoneBottom, float step, float tolerance) =>
    zoneMid =
         (zoneTop + zoneBottom) / 2.0

    nr =
         f_nearestRound(
             zoneMid,
             step)

    nr >= zoneBottom - tolerance and
     nr <= zoneTop + tolerance


roundTolerance =
     atr * roundToleranceATR


//=====================================================================
// ACTIVE DEMAND ZONE STORAGE
//=====================================================================

var float demandTop = na
var float demandBottom = na
var float demandRound = na
var bool demandHasRound = false
var bool demandHasMajorRound = false
var int demandTouches = 0
var bool demandTouchedPreviousBar = false
var box demandBox = na


//=====================================================================
// ACTIVE SUPPLY ZONE STORAGE
//=====================================================================

var float supplyTop = na
var float supplyBottom = na
var float supplyRound = na
var bool supplyHasRound = false
var bool supplyHasMajorRound = false
var int supplyTouches = 0
var bool supplyTouchedPreviousBar = false
var box supplyBox = na


//=====================================================================
// CREATE DEMAND ZONE
//=====================================================================

if bullBase

    candidateRound =
         f_nearestRound(
             (newDemandTop + newDemandBottom) / 2,
             roundStep)

    candidateHasRound =
         f_zoneHasRound(
             newDemandTop,
             newDemandBottom,
             roundStep,
             roundTolerance)

    candidateMajorRound =
         f_zoneHasRound(
             newDemandTop,
             newDemandBottom,
             majorStep,
             roundTolerance)

    if candidateHasRound or showWeakZones

        if not na(demandBox)
            box.delete(demandBox)

        demandTop := newDemandTop
        demandBottom := newDemandBottom

        demandRound := candidateRound

        demandHasRound := candidateHasRound
        demandHasMajorRound := candidateMajorRound

        demandTouches := 0
        demandTouchedPreviousBar := false

        demandBox :=
             box.new(
                 left = bar_index - 1,
                 top = demandTop,
                 right = bar_index,
                 bottom = demandBottom,
                 extend = extend.right,
                 border_width = candidateHasRound ? 2 : 1,
                 border_color =
                     candidateHasRound ?
                     color.lime :
                     color.new(color.green, 35),
                 bgcolor =
                     candidateHasRound ?
                     color.new(color.lime, 86) :
                     color.new(color.green, 92))


//=====================================================================
// CREATE SUPPLY ZONE
//=====================================================================

if bearBase

    candidateRound =
         f_nearestRound(
             (newSupplyTop + newSupplyBottom) / 2,
             roundStep)

    candidateHasRound =
         f_zoneHasRound(
             newSupplyTop,
             newSupplyBottom,
             roundStep,
             roundTolerance)

    candidateMajorRound =
         f_zoneHasRound(
             newSupplyTop,
             newSupplyBottom,
             majorStep,
             roundTolerance)

    if candidateHasRound or showWeakZones

        if not na(supplyBox)
            box.delete(supplyBox)

        supplyTop := newSupplyTop
        supplyBottom := newSupplyBottom

        supplyRound := candidateRound

        supplyHasRound := candidateHasRound
        supplyHasMajorRound := candidateMajorRound

        supplyTouches := 0
        supplyTouchedPreviousBar := false

        supplyBox :=
             box.new(
                 left = bar_index - 1,
                 top = supplyTop,
                 right = bar_index,
                 bottom = supplyBottom,
                 extend = extend.right,
                 border_width = candidateHasRound ? 2 : 1,
                 border_color =
                     candidateHasRound ?
                     color.red :
                     color.new(color.orange, 35),
                 bgcolor =
                     candidateHasRound ?
                     color.new(color.red, 86) :
                     color.new(color.orange, 92))


//=====================================================================
// DETECT ZONE TOUCHES
//=====================================================================

insideDemand =
     not na(demandTop) and
     low <= demandTop and
     high >= demandBottom

insideSupply =
     not na(supplyTop) and
     high >= supplyBottom and
     low <= supplyTop


// Only count a NEW interaction, not every candle sitting inside the zone.

newDemandTouch =
     insideDemand and
     not demandTouchedPreviousBar

newSupplyTouch =
     insideSupply and
     not supplyTouchedPreviousBar


if newDemandTouch
    demandTouches += 1

if newSupplyTouch
    supplyTouches += 1

demandTouchedPreviousBar := insideDemand
supplyTouchedPreviousBar := insideSupply


//=====================================================================
// ZONE INVALIDATION
//=====================================================================

demandBroken =
     not na(demandBottom) and
     close < demandBottom

supplyBroken =
     not na(supplyTop) and
     close > supplyTop


if demandBroken

    if not na(demandBox)
        box.set_extend(
             demandBox,
             extend.none)

        box.set_right(
             demandBox,
             bar_index)

        box.set_bgcolor(
             demandBox,
             color.new(color.gray, 94))

        box.set_border_color(
             demandBox,
             color.new(color.gray, 75))

    demandTop := na
    demandBottom := na
    demandRound := na
    demandTouches := 0
    demandHasRound := false
    demandHasMajorRound := false


if supplyBroken

    if not na(supplyBox)
        box.set_extend(
             supplyBox,
             extend.none)

        box.set_right(
             supplyBox,
             bar_index)

        box.set_bgcolor(
             supplyBox,
             color.new(color.gray, 94))

        box.set_border_color(
             supplyBox,
             color.new(color.gray, 75))

    supplyTop := na
    supplyBottom := na
    supplyRound := na
    supplyTouches := 0
    supplyHasRound := false
    supplyHasMajorRound := false


//=====================================================================
// LIQUIDITY SWEEP
//
// Bullish sweep:
// price takes previous lows then closes back above them.
//
// Bearish sweep:
// price takes previous highs then closes back below them.
//=====================================================================

priorLowest =
     ta.lowest(
         low[1],
         sweepLookback)

priorHighest =
     ta.highest(
         high[1],
         sweepLookback)

bullLiquiditySweep =
     low < priorLowest and
     close > priorLowest

bearLiquiditySweep =
     high > priorHighest and
     close < priorHighest


//=====================================================================
// REJECTION CANDLES
//=====================================================================

bullRejection =
     bullishCandle and
     lowerWick >= safeBody * rejectionWickRatio

bearRejection =
     bearishCandle and
     upperWick >= safeBody * rejectionWickRatio


//=====================================================================
// MICRO DISPLACEMENT CONFIRMATION
//=====================================================================

bullReactionDisplacement =
     bullishCandle and
     body >= atr * 0.65 and
     close > high[1]

bearReactionDisplacement =
     bearishCandle and
     body >= atr * 0.65 and
     close < low[1]


//=====================================================================
// PULLBACK CONDITIONS
//=====================================================================

demandPullback =
     insideDemand and
     demandTouches <= maxRetests + 1

supplyPullback =
     insideSupply and
     supplyTouches <= maxRetests + 1


//=====================================================================
// SCORING ENGINE
//
// Maximum theoretical score = 100
//
// HTF trend              20
// Local structure        10
// Round number           15
// Major XX00             +5
// Fresh zone             15
// Liquidity sweep        15
// Rejection              10
// Reaction displacement  10
//
// Some points overlap purposely.
//=====================================================================

int bullScore = 0
int bearScore = 0


//---------------------------------------------------------------------
// BULLISH SCORE
//---------------------------------------------------------------------

if htfBull
    bullScore += 20

if bullStructure
    bullScore += 10

if demandHasRound
    bullScore += 15

if demandHasMajorRound
    bullScore += 5

if demandTouches == 1
    bullScore += 15
else if demandTouches == 2
    bullScore += 8

if bullLiquiditySweep
    bullScore += 15

if bullRejection
    bullScore += 10

if bullReactionDisplacement
    bullScore += 10


//---------------------------------------------------------------------
// BEARISH SCORE
//---------------------------------------------------------------------

if htfBear
    bearScore += 20

if bearStructure
    bearScore += 10

if supplyHasRound
    bearScore += 15

if supplyHasMajorRound
    bearScore += 5

if supplyTouches == 1
    bearScore += 15
else if supplyTouches == 2
    bearScore += 8

if bearLiquiditySweep
    bearScore += 15

if bearRejection
    bearScore += 10

if bearReactionDisplacement
    bearScore += 10


// Prevent scores above 100.

bullScore := math.min(bullScore, 100)
bearScore := math.min(bearScore, 100)


//=====================================================================
// SIGNAL CONDITIONS
//
// Signals are only confirmed after the current chart candle closes.
//=====================================================================

bullSignal =
     barstate.isconfirmed and
     demandPullback and
     bullScore >= minimumScore and
     bullishCandle and
     (
         bullLiquiditySweep or
         bullRejection or
         bullReactionDisplacement
     )


bearSignal =
     barstate.isconfirmed and
     supplyPullback and
     bearScore >= minimumScore and
     bearishCandle and
     (
         bearLiquiditySweep or
         bearRejection or
         bearReactionDisplacement
     )


strongBullSignal =
     bullSignal and
     bullScore >= strongScore

strongBearSignal =
     bearSignal and
     bearScore >= strongScore


//=====================================================================
// PREVENT REPEATED SIGNAL SPAM
//=====================================================================

var int lastBullSignalBar = na
var int lastBearSignalBar = na

bullSignalFinal =
     bullSignal and
     (
         na(lastBullSignalBar) or
         bar_index - lastBullSignalBar > 2
     )

bearSignalFinal =
     bearSignal and
     (
         na(lastBearSignalBar) or
         bar_index - lastBearSignalBar > 2
     )

if bullSignalFinal
    lastBullSignalBar := bar_index

if bearSignalFinal
    lastBearSignalBar := bar_index


//=====================================================================
// CHART SIGNALS
//=====================================================================

plotshape(
     bullSignalFinal and bullScore < strongScore,
     title = "Bullish Reaction",
     style = shape.triangleup,
     location = location.belowbar,
     size = size.small,
     color = color.lime,
     text = "LONG")

plotshape(
     strongBullSignal and bullSignalFinal,
     title = "Strong Bullish Reaction",
     style = shape.labelup,
     location = location.belowbar,
     size = size.small,
     color = color.lime,
     textcolor = color.black,
     text = "A+ LONG")

plotshape(
     bearSignalFinal and bearScore < strongScore,
     title = "Bearish Reaction",
     style = shape.triangledown,
     location = location.abovebar,
     size = size.small,
     color = color.red,
     text = "SHORT")

plotshape(
     strongBearSignal and bearSignalFinal,
     title = "Strong Bearish Reaction",
     style = shape.labeldown,
     location = location.abovebar,
     size = size.small,
     color = color.red,
     textcolor = color.white,
     text = "A+ SHORT")


//=====================================================================
// SCORE LABELS
//=====================================================================

if showScores and bullSignalFinal

    string bullText =
         "LONG " +
         str.tostring(bullScore) +
         "/100"

    if demandHasRound
        bullText +=
             "\nRound: " +
             str.tostring(
                 demandRound,
                 format.mintick)

    bullText +=
         "\nRetest: " +
         str.tostring(demandTouches)

    if bullLiquiditySweep
        bullText += "\nLiquidity Sweep"

    if bullRejection
        bullText += "\nRejection"

    if bullReactionDisplacement
        bullText += "\nDisplacement"

    label.new(
         bar_index,
         low,
         bullText,
         style = label.style_label_up,
         color =
             bullScore >= strongScore ?
             color.lime :
             color.new(color.lime, 20),
         textcolor = color.black,
         size = size.small)


if showScores and bearSignalFinal

    string bearText =
         "SHORT " +
         str.tostring(bearScore) +
         "/100"

    if supplyHasRound
        bearText +=
             "\nRound: " +
             str.tostring(
                 supplyRound,
                 format.mintick)

    bearText +=
         "\nRetest: " +
         str.tostring(supplyTouches)

    if bearLiquiditySweep
        bearText += "\nLiquidity Sweep"

    if bearRejection
        bearText += "\nRejection"

    if bearReactionDisplacement
        bearText += "\nDisplacement"

    label.new(
         bar_index,
         high,
         bearText,
         style = label.style_label_down,
         color =
             bearScore >= strongScore ?
             color.red :
             color.new(color.red, 20),
         textcolor = color.white,
         size = size.small)


//=====================================================================
// ROUND NUMBER DISPLAY
//=====================================================================

nearestRound =
     f_nearestRound(
         close,
         roundStep)

nextRoundUp =
     nearestRound < close ?
     nearestRound + roundStep :
     nearestRound

nextRoundDown =
     nearestRound > close ?
     nearestRound - roundStep :
     nearestRound


plot(
     showRoundNumbers ?
     nextRoundUp :
     na,
     title = "Upper Round Number",
     color = color.new(color.yellow, 65),
     linewidth = 1,
     style = plot.style_stepline)

plot(
     showRoundNumbers ?
     nextRoundDown :
     na,
     title = "Lower Round Number",
     color = color.new(color.yellow, 65),
     linewidth = 1,
     style = plot.style_stepline)


//=====================================================================
// OPTIONAL SWEEP MARKERS
//=====================================================================

plotshape(
     bullLiquiditySweep,
     title = "Bullish Liquidity Sweep",
     style = shape.circle,
     location = location.belowbar,
     color = color.new(color.aqua, 20),
     size = size.tiny)

plotshape(
     bearLiquiditySweep,
     title = "Bearish Liquidity Sweep",
     style = shape.circle,
     location = location.abovebar,
     color = color.new(color.orange, 20),
     size = size.tiny)


//=====================================================================
// HTF TREND DASHBOARD
//=====================================================================

var table dashboard =
     table.new(
         position.top_right,
         2,
         6,
         border_width = 1)

if barstate.islast and showHTFTrend

    trendText =
         htfBull ?
         "BULLISH" :
         htfBear ?
         "BEARISH" :
         "NEUTRAL"

    trendColor =
         htfBull ?
         color.lime :
         htfBear ?
         color.red :
         color.yellow

    table.cell(
         dashboard,
         0,
         0,
         "NOVA GOLD",
         bgcolor = color.black,
         text_color = color.white)

    table.cell(
         dashboard,
         1,
         0,
         "REACTION ENGINE",
         bgcolor = color.black,
         text_color = color.white)

    table.cell(
         dashboard,
         0,
         1,
         "4H Context")

    table.cell(
         dashboard,
         1,
         1,
         trendText,
         bgcolor = color.new(trendColor, 70),
         text_color = trendColor)

    table.cell(
         dashboard,
         0,
         2,
         "Demand Score")

    table.cell(
         dashboard,
         1,
         2,
         str.tostring(bullScore))

    table.cell(
         dashboard,
         0,
         3,
         "Supply Score")

    table.cell(
         dashboard,
         1,
         3,
         str.tostring(bearScore))

    table.cell(
         dashboard,
         0,
         4,
         "Demand Retests")

    table.cell(
         dashboard,
         1,
         4,
         str.tostring(demandTouches))

    table.cell(
         dashboard,
         0,
         5,
         "Supply Retests")

    table.cell(
         dashboard,
         1,
         5,
         str.tostring(supplyTouches))


//=====================================================================
// ALERT CONDITIONS
//=====================================================================

// Standard signals

alertcondition(
     bullSignalFinal,
     title = "NOVA Gold LONG",
     message =
         "NOVA Gold Engine: bullish reaction detected. " +
         "Check demand zone, round number and current score.")

alertcondition(
     bearSignalFinal,
     title = "NOVA Gold SHORT",
     message =
         "NOVA Gold Engine: bearish reaction detected. " +
         "Check supply zone, round number and current score.")


// Strong A+ signals

alertcondition(
     strongBullSignal and bullSignalFinal,
     title = "NOVA Gold A+ LONG",
     message =
         "NOVA Gold Engine: A+ bullish reaction detected.")

alertcondition(
     strongBearSignal and bearSignalFinal,
     title = "NOVA Gold A+ SHORT",
     message =
         "NOVA Gold Engine: A+ bearish reaction detected.")


// Zone-touch alerts

alertcondition(
     newDemandTouch,
     title = "NOVA Demand Zone Touch",
     message =
         "Gold has entered the active NOVA demand zone.")

alertcondition(
     newSupplyTouch,
     title = "NOVA Supply Zone Touch",
     message =
         "Gold has entered the active NOVA supply zone.")


// Liquidity alerts

alertcondition(
     bullLiquiditySweep,
     title = "NOVA Bullish Liquidity Sweep",
     message =
         "Gold swept sell-side liquidity.")

alertcondition(
     bearLiquiditySweep,
     title = "NOVA Bearish Liquidity Sweep",
     message =
         "Gold swept buy-side liquidity.")


//=====================================================================
// END
