//@version=6
indicator("RM Multi-Leg Options Strategy + VWAP + Supertrend", overlay=false, scale=scale.left, max_labels_count=500)

//======================================================
// STRATEGY SETTINGS
//======================================================
var string G_MAIN = "Strategy Settings"

strategy_mode = input.string(
     "2-Leg",
     "Strategy Mode",
     options=["2-Leg", "4-Leg"],
     group=G_MAIN)

strategy_preset = input.string(
     "Custom",
     "Strategy Preset",
     options=["Custom", "Straddle", "Strangle", "Iron Fly", "Iron Condor"],
     group=G_MAIN)

show_strategy = input.bool(
     true,
     "Show Strategy Price",
     group=G_MAIN)

chart_style = input.string(
     "Line",
     "Chart Type",
     options=["Line", "Candles"],
     group=G_MAIN)

//======================================================
// LEG 1
//======================================================
var string G_LEG1 = "Leg 1"

leg1_ticker = input.symbol(
     "NSE:NIFTY",
     "Leg 1 Ticker",
     group=G_LEG1)

leg1_direction = input.string(
     "Long",
     "Leg 1 Direction",
     options=["Long", "Short"],
     group=G_LEG1)


//======================================================
// LEG 2
//======================================================
var string G_LEG2 = "Leg 2"

leg2_ticker = input.symbol(
     "NSE:NIFTY",
     "Leg 2 Ticker",
     group=G_LEG2)

leg2_direction = input.string(
     "Long",
     "Leg 2 Direction",
     options=["Long", "Short"],
     group=G_LEG2)


//======================================================
// LEG 3
//======================================================
var string G_LEG3 = "Leg 3"

leg3_ticker = input.symbol(
     "NSE:NIFTY",
     "Leg 3 Ticker",
     group=G_LEG3)

leg3_direction = input.string(
     "Long",
     "Leg 3 Direction",
     options=["Long", "Short"],
     group=G_LEG3)


//======================================================
// LEG 4
//======================================================
var string G_LEG4 = "Leg 4"

leg4_ticker = input.symbol(
     "NSE:NIFTY",
     "Leg 4 Ticker",
     group=G_LEG4)

leg4_direction = input.string(
     "Long",
     "Leg 4 Direction",
     options=["Long", "Short"],
     group=G_LEG4)


//======================================================
// COLORS
//======================================================
var string G_COLOR = "Chart Colors"

strategy_color = input.color(
     color.orange,
     "Strategy Line Color",
     group=G_COLOR)

bull_color = input.color(
     color.green,
     "Bull Candle Color",
     group=G_COLOR)

bear_color = input.color(
     color.red,
     "Bear Candle Color",
     group=G_COLOR)


//======================================================
// VWAP SETTINGS
//======================================================
var string G_VWAP = "Strategy VWAP Settings"

show_vwap = input.bool(
     true,
     "Show Strategy VWAP",
     group=G_VWAP)

vwap_color = input.color(
     color.blue,
     "VWAP Color",
     group=G_VWAP)

vwap_width = input.int(
     2,
     "VWAP Width",
     minval=1,
     maxval=5,
     group=G_VWAP)


//======================================================
// SUPERTREND SETTINGS
//======================================================
var string G_ST = "Supertrend Settings"

show_supertrend = input.bool(
     true,
     "Show Supertrend",
     group=G_ST)

supertrend_source = input.string(
     "Strategy",
     "Supertrend Source",
     options=["Strategy", "Nifty Spot"],
     group=G_ST)

st_factor = input.float(
     3.0,
     "Supertrend Factor",
     minval=0.1,
     step=0.1,
     group=G_ST)

st_atr_period = input.int(
     10,
     "Supertrend ATR Period",
     minval=1,
     group=G_ST)

st_up_color = input.color(
     color.green,
     "Supertrend Up Color",
     group=G_ST)

st_down_color = input.color(
     color.red,
     "Supertrend Down Color",
     group=G_ST)

st_width = input.int(
     2,
     "Supertrend Width",
     minval=1,
     maxval=5,
     group=G_ST)


//======================================================
// LEG DIRECTIONS
//======================================================
float dir1 = leg1_direction == "Long" ? 1.0 : -1.0
float dir2 = leg2_direction == "Long" ? 1.0 : -1.0
float dir3 = leg3_direction == "Long" ? 1.0 : -1.0
float dir4 = leg4_direction == "Long" ? 1.0 : -1.0


//======================================================
// PRESET DIRECTIONS
//======================================================
float final_dir1 = dir1
float final_dir2 = dir2
float final_dir3 = dir3
float final_dir4 = dir4

if strategy_preset == "Straddle"
    final_dir1 := 1.0
    final_dir2 := 1.0
    final_dir3 := 0.0
    final_dir4 := 0.0

if strategy_preset == "Strangle"
    final_dir1 := 1.0
    final_dir2 := 1.0
    final_dir3 := 0.0
    final_dir4 := 0.0

if strategy_preset == "Iron Fly"
    final_dir1 := -1.0
    final_dir2 := -1.0
    final_dir3 := 1.0
    final_dir4 := 1.0

if strategy_preset == "Iron Condor"
    final_dir1 := -1.0
    final_dir2 := -1.0
    final_dir3 := 1.0
    final_dir4 := 1.0


//======================================================
// GET OHLC FUNCTION
//======================================================
f_get_ohlc(string ticker) =>
    float o = request.security(
         ticker,
         timeframe.period,
         open,
         ignore_invalid_symbol=true)

    float h = request.security(
         ticker,
         timeframe.period,
         high,
         ignore_invalid_symbol=true)

    float l = request.security(
         ticker,
         timeframe.period,
         low,
         ignore_invalid_symbol=true)

    float c = request.security(
         ticker,
         timeframe.period,
         close,
         ignore_invalid_symbol=true)

    [o, h, l, c]


//======================================================
// GET ALL LEGS
//======================================================
[l1_o, l1_h, l1_l, l1_c] = f_get_ohlc(leg1_ticker)
[l2_o, l2_h, l2_l, l2_c] = f_get_ohlc(leg2_ticker)
[l3_o, l3_h, l3_l, l3_c] = f_get_ohlc(leg3_ticker)
[l4_o, l4_h, l4_l, l4_c] = f_get_ohlc(leg4_ticker)


//======================================================
// VALID DATA
//======================================================
bool leg1_valid = not na(l1_c)
bool leg2_valid = not na(l2_c)
bool leg3_valid = not na(l3_c)
bool leg4_valid = not na(l4_c)

bool is_four_leg = strategy_mode == "4-Leg"

bool valid_strategy = false

if is_four_leg
    valid_strategy := leg1_valid and leg2_valid and leg3_valid and leg4_valid
else
    valid_strategy := leg1_valid and leg2_valid


//======================================================
// SYNTHETIC STRATEGY OHLC
//======================================================
float strategy_open = 0.0
float strategy_high = 0.0
float strategy_low = 0.0
float strategy_close = 0.0

strategy_open :=
     final_dir1 * nz(l1_o) +
     final_dir2 * nz(l2_o)

strategy_high :=
     final_dir1 * nz(l1_h) +
     final_dir2 * nz(l2_h)

strategy_low :=
     final_dir1 * nz(l1_l) +
     final_dir2 * nz(l2_l)

strategy_close :=
     final_dir1 * nz(l1_c) +
     final_dir2 * nz(l2_c)

if is_four_leg
    strategy_open :=
         final_dir1 * nz(l1_o) +
         final_dir2 * nz(l2_o) +
         final_dir3 * nz(l3_o) +
         final_dir4 * nz(l4_o)

    strategy_high :=
         final_dir1 * nz(l1_h) +
         final_dir2 * nz(l2_h) +
         final_dir3 * nz(l3_h) +
         final_dir4 * nz(l4_h)

    strategy_low :=
         final_dir1 * nz(l1_l) +
         final_dir2 * nz(l2_l) +
         final_dir3 * nz(l3_l) +
         final_dir4 * nz(l4_l)

    strategy_close :=
         final_dir1 * nz(l1_c) +
         final_dir2 * nz(l2_c) +
         final_dir3 * nz(l3_c) +
         final_dir4 * nz(l4_c)


//======================================================
// STRATEGY PRICE
//======================================================
float strategy_price = strategy_close


//======================================================
// VWAP
//======================================================
float strategy_vwap = ta.vwap(strategy_price)

plot(
     show_vwap and valid_strategy ? strategy_vwap : na,
     title="Strategy VWAP",
     color=vwap_color,
     linewidth=vwap_width)


//======================================================
// STRATEGY LINE
//======================================================
plot(
     show_strategy and chart_style == "Line" and valid_strategy
     ? strategy_price
     : na,
     title="Synthetic Strategy Price",
     color=strategy_color,
     linewidth=2)


//======================================================
// SYNTHETIC CANDLES
//======================================================
float candle_high = math.max(
     strategy_open,
     math.max(strategy_high, strategy_low),
     strategy_close)

float candle_low = math.min(
     strategy_open,
     math.min(strategy_high, strategy_low),
     strategy_close)

plotcandle(
     show_strategy and chart_style == "Candles" and valid_strategy
     ? strategy_open
     : na,
     show_strategy and chart_style == "Candles" and valid_strategy
     ? candle_high
     : na,
     show_strategy and chart_style == "Candles" and valid_strategy
     ? candle_low
     : na,
     show_strategy and chart_style == "Candles" and valid_strategy
     ? strategy_close
     : na,
     title="Synthetic Strategy Candles",
     color=strategy_close >= strategy_open ? bull_color : bear_color,
     wickcolor=strategy_close >= strategy_open ? bull_color : bear_color,
     bordercolor=strategy_close >= strategy_open ? bull_color : bear_color)


//======================================================
// CURRENT PRICE LABEL
//======================================================
var label strategy_price_label = na

if barstate.islast
    if not na(strategy_price_label)
        label.delete(strategy_price_label)

    if show_strategy and valid_strategy
        strategy_price_label := label.new(
             bar_index,
             strategy_price,
             "₹" + str.tostring(strategy_price, "#.00"),
             color=strategy_color,
             textcolor=color.white,
             style=label.style_label_left,
             size=size.normal)


//======================================================
// VWAP LABEL
//======================================================
var label vwap_price_label = na

if barstate.islast
    if not na(vwap_price_label)
        label.delete(vwap_price_label)

    if show_vwap and valid_strategy and not na(strategy_vwap)
        vwap_price_label := label.new(
             bar_index,
             strategy_vwap,
             "VWAP ₹" + str.tostring(strategy_vwap, "#.00"),
             color=vwap_color,
             textcolor=color.white,
             style=label.style_label_left,
             size=size.normal)


//======================================================
// NIFTY SPOT DATA
//======================================================
nifty_spot_close = request.security(
     "NSE:NIFTY",
     timeframe.period,
     close,
     ignore_invalid_symbol=true)


//======================================================
// SUPERTREND SOURCE
//======================================================
float supertrend_source_value = strategy_price

if supertrend_source == "Nifty Spot"
    supertrend_source_value := nifty_spot_close


//======================================================
// SUPERTREND
//======================================================
[supertrend_value, supertrend_direction] =
     ta.supertrend(
         st_factor,
         st_atr_period)


//======================================================
// SUPERTREND SOURCE ADJUSTMENT
//======================================================
//
// ta.supertrend() uses the chart's OHLC.
// For Strategy mode, calculate Supertrend
// directly from the synthetic strategy OHLC.
// For Nifty Spot mode, use Nifty Spot OHLC.
//======================================================

float st_high = strategy_high
float st_low = strategy_low
float st_close = strategy_close

if supertrend_source == "Nifty Spot"

    st_high := request.security(
         "NSE:NIFTY",
         timeframe.period,
         high,
         ignore_invalid_symbol=true)

    st_low := request.security(
         "NSE:NIFTY",
         timeframe.period,
         low,
         ignore_invalid_symbol=true)

    st_close := request.security(
         "NSE:NIFTY",
         timeframe.period,
         close,
         ignore_invalid_symbol=true)


//======================================================
// CUSTOM SUPERTREND CALCULATION
//======================================================
float st_atr = ta.atr(st_atr_period)

float st_mid = (st_high + st_low) / 2.0

float upper_basic = st_mid + st_factor * st_atr
float lower_basic = st_mid - st_factor * st_atr

var float upper_band = na
var float lower_band = na
var int st_trend = 1

upper_band := na(upper_band[1])
     ? upper_basic
     : (upper_basic < upper_band[1] or st_close[1] > upper_band[1]
         ? upper_basic
         : upper_band[1])

lower_band := na(lower_band[1])
     ? lower_basic
     : (lower_basic > lower_band[1] or st_close[1] < lower_band[1]
         ? lower_basic
         : lower_band[1])

if na(st_trend[1])
    st_trend := 1
else
    st_trend := st_trend[1]

if st_trend[1] == -1 and st_close > upper_band
    st_trend := 1

if st_trend[1] == 1 and st_close < lower_band
    st_trend := -1


float custom_supertrend = st_trend == 1
     ? lower_band
     : upper_band


//======================================================
// SUPERTREND PLOT
//======================================================
plot(
     show_supertrend and not na(custom_supertrend)
     ? custom_supertrend
     : na,
     title="Supertrend",
     color=st_trend == 1 ? st_up_color : st_down_color,
     linewidth=st_width)


//======================================================
// SUPERTREND SIGNAL MARKERS
//======================================================

supertrend_buy =
     show_supertrend and
     st_trend == 1 and
     st_trend[1] == -1

supertrend_sell =
     show_supertrend and
     st_trend == -1 and
     st_trend[1] == 1


// Buy marker
plot(
     supertrend_buy ? custom_supertrend : na,
     title="Supertrend Buy",
     color=st_up_color,
     linewidth=4,
     style=plot.style_circles)


// Sell marker
plot(
     supertrend_sell ? custom_supertrend : na,
     title="Supertrend Sell",
     color=st_down_color,
     linewidth=4,
     style=plot.style_circles)

    //======================================================
// SUPERTREND BUY / SELL LABELS
//======================================================

var label st_buy_label = na
var label st_sell_label = na

if supertrend_buy
    if not na(st_buy_label)
        label.delete(st_buy_label)

    st_buy_label := label.new(
         bar_index,
         custom_supertrend,
         "ST BUY",
         style=label.style_label_up,
         color=st_up_color,
         textcolor=color.white,
         size=size.small)

if supertrend_sell
    if not na(st_sell_label)
        label.delete(st_sell_label)

    st_sell_label := label.new(
         bar_index,
         custom_supertrend,
         "ST SELL",
         style=label.style_label_down,
         color=st_down_color,
         textcolor=color.white,
         size=size.small)