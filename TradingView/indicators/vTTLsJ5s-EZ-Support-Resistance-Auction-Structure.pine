londonOpenEnabled = showSessionOpens and allowLondonSessionLevels
newYorkOpenEnabled = showSessionOpens and allowNewYorkSessionLevels

// ───── Draw clean key levels as true horizontal line objects
// Each level starts on the candle where that exact level first becomes visible/valid
// (or where its value updates), then extends as one ruler-straight segment to the
// current bar. This intentionally replaces TradingView stepline plots so there are
// no stepped connectors or plot-style artifacts. Level calculations are unchanged.
levelLineColor = color.new(color.black, 0)

f_manage_straight_level(line existingLine, bool enabled, float levelPrice) =>
    line outputLine = existingLine
    bool validLine = enabled and not na(levelPrice)
    if validLine
        bool priceChanged = not na(outputLine) and math.abs(line.get_y1(outputLine) - levelPrice) > syminfo.mintick * 0.001
        if priceChanged
            line.delete(outputLine)
            outputLine := na
        if na(outputLine)
            outputLine := line.new(time, levelPrice, time, levelPrice,
                 xloc=xloc.bar_time, extend=extend.none, color=levelLineColor, width=1, style=line.style_solid)
        else
            line.set_xy2(outputLine, time, levelPrice)
            line.set_color(outputLine, levelLineColor)
            line.set_width(outputLine, 1)
            line.set_style(outputLine, line.style_solid)
    else if not na(outputLine)
        line.delete(outputLine)
        outputLine := na
    outputLine

