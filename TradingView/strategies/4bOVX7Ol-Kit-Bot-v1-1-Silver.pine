// Kit Bot v1.1 - Silver Only, 15% Stake
// Codified strategy: Multi-confirmation entries, ATR stops, session filters
// Platform: TradingView -> Signum -> Hyperliquid
// Asset: Silver/USD 30m ONLY

//@version=5
strategy("Kit Bot v1.1 - Silver", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=15, initial_capital=1000, commission_type=strategy.commission.percent, commission_value=0.05, slippage=1)

// ==========================================
// INPUTS
// ==========================================

// Confirmations required (minimum 3 of 6)
minConfirmations = input.int(3, "Min Confirmations Required", minval=2, maxval=6, group="Strategy")
maxTradesPerDay  = input.int(3, "Max Trades Per Day", minval=1, maxval=5, group="Strategy")
leverage         = input.float(2.0, "Leverage", minval=1.0, maxval=5.0, step=0.5, group="Strategy")
minRR            = input.float(2.0, "Min Risk:Reward", minval=1.0, maxval=5.0, step=0.5, group="Strategy")

// Indicator settings
rsiLen     = input.int(14, "RSI Length", group="Indicators")
bbLen      = input.int(20, "BB Length", group="Indicators")
bbMult     = input.float(2.0, "BB Multiplier", group="Indicators")
emaLen     = input.int(9, "EMA Length", group="Indicators")
atrLen     = input.int(14, "ATR Length", group="Indicators")
atrMult    = input.float(1.5, "ATR Stop Multiplier", minval=0.5, maxval=3.0, step=0.25, group="Indicators")

// Session filters (GMT)
useLondon  = input.bool(true, "Trade London Session (07:00-16:00 GMT)", group="Sessions")
useNYC     = input.bool(true, "Trade NYC Session (13:30-21:00 GMT)", group="Sessions")
useAsian   = input.bool(false, "Trade Asian Session (21:00-01:30 GMT) !! Caution", group="Sessions")

// ==========================================
// INDICATORS
// ==========================================

rsi = ta.rsi(close, rsiLen)
rsiPrev = ta.rsi(close[1], rsiLen)
[bbMid, bbUpper, bbLower] = ta.bb(close, bbLen, bbMult)
ema9 = ta.ema(close, emaLen)
atr = ta.atr(atrLen)

// RSI divergence detection
priceHigher = high > high[1]
rsiLower    = rsi < rsi[1]
priceLower  = low < low[1]
rsiHigher   = rsi > rsi[1]
bearishDiv  = priceHigher and rsiLower and rsi[1] > 65
bullishDiv  = priceLower and rsiHigher and rsi[1] < 35

// Candle patterns
bodySize    = math.abs(close - open)
upperWick   = high - math.max(close, open)
lowerWick   = math.min(close, open) - low
isGravestone = upperWick > bodySize * 2 and lowerWick < bodySize * 0.5 and bodySize > 0
isHammer     = lowerWick > bodySize * 2 and upperWick < bodySize * 0.5 and bodySize > 0
isDoji       = bodySize < (high - low) * 0.1 and (high - low) > 0

// ==========================================
// SESSION FILTER
// ==========================================

// All times in GMT
hourGMT = hour(time, "GMT")
minGMT  = minute(time, "GMT")
timeGMT = hourGMT * 100 + minGMT

inLondon = useLondon and (timeGMT >= 700 and timeGMT < 1600)
inNYC    = useNYC and (timeGMT >= 1330 and timeGMT < 2100)
inAsian  = useAsian and (timeGMT >= 2100 or timeGMT < 130)

inSession = inLondon or inNYC or inAsian

// ==========================================
// TRADE COUNTER (per day)
// ==========================================

var int tradesToday = 0
newDay = ta.change(time("D")) != 0
if newDay
    tradesToday := 0

canTrade = tradesToday < maxTradesPerDay and inSession

// ==========================================
// LONG CONFIRMATIONS (6 checks)
// ==========================================

longC1 = rsi < 55 and rsi > 20 and rsi > rsiPrev                           // RSI reset to 20-55 and turning up
longC2 = close > bbLower and close[1] <= bbLower                            // Price closing back inside lower BB
longC3 = close > ema9                                                        // Close above 9 EMA
longC4 = close > bbMid or (close > bbLower and close < bbMid and rsi < 40)  // Near BB midline or oversold bounce
longC5 = isHammer or (isDoji and close > open)                               // Bullish rejection candle
longC6 = bullishDiv                                                          // RSI bullish divergence

longScore = (longC1 ? 1 : 0) + (longC2 ? 1 : 0) + (longC3 ? 1 : 0) + (longC4 ? 1 : 0) + (longC5 ? 1 : 0) + (longC6 ? 1 : 0)
longSignal = longScore >= minConfirmations and canTrade and strategy.position_size == 0

// ==========================================
// SHORT CONFIRMATIONS (6 checks)
// ==========================================

shortC1 = rsi > 65 and rsi < rsiPrev                                        // RSI crossing back below 70 zone, turning down
shortC2 = close < bbUpper and close[1] >= bbUpper                            // Price closing back inside upper BB
shortC3 = close < ema9                                                       // Close below 9 EMA
shortC4 = isGravestone or (isDoji and close < open)                          // Bearish rejection candle
shortC5 = bearishDiv                                                         // RSI bearish divergence
shortC6 = rsi[1] > 70 and rsi < 70                                          // RSI just crossed below 70

shortScore = (shortC1 ? 1 : 0) + (shortC2 ? 1 : 0) + (shortC3 ? 1 : 0) + (shortC4 ? 1 : 0) + (shortC5 ? 1 : 0) + (shortC6 ? 1 : 0)
shortSignal = shortScore >= minConfirmations and canTrade and strategy.position_size == 0

// ==========================================
// STOP LOSS & TAKE PROFIT (ATR-based)
// ==========================================

longStop   = close - (atr * atrMult)
longTarget = close + (atr * atrMult * minRR)
shortStop   = close + (atr * atrMult)
shortTarget = close - (atr * atrMult * minRR)

// Risk:Reward validation
longRR  = (longTarget - close) / (close - longStop)
shortRR = (close - shortTarget) / (shortStop - close)

// ==========================================
// ENTRIES
// ==========================================

if longSignal and longRR >= minRR
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=longStop, limit=longTarget)
    tradesToday += 1

if shortSignal and shortRR >= minRR
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=shortStop, limit=shortTarget)
    tradesToday += 1

// ==========================================
// PLOTS
// ==========================================

plot(ema9, "EMA 9", color=color.orange, linewidth=2)
plot(bbUpper, "BB Upper", color=color.gray)
plot(bbMid, "BB Mid", color=color.gray, style=plot.style_cross)
plot(bbLower, "BB Lower", color=color.gray)

// Entry markers
plotshape(longSignal and longRR >= minRR, "Long Signal", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(shortSignal and shortRR >= minRR, "Short Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

// Stop and target lines (only when in position)
plot(strategy.position_size > 0 ? longStop : na, "Long Stop", color=color.red, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size > 0 ? longTarget : na, "Long Target", color=color.green, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size < 0 ? shortStop : na, "Short Stop", color=color.red, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size < 0 ? shortTarget : na, "Short Target", color=color.green, style=plot.style_linebr, linewidth=2)

// ==========================================
// INFO TABLE
// ==========================================

var table infoTable = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    // Header
    table.cell(infoTable, 0, 0, "KIT BOT v1.1", text_color=color.white, text_size=size.normal, bgcolor=color.new(color.blue, 60))
    table.cell(infoTable, 1, 0, "SILVER", text_color=color.silver, text_size=size.normal, bgcolor=color.new(color.blue, 60))

    // RSI
    rsiColor = rsi > 70 ? color.red : rsi < 30 ? color.green : color.white
    table.cell(infoTable, 0, 1, "RSI", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(rsi, "#.#"), text_color=rsiColor, text_size=size.small)

    // Long score
    longColor = longScore >= minConfirmations ? color.green : color.gray
    table.cell(infoTable, 0, 2, "LONG", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(longScore) + "/6", text_color=longColor, text_size=size.small)

    // Short score
    shortColor = shortScore >= minConfirmations ? color.red : color.gray
    table.cell(infoTable, 0, 3, "SHORT", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 3, str.tostring(shortScore) + "/6", text_color=shortColor, text_size=size.small)

    // Trades today
    tradeColor = tradesToday >= maxTradesPerDay ? color.red : color.white
    table.cell(infoTable, 0, 4, "TRADES", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 4, str.tostring(tradesToday) + "/" + str.tostring(maxTradesPerDay), text_color=tradeColor, text_size=size.small)

    // Session status
    sessionText = inLondon ? "LDN LONDON" : inNYC ? "US NYC" : inAsian ? "AS ASIAN" : "-- CLOSED"
    sessionColor = inSession ? color.green : color.gray
    table.cell(infoTable, 0, 5, "SESSION", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 5, sessionText, text_color=sessionColor, text_size=size.small)

    // ATR
    table.cell(infoTable, 0, 6, "ATR", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 6, str.tostring(atr, "#.###"), text_color=color.white, text_size=size.small)

    // Stop size
    table.cell(infoTable, 0, 7, "STOP", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 7, str.tostring(atr * atrMult, "#.###"), text_color=color.yellow, text_size=size.small)

    // Position
    posText = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    posColor = strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray
    table.cell(infoTable, 0, 8, "POS", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 8, posText, text_color=posColor, text_size=size.small)

    // Leverage & Stake
    table.cell(infoTable, 0, 9, "CONFIG", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 9, str.tostring(leverage, "#.#") + "x / 15%", text_color=color.white, text_size=size.small)

// ==========================================
// ALERTS (for Signum webhook)
// ==========================================

alertcondition(longSignal and longRR >= minRR, title="Kit Long Entry", message='{"action":"buy","symbol":"SILVER","leverage":{{input.leverage}},"qty_pct":15,"stop":{{plot("Long Stop")}},"tp":{{plot("Long Target")}}}')
alertcondition(shortSignal and shortRR >= minRR, title="Kit Short Entry", message='{"action":"sell","symbol":"SILVER","leverage":{{input.leverage}},"qty_pct":15,"stop":{{plot("Short Stop")}},"tp":{{plot("Short Target")}}}')