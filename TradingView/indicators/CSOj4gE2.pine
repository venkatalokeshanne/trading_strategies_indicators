//@version=6
indicator("AVAX / ETH Ratio - Early Signals", shorttitle="AVAX/ETH Early", overlay=false)

//====================================================
// AVAX / ETH SENTETİK ORAN
//====================================================

avaxOpen  = request.security("BINANCE:AVAXUSDT", timeframe.period, open)
avaxHigh  = request.security("BINANCE:AVAXUSDT", timeframe.period, high)
avaxLow   = request.security("BINANCE:AVAXUSDT", timeframe.period, low)
avaxClose = request.security("BINANCE:AVAXUSDT", timeframe.period, close)

ethOpen  = request.security("BINANCE:ETHUSDT", timeframe.period, open)
ethHigh  = request.security("BINANCE:ETHUSDT", timeframe.period, high)
ethLow   = request.security("BINANCE:ETHUSDT", timeframe.period, low)
ethClose = request.security("BINANCE:ETHUSDT", timeframe.period, close)

ratioOpen  = avaxOpen / ethOpen
ratioClose = avaxClose / ethClose

ratioHigh = math.max(
     avaxHigh / ethLow,
     avaxHigh / ethHigh,
     avaxLow / ethLow,
     avaxLow / ethHigh)

ratioLow = math.min(
     avaxHigh / ethLow,
     avaxHigh / ethHigh,
     avaxLow / ethLow,
     avaxLow / ethHigh)

//====================================================
// MUM
//====================================================

bullCandle = ratioClose >= ratioOpen

plotcandle(
     ratioOpen,
     ratioHigh,
     ratioLow,
     ratioClose,
     title="AVAX/ETH",
     color=bullCandle ? color.green : color.red,
     wickcolor=color.gray,
     bordercolor=bullCandle ? color.green : color.red)

//====================================================
// EMA
//====================================================

ema9   = ta.ema(ratioClose, 9)
ema20  = ta.ema(ratioClose, 20)
ema50  = ta.ema(ratioClose, 50)
ema200 = ta.ema(ratioClose, 200)

plot(ema9,   "EMA 9",   color=color.yellow, linewidth=1)
plot(ema20,  "EMA 20",  color=color.orange, linewidth=2)
plot(ema50,  "EMA 50",  color=color.blue, linewidth=2)
plot(ema200, "EMA 200", color=color.purple, linewidth=2)

//====================================================
// RSI
//====================================================

rsi = ta.rsi(ratioClose, 14)

//====================================================
// EMA EĞİMLERİ
//====================================================

ema9Up   = ema9 > ema9[1]
ema20Up  = ema20 > ema20[1]

ema9Down  = ema9 < ema9[1]
ema20Down = ema20 < ema20[1]

//====================================================
// MOMENTUM
//====================================================

priceAbove20 = ratioClose > ema20
priceBelow20 = ratioClose < ema20

rsiBull = rsi > 50
rsiBear = rsi < 50

//====================================================
// ERKEN AL
//====================================================

// Fiyat EMA20 üzerine çıkıyor
// RSI 50 üzerine çıkıyor
// EMA9 yukarı eğimli

earlyBuy =
     ta.crossover(ratioClose, ema20) and
     rsiBull and
     ema9Up

//====================================================
// GÜÇLÜ AL
//====================================================

// EMA9 > EMA20
// EMA20 yukarı eğimli
// RSI güçlü

strongBuy =
     ta.crossover(ema9, ema20) and
     ema20Up and
     rsi > 52

//====================================================
// ERKEN SAT
//====================================================

earlySell =
     ta.crossunder(ratioClose, ema20) and
     rsiBear and
     ema9Down

//====================================================
// GÜÇLÜ SAT
//====================================================

strongSell =
     ta.crossunder(ema9, ema20) and
     ema20Down and
     rsi < 48

//====================================================
// TEKRAR SİNYAL FİLTRESİ
//====================================================

var int trendState = 0

buySignal =
     (earlyBuy or strongBuy) and
     trendState <= 0

sellSignal =
     (earlySell or strongSell) and
     trendState >= 0

if buySignal
    trendState := 1

if sellSignal
    trendState := -1

//====================================================
// SİNYAL GÖSTERİMİ
//====================================================

plotshape(
     earlyBuy and trendState == 1,
     title="ERKEN AL",
     style=shape.labelup,
     location=location.bottom,
     color=color.green,
     text="ERKEN AL",
     textcolor=color.white,
     size=size.tiny)

plotshape(
     strongBuy and trendState == 1,
     title="GÜÇLÜ AL",
     style=shape.labelup,
     location=location.bottom,
     color=color.lime,
     text="GÜÇLÜ AL",
     textcolor=color.black,
     size=size.small)

plotshape(
     earlySell and trendState == -1,
     title="ERKEN SAT",
     style=shape.labeldown,
     location=location.top,
     color=color.orange,
     text="ERKEN SAT",
     textcolor=color.white,
     size=size.tiny)

plotshape(
     strongSell and trendState == -1,
     title="GÜÇLÜ SAT",
     style=shape.labeldown,
     location=location.top,
     color=color.red,
     text="GÜÇLÜ SAT",
     textcolor=color.white,
     size=size.small)

//====================================================
// TREND ARKA PLANI
//====================================================

bullTrend =
     ratioClose > ema20 and
     ema20 > ema50 and
     rsi > 50

bearTrend =
     ratioClose < ema20 and
     ema20 < ema50 and
     rsi < 50

bgcolor(
     bullTrend ? color.new(color.green, 92) :
     bearTrend ? color.new(color.red, 92) :
     na)

//====================================================
// ALARMLAR
//====================================================

alertcondition(
     earlyBuy,
     title="AVAX/ETH Erken AL",
     message="AVAX/ETH erken güçlenme sinyali")

alertcondition(
     strongBuy,
     title="AVAX/ETH Güçlü AL",
     message="AVAX/ETH güçlü yükseliş teyidi")

alertcondition(
     earlySell,
     title="AVAX/ETH Erken SAT",
     message="AVAX/ETH erken zayıflama sinyali")

alertcondition(
     strongSell,
     title="AVAX/ETH Güçlü SAT",
     message="AVAX/ETH güçlü düşüş teyidi")