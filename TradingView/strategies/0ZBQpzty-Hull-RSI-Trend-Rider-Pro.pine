//@version=6
strategy("Hull RSI - Trend Rider Pro", overlay=true, initial_capital=1000, default_qty_type=strategy.cash, default_qty_value=1000)

// --- Inputs ---
hullLength   = input.int(55, "Hull Base Length")
hullMult     = input.float(10.0, "Hull Multiplier")
rsiLen       = input.int(14, "RSI Length")
rsiUpper     = input.int(50, "RSI Upper (Short Trigger)")
rsiLower     = input.int(50, "RSI Lower (Long Trigger)")
lookback     = input.int(13, "SL Lookback", minval=1)

// --- TP Addition ---
rrRatio      = input.float(5.0, "Risk:Reward Ratio", minval=0.1, step=0.1) 

// --- Calculations ---
actualLength = int(hullLength * hullMult)
hma          = ta.hma(close, actualLength)
rsiVal       = ta.rsi(close, rsiLen)

// Trend Tracking
trendDir     = hma > hma[1] ? 1 : -1
hullChanged  = ta.change(trendDir) != 0
hmaColor     = trendDir == 1 ? color.green : color.red

// --- State Management ---
var float slPrice = na
var float tpPrice = na
var bool tradeTakenThisCycle = false

if hullChanged
    tradeTakenThisCycle := false

// --- Entry Conditions ---
longCondition  = (trendDir == 1) and ta.crossunder(rsiVal, rsiLower) and not tradeTakenThisCycle
shortCondition = (trendDir == -1) and ta.crossover(rsiVal, rsiUpper) and not tradeTakenThisCycle

// --- Execution & Price Calculation ---
if (longCondition and strategy.position_size == 0)
    slPrice := ta.lowest(low, lookback)
    float risk = close - slPrice
    tpPrice := close + (risk * rrRatio) // Calculate TP based on Risk
    strategy.entry("Long", strategy.long)
    tradeTakenThisCycle := true

if (shortCondition and strategy.position_size == 0)
    slPrice := ta.highest(high, lookback)
    float risk = slPrice - close
    tpPrice := close - (risk * rrRatio) // Calculate TP based on Risk
    strategy.entry("Short", strategy.short)
    tradeTakenThisCycle := true

// --- Exit Logic ---
// 1. Trend Flip Exit (Manual Close)
if (strategy.position_size > 0 and trendDir == -1)
    strategy.close("Long", comment="Trend Flip")

if (strategy.position_size < 0 and trendDir == 1)
    strategy.close("Short", comment="Trend Flip")

// 2. Fixed SL and TP (Engine Managed)
if (strategy.position_size != 0)
    strategy.exit("Exit", stop=slPrice, limit=tpPrice, comment_loss="Safety SL", comment_profit="Take Profit")

// --- Visuals ---
plot(hma, color=hmaColor, linewidth=3, title="Hull Suite")
plot(strategy.position_size != 0 ? slPrice : na, color=color.red, style=plot.style_linebr, title="Stop Loss")
plot(strategy.position_size != 0 ? tpPrice : na, color=color.lime, style=plot.style_linebr, title="Take Profit")
