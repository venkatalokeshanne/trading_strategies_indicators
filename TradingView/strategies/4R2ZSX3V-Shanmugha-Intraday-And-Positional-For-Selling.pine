//@version=5
strategy("Turtle Trading System 2", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, pyramiding=4)

// ========== INPUTS ==========
// Entry Parameters
entry_period = input.int(55, "Entry Breakout Period", minval=1)
exit_period = input.int(20, "Exit Breakout Period", minval=1)

// ATR Parameters
atr_period = input.int(20, "ATR Period", minval=1)

// Position Sizing
risk_per_trade = input.float(1.0, "Risk Per Trade (%)", minval=0.1, maxval=100) / 100
max_units = input.int(4, "Maximum Units", minval=1, maxval=10)
unit_expansion = input.float(0.5, "Unit Expansion (N)", minval=0.1, maxval=2.0)

// Stop Loss
use_stop = input.bool(true, "Use Stop Loss")
stop_loss_n = input.float(2.0, "Stop Loss (N multiplier)", minval=0.5, maxval=5.0)

// ========== CALCULATIONS ==========
// Calculate ATR (N)
n = ta.atr(atr_period)

// Entry Levels - 55 day high/low
entry_high = ta.highest(high, entry_period)
entry_low = ta.lowest(low, entry_period)

// Exit Levels - 20 day high/low
exit_low = ta.lowest(low, exit_period)
exit_high = ta.highest(high, exit_period)

// ========== POSITION SIZING ==========
// Dollar volatility
dollar_volatility = n * syminfo.pointvalue

// Unit size based on account equity and risk
unit_size = (strategy.equity * risk_per_trade) / dollar_volatility

// ========== ENTRY CONDITIONS ==========
// Long entry: price breaks above 55-day high
long_entry = ta.crossover(close, entry_high[1])

// Short entry: price breaks below 55-day low
short_entry = ta.crossunder(close, entry_low[1])

// ========== EXIT CONDITIONS ==========
// Long exit: price breaks below 20-day low
long_exit = ta.crossunder(close, exit_low[1])

// Short exit: price breaks above 20-day high
short_exit = ta.crossover(close, exit_high[1])

// ========== PYRAMIDING LOGIC ==========
// Calculate current number of units
var float entry_price = na
var int units_held = 0

// Track entry for pyramiding
if long_entry and strategy.position_size == 0
    entry_price := close
    units_held := 0

if short_entry and strategy.position_size == 0
    entry_price := close
    units_held := 0

// Reset on exit
if strategy.position_size == 0
    units_held := 0
    entry_price := na

// ========== STRATEGY EXECUTION ==========
// Initial Long Entry
if long_entry and strategy.position_size == 0
    strategy.entry("Long", strategy.long, qty=unit_size)
    entry_price := close
    units_held := 1
    if use_stop
        strategy.exit("Long SL", "Long", stop=close - (stop_loss_n * n))

// Add to Long Position (Pyramiding)
if strategy.position_size > 0 and units_held < max_units
    if not na(entry_price) and close >= entry_price + (units_held * unit_expansion * n)
        strategy.entry("Long Add " + str.tostring(units_held + 1), strategy.long, qty=unit_size)
        units_held := units_held + 1
        if use_stop
            strategy.exit("Long SL", stop=close - (stop_loss_n * n))

// Long Exit
if long_exit and strategy.position_size > 0
    strategy.close_all("Exit Long")
    units_held := 0
    entry_price := na

// Initial Short Entry
if short_entry and strategy.position_size == 0
    strategy.entry("Short", strategy.short, qty=unit_size)
    entry_price := close
    units_held := 1
    if use_stop
        strategy.exit("Short SL", "Short", stop=close + (stop_loss_n * n))

// Add to Short Position (Pyramiding)
if strategy.position_size < 0 and units_held < max_units
    if not na(entry_price) and close <= entry_price - (units_held * unit_expansion * n)
        strategy.entry("Short Add " + str.tostring(units_held + 1), strategy.short, qty=unit_size)
        units_held := units_held + 1
        if use_stop
            strategy.exit("Short SL", stop=close + (stop_loss_n * n))

// Short Exit
if short_exit and strategy.position_size < 0
    strategy.close_all("Exit Short")
    units_held := 0
    entry_price := na

// ========== PLOTTING ==========
// Plot entry levels (55-day breakout)
plot(entry_high[1], "55-Day High", color=color.new(color.green, 0), linewidth=2, style=plot.style_line)
plot(entry_low[1], "55-Day Low", color=color.new(color.red, 0), linewidth=2, style=plot.style_line)

// Plot exit levels (20-day breakout)
plot(exit_low[1], "20-Day Exit Low", color=color.new(color.orange, 0), linewidth=1, style=plot.style_circles)
plot(exit_high[1], "20-Day Exit High", color=color.new(color.blue, 0), linewidth=1, style=plot.style_circles)

// Plot average entry price
plot(strategy.position_size != 0 ? strategy.position_avg_price : na, "Avg Entry", color=color.yellow, linewidth=2, style=plot.style_cross)

// Plot stop loss levels
long_stop = strategy.position_size > 0 and use_stop ? strategy.position_avg_price - (stop_loss_n * n) : na
short_stop = strategy.position_size < 0 and use_stop ? strategy.position_avg_price + (stop_loss_n * n) : na
plot(long_stop, "Long Stop", color=color.red, linewidth=1, style=plot.style_stepline)
plot(short_stop, "Short Stop", color=color.red, linewidth=1, style=plot.style_stepline)

// Background color for positions
bgcolor(strategy.position_size > 0 ? color.new(color.green, 95) : strategy.position_size < 0 ? color.new(color.red, 95) : na)

// Fill between entry levels
fill_color = color.new(color.gray, 90)
h1 = plot(entry_high[1], display=display.none)
h2 = plot(entry_low[1], display=display.none)
fill(h1, h2, color=fill_color)

// ========== INFO TABLE ==========
if barstate.islast
    var table info = table.new(position.top_right, 2, 7, border_width=1)
    
    table.cell(info, 0, 0, "SYSTEM 2", bgcolor=color.blue, text_color=color.white, text_size=size.normal)
    table.cell(info, 1, 0, "TURTLE", bgcolor=color.blue, text_color=color.white, text_size=size.normal)
    
    table.cell(info, 0, 1, "ATR (N)", bgcolor=color.gray, text_color=color.white)
    table.cell(info, 1, 1, str.tostring(n, "#.####"), bgcolor=color.gray, text_color=color.white)
    
    table.cell(info, 0, 2, "Unit Size", bgcolor=color.gray, text_color=color.white)
    table.cell(info, 1, 2, str.tostring(unit_size, "#.##"), bgcolor=color.gray, text_color=color.white)
    
    table.cell(info, 0, 3, "Units Held", bgcolor=color.gray, text_color=color.white)
    table.cell(info, 1, 3, str.tostring(units_held), bgcolor=color.gray, text_color=color.white)
    
    table.cell(info, 0, 4, "Position", bgcolor=color.gray, text_color=color.white)
    posText = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    posBg = strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray
    table.cell(info, 1, 4, posText, bgcolor=posBg, text_color=color.white)
    
    table.cell(info, 0, 5, "Avg Price", bgcolor=color.gray, text_color=color.white)
    avgPrice = strategy.position_size != 0 ? str.tostring(strategy.position_avg_price, "#.####") : "---"
    table.cell(info, 1, 5, avgPrice, bgcolor=color.gray, text_color=color.white)
    
    table.cell(info, 0, 6, "P&L", bgcolor=color.gray, text_color=color.white)
    plBg = strategy.netprofit > 0 ? color.green : strategy.netprofit < 0 ? color.red : color.gray
    table.cell(info, 1, 6, str.tostring(strategy.netprofit, "#.##"), bgcolor=plBg, text_color=color.white)

// ========== ALERTS ==========
alertcondition(long_entry, "Long Entry", "System 2: Long Entry Signal at {{close}}")
alertcondition(short_entry, "Short Entry", "System 2: Short Entry Signal at {{close}}")
alertcondition(long_exit, "Long Exit", "System 2: Long Exit Signal at {{close}}")
alertcondition(short_exit, "Short Exit", "System 2: Short Exit Signal at {{close}}")