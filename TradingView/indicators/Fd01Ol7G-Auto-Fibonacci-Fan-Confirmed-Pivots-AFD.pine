        float pocket650Price = projectedPrice(currentOriginPrice, currentOriginTime, levelPrice(currentOriginPrice, currentEndPrice, GOLDEN_POCKET_RATIO_650), currentEndTime, time)
        float pocketLowPrice = math.min(pocket618Price, pocket650Price)
        float pocketHighPrice = math.max(pocket618Price, pocket650Price)
        goldenPocketRelationState := close < pocketLowPrice ? POCKET_STATE_BELOW : close > pocketHighPrice ? POCKET_STATE_ABOVE : POCKET_STATE_INSIDE

// Fan drawings and status board

var array<line> fanLines = array.new<line>(MAX_FANS * LEVEL_COUNT)
var array<line> fanOuterGlowLines = array.new<line>(MAX_FANS * LEVEL_COUNT)
var array<line> fanMiddleGlowLines = array.new<line>(MAX_FANS * LEVEL_COUNT)
var array<line> baselineLines = array.new<line>(MAX_FANS)
var array<linefill> fanFills = array.new<linefill>(MAX_FANS * MAX_FILL_BANDS)
var line goldenPocket618Line = na
var line goldenPocket650Line = na
var linefill goldenPocketFill = na
var table statusTable = table.new(position.top_right, 4, 7, frame_color = color.new(#64748B, 72), frame_width = 1, border_color = color.new(#64748B, 82), border_width = 0)

if barstate.islast
    array<int> sortedLevelIndices = array.sort_indices(levelRatios, order.ascending)
    int visibleFanCount = array.size(fanOriginPrices)
    int visibleLevelCount = 0
    for levelIndex = 0 to LEVEL_COUNT - 1
        if array.get(levelVisible, levelIndex)
            visibleLevelCount += 1

    int spotlightFirstLevel = na
    int spotlightSecondLevel = na
    if queueHasCurrent and visibleFanCount > 0 and fanFillInput != FILL_OFF
