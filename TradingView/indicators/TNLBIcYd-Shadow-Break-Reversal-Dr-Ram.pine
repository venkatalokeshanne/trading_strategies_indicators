//@version=6
indicator("Shadow Break Reversal - Dr-Ram", overlay=true)

// ---- شرط‌ها ----
bearishShadowBreak = high > high[1] and close < low[1]   // رد شدن به بالا با سایه، بسته شدن قرمز پایین‌تر
bullishShadowBreak = low  < low[1]  and close > high[1]  // رد شدن به پایین با سایه، بسته شدن آبی بالاتر

// ---- رنگ‌آمیزی کندل ----
barcolor(bearishShadowBreak ? color.new(#FF6D00, 0) : na)  // نارنجی پررنگ برای تمایز از قرمز معمولی
barcolor(bullishShadowBreak ? color.new(#00E5FF, 0) : na)  // فیروزه‌ای پررنگ برای تمایز از آبی معمولی

// ---- علامت‌گذاری اختیاری روی چارت (اگه بخوای فلش هم داشته باشی) ----
plotshape(bearishShadowBreak, style=shape.triangledown, location=location.abovebar, color=#FF6D00, size=size.tiny)
plotshape(bullishShadowBreak, style=shape.triangleup, location=location.belowbar, color=#00E5FF, size=size.tiny)