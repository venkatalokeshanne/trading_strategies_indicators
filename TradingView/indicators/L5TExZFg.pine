//=============================================================================
// MÉMOIRE DERNIER CROSS
//=============================================================================

var string lastCross1 = "—"
var string lastCross2 = "—"
var string lastCross3 = "—"
var string lastCross4 = "—"
var string lastCross5 = "—"
var string lastCross6 = "—"

if c1Bull
    lastCross1 := f_specialCrossName(true, c1fastType, c1fastLen, c1fastTf, c1slowType, c1slowLen, c1slowTf)
if c1Bear
    lastCross1 := f_specialCrossName(false, c1fastType, c1fastLen, c1fastTf, c1slowType, c1slowLen, c1slowTf)

if c2Bull
    lastCross2 := f_specialCrossName(true, c2fastType, c2fastLen, c2fastTf, c2slowType, c2slowLen, c2slowTf)
if c2Bear
    lastCross2 := f_specialCrossName(false, c2fastType, c2fastLen, c2fastTf, c2slowType, c2slowLen, c2slowTf)

if c3Bull
    lastCross3 := f_specialCrossName(true, c3fastType, c3fastLen, c3fastTf, c3slowType, c3slowLen, c3slowTf)
if c3Bear
    lastCross3 := f_specialCrossName(false, c3fastType, c3fastLen, c3fastTf, c3slowType, c3slowLen, c3slowTf)

