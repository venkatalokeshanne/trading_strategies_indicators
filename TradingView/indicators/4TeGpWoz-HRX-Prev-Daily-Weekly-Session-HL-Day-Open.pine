//@version=6
indicator("HRX Prev Daily/Weekly + Session HL + Day Open", overlay=true, max_lines_count=500)

// ---------------- Global Style ----------------
lineWidth    = input.int(2, "Line Thickness", minval=1, maxval=5)
lineStyleOpt = input.string("Solid", "Line Style", options=["Solid","Dashed","Dotted"])
lineStyle = line.style_solid
if lineStyleOpt == "Dashed"
    lineStyle := line.style_dashed
if lineStyleOpt == "Dotted"
    lineStyle := line.style_dotted

// ---------------- Hide/Show ----------------
showWeekly  = input.bool(true, "Show Previous Week HL")
showDaily   = input.bool(true, "Show Yesterday HL")
showAsia    = input.bool(true, "Show Asia Session")
showLondon  = input.bool(true, "Show London Session")
showNY      = input.bool(true, "Show NY Session")
showDayOpen = input.bool(true, "Show Day Open Line")

// ---------------- Weekly HL (Previous Week) ----------------
wHighColor = input.color(color.purple, "Weekly High Color")
wLowColor  = input.color(color.orange, "Weekly Low Color")
var line wHighLine = na
var line wLowLine = na

weekHigh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_on)
weekLow  = request.security(syminfo.tickerid, "W", low[1], lookahead=barmerge.lookahead_on)
isNewWeek = ta.change(time("W")) != 0

if showWeekly and isNewWeek
    line.delete(wHighLine)
    line.delete(wLowLine)
    wHighLine := line.new(bar_index, weekHigh, bar_index + 1, weekHigh, color=wHighColor, width=lineWidth, style=lineStyle, extend=extend.right)
    wLowLine  := line.new(bar_index, weekLow,  bar_index + 1, weekLow,  color=wLowColor,  width=lineWidth, style=lineStyle, extend=extend.right)

// ---------------- Daily HL (Yesterday) ----------------
dHighColor = input.color(color.green, "Daily High Color")
dLowColor  = input.color(color.red, "Daily Low Color")
var line dHighLine = na
var line dLowLine = na

dayHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
dayLow  = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
isNewDay = ta.change(time("D")) != 0

if showDaily and isNewDay
    line.delete(dHighLine)
    line.delete(dLowLine)
    dHighLine := line.new(bar_index, dayHigh, bar_index + 1, dayHigh, color=dHighColor, width=lineWidth, style=lineStyle, extend=extend.right)
    dLowLine  := line.new(bar_index, dayLow,  bar_index + 1, dayLow,  color=dLowColor,  width=lineWidth, style=lineStyle, extend=extend.right)

// --------------- Day Open Line (New Feature) ----------------
dayOpenColor = input.color(color.new(color.yellow, 0), "Day Open Color")
var line dayOpenLine = na

dOpen = request.security(syminfo.tickerid, "D", open, lookahead=barmerge.lookahead_on)

if showDayOpen and isNewDay
    line.delete(dayOpenLine)
    dayOpenLine := line.new(bar_index, dOpen, bar_index + 1, dOpen, color=dayOpenColor, width=lineWidth, style=lineStyle, extend=extend.right)

if showDayOpen and not na(dayOpenLine)
    line.set_x2(dayOpenLine, bar_index)

// ---------------- Session Inputs ----------------
asiaSession   = input.session("1900-0100", "Asia Session Time")     
asiaHighColor = input.color(color.teal,   "Asia High Color")
asiaLowColor  = input.color(color.orange, "Asia Low Color")

londonSession   = input.session("0300-0600", "London Session Time") 
londonHighColor = input.color(color.blue, "London High Color")
londonLowColor  = input.color(color.red,  "London Low Color")

nySession   = input.session("0800-1200", "NY Session Time")         
nyHighColor = input.color(color.green,  "NY High Color")
nyLowColor  = input.color(color.purple, "NY Low Color")

// ---------------- Session Function ----------------
f_session(_name, show, sess, hColor, lColor) =>
    var float sHigh = na
    var float sLow  = na
    var int   sHighBar = na
    var int   sLowBar  = na
    var line  highLine = na
    var line  lowLine  = na

    inSess   = not na(time(timeframe.period, sess))
    sStart   = inSess and not inSess[1]
    sEnd     = not inSess and inSess[1]

    if ta.change(time("D")) != 0
        if not na(highLine)
            line.delete(highLine)
            highLine := na
        if not na(lowLine)
            line.delete(lowLine)
            lowLine := na
        sHigh := na
        sLow  := na
        sHighBar := na
        sLowBar  := na

    if not show
        if not na(highLine)
            line.delete(highLine)
            highLine := na
        if not na(lowLine)
            line.delete(lowLine)
            lowLine := na
        sHigh := na
        sLow  := na
        sHighBar := na
        sLowBar  := na

    if show and inSess
        if na(sHigh) or high > sHigh
            sHigh := high
            sHighBar := bar_index
        if na(sLow) or low < sLow
            sLow := low
            sLowBar := bar_index

    if show and sEnd
        if not na(highLine)
            line.delete(highLine)
        if not na(lowLine)
            line.delete(lowLine)
        if not na(sHigh) and not na(sHighBar)
            highLine := line.new(sHighBar, sHigh, bar_index, sHigh, color=hColor, width=lineWidth, style=lineStyle)
        if not na(sLow) and not na(sLowBar)
            lowLine := line.new(sLowBar, sLow, bar_index, sLow, color=lColor, width=lineWidth, style=lineStyle)

    if show and not na(highLine)
        line.set_x2(highLine, bar_index)
    if show and not na(lowLine)
        line.set_x2(lowLine, bar_index)

    [sHigh, sLow]

// ---------------- Run Sessions ----------------
[asiaH, asiaL]     = f_session("Asia",   showAsia,   asiaSession,   asiaHighColor,   asiaLowColor)
[londonH, londonL] = f_session("London", showLondon, londonSession, londonHighColor, londonLowColor)
[nyH, nyL]         = f_session("NY",     showNY,     nySession,     nyHighColor,     nyLowColor)
