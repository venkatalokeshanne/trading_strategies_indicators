        table.cell(dashboard, 0, row, 'Daily P&L', text_color = c_gray, text_size = dash_text_size)
        table.cell(dashboard, 1, row, str.tostring(dailyPnL, '$#,###.00'), text_color = dailyPnL >= 0 ? c_green : c_red, text_size = dash_text_size)
        table.cell(dashboard, 2, row, 'Trades', text_color = c_gray, text_size = dash_text_size)
        table.cell(dashboard, 3, row, str.tostring(dailyTrades), text_color = c_gray, text_size = dash_text_size)
        row := row + 1

        table.cell(dashboard, 0, row, 'Weekly P&L', text_color = c_gray, text_size = dash_text_size)
        table.cell(dashboard, 1, row, str.tostring(weeklyPnL, '$#,###.00'), text_color = weeklyPnL >= 0 ? c_green : c_red, text_size = dash_text_size)
        table.cell(dashboard, 2, row, 'Target%', text_color = c_gray, text_size = dash_text_size)
        table.cell(dashboard, 3, row, WEEKLY_TARGET > 0 ? str.tostring(weeklyPnL / WEEKLY_TARGET * 100, '#.#') + '%' : 'N/A', text_color = weeklyPnL >= WEEKLY_TARGET ? c_green : c_gray, text_size = dash_text_size)
        row := row + 1

        // table.cell(dashboard, 0, row, 'Status', text_color = c_gray, text_size = dash_text_size)
