//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Label conversions
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_textHalign(string selection) =>
    switch selection
        "Left"  => text.align_left
        "Right" => text.align_right
        => text.align_center

f_textValign(string selection) =>
    switch selection
        "Top"    => text.align_top
        "Bottom" => text.align_bottom
        => text.align_center

f_textSize(string selection) =>
    switch selection
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Large"  => size.large
        "Huge"   => size.huge
        => size.normal

string selectedTextHalign = f_textHalign(labelHorizontal)
string selectedTextValign = f_textValign(labelVertical)
string selectedTextSize = f_textSize(labelSizeInput)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Object creation
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_createZone(
     int leftBar,
     int rightBar,
     float zoneTop,
     float zoneBottom,
     string zoneText,
     color fillColor,
     color borderColor,
     int borderWidth,
     bool showMidpoint,
     color midpointColor,
     int midpointWidth
 ) =>

    string displayedText = showLabels ? zoneText : ""

    box newBox = box.new(
         left = leftBar,
         top = zoneTop,
         right = rightBar,
         bottom = zoneBottom,
         xloc = xloc.bar_index,
         border_color = borderColor,
         border_width = borderWidth,
         border_style = line.style_solid,
         bgcolor = fillColor,
         text = displayedText,
         text_color = borderColor,
         text_size = selectedTextSize,
         text_halign = selectedTextHalign,
         text_valign = selectedTextValign
    )

    line newMidpoint = na

    if showMidpoint
        float midpointPrice = (zoneTop + zoneBottom) / 2.0

        newMidpoint := line.new(
             x1 = leftBar,
             y1 = midpointPrice,
             x2 = rightBar,
             y2 = midpointPrice,
             xloc = xloc.bar_index,
             extend = extend.none,
             color = midpointColor,
             style = line.style_dashed,
             width = midpointWidth
        )

    [newBox, newMidpoint]

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Array management
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_deleteOldestZone(
     array<box> zoneBoxes,
     array<line> zoneMidpoints,
     array<float> zoneTops,
     array<float> zoneBottoms,
     array<int> confirmationBars,
     array<bool> demandSideFlags,
     array<bool> touchedFlags
 ) =>

    box oldBox = array.shift(zoneBoxes)
    line oldMidpoint = array.shift(zoneMidpoints)

    box.delete(oldBox)

    if not na(oldMidpoint)
        line.delete(oldMidpoint)

    float removedTop = array.shift(zoneTops)
    float removedBottom = array.shift(zoneBottoms)
    int removedConfirmation = array.shift(confirmationBars)
    bool removedDirection = array.shift(demandSideFlags)
    bool removedTouched = array.shift(touchedFlags)

    true

f_removeZoneAt(
     array<box> zoneBoxes,
     array<line> zoneMidpoints,
     array<float> zoneTops,
     array<float> zoneBottoms,
     array<int> confirmationBars,
     array<bool> demandSideFlags,
     array<bool> touchedFlags,
     int index
 ) =>

    box currentBox = array.get(zoneBoxes, index)
    line currentMidpoint = array.get(zoneMidpoints, index)

    box.delete(currentBox)

    if not na(currentMidpoint)
        line.delete(currentMidpoint)

    box removedBox = array.remove(zoneBoxes, index)
    line removedMidpoint = array.remove(zoneMidpoints, index)
    float removedTop = array.remove(zoneTops, index)
    float removedBottom = array.remove(zoneBottoms, index)
    int removedConfirmation = array.remove(confirmationBars, index)
    bool removedDirection = array.remove(demandSideFlags, index)
    bool removedTouched = array.remove(touchedFlags, index)

    true

f_trimZones(
     array<box> zoneBoxes,
     array<line> zoneMidpoints,
     array<float> zoneTops,
     array<float> zoneBottoms,
     array<int> confirmationBars,
     array<bool> demandSideFlags,
     array<bool> touchedFlags,
     int maximumCount
 ) =>

    while array.size(zoneBoxes) > maximumCount
        f_deleteOldestZone(
             zoneBoxes,
             zoneMidpoints,
             zoneTops,
             zoneBottoms,
             confirmationBars,
             demandSideFlags,
             touchedFlags
        )

    true

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Update, penetration and optional removal
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_updateZones(
     array<box> zoneBoxes,
     array<line> zoneMidpoints,
     array<float> zoneTops,
     array<float> zoneBottoms,
     array<int> confirmationBars,
     array<bool> demandSideFlags,
     array<bool> touchedFlags,
     bool removeOnPenetration
 ) =>

    int zoneCount = array.size(zoneBoxes)

    if zoneCount > 0
        // The loop moves backward automatically because the starting
        // value is greater than the ending value.
        for i = zoneCount - 1 to 0
            bool alreadyTouched = array.get(touchedFlags, i)

            if not alreadyTouched
                box currentBox = array.get(zoneBoxes, i)
                line currentMidpoint = array.get(zoneMidpoints, i)

                float currentTop = array.get(zoneTops, i)
                float currentBottom = array.get(zoneBottoms, i)

                int confirmationBar = array.get(confirmationBars, i)
                bool isDemandSide = array.get(demandSideFlags, i)

                int untouchedRight =
                     useIndefiniteExtension
                     ? bar_index
                     : confirmationBar + fixedUntouchedBars

                box.set_right(currentBox, untouchedRight)

                if not na(currentMidpoint)
                    line.set_x2(currentMidpoint, untouchedRight)

                bool insideFiniteEligibilityWindow =
                     bar_index <= confirmationBar + fixedUntouchedBars

                bool eligibleForPenetration =
                     bar_index > confirmationBar and
                     (
                         useIndefiniteExtension or
                         insideFiniteEligibilityWindow
                     )

                if eligibleForPenetration
                    bool penetrated =
                         isDemandSide
                         ? low < currentTop
                         : high > currentBottom

                    if penetrated and removeOnPenetration
                        f_removeZoneAt(
                             zoneBoxes,
                             zoneMidpoints,
                             zoneTops,
                             zoneBottoms,
                             confirmationBars,
                             demandSideFlags,
                             touchedFlags,
                             i
                        )

                    if penetrated and not removeOnPenetration
                        int finalRight =
                             bar_index + postPenetrationBars

                        box.set_right(
                             currentBox,
                             finalRight
                        )

                        box.set_border_style(
                             currentBox,
                             line.style_dashed
                        )

                        if not na(currentMidpoint)
                            line.set_x2(
                                 currentMidpoint,
                                 finalRight
                            )

                        array.set(
                             touchedFlags,
                             i,
                             true
                        )

    true

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Supply/demand storage
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var array<box> sdBoxes = array.new<box>()
var array<line> sdMidpoints = array.new<line>()
var array<float> sdTops = array.new<float>()
var array<float> sdBottoms = array.new<float>()
var array<int> sdConfirmationBars = array.new<int>()
var array<bool> sdDemandSideFlags = array.new<bool>()
var array<bool> sdTouchedFlags = array.new<bool>()

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FVG storage
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var array<box> fvgBoxes = array.new<box>()
var array<line> fvgMidpoints = array.new<line>()
var array<float> fvgTops = array.new<float>()
var array<float> fvgBottoms = array.new<float>()
var array<int> fvgConfirmationBars = array.new<int>()
var array<bool> fvgDemandSideFlags = array.new<bool>()
var array<bool> fvgTouchedFlags = array.new<bool>()

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Update existing objects before detecting new formations
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_updateZones(
     sdBoxes,
     sdMidpoints,
     sdTops,
     sdBottoms,
     sdConfirmationBars,
     sdDemandSideFlags,
     sdTouchedFlags,
     removeTouchedSD
)

f_updateZones(
     fvgBoxes,
     fvgMidpoints,
     fvgTops,
     fvgBottoms,
     fvgConfirmationBars,
     fvgDemandSideFlags,
     fvgTouchedFlags,
     removeTouchedFVG
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Three-candle formation detection
//
// Candle 1 = two bars ago
// Candle 2 = one bar ago
// Candle 3 = current confirmation candle
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bool enoughBars = bar_index >= 3

bool bullishFormation =
     enoughBars and
     high[2] < low

bool bearishFormation =
     enoughBars and
     low[2] > high

if barstate.isconfirmed
    // Candle 1 is bar_index - 2.
    // The rectangle starts one bar before candle 1.
    int newLeftBar = bar_index - 3

    int initialRightBar =
         useIndefiniteExtension
         ? bar_index
         : bar_index + fixedUntouchedBars

    //━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // Bullish formation
    //━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    if bullishFormation
        // Demand zone uses the complete high-to-low range of candle 1.
        if showDemandZones and maxSDZones > 0
            float demandTop = high[2]
            float demandBottom = low[2]

            [newDemandBox, newDemandMidpoint] = f_createZone(
                 newLeftBar,
                 initialRightBar,
                 demandTop,
                 demandBottom,
                 "DZ",
                 color.new(
                     demandFillBase,
                     demandFillTransparency
                 ),
                 color.new(
                     demandBorderBase,
                     demandBorderTransparency
                 ),
                 demandBorderWidth,
                 showDemandMidpoint,
                 color.new(
                     demandMidBase,
                     demandMidTransparency
                 ),
                 demandMidWidth
            )

            array.push(sdBoxes, newDemandBox)
            array.push(sdMidpoints, newDemandMidpoint)
            array.push(sdTops, demandTop)
            array.push(sdBottoms, demandBottom)
            array.push(sdConfirmationBars, bar_index)
            array.push(sdDemandSideFlags, true)
            array.push(sdTouchedFlags, false)

            f_trimZones(
                 sdBoxes,
                 sdMidpoints,
                 sdTops,
                 sdBottoms,
                 sdConfirmationBars,
                 sdDemandSideFlags,
                 sdTouchedFlags,
                 maxSDZones
            )

        // Bullish FVG uses only the empty window between candles 1 and 3.
        if showBullishFVGs and maxFVGZones > 0
            float bullishFVGTop = low
            float bullishFVGBottom = high[2]

            [newBullFVGBox, newBullFVGMidpoint] = f_createZone(
                 newLeftBar,
                 initialRightBar,
                 bullishFVGTop,
                 bullishFVGBottom,
                 "FVG",
                 color.new(
                     bullFVGFillBase,
                     bullFVGFillTransparency
                 ),
                 color.new(
                     bullFVGBorderBase,
                     bullFVGBorderTransparency
                 ),
                 bullFVGBorderWidth,
                 showBullFVGMidpoint,
                 color.new(
                     bullFVGMidBase,
                     bullFVGMidTransparency
                 ),
                 bullFVGMidWidth
            )

            array.push(fvgBoxes, newBullFVGBox)
            array.push(fvgMidpoints, newBullFVGMidpoint)
            array.push(fvgTops, bullishFVGTop)
            array.push(fvgBottoms, bullishFVGBottom)
            array.push(fvgConfirmationBars, bar_index)
            array.push(fvgDemandSideFlags, true)
            array.push(fvgTouchedFlags, false)

            f_trimZones(
                 fvgBoxes,
                 fvgMidpoints,
                 fvgTops,
                 fvgBottoms,
                 fvgConfirmationBars,
                 fvgDemandSideFlags,
                 fvgTouchedFlags,
                 maxFVGZones
            )

    //━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // Bearish formation
    //━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    if bearishFormation
        // Supply zone uses the complete high-to-low range of candle 1.
        if showSupplyZones and maxSDZones > 0
            float supplyTop = high[2]
            float supplyBottom = low[2]

            [newSupplyBox, newSupplyMidpoint] = f_createZone(
                 newLeftBar,
                 initialRightBar,
                 supplyTop,
                 supplyBottom,
                 "SZ",
                 color.new(
                     supplyFillBase,
                     supplyFillTransparency
                 ),
                 color.new(
                     supplyBorderBase,
                     supplyBorderTransparency
                 ),
                 supplyBorderWidth,
                 showSupplyMidpoint,
                 color.new(
                     supplyMidBase,
                     supplyMidTransparency
                 ),
                 supplyMidWidth
            )

            array.push(sdBoxes, newSupplyBox)
            array.push(sdMidpoints, newSupplyMidpoint)
            array.push(sdTops, supplyTop)
            array.push(sdBottoms, supplyBottom)
            array.push(sdConfirmationBars, bar_index)
            array.push(sdDemandSideFlags, false)
            array.push(sdTouchedFlags, false)

            f_trimZones(
                 sdBoxes,
                 sdMidpoints,
                 sdTops,
                 sdBottoms,
                 sdConfirmationBars,
                 sdDemandSideFlags,
                 sdTouchedFlags,
                 maxSDZones
            )

        // Bearish FVG uses only the empty window between candles 1 and 3.
        if showBearishFVGs and maxFVGZones > 0
            float bearishFVGTop = low[2]
            float bearishFVGBottom = high

            [newBearFVGBox, newBearFVGMidpoint] = f_createZone(
                 newLeftBar,
                 initialRightBar,
                 bearishFVGTop,
                 bearishFVGBottom,
                 "FVG",
                 color.new(
                     bearFVGFillBase,
                     bearFVGFillTransparency
                 ),
                 color.new(
                     bearFVGBorderBase,
                     bearFVGBorderTransparency
                 ),
                 bearFVGBorderWidth,
                 showBearFVGMidpoint,
                 color.new(
                     bearFVGMidBase,
                     bearFVGMidTransparency
                 ),
                 bearFVGMidWidth
            )

            array.push(fvgBoxes, newBearFVGBox)
            array.push(fvgMidpoints, newBearFVGMidpoint)
            array.push(fvgTops, bearishFVGTop)
            array.push(fvgBottoms, bearishFVGBottom)
            array.push(fvgConfirmationBars, bar_index)
            array.push(fvgDemandSideFlags, false)
            array.push(fvgTouchedFlags, false)

            f_trimZones(
                 fvgBoxes,
                 fvgMidpoints,
                 fvgTops,
                 fvgBottoms,
                 fvgConfirmationBars,
                 fvgDemandSideFlags,
                 fvgTouchedFlags,
                 maxFVGZones
            )