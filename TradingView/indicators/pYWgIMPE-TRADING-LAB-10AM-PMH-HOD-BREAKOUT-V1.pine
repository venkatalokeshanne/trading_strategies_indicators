//@version=6
indicator("Auto S/R Levels [5 Strongest]", overlay=true, max_lines_count=10)

// ── Inputs ────────────────────────────────────────────────────────────────────
pivotLen   = input.int(10,   "Pivot Length (bars each side)", minval=2, maxval=20)
lookback   = input.int(500,  "Lookback (bars)",               minval=100, maxval=500)
clusterPct = input.float(0.5,"Cluster Tolerance (%)",         minval=0.1, maxval=2.0, step=0.1)
extBars    = input.int(30,   "Extend Forward (bars)",          minval=1, maxval=200)
nLevels    = input.int(5,    "Levels to Draw",                 minval=1, maxval=5)
supColor   = input.color(color.new(color.green, 0), "Support Color")
resColor   = input.color(color.new(color.red, 0),   "Resistance Color")

// ── Collect raw pivot prices ──────────────────────────────────────────────────
var float[] rawPivots = array.new_float()

ph = ta.pivothigh(pivotLen, pivotLen)
pl = ta.pivotlow(pivotLen, pivotLen)

if bar_index >= last_bar_index - lookback
    if not na(ph)
        array.push(rawPivots, ph)
    if not na(pl)
        array.push(rawPivots, pl)

// ── On last bar: cluster → rank → draw ───────────────────────────────────────
if barstate.islast
    // Delete all previously drawn lines via snapshot copy
    snap = array.copy(line.all)
    for ln in snap
        line.delete(ln)

    int n = array.size(rawPivots)
    if n > 0
        float[] cPrices = array.new_float()
        int[]   cHits   = array.new_int()

        // Cluster nearby pivots
        for i = 0 to n - 1
            float p   = array.get(rawPivots, i)
            float tol = p * clusterPct / 100.0
            bool  merged = false
            int   csz  = array.size(cPrices)
            if csz > 0
                for j = 0 to csz - 1
                    float cp   = array.get(cPrices, j)
                    int   hits = array.get(cHits,   j)
                    if math.abs(cp - p) <= tol
                        array.set(cPrices, j, (cp * hits + p) / (hits + 1))
                        array.set(cHits,   j, hits + 1)
                        merged := true
                        break
            if not merged
                array.push(cPrices, p)
                array.push(cHits,   1)

        // Draw top nLevels strongest
        int drawn = 0
        while drawn < nLevels and array.size(cPrices) > 0
            // Find index of max hit-count
            int sz   = array.size(cHits)
            int maxH = array.get(cHits, 0)
            int maxI = 0
            if sz > 1
                for j = 1 to sz - 1
                    int h = array.get(cHits, j)
                    if h > maxH
                        maxH := h
                        maxI := j

            float lvl = array.get(cPrices, maxI)
            color clr = lvl >= close ? resColor : supColor

            line.new(
                x1   = math.max(0, bar_index - lookback),
                y1   = lvl,
                x2   = bar_index + extBars,
                y2   = lvl,
                xloc = xloc.bar_index,
                color = clr,
                width = 2
            )
            array.remove(cPrices, maxI)
            array.remove(cHits,   maxI)
            drawn += 1