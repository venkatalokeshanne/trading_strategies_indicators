//@version=6
strategy("Weekly MACD + 50 EMA Exit - NiftyBEES Optimized", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, process_orders_on_close=true, pyramiding=0)

//================ INPUTS ================
niftySymbol      = input.symbol("NSE:NIFTY", "Nifty Symbol")
fastLen          = input.int(12, "MACD Fast Length", minval=1)
slowLen          = input.int(26, "MACD Slow Length", minval=1)
signalLen        = input.int(9, "MACD Signal Length", minval=1)

showTable        = input.bool(true, "Show Signal Table")
showEMA20        = input.bool(true, "Show EMA 20")
showEMA50        = input.bool(true, "Show EMA 50")
showEMA100       = input.bool(true, "Show EMA 100")
showEMA200       = input.bool(true, "Show EMA 200")

// Exit filters - OPTIMIZED FOR NIFTYBEES
useExitEMA       = input.bool(true, "Use EMA 50 Exit Filter (Recommended)")
useTwoBarConfirm = input.bool(true, "Require 2-Bar Weekly Bearish Confirmation")

//================ MACD FUNCTIONS ================
bullCrossFunc() =>
    [macdLine, signalLine, _] = ta.macd(close, fastLen, slowLen, signalLen)
    ta.crossover(macdLine, signalLine)

bearCrossFunc() =>
    [macdLine, signalLine, _] = ta.macd(close, fastLen, slowLen, signalLen)
    ta.crossunder(macdLine, signalLine)

trendBullFunc() =>
    [macdLine, signalLine, _] = ta.macd(close, fastLen, slowLen, signalLen)
    macdLine > signalLine

trendBearFunc() =>
    [macdLine, signalLine, _] = ta.macd(close, fastLen, slowLen, signalLen)
    macdLine < signalLine

//================ STOCK HTF VALUES ================
stockMonthlyBuy  = request.security(syminfo.tickerid, "M", bullCrossFunc(),  barmerge.gaps_off, barmerge.lookahead_off)
stockMonthlySell = request.security(syminfo.tickerid, "M", bearCrossFunc(),  barmerge.gaps_off, barmerge.lookahead_off)
stockWeeklyBuy   = request.security(syminfo.tickerid, "W", bullCrossFunc(),  barmerge.gaps_off, barmerge.lookahead_off)
stockWeeklySell  = request.security(syminfo.tickerid, "W", bearCrossFunc(),  barmerge.gaps_off, barmerge.lookahead_off)

stockMonthlyBull = request.security(syminfo.tickerid, "M", trendBullFunc(),  barmerge.gaps_off, barmerge.lookahead_off)
stockWeeklyBull  = request.security(syminfo.tickerid, "W", trendBullFunc(),  barmerge.gaps_off, barmerge.lookahead_off)
stockWeeklyBear  = request.security(syminfo.tickerid, "W", trendBearFunc(),  barmerge.gaps_off, barmerge.lookahead_off)

//================ NIFTY HTF VALUES (TABLE ONLY) ================
niftyMonthlyBuy  = request.security(niftySymbol, "M", bullCrossFunc(), barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)
niftyMonthlySell = request.security(niftySymbol, "M", bearCrossFunc(), barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)
niftyWeeklyBuy   = request.security(niftySymbol, "W", bullCrossFunc(), barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)
niftyWeeklySell  = request.security(niftySymbol, "W", bearCrossFunc(), barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)

niftyMonthlyBull = request.security(niftySymbol, "M", trendBullFunc(), barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)
niftyWeeklyBull  = request.security(niftySymbol, "W", trendBullFunc(), barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)

//================ TREND FILTERS ================
// Visual EMAs
ema20   = ta.ema(close, 20)
ema50   = ta.ema(close, 50)
ema100  = ta.ema(close, 100)
ema200  = ta.ema(close, 200)

// **OPTIMIZED EXIT EMA: 50 periods** - Perfect for weekly MACD
exitEMA = ta.ema(close, 50)

plot(showEMA20 ? ema20 : na, title="EMA 20", color=color.aqua, linewidth=2)
plot(showEMA50 ? ema50 : na, title="EMA 50", color=color.blue, linewidth=2)
plot(showEMA100 ? ema100 : na, title="EMA 100", color=color.orange, linewidth=2)
plot(showEMA200 ? ema200 : na, title="EMA 200", color=color.red, linewidth=2)
plot(useExitEMA ? exitEMA : na, title="Exit EMA 50", color=color.yellow, linewidth=3)

//================ ENTRY LOGIC ================
// ✅ Entry: Monthly bullish regime + Weekly bullish trigger
// Both timeframes must be bullish, with fresh weekly confirmation
entryTrigger = stockWeeklyBuy or stockMonthlyBuy
buySignal = 
     strategy.position_size == 0 and
     stockMonthlyBull and           // Monthly regime filter
     stockWeeklyBull and            // Weekly participation
     entryTrigger

//================ EXIT LOGIC ================
// ✅ Exit: Weekly MACD bearish (2-bar confirmation) + Price below EMA 50
weeklyBearConfirmed = stockWeeklyBear and stockWeeklyBear[1]  // 2 consecutive weekly bearish bars
emaExitFilter      = not useExitEMA or close < exitEMA        // Price below EMA 50

sellSignal = 
     strategy.position_size > 0 and
     (
         useTwoBarConfirm 
         ? (weeklyBearConfirmed and emaExitFilter)
         : (stockWeeklyBear and emaExitFilter)
     )

//================ ORDERS ================
if buySignal
    strategy.entry("Long", strategy.long)

if sellSignal
    strategy.close("Long")

//================ SIGNAL LABELS ================
plotshape(buySignal,  title="BUY",  style=shape.labelup,   location=location.belowbar, color=color.green, text="BUY",  textcolor=color.white, size=size.normal)
plotshape(sellSignal, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.red,   text="SELL", textcolor=color.white, size=size.normal)

//================ TABLE TEXT ================
stockMonthlyText = stockMonthlyBuy ? "BUY" : stockMonthlySell ? "SELL" : stockMonthlyBull ? "BULLISH" : "BEARISH"
stockWeeklyText  = stockWeeklyBuy  ? "BUY" : stockWeeklySell  ? "SELL" : stockWeeklyBull  ? "BULLISH" : "BEARISH"

niftyMonthlyText = niftyMonthlyBuy ? "BUY" : niftyMonthlySell ? "SELL" : niftyMonthlyBull ? "BULLISH" : "BEARISH"
niftyWeeklyText  = niftyWeeklyBuy  ? "BUY" : niftyWeeklySell  ? "SELL" : niftyWeeklyBull  ? "BULLISH" : "BEARISH"

stockMonthlyBg = stockMonthlyBuy ? color.green : stockMonthlySell ? color.red : stockMonthlyBull ? color.new(color.green, 35) : color.new(color.red, 35)
stockWeeklyBg  = stockWeeklyBuy  ? color.green : stockWeeklySell  ? color.red : stockWeeklyBull  ? color.new(color.green, 35) : color.new(color.red, 35)

niftyMonthlyBg = niftyMonthlyBuy ? color.green : niftyMonthlySell ? color.red : niftyMonthlyBull ? color.new(color.green, 35) : color.new(color.red, 35)
niftyWeeklyBg  = niftyWeeklyBuy  ? color.green : niftyWeeklySell  ? color.red : niftyWeeklyBull  ? color.new(color.green, 35) : color.new(color.red, 35)

//================ SIGNAL TABLE ================
var table signalTbl = table.new(position.top_center, 2, 5, border_width=2, frame_color=color.gray, border_color=color.gray, bgcolor=color.new(color.black, 80))

if barstate.islast and showTable
    // Headers
    table.cell(signalTbl, 0, 0, "Timeframe", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small)
    table.cell(signalTbl, 1, 0, "Status", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small)
    
    // Stock signals
    table.cell(signalTbl, 0, 1, "Stock Monthly", text_color=color.white, bgcolor=color.black, text_size=size.small)
    table.cell(signalTbl, 1, 1, stockMonthlyText, text_color=color.white, bgcolor=stockMonthlyBg, text_size=size.small)
    
    table.cell(signalTbl, 0, 2, "Stock Weekly", text_color=color.white, bgcolor=color.black, text_size=size.small)
    table.cell(signalTbl, 1, 2, stockWeeklyText, text_color=color.white, bgcolor=stockWeeklyBg, text_size=size.small)
    
    // Nifty signals
    table.cell(signalTbl, 0, 3, "Nifty Monthly", text_color=color.white, bgcolor=color.black, text_size=size.small)
    table.cell(signalTbl, 1, 3, niftyMonthlyText, text_color=color.white, bgcolor=niftyMonthlyBg, text_size=size.small)
    
    table.cell(signalTbl, 0, 4, "Nifty Weekly", text_color=color.white, bgcolor=color.black, text_size=size.small)
    table.cell(signalTbl, 1, 4, niftyWeeklyText, text_color=color.white, bgcolor=niftyWeeklyBg, text_size=size.small)
