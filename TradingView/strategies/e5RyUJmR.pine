//@version=5
strategy("2 Supertrend DCA Fixed Volume + Half Close", 
     overlay=true,
     pyramiding=20,
     initial_capital=1000)

// =========================
// INPUT
// =========================
mainQty = input.float(2.0, "Volume lệnh đầu (TV lot)", step=0.1)
addQty  = input.float(1.0, "Volume lệnh nhồi (TV lot)", step=0.1)
addStep = input.float(10.0, "Khoảng cách nhồi tối thiểu", minval=0)

// =========================
// SUPER TREND
// =========================
[fastST, fastDir] = ta.supertrend(3, 10)
[slowST, slowDir] = ta.supertrend(6, 10)

// fastDir < 0 = xanh, fastDir > 0 = đỏ
sameUp   = fastDir < 0 and slowDir < 0
sameDown = fastDir > 0 and slowDir > 0
fastFlip = fastDir != fastDir[1]

// Fast đổi màu ngược vị thế hiện tại
fastFlipAgainstLong  = strategy.position_size > 0 and fastDir > 0 and fastDir[1] < 0
fastFlipAgainstShort = strategy.position_size < 0 and fastDir < 0 and fastDir[1] > 0

// =========================
// BIẾN TRẠNG THÁI
// =========================
var float lastEntryPrice = na
var int addCount = 0
var bool halfClosedThisLeg = false

// Setup chờ entry đầu
var bool waitLongEntry = false
var bool waitShortEntry = false
var float longBaseST = na
var float shortBaseST = na
var float longBreakHigh = na
var float shortBreakLow = na
var float longEntryTrigger = na
var float shortEntryTrigger = na
var int longSetupBar = na
var int shortSetupBar = na

// =========================
// TẠO SETUP ENTRY ĐẦU
// =========================
newLongSetup  = strategy.position_size == 0 and sameUp and not sameUp[1]
newShortSetup = strategy.position_size == 0 and sameDown and not sameDown[1]

if newLongSetup
    waitLongEntry := true
    waitShortEntry := false

    longBaseST := fastST
    longBreakHigh := high
    longEntryTrigger := na
    longSetupBar := bar_index

    shortBaseST := na
    shortBreakLow := na
    shortEntryTrigger := na
    shortSetupBar := na

if newShortSetup
    waitShortEntry := true
    waitLongEntry := false

    shortBaseST := fastST
    shortBreakLow := low
    shortEntryTrigger := na
    shortSetupBar := bar_index

    longBaseST := na
    longBreakHigh := na
    longEntryTrigger := na
    longSetupBar := na

// =========================
// HỦY SETUP NẾU FAST FLIP NGƯỢC TRƯỚC KHI KHỚP
// =========================
if strategy.position_size == 0
    if waitLongEntry and fastDir > 0
        waitLongEntry := false
        longBaseST := na
        longBreakHigh := na
        longEntryTrigger := na
        longSetupBar := na

    if waitShortEntry and fastDir < 0
        waitShortEntry := false
        shortBaseST := na
        shortBreakLow := na
        shortEntryTrigger := na
        shortSetupBar := na

// =========================
// ENTRY ĐẦU - CHỜ HỒI 30%
// Long: từ đáy ST mới tạo đến đỉnh mới phá
// Short: từ đỉnh ST mới tạo đến đáy mới phá
// Chỉ cho khớp từ cây SAU cây tạo setup
// =========================
if strategy.position_size == 0
    // Setup long
    if waitLongEntry and sameUp
        longBreakHigh := math.max(nz(longBreakHigh, high), high)
        longEntryTrigger := longBaseST + (longBreakHigh - longBaseST) * 0.3

        if bar_index > nz(longSetupBar) and low <= longEntryTrigger
            strategy.entry("Buy", strategy.long, qty=mainQty)
            lastEntryPrice := longEntryTrigger
            addCount := 0
            halfClosedThisLeg := false

            waitLongEntry := false
            longBaseST := na
            longBreakHigh := na
            longEntryTrigger := na
            longSetupBar := na

    // Setup short
    if waitShortEntry and sameDown
        shortBreakLow := math.min(nz(shortBreakLow, low), low)
        shortEntryTrigger := shortBaseST - (shortBaseST - shortBreakLow) * 0.3

        if bar_index > nz(shortSetupBar) and high >= shortEntryTrigger
            strategy.entry("Sell", strategy.short, qty=mainQty)
            lastEntryPrice := shortEntryTrigger
            addCount := 0
            halfClosedThisLeg := false

            waitShortEntry := false
            shortBaseST := na
            shortBreakLow := na
            shortEntryTrigger := na
            shortSetupBar := na

// =========================
// CHỐT 50% KHI FAST ĐỔI MÀU NGƯỢC
// mỗi nhịp chỉ chốt 1 lần
// =========================
if fastFlipAgainstLong and not halfClosedThisLeg
    strategy.order("Half Close Long", strategy.short, qty=math.abs(strategy.position_size) * 0.5)
    halfClosedThisLeg := true

if fastFlipAgainstShort and not halfClosedThisLeg
    strategy.order("Half Close Short", strategy.long, qty=math.abs(strategy.position_size) * 0.5)
    halfClosedThisLeg := true

// Khi fast quay lại đồng hướng với slow thì reset quyền chốt 50%
if strategy.position_size > 0 and sameUp and fastDir < 0
    halfClosedThisLeg := false

if strategy.position_size < 0 and sameDown and fastDir > 0
    halfClosedThisLeg := false

// =========================
// NHỒI LONG
// so với lệnh gần nhất
// =========================
if strategy.position_size > 0 and fastFlip and sameUp and not na(lastEntryPrice)
    if close >= lastEntryPrice + addStep
        addCount += 1
        strategy.entry("Buy add " + str.tostring(addCount), strategy.long, qty=addQty)
        lastEntryPrice := close

// =========================
// NHỒI SHORT
// so với lệnh gần nhất
// =========================
if strategy.position_size < 0 and fastFlip and sameDown and not na(lastEntryPrice)
    if close <= lastEntryPrice - addStep
        addCount += 1
        strategy.entry("Sell add " + str.tostring(addCount), strategy.short, qty=addQty)
        lastEntryPrice := close

// =========================
// ĐÓNG TOÀN BỘ KHI 2 ST ĐẢO HƯỚNG HẲN
// =========================
if strategy.position_size > 0 and sameDown
    strategy.close_all("Close Long")
    lastEntryPrice := na
    addCount := 0
    halfClosedThisLeg := false
    waitLongEntry := false
    waitShortEntry := false

if strategy.position_size < 0 and sameUp
    strategy.close_all("Close Short")
    lastEntryPrice := na
    addCount := 0
    halfClosedThisLeg := false
    waitLongEntry := false
    waitShortEntry := false

// =========================
// RESET PHÒNG HỜ
// =========================
if strategy.position_size == 0 and strategy.position_size[1] != 0
    lastEntryPrice := na
    addCount := 0
    halfClosedThisLeg := false

// =========================
// PLOT
// =========================
plot(fastST, color = fastDir < 0 ? color.green : color.red, title="Fast ST", linewidth=2)
plot(slowST, color = slowDir < 0 ? color.green : color.red, title="Slow ST", linewidth=2)