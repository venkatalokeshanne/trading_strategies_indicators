//@version=6
indicator("VWAP-Multi Smoothed ATR V2", overlay=true)

// =====================================================
// INPUTS
// =====================================================

src = input.source(hlc3, "Source")

atrTimeframe = input.timeframe("5", "ATR Timeframe")

// Default strategy settings
atrLength = input.int(
     2750,
     "ATR Length",
     minval=1
)

atrSmoothLength = input.int(
     2750,
     "ATR Smooth Length",
     minval=1
)

m1 = input.float(
     1.0,
     "ATR Multiplier 1",
     step=0.1
)

m2 = input.float(
     1.85,
     "ATR Multiplier 2",
     step=0.1
)

m3 = input.float(
     3.125,
     "ATR Multiplier 3",
     step=0.1
)


// =====================================================
// VWAP
// =====================================================

// TradingView built-in session VWAP
vwapValue = ta.vwap(src)


// =====================================================
// HIGHER TIMEFRAME ATR
// =====================================================
//
// ATR and EMA smoothing are BOTH calculated
// inside the selected ATR timeframe.
//
// calc_bars_count forces TradingView to request
// a much larger amount of 5-minute history.
//
// 10,000 bars is comfortably above the history
// required for ATR(2750) + EMA smoothing.
//

smoothAtr = request.security(
     syminfo.tickerid,
     atrTimeframe,
     ta.ema(
         ta.atr(atrLength),
         atrSmoothLength
     ),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off,
     calc_bars_count=10000
)


// =====================================================
// ATR BANDS
// =====================================================

upper1 = vwapValue + smoothAtr * m1
lower1 = vwapValue - smoothAtr * m1

upper2 = vwapValue + smoothAtr * m2
lower2 = vwapValue - smoothAtr * m2

upper3 = vwapValue + smoothAtr * m3
lower3 = vwapValue - smoothAtr * m3


// =====================================================
// PLOTS
// =====================================================

// VWAP
plot(
     vwapValue,
     title="VWAP",
     linewidth=2,
     color=color.blue
)


// 1 ATR bands
plot(
     upper1,
     title="Upper 1 ATR",
     color=color.green
)

plot(
     lower1,
     title="Lower 1 ATR",
     color=color.green
)


// 2 ATR bands
plot(
     upper2,
     title="Upper 2 ATR",
     color=color.orange
)

plot(
     lower2,
     title="Lower 2 ATR",
     color=color.orange
)


// 3 ATR bands
plot(
     upper3,
     title="Upper 3 ATR",
     color=color.purple
)

plot(
     lower3,
     title="Lower 3 ATR",
     color=color.purple
)