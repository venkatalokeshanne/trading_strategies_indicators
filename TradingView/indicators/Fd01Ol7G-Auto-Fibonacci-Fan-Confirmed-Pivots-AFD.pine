        for levelIndex = 0 to LEVEL_COUNT - 1
            if array.get(levelVisible, levelIndex)
                float ratio = array.get(levelRatios, levelIndex)
                float constructionPrice = levelPrice(currentOriginPrice, currentEndPrice, ratio)
                float currentLevelPrice = projectedPrice(currentOriginPrice, currentOriginTime, constructionPrice, currentEndTime, time)
                int priorStableSide = array.get(levelStableSides, levelIndex)
                int currentSide = interactionSide(close, currentLevelPrice, interactionTolerance)
                bool touchedZone = high >= currentLevelPrice - interactionTolerance and low <= currentLevelPrice + interactionTolerance
                int eventType = EVENT_NONE
                if currentSide == SIDE_TESTING
