//@version=5
strategy("BTC Trend Strategy V2 (Fixed + ADX Working)",
     overlay=true,
     initial_capital=10000,
     pyramiding=0,
     commission_type=strategy.commission.percent,
     commission_value=0.05)

// ───────────── INPUTS ─────────────
htfTf        = input.timeframe("240", "Higher Timeframe")
htfEmaLen    = input.int(200, "HTF EMA Length")

fastLen      = input.int(21, "Fast EMA")
slowLen      = input.int(55, "Slow EMA")

rsiLen       = input.int(14, "RSI Length")
rsiLongMin   = input.int(55, "RSI Long Min")
rsiShortMax  = input.int(45, "RSI Short Max")

atrLen       = input.int(14, "ATR Length")
stopATR      = input.float(1.8, "Stop ATR")
trailATR     = input.float(1.5, "Trailing ATR")

adxLen       = input.int(14, "ADX Length")
adxMin       = input.int(20, "Min Trend Strength")

riskPct      = input.float(0.75, "Risk % per trade")
leverageMult = input.float(3.0, "Leverage Multiplier")
maxQty       = input.float(1.0, "Max Position Size")

showMAs      = input.bool(true, "Show Moving Averages")

// ───────────── CALCULATIONS ─────────────
fastEma = ta.ema(close, fastLen)
slowEma = ta.ema(close, slowLen)
rsiVal  = ta.rsi(close, rsiLen)
atrVal  = ta.atr(atrLen)

// ✅ FIXED ADX (via DMI)
[plusDI, minusDI, adxVal] = ta.dmi(adxLen, adxLen)

// HTF EMA
htfEma = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfEmaLen))

// Trend
bullTrend = close > htfEma and fastEma > slowEma
bearTrend = close < htfEma and fastEma < slowEma

// Filters
strongTrend = adxVal > adxMin
highVol     = atrVal > ta.sma(atrVal, 20)

// Smart entries (pullback based)
longCondition =
     bullTrend and
     strongTrend and
     highVol and
     plusDI > minusDI and
     low <= fastEma and close > fastEma and
     rsiVal > rsiLongMin

shortCondition =
     bearTrend and
     strongTrend and
     highVol and
     minusDI > plusDI and
     high >= fastEma and close < fastEma and
     rsiVal < rsiShortMax

// ───────────── RISK MANAGEMENT ─────────────
riskAmount = strategy.equity * (riskPct / 100)
stopDist   = atrVal * stopATR

rawQty = stopDist > 0 ? (riskAmount / stopDist) * leverageMult : 0
qty    = math.min(rawQty, maxQty)

// ───────────── ENTRIES ─────────────
if longCondition and strategy.position_size <= 0
    strategy.entry("Long", strategy.long, qty=qty)

if shortCondition and strategy.position_size >= 0
    strategy.entry("Short", strategy.short, qty=qty)

// ───────────── EXITS ─────────────
if strategy.position_size > 0
    strategy.exit("Long Exit", from_entry="Long",
         stop=strategy.position_avg_price - atrVal * stopATR,
         trail_points=atrVal * trailATR,
         trail_offset=atrVal)

if strategy.position_size < 0
    strategy.exit("Short Exit", from_entry="Short",
         stop=strategy.position_avg_price + atrVal * stopATR,
         trail_points=atrVal * trailATR,
         trail_offset=atrVal)

// Emergency close
if strategy.position_size > 0 and bearTrend
    strategy.close("Long")

if strategy.position_size < 0 and bullTrend
    strategy.close("Short")

// ───────────── VISUALS (NO ERRORS) ─────────────
plot(showMAs ? fastEma : na, title="Fast EMA", color=color.teal, linewidth=2)
plot(showMAs ? slowEma : na, title="Slow EMA", color=color.orange, linewidth=2)
plot(showMAs ? htfEma  : na, title="HTF EMA",  color=color.purple, linewidth=2)

plotshape(longCondition,  title="BUY",  location=location.belowbar, color=color.green, style=shape.triangleup)
plotshape(shortCondition, title="SELL", location=location.abovebar, color=color.red,   style=shape.triangledown)