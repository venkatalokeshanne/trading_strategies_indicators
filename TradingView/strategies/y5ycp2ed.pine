plot(ema24,  color=color.rgb(235, 181, 3),linestyle = plot.linestyle_dotted) 
plot(ema25,  color=color.rgb(236, 164, 8),linestyle = plot.linestyle_dotted)
plot(ema26,  color=color.rgb(236, 145, 8),linestyle = plot.linestyle_dotted)
plot(ema27,  color=color.rgb(241, 99, 4, 6),linestyle = plot.linestyle_dotted) 
plot(ema28,  color=color.rgb(241, 40, 4),linestyle = plot.linestyle_dotted) 
plot(ema29,  color=color.rgb(238, 17, 9),linestyle = plot.linestyle_dotted)  

plot(ema211,  color=color.rgb(148, 231, 14),linestyle = plot.linestyle_dotted)
