        // table.cell(dashboard, 1, row, status_text, text_color = status_color, text_size = dash_text_size)
        // row := row + 1

    if dashboardSize != 'Small'
        table.merge_cells(dashboard, 0, row, 4, row)
        table.cell(dashboard, 0, row, '═══  ADAPTIVE ENGINE SCORE: ' + str.tostring(weighted_score, '#.###') + '  ═══', text_color = c_purple, bgcolor = bg_gray, text_size = dash_text_size)
        row := row + 1

        table.cell(dashboard, 0, row, 'Min Score', text_color = c_gray, text_size = dash_text_size)
        table.cell(dashboard, 1, row, str.tostring(adaptive_min_score, '#.##'), text_color = c_purple, text_size = dash_text_size)
        table.cell(dashboard, 2, row, 'Risk Mult', text_color = c_gray, text_size = dash_text_size)
        table.cell(dashboard, 3, row, str.tostring(adaptive_risk_multiplier, '#.##'), text_color = c_red, text_size = dash_text_size)
        row := row + 1

