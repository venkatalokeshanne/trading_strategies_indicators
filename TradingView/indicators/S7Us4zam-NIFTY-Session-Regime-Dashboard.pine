        table.cell(dash, 5, 11, str.tostring(b60, "#.2") + "%", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

        table.cell(dash, 6, 11, bVWAPText, text_color=highlightTextColor, bgcolor=bPrice > bVWAP ? color.green : color.red, text_size=textSize)


        //============================================================
        // L&T
        //============================================================

        string lVWAPText = "BELOW"

        if lPrice > lVWAP
            lVWAPText := "ABOVE"


        table.cell(dash, 0, 12, "L&T", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

