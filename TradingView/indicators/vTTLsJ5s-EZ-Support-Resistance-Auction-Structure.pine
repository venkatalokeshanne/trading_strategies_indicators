f_manage_open_line(line existingLine, bool enabled, int startTime, float levelPrice) =>
    line outputLine = existingLine
    bool validLine = enabled and not na(startTime) and not na(levelPrice)
    if validLine
        if na(outputLine)
            outputLine := line.new(startTime, levelPrice, time, levelPrice,
                 xloc=xloc.bar_time, extend=extend.none, color=levelLineColor, width=1, style=line.style_solid)
        else
            line.set_xy1(outputLine, startTime, levelPrice)
            line.set_xy2(outputLine, time, levelPrice)
            line.set_color(outputLine, levelLineColor)
            line.set_extend(outputLine, extend.none)
            line.set_style(outputLine, line.style_solid)
    else if not na(outputLine)
        line.delete(outputLine)
        outputLine := na
    outputLine

var line open1800ETLine = na
var line midnightETLine = na
var line open1000ETLine = na
open1800ETLine := f_manage_open_line(open1800ETLine, show1800ETOpen, open1800ETTime, open1800ET)
midnightETLine := f_manage_open_line(midnightETLine, showMidnightETOpen, midnightOpenETTime, midnightOpenET)
open1000ETLine := f_manage_open_line(open1000ETLine, show1000ETOpen, open1000ETTime, open1000ET)

// Compact right-edge labels for every enabled objective/key level.
// Exact-price overlaps are intentionally preserved. When multiple enabled levels
// share the same price, their names are combined side-by-side in one tiny label
// (example: PDH • PWH • ASIA H) while every black level line remains at its true price.
var array<float> levelLabelPrices = array.new_float()
var array<string> levelLabelTexts = array.new_string()
var array<label> levelLabelObjects = array.new<label>()

f_delete_level_labels() =>
    int objectCount = array.size(levelLabelObjects)
    if objectCount > 0
        for i = 0 to objectCount - 1
            label.delete(array.get(levelLabelObjects, i))
    array.clear(levelLabelObjects)
    array.clear(levelLabelPrices)
    array.clear(levelLabelTexts)

f_add_level_label(bool enabled, float levelPrice, string levelText) =>
    if showLevelLabels and enabled and not na(levelPrice)
        int matchingIndex = -1
        int groupCount = array.size(levelLabelPrices)
        if groupCount > 0
            for i = 0 to groupCount - 1
                float existingPrice = array.get(levelLabelPrices, i)
                if math.abs(levelPrice - existingPrice) <= syminfo.mintick * 0.001
                    matchingIndex := i
                    break

        if matchingIndex == -1
            array.push(levelLabelPrices, levelPrice)
            array.push(levelLabelTexts, levelText)
        else
            string existingText = array.get(levelLabelTexts, matchingIndex)
            array.set(levelLabelTexts, matchingIndex, existingText + " • " + levelText)

if barstate.islast
    f_delete_level_labels()

    f_add_level_label(showCentralPivot, centralPivot, "CP")
    f_add_level_label(showCamarillaH3L3, camarillaH3, "H3")
    f_add_level_label(showCamarillaH3L3, camarillaL3, "L3")
    f_add_level_label(showCamarillaH4L4, camarillaH4, "H4")
    f_add_level_label(showCamarillaH4L4, camarillaL4, "L4")
    f_add_level_label(showPreviousDay, pdHigh, "PDH")
    f_add_level_label(showPreviousDay, pdLow, "PDL")
    f_add_level_label(showPreviousWeek, pwHigh, "PWH")
    f_add_level_label(showPreviousWeek, pwLow, "PWL")
    f_add_level_label(showPreviousMonth, pmHigh, "PMH")
    f_add_level_label(showPreviousMonth, pmLow, "PML")
    f_add_level_label(showDailyOpen, dailyOpen, "D OPEN")
    f_add_level_label(showPreviousDayMid, previousDayMid, "PD MID")
    f_add_level_label(showWeeklyOpen, weeklyOpen, "W OPEN")
    f_add_level_label(showPreviousWeekMid, previousWeekMid, "PW MID")
    f_add_level_label(showMonthlyOpen, monthlyOpen, "M OPEN")
    f_add_level_label(showPreviousMonthMid, previousMonthMid, "PM MID")
    f_add_level_label(showPrevious4HLevels, previous4HHigh, "P4H H")
    f_add_level_label(showPrevious4HLevels, previous4HLow, "P4H L")
    f_add_level_label(showCurrent4HOpen, current4HOpen, "4H OPEN")
    f_add_level_label(showPrevious4HMid, previous4HMid, "P4H MID")
    f_add_level_label(showMondayLevels, mondayHigh, "MON H")
    f_add_level_label(showMondayLevels, mondayLow, "MON L")
    f_add_level_label(showMondayLevels, mondayMid, "MON MID")
    f_add_level_label(showQuarterLevels, pqHigh, "PQH")
    f_add_level_label(showQuarterLevels, pqLow, "PQL")
    f_add_level_label(showQuarterOpenMid, quarterOpen, "Q OPEN")
    f_add_level_label(showQuarterOpenMid, previousQuarterMid, "PQ MID")
    f_add_level_label(showYearLevels, currentYearHigh, "Y HIGH")
    f_add_level_label(showYearLevels, currentYearLow, "Y LOW")
    f_add_level_label(showYearOpenMid, yearlyOpen, "Y OPEN")
    f_add_level_label(showYearOpenMid, currentYearMid, "Y MID")
    f_add_level_label(asiaHighEnabled, asiaHigh, "ASIA H")
    f_add_level_label(asiaLowEnabled, asiaLow, "ASIA L")
    f_add_level_label(londonHighEnabled, londonHigh, "LONDON H")
    f_add_level_label(londonLowEnabled, londonLow, "LONDON L")
    f_add_level_label(newYorkHighEnabled, newYorkHigh, "NY H")
    f_add_level_label(newYorkLowEnabled, newYorkLow, "NY L")
    f_add_level_label(overnightHighEnabled, overnightHigh, "ON H")
    f_add_level_label(overnightLowEnabled, overnightLow, "ON L")
    f_add_level_label(asiaOpenEnabled, asiaOpen, "ASIA OPEN")
    f_add_level_label(londonOpenEnabled, londonOpen, "LONDON OPEN")
    f_add_level_label(newYorkOpenEnabled, newYorkOpen, "NY OPEN")
    f_add_level_label(show1800ETOpen, open1800ET, "18:00 ET")
    f_add_level_label(showMidnightETOpen, midnightOpenET, "MIDNIGHT ET")
    f_add_level_label(show1000ETOpen, open1000ET, "10:00 ET")

    int levelGroupCount = array.size(levelLabelPrices)
    if showLevelLabels and levelGroupCount > 0
        for i = 0 to levelGroupCount - 1
            float groupedPrice = array.get(levelLabelPrices, i)
            string groupedText = array.get(levelLabelTexts, i)
            label groupedLabel = label.new(bar_index + 1, groupedPrice, groupedText,
                 xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none,
                 textcolor=color.black, size=size.tiny)
            array.push(levelLabelObjects, groupedLabel)

// ───── Structural support / resistance zone engine
f_zone_state(int pivotStrength, int localATRLength, float minimumPaddingATR) =>
    localATR = ta.atr(localATRLength)
    pivotLow = ta.pivotlow(low, pivotStrength, pivotStrength)
    pivotHigh = ta.pivothigh(high, pivotStrength, pivotStrength)

    var float supportTop = na
    var float supportBottom = na
    var float supportVolume = na
    var int supportTime = na

    var float resistanceTop = na
    var float resistanceBottom = na
    var float resistanceVolume = na
    var int resistanceTime = na

    if not na(pivotLow)
        pivotBodyLow = math.min(open[pivotStrength], close[pivotStrength])
        supportBottom := low[pivotStrength]
        supportTop := math.max(pivotBodyLow, supportBottom + localATR[pivotStrength] * minimumPaddingATR)
        supportVolume := showZoneVolume ? volume[pivotStrength] : na
        supportTime := time[pivotStrength]
    else if not na(supportTop)
        bool supportTouching = high >= supportBottom and low <= supportTop
        if close < supportBottom
            supportTop := na
            supportBottom := na
            supportVolume := na
            supportTime := na
        else if showZoneVolume and supportTouching
            supportVolume := nz(supportVolume) + volume

    if not na(pivotHigh)
        pivotBodyHigh = math.max(open[pivotStrength], close[pivotStrength])
        resistanceTop := high[pivotStrength]
        resistanceBottom := math.min(pivotBodyHigh, resistanceTop - localATR[pivotStrength] * minimumPaddingATR)
        resistanceVolume := showZoneVolume ? volume[pivotStrength] : na
        resistanceTime := time[pivotStrength]
    else if not na(resistanceTop)
        bool resistanceTouching = high >= resistanceBottom and low <= resistanceTop
        if close > resistanceTop
            resistanceTop := na
            resistanceBottom := na
            resistanceVolume := na
            resistanceTime := na
        else if showZoneVolume and resistanceTouching
            resistanceVolume := nz(resistanceVolume) + volume

    [supportTop, supportBottom, supportVolume, supportTime,
     resistanceTop, resistanceBottom, resistanceVolume, resistanceTime]

// Higher-timeframe version with one immediately previous still-valid zone per side.
// A previous zone is captured only when a newer confirmed pivot replaces an active zone.
// It is retired when its own source-timeframe close decisively invalidates its outer edge.
f_zone_state_with_memory(int pivotStrength, int localATRLength, float minimumPaddingATR) =>
    localATR = ta.atr(localATRLength)
    pivotLow = ta.pivotlow(low, pivotStrength, pivotStrength)
    pivotHigh = ta.pivothigh(high, pivotStrength, pivotStrength)

    var float supportTop = na
    var float supportBottom = na
    var float supportVolume = na
    var int supportTime = na
    var float previousSupportTop = na
    var float previousSupportBottom = na
    var int previousSupportTime = na

    var float resistanceTop = na
    var float resistanceBottom = na
    var float resistanceVolume = na
    var int resistanceTime = na
    var float previousResistanceTop = na
    var float previousResistanceBottom = na
    var int previousResistanceTime = na

    if not na(previousSupportBottom) and close < previousSupportBottom
        previousSupportTop := na
        previousSupportBottom := na
        previousSupportTime := na
    if not na(previousResistanceTop) and close > previousResistanceTop
        previousResistanceTop := na
        previousResistanceBottom := na
        previousResistanceTime := na

    if not na(pivotLow)
        int newSupportTime = time[pivotStrength]
        if not na(supportTop) and not na(supportTime) and supportTime != newSupportTime
            previousSupportTop := supportTop
            previousSupportBottom := supportBottom
            previousSupportTime := supportTime
        pivotBodyLow = math.min(open[pivotStrength], close[pivotStrength])
        supportBottom := low[pivotStrength]
        supportTop := math.max(pivotBodyLow, supportBottom + localATR[pivotStrength] * minimumPaddingATR)
        supportVolume := showZoneVolume ? volume[pivotStrength] : na
        supportTime := newSupportTime
    else if not na(supportTop)
        bool supportTouching = high >= supportBottom and low <= supportTop
        if close < supportBottom
            supportTop := na
            supportBottom := na
            supportVolume := na
            supportTime := na
        else if showZoneVolume and supportTouching
            supportVolume := nz(supportVolume) + volume

    if not na(pivotHigh)
        int newResistanceTime = time[pivotStrength]
        if not na(resistanceTop) and not na(resistanceTime) and resistanceTime != newResistanceTime
            previousResistanceTop := resistanceTop
            previousResistanceBottom := resistanceBottom
            previousResistanceTime := resistanceTime
        pivotBodyHigh = math.max(open[pivotStrength], close[pivotStrength])
        resistanceTop := high[pivotStrength]
        resistanceBottom := math.min(pivotBodyHigh, resistanceTop - localATR[pivotStrength] * minimumPaddingATR)
        resistanceVolume := showZoneVolume ? volume[pivotStrength] : na
        resistanceTime := newResistanceTime
    else if not na(resistanceTop)
        bool resistanceTouching = high >= resistanceBottom and low <= resistanceTop
        if close > resistanceTop
            resistanceTop := na
            resistanceBottom := na
            resistanceVolume := na
            resistanceTime := na
        else if showZoneVolume and resistanceTouching
            resistanceVolume := nz(resistanceVolume) + volume

    [supportTop, supportBottom, supportVolume, supportTime,
     resistanceTop, resistanceBottom, resistanceVolume, resistanceTime,
     previousSupportTop, previousSupportBottom, previousSupportTime,
     previousResistanceTop, previousResistanceBottom, previousResistanceTime]

// Chart timeframe
[chartSupTop, chartSupBottom, chartSupVolume, chartSupTime,
 chartResTop, chartResBottom, chartResVolume, chartResTime] =
     f_zone_state(srPivotStrength, srATRLength, srMinimumPaddingATR)

// Fixed timeframes
[s5Top, s5Bottom, s5Volume, s5Time, r5Top, r5Bottom, r5Volume, r5Time] =
     request.security(syminfo.tickerid, "5",
         f_zone_state(srPivotStrength, srATRLength, srMinimumPaddingATR),
         lookahead=barmerge.lookahead_off)

[s15Top, s15Bottom, s15Volume, s15Time, r15Top, r15Bottom, r15Volume, r15Time,
 ps15Top, ps15Bottom, ps15Time, pr15Top, pr15Bottom, pr15Time] =
     request.security(syminfo.tickerid, "15",
         f_zone_state_with_memory(srPivotStrength, srATRLength, srMinimumPaddingATR),
         lookahead=barmerge.lookahead_off)

[s1hTop, s1hBottom, s1hVolume, s1hTime, r1hTop, r1hBottom, r1hVolume, r1hTime,
 ps1hTop, ps1hBottom, ps1hTime, pr1hTop, pr1hBottom, pr1hTime] =
     request.security(syminfo.tickerid, "60",
         f_zone_state_with_memory(srPivotStrength, srATRLength, srMinimumPaddingATR),
         lookahead=barmerge.lookahead_off)

[s2hTop, s2hBottom, s2hVolume, s2hTime, r2hTop, r2hBottom, r2hVolume, r2hTime,
 ps2hTop, ps2hBottom, ps2hTime, pr2hTop, pr2hBottom, pr2hTime] =
     request.security(syminfo.tickerid, "120",
