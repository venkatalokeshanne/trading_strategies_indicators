//@version=5
strategy("EMA Cross + 1H Bias + VWAP SL/TP", overlay=true)

// === INPUTS ===
emaFastLen = input.int(10, "Fast EMA")
emaSlowLen = input.int(20, "Slow EMA")
emaHTFLen  = input.int(20, "HTF EMA (1H)")

// === CALCULATIONS ===
// EMAs
fastEMA = ta.ema(close, emaFastLen)
slowEMA = ta.ema(close, emaSlowLen)

// 1H EMA
htfClose = request.security(syminfo.tickerid, "60", close)
htfEMA   = request.security(syminfo.tickerid, "60", ta.ema(close, emaHTFLen))

// VWAP
vwap = ta.vwap(close)

// === CONDITIONS ===
bullHTF = htfClose > htfEMA
bearHTF = htfClose < htfEMA

longCondition  = ta.crossover(fastEMA, slowEMA)
shortCondition = ta.crossunder(fastEMA, slowEMA)

// FINAL CONDITIONS
longFinal  = longCondition and bullHTF and close > vwap
shortFinal = shortCondition and bearHTF and close < vwap

// === SL / TP ===
longSL = vwap
shortSL = vwap

longTP = close + (close - longSL)
shortTP = close - (shortSL - close)

// === EXECUTION ===
if (longFinal)
    strategy.entry("Long", strategy.long)
    strategy.exit("Long TP/SL", from_entry="Long", stop=longSL, limit=longTP)

if (shortFinal)
    strategy.entry("Short", strategy.short)
    strategy.exit("Short TP/SL", from_entry="Short", stop=shortSL, limit=shortTP)

// === PLOTS ===
plot(fastEMA, color=color.orange)
plot(slowEMA, color=color.blue)
plot(htfEMA, color=color.purple)
plot(vwap, color=color.fuchsia)