//@version=5
strategy("波段交易执行手册 v1 - BTC/ETH/SOL", 
     overlay=true, 
     default_qty_type=strategy.percent_of_equity, 
     default_qty_value=100, 
     initial_capital=100000, 
     commission_type=strategy.commission.percent, 
     commission_value=0.1,
     pyramiding=0)

// ==================== 输入参数 ====================
lenEMA20     = input.int(20, "20 EMA", minval=1)
lenEMA50     = input.int(50, "50 EMA", minval=1)
lenRSI       = input.int(14, "RSI 长度")
lenMACDfast  = input.int(12, "MACD 快线")
lenMACDsignal= input.int(26, "MACD 慢线")
lenBB        = input.int(20, "布林带长度")
multBB       = input.float(2.0, "布林带倍数")
atrLen       = input.int(14, "ATR 长度")
rrRatio      = input.float(2.0, "盈亏比", minval=1.5, step=0.1)
riskPercent  = input.float(1.0, "单笔风险 %", minval=0.5, maxval=2.0)

// ==================== 计算指标 ====================
ema20   = ta.ema(close, lenEMA20)
ema50   = ta.ema(close, lenEMA50)
rsi     = ta.rsi(close, lenRSI)
[macdLine, signalLine, hist] = ta.macd(close, lenMACDfast, lenMACDsignal, 9)
[bbMiddle, bbUpper, bbLower] = ta.bb(close, lenBB, multBB)
atr     = ta.atr(atrLen)

// ==================== 日线趋势过滤 ====================
dailyClose = request.security(syminfo.tickerid, "D", close)
dailyEMA20 = request.security(syminfo.tickerid, "D", ta.ema(close, lenEMA20))
dailyEMA50 = request.security(syminfo.tickerid, "D", ta.ema(close, lenEMA50))

[dailyMACDLine, dailySignalLine, dailyHist] = request.security(syminfo.tickerid, "D", ta.macd(close, lenMACDfast, lenMACDsignal, 9))

dailyBullish = dailyClose > dailyEMA20 and dailyClose > dailyEMA50 and dailyHist > 0

// ==================== 入场条件 ====================
pullbackToSupport = close <= ema20 or close <= bbMiddle
rsiCondition      = rsi > 45
macdBullish       = hist > 0 or (macdLine > signalLine)
volumeConfirm     = volume > ta.sma(volume, 20) * 0.8

longCondition = dailyBullish and pullbackToSupport and rsiCondition and macdBullish

// ==================== 止损与止盈 ====================
longStop  = close - atr * 1.5
longTP    = close + (close - longStop) * rrRatio

// ==================== 执行交易 ====================
if longCondition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", "Long", stop=longStop, limit=longTP)

// ==================== 绘图 ====================
plot(ema20, color=color.orange, linewidth=2, title="20 EMA")
plot(ema50, color=color.blue, linewidth=2, title="50 EMA")
plot(bbMiddle, color=color.gray, linewidth=1, title="布林中轨")

plotshape(longCondition, style=shape.triangleup, location=location.belowbar, 
     color=color.green, size=size.small, title="做多信号")

// ==================== 策略信息面板 ====================
var table infoTable = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 80))
if barstate.islast
    table.cell(infoTable, 0, 0, "策略名称", text_color=color.white)
    table.cell(infoTable, 1, 0, "波段交易手册 v1", text_color=color.lime)
    table.cell(infoTable, 0, 1, "当前趋势", text_color=color.white)
    table.cell(infoTable, 1, 1, dailyBullish ? "多头" : "空头/观望", text_color=dailyBullish ? color.lime : color.red)
    table.cell(infoTable, 0, 2, "RSI", text_color=color.white)
    table.cell(infoTable, 1, 2, str.tostring(rsi, "#.##"), text_color=rsi > 50 ? color.lime : color.red)
    table.cell(infoTable, 0, 3, "盈亏比", text_color=color.white)
    table.cell(infoTable, 1, 3, str.tostring(rrRatio, "#.#"), text_color=color.white)