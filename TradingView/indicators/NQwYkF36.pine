//@version=6
// ═══════════════════════════════════════════════════════════════════
//  Stochastic + RSI + MACD (3 in 1)   |   Version 1.1   |   2026-08-08
//  ใช้คู่กับสคริปต์ "EMA 5 เส้น + Dashboard"
//  ค่าตั้งต้นตามรูป TradeStation :  %K 9 / %D 3 , RSI 14 , MACD 12-26-9
// ═══════════════════════════════════════════════════════════════════
indicator("Stoch + RSI + MACD (3 in 1)", shorttitle="OSC 3in1", overlay=false)

// ─────────────────────────── ① โหมดแสดงผล ───────────────────────────
gM = "① โหมดแสดงผล"
mode = input.string("RSI + Stochastic", "เลือกสิ่งที่จะแสดง", options = ["RSI", "Stochastic", "MACD", "RSI + Stochastic", "ทั้งหมด (ปรับสเกล)"], group = gM)

showDB    = input.bool(true, "แสดง Dashboard ค่าตัวเลข", group = gM)
dbPosStr  = input.string("บนขวา", "ตำแหน่ง Dashboard", options = ["บนซ้าย", "บนขวา", "ล่างซ้าย", "ล่างขวา"], group = gM)
dbSizeStr = input.string("เล็ก", "ขนาดตัวอักษร", options = ["จิ๋ว", "เล็ก", "ปกติ"], group = gM)

// ──────────────────────────── ② STOCHASTIC ──────────────────────────
gS = "② Stochastic"
kLen    = input.int(9, "%K ความยาว", minval = 1, group = gS)
kSmooth = input.int(3, "%K ทำให้เรียบ (Slow)", minval = 1, group = gS)
dLen    = input.int(3, "%D ความยาว", minval = 1, group = gS)
kCol    = input.color(#00E676, "สี %K", group = gS, inline = "sc")
dCol    = input.color(#FFEB3B, "สี %D", group = gS, inline = "sc")
stOB    = input.int(80, "โซนซื้อมากไป", group = gS, inline = "sz")
stOS    = input.int(20, "โซนขายมากไป", group = gS, inline = "sz")

// ──────────────────────────────── ③ RSI ─────────────────────────────
gR = "③ RSI"
rsiLen = input.int(14, "RSI ความยาว", minval = 1, group = gR)
rsiSrc = input.source(close, "แหล่งราคา", group = gR)
rsiCol = input.color(#E040FB, "สีเส้น RSI", group = gR)
rsiHi  = input.int(70, "เส้นบน", group = gR, inline = "rz")
rsiMid = input.int(50, "เส้นกลาง", group = gR, inline = "rz")
rsiLo  = input.int(30, "เส้นล่าง", group = gR, inline = "rz")
rsiFill= input.bool(true, "ระบายสีโซน 30-70", group = gR)

// ─────────────────────────────── ④ MACD ─────────────────────────────
gC = "④ MACD"
fastLen = input.int(12, "EMA เร็ว", minval = 1, group = gC)
slowLen = input.int(26, "EMA ช้า",  minval = 1, group = gC)
sigLen  = input.int(9,  "Signal",   minval = 1, group = gC)
macdCol = input.color(#00E5FF, "สี MACD",  group = gC, inline = "mc")
sigCol  = input.color(#FF1744, "สี Signal", group = gC, inline = "mc")
histUp  = input.color(#26A69A, "แท่ง +", group = gC, inline = "mh")
histDn  = input.color(#EF5350, "แท่ง −", group = gC, inline = "mh")
normLen = input.int(100, "ช่วงปรับสเกล MACD (โหมดทั้งหมด)", minval = 10, group = gC)

// ───────────────────────────── คำนวณค่า ─────────────────────────────
rawK = ta.stoch(close, high, low, kLen)
kVal = ta.sma(rawK, kSmooth)          // Slow %K
dVal = ta.sma(kVal, dLen)             // %D

rsiVal = ta.rsi(rsiSrc, rsiLen)

[macdLine, sigLine, histLine] = ta.macd(close, fastLen, slowLen, sigLen)

// ปรับสเกล MACD ให้อยู่ในกรอบ 0-100 โดยให้ระดับ 50 = เส้นศูนย์
scaleRef  = math.max(ta.highest(math.abs(macdLine), normLen), ta.highest(math.abs(sigLine), normLen))
macdNorm  = na(scaleRef) or scaleRef == 0 ? 50.0 : 50.0 + 50.0 * macdLine / scaleRef
sigNorm   = na(scaleRef) or scaleRef == 0 ? 50.0 : 50.0 + 50.0 * sigLine  / scaleRef
histNorm  = na(scaleRef) or scaleRef == 0 ? 0.0  : 50.0 * histLine / scaleRef

// ──────────────────────────── ตัวคุมโหมด ────────────────────────────
bool mRSI   = mode == "RSI"        or mode == "RSI + Stochastic"
bool mStoch = mode == "Stochastic" or mode == "RSI + Stochastic"
bool mMacd  = mode == "MACD"
bool mAll   = mode == "ทั้งหมด (ปรับสเกล)"

bool use100 = mRSI or mStoch or mAll   // สเกล 0-100
bool useRaw = mMacd                     // สเกลจริงของ MACD

// ──────────────────────────── วาดเส้น ───────────────────────────────
plot(mStoch or mAll ? kVal : na, "%K", color = kCol, linewidth = 2)
plot(mStoch or mAll ? dVal : na, "%D", color = dCol, linewidth = 1)

plot(mRSI or mAll ? rsiVal : na, "RSI", color = rsiCol, linewidth = 2)

// MACD โหมดสเกลจริง
plot(useRaw ? macdLine : na, "MACD", color = macdCol, linewidth = 2)
plot(useRaw ? sigLine  : na, "Signal", color = sigCol, linewidth = 2)
histColRaw = histLine >= 0 ? (histLine >= nz(histLine[1]) ? histUp : color.new(histUp, 45)) : (histLine <= nz(histLine[1]) ? histDn : color.new(histDn, 45))
plot(useRaw ? histLine : na, "Histogram", style = plot.style_columns, color = histColRaw)
plot(useRaw ? 0 : na, "เส้นศูนย์ MACD", color = color.new(#B0BEC5, 40), linewidth = 1)

// MACD โหมดปรับสเกล
plot(mAll ? macdNorm : na, "MACD (สเกล)", color = macdCol, linewidth = 2)
plot(mAll ? sigNorm  : na, "Signal (สเกล)", color = sigCol, linewidth = 1)
histColNorm = histLine >= 0 ? color.new(histUp, 55) : color.new(histDn, 55)
plot(mAll ? 50 + histNorm : na, "Hist (สเกล)", style = plot.style_columns, color = histColNorm, histbase = 50)

// ────────────────────── เส้นระดับ (เฉพาะสเกล 0-100) ─────────────────
r70 = plot(use100 ? rsiHi  : na, "เส้นบน", color = color.new(#FF5252, 45), linewidth = 1)
r50 = plot(use100 ? rsiMid : na, "เส้นกลาง", color = color.new(#B0BEC5, 55), linewidth = 1)
r30 = plot(use100 ? rsiLo  : na, "เส้นล่าง", color = color.new(#00E676, 45), linewidth = 1)
fill(r70, r30, color = rsiFill and use100 ? color.new(#607D8B, 92) : na, title = "โซน RSI")

plot(mStoch and not mAll ? stOB : na, "Stoch OB", color = color.new(#FF5252, 70), linewidth = 1)
plot(mStoch and not mAll ? stOS : na, "Stoch OS", color = color.new(#00E676, 70), linewidth = 1)

// ────────────────────────── สัญญาณเตือน ─────────────────────────────
alertcondition(ta.crossover(kVal, dVal)  and kVal < stOS, "Stoch ตัดขึ้นในโซนขายมากไป", "Stoch {{ticker}} : %K ตัดขึ้น %D ในโซนต่ำ")
alertcondition(ta.crossunder(kVal, dVal) and kVal > stOB, "Stoch ตัดลงในโซนซื้อมากไป",  "Stoch {{ticker}} : %K ตัดลง %D ในโซนสูง")
alertcondition(ta.crossover(rsiVal, rsiLo),  "RSI ตัดขึ้นเหนือเส้นล่าง", "RSI {{ticker}} ตัดขึ้นเหนือเส้นล่าง")
alertcondition(ta.crossunder(rsiVal, rsiHi), "RSI ตัดลงใต้เส้นบน",     "RSI {{ticker}} ตัดลงใต้เส้นบน")
alertcondition(ta.crossover(macdLine, sigLine),  "MACD ตัดขึ้น", "MACD {{ticker}} ตัดขึ้นเหนือ Signal")
alertcondition(ta.crossunder(macdLine, sigLine), "MACD ตัดลง",  "MACD {{ticker}} ตัดลงใต้ Signal")

// ──────────────────────────── DASHBOARD ────────────────────────────
dbPos = dbPosStr == "บนซ้าย" ? position.top_left : dbPosStr == "บนขวา" ? position.top_right : dbPosStr == "ล่างซ้าย" ? position.bottom_left : position.bottom_right
dbSize = dbSizeStr == "จิ๋ว" ? size.tiny : dbSizeStr == "เล็ก" ? size.small : size.normal

var table db = table.new(position.top_right, 3, 8, border_width = 1, border_color = color.new(#546E7A, 40))

if showDB and barstate.islast
    table.clear(db, 0, 0, 2, 7)
    table.set_position(db, dbPos)
    table.set_bgcolor(db, color.new(#000000, 10))

    // ---- Stochastic ----
    string stTxt = kVal > stOB ? "ซื้อมากไป" : kVal < stOS ? "ขายมากไป" : "กลางๆ"
    color  stCol = kVal > stOB ? #FF5252 : kVal < stOS ? #00E676 : #B0BEC5
    table.cell(db, 0, 0, "%K " + str.tostring(kLen), text_color = kCol, text_size = dbSize, text_halign = text.align_left)
    table.cell(db, 1, 0, str.tostring(kVal, "#.##"), text_color = kCol, text_size = dbSize, text_halign = text.align_right)
    table.cell(db, 2, 0, stTxt, text_color = stCol, text_size = dbSize, text_halign = text.align_center)
    table.cell(db, 0, 1, "%D " + str.tostring(dLen), text_color = dCol, text_size = dbSize, text_halign = text.align_left)
    table.cell(db, 1, 1, str.tostring(dVal, "#.##"), text_color = dCol, text_size = dbSize, text_halign = text.align_right)
    table.cell(db, 2, 1, kVal > dVal ? "K เหนือ D" : "K ใต้ D", text_color = kVal > dVal ? #00E676 : #FF5252, text_size = dbSize, text_halign = text.align_center)

    // ---- RSI ----
    string rTxt = rsiVal > rsiHi ? "ซื้อมากไป" : rsiVal < rsiLo ? "ขายมากไป" : rsiVal > rsiMid ? "ฝั่งขึ้น" : "ฝั่งลง"
    color  rCol = rsiVal > rsiHi ? #FF5252 : rsiVal < rsiLo ? #00E676 : rsiVal > rsiMid ? #AED581 : #FF8A80
    table.cell(db, 0, 2, "RSI " + str.tostring(rsiLen), text_color = rsiCol, text_size = dbSize, text_halign = text.align_left)
    table.cell(db, 1, 2, str.tostring(rsiVal, "#.##"), text_color = rsiCol, text_size = dbSize, text_halign = text.align_right)
    table.cell(db, 2, 2, rTxt, text_color = rCol, text_size = dbSize, text_halign = text.align_center)

    // ---- MACD ----
    table.cell(db, 0, 3, "MACD E" + str.tostring(fastLen) + "-E" + str.tostring(slowLen), text_color = macdCol, text_size = dbSize, text_halign = text.align_left)
    table.cell(db, 1, 3, str.tostring(macdLine, "#.##"), text_color = macdCol, text_size = dbSize, text_halign = text.align_right)
    table.cell(db, 2, 3, macdLine > 0 ? "เหนือศูนย์" : "ใต้ศูนย์", text_color = macdLine > 0 ? #00E676 : #FF5252, text_size = dbSize, text_halign = text.align_center)

    table.cell(db, 0, 4, "Signal E" + str.tostring(sigLen), text_color = sigCol, text_size = dbSize, text_halign = text.align_left)
    table.cell(db, 1, 4, str.tostring(sigLine, "#.##"), text_color = sigCol, text_size = dbSize, text_halign = text.align_right)
    table.cell(db, 2, 4, macdLine > sigLine ? "MACD เหนือ" : "MACD ใต้", text_color = macdLine > sigLine ? #00E676 : #FF5252, text_size = dbSize, text_halign = text.align_center)

    color hCol = histLine >= 0 ? histUp : histDn
    table.cell(db, 0, 5, "MACD Osc", text_color = #FFEB3B, text_size = dbSize, text_halign = text.align_left)
    table.cell(db, 1, 5, str.tostring(histLine, "#.##"), text_color = hCol, text_size = dbSize, text_halign = text.align_right)
    table.cell(db, 2, 5, histLine >= nz(histLine[1]) ? "แรงขึ้น" : "แรงลด", text_color = hCol, text_size = dbSize, text_halign = text.align_center)

    // ---- สรุปคะแนนรวม 3 ตัว ----
    int sc = 0
    sc := sc + (kVal > dVal ? 1 : -1)
    sc := sc + (rsiVal > rsiMid ? 1 : -1)
    sc := sc + (macdLine > sigLine ? 1 : -1)
    string sumTxt = sc == 3 ? "เขียวทั้ง 3 ตัว" : sc == 1 ? "เอียงขึ้น 2:1" : sc == -1 ? "เอียงลง 1:2" : "แดงทั้ง 3 ตัว"
    color  sumCol = sc == 3 ? #00E676 : sc == 1 ? #AED581 : sc == -1 ? #FF8A80 : #FF1744

    table.cell(db, 0, 6, "สรุป", text_color = #B0BEC5, text_size = dbSize, bgcolor = color.new(#263238, 0), text_halign = text.align_left)
    table.cell(db, 1, 6, str.tostring(sc), text_color = sumCol, text_size = dbSize, bgcolor = color.new(#263238, 0), text_halign = text.align_right)
    table.cell(db, 2, 6, sumTxt, text_color = sumCol, text_size = dbSize, bgcolor = color.new(#263238, 0), text_halign = text.align_center)

    table.cell(db, 0, 7, "โหมด", text_color = #78909C, text_size = dbSize, text_halign = text.align_left)
    table.cell(db, 1, 7, mode, text_color = #78909C, text_size = dbSize, text_halign = text.align_right)
    table.cell(db, 2, 7, timeframe.period, text_color = #78909C, text_size = dbSize, text_halign = text.align_center)
// ═══════════════════════ จบสคริปต์ ════════════════════════════════
