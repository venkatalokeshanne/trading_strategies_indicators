const string BOARD_LARGE = "Large"
const string BOARD_COMPACT = "Compact"

const int LEVEL_COUNT = 5
const int MAX_FANS = 4
const int MAX_FILL_BANDS = LEVEL_COUNT - 1
const int VISUAL_ATR_LENGTH = 14
const float GOLDEN_POCKET_RATIO_618 = 0.618
const float GOLDEN_POCKET_RATIO_650 = 0.650
const float GOLDEN_POCKET_OPACITY = 24.0
const int STATE_WAITING_FIRST = 0
const int STATE_WAITING_OPPOSITE = 1
const int STATE_ACTIVE = 2
const int STATE_HELD = 3
const int STATE_INVALIDATED = 4
const int POCKET_STATE_WAITING = 0
const int POCKET_STATE_BELOW = 1
const int POCKET_STATE_INSIDE = 2
const int POCKET_STATE_ABOVE = 3
const int SIDE_BELOW = -1
const int SIDE_TESTING = 0
const int SIDE_ABOVE = 1
const int EVENT_NONE = 0
const int EVENT_TESTING = 1
const int EVENT_REJECT_UP = 2
const int EVENT_REJECT_DOWN = 3
const int EVENT_BREAK_UP = 4
const int EVENT_BREAK_DOWN = 5
const int EVENT_HOLD_ABOVE = 6
const int EVENT_HOLD_BELOW = 7

const string TOOLTIP_TIMEFRAME = "• Chart or same duration: uses chart bars\n• Higher timeframe: waits for completed source bars\n• Lower/non-comparable: no fan; chart shows the fix"
const string TOOLTIP_PRESET = "• Swing default: 7 · 1.25 ATR · 25% efficiency\n• Intraday: 5 · 1.00 ATR · 20% efficiency\n• Scalp: 3 · 0.65 ATR · 15% efficiency\n• Presets use ATR(21); lower gates reduce filtering\n• Custom enables the four fields below"
const string TOOLTIP_STRENGTH = "• Custom only\n• Source bars required on each side of a pivot\n• Confirms this many source bars after the pivot\n• Higher values find fewer, later pivots"
const string TOOLTIP_ATR_LENGTH = "• Custom only; presets use 21\n• ATR lookback on the selected anchor source\n• Normalizes candidate leg size\n• Board tolerance uses chart ATR with this length"
const string TOOLTIP_MIN_ATR = "• Custom only\n• Minimum anchor-to-anchor move in source ATRs\n• Zero disables this qualification filter"
const string TOOLTIP_MIN_EFFICIENCY = "• Custom only\n• Direct move ÷ total true-range path\n• Higher values reject choppier legs\n• Zero disables this qualification filter"
const string TOOLTIP_SCHEME = "• Visual only; anchor and event logic do not change\n• Sets ray, fill, glow, and board-rail colors\n• Custom enables the five Color controls\n• Older fans retain the palette with more fade"
const string TOOLTIP_LEVEL = "• Show controls this ray and its adjacent fills\n• Hidden levels show OFF while any ray remains\n• Ratio: 0 = leg end · 1 = leg origin\n• Ratio changes ray geometry, not anchor selection\n• Color is visual only and active with Custom"
const string TOOLTIP_FANS = "• Limits current and archived fans together\n• Range: 1–4; qualification does not change\n• At the limit, a new fan evicts the oldest"
const string TOOLTIP_PROJECTION = "• Both modes keep identical anchors and slope\n• Lifecycle ends current rays at the latest chart bar\n• Lifecycle ends archives at replacement/invalidation\n• Infinite extends current and archived rays right\n• Baselines remain anchor-bounded"
const string TOOLTIP_LINE_STYLE = "• Dotted is the default\n• Applies to all core rays and Gradient glow\n• Options: Solid · Dashed · Dotted\n• Visual only; baselines remain dashed"
const string TOOLTIP_LINE_WIDTH = "• Default: 1 px · range: 1–4 px\n• Anchor and event logic do not change\n• Gradient adds wider glow around current rays\n• Baselines remain 1 px"
const string TOOLTIP_FILL = "• Visual only; anchor and event logic do not change\n• Off hides editable-level bands and glow only\n• Golden Pocket has its own display control\n• Solid: one shared editable-band color\n• Gradient: stepped blends, glow, and emphasis"
const string TOOLTIP_FILL_OPACITY = "• Default: 20% · range: 0–60%\n• Sets base band opacity; core rays do not change\n• Gradient fades tighter projected spacing\n• Current price band may reach 1.75×, capped at 60%"
const string TOOLTIP_BASELINE = "• Visual only; joins each fan's two anchors\n• Always dashed, 1 px, and anchor-bounded\n• Projection mode never extends it"
const string TOOLTIP_BASELINE_COLOR = "• Visual only; shared by every baseline\n• Uses the selected color and transparency\n• Older baselines fade further with fan age"
const string TOOLTIP_STATUS_BOARD = "• Current fan only · fixed at top-right\n• Gold row shows confirmed close versus the pocket\n• Level rows show ratio, rail, price, and last event\n• Level event and age persist; states are not signals\n• Fan changes reset states; timeframe warnings can remain"
const string TOOLTIP_BOARD_SIZE = "• Visual only; changes board cells and text\n• Compact is the smaller default\n• Large increases both; state logic does not change"
const string TOOLTIP_TOLERANCE = "• Confirmed chart-bar events only\n• Zone = max(chart ATR(active length) × factor, 2 ticks)\n• ATR length follows the active preset or Custom value\n• Inside = TESTED; full cross = BROKEN\n• Same-side retest = REJECTED or post-break HELD"
const string TOOLTIP_GOLDEN_POCKET = "• Shades current fan 0.618–0.650\n• 0.650 is conventional, not Fibonacci-derived\n• Board uses last confirmed close: IN/ABOVE/BELOW\n• Independent of level visibility and Fill Mode\n• Context only; not a trade signal"

color DEFAULT_BASELINE_COLOR = #78909C
color PANEL_BACKGROUND = color.new(#111827, 12)
color PANEL_KEY_BACKGROUND = color.new(#1F2937, 12)
color PANEL_TEXT = #F3F4F6
color PANEL_MUTED = #CBD5E1
color PANEL_WARNING = #F59E0B
color GOLDEN_POCKET_COLOR = #C6A15B
color STATUS_ABOVE = #22C55E
color STATUS_BELOW = #EF4444
color STATUS_TESTING = #F59E0B
color STATUS_BREAK = #38BDF8
color STATUS_HOLD = #A78BFA

// Inputs and effective settings

string anchorTimeframeInput = input.timeframe(
    defval = "",
    title = "Anchor Timeframe",
    tooltip = TOOLTIP_TIMEFRAME,
    group = GROUP_ANCHORS,
    display = display.none
)
string behaviorPresetInput = input.string(
    defval = PRESET_SWING,
    title = "Qualification Preset",
    options = [PRESET_SCALP, PRESET_INTRADAY, PRESET_SWING, PRESET_CUSTOM],
    tooltip = TOOLTIP_PRESET,
    group = GROUP_ANCHORS,
    display = display.none
)
int swingStrengthInput = input.int(
    defval = 7,
    title = "Pivot Strength",
    minval = 2,
    maxval = 50,
    tooltip = TOOLTIP_STRENGTH,
    group = GROUP_ANCHORS,
    display = display.none,
    active = behaviorPresetInput == PRESET_CUSTOM
)
int atrLengthInput = input.int(
    defval = 21,
    title = "ATR Length",
    minval = 2,
    maxval = 100,
    tooltip = TOOLTIP_ATR_LENGTH,
    group = GROUP_ANCHORS,
    display = display.none,
    active = behaviorPresetInput == PRESET_CUSTOM
)
float minimumAtrUnitsInput = input.float(
    defval = 1.25,
    title = "Minimum Leg (ATR)",
    minval = 0.00,
    maxval = 20.00,
    step = 0.05,
    tooltip = TOOLTIP_MIN_ATR,
    group = GROUP_ANCHORS,
    display = display.none,
    active = behaviorPresetInput == PRESET_CUSTOM
)
float minimumEfficiencyInput = input.float(
    defval = 0.25,
    title = "Minimum Efficiency",
    minval = 0.00,
    maxval = 1.00,
    step = 0.05,
    tooltip = TOOLTIP_MIN_EFFICIENCY,
    group = GROUP_ANCHORS,
    display = display.none,
    active = behaviorPresetInput == PRESET_CUSTOM
)

string colorSchemeInput = input.string(
    defval = SCHEME_ORDER_FLOW,
    title = "Color Scheme",
    options = [SCHEME_ORDER_FLOW, SCHEME_MIDNIGHT, SCHEME_NEON, SCHEME_OCEAN, SCHEME_EMBER, SCHEME_VIOLET, SCHEME_COPPER, SCHEME_ARCTIC, SCHEME_CARBON, SCHEME_CUSTOM],
    tooltip = TOOLTIP_SCHEME,
    group = GROUP_LEVELS,
    display = display.none
)

bool showLevel1Input = input.bool(true, "Show", inline = "level1", group = GROUP_LEVELS, display = display.none)
float level1Input = input.float(0.236, "Ratio", minval = 0.0, maxval = 1.0, step = 0.001, inline = "level1", group = GROUP_LEVELS, display = display.none, active = showLevel1Input)
color level1ColorInput = input.color(#0072B2, "Color", tooltip = TOOLTIP_LEVEL, inline = "level1", group = GROUP_LEVELS, display = display.none, active = colorSchemeInput == SCHEME_CUSTOM)
bool showLevel2Input = input.bool(true, "Show", inline = "level2", group = GROUP_LEVELS, display = display.none)
float level2Input = input.float(0.382, "Ratio", minval = 0.0, maxval = 1.0, step = 0.001, inline = "level2", group = GROUP_LEVELS, display = display.none, active = showLevel2Input)
color level2ColorInput = input.color(#356D86, "Color", tooltip = TOOLTIP_LEVEL, inline = "level2", group = GROUP_LEVELS, display = display.none, active = colorSchemeInput == SCHEME_CUSTOM)
bool showLevel3Input = input.bool(true, "Show", inline = "level3", group = GROUP_LEVELS, display = display.none)
float level3Input = input.float(0.500, "Ratio", minval = 0.0, maxval = 1.0, step = 0.001, inline = "level3", group = GROUP_LEVELS, display = display.none, active = showLevel3Input)
color level3ColorInput = input.color(#6B6859, "Color", tooltip = TOOLTIP_LEVEL, inline = "level3", group = GROUP_LEVELS, display = display.none, active = colorSchemeInput == SCHEME_CUSTOM)
bool showLevel4Input = input.bool(true, "Show", inline = "level4", group = GROUP_LEVELS, display = display.none)
float level4Input = input.float(0.618, "Ratio", minval = 0.0, maxval = 1.0, step = 0.001, inline = "level4", group = GROUP_LEVELS, display = display.none, active = showLevel4Input)
color level4ColorInput = input.color(#A0632D, "Color", tooltip = TOOLTIP_LEVEL, inline = "level4", group = GROUP_LEVELS, display = display.none, active = colorSchemeInput == SCHEME_CUSTOM)
bool showLevel5Input = input.bool(true, "Show", inline = "level5", group = GROUP_LEVELS, display = display.none)
float level5Input = input.float(0.786, "Ratio", minval = 0.0, maxval = 1.0, step = 0.001, inline = "level5", group = GROUP_LEVELS, display = display.none, active = showLevel5Input)
color level5ColorInput = input.color(#D55E00, "Color", tooltip = TOOLTIP_LEVEL, inline = "level5", group = GROUP_LEVELS, display = display.none, active = colorSchemeInput == SCHEME_CUSTOM)

int fansOnChartInput = input.int(4, "Visible Fans", minval = 1, maxval = 4, tooltip = TOOLTIP_FANS, group = GROUP_DISPLAY, display = display.none)
string rayProjectionInput = input.string(PROJECTION_LIFECYCLE, "Projection", options = [PROJECTION_LIFECYCLE, PROJECTION_INFINITE], tooltip = TOOLTIP_PROJECTION, group = GROUP_DISPLAY, display = display.none)
string lineStyleInput = input.string(STYLE_DOTTED, "Ray Style", options = [STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], tooltip = TOOLTIP_LINE_STYLE, group = GROUP_DISPLAY, display = display.none)
int lineWidthInput = input.int(1, "Ray Width", minval = 1, maxval = 4, tooltip = TOOLTIP_LINE_WIDTH, group = GROUP_DISPLAY, display = display.none)
string fanFillInput = input.string(FILL_GRADIENT, "Fill Mode", options = [FILL_OFF, FILL_SOLID, FILL_GRADIENT], tooltip = TOOLTIP_FILL, group = GROUP_DISPLAY, display = display.none)
int fillOpacityInput = input.int(20, "Fill Opacity", minval = 0, maxval = 60, tooltip = TOOLTIP_FILL_OPACITY, group = GROUP_DISPLAY, display = display.none, active = fanFillInput != FILL_OFF)
bool showBaselineInput = input.bool(true, "Show Baselines", tooltip = TOOLTIP_BASELINE, group = GROUP_DISPLAY, display = display.none)
color baselineColorInput = input.color(DEFAULT_BASELINE_COLOR, "Baseline Color", tooltip = TOOLTIP_BASELINE_COLOR, group = GROUP_DISPLAY, display = display.none, active = showBaselineInput)
bool showStatusBoardInput = input.bool(true, "Show Fib Status Board", tooltip = TOOLTIP_STATUS_BOARD, group = GROUP_DISPLAY, display = display.none)
string statusBoardSizeInput = input.string(BOARD_COMPACT, "Status Board Size", options = [BOARD_COMPACT, BOARD_LARGE], tooltip = TOOLTIP_BOARD_SIZE, group = GROUP_DISPLAY, display = display.none, active = showStatusBoardInput)
float interactionToleranceInput = input.float(0.10, "Interaction Tolerance (ATR)", minval = 0.00, maxval = 1.00, step = 0.05, tooltip = TOOLTIP_TOLERANCE, group = GROUP_DISPLAY, display = display.none, active = showStatusBoardInput)
bool showGoldenPocketInput = input.bool(true, "Show Golden Pocket", tooltip = TOOLTIP_GOLDEN_POCKET, group = GROUP_DISPLAY, display = display.none)

int effectiveSwingStrength = switch behaviorPresetInput
    PRESET_SCALP => 3
    PRESET_INTRADAY => 5
    PRESET_SWING => 7
    => swingStrengthInput
int effectiveAtrLength = behaviorPresetInput == PRESET_CUSTOM ? atrLengthInput : 21
float effectiveMinimumAtrUnits = switch behaviorPresetInput
    PRESET_SCALP => 0.65
    PRESET_INTRADAY => 1.00
    PRESET_SWING => 1.25
    => minimumAtrUnitsInput
float effectiveMinimumEfficiency = switch behaviorPresetInput
    PRESET_SCALP => 0.15
    PRESET_INTRADAY => 0.20
    PRESET_SWING => 0.25
    => minimumEfficiencyInput

// Geometry, style, and state helpers

strictPivotHigh(int strength) =>
    float candidate = high[strength]
    bool result = not na(candidate)
    for offset = 1 to strength
        float rightNeighbor = high[strength - offset]
        float leftNeighbor = high[strength + offset]
        if na(leftNeighbor) or na(rightNeighbor) or leftNeighbor >= candidate or rightNeighbor >= candidate
            result := false
    result

strictPivotLow(int strength) =>
    float candidate = low[strength]
    bool result = not na(candidate)
    for offset = 1 to strength
        float rightNeighbor = low[strength - offset]
        float leftNeighbor = low[strength + offset]
        if na(leftNeighbor) or na(rightNeighbor) or leftNeighbor <= candidate or rightNeighbor <= candidate
            result := false
    result

levelPrice(float originPrice, float endPrice, float ratio) =>
    endPrice + (originPrice - endPrice) * ratio

projectedPrice(float originPrice, int originTime, float constructionPrice, int constructionTime, int targetTime) =>
    float elapsedFraction = float(targetTime - originTime) / float(constructionTime - originTime)
    originPrice + (constructionPrice - originPrice) * elapsedFraction

gradientDepth(float projectedSpacing, float normalization) =>
    float normalizedSpacing = math.min(1.0, projectedSpacing / math.max(normalization, syminfo.mintick * 2.0))
    0.35 + 0.65 * normalizedSpacing

lineStyleOf(string styleName) =>
    switch styleName
        STYLE_DASHED => line.style_dashed
        STYLE_DOTTED => line.style_dotted
        => line.style_solid

paletteColor(int levelIndex, color level1, color level2, color level3, color level4, color level5) =>
    switch levelIndex
        0 => level1
        1 => level2
        2 => level3
        3 => level4
        => level5

schemeColor(string schemeName, int levelIndex) =>
    switch schemeName
        SCHEME_MIDNIGHT => paletteColor(levelIndex, #3B78A5, #5671A3, #716AA2, #8B63A0, #A65C9E)
        SCHEME_NEON => paletteColor(levelIndex, #00F5FF, #39FF14, #FFF01F, #FF7A00, #FF2BD6)
        SCHEME_OCEAN => paletteColor(levelIndex, #28DAD2, #5EB8C2, #9496B2, #C974A1, #FF5291)
        SCHEME_EMBER => paletteColor(levelIndex, #FFB248, #FF9D48, #FF8748, #FF7248, #FF5C48)
        SCHEME_VIOLET => paletteColor(levelIndex, #9970FF, #B36BEB, #CC66D8, #E661C4, #FF5CB0)
        SCHEME_COPPER => paletteColor(levelIndex, #A15C22, #A15934, #A15646, #A15258, #A14F6A)
        SCHEME_ARCTIC => paletteColor(levelIndex, #1F7A8C, #446F82, #686378, #8D586D, #B14C63)
        SCHEME_CARBON => paletteColor(levelIndex, #3F7782, #556E7C, #6B6677, #805D71, #96546B)
        => paletteColor(levelIndex, #0072B2, #356D86, #6B6859, #A0632D, #D55E00)

fadeColor(color baseColor, float opacityFactor) =>
    float baseOpacity = 100.0 - color.t(baseColor)
    float boundedFactor = math.max(0.0, math.min(100.0, opacityFactor))
    int combinedTransparency = int(math.round(100.0 - baseOpacity * boundedFactor / 100.0))
    color.new(baseColor, combinedTransparency)

blendColors(color firstColor, color secondColor) =>
    int red = int(math.round((color.r(firstColor) + color.r(secondColor)) / 2.0))
    int green = int(math.round((color.g(firstColor) + color.g(secondColor)) / 2.0))
    int blue = int(math.round((color.b(firstColor) + color.b(secondColor)) / 2.0))
    int transparency = int(math.round((color.t(firstColor) + color.t(secondColor)) / 2.0))
    color.rgb(red, green, blue, transparency)

contrastTextColor(color backgroundColor) =>
    float luminance = color.r(backgroundColor) * 0.299 + color.g(backgroundColor) * 0.587 + color.b(backgroundColor) * 0.114
    luminance >= 150.0 ? #111827 : #F8FAFC

interactionSide(float confirmedClose, float projectedLevel, float tolerance) =>
    confirmedClose > projectedLevel + tolerance ? SIDE_ABOVE : confirmedClose < projectedLevel - tolerance ? SIDE_BELOW : SIDE_TESTING

interactionEventText(int eventType, int stableSide, int eventBar, int currentBar) =>
    string baseText = switch eventType
        EVENT_TESTING => "TESTED"
        EVENT_REJECT_UP => "REJECTED ↑"
        EVENT_REJECT_DOWN => "REJECTED ↓"
        EVENT_BREAK_UP => "BROKEN ↑"
        EVENT_BREAK_DOWN => "BROKEN ↓"
        EVENT_HOLD_ABOVE => "HELD ↑"
        EVENT_HOLD_BELOW => "HELD ↓"
        => stableSide == SIDE_ABOVE ? "ABOVE" : stableSide == SIDE_BELOW ? "BELOW" : "WAITING"
    int eventAge = eventType == EVENT_NONE or na(eventBar) ? na : math.max(0, currentBar - eventBar)
    na(eventAge) ? baseText : baseText + (eventAge == 0 ? " · NOW" : " · " + str.tostring(eventAge) + "B")

interactionEventColor(int eventType, int stableSide) =>
    switch eventType
        EVENT_TESTING => STATUS_TESTING
        EVENT_REJECT_UP => STATUS_ABOVE
        EVENT_REJECT_DOWN => STATUS_BELOW
        EVENT_BREAK_UP => STATUS_BREAK
        EVENT_BREAK_DOWN => STATUS_BREAK
        EVENT_HOLD_ABOVE => STATUS_HOLD
        EVENT_HOLD_BELOW => STATUS_HOLD
        => stableSide == SIDE_ABOVE ? STATUS_ABOVE : stableSide == SIDE_BELOW ? STATUS_BELOW : PANEL_MUTED

sourceAnchorState(bool commit) =>
    float sourceTrueRange = ta.tr(true)
    float cumulativeTrueRange = ta.cum(sourceTrueRange)
    float sourceAtr = ta.atr(effectiveAtrLength)
    bool highPivot = strictPivotHigh(effectiveSwingStrength)
    bool lowPivot = strictPivotLow(effectiveSwingStrength)

    var int previousSide = 0
    var float previousPrice = na
    var int previousTime = na
    var float previousPath = na

    var int latestSide = 0
    var float latestPrice = na
    var int latestTime = na
    var float latestPath = na
    var float latestAtr = na

    var float activeOriginPrice = na
    var int activeOriginTime = na
    var float activeEndPrice = na
    var int activeEndTime = na
    var int activeDirection = 0
    var float activeAtrUnits = na
    var float activeEfficiency = na
    var int activeState = STATE_WAITING_FIRST
    var int activeQualifiedAtTime = na

    float qualifiedEventOriginPrice = na
    int qualifiedEventOriginTime = na
    float qualifiedEventEndPrice = na
    int qualifiedEventEndTime = na
    int qualifiedEventDirection = 0
    float qualifiedEventAtrUnits = na
    float qualifiedEventEfficiency = na
    int qualifiedEventAtTime = na
    int invalidatedEventAtTime = na

    if commit
        int eventSide = 0
        float eventPrice = na
        int eventTime = na
        float eventPath = na
        float eventAtr = na

        if highPivot and lowPivot
            if latestSide == 1
                eventSide := -1
                eventPrice := low[effectiveSwingStrength]
            else if latestSide == -1
                eventSide := 1
                eventPrice := high[effectiveSwingStrength]
        else if highPivot
            eventSide := 1
            eventPrice := high[effectiveSwingStrength]
        else if lowPivot
            eventSide := -1
            eventPrice := low[effectiveSwingStrength]

        if eventSide != 0
            eventTime := time[effectiveSwingStrength]
            eventPath := cumulativeTrueRange[effectiveSwingStrength]
            eventAtr := sourceAtr[effectiveSwingStrength]

            bool candidateChanged = false
            if latestSide == 0
                latestSide := eventSide
                latestPrice := eventPrice
                latestTime := eventTime
                latestPath := eventPath
                latestAtr := eventAtr
                if activeState == STATE_WAITING_FIRST
                    activeState := STATE_WAITING_OPPOSITE
            else if latestSide == eventSide
                bool moreExtreme = eventSide == 1 ? eventPrice > latestPrice : eventPrice < latestPrice
                if moreExtreme
                    latestPrice := eventPrice
                    latestTime := eventTime
                    latestPath := eventPath
                    latestAtr := eventAtr
                    candidateChanged := previousSide != 0
            else
                previousSide := latestSide
                previousPrice := latestPrice
                previousTime := latestTime
                previousPath := latestPath

                latestSide := eventSide
                latestPrice := eventPrice
                latestTime := eventTime
                latestPath := eventPath
                latestAtr := eventAtr
                candidateChanged := true

            if candidateChanged and previousSide != 0 and previousSide != latestSide
                float candidateRange = math.abs(latestPrice - previousPrice)
                float candidatePath = math.abs(latestPath - previousPath)
                bool drawable = candidateRange > 0.0 and latestTime != previousTime
                bool metricsAvailable = drawable and not na(latestAtr) and latestAtr > 0.0 and not na(candidatePath) and candidatePath > 0.0
                float candidateAtrUnits = metricsAvailable ? candidateRange / latestAtr : na
                float candidateEfficiency = metricsAvailable ? math.min(1.0, candidateRange / candidatePath) : na
                bool qualified = metricsAvailable and candidateAtrUnits >= effectiveMinimumAtrUnits and candidateEfficiency >= effectiveMinimumEfficiency

                if qualified
                    activeOriginPrice := previousPrice
                    activeOriginTime := previousTime
                    activeEndPrice := latestPrice
                    activeEndTime := latestTime
                    activeDirection := latestSide == 1 ? 1 : -1
                    activeAtrUnits := candidateAtrUnits
                    activeEfficiency := candidateEfficiency
                    activeState := STATE_ACTIVE
                    activeQualifiedAtTime := time
                    qualifiedEventOriginPrice := previousPrice
                    qualifiedEventOriginTime := previousTime
                    qualifiedEventEndPrice := latestPrice
                    qualifiedEventEndTime := latestTime
                    qualifiedEventDirection := latestSide == 1 ? 1 : -1
                    qualifiedEventAtrUnits := candidateAtrUnits
                    qualifiedEventEfficiency := candidateEfficiency
