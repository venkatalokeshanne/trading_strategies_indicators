// --- GOLDEN / DEATH : TOP / BOTTOM FIXE ---
// Une seule sortie globale par direction évite de multiplier les plots.
// Si n'importe quel Cross actif correspond à SMA 50D / SMA 200D,
// le marqueur affiche GOLDEN ou DEATH au lieu du numéro du Cross.

anyGoldenBull =
     (cross1Visual and c1Bull and c1GoldenPair) or
     (cross2Visual and c2Bull and c2GoldenPair) or
     (cross3Visual and c3Bull and c3GoldenPair) or
     (cross4Visual and c4Bull and c4GoldenPair) or
     (cross5Visual and c5Bull and c5GoldenPair) or
     (cross6Visual and c6Bull and c6GoldenPair)

anyDeathBear =
     (cross1Visual and c1Bear and c1GoldenPair) or
     (cross2Visual and c2Bear and c2GoldenPair) or
     (cross3Visual and c3Bear and c3GoldenPair) or
     (cross4Visual and c4Bear and c4GoldenPair) or
     (cross5Visual and c5Bear and c5GoldenPair) or
     (cross6Visual and c6Bear and c6GoldenPair)

plotshape(
    anyGoldenBull and (crossBullLocation == location.bottom or crossBullLocation == location.top),
    title="GOLDEN CROSS",
    style=crossBullShape,
    location=crossBullLocation,
    color=color.green,
    text="GOLDEN",
    textcolor=crossShowText ? color.white : color.new(color.white, 100),
    size=size.small,
    editable=false,
    display=display.pane
)

plotshape(
    anyDeathBear and (crossBearLocation == location.bottom or crossBearLocation == location.top),
    title="DEATH CROSS",
    style=crossBearShape,
    location=crossBearLocation,
    color=color.red,
    text="DEATH",
    textcolor=crossShowText ? color.white : color.new(color.white, 100),
    size=size.small,
    editable=false,
    display=display.pane
)

// --- ABOVE BAR / BELOW BAR : FLEXIBLE AVEC DÉCALAGE ---

f_drawFlexibleCross(bool condition, bool bullish, string markerText) =>
    if condition
        string markerLocation = bullish ? crossBullLocation : crossBearLocation
        bool flexible = markerLocation == location.abovebar or markerLocation == location.belowbar
        if flexible
            float markerOffset = bullish ? crossBullOffset : crossBearOffset
            float markerY = markerLocation == location.abovebar ? high * (1 + markerOffset / 100) : low * (1 - markerOffset / 100)
            string markerStyle = bullish ? crossBullLabelStyle : crossBearLabelStyle
            color markerColor = bullish ? color.green : color.red
            string markerVisibleText = crossShowText ? markerText : ""
            label.new(
                bar_index,
                markerY,
                markerVisibleText,
                xloc=xloc.bar_index,
                yloc=yloc.price,
                color=markerColor,
                style=markerStyle,
                textcolor=color.white,
                size=crossLabelSize
            )

f_drawFlexibleCross(cross1Visual and c1Bull, true, c1GoldenPair ? "GOLDEN" : "1")
f_drawFlexibleCross(cross1Visual and c1Bear, false, c1GoldenPair ? "DEATH" : "1")
f_drawFlexibleCross(cross2Visual and c2Bull, true, c2GoldenPair ? "GOLDEN" : "2")
f_drawFlexibleCross(cross2Visual and c2Bear, false, c2GoldenPair ? "DEATH" : "2")
f_drawFlexibleCross(cross3Visual and c3Bull, true, c3GoldenPair ? "GOLDEN" : "3")
f_drawFlexibleCross(cross3Visual and c3Bear, false, c3GoldenPair ? "DEATH" : "3")
f_drawFlexibleCross(cross4Visual and c4Bull, true, c4GoldenPair ? "GOLDEN" : "4")
f_drawFlexibleCross(cross4Visual and c4Bear, false, c4GoldenPair ? "DEATH" : "4")
f_drawFlexibleCross(cross5Visual and c5Bull, true, c5GoldenPair ? "GOLDEN" : "5")
f_drawFlexibleCross(cross5Visual and c5Bear, false, c5GoldenPair ? "DEATH" : "5")
f_drawFlexibleCross(cross6Visual and c6Bull, true, c6GoldenPair ? "GOLDEN" : "6")
f_drawFlexibleCross(cross6Visual and c6Bear, false, c6GoldenPair ? "DEATH" : "6")


