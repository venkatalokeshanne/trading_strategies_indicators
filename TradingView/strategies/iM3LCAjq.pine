//@version=5
strategy("XAU_Tanner_Vol_Funnel_V6", overlay=true, initial_capital=1000000, default_qty_type=strategy.percent_of_equity, default_qty_value=90, commission_type=strategy.commission.percent, commission_value=0.1)

// ==================== 基础参数 ====================
bb_length    = input.int(25, "布林带周期")
bb_mult      = input.float(2.0, "布林带倍数")
rsi_length   = input.int(14, "RSI 周期")
rsi_filter   = input.int(55, "RSI 强度过滤")

// ==================== 波动率漏斗参数 ====================
atr_length   = input.int(14, "ATR 周期")
vol_threshold = input.float(1.2, "波动率放大阈值") 

// 费率适应性止盈止损 (针对 0.1% 费率优化)
tp_pct = input.float(2.5, "止盈 %") / 100
sl_pct = input.float(1.2, "止损 %") / 100

// ==================== 指标计算 ====================
[basis, upper, lower] = ta.bb(close, bb_length, bb_mult)
rsi_val = ta.rsi(close, rsi_length)

// 波动率漏斗计算逻辑
atr = ta.atr(atr_length)
atr_sma = ta.sma(atr, 50) 
// 漏斗逻辑：当前波动率不能处于死寂状态
vol_is_ready = atr > (atr_sma * 0.8) 

// ==================== 信号逻辑 ====================
// 引用前一根收盘价 [1]，防止实盘信号闪烁（Repainting）
cross_under_upper = close[1] > upper[1] and close < upper
signal_long = cross_under_upper and rsi_val > rsi_filter and vol_is_ready

// ==================== 执行策略 ====================
if (strategy.position_size == 0)
    if (signal_long)
        strategy.entry("Long", strategy.long, comment="漏斗入场")

if (strategy.position_size > 0)
    strategy.exit("Exit", "Long", limit=strategy.position_avg_price * (1 + tp_pct), stop=strategy.position_avg_price * (1 - sl_pct), comment="止盈/止损")

// ==================== 绘图 ====================
plot(upper, color=color.new(color.red, 30), title="上轨")
plot(lower, color=color.new(color.green, 30), title="下轨")
bgcolor(vol_is_ready ? color.new(color.blue, 95) : na, title="波动率就绪区域")