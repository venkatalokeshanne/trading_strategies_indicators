//@version=6
indicator("SHM - RSI Momentum Matrix", overlay=false, max_labels_count=500)

// ==========================================
// 1. CORE ENTRY INPUTS
// ==========================================
// WMA Core Framework
var_fast_wma_len = input.int(63, title="Fast Institutional WMA Length", group="1. Core Framework")
var_slow_wma_len = input.int(480, title="Macro Baseline WMA Length", group="1. Core Framework")
wma_offset       = input.int(0, title="Visual Plot Offset", minval=-500, maxval=500, group="1. Core Framework", tooltip="Shifts indicator plots left or right visually.")
sensitivity      = input.int(41, title="Structural Sensitivity Filter", group="1. Core Framework")
src              = input.source(ohlc4, title="Price Source Data", group="1. Core Framework")

// =========================================================================
// EXPERIMENTAL BASELINE PRICE ACTION TOGGLE MODULE
// =========================================================================
var string G_PA_TEST = "Experimental Baseline PA Module"
use_pa_test          = input.bool(false, title="Enable Experimental Baseline PA Module", tooltip="Turn ON to bypass standard entries and isolate pure line-crossing mechanics.", group=G_PA_TEST)
use_body_trigger     = input.bool(true, title="► Use Candle Body Trigger (Close Cross)", tooltip="Trigger entries when the candle CLOSE crosses the 65 or 480 WMA lines (Original v7.3 behavior).", group=G_PA_TEST)
use_wick_trigger     = input.bool(false, title="► Use Candle Wick Trigger (High/Low Cross)", tooltip="Trigger entries immediately when the candle WICK (High/Low) crosses the 65 or 480 WMA lines.", group=G_PA_TEST)

// Macro Tide Filter (480 WMA Alignment)
use_macro_tide   = input.bool(true, title="Enable Macro Tide Filter", tooltip="Requires price to be above 480 WMA for Longs and below for Shorts.", group="2. Macro Tide Filter")

// Timeframe-Locked RSI Momentum Matrix
use_rsi_filter  = input.bool(true, title="Enable RSI Momentum Gate", tooltip="Filters signals using RSI momentum thresholds.", group="3. RSI Momentum Matrix")
rsi_tf          = input.timeframe("1440", title="Locked RSI Timeframe", tooltip="Select '1440' for Daily or leave empty to match the chart timeframe.", group="3. RSI Momentum Matrix")
rsi_len         = input.int(33, title="RSI Lookback Period", group="3. RSI Momentum Matrix")
rsi_long_min    = input.float(42.0, title="Min RSI for Longs (Velocity Gate)", group="3. RSI Momentum Matrix")
rsi_long_max    = input.float(48.0, title="Max RSI for Longs (Exhaustion Cap)", group="3. RSI Momentum Matrix")
rsi_short_max   = input.float(52.0, title="Max RSI for Shorts (Velocity Gate)", group="3. RSI Momentum Matrix")
rsi_short_min   = input.float(46.0, title="Min RSI for Shorts (Exhaustion Floor)", group="3. RSI Momentum Matrix")

// Visual Display Settings
show_labels     = input.bool(true, title="Show Buy/Sell Signal Labels", group="4. Display Settings")
show_rsi_bands  = input.bool(true, title="Show Threshold Zone Box", group="4. Display Settings")

// ==========================================
// 2. MATHEMATICS & SIGNAL MATRIX
// ==========================================
// WMAs and Sensitivity Line
fast_wma  = ta.wma(src, var_fast_wma_len)
slow_wma  = ta.wma(src, var_slow_wma_len)
filter_ma = ta.sma(src, sensitivity)

// Macro Tide Engine
macro_bullish = not use_macro_tide or (close > slow_wma)
macro_bearish = not use_macro_tide or (close < slow_wma)

// Timeframe-Locked RSI Engine
rsi_raw = ta.rsi(src, rsi_len)
rsi_val = request.security(syminfo.tickerid, rsi_tf, rsi_raw[1], barmerge.gaps_off, barmerge.lookahead_off)

rsi_long_ok  = not use_rsi_filter or (rsi_val >= rsi_long_min and rsi_val <= rsi_long_max)
rsi_short_ok = not use_rsi_filter or (rsi_val <= rsi_short_max and rsi_val >= rsi_short_min)

// --- PURE BASELINE GEOMETRY CALCULATIONS ---
// 1. Candle Body Breaks (Evaluated separately to prevent short-circuit execution skips)
body_cross_fast_up   = ta.crossover(close, fast_wma)
body_cross_slow_up   = ta.crossover(close, slow_wma)
body_break_up        = body_cross_fast_up or body_cross_slow_up

body_cross_fast_down = ta.crossunder(close, fast_wma)
body_cross_slow_down = ta.crossunder(close, slow_wma)
body_break_down      = body_cross_fast_down or body_cross_slow_down

// 2. Candle Wick Breaks (Evaluated separately to prevent short-circuit execution skips)
wick_cross_fast_up   = ta.crossover(high, fast_wma)
wick_cross_slow_up   = ta.crossover(high, slow_wma)
wick_break_up        = wick_cross_fast_up or wick_cross_slow_up

wick_cross_fast_down = ta.crossunder(low, fast_wma)
wick_cross_slow_down = ta.crossunder(low, slow_wma)
wick_break_down      = wick_cross_fast_down or wick_cross_slow_down

// --- DYNAMIC BASELINE ROUTING LAYER ---
bool trigger_long  = false
bool trigger_short = false

if use_pa_test
    bool has_active_toggle = use_body_trigger or use_wick_trigger
    if has_active_toggle
        // Combined selection handling via OR logic
        trigger_long  := (use_body_trigger and body_break_up) or (use_wick_trigger and wick_break_up)
        trigger_short := (use_body_trigger and body_break_down) or (use_wick_trigger and wick_break_down)
    else
        // Fallback protection: If module is active but choices are blank, revert to original v7.3 body crosses
        trigger_long  := body_break_up
        trigger_short := body_break_down
else
    // Default directly back to baseline execution rules (Original v7.3 Body Breaks)
    trigger_long  := body_break_up
    trigger_short := body_break_down

// Final Synchronized Signal Logic
longCondition  = trigger_long and (close > filter_ma) and macro_bullish and rsi_long_ok
shortCondition = trigger_short and (close < filter_ma) and macro_bearish and rsi_short_ok

// ==========================================
// 3. INDICATOR PANE PLOTS
// ==========================================
// Main RSI Line
rsi_color = rsi_val >= 50 ? #22ab94 : #f23645
plot(rsi_val, title="Locked RSI", color=rsi_color, linewidth=2, offset=wma_offset)

// Midline Reference (50)
hline(50, title="RSI Centerline", color=color.new(color.gray, 100), linestyle=hline.style_dashed)

// Long Zone Threshold Boundaries (Synced directly to Input variables)
p_long_max = hline(rsi_long_max, title="Long Max Threshold", color=color.new(#ffffff, 70), linestyle=hline.style_dotted)
p_long_min = hline(rsi_long_min, title="Long Min Threshold", color=color.new(#22ab94, 0), linestyle=hline.style_solid)
fill(p_long_max, p_long_min, color=show_rsi_bands ? color.new(#22ab94, 85) : na, title="Long Entry Zone")

// Short Zone Threshold Boundaries (Synced directly to Input variables)
p_short_max = hline(rsi_short_max, title="Short Max Threshold", color=color.new(#ee2000, 0), linestyle=hline.style_solid)
p_short_min = hline(rsi_short_min, title="Short Min Threshold", color=color.new(#ffffff, 70), linestyle=hline.style_dotted)
fill(p_short_max, p_short_min, color=show_rsi_bands ? color.new(#f23645, 85) : na, title="Short Entry Zone")

// Buy/Sell Signals Plotted in the Indicator Pane
plotshape(show_labels and longCondition ? rsi_val : na, title="Buy Signal", style=shape.labelup, location=location.absolute, color=#22ab94, text="BUY", textcolor=color.white, size=size.tiny, offset=wma_offset)
plotshape(show_labels and shortCondition ? rsi_val : na, title="Sell Signal", style=shape.labeldown, location=location.absolute, color=#f23645, text="SELL", textcolor=color.white, size=size.tiny, offset=wma_offset)