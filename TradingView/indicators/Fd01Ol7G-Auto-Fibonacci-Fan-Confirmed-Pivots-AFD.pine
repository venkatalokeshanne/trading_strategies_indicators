                        float gradientProjectedPrice = projectedPrice(originPrice, originTime, gradientConstructionPrice, endTime, fanDisplayEndTime)
                        fanGradientLow := na(fanGradientLow) ? gradientProjectedPrice : math.min(fanGradientLow, gradientProjectedPrice)
                        fanGradientHigh := na(fanGradientHigh) ? gradientProjectedPrice : math.max(fanGradientHigh, gradientProjectedPrice)
                        fanGradientLevelCount += 1
            float fanGlowDepth = fanGradientLevelCount > 1 ? gradientDepth(math.abs(fanGradientHigh - fanGradientLow), nz(chartVisualAtr, syminfo.mintick * 2.0)) : 0.35

            for levelIndex = 0 to LEVEL_COUNT - 1
                int lineIndex = lineBaseIndex + levelIndex
                line ray = array.get(fanLines, lineIndex)
                line outerGlowRay = array.get(fanOuterGlowLines, lineIndex)
                line middleGlowRay = array.get(fanMiddleGlowLines, lineIndex)
                bool levelIsVisible = array.get(levelVisible, levelIndex)
                if levelIsVisible
                    float ratio = array.get(levelRatios, levelIndex)
                    float constructionPrice = levelPrice(originPrice, endPrice, ratio)
                    bool infiniteProjection = rayProjectionInput == PROJECTION_INFINITE
                    int rayEndTime = fanDisplayEndTime
                    float rayEndPrice = projectedPrice(originPrice, originTime, constructionPrice, endTime, rayEndTime)
                    color baseLevelColor = colorSchemeInput == SCHEME_CUSTOM ? array.get(customLevelColors, levelIndex) : schemeColor(colorSchemeInput, levelIndex)
                    color rayColor = fadeColor(baseLevelColor, ageOpacity)
                    bool glowVisible = fanFillInput == FILL_GRADIENT and queueHasCurrent and fanIndex == visibleFanCount - 1
                    color outerGlowColor = fadeColor(baseLevelColor, 10.0 * fanGlowDepth)
                    color middleGlowColor = fadeColor(baseLevelColor, 20.0 * fanGlowDepth)

                    if glowVisible
                        if na(outerGlowRay)
                            outerGlowRay := line.new(
                                x1 = originTime,
                                y1 = originPrice,
                                x2 = rayEndTime,
                                y2 = rayEndPrice,
                                xloc = xloc.bar_time,
                                extend = infiniteProjection ? extend.right : extend.none,
                                color = outerGlowColor,
                                style = activeLineStyle,
                                width = lineWidthInput + 4
                            )
                            array.set(fanOuterGlowLines, lineIndex, outerGlowRay)
                        else
                            line.set_xy1(outerGlowRay, originTime, originPrice)
                            line.set_xy2(outerGlowRay, rayEndTime, rayEndPrice)
                            line.set_extend(outerGlowRay, infiniteProjection ? extend.right : extend.none)
                            line.set_color(outerGlowRay, outerGlowColor)
                            line.set_style(outerGlowRay, activeLineStyle)
                            line.set_width(outerGlowRay, lineWidthInput + 4)
                        if na(middleGlowRay)
