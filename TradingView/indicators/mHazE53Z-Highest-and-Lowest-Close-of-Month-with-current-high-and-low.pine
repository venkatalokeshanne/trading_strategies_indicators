//@version=6
indicator("Monthly High/Low Close Rays + Boxes (NY 5PM Daily Close)", overlay=true, max_lines_count=10, max_labels_count=10, max_boxes_count=5)

// Inputs
highColor  = input.color(color.new(color.lime, 0), "Highest Close Color")
lowColor   = input.color(color.new(color.red,  0), "Lowest Close Color")
lineW      = input.int(2, "Line Width", minval = 1, maxval = 5)
lineStyleI = input.string("Solid", "Line Style", options = ["Solid", "Dashed", "Dotted"])
showLabels = input.bool(true, "Show Price Labels")
showBoxes  = input.bool(true, "Show Close-to-Extreme Boxes")
highBoxColor = input.color(color.new(color.lime, 85), "High Box Fill Color")
lowBoxColor  = input.color(color.new(color.red,  85), "Low Box Fill Color")

getStyle(s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

// Pull the underlying Daily close/high/low (NY 5PM close for standard forex feeds)
dailyClose = request.security(syminfo.tickerid, "D", close, lookahead = barmerge.lookahead_off)
dailyHigh  = request.security(syminfo.tickerid, "D", high,  lookahead = barmerge.lookahead_off)
dailyLow   = request.security(syminfo.tickerid, "D", low,   lookahead = barmerge.lookahead_off)

var line  highLine   = na
var line  lowLine    = na
var label highLabel  = na
var label lowLabel   = na
var box   highBox    = na
var box   lowBox     = na

var float monthHigh     = na   // highest DAILY CLOSE this month (5PM NY)
var int   monthHighBar  = na
var float monthLow      = na   // lowest DAILY CLOSE this month (5PM NY)
var int   monthLowBar   = na
var float monthHighPx   = na   // highest PRICE (high) reached this month
var float monthLowPx    = na   // lowest PRICE (low) reached this month
var int   monthStartBar = na

newMonth = ta.change(time("M")) != 0 or barstate.isfirst
newDay   = ta.change(time("D")) != 0

// ─────────────────── Track monthly high/low of NY daily closes ───────────────────
if newMonth
    seed = newDay ? dailyClose[1] : dailyClose
    monthHigh     := seed
    monthHighBar  := bar_index
    monthLow      := seed
    monthLowBar   := bar_index
    monthHighPx   := dailyHigh
    monthLowPx    := dailyLow
    monthStartBar := bar_index
else if newDay
    completedClose = dailyClose[1]
    if completedClose > monthHigh
        monthHigh    := completedClose
        monthHighBar := bar_index[1]
    if completedClose < monthLow
        monthLow    := completedClose
        monthLowBar := bar_index[1]

// Highest/lowest PRICE of the month updates live (intrabar extremes, not "closes")
priceHighUpdated = false
priceLowUpdated  = false
if not newMonth
    if dailyHigh > monthHighPx
        monthHighPx      := dailyHigh
        priceHighUpdated := true
    if dailyLow < monthLowPx
        monthLowPx       := dailyLow
        priceLowUpdated  := true

// ─────────────────── (Re)draw the close rays only when the anchor moves ───────────────────
redrawHigh = newMonth or (monthHighBar == bar_index) or (monthHighBar == bar_index[1] and newDay)
redrawLow  = newMonth or (monthLowBar  == bar_index) or (monthLowBar  == bar_index[1] and newDay)

if redrawHigh
    line.delete(highLine)
    highLine := line.new(monthHighBar, monthHigh, bar_index, monthHigh, extend = extend.right, color = highColor, width = lineW, style = getStyle(lineStyleI))

if redrawLow
    line.delete(lowLine)
    lowLine := line.new(monthLowBar, monthLow, bar_index, monthLow, extend = extend.right, color = lowColor, width = lineW, style = getStyle(lineStyleI))

// ─────────────────── Shaded boxes: close  →  price extreme of month ───────────────────
if showBoxes and (redrawHigh or priceHighUpdated or newMonth)
    box.delete(highBox)
    highBox := box.new(monthStartBar, monthHighPx, bar_index, monthHigh, border_color = na, bgcolor = highBoxColor, extend = extend.right)

if showBoxes and (redrawLow or priceLowUpdated or newMonth)
    box.delete(lowBox)
    lowBox := box.new(monthStartBar, monthLow, bar_index, monthLowPx, border_color = na, bgcolor = lowBoxColor, extend = extend.right)

// ─────────────────── Labels that follow price to the current bar ───────────────────
if showLabels
    label.delete(highLabel)
    label.delete(lowLabel)
    highLabel := label.new(bar_index, monthHigh, "Month High Close: " + str.tostring(monthHigh, format.mintick), style = label.style_label_left, color = color.new(highColor, 80), textcolor = highColor, xloc = xloc.bar_index)
    lowLabel  := label.new(bar_index, monthLow, "Month Low Close: " + str.tostring(monthLow, format.mintick), style = label.style_label_left, color = color.new(lowColor, 80), textcolor = lowColor, xloc = xloc.bar_index)