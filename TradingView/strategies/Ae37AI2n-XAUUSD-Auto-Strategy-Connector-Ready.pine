//@version=5
strategy("XAUUSD Auto Strategy (Connector Ready)", overlay=true)

// === INPUTS ===
riskPercent = input.float(1.0, "Risk % per Trade", step=0.1)
atrSL = input.float(2.0, "SL ATR Multiplier")
atrTP = input.float(4.0, "TP ATR Multiplier")

// === INDICATORS ===
fastEMA = ta.ema(close, 20)
slowEMA = ta.ema(close, 50)
atr = ta.atr(14)

// === CONDITIONS ===
bull = fastEMA > slowEMA
bear = fastEMA < slowEMA

buy = bull and ta.crossover(close, fastEMA)
sell = bear and ta.crossunder(close, fastEMA)

// === SL / TP ===
longSL = close - atr * atrSL
longTP = close + atr * atrTP

shortSL = close + atr * atrSL
shortTP = close - atr * atrTP

// === RISK MANAGEMENT (SAFE VERSION) ===
risk = strategy.equity * (riskPercent / 100)
slDist = atr * atrSL

// Prevent divide-by-zero
lot = slDist > 0 ? risk / slDist : 0.01

// Optional: round lot size
lotRounded = math.round(lot * 100) / 100

// === EXECUTION ===
if (buy)
    strategy.entry("BUY", strategy.long, qty=lotRounded)
    strategy.exit("TP/SL BUY", from_entry="BUY", stop=longSL, limit=longTP)

if (sell)
    strategy.entry("SELL", strategy.short, qty=lotRounded)
    strategy.exit("TP/SL SELL", from_entry="SELL", stop=shortSL, limit=shortTP)

// === ALERT MESSAGES (CRITICAL FOR CONNECTOR) ===
buyMsg = "BUY XAUUSD SL=" + str.tostring(longSL) + " TP=" + str.tostring(longTP) + " LOT=" + str.tostring(lotRounded)
sellMsg = "SELL XAUUSD SL=" + str.tostring(shortSL) + " TP=" + str.tostring(shortTP) + " LOT=" + str.tostring(lotRounded)

// === ALERT TRIGGERS (FIXED) ===
if (buy)
    alert(buyMsg, alert.freq_once_per_bar_close)

if (sell)
    alert(sellMsg, alert.freq_once_per_bar_close)

// === VISUALS ===
plot(fastEMA, color=color.green, title="Fast EMA")
plot(slowEMA, color=color.red, title="Slow EMA")