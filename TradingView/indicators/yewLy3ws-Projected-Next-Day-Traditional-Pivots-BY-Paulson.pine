
//@version=6
indicator(
     "Projected Next-Day Traditional Pivots",
     shorttitle = "Projpivots",
     overlay = true,
     max_lines_count = 100,
     max_labels_count = 100
     )

// ============================================================================
// INPUTS
// ============================================================================

groupDisplay = "Display"

showPivot  = input.bool(true, "Show Pivot (P)", group = groupDisplay)
showR1S1   = input.bool(true, "Show R1 / S1", group = groupDisplay)
showR2S2   = input.bool(true, "Show R2 / S2", group = groupDisplay)
showR3S3   = input.bool(true, "Show R3 / S3", group = groupDisplay)
showLabels = input.bool(true, "Show Labels", group = groupDisplay)

lineWidth = input.int(
     2,
     "Line Width",
     minval = 1,
     maxval = 5,
     group = groupDisplay
     )

// ============================================================================
// CURRENT DEVELOPING DAILY HIGH / LOW / CLOSE
// ============================================================================

bool newDay = timeframe.change("D")

var float todayHigh = na
var float todayLow  = na

if newDay or na(todayHigh)
    todayHigh := high
    todayLow  := low
else
    todayHigh := math.max(todayHigh, high)
    todayLow  := math.min(todayLow, low)

// The current price acts as the projected daily close.
float todayClose = close

// ============================================================================
// PROJECTED TRADITIONAL PIVOTS FOR TOMORROW
// ============================================================================

float P = (todayHigh + todayLow + todayClose) / 3.0

float R1 = 2.0 * P - todayLow
float S1 = 2.0 * P - todayHigh

float R2 = P + (todayHigh - todayLow)
float S2 = P - (todayHigh - todayLow)

float R3 = todayHigh + 2.0 * (P - todayLow)
float S3 = todayLow - 2.0 * (todayHigh - P)

// ============================================================================
// TOMORROW'S TIME WINDOW
// ============================================================================

// Opening timestamp of today's daily candle.
int todayStart = time("D")

// Closing timestamp of today's daily candle.
// This is also the beginning of the next daily period.
int tomorrowStart = time_close("D")

// Calculate approximate duration of the current daily period.
int dayDuration = tomorrowStart - todayStart

// End of tomorrow's projected daily period.
int tomorrowEnd = tomorrowStart + dayDuration

// ============================================================================
// LINE OBJECTS
// ============================================================================

var line lineR3 = na
var line lineR2 = na
var line lineR1 = na
var line lineP  = na
var line lineS1 = na
var line lineS2 = na
var line lineS3 = na

// ============================================================================
// LABEL OBJECTS
// ============================================================================

var label labelR3 = na
var label labelR2 = na
var label labelR1 = na
var label labelP  = na
var label labelS1 = na
var label labelS2 = na
var label labelS3 = na

// ============================================================================
// DRAW / UPDATE PROJECTED LINES
// ============================================================================

if barstate.islast

    // ------------------------------------------------------------------------
    // R3
    // ------------------------------------------------------------------------

    if showR3S3
        if na(lineR3)
            lineR3 := line.new(
                 x1 = tomorrowStart,
                 y1 = R3,
                 x2 = tomorrowEnd,
                 y2 = R3,
                 xloc = xloc.bar_time,
                 color = color.red,
                 width = lineWidth
                 )
        else
            line.set_xy1(lineR3, tomorrowStart, R3)
            line.set_xy2(lineR3, tomorrowEnd, R3)
            line.set_width(lineR3, lineWidth)
            line.set_color(lineR3, color.red)
    else
        line.delete(lineR3)
        lineR3 := na

    // ------------------------------------------------------------------------
    // R2
    // ------------------------------------------------------------------------

    if showR2S2
        if na(lineR2)
            lineR2 := line.new(
                 x1 = tomorrowStart,
                 y1 = R2,
                 x2 = tomorrowEnd,
                 y2 = R2,
                 xloc = xloc.bar_time,
                 color = color.new(color.red, 15),
                 width = lineWidth
                 )
        else
            line.set_xy1(lineR2, tomorrowStart, R2)
            line.set_xy2(lineR2, tomorrowEnd, R2)
            line.set_width(lineR2, lineWidth)
            line.set_color(lineR2, color.new(color.red, 15))
    else
        line.delete(lineR2)
        lineR2 := na

    // ------------------------------------------------------------------------
    // R1
    // ------------------------------------------------------------------------

    if showR1S1
        if na(lineR1)
            lineR1 := line.new(
                 x1 = tomorrowStart,
                 y1 = R1,
                 x2 = tomorrowEnd,
                 y2 = R1,
                 xloc = xloc.bar_time,
                 color = color.new(color.red, 30),
                 width = lineWidth
                 )
        else
            line.set_xy1(lineR1, tomorrowStart, R1)
            line.set_xy2(lineR1, tomorrowEnd, R1)
            line.set_width(lineR1, lineWidth)
            line.set_color(lineR1, color.new(color.red, 30))
    else
        line.delete(lineR1)
        lineR1 := na

    // ------------------------------------------------------------------------
    // PIVOT
    // ------------------------------------------------------------------------

    if showPivot
        if na(lineP)
            lineP := line.new(
                 x1 = tomorrowStart,
                 y1 = P,
                 x2 = tomorrowEnd,
                 y2 = P,
                 xloc = xloc.bar_time,
                 color = color.orange,
                 width = lineWidth
                 )
        else
            line.set_xy1(lineP, tomorrowStart, P)
            line.set_xy2(lineP, tomorrowEnd, P)
            line.set_width(lineP, lineWidth)
            line.set_color(lineP, color.orange)
    else
        line.delete(lineP)
        lineP := na

    // ------------------------------------------------------------------------
    // S1
    // ------------------------------------------------------------------------

    if showR1S1
        if na(lineS1)
            lineS1 := line.new(
                 x1 = tomorrowStart,
                 y1 = S1,
                 x2 = tomorrowEnd,
                 y2 = S1,
                 xloc = xloc.bar_time,
                 color = color.new(color.lime, 30),
                 width = lineWidth
                 )
        else
            line.set_xy1(lineS1, tomorrowStart, S1)
            line.set_xy2(lineS1, tomorrowEnd, S1)
            line.set_width(lineS1, lineWidth)
            line.set_color(lineS1, color.new(color.lime, 30))
    else
        line.delete(lineS1)
        lineS1 := na

    // ------------------------------------------------------------------------
    // S2
    // ------------------------------------------------------------------------

    if showR2S2
        if na(lineS2)
            lineS2 := line.new(
                 x1 = tomorrowStart,
                 y1 = S2,
                 x2 = tomorrowEnd,
                 y2 = S2,
                 xloc = xloc.bar_time,
                 color = color.new(color.lime, 15),
                 width = lineWidth
                 )
        else
            line.set_xy1(lineS2, tomorrowStart, S2)
            line.set_xy2(lineS2, tomorrowEnd, S2)
            line.set_width(lineS2, lineWidth)
            line.set_color(lineS2, color.new(color.lime, 15))
    else
        line.delete(lineS2)
        lineS2 := na

    // ------------------------------------------------------------------------
    // S3
    // ------------------------------------------------------------------------

    if showR3S3
        if na(lineS3)
            lineS3 := line.new(
                 x1 = tomorrowStart,
                 y1 = S3,
                 x2 = tomorrowEnd,
                 y2 = S3,
                 xloc = xloc.bar_time,
                 color = color.lime,
                 width = lineWidth
                 )
        else
            line.set_xy1(lineS3, tomorrowStart, S3)
            line.set_xy2(lineS3, tomorrowEnd, S3)
            line.set_width(lineS3, lineWidth)
            line.set_color(lineS3, color.lime)
    else
        line.delete(lineS3)
        lineS3 := na

    // ========================================================================
    // LABELS
    // ========================================================================

    label.delete(labelR3)
    label.delete(labelR2)
    label.delete(labelR1)
    label.delete(labelP)
    label.delete(labelS1)
    label.delete(labelS2)
    label.delete(labelS3)

    labelR3 := na
    labelR2 := na
    labelR1 := na
    labelP  := na
    labelS1 := na
    labelS2 := na
    labelS3 := na

    if showLabels

        if showR3S3
            labelR3 := label.new(
                 x = tomorrowStart,
                 y = R3,
                 text = "R3",
                 xloc = xloc.bar_time,
                 style = label.style_label_right,
                 color = color.red,
                 textcolor = color.white,
                 size = size.small
                 )

        if showR2S2
            labelR2 := label.new(
                 x = tomorrowStart,
                 y = R2,
                 text = "R2",
                 xloc = xloc.bar_time,
                 style = label.style_label_right,
                 color = color.red,
                 textcolor = color.white,
                 size = size.small
                 )

        if showR1S1
            labelR1 := label.new(
                 x = tomorrowStart,
                 y = R1,
                 text = "R1",
                 xloc = xloc.bar_time,
                 style = label.style_label_right,
                 color = color.red,
                 textcolor = color.white,
                 size = size.small
                 )

        if showPivot
            labelP := label.new(
                 x = tomorrowStart,
                 y = P,
                 text = "P",
                 xloc = xloc.bar_time,
                 style = label.style_label_right,
                 color = color.orange,
                 textcolor = color.white,
                 size = size.small
                 )

        if showR1S1
            labelS1 := label.new(
                 x = tomorrowStart,
                 y = S1,
                 text = "S1",
                 xloc = xloc.bar_time,
                 style = label.style_label_right,
                 color = color.green,
                 textcolor = color.white,
                 size = size.small
                 )

        if showR2S2
            labelS2 := label.new(
                 x = tomorrowStart,
                 y = S2,
                 text = "S2",
                 xloc = xloc.bar_time,
                 style = label.style_label_right,
                 color = color.green,
                 textcolor = color.white,
                 size = size.small
                 )

        if showR3S3
            labelS3 := label.new(
                 x = tomorrowStart,
                 y = S3,
                 text = "S3",
                 xloc = xloc.bar_time,
                 style = label.style_label_right,
                 color = color.green,
                 textcolor = color.white,
                 size = size.small
                 )

// ============================================================================
// DATA WINDOW
// ============================================================================

plot(todayHigh,  "Today's Developing High", display = display.data_window)
plot(todayLow,   "Today's Developing Low", display = display.data_window)
plot(todayClose, "Today's Developing Close", display = display.data_window)

plot(P,  "Projected P",  display = display.data_window)
plot(R1, "Projected R1", display = display.data_window)
plot(R2, "Projected R2", display = display.data_window)
plot(R3, "Projected R3", display = display.data_window)
plot(S1, "Projected S1", display = display.data_window)
plot(S2, "Projected S2", display = display.data_window)
plot(S3, "Projected S3", display = display.data_window)