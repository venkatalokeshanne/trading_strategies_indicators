//@version=6
indicator("1H / 4H Liquidity Levels", overlay=true, max_lines_count=500)

// =====================================================
// INPUTS
// =====================================================

pivotLen = input.int(3, "Swing Strength", minval=1)
maxLevels = input.int(300, "Max Stored Levels", minval=25, maxval=450)

show1H = input.bool(true, "Show 1H Levels")
show4H = input.bool(true, "Show 4H Levels")

h1HighColor = input.color(color.red, "1H High Color")
h1LowColor = input.color(color.green, "1H Low Color")
h4HighColor = input.color(color.orange, "4H High Color")
h4LowColor = input.color(color.blue, "4H Low Color")

h1Width = input.int(1, "1H Line Width", minval=1, maxval=5)
h4Width = input.int(2, "4H Line Width", minval=1, maxval=5)

deleteDelayMinutes = input.int(10, "Minutes After Sweep Before Delete", minval=1)

hideTodaysPremarketLevels = input.bool(true, "Hide Today's Premarket Liquidity")
premarketSession = input.session("0400-0930", "Premarket Session")

mergeNearbyLevels = input.bool(true, "Merge 1H Levels Near 4H")
mergeDistanceTicks = input.int(10, "Merge Distance In Ticks", minval=1)
mergeDistance = mergeDistanceTicks * syminfo.mintick

showPriceAxisLevels = input.bool(true, "Show Liquidity Prices On Price Axis")
priceTagColor = input.color(color.aqua, "Liquidity Price Tag Color")

// =====================================================
// ARRAYS
// =====================================================

var line[] lines = array.new_line()
var float[] prices = array.new_float()
var int[] sides = array.new_int()
var int[] sweptTimes = array.new_int()
var string[] tfs = array.new_string()
var color[] baseColors = array.new_color()
var bool[] madeInPremarket = array.new_bool()
var int[] madeDay = array.new_int()
var int[] pivotTimes = array.new_int()

var float[] axisPrices = array.new_float(30, na)

// =====================================================
// DAY KEY
// =====================================================

f_dayKey(_time) =>
    year(_time) * 10000 + month(_time) * 100 + dayofmonth(_time)

todayKey = f_dayKey(time)

// =====================================================
// HIGHER TIMEFRAME PIVOT DATA
// =====================================================

f_pivotHighData() =>
    pivotPrice = ta.pivothigh(high, pivotLen, pivotLen)
    pivotTime = not na(pivotPrice) ? time[pivotLen] : na
    pivotDay = not na(pivotPrice) ? f_dayKey(pivotTime) : na
    pivotPremarket = not na(pivotPrice) and not na(time(timeframe.period, premarketSession)[pivotLen])
    [pivotPrice, pivotTime, pivotDay, pivotPremarket]

f_pivotLowData() =>
    pivotPrice = ta.pivotlow(low, pivotLen, pivotLen)
    pivotTime = not na(pivotPrice) ? time[pivotLen] : na
    pivotDay = not na(pivotPrice) ? f_dayKey(pivotTime) : na
    pivotPremarket = not na(pivotPrice) and not na(time(timeframe.period, premarketSession)[pivotLen])
    [pivotPrice, pivotTime, pivotDay, pivotPremarket]

// =====================================================
// ADD LIQUIDITY LEVEL
// =====================================================

f_addLevel(_price, _pivotTime, _color, _width, _side, _tf, _isPremarket, _day) =>
    hideLine = hideTodaysPremarketLevels and _isPremarket and _day == todayKey
    drawColor = hideLine ? color.new(_color, 100) : _color

    newLine = line.new(
         x1=_pivotTime,
         y1=_price,
         x2=_pivotTime + 60000,
         y2=_price,
         xloc=xloc.bar_time,
         extend=extend.right,
         color=drawColor,
         width=_width)

    array.push(lines, newLine)
    array.push(prices, _price)
    array.push(sides, _side)
    array.push(sweptTimes, na)
    array.push(tfs, _tf)
    array.push(baseColors, _color)
    array.push(madeInPremarket, _isPremarket)
    array.push(madeDay, _day)
    array.push(pivotTimes, _pivotTime)

    if array.size(lines) > maxLevels
        oldLine = array.shift(lines)
        line.delete(oldLine)

        array.shift(prices)
        array.shift(sides)
        array.shift(sweptTimes)
        array.shift(tfs)
        array.shift(baseColors)
        array.shift(madeInPremarket)
        array.shift(madeDay)
        array.shift(pivotTimes)

// =====================================================
// CHECK IF 1H LEVEL IS NEAR EXISTING 4H LEVEL
// =====================================================

f_near4H(_price) =>
    near = false

    if array.size(prices) > 0
        for i = 0 to array.size(prices) - 1
            existingPrice = array.get(prices, i)
            existingTf = array.get(tfs, i)

            if existingTf == "4H" and math.abs(existingPrice - _price) <= mergeDistance
                near := true

    near

// =====================================================
// REQUEST 1H DATA
// =====================================================

[h1High, h1HighTime, h1HighDay, h1HighPM] = request.security(
     syminfo.tickerid,
     "60",
     f_pivotHighData(),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

[h1Low, h1LowTime, h1LowDay, h1LowPM] = request.security(
     syminfo.tickerid,
     "60",
     f_pivotLowData(),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

// =====================================================
// REQUEST 4H DATA
// =====================================================

[h4High, h4HighTime, h4HighDay, h4HighPM] = request.security(
     syminfo.tickerid,
     "240",
     f_pivotHighData(),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

[h4Low, h4LowTime, h4LowDay, h4LowPM] = request.security(
     syminfo.tickerid,
     "240",
     f_pivotLowData(),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

// =====================================================
// DETECT NEW PIVOTS
// =====================================================

newH4High = show4H and not na(h4HighTime) and (na(h4HighTime[1]) or h4HighTime != h4HighTime[1])
newH4Low = show4H and not na(h4LowTime) and (na(h4LowTime[1]) or h4LowTime != h4LowTime[1])

newH1High = show1H and not na(h1HighTime) and (na(h1HighTime[1]) or h1HighTime != h1HighTime[1])
newH1Low = show1H and not na(h1LowTime) and (na(h1LowTime[1]) or h1LowTime != h1LowTime[1])

// =====================================================
// ADD 4H LEVELS FIRST
// =====================================================

if newH4High
    f_addLevel(h4High, h4HighTime, h4HighColor, h4Width, 1, "4H", h4HighPM, h4HighDay)

if newH4Low
    f_addLevel(h4Low, h4LowTime, h4LowColor, h4Width, -1, "4H", h4LowPM, h4LowDay)

// =====================================================
// ADD 1H LEVELS
// =====================================================

if newH1High
    shouldMerge = mergeNearbyLevels and f_near4H(h1High)

    if not shouldMerge
        f_addLevel(h1High, h1HighTime, h1HighColor, h1Width, 1, "1H", h1HighPM, h1HighDay)

if newH1Low
    shouldMerge = mergeNearbyLevels and f_near4H(h1Low)

    if not shouldMerge
        f_addLevel(h1Low, h1LowTime, h1LowColor, h1Width, -1, "1H", h1LowPM, h1LowDay)

// =====================================================
// UPDATE PREMARKET VISIBILITY
// =====================================================

if array.size(lines) > 0
    for i = 0 to array.size(lines) - 1
        currentLine = array.get(lines, i)
        currentColor = array.get(baseColors, i)
        isPremarket = array.get(madeInPremarket, i)
        dayCreated = array.get(madeDay, i)

        hideLine = hideTodaysPremarketLevels and isPremarket and dayCreated == todayKey

        line.set_color(currentLine, hideLine ? color.new(currentColor, 100) : currentColor)

// =====================================================
// SWEEP / DELETE LOGIC
// =====================================================

delayMilliseconds = deleteDelayMinutes * 60 * 1000

if array.size(lines) > 0
    for i = array.size(lines) - 1 to 0
        levelPrice = array.get(prices, i)
        levelSide = array.get(sides, i)
        sweptTime = array.get(sweptTimes, i)

        swept = levelSide == 1 ? high >= levelPrice : low <= levelPrice

        if swept and na(sweptTime)
            array.set(sweptTimes, i, time)

        updatedSweptTime = array.get(sweptTimes, i)

        if not na(updatedSweptTime) and time >= updatedSweptTime + delayMilliseconds
            currentLine = array.get(lines, i)
            line.delete(currentLine)

            array.remove(lines, i)
            array.remove(prices, i)
            array.remove(sides, i)
            array.remove(sweptTimes, i)
            array.remove(tfs, i)
            array.remove(baseColors, i)
            array.remove(madeInPremarket, i)
            array.remove(madeDay, i)
            array.remove(pivotTimes, i)

// =====================================================
// RESET PRICE AXIS SLOTS
// =====================================================

for slot = 0 to 29
    array.set(axisPrices, slot, na)

// =====================================================
// FIND ACTIVE LEVELS ON CURRENT BAR
// =====================================================

if barstate.islast and showPriceAxisLevels
    candidatePrices = array.new_float()
    candidateDistances = array.new_float()

    if array.size(prices) > 0
        for i = 0 to array.size(prices) - 1
            levelPrice = array.get(prices, i)
            levelSweptTime = array.get(sweptTimes, i)

            isPremarket = array.get(madeInPremarket, i)
            dayCreated = array.get(madeDay, i)

            hideLevel = hideTodaysPremarketLevels and isPremarket and dayCreated == todayKey
            activeLevel = na(levelSweptTime)

            if activeLevel and not hideLevel
                duplicatePrice = false

                if array.size(candidatePrices) > 0
                    for j = 0 to array.size(candidatePrices) - 1
                        existingCandidate = array.get(candidatePrices, j)

                        if math.abs(existingCandidate - levelPrice) <= syminfo.mintick * 0.5
                            duplicatePrice := true

                if not duplicatePrice
                    distanceFromPrice = math.abs(levelPrice - close)

                    array.push(candidatePrices, levelPrice)
                    array.push(candidateDistances, distanceFromPrice)

    if array.size(candidatePrices) > 0
        sortedIndices = array.sort_indices(candidateDistances, order.ascending)
        numberToShow = math.min(30, array.size(sortedIndices))

        if numberToShow > 0
            for slot = 0 to numberToShow - 1
                candidateIndex = array.get(sortedIndices, slot)
                selectedPrice = array.get(candidatePrices, candidateIndex)
                array.set(axisPrices, slot, selectedPrice)

// =====================================================
// 30 NATIVE PRICE AXIS MARKERS
// Editable color
// =====================================================

plot(array.get(axisPrices, 0), "Liquidity 01", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 1), "Liquidity 02", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 2), "Liquidity 03", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 3), "Liquidity 04", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 4), "Liquidity 05", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 5), "Liquidity 06", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 6), "Liquidity 07", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 7), "Liquidity 08", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 8), "Liquidity 09", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 9), "Liquidity 10", color=priceTagColor, display=display.price_scale, show_last=1)

plot(array.get(axisPrices, 10), "Liquidity 11", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 11), "Liquidity 12", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 12), "Liquidity 13", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 13), "Liquidity 14", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 14), "Liquidity 15", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 15), "Liquidity 16", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 16), "Liquidity 17", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 17), "Liquidity 18", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 18), "Liquidity 19", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 19), "Liquidity 20", color=priceTagColor, display=display.price_scale, show_last=1)

plot(array.get(axisPrices, 20), "Liquidity 21", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 21), "Liquidity 22", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 22), "Liquidity 23", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 23), "Liquidity 24", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 24), "Liquidity 25", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 25), "Liquidity 26", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 26), "Liquidity 27", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 27), "Liquidity 28", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 28), "Liquidity 29", color=priceTagColor, display=display.price_scale, show_last=1)
plot(array.get(axisPrices, 29), "Liquidity 30", color=priceTagColor, display=display.price_scale, show_last=1)