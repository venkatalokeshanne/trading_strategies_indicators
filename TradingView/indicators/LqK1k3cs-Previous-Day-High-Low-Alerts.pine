//@version=6
indicator("Previous Day RTH High Low + Alerts", overlay=true, max_lines_count=500)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CONFIGURACIÓN
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

string TZ = "America/New_York"

// Display
showHistorical = input.bool(true, "Show Historical Lines", group="Display")

// Previous Day High
highColor = input.color(color.yellow, "High Color", group="Previous Day High")
highWidth = input.int(1, "High Width", minval=1, maxval=5, group="Previous Day High")
highStyleInput = input.string(
     "Dotted",
     "High Style",
     options=["Solid", "Dashed", "Dotted"],
     group="Previous Day High"
)

// Previous Day Low
lowColor = input.color(color.yellow, "Low Color", group="Previous Day Low")
lowWidth = input.int(1, "Low Width", minval=1, maxval=5, group="Previous Day Low")
lowStyleInput = input.string(
     "Dotted",
     "Low Style",
     options=["Solid", "Dashed", "Dotted"],
     group="Previous Day Low"
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ESTILOS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

highStyle = highStyleInput == "Dashed" ? line.style_dashed :
     highStyleInput == "Dotted" ? line.style_dotted :
     line.style_solid

lowStyle = lowStyleInput == "Dashed" ? line.style_dashed :
     lowStyleInput == "Dotted" ? line.style_dotted :
     line.style_solid

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RTH
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

int h = hour(time, TZ)
int m = minute(time, TZ)

bool inRTH = (h > 9 or (h == 9 and m >= 30)) and h < 16

// Primera vela después de las 4:00 PM
bool rthEnded = not inRTH and inRTH[1]

// Comienzo del RTH
bool rthStarted = inRTH and not inRTH[1]

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// VARIABLES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var float currentRTHHigh = na
var float currentRTHLow = na

var float previousRTHHigh = na
var float previousRTHLow = na

// Líneas actuales
var line currentHighLine = na
var line currentLowLine = na

// Arrays para líneas históricas
var array<line> historicalHighLines = array.new_line()
var array<line> historicalLowLines = array.new_line()

// Control de alertas
var bool highTouched = false
var bool lowTouched = false

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// COMIENZO DEL RTH
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if rthStarted
    currentRTHHigh := high
    currentRTHLow := low

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ACUMULAR HIGH / LOW DEL RTH
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if inRTH
    currentRTHHigh := na(currentRTHHigh) ? high : math.max(currentRTHHigh, high)
    currentRTHLow := na(currentRTHLow) ? low : math.min(currentRTHLow, low)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 4:00 PM — ACTUALIZAR NIVELES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if rthEnded

    // Guardar el RTH que acaba de terminar
    previousRTHHigh := currentRTHHigh
    previousRTHLow := currentRTHLow

    //━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // CONVERTIR LAS LÍNEAS ACTUALES
    // EN LÍNEAS HISTÓRICAS
    //━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    if not na(currentHighLine)
        line.set_extend(currentHighLine, extend.none)
        line.set_x2(currentHighLine, bar_index)

        array.push(historicalHighLines, currentHighLine)

    if not na(currentLowLine)
        line.set_extend(currentLowLine, extend.none)
        line.set_x2(currentLowLine, bar_index)

        array.push(historicalLowLines, currentLowLine)

    //━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // CREAR NUEVAS LÍNEAS ACTIVAS
    //━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    if not na(previousRTHHigh)
        currentHighLine := line.new(
             x1=bar_index,
             y1=previousRTHHigh,
             x2=bar_index + 1,
             y2=previousRTHHigh,
             xloc=xloc.bar_index,
             extend=extend.right,
             color=highColor,
             width=highWidth,
             style=highStyle
        )

    if not na(previousRTHLow)
        currentLowLine := line.new(
             x1=bar_index,
             y1=previousRTHLow,
             x2=bar_index + 1,
             y2=previousRTHLow,
             xloc=xloc.bar_index,
             extend=extend.right,
             color=lowColor,
             width=lowWidth,
             style=lowStyle
        )

    // Reiniciar alertas
    highTouched := false
    lowTouched := false

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MOSTRAR / OCULTAR LÍNEAS HISTÓRICAS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if array.size(historicalHighLines) > 0
    for i = 0 to array.size(historicalHighLines) - 1
        line historicalLine = array.get(historicalHighLines, i)
        line.set_color(
             historicalLine,
             showHistorical ? highColor : color.new(highColor, 100)
        )

if array.size(historicalLowLines) > 0
    for i = 0 to array.size(historicalLowLines) - 1
        line historicalLine = array.get(historicalLowLines, i)
        line.set_color(
             historicalLine,
             showHistorical ? lowColor : color.new(lowColor, 100)
        )

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ALERTAS — SOLO NIVELES ACTIVOS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bool highTouch = not na(previousRTHHigh) and high >= previousRTHHigh
bool lowTouch = not na(previousRTHLow) and low <= previousRTHLow

bool highAlert = highTouch and not highTouched
bool lowAlert = lowTouch and not lowTouched

if highTouch
    highTouched := true
else
    highTouched := false

if lowTouch
    lowTouched := true
else
    lowTouched := false

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ALERT CONDITIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

alertcondition(
     highAlert,
     title="Previous Day High",
     message="🔴 PREVIOUS DAY HIGH — {{ticker}} — Price: {{close}}"
)

alertcondition(
     lowAlert,
     title="Previous Day Low",
     message="🟢 PREVIOUS DAY LOW — {{ticker}} — Price: {{close}}"
)