length = input.int(7, minval = 2, group = gEntry1)
smoType1 = input.string('TMA', 'Method', options = ['EMA', 'SMA', 'RMA', 'TMA'], group = gEntry1)
src = input(close, 'Source', group = gEntry1)

smooth = input.int(2, minval = 1, group = gEntry2)
