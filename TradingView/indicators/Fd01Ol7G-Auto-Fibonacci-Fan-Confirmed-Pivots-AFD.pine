                    activeState := STATE_HELD

        bool originBroken = (activeState == STATE_ACTIVE or activeState == STATE_HELD) and (
            (activeDirection == 1 and close < activeOriginPrice) or
            (activeDirection == -1 and close > activeOriginPrice)
        )
        if originBroken
            invalidatedEventAtTime := time
            activeOriginPrice := na
            activeOriginTime := na
            activeEndPrice := na
            activeEndTime := na
