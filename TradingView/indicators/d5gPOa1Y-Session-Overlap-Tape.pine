//@version=6
indicator("Session Overlap Tape", overlay=false, shorttitle="Sessions")

// ========================================================================= //
// SESSION TIMINGS (UTC)
// ========================================================================= //
// Asia: 23:00 to 08:00 UTC
// London: 07:00 to 16:00 UTC
// New York: 12:00 to 21:00 UTC

in_asia = not na(time(timeframe.period, "2300-0800", "UTC")) ? 3 : na
in_lon  = not na(time(timeframe.period, "0700-1600", "UTC")) ? 2 : na
in_ny   = not na(time(timeframe.period, "1200-2100", "UTC")) ? 1 : na

// ========================================================================= //
// TAPE PLOTTING
// ========================================================================= //
// Plots horizontal lines at distinct Y-axis levels. 
// When they overlap in time, they stack perfectly on top of each other.

plot(in_asia, title="Asia Session",   color=color.new(color.yellow, 0), style=plot.style_linebr, linewidth=6)
plot(in_lon,  title="London Session", color=color.new(color.blue, 0),   style=plot.style_linebr, linewidth=6)
plot(in_ny,   title="NY Session",     color=color.new(color.red, 0),    style=plot.style_linebr, linewidth=6)

// Set strict pane boundaries to keep it looking like a thin 2mm tape
hline(0, color=color.new(color.black, 100))
hline(4, color=color.new(color.black, 100))