//@version=6
indicator('Options Spread Visualizer', overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ============================================
// STRATEGY SELECTION
// ============================================

strategyType = input.string('Iron Condor', 'Strategy Type', options = ['Iron Condor', 'Butterfly Spread', 'Short Credit Spread', 'Long Debit Spread'], group = '🎯 STRATEGY')

verticalSide = input.string('Put', 'Vertical Spread Type', options = ['Put', 'Call'], group = '🎯 STRATEGY', tooltip = 'SHORT CREDIT:\nPut = Bull Put Credit Spread\nCall = Bear Call Credit Spread\n\nLONG DEBIT:\nPut = Bear Put Debit Spread\nCall = Bull Call Debit Spread')

// ============================================
// QUICK PASTE
// ============================================

pasteData = input.string('626,628,620,618,1.20,1,30', '📋 📋 📋 PASTE YOUR TRADE DATA HERE 📋 📋 📋', group = '🎯 QUICK PASTE', tooltip = 'IRON CONDOR:\nShortCall,LongCall,ShortPut,LongPut,Credit,Contracts,Target%\nExample: 626,628,620,618,1.20,1,30\n\nBUTTERFLY:\nLowerWing,Body,UpperWing,Debit,Contracts,Target%\nExample: 600,620,640,2.50,2,50\n\nSHORT CREDIT:\nShortStrike,LongStrike,Credit,Contracts,Target%\nExample: 620,615,1.50,1,50\n\nLONG DEBIT:\nLongStrike,ShortStrike,Debit,Contracts,Target%\nExample: 620,625,2.50,1,50')

// ============================================
// VISUAL SETTINGS
// ============================================

showProfitZone = input.bool(true, 'Show Max Profit Zone', group = 'Visuals')
showBreakevens = input.bool(true, 'Show Breakeven Lines', group = 'Visuals')
showAdjustmentZones = input.bool(true, 'Show Adjustment Warning Zones', group = 'Visuals')
showTimeDecay = input.bool(false, 'Show Time Decay Progress', group = 'Visuals')
showInfoBox = input.bool(false, 'Show Info Box', group = 'Visuals')
showStrikeLabels = input.bool(true, 'Show Strike Labels', group = 'Visuals')

// ============================================
// RISK MANAGEMENT
// ============================================

stopLossPercent = input.float(50, 'Stop Loss (% of Max Loss)', minval = 0, maxval = 100, group = 'Risk Management')
adjustmentThreshold = input.float(50, 'Adjustment Alert (% to Strike)', minval = 0, maxval = 100, group = 'Risk Management')

// ============================================
// POSITION SIZING
// ============================================

accountSize = input.float(10000, 'Account Size ($)', minval = 100, group = 'Position Sizing')
riskPerTrade = input.float(2, 'Risk Per Trade (%)', minval = 0.1, maxval = 10, group = 'Position Sizing')
maxPositionSize = input.int(10, 'Max Contracts', minval = 1, group = 'Position Sizing')

// ============================================
// MARKET CONDITIONS
// ============================================

ivRank = input.float(50, 'IV Rank (0-100)', minval = 0, maxval = 100, group = 'Market Conditions')
currentIV = input.float(20, 'Current IV (%)', minval = 0, group = 'Market Conditions')
daysToExp = input.int(0, 'Days to Expiration (0 = today)', minval = 0, group = 'Market Conditions')

// ============================================
// STRATEGY FLAGS
// ============================================

isCondor = strategyType == 'Iron Condor'
isButterfly = strategyType == 'Butterfly Spread'
isShortCredit = strategyType == 'Short Credit Spread'
isLongDebit = strategyType == 'Long Debit Spread'
isVertical = isShortCredit or isLongDebit

isPutVertical = verticalSide == 'Put'
isCallVertical = verticalSide == 'Call'

// ============================================
// VARIABLES
// ============================================

float shortCallStrike = na
float longCallStrike = na
float shortPutStrike = na
float longPutStrike = na

float lowerWing = na
float bodyStrike = na
float upperWing = na

float verticalShortStrike = na
float verticalLongStrike = na

float netCredit = 0.0
float netDebit = 0.0

int contractSize = 1
float profitTarget = 30.0

// ============================================
// PARSE QUICK-PASTE DATA
// ============================================

if str.length(pasteData) > 0

    parts = str.split(pasteData, ',')

    if isButterfly and array.size(parts) >= 6

        lowerWing := str.tonumber(array.get(parts, 0))
        bodyStrike := str.tonumber(array.get(parts, 1))
        upperWing := str.tonumber(array.get(parts, 2))
        netDebit := str.tonumber(array.get(parts, 3))
        contractSize := int(str.tonumber(array.get(parts, 4)))
        profitTarget := str.tonumber(array.get(parts, 5))

        longPutStrike := lowerWing
        shortPutStrike := bodyStrike
        shortCallStrike := bodyStrike
        longCallStrike := upperWing
        longCallStrike

    else if isCondor and array.size(parts) >= 7

        shortCallStrike := str.tonumber(array.get(parts, 0))
        longCallStrike := str.tonumber(array.get(parts, 1))
        shortPutStrike := str.tonumber(array.get(parts, 2))
        longPutStrike := str.tonumber(array.get(parts, 3))
        netCredit := str.tonumber(array.get(parts, 4))
        contractSize := int(str.tonumber(array.get(parts, 5)))
        profitTarget := str.tonumber(array.get(parts, 6))
        profitTarget

    else if isShortCredit and array.size(parts) >= 5

        verticalShortStrike := str.tonumber(array.get(parts, 0))
        verticalLongStrike := str.tonumber(array.get(parts, 1))
        netCredit := str.tonumber(array.get(parts, 2))
        contractSize := int(str.tonumber(array.get(parts, 3)))
        profitTarget := str.tonumber(array.get(parts, 4))

        if isPutVertical
            shortPutStrike := verticalShortStrike
            longPutStrike := verticalLongStrike
            longPutStrike

        if isCallVertical
            shortCallStrike := verticalShortStrike
            longCallStrike := verticalLongStrike
            longCallStrike

    else if isLongDebit and array.size(parts) >= 5

        verticalLongStrike := str.tonumber(array.get(parts, 0))
        verticalShortStrike := str.tonumber(array.get(parts, 1))
        netDebit := str.tonumber(array.get(parts, 2))
        contractSize := int(str.tonumber(array.get(parts, 3)))
        profitTarget := str.tonumber(array.get(parts, 4))

        if isPutVertical
            longPutStrike := verticalLongStrike
            shortPutStrike := verticalShortStrike
            shortPutStrike

        if isCallVertical
            longCallStrike := verticalLongStrike
            shortCallStrike := verticalShortStrike
            shortCallStrike

// ============================================
// CALCULATIONS
// ============================================

currentPrice = close

float maxProfit = 0.0
float maxLoss = 0.0

float upperBreakeven = na
float lowerBreakeven = na
float verticalBreakeven = na
float spreadWidth = na

// ============================================
// IRON CONDOR
// ============================================

if isCondor

    callSpread = longCallStrike - shortCallStrike
    putSpread = shortPutStrike - longPutStrike

    maxProfit := netCredit * 100 * contractSize

    maxLossCall = (callSpread - netCredit) * 100 * contractSize
    maxLossPut = (putSpread - netCredit) * 100 * contractSize

    maxLoss := math.max(maxLossCall, maxLossPut)

    upperBreakeven := shortCallStrike + netCredit
    lowerBreakeven := shortPutStrike - netCredit
    lowerBreakeven

// ============================================
// BUTTERFLY
// ============================================

if isButterfly

    wingWidth = bodyStrike - lowerWing

    maxProfit := (wingWidth - netDebit) * 100 * contractSize
    maxLoss := netDebit * 100 * contractSize

    upperBreakeven := bodyStrike + netDebit
    lowerBreakeven := bodyStrike - netDebit
    lowerBreakeven

// ============================================
// SHORT CREDIT VERTICAL
// ============================================

if isShortCredit

    spreadWidth := math.abs(verticalShortStrike - verticalLongStrike)

    maxProfit := netCredit * 100 * contractSize
    maxLoss := (spreadWidth - netCredit) * 100 * contractSize

    if isPutVertical
        verticalBreakeven := verticalShortStrike - netCredit
        lowerBreakeven := verticalBreakeven
        lowerBreakeven

    if isCallVertical
        verticalBreakeven := verticalShortStrike + netCredit
        upperBreakeven := verticalBreakeven
        upperBreakeven

// ============================================
// LONG DEBIT VERTICAL
// ============================================

if isLongDebit

    spreadWidth := math.abs(verticalLongStrike - verticalShortStrike)

    maxLoss := netDebit * 100 * contractSize
    maxProfit := (spreadWidth - netDebit) * 100 * contractSize

    if isPutVertical
        verticalBreakeven := verticalLongStrike - netDebit
        upperBreakeven := verticalBreakeven
        upperBreakeven

    if isCallVertical
        verticalBreakeven := verticalLongStrike + netDebit
        lowerBreakeven := verticalBreakeven
        lowerBreakeven

// ============================================
// EXPIRATION P&L
// ============================================

float currentPnL = 0.0

if isButterfly

    if currentPrice >= upperWing or currentPrice <= lowerWing
        currentPnL := -maxLoss
        currentPnL

    else if currentPrice == bodyStrike
        currentPnL := maxProfit
        currentPnL

    else if currentPrice > bodyStrike
        distanceFromBody = currentPrice - bodyStrike
        currentPnL := maxProfit - distanceFromBody * 100 * contractSize
        currentPnL

    else
        distanceFromBody = bodyStrike - currentPrice
        currentPnL := maxProfit - distanceFromBody * 100 * contractSize
        currentPnL

if isCondor

    if currentPrice >= longCallStrike
        currentPnL := -maxLoss
        currentPnL

    else if currentPrice > shortCallStrike
        currentPnL := (netCredit - (currentPrice - shortCallStrike)) * 100 * contractSize
        currentPnL

    else if currentPrice <= longPutStrike
        currentPnL := -maxLoss
        currentPnL

    else if currentPrice < shortPutStrike
        currentPnL := (netCredit - (shortPutStrike - currentPrice)) * 100 * contractSize
        currentPnL

    else
        currentPnL := maxProfit
        currentPnL

// Short Put Credit
if isShortCredit and isPutVertical

    if currentPrice >= verticalShortStrike
        currentPnL := maxProfit
        currentPnL

    else if currentPrice <= verticalLongStrike
        currentPnL := -maxLoss
        currentPnL

    else
        currentPnL := (netCredit - (verticalShortStrike - currentPrice)) * 100 * contractSize
        currentPnL

// Short Call Credit
if isShortCredit and isCallVertical

    if currentPrice <= verticalShortStrike
        currentPnL := maxProfit
        currentPnL

    else if currentPrice >= verticalLongStrike
        currentPnL := -maxLoss
        currentPnL

    else
        currentPnL := (netCredit - (currentPrice - verticalShortStrike)) * 100 * contractSize
        currentPnL

// Long Call Debit
if isLongDebit and isCallVertical

    if currentPrice <= verticalLongStrike
        currentPnL := -maxLoss
        currentPnL

    else if currentPrice >= verticalShortStrike
        currentPnL := maxProfit
        currentPnL

    else
        currentPnL := (currentPrice - verticalLongStrike - netDebit) * 100 * contractSize
        currentPnL

// Long Put Debit
if isLongDebit and isPutVertical

    if currentPrice >= verticalLongStrike
        currentPnL := -maxLoss
        currentPnL

    else if currentPrice <= verticalShortStrike
        currentPnL := maxProfit
        currentPnL

    else
        currentPnL := (verticalLongStrike - currentPrice - netDebit) * 100 * contractSize
        currentPnL

// ============================================
// TARGET / STOP
// ============================================

profitTargetAmount = maxProfit * (profitTarget / 100)
stopLossAmount = -maxLoss * (stopLossPercent / 100)
stopLossPrice = currentPnL <= stopLossAmount

// ============================================
// POSITION SIZING
// ============================================

maxRiskDollars = accountSize * (riskPerTrade / 100)

recommendedContracts = maxLoss > 0 ? math.floor(maxRiskDollars / maxLoss) : 0
optimalContracts = math.min(recommendedContracts, maxPositionSize)

actualRiskDollars = maxLoss
riskPercentUsed = accountSize > 0 ? actualRiskDollars / accountSize * 100 : 0

// ============================================
// TIME / IV
// ============================================

theta = daysToExp > 0 ? isCondor or isShortCredit ? maxProfit / daysToExp : -maxLoss / daysToExp : 0

timeDecayProgress = daysToExp > 0 ? (1 - daysToExp / 30.0) * 100 : 100

isCreditStrategy = isCondor or isShortCredit

ivCondition = isCreditStrategy ? ivRank > 50 ? 'FAVORABLE' : ivRank > 30 ? 'NEUTRAL' : 'POOR' : ivRank < 30 ? 'FAVORABLE' : ivRank < 50 ? 'NEUTRAL' : 'POOR'

riskRewardRatio = maxLoss > 0 ? maxProfit / maxLoss : 0

// ============================================
// LINES
// ============================================

var line shortCallLine = na
var line longCallLine = na
var line shortPutLine = na
var line longPutLine = na
var line upperBELine = na
var line lowerBELine = na

if barstate.islast

    line.delete(shortCallLine)
    line.delete(longCallLine)
    line.delete(shortPutLine)
    line.delete(longPutLine)
    line.delete(upperBELine)
    line.delete(lowerBELine)

    if not na(shortCallStrike)
        shortCallLine := line.new(bar_index - 50, shortCallStrike, bar_index + 10, shortCallStrike, color = color.red, width = 2)
        shortCallLine

    if not na(longCallStrike)
        longCallLine := line.new(bar_index - 50, longCallStrike, bar_index + 10, longCallStrike, color = color.new(color.orange, 30), width = 1, style = line.style_dashed)
        longCallLine

    if not na(shortPutStrike)
        shortPutLine := line.new(bar_index - 50, shortPutStrike, bar_index + 10, shortPutStrike, color = color.red, width = 2)
        shortPutLine

    if not na(longPutStrike)
        longPutLine := line.new(bar_index - 50, longPutStrike, bar_index + 10, longPutStrike, color = color.new(color.orange, 30), width = 1, style = line.style_dashed)
        longPutLine

    if showBreakevens

        if not na(upperBreakeven)
            upperBELine := line.new(bar_index - 50, upperBreakeven, bar_index + 10, upperBreakeven, color = color.yellow, width = 1, style = line.style_dotted)
            upperBELine

        if not na(lowerBreakeven)
            lowerBELine := line.new(bar_index - 50, lowerBreakeven, bar_index + 10, lowerBreakeven, color = color.yellow, width = 1, style = line.style_dotted)
            lowerBELine

// ============================================
// PROFIT ZONE
// ============================================

var box profitBox = na

if barstate.islast

    box.delete(profitBox)

    if showProfitZone and (isCondor or isButterfly)

        if not na(upperBreakeven) and not na(lowerBreakeven)

            profitBox := box.new(bar_index - 50, upperBreakeven, bar_index + 10, lowerBreakeven, border_color = color.new(color.green, 70), bgcolor = color.new(color.green, 90), border_width = 1)
            profitBox

// ============================================
// ADJUSTMENT ZONES
// ============================================

var box adjustmentCallBox = na
var box adjustmentPutBox = na

if barstate.islast

    box.delete(adjustmentCallBox)
    box.delete(adjustmentPutBox)

    if showAdjustmentZones

        if isCondor

            distanceToCall = shortCallStrike - currentPrice
            distanceToPut = currentPrice - shortPutStrike

            callWarning = shortCallStrike - distanceToCall * (adjustmentThreshold / 100)
            putWarning = shortPutStrike + distanceToPut * (adjustmentThreshold / 100)

            adjustmentCallBox := box.new(bar_index - 50, shortCallStrike, bar_index + 10, callWarning, border_color = color.new(color.orange, 60), bgcolor = color.new(color.orange, 95), border_width = 1)

            adjustmentPutBox := box.new(bar_index - 50, putWarning, bar_index + 10, shortPutStrike, border_color = color.new(color.orange, 60), bgcolor = color.new(color.orange, 95), border_width = 1)
            adjustmentPutBox

        if isShortCredit and isPutVertical

            distance = currentPrice - verticalShortStrike
            warning = verticalShortStrike + distance * (adjustmentThreshold / 100)

            adjustmentPutBox := box.new(bar_index - 50, warning, bar_index + 10, verticalShortStrike, border_color = color.new(color.orange, 60), bgcolor = color.new(color.orange, 95), border_width = 1)
            adjustmentPutBox

        if isShortCredit and isCallVertical

            distance = verticalShortStrike - currentPrice
            warning = verticalShortStrike - distance * (adjustmentThreshold / 100)

            adjustmentCallBox := box.new(bar_index - 50, verticalShortStrike, bar_index + 10, warning, border_color = color.new(color.orange, 60), bgcolor = color.new(color.orange, 95), border_width = 1)
            adjustmentCallBox

// ============================================
// LABELS
// ============================================

var label infoLabel = na
var label shortCallLabel = na
var label longCallLabel = na
var label shortPutLabel = na
var label longPutLabel = na
var label timeDecayLabel = na

if barstate.islast

    label.delete(infoLabel)
    label.delete(shortCallLabel)
    label.delete(longCallLabel)
    label.delete(shortPutLabel)
    label.delete(longPutLabel)
    label.delete(timeDecayLabel)

    if showStrikeLabels

        if not na(shortCallStrike)
            shortCallLabel := label.new(bar_index + 12, shortCallStrike, 'SHORT CALL  ' + str.tostring(shortCallStrike), style = label.style_label_left, color = color.red, textcolor = color.white, size = size.small)
            shortCallLabel

        if not na(longCallStrike)
            longCallLabel := label.new(bar_index + 12, longCallStrike, 'LONG CALL  ' + str.tostring(longCallStrike), style = label.style_label_left, color = color.orange, textcolor = color.white, size = size.small)
            longCallLabel

        if not na(shortPutStrike)
            shortPutLabel := label.new(bar_index + 12, shortPutStrike, 'SHORT PUT  ' + str.tostring(shortPutStrike), style = label.style_label_left, color = color.red, textcolor = color.white, size = size.small)
            shortPutLabel

        if not na(longPutStrike)
            longPutLabel := label.new(bar_index + 12, longPutStrike, 'LONG PUT  ' + str.tostring(longPutStrike), style = label.style_label_left, color = color.orange, textcolor = color.white, size = size.small)
            longPutLabel

// ========================================
// INFO BOX
// ========================================

    if showInfoBox

        string strategyName = ''

        if isCondor
            strategyName := '🔶 IRON CONDOR'
            strategyName

        if isButterfly
            strategyName := '🦋 BUTTERFLY'
            strategyName

        if isShortCredit and isPutVertical
            strategyName := '🟢 BULL PUT CREDIT'
            strategyName

        if isShortCredit and isCallVertical
            strategyName := '🔴 BEAR CALL CREDIT'
            strategyName

        if isLongDebit and isCallVertical
            strategyName := '🟢 BULL CALL DEBIT'
            strategyName

        if isLongDebit and isPutVertical
            strategyName := '🔴 BEAR PUT DEBIT'
            strategyName

        premiumText = isCondor or isShortCredit ? 'Credit: $' + str.tostring(netCredit, '#.##') : 'Debit: $' + str.tostring(netDebit, '#.##')

        infoText = strategyName + '\n' + premiumText + '\n💰 Max Profit: $' + str.tostring(maxProfit, '#.##') + '\n🔴 Max Loss: $' + str.tostring(maxLoss, '#.##') + '\n⚖️ R:R: ' + str.tostring(riskRewardRatio, '#.##') + ':1'

        if isVertical

            infoText := infoText + '\n📏 Width: ' + str.tostring(spreadWidth, '#.##') + '\n⚪ Breakeven: ' + str.tostring(verticalBreakeven, '#.##')
            infoText

        else 
            infoText := infoText + '\n⬆️ Upper BE: ' + str.tostring(upperBreakeven, '#.##') + '\n⬇️ Lower BE: ' + str.tostring(lowerBreakeven, '#.##')
            infoText

        infoText := infoText + '\n🎯 Target: $' + str.tostring(profitTargetAmount, '#.##') + '\n📊 Exp. P&L: $' + str.tostring(currentPnL, '#.##') + '\n🧮 Contracts: ' + str.tostring(contractSize) + '\n🛡️ Risk: ' + str.tostring(riskPercentUsed, '#.##') + '%' + '\n🌡️ IV: ' + ivCondition

        if daysToExp > 0
            infoText := infoText + '\n⏰ Theta Est: $' + str.tostring(math.abs(theta), '#.##')
            infoText

        infoLabel := label.new(bar_index - 45, high * 0.988, infoText, style = label.style_label_down, color = color.new(color.blue, 20), textcolor = color.white, size = size.small)
        infoLabel

    if showTimeDecay and daysToExp > 0

        timeDecayText = '⏱️ ' + str.tostring(timeDecayProgress, '#') + '% | ' + str.tostring(daysToExp) + ' days'

        timeDecayLabel := label.new(bar_index, low * 0.998, timeDecayText, style = label.style_label_up, color = color.new(color.orange, 20), textcolor = color.white, size = size.small)
        timeDecayLabel

// ============================================
// ALERT CONDITIONS
// ============================================

bool approachingShortCall = false
bool approachingShortPut = false

if isCondor and not na(shortCallStrike)

    callDistance = shortCallStrike - currentPrice
    callZone = shortCallStrike - callDistance * (adjustmentThreshold / 100)

    approachingShortCall := currentPrice >= callZone
    approachingShortCall

if isCondor and not na(shortPutStrike)

    putDistance = currentPrice - shortPutStrike
    putZone = shortPutStrike + putDistance * (adjustmentThreshold / 100)

    approachingShortPut := currentPrice <= putZone
    approachingShortPut

if isShortCredit and isCallVertical

    callDistance = verticalShortStrike - currentPrice
    callZone = verticalShortStrike - callDistance * (adjustmentThreshold / 100)

    approachingShortCall := currentPrice >= callZone
    approachingShortCall

if isShortCredit and isPutVertical

    putDistance = currentPrice - verticalShortStrike
    putZone = verticalShortStrike + putDistance * (adjustmentThreshold / 100)

    approachingShortPut := currentPrice <= putZone
    approachingShortPut

profitTargetHit = currentPnL >= profitTargetAmount and profitTargetAmount > 0
stopLossHit = stopLossPrice

alertcondition(approachingShortCall, '⚠️ Call Zone', 'Approaching short call strike')
alertcondition(approachingShortPut, '⚠️ Put Zone', 'Approaching short put strike')
alertcondition(profitTargetHit, '🎯 Target Hit', 'Profit target reached')
alertcondition(stopLossHit, '🛑 Stop Loss', 'Stop loss triggered')

// ============================================
// ONE-TIME MARKERS
// ============================================

var bool shortCallAlerted = false
var bool shortPutAlerted = false
var bool profitAlerted = false
var bool stopLossAlerted = false

if not approachingShortCall
    shortCallAlerted := false
    shortCallAlerted

if not approachingShortPut
    shortPutAlerted := false
    shortPutAlerted

if not profitTargetHit
    profitAlerted := false
    profitAlerted

if not stopLossHit
    stopLossAlerted := false
    stopLossAlerted

showShortCallWarning = approachingShortCall and not shortCallAlerted
showShortPutWarning = approachingShortPut and not shortPutAlerted
showProfitTarget = profitTargetHit and not profitAlerted
showStopLoss = stopLossHit and not stopLossAlerted

if showShortCallWarning
    shortCallAlerted := true
    shortCallAlerted

if showShortPutWarning
    shortPutAlerted := true
    shortPutAlerted

if showProfitTarget
    profitAlerted := true
    profitAlerted

if showStopLoss
    stopLossAlerted := true
    stopLossAlerted

plotshape(showShortCallWarning, 'Call Alert', shape.triangledown, location.abovebar, color.orange, size = size.small)
plotshape(showShortPutWarning, 'Put Alert', shape.triangleup, location.belowbar, color.orange, size = size.small)
plotshape(showProfitTarget, 'Target', shape.diamond, location.abovebar, color.green, size = size.normal)
plotshape(showStopLoss, 'Stop', shape.xcross, location.belowbar, color.red, size = size.normal)
