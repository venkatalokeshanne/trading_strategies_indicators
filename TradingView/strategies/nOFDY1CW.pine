//@version=5
strategy("Ichimoku: ATR Chikou + V4 Viz + Cloud Opacity", overlay=true, initial_capital=1000)

// --- Inputs ---
ts_bars     = input.int(9, minval=1, title="Tenkan-Sen Bars")
ks_bars     = input.int(26, minval=1, title="Kijun-Sen Bars")
ssb_bars    = input.int(52, minval=1, title="Senkou-Span B Bars")
cs_offset   = input.int(26, minval=1, title="Chikou-Span Offset")
ss_offset   = input.int(26, minval=1, title="Senkou-Span Offset")

// Configuração ATR para o modelo quantitativo
atr_length  = input.int(14, "Período do ATR")
atr_mult    = input.float(1.5, "Mult. ATR p/ Ativar Chikou", step=0.1)

// --- Cálculos Ichimoku Kinko Hyo ---
middle(len) => math.avg(ta.lowest(len), ta.highest(len))
tenkan  = middle(ts_bars)
kijun   = middle(ks_bars)
senkouA = math.avg(tenkan, kijun)
senkouB = middle(ssb_bars)
atr_value = ta.atr(atr_length)

// --- Sinais de Entrada (Setup Ichimoku V4) ---
ss_high = math.max(senkouA[ss_offset-1], senkouB[ss_offset-1])
ss_low  = math.min(senkouA[ss_offset-1], senkouB[ss_offset-1])

bullish = tenkan > kijun and ta.mom(close, cs_offset-1) > 0 and close > ss_high
bearish = tenkan < kijun and ta.mom(close, cs_offset-1) < 0 and close < ss_low

// --- Gestão de Saída e Ativação ATR ---
var float entry_price = 0.0
is_new_entry = strategy.position_size != 0 and strategy.position_size[1] == 0

if is_new_entry
    entry_price := close

profit_points = strategy.position_size > 0 ? (close - entry_price) : 
                 strategy.position_size < 0 ? (entry_price - close) : 0.0

chikou_is_active = profit_points > (atr_value * atr_mult)
price_lookback = close[cs_offset-1]
chikou_touch = ta.cross(close, price_lookback)

// --- Execução de Ordens ---
if (bullish)
    strategy.entry("Long", strategy.long)

if (bearish)
    strategy.entry("Short", strategy.short)

// Saída Híbrida (Chikou vs Original)
if (strategy.position_size > 0 and chikou_is_active and chikou_touch)
    strategy.close("Long", comment="Saída: Chikou")

if (strategy.position_size < 0 and chikou_is_active and chikou_touch)
    strategy.close("Short", comment="Saída: Chikou")

if (strategy.position_size > 0 and bearish)
    strategy.close("Long", comment="Saída: Original")

if (strategy.position_size < 0 and bullish)
    strategy.close("Short", comment="Saída: Original")

// --- VISUALIZAÇÃO ---

// 1. Médias Principais
plot(tenkan, color=#0496ff, title="Tenkan-Sen")
plot(kijun, color=#991515, linewidth=2, title="Kijun-Sen")

// 2. Nuvem (Kumo) com Opacidade de 25% (Transparency 75)
sa = plot(senkouA, offset=ss_offset-1, color=color.new(color.green, 50), title="Senkou A")
sb = plot(senkouB, offset=ss_offset-1, color=color.new(color.red, 50), title="Senkou B")
fill(sa, sb, color = senkouA > senkouB ? color.new(color.green, 75) : color.new(color.red, 75), title="Fundo da Plotagem")

// 3. Linha de Referência Chikou
// Verde (Ativo): 80% opacidade | Rosa (Inativo): 40% opacidade
chikou_color = chikou_is_active ? color.new(color.lime, 20) : color.new(#ffcdd2, 60)
plot(price_lookback, color=chikou_color, linewidth=2, title="Chikou Ref")

// 4. Elementos Auxiliares
activation_level = strategy.position_size > 0 ? entry_price + (atr_value * atr_mult) : 
                   strategy.position_size < 0 ? entry_price - (atr_value * atr_mult) : na
plot(is_new_entry ? activation_level : na, color=color.white, style=plot.style_cross, linewidth=4, title="Cruz ATR")