// © PtGambler
// Modified visual layout

//@version=6
indicator("QQQ NDX NQ Price Converter [Pt] - Clean Right Levels",
     shorttitle="QQQ Levels",
     overlay=true,
     max_labels_count=500,
     max_lines_count=500)

group_table = "Price Table"

// ============================================================================
// INPUTS
// ============================================================================

update_freq = input.string(
     "Every tick",
     "Conversion Frequency",
     ["Every tick", "Per Candle Close"])

// QQQ
qqq = input.bool(true, "QQQ", inline="qqq")
multi1 = input.float(1, "| Multiplier", minval=0.1, step=0.5, inline="qqq")
col1 = input.color(color.blue, "", inline="qqq")
qqqbase = input.int(1, "Base", minval=1, inline="qqq")

line_style1 = input.string(
     "Dotted",
     "QQQ Line Style",
     options=["Solid", "Dashed", "Dotted"])

// NDX
ndx = input.bool(false, "NDX", inline="ndx")
multi2 = input.float(100, "| Multiplier", minval=0.1, step=5, inline="ndx")
col2 = input.color(color.yellow, "", inline="ndx")

line_style2 = input.string(
     "Dashed",
     "NDX Line Style",
     options=["Solid", "Dashed", "Dotted"])

// NQ
nq = input.bool(false, "NQ", inline="nq")
multi3 = input.float(100, "| Multiplier", minval=0.25, step=5, inline="nq")
col3 = input.color(color.orange, "", inline="nq")

line_style3 = input.string(
     "Dashed",
     "NQ Line Style",
     options=["Solid", "Dashed", "Dotted"])

// NAS100
nasusd = input.bool(false, "", inline="nasusd")
ticker_input = input.symbol("NAS100USD", "", inline="nasusd")
multi4 = input.float(100, "| Multiplier", minval=0.1, step=5, inline="nasusd")
col4 = input.color(color.aqua, "", inline="nasusd")

line_style4 = input.string(
     "Dashed",
     "NAS100 Line Style",
     options=["Solid", "Dashed", "Dotted"])

// ============================================================================
// LEVEL SETTINGS
// ============================================================================

levels = input.int(
     10,
     "# of levels +/-",
     minval=1) * 2 + 1

in_text_size = input.string(
     "Normal",
     "Text size",
     options=["Auto", "Large", "Normal", "Small", "Tiny"])

text_size = switch in_text_size
    "Auto"   => size.auto
    "Large"  => size.large
    "Normal" => size.normal
    "Small"  => size.small
    "Tiny"   => size.tiny

// Distance of QQQ levels from current market
distance_from_market = input.int(
     240,
     "Distance From Market",
     minval=2,
     maxval=400)

// Where QQQ level lines begin
line_start_gap = input.int(
     2,
     "Line Start Gap",
     minval=0,
     maxval=100)

// ============================================================================
// CURRENT QQQ PRICE TAG
// ============================================================================

show_current_qqq = input.bool(
     true,
     "Show Current QQQ Price")

current_qqq_offset = input.int(
     8,
     "Current QQQ Label Distance",
     minval=2,
     maxval=100)

current_qqq_color = input.color(
     color.rgb(160, 190, 205),
     "Current QQQ Label Color")

current_qqq_line_width = input.int(
     2,
     "Current QQQ Tail Width",
     minval=1,
     maxval=4)

show_last = input.bool(
     false,
     "Show last closing price")

// ============================================================================
// PRICE TABLE
// ============================================================================

show_table = input.bool(
     true,
     "Show Prices",
     group=group_table)

tableLocation = input.string(
     "Top right",
     "Location",
     options=[
         "Top left",
         "Top center",
         "Top right",
         "Bottom left",
         "Bottom center",
         "Bottom right"],
     group=group_table)

tablePosition =
     tableLocation == "Top left" ? position.top_left :
     tableLocation == "Top center" ? position.top_center :
     tableLocation == "Top right" ? position.top_right :
     tableLocation == "Bottom left" ? position.bottom_left :
     tableLocation == "Bottom center" ? position.bottom_center :
     position.bottom_right

table_font_size = input.string(
     "Normal",
     "Font Size",
     options=["Auto", "Tiny", "Small", "Normal", "Large"],
     group=group_table)

show_chg = input.bool(
     true,
     "Show Price Change",
     group=group_table)

// ============================================================================
// LINE STYLES
// ============================================================================

f_lineStyle(_styleStr) =>
    switch _styleStr
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        => line.style_dotted

qqqLineStyle = f_lineStyle(line_style1)
ndxLineStyle = f_lineStyle(line_style2)
nqLineStyle  = f_lineStyle(line_style3)
nasLineStyle = f_lineStyle(line_style4)

// ============================================================================
// MARKET DATA
// ============================================================================

t1 = time(
     timeframe.period,
     "0930-1600:23456",
     "America/New_York")

ticker = syminfo.ticker

QQQ_price = request.security(
     "QQQ",
     timeframe.period,
     math.round_to_mintick(close))

NDX_price = request.security(
     "NDX",
     timeframe.period,
     math.round_to_mintick(close))

[NQ_price, NQ_last_close] = request.security(
     "NQ1!",
     timeframe.period,
     [
         math.round_to_mintick(close),
         ta.valuewhen(not na(t1[1]) and na(t1), open, 0)
     ])

ticker_price = request.security(
     ticker_input,
     timeframe.period,
     math.round_to_mintick(close))

ticker_last_close = request.security(
     ticker_input,
     "1D",
     math.round_to_mintick(close[1]))

// ============================================================================
// ARRAYS
// ============================================================================

var qqq_levels = array.new_line()
var ndx_levels = array.new_line()
var nq_levels = array.new_line()
var nasusd_levels = array.new_line()

var qqq_lbls = array.new_label()
var ndx_lbls = array.new_label()
var nq_lbls = array.new_label()
var nasusd_lbls = array.new_label()

// ============================================================================
// BASE PRICES
// ============================================================================

QQQp0 = math.floor(QQQ_price / qqqbase) * qqqbase
NDXp0 = math.floor(NDX_price / 100) * 100
NQp0 = math.floor(NQ_price / 100) * 100

round_num = math.pow(
     10,
     str.length(str.tostring(math.floor(ticker_price))) - 2)

NDXUSDp0 =
     math.floor(ticker_price / round_num) *
     round_num

// ============================================================================
// REGULAR SESSION PRICE
// ============================================================================

last_session_close = ta.valuewhen(not na(t1), close, 0)

regular_close =
     na(t1) ?
     close :
     last_session_close

// ============================================================================
// PRICE CHANGE
// ============================================================================

NQ_chg = NQ_price - NQ_last_close
NQ_chg_pct = NQ_chg / NQ_last_close * 100

ticker_chg = ticker_price - ticker_last_close
ticker_chg_pct = ticker_chg / ticker_last_close * 100

// ============================================================================
// CLEAR OLD OBJECTS
// ============================================================================

f_clearLines(_array) =>
    while array.size(_array) > 0
        line.delete(array.pop(_array))

f_clearLabels(_array) =>
    while array.size(_array) > 0
        label.delete(array.pop(_array))

// ============================================================================
// DRAW ONE LEVEL
// ============================================================================

f_drawLevel(
     _lineArray,
     _lblArray,
     _labelText,
     _price,
     _color,
     _linestyle) =>

    // Everything is anchored to the CURRENT/LAST candle.
    // As new candles appear, the whole QQQ block moves with them.

    currentBar = bar_index

    // Where the QQQ line begins
    lineStart = currentBar + line_start_gap

    // Where QQQ 725 / 726 / etc. text sits
    labelX = currentBar + distance_from_market

    // Line ends exactly at the QQQ text
    lineEnd = labelX

    array.push(
         _lineArray,
         line.new(
             lineStart,
             _price,
             lineEnd,
             _price,
             xloc=xloc.bar_index,
             extend=extend.none,
             color=_color,
             style=_linestyle,
             width=1))

    array.push(
         _lblArray,
         label.new(
             labelX,
             _price,
             _labelText,
             xloc=xloc.bar_index,
             yloc=yloc.price,
             color=color.new(chart.bg_color, 100),
             style=label.style_label_center,
             textcolor=_color,
             size=text_size,
             textalign=text.align_center))
// ============================================================================
// CREATE LEVELS
// QQQ -> NQ CONVERSION LOGIC UNCHANGED
// ============================================================================

f_setLevels(
     _alt,
     _lineArray,
     _lblArray,
     _basePrice,
     _altPrice,
     _multiplier,
     _color,
     _linestyle) =>

    _price = close

    if _alt == "QQQ" or _alt == "NDX"
        _price := regular_close

    // BASE
    base =
         _basePrice *
         (_price / _altPrice)

    f_drawLevel(
         _lineArray,
         _lblArray,
         _alt + " " + str.tostring(_basePrice),
         base,
         _color,
         _linestyle)

    // ABOVE
    for x = 1 to (levels - 1) / 2

        alt_price =
             _basePrice +
             x * _multiplier

        price =
             alt_price *
             (_price / _altPrice)

        f_drawLevel(
             _lineArray,
             _lblArray,
             _alt + " " + str.tostring(alt_price),
             price,
             _color,
             _linestyle)

    // BELOW
    for x = (levels - 1) / 2 + 1 to levels - 1

        y =
             (levels - 1) / 2 -
             x

        alt_price =
             _basePrice +
             y * _multiplier

        price =
             alt_price *
             (_price / _altPrice)

        f_drawLevel(
             _lineArray,
             _lblArray,
             _alt + " " + str.tostring(alt_price),
             price,
             _color,
             _linestyle)

// ============================================================================
// CURRENT QQQ PRICE TAG
// ============================================================================

var label currentQQQLabel = na
var line currentQQQLine = na

// ============================================================================
// LAST PRICE TEXT
// ============================================================================

var label lastPriceLabel = na

text_qqq =
     qqq or ticker == "QQQ" ?
     "QQQ " + str.tostring(QQQ_price) + "\n" :
     ""

text_ndx =
     ndx or ticker == "NDX" ?
     "NDX " + str.tostring(NDX_price) + "\n" :
     ""

text_nq =
     nq or ticker == "NQ1!" ?
     "NQ1! " + str.tostring(NQ_price) + "\n" :
     ""

text_nasusd =
     nasusd ?
     "NAS100 " + str.tostring(ticker_price) + "\n" :
     ""

price_text = ""

if ticker == "QQQ"
    price_text :=
         text_qqq +
         text_ndx +
         text_nq +
         text_nasusd

else if ticker == "NDX"
    price_text :=
         text_ndx +
         text_qqq +
         text_nq +
         text_nasusd

else if ticker == "NQ1!" or ticker == "MNQ1!" or str.contains(ticker, "MNQ")
    price_text :=
         text_nq +
         text_qqq +
         text_ndx +
         text_nasusd

// ============================================================================
// MAIN
// ============================================================================

shouldUpdate =
     update_freq == "Per Candle Close" ?
     barstate.isconfirmed :
     barstate.islast

if shouldUpdate

    // Clear old levels
    if qqq
        f_clearLines(qqq_levels)
        f_clearLabels(qqq_lbls)

    if ndx
        f_clearLines(ndx_levels)
        f_clearLabels(ndx_lbls)

    if nq
        f_clearLines(nq_levels)
        f_clearLabels(nq_lbls)

    if nasusd
        f_clearLines(nasusd_levels)
        f_clearLabels(nasusd_lbls)

    // ========================================================================
    // CURRENT QQQ PRICE TAG
    //
    // Looks like:
    //
    // -----> [ QQQ: 725.31 ]
    //
    // ========================================================================

    if not na(currentQQQLabel)
        label.delete(currentQQQLabel)

    if not na(currentQQQLine)
        line.delete(currentQQQLine)

    if qqq and show_current_qqq

        currentLabelX =
             bar_index + current_qqq_offset

        currentLineStart =
             bar_index + 1

        currentLineEnd =
             currentLabelX - 1

        // Short tail
        currentQQQLine :=
             line.new(
                 currentLineStart,
                 regular_close,
                 currentLineEnd,
                 regular_close,
                 xloc=xloc.bar_index,
                 extend=extend.none,
                 color=current_qqq_color,
                 style=line.style_solid,
                 width=current_qqq_line_width)

        // Compact tag with arrow/point on left
        currentQQQLabel :=
             label.new(
                 currentLabelX,
                 regular_close,
                 "QQQ: " + str.tostring(QQQ_price, "#.00"),
                 xloc=xloc.bar_index,
                 yloc=yloc.price,
                 color=current_qqq_color,
                 style=label.style_label_left,
                 textcolor=color.white,
                 size=size.normal,
                 textalign=text.align_center)

    // ========================================================================
    // OPTIONAL OLD LAST PRICE DISPLAY
    // ========================================================================

    if show_last

        if not na(lastPriceLabel)
            label.delete(lastPriceLabel)

        lastPriceLabel :=
             label.new(
                 bar_index,
                 close,
                 price_text,
                 xloc=xloc.bar_index,
                 yloc=yloc.price,
                 color=color.new(chart.bg_color, 70),
                 style=label.style_label_left,
                 textcolor=chart.fg_color,
                 size=size.normal,
                 textalign=text.align_left)

    // ========================================================================
    // QQQ LEVELS
    // ========================================================================

    if qqq
        f_setLevels(
             "QQQ",
             qqq_levels,
             qqq_lbls,
             QQQp0,
             QQQ_price,
             multi1,
             col1,
             qqqLineStyle)

    // ========================================================================
    // NDX LEVELS
    // ========================================================================

    if ndx
        f_setLevels(
             "NDX",
             ndx_levels,
             ndx_lbls,
             NDXp0,
             NDX_price,
             multi2,
             col2,
             ndxLineStyle)

    // ========================================================================
    // NQ LEVELS
    // ========================================================================

    if nq
        f_setLevels(
             "NQ1!",
             nq_levels,
             nq_lbls,
             NQp0,
             NQ_price,
             multi3,
             col3,
             nqLineStyle)

    // ========================================================================
    // NAS100 LEVELS
    // ========================================================================

    if nasusd
        f_setLevels(
             "NAS100",
             nasusd_levels,
             nasusd_lbls,
             NDXUSDp0,
             ticker_price,
             multi4,
             col4,
             nasLineStyle)

// ============================================================================
// TABLE
// ============================================================================

var displayTable =
     table.new(
         tablePosition,
         4,
         4,
         border_width=1)

f_fillCell(_row, _column, _cellText) =>

    cellSize = switch table_font_size
        "Auto"   => size.auto
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        => size.large

    table.cell(
         displayTable,
         _column,
         _row,
         _cellText,
         bgcolor=color.new(chart.bg_color, 50),
         text_color=chart.fg_color,
         text_halign=text.align_left,
         text_valign=text.align_center,
         text_size=cellSize)

if barstate.islast and show_table

    f_fillCell(0, 0, "QQQ")
    f_fillCell(1, 0, "NDX")
    f_fillCell(2, 0, "NQ1!")
    f_fillCell(3, 0, "NAS100USD")

    f_fillCell(
         0,
         1,
         str.tostring(QQQ_price))

    f_fillCell(
         1,
         1,
         str.tostring(NDX_price))

    f_fillCell(
         2,
         1,
         str.tostring(NQ_price))

    f_fillCell(
         3,
         1,
         str.tostring(ticker_price))

    if show_chg

        nqChangeText =
             math.sign(NQ_chg) >= 0 ?
             "+" + str.tostring(NQ_chg_pct, "#.##") + "%" :
             str.tostring(NQ_chg_pct, "#.##") + "%"

        nasChangeText =
             math.sign(ticker_chg) >= 0 ?
             "+" + str.tostring(ticker_chg_pct, "#.##") + "%" :
             str.tostring(ticker_chg_pct, "#.##") + "%"

        f_fillCell(
             0,
             2,
             nqChangeText)

        f_fillCell(
             3,
             2,
             nasChangeText)