//@version=6
indicator("Professional Session CVD [Order Flow]", "Session CVD", overlay=false, format=format.volume)

// =========================================================================
// INPUTS & SETTINGS
// =========================================================================
grp_data = "Data Configuration"
ltf_input = input.timeframe("1", title="Intrabar Timeframe (Granularity)", group=grp_data, tooltip="Lower timeframe used to approximate tick-by-tick bid/ask delta. 1-minute is standard; use '1S' if you have Premium data.")
reset_mode = input.string("Daily", title="Session Reset Mode", options=["Daily", "Weekly", "Continuous"], group=grp_data)

grp_visuals = "Visuals & Labels"
color_bull = input.color(color.new(color.teal, 0), title="Bullish Delta Color", group=grp_visuals)
color_bear = input.color(color.new(color.red, 0), title="Bearish Delta Color", group=grp_visuals)
show_labels = input.bool(true, title="Show Delta Max/Min Labels on Extremes", group=grp_visuals)

// =========================================================================
// INTRABAR DELTA CALCULATION LOGIC
// =========================================================================
// Estimates aggressive ask vs bid lifting on the lower timeframe
get_intrabar_delta() =>
    float buy_vol  = close > open ? volume : (close == open and close >= close[1] ? volume : 0)
    float sell_vol = close < open ? volume : (close == open and close < close[1] ? volume : 0)
    buy_vol - sell_vol // Delta = Buy Volume - Sell Volume

// Fetch lower timeframe array of deltas for the current higher timeframe bar
float[] ltf_deltas = request.security_lower_tf(syminfo.tickerid, ltf_input, get_intrabar_delta())

// =========================================================================
// SESSION ACCUMULATION & RESET LOGIC
// =========================================================================
var float current_cvd = 0.0

// Determine if a new session has started based on user settings
bool is_new_session = false
if reset_mode == "Daily"
    is_new_session := ta.change(time("D")) != 0
else if reset_mode == "Weekly"
    is_new_session := ta.change(time("W")) != 0

// Reset CVD at the start of the defined session
if is_new_session
    current_cvd := 0.0

// =========================================================================
// CANDLESTICK RECONSTRUCTION (Delta Max, Min, Open, Close)
// =========================================================================
float cvd_open  = current_cvd
float temp_cvd  = current_cvd
float cvd_high  = current_cvd
float cvd_low   = current_cvd

// Iterate through the intrabar data to find true extremes (Delta Max/Min)
if array.size(ltf_deltas) > 0
    for i = 0 to array.size(ltf_deltas) - 1
        temp_cvd += array.get(ltf_deltas, i)
        cvd_high := math.max(cvd_high, temp_cvd)
        cvd_low  := math.min(cvd_low, temp_cvd)
        
// Update the running CVD to close the bar
current_cvd := temp_cvd
float cvd_close = current_cvd

// Determine bar color based on localized effort
color candle_color = cvd_close >= cvd_open ? color_bull : color_bear

// =========================================================================
// PLOTTING & VISUALS
// =========================================================================
// Plot CVD as a continuous candlestick
plotcandle(cvd_open, cvd_high, cvd_low, cvd_close, title="CVD Candles", color=candle_color, wickcolor=candle_color, bordercolor=candle_color)

// Zero Baseline for context
hline(0, title="Zero Line", color=color.new(color.gray, 50), linestyle=hline.style_dashed)

// Plot Delta Divergence/Extreme Labels
bool is_swing_high = cvd_close == ta.highest(cvd_close, 10)
bool is_swing_low  = cvd_close == ta.lowest(cvd_close, 10)

if show_labels and is_swing_high
    label.new(bar_index, cvd_high, text=str.tostring(math.round(cvd_high)), color=color.new(color.teal, 80), style=label.style_label_down, textcolor=color.white, size=size.small)
    
if show_labels and is_swing_low
    label.new(bar_index, cvd_low, text=str.tostring(math.round(cvd_low)), color=color.new(color.red, 80), style=label.style_label_up, textcolor=color.white, size=size.small)
