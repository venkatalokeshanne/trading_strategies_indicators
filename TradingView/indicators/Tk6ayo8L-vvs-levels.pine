//@version=6
// =============================================================
//  CLARITY 2 CAPITAL  —  DAILY LEVELS
//  Paste your sheet into the "Levels" box in settings.
//  The script auto-draws only the row matching the open chart.
//
//  FORMAT (one ticker per line):
//    TICKER, resistance, support, upTargets, downTargets
//    Targets are space-separated. Lines starting with # are ignored.
//
//  Educational only. Not financial advice. NFA.
// =============================================================
 
indicator("C2C Daily Levels", shorttitle = "C2C LEVELS", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)
 
// ------------------------- INPUTS ----------------------------
gL = "LEVELS  —  paste your sheet here"
 
levelsInput = input.text_area(
     defval =
     "# TICKER, resistance, support, up targets, down targets\n" +
     "SPY, 774.50, 773.50, 775.22 775.64 776.16 776.81 777.93, 772.26 771.76 770.47 769.61\n" +
     "QQQ, 727.00, 724.93, 728.14 730.41 734.45 735.92 737.61, 722.12 721.66 720.50 719.26 718.45\n" +
     "IWM, 302.46, 301.00, 302.85 303.03 303.19 303.50 304.25 305.62 306.46, 300.89 300.62 299.80 299.00\n" +
     "SPX, 7767.07, 7758.38, 7780.00 7789.00 7792.37 7798.00 7807.43 7811.03, 7754.79 7749.25 7743.17\n" +
     "TSLA, 333.67, 328.91, 334.54 335.47 336.20 338.21 340.00, 328.18 327.43 326.92 326.48 325.95 324.55\n" +
     "MSFT, 501.95, 499.50, 502.71 503.89 505.18, 499.00 498.50 497.30 496.31\n" +
     "AAPL, 305.00, 303.78, 305.95 306.68 307.22 308.21 309.21 310.00, 302.53 301.07 300.19 299.03 297.90 296.24 294.43\n" +
     "NVDA, 220.71, 218.02, 221.52 222.26 223.21 223.97 224.76 225.69 227.20, 216.35 214.63 213.05 210.95 209.00\n" +
     "GOOGL, 347.94, 343.40, 349.53 350.53 352.62 353.71 355.63 356.22, 341.37 337.40 335.16 331.67 329.10\n" +
     "AMZN, 274.62, 272.00, 275.53 276.19 277.13 278.32 279.00 280.17, 271.89 270.61 269.65 268.49 267.75 266.90 266.34 265.40\n" +
     "META, 602.67, 599.21, 604.46 605.77 606.60 607.33 610.20 612.38, 597.19 595.82 593.70 590.58 588.18 585.54\n" +
     "PLTR, 173.00, 172.00, 174.34 176.61 178.52 180.05, 170.91 169.74 169.00 167.66 166.20 164.70",
     title = "Levels", group = gL)
 
gS = "DISPLAY"
showTargets = input.bool(true,  "Show target ladders",       group = gS)
showChop    = input.bool(true,  "Shade chop zone",           group = gS)
showLabels  = input.bool(true,  "Show price labels",         group = gS)
extendRight = input.int(30,     "Extend right (bars)",       minval = 0, maxval = 200, group = gS)
lookback    = input.int(200,    "Extend left (bars)",        minval = 20, maxval = 1000, group = gS)
labelSize   = input.string("small", "Label size", options = ["tiny","small","normal"], group = gS)
 
gC = "BRAND COLORS"
cRes   = input.color(color.new(#4ADE80, 0),  "Resistance",   group = gC)
cSup   = input.color(color.new(#FF5C7A, 0),  "Support",      group = gC)
cTgtUp = input.color(color.new(#4ADE80, 55), "Targets up",   group = gC)
cTgtDn = input.color(color.new(#FF5C7A, 55), "Targets down", group = gC)
cChop  = input.color(color.new(#D4AF37, 90), "Chop fill",    group = gC)
cText  = input.color(#F5F1EA,                "Label text",   group = gC)
 
gA = "ALERTS"
alertsOn = input.bool(true, "Enable break alerts", group = gA,
     tooltip = "Set the alert to 'Once Per Bar Close' so it only fires on a confirmed 3m close.")
 
// --------------------- SYMBOL MATCHING -----------------------
// Matches the sheet row to the open chart. Handles bare tickers
// (SPX), exchange-prefixed IDs (CBOE:SPX / SP:SPX) and the common
// SPX aliases so the index row draws on whichever feed is loaded.
bareSymbol() =>
    tid   = str.upper(syminfo.tickerid)
    parts = str.split(tid, ":")
    array.size(parts) > 1 ? array.get(parts, 1) : tid
 
matchTicker(tk) =>
    sym  = str.upper(syminfo.ticker)
    bare = bareSymbol()
    ok   = tk == sym or tk == bare
    if not ok and tk == "SPX"
        ok := sym == "SPXW" or sym == "SPXUSD" or bare == "SPXW" or bare == "SPXUSD"
    ok
 
// ------------------------ PARSING ----------------------------
parseFloats(s) =>
    out = array.new<float>()
    parts = str.split(str.trim(s), " ")
    if array.size(parts) > 0
        for i = 0 to array.size(parts) - 1
            p = str.trim(array.get(parts, i))
            if str.length(p) > 0
                v = str.tonumber(p)
                if not na(v)
                    array.push(out, v)
    out
 
parseSheet() =>
    float res = na
    float sup = na
    upT = array.new<float>()
    dnT = array.new<float>()
 
    rows = str.split(levelsInput, "\n")
    if array.size(rows) > 0
        for i = 0 to array.size(rows) - 1
            raw = str.trim(array.get(rows, i))
            isComment = str.length(raw) > 0 and str.substring(raw, 0, 1) == "#"
            if str.length(raw) > 0 and not isComment
                f = str.split(raw, ",")
                if array.size(f) >= 3
                    tk = str.upper(str.trim(array.get(f, 0)))
                    if matchTicker(tk)
                        res := str.tonumber(str.trim(array.get(f, 1)))
                        sup := str.tonumber(str.trim(array.get(f, 2)))
                        if array.size(f) >= 4
                            upT := parseFloats(array.get(f, 3))
                        if array.size(f) >= 5
                            dnT := parseFloats(array.get(f, 4))
    [res, sup, upT, dnT]
 
[resistance, support, upTargets, dnTargets] = parseSheet()
 
// ------------------------ DRAWING ----------------------------
var line[]  objLines  = array.new<line>()
var label[] objLabels = array.new<label>()
var box[]   objBoxes  = array.new<box>()
 
wipe() =>
    if array.size(objLines) > 0
        for i = 0 to array.size(objLines) - 1
            line.delete(array.get(objLines, i))
        array.clear(objLines)
    if array.size(objLabels) > 0
        for i = 0 to array.size(objLabels) - 1
            label.delete(array.get(objLabels, i))
        array.clear(objLabels)
    if array.size(objBoxes) > 0
        for i = 0 to array.size(objBoxes) - 1
            box.delete(array.get(objBoxes, i))
        array.clear(objBoxes)
 
lsize() =>
    labelSize == "tiny" ? size.tiny : labelSize == "normal" ? size.normal : size.small
 
// Clamp so a short chart history can't push the line off the bar index.
leftEdge() =>
    math.max(0, bar_index - lookback)
 
drawLevel(float price, color col, int width, string style, string txt) =>
    if not na(price)
        l = line.new(leftEdge(), price, bar_index + extendRight, price,
             xloc = xloc.bar_index, color = col, width = width,
             style = style == "solid" ? line.style_solid : line.style_dashed)
        array.push(objLines, l)
        if showLabels
            lb = label.new(bar_index + extendRight, price, txt,
                 xloc = xloc.bar_index, style = label.style_label_left,
                 color = color.new(#1A1A1A, 15), textcolor = cText, size = lsize())
            array.push(objLabels, lb)
 
if barstate.islast
    wipe()
 
    // chop zone
    if showChop and not na(resistance) and not na(support)
        b = box.new(leftEdge(), math.max(resistance, support), bar_index + extendRight, math.min(resistance, support),
             xloc = xloc.bar_index, border_color = color.new(#D4AF37, 70),
             bgcolor = cChop)
        array.push(objBoxes, b)
 
    // triggers
    drawLevel(resistance, cRes, 2, "solid", "CALLS ▲ " + str.tostring(resistance, format.mintick))
    drawLevel(support,    cSup, 2, "solid", "PUTS ▼ "  + str.tostring(support,    format.mintick))
 
    // target ladders
    if showTargets
        if array.size(upTargets) > 0
            for i = 0 to array.size(upTargets) - 1
                v = array.get(upTargets, i)
                drawLevel(v, cTgtUp, 1, "dashed", "▲ T" + str.tostring(i + 1) + "  " + str.tostring(v, format.mintick))
        if array.size(dnTargets) > 0
            for i = 0 to array.size(dnTargets) - 1
                v = array.get(dnTargets, i)
                drawLevel(v, cTgtDn, 1, "dashed", "▼ T" + str.tostring(i + 1) + "  " + str.tostring(v, format.mintick))
 
// ------------------------ ALERTS -----------------------------
// Fires only on a confirmed candle close beyond the trigger.
brokeUp   = alertsOn and not na(resistance) and close > resistance and close[1] <= resistance
brokeDown = alertsOn and not na(support)    and close < support    and close[1] >= support
 
if brokeUp and barstate.isconfirmed
    alert(syminfo.ticker + " closed above " + str.tostring(resistance, format.mintick) +
         " on the " + timeframe.period + " — call side live.", alert.freq_once_per_bar_close)
 
if brokeDown and barstate.isconfirmed
    alert(syminfo.ticker + " closed below " + str.tostring(support, format.mintick) +
         " on the " + timeframe.period + " — put side live.", alert.freq_once_per_bar_close)
 
alertcondition(brokeUp,   title = "C2C — Close above resistance", message = "{{ticker}} closed above the C2C level.")
alertcondition(brokeDown, title = "C2C — Close below support",    message = "{{ticker}} closed below the C2C level.")
 
// status corner
var table tbl = table.new(position.bottom_right, 1, 1, border_width = 0)
if barstate.islast
    txt = na(resistance) ? syminfo.ticker + " — no levels set" :
         syminfo.ticker + "   ▲ " + str.tostring(resistance, format.mintick) +
         "   ▼ " + str.tostring(support, format.mintick)
    table.cell(tbl, 0, 0, txt, text_color = cText, text_size = size.tiny,
         bgcolor = color.new(#0D0D0D, 20))