//@version=6
// © S_SANLI
indicator("ROC & RSI Toleranslı Al-Sat İndikatörü © S_SANLI", shorttitle="ROC_RSI_S_SANLI", overlay=true)

// ==========================================
// GİRDİLER (INPUTS)
// ==========================================
// ROC Ayarları
roc_len = input.int(9, title="ROC Uzunluğu", minval=1, group="ROC Ayarları")

// RSI Ayarları
rsi_len    = input.int(14, title="RSI Uzunluğu", minval=1, group="RSI Ayarları")
rsi_ma_len = input.int(14, title="RSI MA (Ortalama) Uzunluğu", minval=1, group="RSI Ayarları")

// Tolerans Ayarı
tolerance = input.int(2, title="Tolerans Mum Sayısı", minval=0, group="Sinyal Ayarları", 
                      tooltip="İki kesişimin birbiri ardına gerçekleşebileceği maksimum mum sayısı. (0 = Tam aynı mumda kesişmeli)")

// ==========================================
// HESAPLAMALAR
// ==========================================
// ROC hesaplama
roc = ta.roc(close, roc_len)

// RSI ve RSI Ortalaması hesaplama
rsi    = ta.rsi(close, rsi_len)
rsi_ma = ta.sma(rsi, rsi_ma_len)

// Kesişim Koşulları
roc_cross_up   = ta.crossover(roc, 0)
roc_cross_down = ta.crossunder(roc, 0)

rsi_cross_up   = ta.crossover(rsi, rsi_ma)
rsi_cross_down = ta.crossunder(rsi, rsi_ma)

// Son kesişimden bu yana geçen mum sayıları
bars_since_roc_up   = ta.barssince(roc_cross_up)
bars_since_roc_down = ta.barssince(roc_cross_down)

bars_since_rsi_up   = ta.barssince(rsi_cross_up)
bars_since_rsi_down = ta.barssince(rsi_cross_down)

// ==========================================
// SİNYAL MANTIĞI
// ==========================================
// Al Sinyali: Bir kesişim tam şu an gerçekleştiğinde, diğer kesişim tolerans mum sayısı içinde kaldıysa tetiklenir.
// Not: İlk mumlarda tanımsız (na) değer dönmesini engellemek için nz() ile tolerans limiti aşıldı varsayımı eklendi.
buy_signal = (roc_cross_up and nz(bars_since_rsi_up, tolerance + 1) <= tolerance) or (rsi_cross_up and nz(bars_since_roc_up, tolerance + 1) <= tolerance)

// Sat Sinyali: Aynı mantık aşağı kesişimler için geçerlidir.
sell_signal = (roc_cross_down and nz(bars_since_rsi_down, tolerance + 1) <= tolerance) or (rsi_cross_down and nz(bars_since_roc_down, tolerance + 1) <= tolerance)

// ==========================================
// GRAFİK ÜZERİNE ÇİZİM
// ==========================================
plotshape(buy_signal, title="Al Sinyali", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="AL", textcolor=color.white)
plotshape(sell_signal, title="Sat Sinyali", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SAT", textcolor=color.white)

// ==========================================
// ALARM KOŞULLARI
// ==========================================
alertcondition(buy_signal, title="AL Alarmı", message="ROC & RSI: AL Sinyali Oluştu!")
alertcondition(sell_signal, title="SAT Alarmı", message="ROC & RSI: SAT Sinyali Oluştu!")