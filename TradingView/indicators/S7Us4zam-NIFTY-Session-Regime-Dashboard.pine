        string iVWAPText = "BELOW"

        if iPrice > iVWAP
            iVWAPText := "ABOVE"


        table.cell(dash, 0, 9, "ICICI Bank", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

