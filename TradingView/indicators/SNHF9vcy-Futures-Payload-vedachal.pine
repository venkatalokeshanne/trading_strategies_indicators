// © VedZone | @vedachal
//@version=6
indicator("Futures Payload — @vedachal", overlay = true, max_lines_count = 60, max_labels_count = 50)

// ═══════════════════════════════════════════════════════════════
// MODULE 1: POSITION SIZE & R-LEVELS — INPUTS
// ═══════════════════════════════════════════════════════════════

grpA = "PS — Asset / Contract Spec"
assetPreset = input.string("MNQ", "Asset Preset", options = ["MNQ","NQ","MES","ES","CL","GC","ZN","6E","CUSTOM"], group = grpA)
customDPP   = input.float(2.0,  "Custom $/point (CUSTOM only)", group = grpA, minval = 0.0001, step = 0.5)
customTick  = input.float(0.25, "Custom Tick Size (CUSTOM only)", group = grpA, minval = 0.00001, step = 0.01)

grpR = "PS — Risk Settings"
fixedRisk = input.float(100.0, "Fixed Dollar Risk ($)", group = grpR, minval = 1.0, step = 10.0)

grpS = "PS — Stop Distance (Primary)"
stopMode   = input.string("Points", "Enter Stop As", options = ["Points","Ticks"], group = grpS)
stopPoints = input.float(5.0, "Stop Distance — Points", group = grpS, minval = 0.0001, step = 0.25)
stopTicks  = input.int(20,    "Stop Distance — Ticks",  group = grpS, minval = 1, step = 1)

grpAlt = "PS — Alternate SL Levels"
showAlt1 = input.bool(false, "Show Alternate SL 1", group = grpAlt)
altPts1  = input.float(5.0,  "Alt SL 1 — Points",   group = grpAlt, minval = 0.0001, step = 0.25)
showAlt2 = input.bool(false, "Show Alternate SL 2",  group = grpAlt)
altPts2  = input.float(10.0, "Alt SL 2 — Points",   group = grpAlt, minval = 0.0001, step = 0.25)

grpE = "PS — Entry"
tradeDir  = input.string("Long", "Trade Direction", options = ["Long","Short"], group = grpE)
base_mode = input.string("Close (live)", "Base Price", options = ["Close (live)","Open","HL2","HLC3","OHLC4"], group = grpE)

grpV = "PS — Appearance — Lines & Labels"
showZone      = input.bool(false, "Show Risk Zone",         group = grpV)
showEntryLine = input.bool(false, "Show Entry Line",        group = grpV)
showSLLine    = input.bool(false, "Show SL Line",           group = grpV)
showTPLines   = input.bool(false, "Show TP Lines (1R 2R 3R)", group = grpV)
showLabels    = input.bool(true,  "Show Price Labels",      group = grpV)
zoneCol       = input.color(color.new(color.red, 88), "Zone Color", group = grpV)

grpT = "PS — Appearance — Tables"
showMainTbl = input.bool(true,   "Show Main Info Table",    group = grpT)
showRefTbl  = input.bool(true,   "Show Size Reference Table", group = grpT)
mainTblPos  = input.string("Bottom Right", "Main Table Position",
     options = ["Bottom Right","Bottom Left","Bottom Center","Top Right","Top Left","Top Center","Middle Right","Middle Left"],
     group = grpT)
refTblPos   = input.string("Bottom Right",  "Ref Table Position",
     options = ["Bottom Right","Bottom Left","Bottom Center","Top Right","Top Left","Top Center","Middle Right","Middle Left"],
     group = grpT)
tblTxtSize  = input.string("Normal", "Table Text Size",
     options = ["Tiny","Small","Normal","Large"],
     group = grpT)
refTxtSize  = input.string("Small",  "Ref Table Text Size",
     options = ["Tiny","Small","Normal","Large"],
     group = grpT)

// ═══════════════════════════════════════════════════════════════
// MODULE 2: RED FOLDER EXPLOIT — INPUTS
// ═══════════════════════════════════════════════════════════════

rfGrp1 = "RF — Level Settings"
entry_dist   = input.float(30,  "Entry Distance (points)", minval=1, step=1,   group=rfGrp1)
tp_dist      = input.float(5,   "TP Distance (points)",    minval=1, step=0.5, group=rfGrp1)

rfGrp2 = "RF — Base Price"
rfBaseMode   = input.string("Close (live)", "Base Price", options=["Close (live)", "Open", "HL2", "HLC3", "OHLC4"], group=rfGrp2)

rfGrp3 = "RF — Appearance"
showRFLines  = input.bool(true, "Show Entry/TP Lines", group=rfGrp3)
line_width   = input.int(2,     "Line Width",             minval=1, maxval=4, group=rfGrp3)
line_style   = input.string("Dashed", "Entry Line Style", options=["Solid", "Dashed", "Dotted"], group=rfGrp3)
color_long   = input.color(color.new(#00E676, 0), "Long Color",  group=rfGrp3)
color_short  = input.color(color.new(#FF1744, 0), "Short Color", group=rfGrp3)
show_labels  = input.bool(true, "Show Price Labels",      group=rfGrp3)
extend_right = input.bool(true, "Extend Lines to Right",  group=rfGrp3)

rfGrp4 = "RF — Table"
show_table   = input.bool(true, "Show Levels Table", group=rfGrp4)
tbl_pos      = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=rfGrp4)

// ═══════════════════════════════════════════════════════════════
// MODULE 1: COLORS & HELPERS
// ═══════════════════════════════════════════════════════════════

clrEntry = color.new(#E0E0E0, 0)
clrStop  = color.new(#FF4560, 0)
clr1R    = color.new(#00E396, 0)
clr2R    = color.new(#00B4D8, 0)
clr3R    = color.new(#FFD60A, 0)
clrAlt1  = color.new(#FF9F43, 0)
clrAlt2  = color.new(#C77DFF, 0)
clrNone  = color.new(color.black, 100)

getDPP(p) =>
    p == "MNQ" ? 2.0 : p == "NQ" ? 20.0 : p == "MES" ? 5.0 : p == "ES" ? 50.0 : p == "CL" ? 1000.0 : p == "GC" ? 100.0 : p == "ZN" ? 1000.0 : p == "6E" ? 125000.0 : customDPP

getTick(p) =>
    p == "MNQ" ? 0.25 : p == "NQ" ? 0.25 : p == "MES" ? 0.25 : p == "ES" ? 0.25 : p == "CL" ? 0.01 : p == "GC" ? 0.10 : p == "ZN" ? 0.0078125 : p == "6E" ? 0.00005 : customTick

getBase() =>
    switch base_mode
        "Open"  => open
        "HL2"   => hl2
        "HLC3"  => hlc3
        "OHLC4" => ohlc4
        => close

toPos(s) =>
    switch s
        "Bottom Right"  => position.bottom_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Top Right"     => position.top_right
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Middle Right"  => position.middle_right
        => position.middle_left

toSz(s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Large"  => size.large
        => size.normal

// ═══════════════════════════════════════════════════════════════
// MODULE 2: HELPERS
// ═══════════════════════════════════════════════════════════════

rfLineStyle(s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

rfTablePos(s) =>
    s == "Top Right"    ? position.top_right    :
     s == "Top Left"     ? position.top_left     :
     s == "Bottom Right" ? position.bottom_right : position.bottom_left

rfBasePrice() =>
    switch rfBaseMode
        "Open"   => open
        "HL2"    => hl2
        "HLC3"   => hlc3
        "OHLC4"  => ohlc4
        => close

// ═══════════════════════════════════════════════════════════════
// MODULE 1: MATH
// ═══════════════════════════════════════════════════════════════

dpp       = getDPP(assetPreset)
tickSz    = getTick(assetPreset)
stopDist  = stopMode == "Ticks" ? float(stopTicks) * tickSz : stopPoints
riskPC    = stopDist * dpp
contracts = riskPC > 0 ? math.floor(fixedRisk / riskPC) : 0
actRisk   = float(contracts) * riskPC
mult      = tradeDir == "Long" ? 1.0 : -1.0

ep    = getBase()
pStop = ep - mult * stopDist
p1r   = ep + mult * stopDist
p2r   = ep + mult * stopDist * 2.0
p3r   = ep + mult * stopDist * 3.0

pStop_a1     = ep - mult * altPts1
p1r_a1       = ep + mult * altPts1
pStop_a2     = ep - mult * altPts2
p1r_a2       = ep + mult * altPts2
contracts_a1 = (altPts1 * dpp) > 0 ? math.floor(fixedRisk / (altPts1 * dpp)) : 0
contracts_a2 = (altPts2 * dpp) > 0 ? math.floor(fixedRisk / (altPts2 * dpp)) : 0

rpc_75   = 7.5  * dpp
cts_75   = rpc_75  > 0 ? math.floor(fixedRisk / rpc_75)  : 0
risk_75  = float(cts_75) * rpc_75

rpc_100  = 10.0 * dpp
cts_100  = rpc_100 > 0 ? math.floor(fixedRisk / rpc_100) : 0
risk_100 = float(cts_100) * rpc_100

rpc_125  = 12.5 * dpp
cts_125  = rpc_125 > 0 ? math.floor(fixedRisk / rpc_125) : 0
risk_125 = float(cts_125) * rpc_125

rpc_150  = 15.0 * dpp
cts_150  = rpc_150 > 0 ? math.floor(fixedRisk / rpc_150) : 0
risk_150 = float(cts_150) * rpc_150

rpc_200  = 20.0 * dpp
cts_200  = rpc_200 > 0 ? math.floor(fixedRisk / rpc_200) : 0
risk_200 = float(cts_200) * rpc_200

act75  = math.abs(7.5  - stopDist) < 0.001
act100 = math.abs(10.0 - stopDist) < 0.001
act125 = math.abs(12.5 - stopDist) < 0.001
act150 = math.abs(15.0 - stopDist) < 0.001
act200 = math.abs(20.0 - stopDist) < 0.001

// ═══════════════════════════════════════════════════════════════
// MODULE 2: LEVEL CALCULATIONS
// ═══════════════════════════════════════════════════════════════

rfBase        = rfBasePrice()
long_entry    = rfBase + entry_dist
long_tp       = rfBase + entry_dist + tp_dist
short_entry   = rfBase - entry_dist
short_tp      = rfBase - entry_dist - tp_dist

// ═══════════════════════════════════════════════════════════════
// MODULE 1: DRAW LINES
// ═══════════════════════════════════════════════════════════════

ext = extend.right

var line lnEntry = na
var line lnStop  = na
var line ln1r    = na
var line ln2r    = na
var line ln3r    = na
var box  bxZone  = na
var line lnA1s   = na
var line lnA1r   = na
var line lnA2s   = na
var line lnA2r   = na

line.delete(lnEntry)
line.delete(lnStop)
line.delete(ln1r)
line.delete(ln2r)
line.delete(ln3r)
box.delete(bxZone)
line.delete(lnA1s)
line.delete(lnA1r)
line.delete(lnA2s)
line.delete(lnA2r)

lnEntry := line.new(bar_index, ep,    bar_index + 1, ep,    xloc = xloc.bar_index, extend = ext, color = showEntryLine ? clrEntry : clrNone, style = line.style_dashed, width = 1)
lnStop  := line.new(bar_index, pStop, bar_index + 1, pStop, xloc = xloc.bar_index, extend = ext, color = showSLLine   ? clrStop  : clrNone, style = line.style_dashed, width = 1)
ln1r    := line.new(bar_index, p1r,   bar_index + 1, p1r,   xloc = xloc.bar_index, extend = ext, color = showTPLines  ? clr1R    : clrNone, style = line.style_dashed, width = 1)
ln2r    := line.new(bar_index, p2r,   bar_index + 1, p2r,   xloc = xloc.bar_index, extend = ext, color = showTPLines  ? clr2R    : clrNone, style = line.style_dashed, width = 1)
ln3r    := line.new(bar_index, p3r,   bar_index + 1, p3r,   xloc = xloc.bar_index, extend = ext, color = showTPLines  ? clr3R    : clrNone, style = line.style_dashed, width = 1)

if showZone
    bxZone := box.new(bar_index, math.max(ep, pStop), bar_index + 1, math.min(ep, pStop), xloc = xloc.bar_index, extend = ext, border_color = color.new(color.red, 100), bgcolor = zoneCol)

if showAlt1
    lnA1s := line.new(bar_index, pStop_a1, bar_index + 1, pStop_a1, xloc = xloc.bar_index, extend = ext, color = showSLLine  ? clrAlt1 : clrNone, style = line.style_dotted, width = 1)
    lnA1r := line.new(bar_index, p1r_a1,   bar_index + 1, p1r_a1,   xloc = xloc.bar_index, extend = ext, color = showTPLines ? clrAlt1 : clrNone, style = line.style_dotted, width = 1)

if showAlt2
    lnA2s := line.new(bar_index, pStop_a2, bar_index + 1, pStop_a2, xloc = xloc.bar_index, extend = ext, color = showSLLine  ? clrAlt2 : clrNone, style = line.style_dotted, width = 1)
    lnA2r := line.new(bar_index, p1r_a2,   bar_index + 1, p1r_a2,   xloc = xloc.bar_index, extend = ext, color = showTPLines ? clrAlt2 : clrNone, style = line.style_dotted, width = 1)

// ═══════════════════════════════════════════════════════════════
// MODULE 1: LABELS
// ═══════════════════════════════════════════════════════════════

var label lbEntry = na
var label lbStop  = na
var label lb1r    = na
var label lb2r    = na
var label lb3r    = na
var label lbA1s   = na
var label lbA1r   = na
var label lbA2s   = na
var label lbA2r   = na

label.delete(lbEntry)
label.delete(lbStop)
label.delete(lb1r)
label.delete(lb2r)
label.delete(lb3r)
label.delete(lbA1s)
label.delete(lbA1r)
label.delete(lbA2s)
label.delete(lbA2r)

labelVis(c) => showLabels ? c : clrNone

sl_txt = "SL  " + str.tostring(stopDist, "#.##") + " pts   SIZE " + str.tostring(contracts) + "   Risk $" + str.tostring(math.round(actRisk))

lbEntry := label.new(bar_index, ep,    "ENTRY  " + str.tostring(ep, "#.##"),                    xloc = xloc.bar_index, style = label.style_label_lower_left, color = clrNone, textcolor = labelVis(clrEntry), size = size.normal)
lbStop  := label.new(bar_index, pStop, sl_txt,                                                  xloc = xloc.bar_index, style = label.style_label_upper_left, color = clrNone, textcolor = labelVis(clrStop),  size = size.normal)
lb1r    := label.new(bar_index, p1r,   "1R  +" + str.tostring(stopDist, "#.##") + " pts",       xloc = xloc.bar_index, style = label.style_label_lower_left, color = clrNone, textcolor = labelVis(clr1R),    size = size.normal)
lb2r    := label.new(bar_index, p2r,   "2R  +" + str.tostring(stopDist * 2.0, "#.##") + " pts", xloc = xloc.bar_index, style = label.style_label_lower_left, color = clrNone, textcolor = labelVis(clr2R),    size = size.normal)
lb3r    := label.new(bar_index, p3r,   "3R  +" + str.tostring(stopDist * 3.0, "#.##") + " pts", xloc = xloc.bar_index, style = label.style_label_lower_left, color = clrNone, textcolor = labelVis(clr3R),    size = size.normal)

if showAlt1
    lbA1s := label.new(bar_index, pStop_a1, "ALT SL1  " + str.tostring(altPts1, "#.##") + " pts  SIZE " + str.tostring(contracts_a1), xloc = xloc.bar_index, style = label.style_label_upper_left, color = clrNone, textcolor = labelVis(clrAlt1), size = size.normal)
    lbA1r := label.new(bar_index, p1r_a1,   "ALT 1R1", xloc = xloc.bar_index, style = label.style_label_lower_left, color = clrNone, textcolor = labelVis(clrAlt1), size = size.normal)

if showAlt2
    lbA2s := label.new(bar_index, pStop_a2, "ALT SL2  " + str.tostring(altPts2, "#.##") + " pts  SIZE " + str.tostring(contracts_a2), xloc = xloc.bar_index, style = label.style_label_upper_left, color = clrNone, textcolor = labelVis(clrAlt2), size = size.normal)
    lbA2r := label.new(bar_index, p1r_a2,   "ALT 1R2", xloc = xloc.bar_index, style = label.style_label_lower_left, color = clrNone, textcolor = labelVis(clrAlt2), size = size.normal)

// ═══════════════════════════════════════════════════════════════
// MODULE 2: DRAW LINES
// ═══════════════════════════════════════════════════════════════

extRF = extend_right ? extend.right : extend.none
ls    = rfLineStyle(line_style)
rfClrNone = color.new(color.black, 100)

var line ln_long_entry  = na
var line ln_long_tp     = na
var line ln_short_entry = na
var line ln_short_tp    = na

line.delete(ln_long_entry)
line.delete(ln_long_tp)
line.delete(ln_short_entry)
line.delete(ln_short_tp)

ln_long_entry  := line.new(bar_index, long_entry,  bar_index + 1, long_entry,  xloc=xloc.bar_index, extend=extRF, color=showRFLines ? color_long  : rfClrNone, style=ls,               width=line_width)
ln_long_tp     := line.new(bar_index, long_tp,     bar_index + 1, long_tp,     xloc=xloc.bar_index, extend=extRF, color=showRFLines ? color_long  : rfClrNone, style=line.style_solid, width=line_width)
ln_short_entry := line.new(bar_index, short_entry, bar_index + 1, short_entry, xloc=xloc.bar_index, extend=extRF, color=showRFLines ? color_short : rfClrNone, style=ls,               width=line_width)
ln_short_tp    := line.new(bar_index, short_tp,    bar_index + 1, short_tp,    xloc=xloc.bar_index, extend=extRF, color=showRFLines ? color_short : rfClrNone, style=line.style_solid, width=line_width)

// ═══════════════════════════════════════════════════════════════
// MODULE 2: PRICE LABELS
// ═══════════════════════════════════════════════════════════════

var label lb_long_entry  = na
var label lb_long_tp     = na
var label lb_short_entry = na
var label lb_short_tp    = na

label.delete(lb_long_entry)
label.delete(lb_long_tp)
label.delete(lb_short_entry)
label.delete(lb_short_tp)

if show_labels
    bg_long_e  = color.new(color_long,  15)
    bg_long_tp = color.new(color_long,  40)
    bg_shrt_e  = color.new(color_short, 15)
    bg_shrt_tp = color.new(color_short, 40)

    lb_long_entry  := label.new(bar_index, long_entry,  "▲ BUY STOP  " + str.tostring(long_entry,  "#.##"), xloc=xloc.bar_index, style=label.style_label_left, color=bg_long_e,  textcolor=color.white, size=size.small)
    lb_long_tp     := label.new(bar_index, long_tp,     "✦ LONG TP   " + str.tostring(long_tp,     "#.##"), xloc=xloc.bar_index, style=label.style_label_left, color=bg_long_tp, textcolor=color.white, size=size.small)
    lb_short_entry := label.new(bar_index, short_entry, "▼ SELL STOP " + str.tostring(short_entry, "#.##"), xloc=xloc.bar_index, style=label.style_label_left, color=bg_shrt_e,  textcolor=color.white, size=size.small)
    lb_short_tp    := label.new(bar_index, short_tp,    "✦ SHORT TP  " + str.tostring(short_tp,    "#.##"), xloc=xloc.bar_index, style=label.style_label_left, color=bg_shrt_tp, textcolor=color.white, size=size.small)

// ═══════════════════════════════════════════════════════════════
// TABLES (both modules, barstate.islast)
// ═══════════════════════════════════════════════════════════════

if barstate.islast
    mainPos = toPos(mainTblPos)
    refPos  = toPos(refTblPos)
    sz      = toSz(tblTxtSize)
    sz2     = toSz(refTxtSize)

    // ── MODULE 1: MAIN INFO TABLE ─────────────────────────────
    if showMainTbl
        var table tbl = table.new(mainPos, 2, 6, bgcolor = color.new(#0a0a14, 80), border_color = color.new(color.gray, 50), border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 1)
        hdr = color.new(#1a1a2e, 0)
        cel = color.new(#0d0d1a, 0)

        table.cell(tbl, 0, 0, "Futures Payload  |  " + assetPreset, text_color = color.new(#CEFF1A, 0), bgcolor = hdr, text_size = sz, text_halign = text.align_center)
        table.cell(tbl, 1, 0, tradeDir, text_color = tradeDir == "Long" ? clr1R : clrStop, bgcolor = hdr, text_size = sz, text_halign = text.align_center)

        table.cell(tbl, 0, 1, "Stop Distance",   text_color = color.silver, bgcolor = cel, text_size = sz, text_halign = text.align_left)
        table.cell(tbl, 1, 1, str.tostring(stopDist, "#.##") + " pts", text_color = clrStop, bgcolor = cel, text_size = sz, text_halign = text.align_right)

        table.cell(tbl, 0, 2, "Risk / Contract", text_color = color.silver, bgcolor = cel, text_size = sz, text_halign = text.align_left)
        table.cell(tbl, 1, 2, "$" + str.tostring(math.round(riskPC)), text_color = color.white, bgcolor = cel, text_size = sz, text_halign = text.align_right)

        table.cell(tbl, 0, 3, "Contract Size",   text_color = color.silver, bgcolor = cel, text_size = sz, text_halign = text.align_left)
        table.cell(tbl, 1, 3, str.tostring(contracts), text_color = contracts > 0 ? clr1R : color.orange, bgcolor = cel, text_size = sz, text_halign = text.align_right)

        table.cell(tbl, 0, 4, "Actual Risk",     text_color = color.silver, bgcolor = cel, text_size = sz, text_halign = text.align_left)
        table.cell(tbl, 1, 4, "$" + str.tostring(math.round(actRisk)), text_color = clrStop, bgcolor = cel, text_size = sz, text_halign = text.align_right)

        rr_txt = "1R $" + str.tostring(math.round(actRisk)) + "   2R $" + str.tostring(math.round(actRisk * 2)) + "   3R $" + str.tostring(math.round(actRisk * 3))
        table.cell(tbl, 0, 5, rr_txt, text_color = clr1R, bgcolor = hdr, text_size = size.small, text_halign = text.align_center)
        table.cell(tbl, 1, 5, "", bgcolor = hdr)

    // ── MODULE 1: SIZE REFERENCE TABLE ────────────────────────
    if showRefTbl
        var table tbl2 = table.new(refPos, 3, 7, bgcolor = color.new(#0a0a14, 80), border_color = color.new(color.gray, 50), border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 1)
        hdr2 = color.new(#1a1a2e, 0)
        cel2 = color.new(#0d0d1a, 0)
        act  = color.new(#0d200d, 0)

        table.cell(tbl2, 0, 0, "STOP",      text_color = color.new(#CEFF1A, 0), bgcolor = hdr2, text_size = sz2, text_halign = text.align_center)
        table.cell(tbl2, 1, 0, "CONTRACTS", text_color = color.new(#CEFF1A, 0), bgcolor = hdr2, text_size = sz2, text_halign = text.align_center)
        table.cell(tbl2, 2, 0, "RISK $",    text_color = color.new(#CEFF1A, 0), bgcolor = hdr2, text_size = sz2, text_halign = text.align_center)

        bg1 = act75 ? act : cel2
        pc1 = act75 ? color.new(#CEFF1A, 0) : color.silver
        cc1 = act75 ? clr1R : color.white
        rc1 = act75 ? clrStop : color.new(#aaaaaa, 0)
        table.cell(tbl2, 0, 1, "7.5 pts",  text_color = pc1, bgcolor = bg1, text_size = sz2, text_halign = text.align_left)
        table.cell(tbl2, 1, 1, str.tostring(cts_75),                    text_color = cc1, bgcolor = bg1, text_size = sz2, text_halign = text.align_center)
        table.cell(tbl2, 2, 1, "$" + str.tostring(math.round(risk_75)), text_color = rc1, bgcolor = bg1, text_size = sz2, text_halign = text.align_right)

        bg2 = act100 ? act : cel2
        pc2 = act100 ? color.new(#CEFF1A, 0) : color.silver
        cc2 = act100 ? clr1R : color.white
        rc2 = act100 ? clrStop : color.new(#aaaaaa, 0)
        table.cell(tbl2, 0, 2, "10.0 pts", text_color = pc2, bgcolor = bg2, text_size = sz2, text_halign = text.align_left)
        table.cell(tbl2, 1, 2, str.tostring(cts_100),                    text_color = cc2, bgcolor = bg2, text_size = sz2, text_halign = text.align_center)
        table.cell(tbl2, 2, 2, "$" + str.tostring(math.round(risk_100)), text_color = rc2, bgcolor = bg2, text_size = sz2, text_halign = text.align_right)

        bg3 = act125 ? act : cel2
        pc3 = act125 ? color.new(#CEFF1A, 0) : color.silver
        cc3 = act125 ? clr1R : color.white
        rc3 = act125 ? clrStop : color.new(#aaaaaa, 0)
        table.cell(tbl2, 0, 3, "12.5 pts", text_color = pc3, bgcolor = bg3, text_size = sz2, text_halign = text.align_left)
        table.cell(tbl2, 1, 3, str.tostring(cts_125),                    text_color = cc3, bgcolor = bg3, text_size = sz2, text_halign = text.align_center)
        table.cell(tbl2, 2, 3, "$" + str.tostring(math.round(risk_125)), text_color = rc3, bgcolor = bg3, text_size = sz2, text_halign = text.align_right)

        bg4 = act150 ? act : cel2
        pc4 = act150 ? color.new(#CEFF1A, 0) : color.silver
        cc4 = act150 ? clr1R : color.white
        rc4 = act150 ? clrStop : color.new(#aaaaaa, 0)
        table.cell(tbl2, 0, 4, "15.0 pts", text_color = pc4, bgcolor = bg4, text_size = sz2, text_halign = text.align_left)
        table.cell(tbl2, 1, 4, str.tostring(cts_150),                    text_color = cc4, bgcolor = bg4, text_size = sz2, text_halign = text.align_center)
        table.cell(tbl2, 2, 4, "$" + str.tostring(math.round(risk_150)), text_color = rc4, bgcolor = bg4, text_size = sz2, text_halign = text.align_right)

        bg5 = act200 ? act : cel2
        pc5 = act200 ? color.new(#CEFF1A, 0) : color.silver
        cc5 = act200 ? clr1R : color.white
        rc5 = act200 ? clrStop : color.new(#aaaaaa, 0)
        table.cell(tbl2, 0, 5, "20.0 pts", text_color = pc5, bgcolor = bg5, text_size = sz2, text_halign = text.align_left)
        table.cell(tbl2, 1, 5, str.tostring(cts_200),                    text_color = cc5, bgcolor = bg5, text_size = sz2, text_halign = text.align_center)
        table.cell(tbl2, 2, 5, "$" + str.tostring(math.round(risk_200)), text_color = rc5, bgcolor = bg5, text_size = sz2, text_halign = text.align_right)

        table.cell(tbl2, 0, 6, "YOUR STOP → " + str.tostring(stopDist, "#.##") + " pts", text_color = color.new(#CEFF1A, 0), bgcolor = hdr2, text_size = size.tiny, text_halign = text.align_left)
        table.cell(tbl2, 1, 6, str.tostring(contracts),                 text_color = clr1R,   bgcolor = hdr2, text_size = size.tiny, text_halign = text.align_center)
        table.cell(tbl2, 2, 6, "$" + str.tostring(math.round(actRisk)), text_color = clrStop, bgcolor = hdr2, text_size = size.tiny, text_halign = text.align_right)

    // ── MODULE 2: LEVELS TABLE ─────────────────────────────────
    if show_table
        var table t = table.new(rfTablePos(tbl_pos), 3, 8, border_width=1, border_color=color.new(color.gray, 60), frame_color=color.new(color.gray, 60), frame_width=1)

        hdr_bg   = color.new(#1A1A2E, 0)
        long_bg  = color.new(color.new(color_long,  75), 0)
        short_bg = color.new(color.new(color_short, 75), 0)
        val_bg   = color.new(#0D0D1A, 0)

        table.cell(t, 0, 0, "PASS PROPFIRM IN ONE TRADE", text_color=color.white, bgcolor=hdr_bg, text_size=size.normal, text_halign=text.align_center)
        table.cell(t, 1, 0, "", bgcolor=hdr_bg)
        table.cell(t, 2, 0, "", bgcolor=hdr_bg)

        table.cell(t, 0, 1, "LEVEL",  text_color=color.new(color.gray, 20), bgcolor=hdr_bg, text_size=size.small)
        table.cell(t, 1, 1, "PRICE",  text_color=color.new(color.gray, 20), bgcolor=hdr_bg, text_size=size.small)
        table.cell(t, 2, 1, "DIST",   text_color=color.new(color.gray, 20), bgcolor=hdr_bg, text_size=size.small)

        table.cell(t, 0, 2, "✦ Long TP",   text_color=color_long,  bgcolor=long_bg, text_size=size.small)
        table.cell(t, 1, 2, str.tostring(long_tp,     "#.##"), text_color=color.white, bgcolor=val_bg, text_size=size.small)
        table.cell(t, 2, 2, "+" + str.tostring(entry_dist + tp_dist, "#") + " pts", text_color=color_long, bgcolor=val_bg, text_size=size.small)

        table.cell(t, 0, 3, "▲ Buy Stop",  text_color=color_long,  bgcolor=long_bg, text_size=size.small)
        table.cell(t, 1, 3, str.tostring(long_entry,  "#.##"), text_color=color.white, bgcolor=val_bg, text_size=size.small)
        table.cell(t, 2, 3, "+" + str.tostring(entry_dist, "#") + " pts", text_color=color_long, bgcolor=val_bg, text_size=size.small)

        table.cell(t, 0, 4, "● Base",      text_color=color.gray,  bgcolor=hdr_bg,  text_size=size.small)
        table.cell(t, 1, 4, str.tostring(rfBase, "#.##"), text_color=color.white, bgcolor=val_bg, text_size=size.small)
        table.cell(t, 2, 4, "—",           text_color=color.gray,  bgcolor=val_bg,  text_size=size.small)

        table.cell(t, 0, 5, "▼ Sell Stop", text_color=color_short, bgcolor=short_bg, text_size=size.small)
        table.cell(t, 1, 5, str.tostring(short_entry, "#.##"), text_color=color.white, bgcolor=val_bg, text_size=size.small)
        table.cell(t, 2, 5, "-" + str.tostring(entry_dist, "#") + " pts", text_color=color_short, bgcolor=val_bg, text_size=size.small)

        table.cell(t, 0, 6, "✦ Short TP",  text_color=color_short, bgcolor=short_bg, text_size=size.small)
        table.cell(t, 1, 6, str.tostring(short_tp,    "#.##"), text_color=color.white, bgcolor=val_bg, text_size=size.small)
        table.cell(t, 2, 6, "-" + str.tostring(entry_dist + tp_dist, "#") + " pts", text_color=color_short, bgcolor=val_bg, text_size=size.small)

        table.cell(t, 0, 7, "Place orders before news. Cancel opposite on fill.", text_color=color.new(color.gray, 30), bgcolor=hdr_bg, text_size=size.small, text_halign=text.align_center)
        table.cell(t, 1, 7, "", bgcolor=hdr_bg)
        table.cell(t, 2, 7, "", bgcolor=hdr_bg)
