//@version=6
indicator("ProfitsFX — Fib Retracement", overlay=true, max_lines_count=30, max_labels_count=30)

// ─────────────────────────────────────────────
//  INPUTS
// ─────────────────────────────────────────────

var string GRP_SWING  = "📍 Define Your Swing"
var string GRP_LEVELS = "📐 Fib Levels"
var string GRP_STYLE  = "🎨 Style"

// Swing prices — type directly from chart
swing_hi_input = input.price(0.0, "Swing HIGH price",  group=GRP_SWING, confirm=true,
     tooltip="Click the swing HIGH on the chart, or type the price manually.")
swing_lo_input = input.price(0.0, "Swing LOW price",   group=GRP_SWING, confirm=true,
     tooltip="Click the swing LOW on the chart, or type the price manually.")

// Level toggles
show_0   = input.bool(true,  "0%",           group=GRP_LEVELS, inline="L0")
show_236 = input.bool(true,  "23.6%",        group=GRP_LEVELS, inline="L1")
show_382 = input.bool(true,  "38.2%",        group=GRP_LEVELS, inline="L2")
show_500 = input.bool(true,  "50%",          group=GRP_LEVELS, inline="L3")
show_618 = input.bool(true,  "61.8%",        group=GRP_LEVELS, inline="L4")
show_705 = input.bool(false, "70.5%",        group=GRP_LEVELS, inline="L5")
show_786 = input.bool(true,  "78.6%",        group=GRP_LEVELS, inline="L6")
show_100 = input.bool(true,  "100%",         group=GRP_LEVELS, inline="L7")
show_127 = input.bool(false, "127.2% (Ext)", group=GRP_LEVELS, inline="L8")
show_162 = input.bool(false, "161.8% (Ext)", group=GRP_LEVELS, inline="L9")
show_200 = input.bool(false, "200%   (Ext)", group=GRP_LEVELS, inline="L10")

// Style
col_0_100      = input.color(color.new(#EF9F27, 0), "0% / 100% color",           group=GRP_STYLE)
col_key        = input.color(color.new(#1D9E75, 0), "Key levels (38.2/50/61.8)", group=GRP_STYLE)
col_minor      = input.color(color.new(#6b7a99, 0), "Minor levels",              group=GRP_STYLE)
col_ext        = input.color(color.new(#F23645, 0), "Extension levels",          group=GRP_STYLE)
line_width     = input.int(1, "Line width", minval=1, maxval=4, group=GRP_STYLE)
line_style_sel = input.string("Solid", "Line style", options=["Solid","Dashed","Dotted"], group=GRP_STYLE)
show_labels    = input.bool(true, "Show price labels", group=GRP_STYLE)
show_pct_label = input.bool(true, "Show % on label",  group=GRP_STYLE)
label_size_sel = input.string("Small", "Label size", options=["Tiny","Small","Normal","Large"], group=GRP_STYLE)
extend_right   = input.bool(true, "Extend lines right", group=GRP_STYLE)

// ─────────────────────────────────────────────
//  SWING RESOLUTION  — high/low from price inputs
// ─────────────────────────────────────────────

// Auto-detect which is higher so direction doesn't matter
swing_hi = math.max(swing_hi_input, swing_lo_input)
swing_lo = math.min(swing_hi_input, swing_lo_input)
range_sz = swing_hi - swing_lo

// Bullish = retracing from high down; bearish = retracing from low up
// Standard fib: levels between 0% (high) and 100% (low) for a pullback
fib_price(float pct) =>
    swing_hi - range_sz * pct

p0   = fib_price(0.000)
p236 = fib_price(0.236)
p382 = fib_price(0.382)
p500 = fib_price(0.500)
p618 = fib_price(0.618)
p705 = fib_price(0.705)
p786 = fib_price(0.786)
p100 = fib_price(1.000)
p127 = fib_price(1.272)
p162 = fib_price(1.618)
p200 = fib_price(2.000)

// ─────────────────────────────────────────────
//  PERSISTENT DRAW ARRAYS
// ─────────────────────────────────────────────

var line[]  drawn_lines  = array.new<line>()
var label[] drawn_labels = array.new<label>()

// ─────────────────────────────────────────────
//  DRAW FUNCTION
// ─────────────────────────────────────────────

draw_level(float price, string pct_str, color col, bool show, int x1, int x2, int lw) =>
    if show
        ls = line_style_sel == "Dashed" ? line.style_dashed :
             line_style_sel == "Dotted" ? line.style_dotted :
             line.style_solid

        ext = extend_right ? extend.right : extend.none

        lsz = label_size_sel == "Tiny"   ? size.tiny   :
              label_size_sel == "Normal" ? size.normal :
              label_size_sel == "Large"  ? size.large  :
              size.small

        txt = ""
        if show_labels
            txt := show_pct_label ? pct_str + "  " + str.tostring(math.round(price, 2)) :
                   str.tostring(math.round(price, 2))

        ln = line.new(x1, price, x2, price,
             color=col, width=lw, style=ls, extend=ext)
        lb = label.new(x2, price,
             text=txt,
             color=color.new(color.black, 100),
             textcolor=col,
             style=label.style_label_left,
             size=lsz)

        array.push(drawn_lines,  ln)
        array.push(drawn_labels, lb)

// ─────────────────────────────────────────────
//  MAIN — redraw every bar so levels stay live
// ─────────────────────────────────────────────

if barstate.islast and range_sz > 0

    // Clear old draws
    for ln in drawn_lines
        line.delete(ln)
    for lb in drawn_labels
        label.delete(lb)
    array.clear(drawn_lines)
    array.clear(drawn_labels)

    x1 = bar_index - 50   // anchor left side 50 bars back
    x2 = bar_index

    draw_level(p0,   "0%",     col_0_100, show_0,   x1, x2, line_width)
    draw_level(p236, "23.6%",  col_minor, show_236, x1, x2, line_width)
    draw_level(p382, "38.2%",  col_key,   show_382, x1, x2, line_width)
    draw_level(p500, "50%",    col_key,   show_500, x1, x2, line_width)
    draw_level(p618, "61.8%",  col_key,   show_618, x1, x2, line_width)
    draw_level(p705, "70.5%",  col_minor, show_705, x1, x2, line_width)
    draw_level(p786, "78.6%",  col_minor, show_786, x1, x2, line_width)
    draw_level(p100, "100%",   col_0_100, show_100, x1, x2, line_width)
    draw_level(p127, "127.2%", col_ext,   show_127, x1, x2, line_width)
    draw_level(p162, "161.8%", col_ext,   show_162, x1, x2, line_width)
    draw_level(p200, "200%",   col_ext,   show_200, x1, x2, line_width)

    // Swing range box
    box.new(x1, swing_hi, x2, swing_lo,
         border_color=color.new(#EF9F27, 80),
         bgcolor=color.new(#EF9F27, 95),
         border_width=1)

    // HIGH label
    label.new(x1, swing_hi,
         text="▲ HIGH  " + str.tostring(math.round(swing_hi, 2)),
         color=color.new(#EF9F27, 85),
         textcolor=#EF9F27,
         style=label.style_label_down,
         size=size.small)

    // LOW label
    label.new(x1, swing_lo,
         text="▼ LOW  " + str.tostring(math.round(swing_lo, 2)),
         color=color.new(#1D9E75, 85),
         textcolor=#1D9E75,
         style=label.style_label_up,
         size=size.small)
