//@version=6
strategy(
    title="[st]BTC 4H Trend v4 LongOnly",
    overlay=true,
    initial_capital=300000,
    currency=currency.JPY,
    default_qty_type=strategy.percent_of_equity,
    default_qty_value=10,
    commission_type=strategy.commission.percent,
    commission_value=0.02,
    slippage=2
)

// ─── パラメータ ───────────────────────────────────────────
emaFastL  = input.int(21,   "短期EMA",        group="EMA設定")
emaSlowL  = input.int(55,   "長期EMA",        group="EMA設定")
emaTrendL = input.int(200,  "トレンドEMA",    group="EMA設定")

rsiLen = input.int(14, "RSI期間",  group="RSI設定")
rsiOB  = input.int(70, "RSI上限",  group="RSI設定")

atrLen   = input.int(14,    "ATR期間",           group="リスク設定")
atrSLMul = input.float(1.5, "SL倍率",            group="リスク設定")
atrTPMul = input.float(3.0, "TP倍率",            group="リスク設定")
trailMul = input.float(1.5, "トレールATR倍率",   group="リスク設定")

useTrend = input.bool(true,  "トレンドフィルター（EMA200）", group="フィルター")
useShort = input.bool(false, "ショート有効（推奨: OFF）",   group="フィルター")

alertLongEntry  = input.string("LONG_ENTRY",  "ロングエントリーAlertメッセージ",   group="アラート設定")
alertLongExit   = input.string("LONG_EXIT",   "ロング決済Alertメッセージ",         group="アラート設定")
alertShortEntry = input.string("SHORT_ENTRY", "ショートエントリーAlertメッセージ", group="アラート設定")
alertShortExit  = input.string("SHORT_EXIT",  "ショート決済Alertメッセージ",       group="アラート設定")

// ─── 計算 ─────────────────────────────────────────────────
emaFast  = ta.ema(close, emaFastL)
emaSlow  = ta.ema(close, emaSlowL)
emaTrend = ta.ema(close, emaTrendL)
rsiVal   = ta.rsi(close, rsiLen)
atrVal   = ta.atr(atrLen)

// ─── トレンド判定 ─────────────────────────────────────────
bull      = not useTrend or close > emaTrend
bear      = not useTrend or close < emaTrend
trendUp   = emaTrend > emaTrend[3]
trendDown = emaTrend < emaTrend[3]

// ─── シグナル ─────────────────────────────────────────────
longCross  = ta.crossover(emaFast, emaSlow)
shortCross = ta.crossunder(emaFast, emaSlow)

longPull  = emaFast > emaSlow and close > emaFast and close[1] < emaFast
shortPull = emaFast < emaSlow and close < emaFast and close[1] > emaFast

// ─── エントリー条件 ───────────────────────────────────────
longCond  = (longCross  or longPull)  and bull  and trendUp   and rsiVal < rsiOB and strategy.position_size == 0
shortCond = (shortCross or shortPull) and bear  and trendDown and rsiVal > 30    and strategy.position_size == 0 and useShort

// ─── 決済 ─────────────────────────────────────────────────
sl    = atrVal * atrSLMul
tp    = atrVal * atrTPMul
trail = atrVal * trailMul

if longCond
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long",
                  stop         = close - sl,
                  limit        = close + tp,
                  trail_points = trail,
                  trail_offset = trail)
    alert(alertLongEntry, alert.freq_once_per_bar_close)

if shortCond
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short",
                  stop         = close + sl,
                  limit        = close - tp,
                  trail_points = trail,
                  trail_offset = trail)
    alert(alertShortEntry, alert.freq_once_per_bar_close)

if strategy.position_size[1] > 0 and strategy.position_size == 0
    alert(alertLongExit, alert.freq_once_per_bar_close)

if strategy.position_size[1] < 0 and strategy.position_size == 0
    alert(alertShortExit, alert.freq_once_per_bar_close)

// ─── 表示 ─────────────────────────────────────────────────
plot(emaFast,  "EMA短期", color=color.aqua)
plot(emaSlow,  "EMA長期", color=color.yellow)
plot(emaTrend, "EMA200",  color=color.gray)

plotshape(longCond,  title="ロング",   location=location.belowbar, color=color.lime, style=shape.triangleup)
plotshape(shortCond, title="ショート", location=location.abovebar, color=color.red,  style=shape.triangledown)

bgcolor(strategy.position_size > 0 ? color.new(color.green, 90) : na)
bgcolor(strategy.position_size < 0 ? color.new(color.red,   90) : na)