//@version=6
indicator("MA20 vs MA200 Fill", overlay=true)

ma20 = ta.sma(close, 20)
ma200 = ta.sma(close, 200)

p1 = plot(ma20, color=color.blue, linewidth=2, title="MA20")
p2 = plot(ma200, color=color.orange, linewidth=2, title="MA200")

fillColor = ma20 > ma200 ? color.new(color.green, 80) : color.new(color.red, 80)
fill(p1, p2, color=fillColor)// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
