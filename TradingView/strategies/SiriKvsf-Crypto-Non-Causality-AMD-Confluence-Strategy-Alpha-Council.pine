//@version=6
strategy("Crypto Non-Causality & AMD Confluence Strategy [Alpha Council]", "Crypto-NCS Strat v6", overlay=true, initial_capital=2000, margin_long=1, margin_short=1, pyramiding=10, max_labels_count=500, max_lines_count=500, max_boxes_count=500, commission_type=strategy.commission.percent, commission_value=0.05)

// =========================================================================
// 1. INPUTS & CONFIGURATION
// =========================================================================
string GRP_MAP    = "1. Spatial Map & DSP (Non-Causal/Adaptive)"
float  fastLimit  = input.float(0.5, "MAMA Fast Limit", group=GRP_MAP)
float  slowLimit  = input.float(0.05, "MAMA Slow Limit", group=GRP_MAP)
float  lagGamma   = input.float(0.5, "Laguerre Filter Gamma", group=GRP_MAP)

string GRP_HMM    = "2. HMM Regime Detector (Calm Before Storm)"
bool   useHmm     = input.bool(true, "Enable HMM Regime Engine", group=GRP_HMM, tooltip="Activates the Viterbi-approximated HMM to detect latent regimes, preventing entries in hostile trends and finding 'Calm Before the Storm' compression zones.")
bool   showHmmBg  = input.bool(true, "Show Regime Background Fills", group=GRP_HMM)

string GRP_AMD    = "3. Structural Behavioral Mapping (AMD Sessions)"
string sess_asia  = input.session("0000-0800", "Asian Session (Accumulation)", group=GRP_AMD)
string sess_lon   = input.session("0800-1600", "London Session (Manipulation)", group=GRP_AMD)
string sess_ny    = input.session("1300-2100", "NY Session (Distribution)", group=GRP_AMD)

string GRP_ACV    = "4. ACV & Causality (Hurst & DXY)"
int    hurstLen   = input.int(30, "Hurst Exponent Lookback", group=GRP_ACV)
string dxyTicker  = input.symbol("TVC:DXY", "Causal Cross-Mapping Ticker", group=GRP_ACV)

string GRP_STRAT  = "5. Strategy Engine (Martingale & Risk)"
bool   longOnly   = input.bool(false, "Long-Only Mode", group=GRP_STRAT, tooltip="Disables all short entries and signals.")
bool   compoundWins = input.bool(true, "Compound Wins (Equity Scaling)", group=GRP_STRAT, tooltip="Scales your base margin as account equity grows. Martingale steps multiply this compounded base.")
float  baseMargin = input.float(50.0, "Base Margin ($)", group=GRP_STRAT)
float  leverage   = input.float(100.0, "Account Leverage", group=GRP_STRAT)
int    maxDoubs   = input.int(5, "Max Martingale Doublings", group=GRP_STRAT)
float  dynTpPct   = input.float(0.2, "Dynamic TP Threshold (%)", group=GRP_STRAT) / 100.0
float  logSlPct   = input.float(2.0, "Logical Stop Loss (%)", group=GRP_STRAT) / 100.0
float  catSlPct   = input.float(4.0, "Catastrophic Wick SL (%)", group=GRP_STRAT) / 100.0
int    emaTpLen   = input.int(5, "Fast EMA Length (TP Exit)", group=GRP_STRAT)

// Color Palette
color COL_BULL = #00E676
color COL_BEAR = #FF1744
color COL_NEUT = color.gray
color COL_CALM = color.purple
color COL_ASIA = color.new(color.purple, 85)
color COL_LON  = color.new(color.blue, 85)
color COL_NY   = color.new(color.orange, 85)

// =========================================================================
// 2. FRACTALITY & HMM REGIME DETECTOR (VITERBI APPROXIMATION)
// =========================================================================
// Hurst Exponent Proxy
float atr_sum = math.sum(ta.atr(1), hurstLen)
float hh      = ta.highest(high, hurstLen)
float ll      = ta.lowest(low, hurstLen)
float hurst   = math.log10(atr_sum / math.max(hh - ll, 1e-10)) / math.log10(hurstLen)
hurst := 1.0 - hurst 

// Volatility Compression / Entropy
float atr14 = ta.atr(14)
float atr50 = ta.sma(atr14, 50)
float vol_ratio = atr50 > 0 ? atr14 / atr50 : 1.0

// Micro-CVD (Cumulative Volume Delta)
var float ltf_cvd = 0.0
ltf_cvd += (close > open ? volume : (close < open ? -volume : 0))
float cvd_delta = ltf_cvd - nz(ltf_cvd[1])

// Kinetics (ADX & RSI)
[di_plus, di_minus, adx_val] = ta.dmi(14, 14)
float rsi_val = ta.rsi(close, 14)

// HMM Emission Probabilities
float e_bull = (rsi_val > 50 ? 1.0 : 0.0) + (di_plus > di_minus and adx_val > 20 ? 1.0 : 0.0) + (cvd_delta > 0 ? 1.0 : 0.0)
float e_bear = (rsi_val < 50 ? 1.0 : 0.0) + (di_minus > di_plus and adx_val > 20 ? 1.0 : 0.0) + (cvd_delta < 0 ? 1.0 : 0.0)

// HMM State Decoder
var int hmm_state = 0 // 0 = Chop, 1 = Bull Trend, -1 = Bear Trend, 2 = Kinetic Trap (Calm Before Storm)
if useHmm
    if vol_ratio < 0.65 and hurst < 0.55
        hmm_state := 2 // The "Calm Before the Storm"
    else if hurst > 0.5 and adx_val > 20
        if e_bull > e_bear and e_bull >= 2
            hmm_state := 1
        else if e_bear > e_bull and e_bear >= 2
            hmm_state := -1
        else
            hmm_state := 0
    else
        hmm_state := 0
else
    hmm_state := hurst < 0.5 ? 0 : (close > ta.sma(close, 50) ? 1 : -1)

// Background Fills
color bg_col = na
if showHmmBg and useHmm
    if hmm_state == 2
        bg_col := color.new(COL_CALM, 90)
    else if hmm_state == 1
        bg_col := color.new(COL_BULL, 92)
    else if hmm_state == -1
        bg_col := color.new(COL_BEAR, 92)
    else
        bg_col := color.new(COL_NEUT, 95)
bgcolor(bg_col, title="HMM Regime Background")

// =========================================================================
// 3. DIGITAL SIGNAL PROCESSING: MAMA, FAMA & HILBERT PHASE SPACE
// =========================================================================
float pr = hl2
var float smooth = 0.0, var float detrender = 0.0
var float I1 = 0.0, var float Q1 = 0.0
var float jI = 0.0, var float jQ = 0.0
var float I2 = 0.0, var float Q2 = 0.0
var float Re = 0.0, var float Im = 0.0
var float period = 0.0, var float smoothPeriod = 0.0
var float phase = 0.0, var float deltaPhase = 0.0

smooth := (4*pr + 3*nz(pr[1]) + 2*nz(pr[2]) + nz(pr[3])) / 10
detrender := (0.0962*smooth + 0.5769*nz(smooth[2]) - 0.5769*nz(smooth[4]) - 0.0962*nz(smooth[6]))*(0.075*nz(period[1]) + 0.54)

Q1 := (0.0962*detrender + 0.5769*nz(detrender[2]) - 0.5769*nz(detrender[4]) - 0.0962*nz(detrender[6]))*(0.075*nz(period[1]) + 0.54)
I1 := nz(detrender[3])

jI := (0.0962*I1 + 0.5769*nz(I1[2]) - 0.5769*nz(I1[4]) - 0.0962*nz(I1[6]))*(0.075*nz(period[1]) + 0.54)
jQ := (0.0962*Q1 + 0.5769*nz(Q1[2]) - 0.5769*nz(Q1[4]) - 0.0962*nz(Q1[6]))*(0.075*nz(period[1]) + 0.54)

I2 := I1 - jQ
Q2 := Q1 + jI
I2 := 0.2*I2 + 0.8*nz(I2[1])
Q2 := 0.2*Q2 + 0.8*nz(Q2[1])

Re := I2*nz(I2[1]) + Q2*nz(Q2[1])
Im := I2*nz(Q2[1]) - Q2*nz(I2[1])
Re := 0.2*Re + 0.8*nz(Re[1])
Im := 0.2*Im + 0.8*nz(Im[1])

if Re != 0 and Im != 0
    period := 360 / (180/math.pi * math.atan(Im/Re))
if period > 1.5 * nz(period[1])
    period := 1.5 * nz(period[1])
if period < 0.67 * nz(period[1])
    period := 0.67 * nz(period[1])
if period < 6
    period := 6
if period > 50
    period := 50
period := 0.2*period + 0.8*nz(period[1])
smoothPeriod := 0.33*period + 0.67*nz(smoothPeriod[1])

if I1 != 0
    phase := (180/math.pi) * math.atan(Q1 / I1)
deltaPhase := nz(phase[1]) - phase
if deltaPhase < 1
    deltaPhase := 1

float alpha = fastLimit / deltaPhase
if alpha < slowLimit
    alpha := slowLimit

var float mama = 0.0, var float fama = 0.0
mama := alpha*pr + (1 - alpha)*nz(mama[1])
fama := 0.5*alpha*mama + (1 - 0.5*alpha)*nz(fama[1])

plot(mama, "MAMA", color=color.aqua, linewidth=2)
plot(fama, "FAMA", color=color.fuchsia, linewidth=2)

// =========================================================================
// 4. CAUSAL TRIGGERS: LAGUERRE TIME-WARPING FILTER
// =========================================================================
var float L0 = 0.0, var float L1 = 0.0, var float L2 = 0.0, var float L3 = 0.0
L0 := (1 - lagGamma)*close + lagGamma*nz(L0[1])
L1 := -lagGamma*L0 + nz(L0[1]) + lagGamma*nz(L1[1])
L2 := -lagGamma*L1 + nz(L1[1]) + lagGamma*nz(L2[1])
L3 := -lagGamma*L2 + nz(L2[1]) + lagGamma*nz(L3[1])

float CU = (L0 > L1 ? L0 - L1 : 0) + (L1 > L2 ? L1 - L2 : 0) + (L2 > L3 ? L2 - L3 : 0)
float CD = (L0 < L1 ? L1 - L0 : 0) + (L1 < L2 ? L2 - L1 : 0) + (L2 < L3 ? L3 - L2 : 0)
float lagRSI = CU + CD != 0 ? CU / (CU + CD) : 0

// =========================================================================
// 5. BEHAVIORAL STRUCTURE: AMD SESSIONS & LIQUIDITY SWEEPS
// =========================================================================
in_session(sess) => not na(time(timeframe.period, sess))
is_new_session(sess) => in_session(sess) and not in_session(sess)[1]

var float asia_hi = na, var float asia_lo = na, var float asia_vwap = na, var float asia_vol = 0.0
var float lon_hi  = na, var float lon_lo  = na, var float lon_vwap  = na, var float lon_vol  = 0.0

// Asian Accumulation
if is_new_session(sess_asia)
    asia_hi := high, asia_lo := low
    asia_vwap := hlc3 * volume, asia_vol := volume
else if in_session(sess_asia)
    asia_hi := math.max(asia_hi, high), asia_lo := math.min(asia_lo, low)
    asia_vwap += hlc3 * volume, asia_vol += volume

// London Manipulation
if is_new_session(sess_lon)
    lon_hi := high, lon_lo := low
    lon_vwap := hlc3 * volume, lon_vol := volume
else if in_session(sess_lon)
    lon_hi := math.max(lon_hi, high), lon_lo := math.min(lon_lo, low)
    lon_vwap += hlc3 * volume, lon_vol += volume

// Liquidity Sweeps (Rejection of session extremes)
bool sweep_asia_hi = high > asia_hi and close < asia_hi and in_session(sess_lon)
bool sweep_asia_lo = low < asia_lo and close > asia_lo and in_session(sess_lon)

// =========================================================================
// 6. CAUSAL INFERENCE: CONVERGENT CROSS-MAPPING PROXY (DXY)
// =========================================================================
float dxy_close = request.security(dxyTicker, timeframe.period, close, lookahead=barmerge.lookahead_off)
float dxy_roc   = ta.change(dxy_close)
bool dxy_bear_confirm = dxy_roc > 0 
bool dxy_bull_confirm = dxy_roc < 0 

// =========================================================================
// 7. CONFLUENCE & EXECUTION (THE SNIPER)
// =========================================================================
// The HMM Gate strictly limits executions. We only fire AMD Sweeps if the regime is Stationary (0) or Compressed (2).
bool valid_regime = useHmm ? (hmm_state == 0 or hmm_state == 2) : (hurst < 0.5)

bool long_cond = sweep_asia_lo and lagRSI < 0.2 and valid_regime and dxy_bull_confirm
bool short_cond = sweep_asia_hi and lagRSI > 0.8 and valid_regime and dxy_bear_confirm

if long_cond
    label.new(bar_index, low, "AMD\nSWEEP\n▲", color=COL_BULL, textcolor=color.white, style=label.style_label_up, size=size.small)

if short_cond
    label.new(bar_index, high, "AMD\nSWEEP\n▼", color=COL_BEAR, textcolor=color.white, style=label.style_label_down, size=size.small)

// =========================================================================
// 8. STRATEGY EXECUTION ENGINE (MARTINGALE & DYNAMIC EXIT)
// =========================================================================
// Calculate Dynamic Compound Base Margin
float active_base = compoundWins ? math.max(baseMargin, baseMargin * (strategy.equity / strategy.initial_capital)) : baseMargin
float max_margin_allowed = active_base * math.pow(2, maxDoubs)
var float margin_allocated = baseMargin

// Position Data Tracker
bool is_flat = strategy.position_size == 0
bool is_long = strategy.position_size > 0
bool is_short = strategy.position_size < 0
float pos_avg = strategy.position_avg_price

float profit_pct = 0.0
if is_long
    profit_pct := (close - pos_avg) / pos_avg
else if is_short
    profit_pct := (pos_avg - close) / pos_avg

// 8A. DYNAMIC EXIT LOGIC (Take Profit)
float fast_ema = ta.ema(close, emaTpLen)
bool momentum_dead_long = close < fast_ema
bool momentum_dead_short = close > fast_ema

bool trigger_tp_long = is_long and profit_pct >= dynTpPct and momentum_dead_long
bool trigger_tp_short = is_short and profit_pct >= dynTpPct and momentum_dead_short

if trigger_tp_long
    strategy.close_all(comment="Close Long (Dynamic TP)")
if trigger_tp_short
    strategy.close_all(comment="Close Short (Dynamic TP)")

// 8B. STOP LOSS LOGIC (Logical Close & Catastrophic Wick)
if is_long
    strategy.exit("Wick_Exit_L", stop=pos_avg * (1.0 - catSlPct))
if is_short
    strategy.exit("Wick_Exit_S", stop=pos_avg * (1.0 + catSlPct))

if is_long and close <= pos_avg * (1.0 - logSlPct)
    strategy.close_all(comment="Logical SL (-" + str.tostring(logSlPct*100) + "% Close)")
if is_short and close >= pos_avg * (1.0 + logSlPct)
    strategy.close_all(comment="Logical SL (-" + str.tostring(logSlPct*100) + "% Close)")

// 8C. STATE MANAGER (Win/Loss Tracking for Martingale)
var float previous_netprofit = 0.0
var float accumulated_loss = 0.0

if is_flat and strategy.position_size[1] != 0
    if strategy.netprofit >= previous_netprofit
        margin_allocated := active_base 
        accumulated_loss := 0.0
    else
        accumulated_loss += (previous_netprofit - strategy.netprofit)
    previous_netprofit := strategy.netprofit

if is_flat and accumulated_loss == 0
    margin_allocated := active_base

// 8D. ENTRY LOGIC (The Averaging Engine)
float entry_qty = math.max((margin_allocated * leverage) / close, 1e-6)

if long_cond
    if is_flat
        strategy.entry("Long", strategy.long, qty=entry_qty)
        margin_allocated := math.min(margin_allocated * 2, max_margin_allowed) 
    else if is_long and close < pos_avg 
        strategy.entry("Long_Add", strategy.long, qty=entry_qty)
        margin_allocated := math.min(margin_allocated * 2, max_margin_allowed) 

if short_cond and not longOnly
    if is_flat
        strategy.entry("Short", strategy.short, qty=entry_qty)
        margin_allocated := math.min(margin_allocated * 2, max_margin_allowed)
    else if is_short and close > pos_avg 
        strategy.entry("Short_Add", strategy.short, qty=entry_qty)
        margin_allocated := math.min(margin_allocated * 2, max_margin_allowed)

// =========================================================================
// 9. TACTICAL HUD (HEADS-UP DISPLAY)
// =========================================================================
var table hud = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 80), border_color=color.gray, border_width=1)
if barstate.islast
    table.cell(hud, 0, 0, "ALPHA COUNCIL - NON-LINEARITY STRATEGY", text_color=color.white, text_halign=text.align_center, bgcolor=color.black)
    table.merge_cells(hud, 0, 0, 1, 0)
    
    // HMM Engine State
    string hmm_txt = hmm_state == 2 ? "KINETIC TRAP (CALM)" : hmm_state == 1 ? "BULL EXPANSION" : hmm_state == -1 ? "BEAR EXPANSION" : "STATIONARY / CHOP"
    color hmm_col = hmm_state == 2 ? color.fuchsia : hmm_state == 1 ? color.green : hmm_state == -1 ? color.red : color.gray
    table.cell(hud, 0, 1, useHmm ? "HMM REGIME STATE:" : "HMM REGIME (DISABLED):", text_color=color.white, text_halign=text.align_left)
    table.cell(hud, 1, 1, useHmm ? hmm_txt : "OFF", text_color=color.white, bgcolor=useHmm ? hmm_col : color.gray)

    // Stationarity Gate
    color reg_col = hurst < 0.5 ? color.orange : (close > ta.sma(close, 50) ? color.green : color.red)
    string reg_txt = hurst < 0.5 ? "MEAN-REVERTING" : "TRENDING"
    table.cell(hud, 0, 2, "STATIONARITY (HURST):", text_color=color.white, text_halign=text.align_left)
    table.cell(hud, 1, 2, reg_txt + " (" + str.tostring(math.round(hurst, 2)) + ")", text_color=color.white, bgcolor=reg_col)
    
    // Phase Space
    string phase_txt = mama > fama ? "BULLISH EXPANSION" : "BEARISH CONTRACTION"
    table.cell(hud, 0, 3, "DOMINANT CYCLE PHASE:", text_color=color.white, text_halign=text.align_left)
    table.cell(hud, 1, 3, phase_txt, text_color=color.white, bgcolor=mama > fama ? color.green : color.red)
    
    // Laguerre Time-Warp
    table.cell(hud, 0, 4, "LAGUERRE KINETICS:", text_color=color.white, text_halign=text.align_left)
    table.cell(hud, 1, 4, str.tostring(math.round(lagRSI*100, 1)) + "%", text_color=color.white, bgcolor=lagRSI > 0.8 ? color.red : (lagRSI < 0.2 ? color.green : color.gray))
    
    // Causal Inference
    table.cell(hud, 0, 5, "CAUSAL INFERENCE (DXY):", text_color=color.white, text_halign=text.align_left)
    table.cell(hud, 1, 5, dxy_roc > 0 ? "DXY RISING (BEARISH Crypto)" : "DXY FALLING (BULLISH Crypto)", text_color=color.white, bgcolor=dxy_roc > 0 ? color.red : color.green)
    
    // ACV Status
    table.cell(hud, 0, 6, "ACV DEFENSE SHIELD:", text_color=color.white, text_halign=text.align_left)
    table.cell(hud, 1, 6, not valid_regime ? "LOCKED (HOSTILE TREND)" : "ARMED (VALID)", text_color=color.white, bgcolor=not valid_regime ? color.red : color.green)

    // Strategy Engine Metrics
    table.cell(hud, 0, 7, "ACTIVE BASE (COMP):", text_color=color.white, text_halign=text.align_left)
    table.cell(hud, 1, 7, "$" + str.tostring(math.round(active_base, 2)), text_color=color.white, bgcolor=color.new(color.blue, 20))

    table.cell(hud, 0, 8, "NEXT MARGIN ALLOC:", text_color=color.white, text_halign=text.align_left)
    table.cell(hud, 1, 8, "$" + str.tostring(math.round(margin_allocated, 2)), text_color=color.white, bgcolor=margin_allocated > active_base ? color.red : color.green)
    
    table.cell(hud, 0, 9, "RECOVERY TARGET:", text_color=color.white, text_halign=text.align_left)
    table.cell(hud, 1, 9, accumulated_loss > 0 ? "$" + str.tostring(math.round(accumulated_loss, 2)) : "NONE", text_color=color.white, bgcolor=accumulated_loss > 0 ? color.orange : color.green)