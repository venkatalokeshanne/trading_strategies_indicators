//@version=6
indicator("Structure Trend Ribbon (BOS/CHoCH + ICT Toolkit)", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// =====================================================================
// ---------- Inputs ----------
// =====================================================================
autoTF = input.bool(true, "Auto Timeframe Mode (overrides Structure/Killzone/OB/Fib settings below)", group="Auto Mode")

swingLen        = input.int(5, "Swing Lookback (bars each side)", minval=2, group="Structure (manual — used when Auto Mode is off)")
showChoch       = input.bool(true, "Show CHoCH Labels", group="Structure (manual — used when Auto Mode is off)")
showBos         = input.bool(true, "Show BOS Labels", group="Structure (manual — used when Auto Mode is off)")
showBreakLines  = input.bool(true, "Show Structure Break Lines", group="Structure (manual — used when Auto Mode is off)")
labelOffsetMult = input.float(0.6, "Label Offset (ATR mult)", minval=0, group="Structure (manual — used when Auto Mode is off)")

ribbonLen  = input.int(20, "Ribbon Basis Length (EMA)", group="Ribbon")
ribbonMult = input.float(1.5, "Ribbon Width (ATR mult)", group="Ribbon")
ribbonFillTransp = input.int(85, "Ribbon Fill Transparency (0=solid, 100=invisible)", minval=0, maxval=100, group="Ribbon")

showOB     = input.bool(true, "Show Order Blocks", group="Order Blocks")
obLookback = input.int(15, "Order Block Lookback (bars, manual)", minval=1, group="Order Blocks")

showFVG = input.bool(true, "Show Fair Value Gaps", group="Fair Value Gaps")

showKillzones = input.bool(true, "Show Killzone Shading (manual — used when Auto Mode is off)", group="Killzones")
londonSession = input.session("0200-0500", "London Killzone", group="Killzones")
nySession     = input.session("0830-1100", "NY AM Killzone", group="Killzones")
asiaSession   = input.session("2000-0000", "Asian Killzone", group="Killzones")

showEQ      = input.bool(true, "Show Equal Highs/Lows", group="Liquidity")
eqTolerance = input.float(0.05, "Equal High/Low Tolerance (%)", minval=0.0, step=0.01, group="Liquidity")

showGoldenZone = input.bool(true, "Show Golden Zone (OTE)", group="Fibonacci")
showFullFib    = input.bool(true, "Show Full Fib Levels (manual — used when Auto Mode is off)", group="Fibonacci")
fibStart       = input.float(0.618, "Golden Zone Start (Fib)", step=0.01, group="Fibonacci")
fibEnd         = input.float(0.79, "Golden Zone End (Fib)", step=0.01, group="Fibonacci")

showInfoTable = input.bool(true, "Show Mode Info Table", group="Auto Mode")

// =====================================================================
// ---------- Moving Averages (auto-adjusting) ----------
// =====================================================================
showMAs         = input.bool(true, "Show Moving Averages", group="Moving Averages")
maType          = input.string("EMA", "MA Type", options=["EMA", "SMA"], group="Moving Averages")
labelOffsetBars = input.int(6, "Price Label Offset (bars right of fib labels)", minval=0, group="Moving Averages")

ma1LenManual = input.int(9,   "MA 1 Length (manual — used when Auto Mode is off)", minval=1, group="Moving Averages")
ma2LenManual = input.int(21,  "MA 2 Length (manual — used when Auto Mode is off)", minval=1, group="Moving Averages")
ma3LenManual = input.int(50,  "MA 3 Length (manual — used when Auto Mode is off)", minval=1, group="Moving Averages")
ma4LenManual = input.int(200, "MA 4 Length (manual — used when Auto Mode is off)", minval=1, group="Moving Averages")

ma1Color = input.color(color.yellow,    "MA 1 Color", group="Moving Averages")
ma2Color = input.color(color.aqua,      "MA 2 Color", group="Moving Averages")
ma3Color = input.color(color.orange,    "MA 3 Color", group="Moving Averages")
ma4Color = input.color(color.fuchsia,   "MA 4 Color", group="Moving Averages")

// =====================================================================
// ---------- Auto Timeframe Mode ----------
// buckets: HTF (1H+), Entry (5m-59m), LTF (<5m) — matches killzone / swing
// trading workflow: HTF for bias, Entry/LTF for actual triggers
// =====================================================================
tfSeconds = timeframe.in_seconds()

htf   = tfSeconds >= 3600
entry = not htf and tfSeconds >= 300

autoSwingLen      = htf ? 8 : entry ? 4 : 3
autoShowBos       = htf ? false : true
autoShowKillzones = htf ? false : true
autoObLookback    = htf ? 25 : entry ? 15 : 10
autoShowFullFib   = htf ? true : entry ? true : false

// MA period sets per bucket — HTF gets slower/trend-following lengths,
// Entry a standard fast/slow set, LTF the fastest scalping lengths
autoMa1 = htf ? 20  : entry ? 9   : 5
autoMa2 = htf ? 50  : entry ? 21  : 13
autoMa3 = htf ? 100 : entry ? 50  : 21
autoMa4 = htf ? 200 : entry ? 100 : 50

swingLenEff      = autoTF ? autoSwingLen      : swingLen
showBosEff       = autoTF ? autoShowBos       : showBos
showKillzonesEff = autoTF ? autoShowKillzones : showKillzones
obLookbackEff    = autoTF ? autoObLookback    : obLookback
showFullFibEff   = autoTF ? autoShowFullFib   : showFullFib

ma1LenEff = autoTF ? autoMa1 : ma1LenManual
ma2LenEff = autoTF ? autoMa2 : ma2LenManual
ma3LenEff = autoTF ? autoMa3 : ma3LenManual
ma4LenEff = autoTF ? autoMa4 : ma4LenManual

if showInfoTable
    var table infoTable = table.new(position.top_right, 1, 1, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.gray)
    if barstate.islast
        modeLabel = not autoTF ? "Manual Settings" : htf ? "Auto: HTF Mode" : entry ? "Auto: Entry Mode" : "Auto: LTF Mode"
        detailLabel = "Swing " + str.tostring(swingLenEff) + " | OB " + str.tostring(obLookbackEff) + " | BOS " + (showBosEff ? "On" : "Off") + " | KZ " + (showKillzonesEff ? "On" : "Off")
        maDetailLabel = showMAs ? ("\nMA " + str.tostring(ma1LenEff) + "/" + str.tostring(ma2LenEff) + "/" + str.tostring(ma3LenEff) + "/" + str.tostring(ma4LenEff)) : ""
        table.cell(infoTable, 0, 0, modeLabel + "\n" + detailLabel + maDetailLabel, text_color=color.white, text_size=size.small)

// =====================================================================
// ---------- Swing point detection ----------
// =====================================================================
swingHighBar = ta.pivothigh(high, swingLenEff, swingLenEff)
swingLowBar  = ta.pivotlow(low, swingLenEff, swingLenEff)

var float lastSwingHigh    = na
var float lastSwingLow     = na
var int   lastSwingHighBar = na
var int   lastSwingLowBar  = na

if not na(swingHighBar)
    lastSwingHigh    := swingHighBar
    lastSwingHighBar := bar_index - swingLenEff
if not na(swingLowBar)
    lastSwingLow    := swingLowBar
    lastSwingLowBar := bar_index - swingLenEff

// =====================================================================
// ---------- Structure / trend state (BOS / CHoCH) ----------
// =====================================================================
var int trend = 0   // 1 = bullish structure, -1 = bearish, 0 = undefined

bullBreak = not na(lastSwingHigh) and ta.crossover(close, lastSwingHigh)
bearBreak = not na(lastSwingLow) and ta.crossunder(close, lastSwingLow)

bullChoch = bullBreak and trend == -1
bearChoch = bearBreak and trend == 1
bullBos   = bullBreak and trend <= 0 and not bullChoch
bearBos   = bearBreak and trend >= 0 and not bearChoch

if bullBreak
    trend := 1
if bearBreak
    trend := -1

// =====================================================================
// ---------- Ribbon (colored by structure, not just a lagging MA) ----------
// =====================================================================
basis  = ta.ema(close, ribbonLen)
atrVal = ta.atr(14) * ribbonMult
upper  = basis + atrVal
lower  = basis - atrVal

ribbonColor = trend == 1 ? color.new(color.green, ribbonFillTransp) : trend == -1 ? color.new(color.red, ribbonFillTransp) : color.new(color.gray, 90)
lineColor   = trend == 1 ? color.green : trend == -1 ? color.red : color.gray

pUpper = plot(upper, "Ribbon Upper", color=lineColor)
pLower = plot(lower, "Ribbon Lower", color=lineColor)
fill(pUpper, pLower, color=ribbonColor, title="Ribbon Fill")
plot(basis, "Basis", color=color.new(lineColor, 30), linewidth=2)

// =====================================================================
// ---------- Clean BOS / CHoCH markers ----------
// =====================================================================
offsetAmt = ta.atr(14) * labelOffsetMult

if showBreakLines and bullChoch
    line.new(lastSwingHighBar, lastSwingHigh, bar_index, lastSwingHigh, color=color.new(color.green, 20), style=line.style_dashed, width=2)
if showBreakLines and bearChoch
    line.new(lastSwingLowBar, lastSwingLow, bar_index, lastSwingLow, color=color.new(color.red, 20), style=line.style_dashed, width=2)
if showBreakLines and bullBos
    line.new(lastSwingHighBar, lastSwingHigh, bar_index, lastSwingHigh, color=color.new(color.green, 60), style=line.style_dotted, width=1)
if showBreakLines and bearBos
    line.new(lastSwingLowBar, lastSwingLow, bar_index, lastSwingLow, color=color.new(color.red, 60), style=line.style_dotted, width=1)

if showChoch and bullChoch
    label.new(bar_index, low - offsetAmt, "CHoCH", style=label.style_none, textcolor=color.green, size=size.normal)
if showChoch and bearChoch
    label.new(bar_index, high + offsetAmt, "CHoCH", style=label.style_none, textcolor=color.red, size=size.normal)

if showBosEff and bullBos
    label.new(bar_index, low - offsetAmt * 0.5, "•", style=label.style_none, textcolor=color.new(color.green, 25), size=size.tiny)
if showBosEff and bearBos
    label.new(bar_index, high + offsetAmt * 0.5, "•", style=label.style_none, textcolor=color.new(color.red, 25), size=size.tiny)

// =====================================================================
// ---------- Order Blocks ----------
// last opposite-colored candle before a structure break, held until mitigated
// =====================================================================
var box   bullOB          = na
var float bullOBTop       = na
var float bullOBBot       = na
var bool  bullOBMitigated = true

var box   bearOB          = na
var float bearOBTop       = na
var float bearOBBot       = na
var bool  bearOBMitigated = true

if showOB and bullBreak
    idxB = -1
    for i = 1 to obLookbackEff
        if close[i] < open[i]
            idxB := i
            break
    if idxB != -1
        bullOBTop := high[idxB]
        bullOBBot := low[idxB]
        bullOB := box.new(bar_index - idxB, bullOBTop, bar_index, bullOBBot, border_color=color.new(color.blue, 40), bgcolor=color.new(color.blue, 85), extend=extend.right)
        bullOBMitigated := false

if showOB and not na(bullOB) and not bullOBMitigated and low <= bullOBTop
    bullOBMitigated := true
    box.set_extend(bullOB, extend.none)
    box.set_right(bullOB, bar_index)

if showOB and bearBreak
    idxS = -1
    for i = 1 to obLookbackEff
        if close[i] > open[i]
            idxS := i
            break
    if idxS != -1
        bearOBTop := high[idxS]
        bearOBBot := low[idxS]
        bearOB := box.new(bar_index - idxS, bearOBTop, bar_index, bearOBBot, border_color=color.new(color.orange, 40), bgcolor=color.new(color.orange, 85), extend=extend.right)
        bearOBMitigated := false

if showOB and not na(bearOB) and not bearOBMitigated and high >= bearOBBot
    bearOBMitigated := true
    box.set_extend(bearOB, extend.none)
    box.set_right(bearOB, bar_index)

// =====================================================================
// ---------- Fair Value Gaps ----------
// 3-candle imbalance, held until price trades back through the gap
// =====================================================================
var array<box> bullFVGs = array.new<box>()
var array<box> bearFVGs = array.new<box>()

bullFVGCond = low > high[2]
bearFVGCond = high < low[2]

if showFVG and bullFVGCond
    newBullFVG = box.new(bar_index - 2, high[2], bar_index, low, border_color=color.new(color.aqua, 50), bgcolor=color.new(color.aqua, 85), extend=extend.right)
    array.push(bullFVGs, newBullFVG)

if showFVG and bearFVGCond
    newBearFVG = box.new(bar_index - 2, low[2], bar_index, high, border_color=color.new(color.fuchsia, 50), bgcolor=color.new(color.fuchsia, 85), extend=extend.right)
    array.push(bearFVGs, newBearFVG)

if array.size(bullFVGs) > 0
    for i = array.size(bullFVGs) - 1 to 0
        b = array.get(bullFVGs, i)
        botB = box.get_bottom(b)
        if low <= botB
            box.set_extend(b, extend.none)
            box.set_right(b, bar_index)
            array.remove(bullFVGs, i)

if array.size(bearFVGs) > 0
    for i = array.size(bearFVGs) - 1 to 0
        b = array.get(bearFVGs, i)
        topB = box.get_top(b)
        if high >= topB
            box.set_extend(b, extend.none)
            box.set_right(b, bar_index)
            array.remove(bearFVGs, i)

// =====================================================================
// ---------- Killzone Session Shading ----------
// =====================================================================
inLondon = not na(time(timeframe.period, londonSession, "America/New_York"))
inNY     = not na(time(timeframe.period, nySession, "America/New_York"))
inAsia   = not na(time(timeframe.period, asiaSession, "America/New_York"))

bgcolor(showKillzonesEff and inLondon ? color.new(color.blue, 92) : na, title="London Killzone")
bgcolor(showKillzonesEff and inNY ? color.new(color.yellow, 92) : na, title="NY Killzone")
bgcolor(showKillzonesEff and inAsia ? color.new(color.purple, 92) : na, title="Asian Killzone")

// =====================================================================
// ---------- Equal Highs / Equal Lows (liquidity pools) ----------
// =====================================================================
var float prevSwingHighVal  = na
var int   prevSwingHighBarI = na
var float prevSwingLowVal   = na
var int   prevSwingLowBarI  = na

if not na(swingHighBar)
    if showEQ and not na(prevSwingHighVal)
        tolH = prevSwingHighVal * eqTolerance / 100
        if math.abs(swingHighBar - prevSwingHighVal) <= tolH
            line.new(prevSwingHighBarI, prevSwingHighVal, bar_index - swingLenEff, swingHighBar, color=color.new(color.fuchsia, 20), width=1)
            label.new(bar_index - swingLenEff, swingHighBar, "EQH", style=label.style_label_down, color=color.new(color.fuchsia, 30), textcolor=color.white, size=size.tiny)
    prevSwingHighVal  := swingHighBar
    prevSwingHighBarI := bar_index - swingLenEff

if not na(swingLowBar)
    if showEQ and not na(prevSwingLowVal)
        tolL = prevSwingLowVal * eqTolerance / 100
        if math.abs(swingLowBar - prevSwingLowVal) <= tolL
            line.new(prevSwingLowBarI, prevSwingLowVal, bar_index - swingLenEff, swingLowBar, color=color.new(color.aqua, 20), width=1)
            label.new(bar_index - swingLenEff, swingLowBar, "EQL", style=label.style_label_up, color=color.new(color.aqua, 30), textcolor=color.white, size=size.tiny)
    prevSwingLowVal  := swingLowBar
    prevSwingLowBarI := bar_index - swingLenEff

// =====================================================================
// ---------- Golden Zone (OTE) + Full Fib Levels ----------
// tracks the two most recent opposing swing points as the active "leg"
// =====================================================================
var float p1price = na
var int   p1bar   = na
var string p1type = na
var float p2price = na
var int   p2bar   = na
var string p2type = na

if not na(swingHighBar)
    p1price := p2price
    p1bar   := p2bar
    p1type  := p2type
    p2price := swingHighBar
    p2bar   := bar_index - swingLenEff
    p2type  := "high"

if not na(swingLowBar)
    p1price := p2price
    p1bar   := p2bar
    p1type  := p2type
    p2price := swingLowBar
    p2bar   := bar_index - swingLenEff
    p2type  := "low"

var box   goldenBox = na
var label goldenLbl = na

var array<line>   fibLines  = array.new<line>()
var array<label>  fibLbls   = array.new<label>()
var array<float>  fibLevels = array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.79, 1.0)
var array<string> fibTxt    = array.from("0", "23.6", "38.2", "50", "61.8", "79", "100")

newLeg = not na(p1price) and not na(p2price) and p1type != p2type

if newLeg
    legRange = math.abs(p2price - p1price)
    bullLeg  = p2type == "high" and p2price > p1price

    // ---- Golden Zone box ----
    float zoneTop = na
    float zoneBottom = na
    if bullLeg
        zoneTop    := p2price - legRange * fibStart
        zoneBottom := p2price - legRange * fibEnd
    else
        zoneTop    := p2price + legRange * fibEnd
        zoneBottom := p2price + legRange * fibStart

    if showGoldenZone
        if na(goldenBox)
            goldenBox := box.new(p2bar, zoneTop, bar_index, zoneBottom, border_color=color.new(color.yellow, 30), bgcolor=color.new(color.yellow, 80), border_width=1, extend=extend.right)
            goldenLbl := label.new(p2bar, zoneTop, "OTE", style=label.style_label_down, color=color.new(color.yellow, 30), textcolor=color.black, size=size.tiny)
        else
            box.set_lefttop(goldenBox, p2bar, zoneTop)
            box.set_rightbottom(goldenBox, bar_index, zoneBottom)
            label.set_xy(goldenLbl, p2bar, zoneTop)

    // ---- Full fib levels ----
    if showFullFibEff
        if array.size(fibLines) > 0
            for i = 0 to array.size(fibLines) - 1
                line.delete(array.get(fibLines, i))
            array.clear(fibLines)
        if array.size(fibLbls) > 0
            for i = 0 to array.size(fibLbls) - 1
                label.delete(array.get(fibLbls, i))
            array.clear(fibLbls)

        for i = 0 to array.size(fibLevels) - 1
            lvl = array.get(fibLevels, i)
            price = bullLeg ? p2price - legRange * lvl : p2price + legRange * lvl
            ln = line.new(p2bar, price, bar_index, price, color=color.new(color.gray, 55), style=line.style_dotted, extend=extend.right)
            lb = label.new(bar_index, price, array.get(fibTxt, i) + "%", style=label.style_label_left, color=color.new(color.gray, 100), textcolor=color.gray, size=size.tiny)
            array.push(fibLines, ln)
            array.push(fibLbls, lb)

if showGoldenZone and not na(goldenBox) and not newLeg
    box.set_right(goldenBox, bar_index)

// =====================================================================
// ---------- Moving Averages: horizontal current-level lines ----------
// Lengths auto-adjust with Auto Timeframe Mode (same htf/entry/ltf
// buckets used above). Instead of a curved line tracing price history,
// each MA renders as a flat horizontal line at its CURRENT value,
// extending right past the candles — same visual pattern as the fib
// grid lines. Labels sit past the line end, auto-contrast their text
// color against each MA's chosen color.
// =====================================================================
f_ma(src, len) =>
    maType == "EMA" ? ta.ema(src, len) : ta.sma(src, len)

ma1Val = f_ma(close, ma1LenEff)
ma2Val = f_ma(close, ma2LenEff)
ma3Val = f_ma(close, ma3LenEff)
ma4Val = f_ma(close, ma4LenEff)

f_txtColor(bg) =>
    float lum = 0.299 * color.r(bg) + 0.587 * color.g(bg) + 0.114 * color.b(bg)
    lum > 140 ? color.black : color.white

var line ma1Line = na
var line ma2Line = na
var line ma3Line = na
var line ma4Line = na
var label ma1Lbl = na
var label ma2Lbl = na
var label ma3Lbl = na
var label ma4Lbl = na

f_updMaLine(ln, val, col, w) =>
    lnOut = ln
    if na(lnOut)
        lnOut := line.new(bar_index - 1, val, bar_index, val, color=col, width=w, extend=extend.right)
    else
        line.set_xy1(lnOut, bar_index - 1, val)
        line.set_xy2(lnOut, bar_index, val)
    lnOut

f_updMaLbl(lbl, val, len, col) =>
    txt = (maType == "EMA" ? "EMA " : "SMA ") + str.tostring(len) + "  " + str.tostring(val, format.mintick)
    lblOut = lbl
    if na(lblOut)
        lblOut := label.new(bar_index + labelOffsetBars, val, txt, style=label.style_label_left, color=col, textcolor=f_txtColor(col), size=size.small)
    else
        label.set_xy(lblOut, bar_index + labelOffsetBars, val)
        label.set_text(lblOut, txt)
        label.set_textcolor(lblOut, f_txtColor(col))
    lblOut

if showMAs and barstate.islast
    ma1Line := f_updMaLine(ma1Line, ma1Val, ma1Color, 1)
    ma2Line := f_updMaLine(ma2Line, ma2Val, ma2Color, 1)
    ma3Line := f_updMaLine(ma3Line, ma3Val, ma3Color, 2)
    ma4Line := f_updMaLine(ma4Line, ma4Val, ma4Color, 2)
    ma1Lbl  := f_updMaLbl(ma1Lbl, ma1Val, ma1LenEff, ma1Color)
    ma2Lbl  := f_updMaLbl(ma2Lbl, ma2Val, ma2LenEff, ma2Color)
    ma3Lbl  := f_updMaLbl(ma3Lbl, ma3Val, ma3LenEff, ma3Color)
    ma4Lbl  := f_updMaLbl(ma4Lbl, ma4Val, ma4LenEff, ma4Color)
