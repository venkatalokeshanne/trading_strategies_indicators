     group = groupSessionRange)

currentSessionLineStyleInput = input.string(
     "Dashed",
     "Session High/Low Style",
     options = ["Solid", "Dashed", "Dotted"],
     group = groupSessionRange)

showCurrentSessionLabels = input.bool(
