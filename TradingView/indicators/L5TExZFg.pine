// TABLEAU
//=============================================================================

var table tbl = table.new(
    tablePosition,
    5,
    14,
    border_width=1,
    border_color=color.rgb(80, 80, 80)
)

if barstate.islast
    table.clear(tbl, 0, 0, 4, 13)

    if showTable

        int row = 0

        table.cell(tbl, 0, row, "# MA", bgcolor=tableHeader, text_color=color.white, text_size=tableSize)
        table.cell(tbl, 1, row, "Moyenne", bgcolor=tableHeader, text_color=color.white, text_size=tableSize)
        table.cell(tbl, 2, row, "", bgcolor=tableHeader, text_color=color.white, text_size=tableSize)
        table.cell(tbl, 3, row, "Valeur", bgcolor=tableHeader, text_color=color.white, text_size=tableSize)
        table.cell(tbl, 4, row, "Prix", bgcolor=tableHeader, text_color=color.white, text_size=tableSize)

        row += 1

        if show1
            table.cell(tbl, 0, row, "MA 1", bgcolor=tableBackground, text_color=col1, text_size=tableSize)
