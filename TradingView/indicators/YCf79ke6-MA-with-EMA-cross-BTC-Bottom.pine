//@version=6
//witten by Hamitcagdas to support Legend indicator
indicator("MA with EMA cross + BTC Bottom", overlay=true, scale=scale.right)

// Ayarlar (Inputs)
hide_unnecessary = input.bool(true, title="Gereksiz Çizgileri Kaldır")
ma_len  = input.int(22, title="MA Uzunluğu (SMA)")
ema_len = input.int(11, title="EMA Uzunluğu")

// Hesaplamalar (Calculations)
ma_val  = ta.sma(close, ma_len)
ema_val = ta.ema(close, ema_len)

// Çizimler (Draw)
plot(ma_val, color=color.blue, title="MA", linewidth=2)
plot(ema_val, color=color.orange, title="EMA", linewidth=2)

// Kesişim Koşulları (Cross)
cross_up = ta.crossover(ema_val, ma_val)
cross_dn = ta.crossunder(ema_val, ma_val)

// Kesişim Sinyallerini Ekrana Basma (Visualization)
plotshape(cross_up, title="Al Sinyali", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(cross_dn, title="Sat Sinyali", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

// Bilgi Tablosu (Bottom Center)
var table info_table = table.new(position.bottom_center, 1, 1, frame_color=na, frame_width=0, bgcolor=color.new(color.black, 100))
if barstate.islast
    table.cell(info_table, 0, 0, "Suggested Timeframe: 1W\nÖnerilen Zaman Dilimi: 1W\nMarco de tiempo sugerido: 1W\nEmpfohlener Zeitrahmen: 1W", text_color=color.new(color.gray, 0), text_size=size.normal, text_halign=text.align_center)

f_x1() =>
    var float _v1 = 0.0
    var float _v2 = 0.0
    var int _v3 = 0
    if not na(close)
        _v1 += close
        _v2 += close * close
        _v3 += 1
    _m1 = _v1 / _v3
    _m2 = (_v2 / _v3) - (_m1 * _m1)
    _m3 = math.sqrt(math.max(0, _m2))
    _m3

_sym1 = "GLA" + "SSN" + "ODE:BT" + "C_MA" + "RKET" + "CAP"
_sym2 = "COI" + "NMET" + "RICS:B" + "TC_MA" + "RKETCA" + "PREAL"
_sym3 = "BT" + "C_MA" + "RKETC" + "APREAL"
_sym4 = "B" + "TC_S" + "UPPLY"

_g = request.security(_sym1, "1W", f_x1())
_h = request.security(_sym1, "1W", close)
_i = request.security(_sym2, "1W", close)

float _j = _g
float _k = request.security(_sym4, "1D", close)

float _l1 = (-0.14 * _j + _i) / _k
float _l2 = (-0.17 * _j + _i) / _k
float _l3 = (-0.24 * _j + _i) / _k

plot(hide_unnecessary ? na : _l1, title="Line 1", color=color.new(color.red, 30), linewidth=2)
plot(hide_unnecessary ? na : _l2, title="Line 2", color=color.new(color.blue, 30), linewidth=2)
plot(hide_unnecessary ? na : _l3, title="Line 3", color=color.new(color.green, 30), linewidth=2)

_m  = request.security(_sym3, "1D", close)
_n  = request.security(_sym4, "1D", close)
_o = _m / _n

_b0 = _o * 0.75
_b0_1 = _o * 0.85
_b0_2 = _o * 0.90

_b1 = _o * 1.5
_b2 = _o * 2.0
_b3 = _o * 3.0
_b4 = _o * 3.5

plot(_b0, title="Line 4", color=color.new(color.white, 70), style=plot.style_line)
plot(_b0_1, title="Line 5", color=color.new(color.silver, 70), style=plot.style_line)
plot(_b0_2, title="Line 6", color=color.new(color.gray, 70), style=plot.style_line)

plot(hide_unnecessary ? na : _o, title="Line 7", color=color.new(color.white, 10), linewidth=2)
plot(hide_unnecessary ? na : _b1, title="Line 8", color=color.new(color.green, 50))
plot(hide_unnecessary ? na : _b2, title="Line 9", color=color.new(color.yellow, 50))
plot(hide_unnecessary ? na : _b3, title="Line 10", color=color.new(color.orange, 50))
plot(hide_unnecessary ? na : _b4, title="Line 11", color=color.new(color.red, 50))

_p = _o / (1 - (-13.0/100))
plot(hide_unnecessary ? na : _p, title="Line 12", color=color.new(#4caf50, 20), linewidth=3)

