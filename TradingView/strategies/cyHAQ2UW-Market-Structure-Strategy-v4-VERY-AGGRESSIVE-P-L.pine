//@version=5
strategy("Market Structure Strategy v4 (VERY AGGRESSIVE P&L)",
     overlay=true,
     initial_capital=50000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=2,          // ↑ more exposure
     pyramiding=3,                 // ↑ multiple trades per BOS
     calc_on_every_tick=false)

// ─────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────
extLen = input.int(15, "External Structure Length", minval=5)
intLen = input.int(4,  "Internal Structure Length", minval=2)

rrPartial = input.float(1.0, "Partial Profit R")
rrFinal   = input.float(1.8, "Final Target R")

atrLen   = input.int(14, "ATR Length")
atrMult  = input.float(0.4, "ATR Stop Buffer")

adxLen       = input.int(14, "DI Length")
adxSmooth    = input.int(14, "ADX Smoothing")
adxMin       = input.float(15, "Minimum ADX (Loose!)")

// ─────────────────────────────────────────────
// Indicators
// ─────────────────────────────────────────────
atr = ta.atr(atrLen)
[plusDI, minusDI, adx] = ta.dmi(adxLen, adxSmooth)

// ─────────────────────────────────────────────
// External Structure
// ─────────────────────────────────────────────
extHigh = ta.pivothigh(high, extLen, extLen)
extLow  = ta.pivotlow(low, extLen, extLen)

var float lastExtHigh = na
var float lastExtLow  = na
var int   extBias     = 0

if not na(extHigh)
    lastExtHigh := extHigh
if not na(extLow)
    lastExtLow := extLow

if not na(lastExtHigh) and close > lastExtHigh
    extBias := 1

if not na(lastExtLow) and close < lastExtLow
    extBias := -1

// ─────────────────────────────────────────────
// Internal Structure
// ─────────────────────────────────────────────
intHigh = ta.pivothigh(high, intLen, intLen)
intLow  = ta.pivotlow(low, intLen, intLen)

var float lastHL = na
var float lastLH = na

if extBias == 1 and not na(intLow)
    lastHL := intLow

if extBias == -1 and not na(intHigh)
    lastLH := intHigh

// ─────────────────────────────────────────────
// Wide Pullback Zone (30–85%)
// ─────────────────────────────────────────────
float pbTop = na
float pbBot = na

if extBias == 1 and not na(lastHL) and not na(lastExtHigh)
    structRange = lastExtHigh - lastHL
    pbTop := lastExtHigh - structRange * 0.30
    pbBot := lastExtHigh - structRange * 0.85

if extBias == -1 and not na(lastLH) and not na(lastExtLow)
    structRange = lastLH - lastExtLow
    pbBot := lastExtLow + structRange * 0.30
    pbTop := lastExtLow + structRange * 0.85

// ─────────────────────────────────────────────
// Entries (Loose by Design)
// ─────────────────────────────────────────────
longAllowed = extBias == 1 and adx > adxMin and low <= pbTop and low >= pbBot 
shortAllowed = extBias == -1 and adx > adxMin and high >= pbBot and high <= pbTop

// ─────────────────────────────────────────────
// Execution — Partial + Runner
// ─────────────────────────────────────────────
if longAllowed and not na(lastHL)
    stop   = lastHL - atr * atrMult
    risk   = close - stop

    tp1    = close + risk * rrPartial
    tp2    = close + risk * rrFinal

    strategy.entry("Long", strategy.long)
    strategy.exit("L-P1", "Long", qty_percent=50, limit=tp1, stop=stop)
    strategy.exit("L-P2", "Long", qty_percent=50, limit=tp2, stop=stop)

if shortAllowed and not na(lastLH)
    stop   = lastLH + atr * atrMult
    risk   = stop - close

    tp1    = close - risk * rrPartial
    tp2    = close - risk * rrFinal

    strategy.entry("Short", strategy.short)
    strategy.exit("S-P1", "Short", qty_percent=50, limit=tp1, stop=stop)
    strategy.exit("S-P2", "Short", qty_percent=50, limit=tp2, stop=stop)

// ─────────────────────────────────────────────
// Visualization
// ─────────────────────────────────────────────
bgcolor(extBias == 1 ? color.new(color.green, 85) : extBias == -1 ? color.new(color.red, 85) : na)