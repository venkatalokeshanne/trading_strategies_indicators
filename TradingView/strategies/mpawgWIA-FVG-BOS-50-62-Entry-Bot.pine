//@version=5
strategy("FVG BOS 50-62 Entry Bot", overlay=true, pyramiding=0, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.02)

//====================================================
// Inputs
//====================================================
swingLen          = input.int(5, "Swing length", minval=1)
atrLen            = input.int(14, "ATR length", minval=1)
dispATRMult       = input.float(0.8, "Min displacement body (x ATR)", step=0.1)
minGapATRMult     = input.float(0.15, "Min FVG size (x ATR)", step=0.01)
slBufferTicks     = input.int(2, "SL buffer (ticks)", minval=0)
rrTarget          = input.float(2.0, "Risk:Reward target", step=0.1)
entryMode         = input.string("62%", "Entry trigger level", options=["50%", "62%"])
useCloseForBOS    = input.bool(true, "Use close for BOS (otherwise wick)")
oneTradeAtATime   = input.bool(true, "Only 1 open trade at a time")
showZones         = input.bool(true, "Show FVG zones")
showLabels        = input.bool(true, "Show labels")

atr  = ta.atr(atrLen)
tick = syminfo.mintick

//====================================================
// Market structure using pivots
// ta.pivothigh() / ta.pivotlow() confirm pivots only
// after the right-side bars are available, which is
// how Pine handles swing confirmation in the docs.
// :contentReference[oaicite:1]{index=1}
//====================================================
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastSwingHigh = na
var float lastSwingLow  = na

if not na(ph)
    lastSwingHigh := ph

if not na(pl)
    lastSwingLow := pl

bullBos = not na(lastSwingHigh) and (useCloseForBOS ? close > lastSwingHigh : high > lastSwingHigh)
bearBos = not na(lastSwingLow)  and (useCloseForBOS ? close < lastSwingLow  : low < lastSwingLow)

//====================================================
// FVG detection
// Bullish FVG: low > high[2]
// Bearish FVG: high < low[2]
//====================================================
midBody = math.abs(close[1] - open[1])

bullGapTop    = low
bullGapBottom = high[2]
bullGapSize   = bullGapTop - bullGapBottom

bearGapTop    = low[2]
bearGapBottom = high
bearGapSize   = bearGapTop - bearGapBottom

bullFVG = bar_index >= 2 and low > high[2]
bearFVG = bar_index >= 2 and high < low[2]

bullDisplacementOk = midBody > atr * dispATRMult
bearDisplacementOk = midBody > atr * dispATRMult

bullGapOk = bullGapSize > atr * minGapATRMult
bearGapOk = bearGapSize > atr * minGapATRMult

validBullNow = bullFVG and bullDisplacementOk and bullGapOk and bullBos
validBearNow = bearFVG and bearDisplacementOk and bearGapOk and bearBos

//====================================================
// Store active FVG zones
// We keep the latest qualified bullish and bearish zone
//====================================================
var float activeBullTop    = na
var float activeBullBottom = na
var int   activeBullBar    = na

var float activeBearTop    = na
var float activeBearBottom = na
var int   activeBearBar    = na

if validBullNow
    activeBullTop    := bullGapTop
    activeBullBottom := bullGapBottom
    activeBullBar    := bar_index

if validBearNow
    activeBearTop    := bearGapTop
    activeBearBottom := bearGapBottom
    activeBearBar    := bar_index

//====================================================
// Fib levels inside the FVG
// For bullish:
//   top    = low
//   bottom = high[2]
// Deeper entry = lower in the zone
// 50% = midpoint
// 62% = deeper retracement
//====================================================
bull50 = na(activeBullTop) or na(activeBullBottom) ? na : activeBullTop - (activeBullTop - activeBullBottom) * 0.50
bull62 = na(activeBullTop) or na(activeBullBottom) ? na : activeBullTop - (activeBullTop - activeBullBottom) * 0.62

bear50 = na(activeBearTop) or na(activeBearBottom) ? na : activeBearBottom + (activeBearTop - activeBearBottom) * 0.50
bear62 = na(activeBearTop) or na(activeBearBottom) ? na : activeBearBottom + (activeBearTop - activeBearBottom) * 0.62

bullTriggerLevel = entryMode == "50%" ? bull50 : bull62
bearTriggerLevel = entryMode == "50%" ? bear50 : bear62

//====================================================
// Zone invalidation
// Bullish zone invalid if price closes below bottom
// Bearish zone invalid if price closes above top
//====================================================
bullInvalid = not na(activeBullBottom) and close < activeBullBottom
bearInvalid = not na(activeBearTop) and close > activeBearTop

if bullInvalid
    activeBullTop    := na
    activeBullBottom := na
    activeBullBar    := na

if bearInvalid
    activeBearTop    := na
    activeBearBottom := na
    activeBearBar    := na

//====================================================
// Entry logic
// Long when price retraces into chosen FVG level
// Short when price retraces into chosen FVG level
//====================================================
flatOrAllowed = oneTradeAtATime ? strategy.position_size == 0 : true

longTouch  = not na(activeBullTop) and not na(bullTriggerLevel) and low <= bullTriggerLevel and close >= activeBullBottom
shortTouch = not na(activeBearBottom) and not na(bearTriggerLevel) and high >= bearTriggerLevel and close <= activeBearTop

longSL = na(activeBullBottom) ? na : activeBullBottom - slBufferTicks * tick
shortSL = na(activeBearTop) ? na : activeBearTop + slBufferTicks * tick

longEntryPrice  = bullTriggerLevel
shortEntryPrice = bearTriggerLevel

longRisk  = na(longSL) or na(longEntryPrice)  ? na : longEntryPrice - longSL
shortRisk = na(shortSL) or na(shortEntryPrice) ? na : shortSL - shortEntryPrice

longTP  = na(longRisk)  ? na : longEntryPrice  + longRisk * rrTarget
shortTP = na(shortRisk) ? na : shortEntryPrice - shortRisk * rrTarget

validLongTrade  = flatOrAllowed and longTouch and not na(longRisk) and longRisk > 0
validShortTrade = flatOrAllowed and shortTouch and not na(shortRisk) and shortRisk > 0

if validLongTrade
    strategy.entry("Long", strategy.long)
    strategy.exit("Long TP/SL", from_entry="Long", stop=longSL, limit=longTP)
    activeBullTop    := na
    activeBullBottom := na
    activeBullBar    := na

if validShortTrade
    strategy.entry("Short", strategy.short)
    strategy.exit("Short TP/SL", from_entry="Short", stop=shortSL, limit=shortTP)
    activeBearTop    := na
    activeBearBottom := na
    activeBearBar    := na

//====================================================
// Visuals
// Pine supports drawing boxes/visual objects for custom
// chart zones, which is the right way to display FVG areas.
// :contentReference[oaicite:2]{index=2}
//====================================================
var box bullBox = na
var box bearBox = na

if showZones
    if validBullNow
        if not na(bullBox)
            box.delete(bullBox)
        bullBox := box.new(left=bar_index-2, top=bullGapTop, right=bar_index+20, bottom=bullGapBottom, bgcolor=color.new(color.green, 85), border_color=color.new(color.green, 20))
    if validBearNow
        if not na(bearBox)
            box.delete(bearBox)
        bearBox := box.new(left=bar_index-2, top=bearGapTop, right=bar_index+20, bottom=bearGapBottom, bgcolor=color.new(color.red, 85), border_color=color.new(color.red, 20))

    if not na(bullBox)
        box.set_right(bullBox, bar_index + 20)
    if not na(bearBox)
        box.set_right(bearBox, bar_index + 20)

//====================================================
// Level plots
//====================================================
plot(not na(activeBullTop) ? bull50 : na, "Bull 50%", color=color.new(color.green, 0), linewidth=1, style=plot.style_linebr)
plot(not na(activeBullTop) ? bull62 : na, "Bull 62%", color=color.new(color.teal, 0), linewidth=1, style=plot.style_linebr)

plot(not na(activeBearTop) ? bear50 : na, "Bear 50%", color=color.new(color.red, 0), linewidth=1, style=plot.style_linebr)
plot(not na(activeBearTop) ? bear62 : na, "Bear 62%", color=color.new(color.orange, 0), linewidth=1, style=plot.style_linebr)

//====================================================
// Labels
//====================================================
if showLabels and validBullNow
    label.new(bar_index, high, "Bull FVG + BOS", style=label.style_label_down, textcolor=color.white, color=color.new(color.green, 0))

if showLabels and validBearNow
    label.new(bar_index, low, "Bear FVG + BOS", style=label.style_label_up, textcolor=color.white, color=color.new(color.red, 0))

//====================================================
// Alerts
//====================================================
alertcondition(validBullNow, title="New Bullish FVG + BOS", message="New bullish FVG with BOS detected")
alertcondition(validBearNow, title="New Bearish FVG + BOS", message="New bearish FVG with BOS detected")
alertcondition(validLongTrade, title="Long Entry Triggered", message="Long entry triggered from bullish FVG")
alertcondition(validShortTrade, title="Short Entry Triggered", message="Short entry triggered from bearish FVG")