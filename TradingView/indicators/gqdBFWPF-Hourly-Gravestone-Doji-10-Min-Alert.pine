//@version=6
indicator("Hourly Gravestone Doji - 10 Min Alert", overlay=true)

bodyMax = input.float(0.20, "Max Body % of Range", minval=0.01, maxval=0.50)
wickRatio = input.float(2.0, "Upper Wick / Body", minval=1.0)
lowerMax = input.float(0.10, "Max Lower Wick %", minval=0.0, maxval=0.50)

isHourly = timeframe.isminutes and timeframe.multiplier == 60

rng = high - low
body = math.abs(close - open)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

bodyPct = rng > 0 ? body / rng : 0.0
lowerPct = rng > 0 ? lowerWick / rng : 0.0

smallBody = bodyPct <= bodyMax
largeUpperWick = body > 0 ? upperWick >= body * wickRatio : upperWick > 0
smallLowerWick = lowerPct <= lowerMax

gravestone = isHourly and rng > 0 and smallBody and largeUpperWick and smallLowerWick

minutesLeft = (time_close - timenow) / 60000.0
finalTenMinutes = minutesLeft <= 10 and minutesLeft > 0

signal = gravestone and finalTenMinutes

plotshape(signal, title="Gravestone Doji", style=shape.triangledown, location=location.abovebar, size=size.large, text="GRAVE")

alertcondition(signal, title="Hourly Gravestone Doji", message="Hourly Gravestone Doji forming within 10 minutes of hourly close.")