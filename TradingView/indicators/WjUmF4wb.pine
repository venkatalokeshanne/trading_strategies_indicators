//@version=6
indicator("ALTSEASON RADAR 0-10", shorttitle="ALT RADAR", overlay=false)

//====================================================
// VERİLER
//====================================================

// BTC Dominance
btcD = request.security("CRYPTOCAP:BTC.D", timeframe.period, close)

// ETH / BTC
eth = request.security("BINANCE:ETHUSDT", timeframe.period, close)
btc = request.security("BINANCE:BTCUSDT", timeframe.period, close)
ethBtc = eth / btc

// TOTAL3
total3 = request.security("CRYPTOCAP:TOTAL3", timeframe.period, close)

// TOTAL3 / BTC
btcMarketCap = request.security("CRYPTOCAP:BTC", timeframe.period, close)
total3Btc = total3 / btcMarketCap

// AVAX / ETH
avax = request.security("BINANCE:AVAXUSDT", timeframe.period, close)
avaxEth = avax / eth

//====================================================
// EMA'LAR
//====================================================

btcDEma20 = ta.ema(btcD, 20)
btcDEma50 = ta.ema(btcD, 50)

ethBtcEma20 = ta.ema(ethBtc, 20)
ethBtcEma50 = ta.ema(ethBtc, 50)

total3Ema20 = ta.ema(total3, 20)
total3Ema50 = ta.ema(total3, 50)

total3BtcEma20 = ta.ema(total3Btc, 20)
total3BtcEma50 = ta.ema(total3Btc, 50)

avaxEthEma20 = ta.ema(avaxEth, 20)
avaxEthEma50 = ta.ema(avaxEth, 50)

//====================================================
// MOMENTUM
//====================================================

btcDRsi = ta.rsi(btcD, 14)
ethBtcRsi = ta.rsi(ethBtc, 14)
total3Rsi = ta.rsi(total3, 14)
total3BtcRsi = ta.rsi(total3Btc, 14)
avaxEthRsi = ta.rsi(avaxEth, 14)

//====================================================
// PUAN 1 — BTC DOMINANCE
//====================================================

// BTC dominance düşüyorsa altcoinler için olumlu

btcDBull =
     btcD < btcDEma20 and
     btcDEma20 < btcDEma50

btcDStrong =
     btcD < btcDEma20 and
     btcD < btcD[1] and
     btcDRsi < 50

scoreBTC =
     btcDStrong ? 2 :
     btcDBull ? 1 :
     0

//====================================================
// PUAN 2 — ETH / BTC
//====================================================

ethBtcBull =
     ethBtc > ethBtcEma20 and
     ethBtcEma20 > ethBtcEma50

ethBtcStrong =
     ethBtcBull and
     ethBtcRsi > 55 and
     ethBtc > ethBtc[1]

scoreETH =
     ethBtcStrong ? 2 :
     ethBtcBull ? 1 :
     0

//====================================================
// PUAN 3 — TOTAL3
//====================================================

total3Bull =
     total3 > total3Ema20 and
     total3Ema20 > total3Ema50

total3Strong =
     total3Bull and
     total3Rsi > 55 and
     total3 > total3[1]

scoreTOTAL3 =
     total3Strong ? 2 :
     total3Bull ? 1 :
     0

//====================================================
// PUAN 4 — TOTAL3 / BTC
//====================================================

total3BtcBull =
     total3Btc > total3BtcEma20 and
     total3BtcEma20 > total3BtcEma50

total3BtcStrong =
     total3BtcBull and
     total3BtcRsi > 55 and
     total3Btc > total3Btc[1]

scoreTOTAL3BTC =
     total3BtcStrong ? 2 :
     total3BtcBull ? 1 :
     0

//====================================================
// PUAN 5 — AVAX / ETH
//====================================================

avaxEthBull =
     avaxEth > avaxEthEma20 and
     avaxEthEma20 > avaxEthEma50

avaxEthStrong =
     avaxEthBull and
     avaxEthRsi > 55 and
     avaxEth > avaxEth[1]

scoreAVAX =
     avaxEthStrong ? 2 :
     avaxEthBull ? 1 :
     0

//====================================================
// TOPLAM SKOR
//====================================================

totalScore =
     scoreBTC +
     scoreETH +
     scoreTOTAL3 +
     scoreTOTAL3BTC +
     scoreAVAX

//====================================================
// SKOR GRAFİĞİ
//====================================================

plot(
     totalScore,
     title="ALTSEASON SCORE",
     linewidth=4)

// Seviyeler

hline(2, "2", linestyle=hline.style_dotted)
hline(4, "4", linestyle=hline.style_dotted)
hline(6, "6", linestyle=hline.style_dotted)
hline(8, "8", linestyle=hline.style_dotted)
hline(10, "10")

//====================================================
// ALANLAR
//====================================================

bgcolor(
     totalScore >= 8 ? color.new(color.green, 85) :
     totalScore >= 6 ? color.new(color.lime, 90) :
     totalScore >= 4 ? color.new(color.orange, 90) :
     color.new(color.red, 92))

//====================================================
// ALARM
//====================================================

altseasonStart =
     totalScore >= 8 and
     totalScore[1] < 8

altseasonWarning =
     totalScore <= 3 and
     totalScore[1] > 3

alertcondition(
     altseasonStart,
     title="ALTSEASON BAŞLIYOR",
     message="Altseason Radar 8/10 veya üzerine çıktı.")

alertcondition(
     altseasonWarning,
     title="ALTSEASON ZAYIFLIYOR",
     message="Altseason Radar 3/10 veya altına düştü.")