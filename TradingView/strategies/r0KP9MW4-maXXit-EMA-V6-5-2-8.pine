CLIENT_ID = input.string('DUO940014', '😎 Account ID', options = ['DUO940014','U3103575','OANDA','IG_MARKETS','None'], group = group_account, tooltip = 'Your secret determines LIVE or TEST trading - case sensitiv', inline = "3")
ACCOUNT_SIZE = input.float(10000, '💰 Account Size (Autotrail impact)', minval = 5000, group = group_account, tooltip = 'Your trading account balance in USD. This is used for position sizing calculations and drawdown limits.')
WEEKLY_TARGET = input.int(1500, '📈 Weekly Profit Target => ETF/CFD size to trade', minval = 500, group = group_account, tooltip = 'Defines also the ETF and CFD size to trade - 0 means take Your whole account size.')
MAX_DAILY_LOSS = input.int(100, '📉 Max Daily Loss', minval = 100, group = group_account, tooltip = 'Maximum allowed daily loss in USD before trading stops.')

session_start = input.int(0, '⏰ Session Start Hour (24h, exchange time)', minval = 0, maxval = 23, group = 'Session')
session_end = input.int(23, '⌚ Session End Hour (24h, exchange time)', minval = 0, maxval = 23, group = 'Session')
allow_weekend = input.bool(false, '📅 Allow Weekend Trading?', group = 'Session')
session_timezone = input.string('Europe/Berlin', '🌎 Session Timezone', options = ['America/New_York', 'America/Chicago', 'America/Los_Angeles', 'Europe/London', 'Europe/Berlin', 'Europe/Moscow', 'Asia/Tokyo', 'Asia/Hong_Kong', 'Asia/Shanghai', 'Asia/Singapore', 'Australia/Sydney', 'UTC'], group = 'Session')

// --- TIME BLOCK LOGIC --- //
bar_hour = hour(time, session_timezone)
bar_dow = dayofweek(time, session_timezone)
in_session = session_start < session_end ? bar_hour >= session_start and bar_hour < session_end : bar_hour >= session_start or bar_hour < session_end
not_weekend = allow_weekend or bar_dow != dayofweek.saturday and bar_dow != dayofweek.sunday

group_visual = '🎨 Visual Effects Configuration'
dashboardSize = input.string('Normal', 'Dashboard Size', options = ['Small', 'Normal', 'Large'], group = group_visual)
showFractalGrid = input.bool(false, '📜 Show Fractal Grid', group = group_visual, tooltip = 'Shows highs and lows in a grid the last 50 bars back.')
showTriggerLines = input.bool(true, '✔️ Trigger Lines / ➖ (Standard EMA (55/233))', group = group_visual, tooltip = 'Shows the configured EMAs the trigger is based on or the standard EMA 55/233 for trend visualisation.')
glowIntensity = input.int(4, 'Glow Intensity', minval = 1, maxval = 10, group = group_visual, inline = "3")
colorTheme = input.string('Matrix', 'Color Theme', options = ['Cyber', 'Quantum', 'Matrix', 'Aurora'], group = group_visual, inline = "3")

