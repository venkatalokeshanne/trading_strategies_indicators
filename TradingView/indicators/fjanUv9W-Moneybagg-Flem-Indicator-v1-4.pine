             "Score",
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             1,
             13,
             "B " + str.tostring(bullScore) + "/6",
             bgcolor = bullScore >= requiredScore ? color.green : color.gray,
             text_color = color.white,
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             2,
             13,
             "S " + str.tostring(bearScore) + "/6",
             bgcolor = bearScore >= requiredScore ? color.red : color.gray,
             text_color = color.white,
             text_size = dashboardTextSize
        )

