//@version=6
indicator("Premarket + ORB Levels - SPY & SPX", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=250)

//=============================================================================
// CONSTANTS
//=============================================================================

string TZ = "America/New_York"
string WEEKDAYS = ":23456"

//=============================================================================
// MASTER SETTINGS
//=============================================================================

string groupMaster = "──────── MASTER SETTINGS ────────"

bool showPremarket = input.bool(true, "Show Premarket Levels", group=groupMaster)
bool showORB = input.bool(true, "Show ORB Levels", group=groupMaster)
bool showLabels = input.bool(true, "Show Labels / Prices", group=groupMaster)
bool keepHistory = input.bool(false, "Keep Previous Days", group=groupMaster)

//=============================================================================
// LABEL SETTINGS
//=============================================================================

string groupLabels = "──────── LABEL SETTINGS ────────"

int orbLabelOffset = input.int(
     8,
     "ORB Label Offset",
     minval=0,
     maxval=30,
     group=groupLabels)

int spx945LabelOffset = input.int(
     15,
     "SPX 9:45 Label Offset",
     minval=0,
     maxval=30,
     group=groupLabels)

float labelGapTicks = input.float(
     8.0,
     "Label Distance From Line (ticks)",
     minval=0.0,
     group=groupLabels)

float labelGap = syminfo.mintick * labelGapTicks

//=============================================================================
// ORB SETTINGS
//=============================================================================

string groupORB = "──────── ORB SETTINGS ────────"

string orbMode = input.string(
     "Auto",
     "ORB Mode",
     options=["Auto", "SPY", "SPX", "Custom"],
     group=groupORB)

string spyORBSession = input.session(
     "0930-0945",
     "SPY ORB Time (ET)",
     group=groupORB)

string spxORBSession = input.session(
     "0930-1000",
     "SPX ORB Time (ET)",
     group=groupORB)

string customORBSession = input.session(
     "0930-0945",
     "Custom ORB Time (ET)",
     group=groupORB)

// More robust symbol detection.
bool chartIsSPY = syminfo.ticker == "SPY"
bool chartIsSPX = syminfo.ticker == "SPX" or syminfo.root == "SPX"

string selectedORBSession = switch orbMode
    "SPY" => spyORBSession
    "SPX" => spxORBSession
    "Custom" => customORBSession
    => chartIsSPX ? spxORBSession : chartIsSPY ? spyORBSession : customORBSession

//=============================================================================
// SPX 9:45 CLOSE SETTINGS
//=============================================================================

string group945 = "──────── SPX 9:45 CLOSE ────────"

bool showSPX945 = input.bool(
     true,
     "Show SPX 9:45 Close",
     group=group945)

color spx945Color = input.color(
     color.aqua,
     "9:45 Close Color",
     group=group945)

int spx945LineWidth = input.int(
     2,
     "9:45 Close Line Width",
     minval=1,
     maxval=5,
     group=group945)

string spx945StyleInput = input.string(
     "Dotted",
     "9:45 Close Line Style",
     options=["Solid", "Dashed", "Dotted"],
     group=group945)

//=============================================================================
// PREMARKET SETTINGS
//=============================================================================

string groupPM = "──────── PREMARKET SETTINGS ────────"

string premarketSession = input.session(
     "0400-0930",
     "Premarket Session (ET)",
     group=groupPM)

bool showPMHigh = input.bool(
     true,
     "Premarket High",
     group=groupPM)

bool showPMLow = input.bool(
     true,
     "Premarket Low",
     group=groupPM)

bool showPMMid = input.bool(
     true,
     "Premarket 50% Midpoint",
     group=groupPM)

bool showPM75 = input.bool(
     false,
     "Premarket 75% Level",
     group=groupPM)

bool showPM25 = input.bool(
     false,
     "Premarket 25% Level",
     group=groupPM)

bool shadePremarket = input.bool(
     true,
     "Shade Premarket Range",
     group=groupPM)

color pmShadeColor = input.color(
     color.purple,
     "Premarket Shade Color",
     group=groupPM)

int pmShadeOpacity = input.int(
     85,
     "Shade Opacity",
     minval=0,
     maxval=100,
     group=groupPM)

//=============================================================================
// LINE SETTINGS
//=============================================================================

string groupLines = "──────── LINE SETTINGS ────────"

color pmHighColor = input.color(
     color.rgb(53, 165, 19),
     "Premarket High",
     group=groupLines)

color pmLowColor = input.color(
     color.rgb(192, 20, 20),
     "Premarket Low",
     group=groupLines)

color pmMidColor = input.color(
     color.white,
     "Premarket Mid",
     group=groupLines)

color pmQuarterColor = input.color(
     color.gray,
     "Premarket 25% / 75%",
     group=groupLines)

color orbHighColor = input.color(
     color.green,
     "ORB High",
     group=groupLines)

color orbLowColor = input.color(
     color.red,
     "ORB Low",
     group=groupLines)

int pmLineWidth = input.int(
     1,
     "Premarket Line Width",
     minval=1,
     maxval=5,
     group=groupLines)

int orbLineWidth = input.int(
     2,
     "ORB Line Width",
     minval=1,
     maxval=5,
     group=groupLines)

string pmLineStyleInput = input.string(
     "Dashed",
     "Premarket Line Style",
     options=["Solid", "Dashed", "Dotted"],
     group=groupLines)

string orbLineStyleInput = input.string(
     "Solid",
     "ORB Line Style",
     options=["Solid", "Dashed", "Dotted"],
     group=groupLines)

getLineStyle(string styleInput) =>
    switch styleInput
        "Solid" => line.style_solid
        "Dotted" => line.style_dotted
        => line.style_dashed

pmLineStyle = getLineStyle(pmLineStyleInput)
orbLineStyle = getLineStyle(orbLineStyleInput)
spx945LineStyle = getLineStyle(spx945StyleInput)

//=============================================================================
// SESSION DETECTION
//=============================================================================

int pmTime = time(
     timeframe.period,
     premarketSession + WEEKDAYS,
     TZ)

int orbTime = time(
     timeframe.period,
     selectedORBSession + WEEKDAYS,
     TZ)

int regularTime = time(
     timeframe.period,
     "0930-1600" + WEEKDAYS,
     TZ)

bool inPremarket = not na(pmTime)
bool inORB = not na(orbTime)
bool inRegular = not na(regularTime)

bool pmStart =
     inPremarket and
     (bar_index == 0 or not inPremarket[1])

bool orbStart =
     inORB and
     (bar_index == 0 or not inORB[1])

//=============================================================================
// TODAY'S SESSION TIMES
//=============================================================================

int premarketCloseTime = timestamp(
     TZ,
     year(time, TZ),
     month(time, TZ),
     dayofmonth(time, TZ),
     9,
     30)

int marketCloseTime = timestamp(
     TZ,
     year(time, TZ),
     month(time, TZ),
     dayofmonth(time, TZ),
     16,
     0)

//=============================================================================
// SPX 9:45 CLOSE
//
// IMPORTANT:
// The 9:45 test is deliberately INSIDE the 15-minute request.
// This makes the calculation independent of the chart timeframe.
//=============================================================================

float spx945Close = request.security(
     syminfo.tickerid,
     "15",
     ta.valuewhen(
         hour(time_close, TZ) == 9 and minute(time_close, TZ) == 45,
         close,
         0),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

int spx945CloseTime = request.security(
     syminfo.tickerid,
     "15",
     ta.valuewhen(
         hour(time_close, TZ) == 9 and minute(time_close, TZ) == 45,
         time_close,
         0),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

//=============================================================================
// PREMARKET VARIABLES
//=============================================================================

var float pmHigh = na
var float pmLow = na
var float pmMid = na
var float pm75 = na
var float pm25 = na

var line pmHighLine = na
var line pmLowLine = na
var line pmMidLine = na
var line pm75Line = na
var line pm25Line = na

var label pmHighLabel = na
var label pmLowLabel = na
var label pmMidLabel = na
var label pm75Label = na
var label pm25Label = na

var box pmBox = na

//=============================================================================
// ORB VARIABLES
//=============================================================================

var float orbHigh = na
var float orbLow = na

var line orbHighLine = na
var line orbLowLine = na

var label orbHighLabel = na
var label orbLowLabel = na

//=============================================================================
// SPX 9:45 VARIABLES
//=============================================================================

var line spx945Line = na
var label spx945Label = na
var int last945DrawnTime = na

//=============================================================================
// DELETE OLD PREMARKET OBJECTS
//=============================================================================

if pmStart and not keepHistory

    if not na(pmHighLine)
        line.delete(pmHighLine)

    if not na(pmLowLine)
        line.delete(pmLowLine)

    if not na(pmMidLine)
        line.delete(pmMidLine)

    if not na(pm75Line)
        line.delete(pm75Line)

    if not na(pm25Line)
        line.delete(pm25Line)

    if not na(pmHighLabel)
        label.delete(pmHighLabel)

    if not na(pmLowLabel)
        label.delete(pmLowLabel)

    if not na(pmMidLabel)
        label.delete(pmMidLabel)

    if not na(pm75Label)
        label.delete(pm75Label)

    if not na(pm25Label)
        label.delete(pm25Label)

    if not na(pmBox)
        box.delete(pmBox)

//=============================================================================
// DELETE OLD ORB OBJECTS
//=============================================================================

if orbStart and not keepHistory

    if not na(orbHighLine)
        line.delete(orbHighLine)

    if not na(orbLowLine)
        line.delete(orbLowLine)

    if not na(orbHighLabel)
        label.delete(orbHighLabel)

    if not na(orbLowLabel)
        label.delete(orbLowLabel)

//=============================================================================
// PREMARKET START
//=============================================================================

if pmStart and showPremarket

    pmHigh := high
    pmLow := low

    pmMid := (pmHigh + pmLow) / 2.0
    pm75 := pmLow + ((pmHigh - pmLow) * 0.75)
    pm25 := pmLow + ((pmHigh - pmLow) * 0.25)

    if shadePremarket
        pmBox := box.new(
             left=bar_index,
             top=pmHigh,
             right=bar_index,
             bottom=pmLow,
             bgcolor=color.new(pmShadeColor, pmShadeOpacity),
             border_color=na)

    // PM HIGH continues through 4 PM.
    if showPMHigh
        pmHighLine := line.new(
             x1=time,
             y1=pmHigh,
             x2=marketCloseTime,
             y2=pmHigh,
             xloc=xloc.bar_time,
             color=pmHighColor,
             width=pmLineWidth,
             style=pmLineStyle)

    // PM LOW continues through 4 PM.
    if showPMLow
        pmLowLine := line.new(
             x1=time,
             y1=pmLow,
             x2=marketCloseTime,
             y2=pmLow,
             xloc=xloc.bar_time,
             color=pmLowColor,
             width=pmLineWidth,
             style=pmLineStyle)

    // PM MID stops at 9:30.
    if showPMMid
        pmMidLine := line.new(
             x1=time,
             y1=pmMid,
             x2=premarketCloseTime,
             y2=pmMid,
             xloc=xloc.bar_time,
             color=pmMidColor,
             width=pmLineWidth,
             style=pmLineStyle)

    if showPM75
        pm75Line := line.new(
             x1=time,
             y1=pm75,
             x2=marketCloseTime,
             y2=pm75,
             xloc=xloc.bar_time,
             color=pmQuarterColor,
             width=pmLineWidth,
             style=pmLineStyle)

    if showPM25
        pm25Line := line.new(
             x1=time,
             y1=pm25,
             x2=marketCloseTime,
             y2=pm25,
             xloc=xloc.bar_time,
             color=pmQuarterColor,
             width=pmLineWidth,
             style=pmLineStyle)

    // Use TIME coordinates for PM labels.
    // They can move during premarket, then freeze at exactly 9:30 ET.
    if showLabels

        if showPMHigh
            pmHighLabel := label.new(
                 x=time,
                 y=pmHigh,
                 text="",
                 xloc=xloc.bar_time,
                 yloc=yloc.price,
                 style=label.style_none,
                 textcolor=pmHighColor,
                 size=size.normal)

        if showPMLow
            pmLowLabel := label.new(
                 x=time,
                 y=pmLow,
                 text="",
                 xloc=xloc.bar_time,
                 yloc=yloc.price,
                 style=label.style_none,
                 textcolor=pmLowColor,
                 size=size.normal)

        if showPMMid
            pmMidLabel := label.new(
                 x=time,
                 y=pmMid,
                 text="",
                 xloc=xloc.bar_time,
                 yloc=yloc.price,
                 style=label.style_none,
                 textcolor=pmMidColor,
                 size=size.normal)

        if showPM75
            pm75Label := label.new(
                 x=time,
                 y=pm75,
                 text="",
                 xloc=xloc.bar_time,
                 yloc=yloc.price,
                 style=label.style_none,
                 textcolor=pmQuarterColor,
                 size=size.normal)

        if showPM25
            pm25Label := label.new(
                 x=time,
                 y=pm25,
                 text="",
                 xloc=xloc.bar_time,
                 yloc=yloc.price,
                 style=label.style_none,
                 textcolor=pmQuarterColor,
                 size=size.normal)

//=============================================================================
// UPDATE PREMARKET RANGE
//=============================================================================

if inPremarket and showPremarket

    pmHigh := na(pmHigh) ? high : math.max(pmHigh, high)
    pmLow := na(pmLow) ? low : math.min(pmLow, low)

    pmMid := (pmHigh + pmLow) / 2.0
    pm75 := pmLow + ((pmHigh - pmLow) * 0.75)
    pm25 := pmLow + ((pmHigh - pmLow) * 0.25)

    if shadePremarket and not na(pmBox)
        box.set_right(pmBox, bar_index)
        box.set_top(pmBox, pmHigh)
        box.set_bottom(pmBox, pmLow)

    if showPMHigh and not na(pmHighLine)
        line.set_y1(pmHighLine, pmHigh)
        line.set_y2(pmHighLine, pmHigh)

    if showPMLow and not na(pmLowLine)
        line.set_y1(pmLowLine, pmLow)
        line.set_y2(pmLowLine, pmLow)

    if showPMMid and not na(pmMidLine)
        line.set_y1(pmMidLine, pmMid)
        line.set_y2(pmMidLine, pmMid)
        line.set_x2(pmMidLine, premarketCloseTime)

    if showPM75 and not na(pm75Line)
        line.set_y1(pm75Line, pm75)
        line.set_y2(pm75Line, pm75)

    if showPM25 and not na(pm25Line)
        line.set_y1(pm25Line, pm25)
        line.set_y2(pm25Line, pm25)

//=============================================================================
// PREMARKET LABELS
//
// During PM: move with current candle.
// After PM: FREEZE at 9:30 ET.
//=============================================================================

if showPremarket and showLabels and (inPremarket or inRegular)

    int pmLabelTime = inPremarket ? time : premarketCloseTime

    if showPMHigh and not na(pmHighLabel)
        label.set_x(pmHighLabel, pmLabelTime)
        label.set_y(pmHighLabel, pmHigh + labelGap)
        label.set_text(
             pmHighLabel,
             "PM HIGH  " +
             str.tostring(pmHigh, format.mintick))

    if showPMLow and not na(pmLowLabel)
        label.set_x(pmLowLabel, pmLabelTime)
        label.set_y(pmLowLabel, pmLow - labelGap)
        label.set_text(
             pmLowLabel,
             "PM LOW  " +
             str.tostring(pmLow, format.mintick))

    if showPMMid and not na(pmMidLabel)
        label.set_x(pmMidLabel, pmLabelTime)
        label.set_y(pmMidLabel, pmMid + labelGap)
        label.set_text(
             pmMidLabel,
             "PM 50%  " +
             str.tostring(pmMid, format.mintick))

    if showPM75 and not na(pm75Label)
        label.set_x(pm75Label, pmLabelTime)
        label.set_y(pm75Label, pm75 + labelGap)
        label.set_text(
             pm75Label,
             "PM 75%  " +
             str.tostring(pm75, format.mintick))

    if showPM25 and not na(pm25Label)
        label.set_x(pm25Label, pmLabelTime)
        label.set_y(pm25Label, pm25 - labelGap)
        label.set_text(
             pm25Label,
             "PM 25%  " +
             str.tostring(pm25, format.mintick))

//=============================================================================
// ORB START
//=============================================================================

if orbStart and showORB

    orbHigh := high
    orbLow := low

    orbHighLine := line.new(
         x1=time,
         y1=orbHigh,
         x2=marketCloseTime,
         y2=orbHigh,
         xloc=xloc.bar_time,
         color=orbHighColor,
         width=orbLineWidth,
         style=orbLineStyle)

    orbLowLine := line.new(
         x1=time,
         y1=orbLow,
         x2=marketCloseTime,
         y2=orbLow,
         xloc=xloc.bar_time,
         color=orbLowColor,
         width=orbLineWidth,
         style=orbLineStyle)

    if showLabels

        orbHighLabel := label.new(
             bar_index,
             orbHigh,
             "",
             xloc=xloc.bar_index,
             yloc=yloc.price,
             style=label.style_none,
             textcolor=orbHighColor,
             size=size.normal)

        orbLowLabel := label.new(
             bar_index,
             orbLow,
             "",
             xloc=xloc.bar_index,
             yloc=yloc.price,
             style=label.style_none,
             textcolor=orbLowColor,
             size=size.normal)

//=============================================================================
// UPDATE ORB
//=============================================================================

if inORB and showORB

    orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
    orbLow := na(orbLow) ? low : math.min(orbLow, low)

    if not na(orbHighLine)
        line.set_y1(orbHighLine, orbHigh)
        line.set_y2(orbHighLine, orbHigh)

    if not na(orbLowLine)
        line.set_y1(orbLowLine, orbLow)
        line.set_y2(orbLowLine, orbLow)

//=============================================================================
// ORB LABELS
//=============================================================================

if showORB and showLabels and (inORB or inRegular)

    int orbX = bar_index + orbLabelOffset

    if not na(orbHighLabel)
        label.set_x(orbHighLabel, orbX)
        label.set_y(orbHighLabel, orbHigh + labelGap)
        label.set_text(
             orbHighLabel,
             "ORB HIGH  " +
             str.tostring(orbHigh, format.mintick))

    if not na(orbLowLabel)
        label.set_x(orbLowLabel, orbX)
        label.set_y(orbLowLabel, orbLow - labelGap)
        label.set_text(
             orbLowLabel,
             "ORB LOW  " +
             str.tostring(orbLow, format.mintick))

//=============================================================================
// SPX 9:45 CLOSE
//
// Detect each NEW 9:45 ET 15-minute close.
// Draw from 9:45 to that day's 4:00 PM close.
//=============================================================================

bool newSPX945 =
     chartIsSPX and
     showSPX945 and
     not na(spx945Close) and
     not na(spx945CloseTime) and
     spx945CloseTime != last945DrawnTime

if newSPX945

    // Derive the correct day's 4 PM timestamp from the actual
    // 9:45 closing timestamp, rather than the chart bar.
    int spx945MarketCloseTime = timestamp(
         TZ,
         year(spx945CloseTime, TZ),
         month(spx945CloseTime, TZ),
         dayofmonth(spx945CloseTime, TZ),
         16,
         0)

    if not keepHistory

        if not na(spx945Line)
            line.delete(spx945Line)

        if not na(spx945Label)
            label.delete(spx945Label)

    spx945Line := line.new(
         x1=spx945CloseTime,
         y1=spx945Close,
         x2=spx945MarketCloseTime,
         y2=spx945Close,
         xloc=xloc.bar_time,
         color=spx945Color,
         width=spx945LineWidth,
         style=spx945LineStyle)

    if showLabels

        spx945Label := label.new(
             bar_index,
             spx945Close,
             "",
             xloc=xloc.bar_index,
             yloc=yloc.price,
             style=label.style_none,
             textcolor=spx945Color,
             size=size.normal)

    last945DrawnTime := spx945CloseTime

//=============================================================================
// SPX 9:45 LABEL
//=============================================================================

if chartIsSPX and showSPX945 and showLabels and not na(spx945Label)

    int spx945X = bar_index + spx945LabelOffset

    label.set_x(
         spx945Label,
         spx945X)

    label.set_y(
         spx945Label,
         spx945Close + labelGap)

    label.set_text(
         spx945Label,
         "SPX 9:45 CLOSE  " +
         str.tostring(
             spx945Close,
             format.mintick))