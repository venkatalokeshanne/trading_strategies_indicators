//@version=6
// ═════════════════════════════════════════════════════════════════════════════
//  MBF_RZ LIQUIDITY RADAR — Glow · Story · Delivery
//  MBF & RZ Trading — free public flagship. v1.5 (2026-08-12) — structure markers + next-draw-of-liquidity + LTF CHoCH confirmation + STRATEGY ENGINE
// ─────────────────────────────────────────────────────────────────────────────
//  STRATEGY ENGINE (v1.5) — built for the 5m sweep+BOS / fib-OTE / internal-sweep /
//  1m-confirmation playbook: 1H trend → 5m sweep+BOS (with fib+OTE zone drawn from
//  the broken swing to the sweep) → internal liquidity swept inside the OTE zone →
//  1m BOS confirms entry → SL at the new LTF swing, TP at the next unswept magnet.
//  Still draws context only; you pull the trigger. See "🧠 STRATEGY" input groups.
// ─────────────────────────────────────────────────────────────────────────────
//  THREE ENGINES, ONE CHART:
//   1. LIQUIDITY RADAR — untapped swing highs/lows and EQH/EQL clusters render
//      as GLOW BANDS (gold buyside above, purple sellside below — MBF brand).
//      Glow intensifies with touches + age. Swept pools FLASH ⚡ and burn to a
//      dim EMBER that persists all session — the scar where liquidity died.
//   2. STORYTELLER — one-line live narrative in the market's own sequence:
//      "London low swept → displacement up → CISD ✓ → 5m CHoCH ✓ → delivering to PDH".
//      No arrows, no signals. The story, in plain English.
//   3. DELIVERY MAP — right-edge ladder of every unmitigated magnet (pools,
//      PDH/PDL, PWH/PWL, EQs) ranked by pull score. Where is price owed?
//  PHILOSOPHY: this tool draws CONTEXT, never entries. No sweep = no story =
//  no trade. Educational only — not financial advice.
// ═════════════════════════════════════════════════════════════════════════════
indicator('MBF_RZ LIQUIDITY RADAR — Glow · Story · Delivery', shorttitle='MBF RADAR', overlay=true, max_boxes_count=500, max_labels_count=200, max_lines_count=100)

// ─── STYLE — MAKE IT YOUR OWN ────────────────────────────────────────────────
g0 = "🎨 STYLE — Make It Your Own"
C_BUY   = input.color(#FFD700, "Buyside pools", group=g0, inline="c1", tooltip="Pools above price (swing highs / EQH clusters). MBF default: gold.")
C_SELL  = input.color(#AA00FF, "Sellside pools", group=g0, inline="c1", tooltip="Pools below price (swing lows / EQL clusters). MBF default: purple.")
C_TXT   = input.color(#F3EEE2, "Panel text", group=g0, inline="c2")
C_PANEL = input.color(#132420, "Panel background", group=g0, inline="c2")
bold_on    = input.bool(true, "◼ Pool level markers", group=g0, inline="b1", tooltip="Marks each pool's exact level through the glow — the precision read. Default is a scattered dot plot; switch to Solid/Dashed for a heavier look.")
bold_w     = input.int(1, "Width", minval=1, maxval=4, group=g0, inline="b1", tooltip="Width 1 keeps dots crisp. Wider turns dots into beads.")
bold_style = input.string("Dotted", "Marker style", options=["Dotted","Dashed","Solid"], group=g0)
band_mult  = input.float(1.0, "Glow band thickness ×", minval=0.4, maxval=3.0, step=0.2, group=g0, tooltip="Scales all three glow layers. Thicker = louder chart, thinner = surgical.")
ember_line = input.bool(true, "Keep bold line on embers (dimmed, dashed)", group=g0, tooltip="Swept pools keep a faint dashed line at the level — the scar stays readable.")
f_lstyle(string x) =>
    x == "Dashed" ? line.style_dashed : x == "Dotted" ? line.style_dotted : line.style_solid

// ─── INPUTS ──────────────────────────────────────────────────────────────────
g1 = "🔥 RADAR — Liquidity Glow"
piv_len    = input.int(8,  "Pivot length", minval=2, maxval=50, group=g1, tooltip="Swing strength for pool detection. Lower = more pools, faster; higher = only major swings.")
max_pools  = input.int(12, "Max live pools per side", minval=3, maxval=20, group=g1)
tol_atr    = input.float(0.25, "Cluster tolerance (×ATR)", minval=0.05, maxval=1.0, step=0.05, group=g1, tooltip="Pivots within this distance stack into ONE pool and add strength (EQH/EQL detection).")
glow_max_t = input.int(70, "Glow core transparency (strongest)", minval=40, maxval=90, group=g1)
show_ember = input.bool(true, "Keep swept embers all session", group=g1)
ember_t    = input.int(92, "Ember transparency", minval=80, maxval=98, group=g1)
show_flash = input.bool(true, "⚡ Flash on sweep", group=g1)

g2 = "📖 STORYTELLER"
show_story = input.bool(true, "Show narrative bar", group=g2)
disp_mult  = input.float(1.4, "Displacement threshold (×ATR)", minval=0.8, maxval=3.0, step=0.1, group=g2, tooltip="A candle body larger than this ×ATR counts as displacement.")
story_pos_s = input.string("Top Center", "Position", options=["Top Center","Top Left","Top Right","Bottom Center"], group=g2)

g3 = "🎯 DELIVERY MAP"
show_map   = input.bool(true, "Show delivery ladder", group=g3)
map_rows   = input.int(8, "Max ladder rows", minval=4, maxval=12, group=g3)
map_pos_s  = input.string("Middle Right", "Position", options=["Top Right","Middle Right","Bottom Right","Top Left","Middle Left","Bottom Left","Top Center","Bottom Center"], group=g3)
w_dist     = input.float(1.0, "Distance weight", minval=0.2, maxval=3.0, step=0.1, group=g3, tooltip="Higher = nearer magnets rank higher. Lower = strength dominates the ranking.")

g5 = "🧭 STRUCTURE & NEXT DRAW"
show_struct = input.bool(true, "Structure markers (BOS / CHoCH)", group=g5, tooltip="Marks every break of structure and change of character at the broken level. Bull breaks purple, bear breaks gold — MBF direction colors.")
show_dol    = input.bool(true, "◎ Next Draw of Liquidity", group=g5, tooltip="The single level price is most likely drawn to next: structure direction picks the side (bullish = buyside above, bearish = sellside below), nearest unswept magnet on that side wins. Before any structure break: discount draws up, premium draws down (vs Daily EQ).")
c_bull      = input.color(#AA00FF, "Bull", group=g5, inline="sd")
c_bear      = input.color(#FFD700, "Bear", group=g5, inline="sd")

g6 = "⏱ LTF CHoCH CONFIRMATION"
use_choch5    = input.bool(true, "Watch for LTF CHoCH after sweep", group=g6, tooltip="After a liquidity sweep, watches a lower timeframe for a change of character in the expected reversal direction — the classic 'sweep then 5m CHoCH' confirmation.")
choch5_ltf    = input.timeframe("5", "LTF for CHoCH", group=g6, tooltip="Lower timeframe used to detect the change of character. Default 5 minutes.")
choch5_len    = input.int(6, "LTF pivot length", minval=2, maxval=30, group=g6, tooltip="Swing strength on the LTF. Lower = more sensitive/faster CHoCH, higher = fewer/more reliable signals.")
choch5_window = input.int(60, "Valid window (bars, this chart's TF)", minval=5, maxval=500, group=g6, tooltip="How many bars of THIS chart the CHoCH watch stays active after a sweep before it expires unconfirmed.")
choch5_mark   = input.bool(true, "Mark confirmation on chart", group=g6)

g7 = "🧠 STRATEGY — 1H Trend"
use_strategy   = input.bool(true, "Enable strategy engine", group=g7, tooltip="Runs the full setup: 1H trend → 5m sweep+BOS → fib/OTE → internal sweep → 1m BOS entry → SL/TP.")
htf_trend_tf   = input.timeframe("60", "HTF for trend", group=g7, tooltip="Timeframe used to judge the higher-timeframe trend. Default 1 hour.")
htf_piv_len    = input.int(6, "HTF pivot length", minval=2, maxval=30, group=g7)
use_htf_ema    = input.bool(true, "Require HTF EMA alignment (strong-trend filter)", group=g7, tooltip="Only treats the HTF trend as valid when price is also on the correct side of this EMA — filters weak/choppy structure breaks.")
htf_ema_len    = input.int(50, "HTF EMA length", minval=5, maxval=300, group=g7)

g8 = "🧠 STRATEGY — 5m Setup & Fib/OTE"
setup_window   = input.int(30, "Sweep → BOS max gap (bars)", minval=3, maxval=200, group=g8, tooltip="How many bars after a counter-trend sweep a follow-up BOS still counts as the same setup.")
show_fib       = input.bool(true, "Draw fib range + OTE zone", group=g8)
fib_ote_lo     = input.float(0.618, "OTE zone start", minval=0.3, maxval=0.9, step=0.01, group=g8, inline="ote")
fib_ote_hi     = input.float(0.79, "OTE zone end", minval=0.3, maxval=0.99, step=0.01, group=g8, inline="ote")
fib_window     = input.int(80, "Fib validity window (bars)", minval=5, maxval=400, group=g8, tooltip="How long a setup stays live waiting for price to sweep internal liquidity inside the OTE zone before it expires.")

g9 = "🧠 STRATEGY — Internal Liquidity & Entry"
internal_piv_len = input.int(3, "Internal pivot length", minval=1, maxval=10, group=g9, tooltip="Smaller swing length used to find minor internal liquidity points inside the OTE zone.")
entry_ltf         = input.timeframe("1", "Entry confirmation TF", group=g9, tooltip="Lower timeframe watched for the confirming break of structure. Default 1 minute.")
entry_piv_len     = input.int(3, "Entry TF pivot length", minval=1, maxval=15, group=g9)
entry_window      = input.int(20, "Entry confirmation window (bars)", minval=3, maxval=200, group=g9, tooltip="How many bars after the internal sweep the entry-TF BOS confirmation stays valid.")
show_trade        = input.bool(true, "Show entry marker + SL/TP", group=g9)

g10 = "🧠 STRATEGY — Status Panel"
show_sm_panel  = input.bool(true, "Show strategy status panel", group=g10)
sm_panel_pos_s = input.string("Bottom Center", "Position", options=["Top Center","Top Left","Top Right","Bottom Center","Bottom Left","Bottom Right"], group=g10)

g4 = "🏷 BRAND"
show_wm = input.bool(true, "Watermark", group=g4)
wm_pos_s = input.string("Bottom Right", "Position", options=["Bottom Right","Bottom Left","Top Right","Top Left"], group=g4)

// ─── SHARED SERIES ───────────────────────────────────────────────────────────
atr = ta.atr(14)
float tol = atr * tol_atr

// HTF levels for storyteller targets + delivery map
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)
float d_eq = (pdh + pdl) / 2
float w_eq = (pwh + pwl) / 2

// ─── POOL TYPE ───────────────────────────────────────────────────────────────
type Pool
    float lvl        // pool level (weighted center of cluster)
    int   touches    // pivots merged into this pool
    int   born       // bar_index at creation
    bool  buyside    // true = above price (swing highs)
    bool  swept      // burned to ember
    int   swept_bar
    box   b_core     // glow layers
    box   b_mid
    box   b_out
    label flash
    line  ln

var array<Pool> pools = array.new<Pool>()

// ─── HELPERS ─────────────────────────────────────────────────────────────────
f_strength(Pool p) =>
    // 0.0 .. 1.0 — touches dominate, age seasons
    float s_t = math.min(p.touches / 4.0, 1.0)
    float s_a = math.min((bar_index - p.born) / 300.0, 1.0)
    0.7 * s_t + 0.3 * s_a

f_glow_colors(Pool p) =>
    float st = f_strength(p)
    color base = p.buyside ? C_BUY : C_SELL
    int t_core = int(glow_max_t + (1.0 - st) * (96 - glow_max_t))
    [color.new(base, t_core), color.new(base, math.min(t_core + 12, 97)), color.new(base, math.min(t_core + 22, 98))]

f_draw(Pool p) =>
    [c1, c2, c3] = f_glow_colors(p)
    color base_c = p.buyside ? C_BUY : C_SELL
    int lft = math.max(p.born, bar_index - 450)   // drawings can't anchor too far back; strength still uses true p.born
    float h = math.max(tol * 0.6, syminfo.mintick * 2) * band_mult
    if na(p.b_core)
        p.b_core := box.new(lft, p.lvl + h*0.5, bar_index, p.lvl - h*0.5, xloc=xloc.bar_index, extend=extend.right, border_color=na, bgcolor=c1)
        p.b_mid  := box.new(lft, p.lvl + h*1.2, bar_index, p.lvl - h*1.2, xloc=xloc.bar_index, extend=extend.right, border_color=na, bgcolor=c2)
        p.b_out  := box.new(lft, p.lvl + h*2.2, bar_index, p.lvl - h*2.2, xloc=xloc.bar_index, extend=extend.right, border_color=na, bgcolor=c3)
        if bold_on
            p.ln := line.new(lft, p.lvl, bar_index, p.lvl, xloc=xloc.bar_index, extend=extend.right, color=color.new(base_c, 15), width=bold_w, style=f_lstyle(bold_style))
        true
    else
        box.set_top(p.b_core, p.lvl + h*0.5)
        box.set_bottom(p.b_core, p.lvl - h*0.5)
        box.set_bgcolor(p.b_core, c1)
        box.set_top(p.b_mid, p.lvl + h*1.2)
        box.set_bottom(p.b_mid, p.lvl - h*1.2)
        box.set_bgcolor(p.b_mid, c2)
        box.set_top(p.b_out, p.lvl + h*2.2)
        box.set_bottom(p.b_out, p.lvl - h*2.2)
        box.set_bgcolor(p.b_out, c3)
        if bold_on and not na(p.ln)
            line.set_y1(p.ln, p.lvl)
            line.set_y2(p.ln, p.lvl)
        true

f_ember(Pool p) =>
    // collapse glow to one dim scar
    color base = p.buyside ? C_BUY : C_SELL
    if not na(p.b_mid)
        box.delete(p.b_mid)
        box.delete(p.b_out)
        p.b_mid := na
        p.b_out := na
    if not na(p.b_core)
        box.set_bgcolor(p.b_core, color.new(base, ember_t))
        box.set_extend(p.b_core, extend.none)
        box.set_right(p.b_core, bar_index)
        true
    if not na(p.ln)
        if ember_line
            line.set_color(p.ln, color.new(base, 70))
            line.set_style(p.ln, line.style_dotted)
            line.set_extend(p.ln, extend.none)
            line.set_x2(p.ln, bar_index)
            line.set_width(p.ln, 1)
        else
            line.delete(p.ln)
            p.ln := na
        true

f_kill(Pool p) =>
    if not na(p.b_core)
        box.delete(p.b_core)
    if not na(p.b_mid)
        box.delete(p.b_mid)
    if not na(p.b_out)
        box.delete(p.b_out)
    if not na(p.flash)
        label.delete(p.flash)
    if not na(p.ln)
        line.delete(p.ln)

f_prune(bool buyside) =>
    // enforce max live pools per side — drop the weakest/oldest live pool
    int live = 0
    int weakest = -1
    float wscore = 999.0
    if array.size(pools) > 0
        for i = 0 to array.size(pools) - 1
            Pool p = array.get(pools, i)
            if p.buyside == buyside and not p.swept
                live += 1
                float sc = f_strength(p)
                if sc < wscore
                    wscore := sc
                    weakest := i
    if live > max_pools and weakest >= 0
        Pool w = array.get(pools, weakest)
        f_kill(w)
        array.remove(pools, weakest)

f_absorb(float lvl, bool buyside) =>
    // merge into an existing live pool within tolerance, else create
    bool merged = false
    if array.size(pools) > 0
        for i = 0 to array.size(pools) - 1
            Pool p = array.get(pools, i)
            if not merged and p.buyside == buyside and not p.swept and math.abs(p.lvl - lvl) <= tol
                p.lvl := (p.lvl * p.touches + lvl) / (p.touches + 1)
                p.touches += 1
                merged := true
    if not merged
        Pool np = Pool.new(lvl, 1, bar_index, buyside, false, na, na, na, na, na, na)
        array.push(pools, np)
        f_prune(buyside)

// ─── DETECT PIVOTS → POOLS ───────────────────────────────────────────────────
float ph = ta.pivothigh(high, piv_len, piv_len)
float pl = ta.pivotlow(low, piv_len, piv_len)
if not na(ph)
    f_absorb(ph, true)
if not na(pl)
    f_absorb(pl, false)

// ─── STRUCTURE ENGINE (BOS / CHoCH) ──────────────────────────────────────────
var float sw_hi = float(na)      // last unbroken swing high
var float sw_lo = float(na)      // last unbroken swing low
var int   struct_dir = 0         // 1 bull · -1 bear · 0 none yet
var float last_bos_up_lvl = na   // swing high level broken on the most recent bullish BOS
var int   last_bos_up_bar = na
var float last_bos_dn_lvl = na   // swing low level broken on the most recent bearish BOS
var int   last_bos_dn_bar = na
if not na(ph)
    sw_hi := ph
if not na(pl)
    sw_lo := pl
if not na(sw_hi) and close > sw_hi
    if show_struct
        label.new(bar_index, sw_hi, struct_dir == -1 ? "CHoCH" : "BOS", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=c_bull, size=size.small)
    last_bos_up_lvl := sw_hi
    last_bos_up_bar := bar_index
    struct_dir := 1
    sw_hi := float(na)
if not na(sw_lo) and close < sw_lo
    if show_struct
        label.new(bar_index, sw_lo, struct_dir == 1 ? "CHoCH" : "BOS", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=c_bear, size=size.small)
    last_bos_dn_lvl := sw_lo
    last_bos_dn_bar := bar_index
    struct_dir := -1
    sw_lo := float(na)

// ─── LTF CHoCH ENGINE (independent structure on a lower timeframe) ──────────
f_ltf_struct(int len) =>
    var float sHi = na
    var float sLo = na
    var int   d   = 0
    var bool  ch  = false
    float phL = ta.pivothigh(high, len, len)
    float plL = ta.pivotlow(low, len, len)
    if not na(phL)
        sHi := phL
    if not na(plL)
        sLo := plL
    ch := false
    if not na(sHi) and close > sHi
        if d == -1
            ch := true
        d := 1
        sHi := na
    if not na(sLo) and close < sLo
        if d == 1
            ch := true
        d := -1
        sLo := na
    [d, ch]

// ─── TARGET (nearest strong opposing magnet) ─────────────────────────────────
// NOTE: moved up here (was previously defined near the bottom of the script).
// Pine requires a function to be defined before any call site that uses it —
// this is called from the STRATEGY ENGINE's STATE 3 block below, so it must
// sit above that. pools / pdh / pdl / pwh / pwl / d_eq / w_eq / Pool are all
// already defined above this point, so nothing else needs to move.
f_nearest_target(bool up) =>
    string nm = string(na)
    float  lv = float(na)
    float  best = 1e10
    // candidate pools
    if array.size(pools) > 0
        for i = 0 to array.size(pools) - 1
            Pool p = array.get(pools, i)
            if not p.swept and p.buyside == up
                float dist = up ? p.lvl - close : close - p.lvl
                if dist > 0 and dist < best
                    best := dist
                    nm := (up ? "BSL pool " : "SSL pool ") + str.tostring(p.lvl, format.mintick)
                    lv := p.lvl
    // HTF candidates
    array<float>  h_lv = up ? array.from(pdh, pwh, d_eq, w_eq) : array.from(pdl, pwl, d_eq, w_eq)
    array<string> h_nm = up ? array.from("PDH", "PWH", "D-EQ", "W-EQ") : array.from("PDL", "PWL", "D-EQ", "W-EQ")
    for hi = 0 to 3
        float l = array.get(h_lv, hi)
        float dist = up ? l - close : close - l
        if dist > 0 and dist < best
            best := dist
            nm := array.get(h_nm, hi) + " " + str.tostring(l, format.mintick)
            lv := l
    [nm, lv]

[d, ch] = request.security(syminfo.tickerid, choch5_ltf, f_ltf_struct(choch5_len), lookahead=barmerge.lookahead_off)
ltf_dir   = use_choch5 ? d  : 0
ltf_choch = use_choch5 ? ch : false

// ─── STRATEGY: HTF TREND + ENTRY-TF BOS ENGINES ──────────────────────────────
f_htf_dir(int len) =>
    var float sHi = na
    var float sLo = na
    var int   d   = 0
    float phH = ta.pivothigh(high, len, len)
    float plH = ta.pivotlow(low, len, len)
    if not na(phH)
        sHi := phH
    if not na(plH)
        sLo := plH
    if not na(sHi) and close > sHi
        d := 1
        sHi := na
    if not na(sLo) and close < sLo
        d := -1
        sLo := na
    d

f_ltf_bos(int len) =>
    // like f_ltf_struct but flags ANY break in either direction (continuation, not just reversal)
    var float sHi = na
    var float sLo = na
    var bool  brkUp = false
    var bool  brkDn = false
    float phL = ta.pivothigh(high, len, len)
    float plL = ta.pivotlow(low, len, len)
    if not na(phL)
        sHi := phL
    if not na(plL)
        sLo := plL
    brkUp := false
    brkDn := false
    if not na(sHi) and close > sHi
        brkUp := true
        sHi := na
    if not na(sLo) and close < sLo
        brkDn := true
        sLo := na
    [brkUp, brkDn]

htf_dir      = use_strategy ? request.security(syminfo.tickerid, htf_trend_tf, f_htf_dir(htf_piv_len)) : 0
htf_close_v  = use_strategy ? request.security(syminfo.tickerid, htf_trend_tf, close) : na
htf_ema_v    = use_strategy ? request.security(syminfo.tickerid, htf_trend_tf, ta.ema(close, htf_ema_len)) : na
bool ema_ok_bull = not use_htf_ema or (htf_close_v > htf_ema_v)
bool ema_ok_bear = not use_htf_ema or (htf_close_v < htf_ema_v)
int trend_dir = not use_strategy ? 0 : htf_dir == 1 and ema_ok_bull ? 1 : htf_dir == -1 and ema_ok_bear ? -1 : 0

[eu, ed] = request.security(syminfo.tickerid, entry_ltf, f_ltf_bos(entry_piv_len), lookahead=barmerge.lookahead_off)
e_brk_up = use_strategy ? eu : false
e_brk_dn = use_strategy ? ed : false

// ─── SWEEP DETECTION + STORY STATE ───────────────────────────────────────────
var string st_sweep_side = string(na)  // "buyside" / "sellside"
var float  st_sweep_lvl  = na
var int    st_sweep_time = na
var int    st_sweep_bar  = na
var string st_sweep_sess = string(na)
var bool   st_disp_seen  = false      // displacement occurred since sweep (v6: cannot na-check a bool)
var bool   st_disp_up    = false      // displacement direction (valid only when st_disp_seen)
var bool   st_cisd       = false
var float  st_disp_open  = na      // open of the displacement candle (CISD ref)
var bool   st_5m_confirmed   = false  // LTF CHoCH confirmed in the expected reversal direction
var int    st_5m_confirm_bar = na
var bool   st_sweep_used     = false  // strategy engine: has this sweep already spawned a setup?

f_session_name() =>
    int h = hour(time, "America/New_York")
    h >= 18 or h < 2 ? "Asia" : h < 5 ? "London" : h < 8 ? "Pre-NY" : h < 12 ? "NY AM" : h < 16 ? "NY PM" : "Post"

if array.size(pools) > 0
    for i = 0 to array.size(pools) - 1
        Pool p = array.get(pools, i)
        if not p.swept
            bool hit = p.buyside ? high > p.lvl : low < p.lvl
            if hit
                p.swept := true
                p.swept_bar := bar_index
                if show_flash
                    p.flash := label.new(bar_index, p.lvl, "⚡", xloc=xloc.bar_index, yloc=yloc.price, style=p.buyside ? label.style_label_down : label.style_label_up, color=color.new(p.buyside ? C_BUY : C_SELL, 20), textcolor=color.white, size=size.small)
                if show_ember
                    f_ember(p)
                else
                    f_kill(p)
                // story: latest sweep wins the narrative
                st_sweep_side := p.buyside ? "buyside" : "sellside"
                st_sweep_lvl  := p.lvl
                st_sweep_time := time
                st_sweep_bar  := bar_index
                st_sweep_sess := f_session_name()
                st_disp_seen := false
                st_disp_up := false
                st_cisd := false
                st_disp_open := float(na)
                st_5m_confirmed := false
                st_5m_confirm_bar := na
                st_sweep_used := false
            true
        else if show_ember and not na(p.b_core)
            box.set_right(p.b_core, bar_index)   // ember rides forward all session
            true

// LTF CHoCH confirmation watch — only while a sweep is active and unconfirmed
if use_choch5 and not na(st_sweep_side) and not st_5m_confirmed
    bool expired = not na(st_sweep_bar) and (bar_index - st_sweep_bar) > choch5_window
    if not expired and ltf_choch
        bool want_bull = st_sweep_side == "sellside"   // low swept → expecting bullish reversal
        bool want_bear = st_sweep_side == "buyside"    // high swept → expecting bearish reversal
        if (want_bull and ltf_dir == 1) or (want_bear and ltf_dir == -1)
            st_5m_confirmed := true
            st_5m_confirm_bar := bar_index
            if choch5_mark
                label.new(bar_index, want_bull ? low : high, choch5_ltf + "m CHoCH ✓", xloc=xloc.bar_index, yloc=want_bull ? yloc.belowbar : yloc.abovebar, style=want_bull ? label.style_label_up : label.style_label_down, color=color.new(want_bull ? c_bull : c_bear, 15), textcolor=color.white, size=size.small)

// ─── STRATEGY ENGINE — sweep+BOS → fib/OTE → internal sweep → LTF entry ──────
// States: 0 idle (no HTF trend) · 1 armed · 2 fib/OTE zone · 3 entry wait · 4 in trade
var int   sm_state    = 0
var int   sm_dir       = 0
var float sm_fibA      = na   // structure point broken by the BOS
var float sm_fibB      = na   // the sweep that preceded/caused it
var float sm_ote_hi    = na
var float sm_ote_lo    = na
var int   sm_setup_bar = na
var float sm_internal_cand     = na
var int   sm_internal_cand_bar = na
var float sm_internal_lvl = na
var int   sm_internal_bar = na
var float sm_run_lo = na
var float sm_run_hi = na
var float sm_sl = na
var float sm_tp = na
var float sm_entry = na
var int   sm_entry_bar = na
var box   sm_fibBoxFull = na
var box   sm_fibBoxOTE  = na
var line  sm_slLine = na
var line  sm_tpLine = na
var label sm_entryLbl = na

float ph_i = ta.pivothigh(high, internal_piv_len, internal_piv_len)
float pl_i = ta.pivotlow(low, internal_piv_len, internal_piv_len)

if use_strategy
    // trend gating
    if trend_dir == 0
        if sm_state != 0 and sm_state != 4
            sm_state := 0
            sm_dir := 0
    else if sm_state == 0
        sm_state := 1
        sm_dir := trend_dir
    else if sm_dir != trend_dir and sm_state >= 1 and sm_state <= 3
        sm_state := 1
        sm_dir := trend_dir
        sm_internal_cand := na
        sm_internal_cand_bar := na

    // STATE 1 → 2 : sweep (counter-trend) + BOS (with-trend) forms the setup
    if sm_state == 1
        if sm_dir == 1 and struct_dir == 1 and not na(last_bos_up_bar) and last_bos_up_bar == bar_index and st_sweep_side == "sellside" and not na(st_sweep_bar) and (bar_index - st_sweep_bar) <= setup_window and not st_sweep_used and math.abs(last_bos_up_lvl - st_sweep_lvl) > tol
            sm_fibA := last_bos_up_lvl
            sm_fibB := st_sweep_lvl
            sm_setup_bar := bar_index
            st_sweep_used := true
            sm_internal_cand := na
            sm_internal_cand_bar := na
            sm_state := 2
            if show_fib
                if not na(sm_fibBoxFull)
                    box.delete(sm_fibBoxFull)
                sm_fibBoxFull := box.new(bar_index, math.max(sm_fibA, sm_fibB), bar_index, math.min(sm_fibA, sm_fibB), xloc=xloc.bar_index, extend=extend.none, border_color=color.new(c_bull, 55), bgcolor=color.new(c_bull, 93))
        else if sm_dir == -1 and struct_dir == -1 and not na(last_bos_dn_bar) and last_bos_dn_bar == bar_index and st_sweep_side == "buyside" and not na(st_sweep_bar) and (bar_index - st_sweep_bar) <= setup_window and not st_sweep_used and math.abs(last_bos_dn_lvl - st_sweep_lvl) > tol
            sm_fibA := last_bos_dn_lvl
            sm_fibB := st_sweep_lvl
            sm_setup_bar := bar_index
            st_sweep_used := true
            sm_internal_cand := na
            sm_internal_cand_bar := na
            sm_state := 2
            if show_fib
                if not na(sm_fibBoxFull)
                    box.delete(sm_fibBoxFull)
                sm_fibBoxFull := box.new(bar_index, math.max(sm_fibA, sm_fibB), bar_index, math.min(sm_fibA, sm_fibB), xloc=xloc.bar_index, extend=extend.none, border_color=color.new(c_bear, 55), bgcolor=color.new(c_bear, 93))

    // OTE zone bounds — fixed for the life of the setup (states 2 & 3)
    if sm_state == 2 or sm_state == 3
        float p1 = sm_fibA - (sm_fibA - sm_fibB) * fib_ote_lo
        float p2 = sm_fibA - (sm_fibA - sm_fibB) * fib_ote_hi
        sm_ote_hi := math.max(p1, p2)
        sm_ote_lo := math.min(p1, p2)
        if show_fib
            box.set_right(sm_fibBoxFull, bar_index)
            color fc = sm_dir == 1 ? c_bull : c_bear
            if na(sm_fibBoxOTE)
                sm_fibBoxOTE := box.new(sm_setup_bar, sm_ote_hi, bar_index, sm_ote_lo, xloc=xloc.bar_index, extend=extend.none, border_color=color.new(fc, 35), bgcolor=color.new(fc, 78))
            else
                box.set_right(sm_fibBoxOTE, bar_index)

    // STATE 2: watch internal liquidity inside the OTE zone, expire if it drags on
    if sm_state == 2
        if bar_index - sm_setup_bar > fib_window
            sm_state := 1
        else if sm_dir == 1
            if not na(pl_i) and pl_i <= sm_ote_hi and pl_i >= sm_ote_lo
                sm_internal_cand := pl_i
                sm_internal_cand_bar := bar_index
            if not na(sm_internal_cand) and low < sm_internal_cand
                sm_internal_lvl := sm_internal_cand
                sm_internal_bar := bar_index
                sm_run_lo := math.min(sm_internal_cand, low)
                sm_state := 3
        else if sm_dir == -1
            if not na(ph_i) and ph_i <= sm_ote_hi and ph_i >= sm_ote_lo
                sm_internal_cand := ph_i
                sm_internal_cand_bar := bar_index
            if not na(sm_internal_cand) and high > sm_internal_cand
                sm_internal_lvl := sm_internal_cand
                sm_internal_bar := bar_index
                sm_run_hi := math.max(sm_internal_cand, high)
                sm_state := 3

    // STATE 3: track the fresh LTF swing, watch for the entry-TF BOS, expire if it drags on
    if sm_state == 3
        if sm_dir == 1
            sm_run_lo := math.min(sm_run_lo, low)
        else if sm_dir == -1
            sm_run_hi := math.max(sm_run_hi, high)
        if bar_index - sm_internal_bar > entry_window
            sm_state := 1
        else if sm_dir == 1 and e_brk_up
            sm_entry := close
            sm_entry_bar := bar_index
            sm_sl := sm_run_lo
            [tn1, tl1] = f_nearest_target(true)
            sm_tp := tl1
            sm_state := 4
            if show_trade
                if not na(sm_slLine)
                    line.delete(sm_slLine)
                if not na(sm_tpLine)
                    line.delete(sm_tpLine)
                if not na(sm_entryLbl)
                    label.delete(sm_entryLbl)
                sm_slLine := line.new(bar_index, sm_sl, bar_index, sm_sl, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.red, 20), width=2, style=line.style_dashed)
                sm_tpLine := line.new(bar_index, sm_tp, bar_index, sm_tp, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.teal, 20), width=2, style=line.style_dashed)
                float rr1 = na(sm_tp) or sm_entry == sm_sl ? na : math.abs(sm_tp - sm_entry) / math.abs(sm_entry - sm_sl)
                string rrTxt1 = na(rr1) ? "" : "\nR:R " + str.tostring(rr1, "#.##")
                sm_entryLbl := label.new(bar_index, sm_entry, "▲ LONG\nE " + str.tostring(sm_entry, format.mintick) + "\nSL " + str.tostring(sm_sl, format.mintick) + "\nTP " + str.tostring(sm_tp, format.mintick) + rrTxt1, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up, color=color.new(c_bull, 10), textcolor=color.white, size=size.small)
        else if sm_dir == -1 and e_brk_dn
            sm_entry := close
            sm_entry_bar := bar_index
            sm_sl := sm_run_hi
            [tn2, tl2] = f_nearest_target(false)
            sm_tp := tl2
            sm_state := 4
            if show_trade
                if not na(sm_slLine)
                    line.delete(sm_slLine)
                if not na(sm_tpLine)
                    line.delete(sm_tpLine)
                if not na(sm_entryLbl)
                    label.delete(sm_entryLbl)
                sm_slLine := line.new(bar_index, sm_sl, bar_index, sm_sl, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.red, 20), width=2, style=line.style_dashed)
                sm_tpLine := line.new(bar_index, sm_tp, bar_index, sm_tp, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.teal, 20), width=2, style=line.style_dashed)
                float rr2 = na(sm_tp) or sm_entry == sm_sl ? na : math.abs(sm_tp - sm_entry) / math.abs(sm_entry - sm_sl)
                string rrTxt2 = na(rr2) ? "" : "\nR:R " + str.tostring(rr2, "#.##")
                sm_entryLbl := label.new(bar_index, sm_entry, "▼ SHORT\nE " + str.tostring(sm_entry, format.mintick) + "\nSL " + str.tostring(sm_sl, format.mintick) + "\nTP " + str.tostring(sm_tp, format.mintick) + rrTxt2, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=color.new(c_bear, 10), textcolor=color.white, size=size.small)

    // STATE 4: manage the open trade — resolve on SL or TP touch
    if sm_state == 4
        if show_trade
            if not na(sm_slLine)
                line.set_x2(sm_slLine, bar_index)
            if not na(sm_tpLine)
                line.set_x2(sm_tpLine, bar_index)
        if sm_dir == 1
            if not na(sm_tp) and high >= sm_tp
                sm_state := 1
            else if low <= sm_sl
                sm_state := 1
        else if sm_dir == -1
            if not na(sm_tp) and low <= sm_tp
                sm_state := 1
            else if high >= sm_sl
                sm_state := 1

// live pools keep glowing
if barstate.islast and array.size(pools) > 0
    for i = 0 to array.size(pools) - 1
        Pool p = array.get(pools, i)
        if not p.swept
            f_draw(p)

// session reset: clear embers + story at new day
if ta.change(time("D")) != 0
    if array.size(pools) > 0
        for i = array.size(pools) - 1 to 0
            Pool p = array.get(pools, i)
            if p.swept
                f_kill(p)
                array.remove(pools, i)
    st_sweep_side := string(na)
    st_disp_seen := false
    st_cisd := false
    st_5m_confirmed := false
    st_5m_confirm_bar := na

// displacement + simplified CISD after a sweep
bool body_disp = math.abs(close - open) > disp_mult * atr
if not na(st_sweep_side) and not st_disp_seen and body_disp
    st_disp_seen := true
    st_disp_up := close > open
    st_disp_open := open
if st_disp_seen and not st_cisd
    st_cisd := st_disp_up ? close > st_disp_open and close > close[1] : close < st_disp_open and close < close[1]

// ─── STORYTELLER RENDER ──────────────────────────────────────────────────────
f_story_pos() =>
    story_pos_s == "Top Left" ? position.top_left : story_pos_s == "Top Right" ? position.top_right : story_pos_s == "Bottom Center" ? position.bottom_center : position.top_center

f_map_pos() =>
    map_pos_s == "Top Right" ? position.top_right : map_pos_s == "Bottom Right" ? position.bottom_right : map_pos_s == "Top Left" ? position.top_left : map_pos_s == "Middle Left" ? position.middle_left : map_pos_s == "Bottom Left" ? position.bottom_left : map_pos_s == "Top Center" ? position.top_center : map_pos_s == "Bottom Center" ? position.bottom_center : position.middle_right

var table story = na
if show_story and barstate.islast
    if na(story)
        story := table.new(f_story_pos(), 1, 1, bgcolor=color.new(C_PANEL, 15), frame_color=color.new(C_BUY, 60), frame_width=1)
    string txt = string(na)
    if na(st_sweep_side)
        txt := "◈ No sweep yet — no story, no trade. Watching " + str.tostring(array.size(pools)) + " pools."
    else
        bool swept_sell = st_sweep_side == "sellside"
        string s1 = st_sweep_sess + " " + (swept_sell ? "low" : "high") + " swept @ " + str.tostring(st_sweep_lvl, format.mintick)
        string s2 = not st_disp_seen ? "waiting on displacement" : "displacement " + (st_disp_up ? "up" : "down")
        string s3 = not st_disp_seen ? string(na) : (st_cisd ? "CISD ✓" : "CISD pending")
        string s5 = string(na)
        if use_choch5 and st_cisd
            s5 := st_5m_confirmed ? (choch5_ltf + "m CHoCH ✓") : ("watching " + choch5_ltf + "m for CHoCH")
        string s4 = string(na)
        if (not use_choch5 and st_cisd) or (use_choch5 and st_5m_confirmed)
            [tn, tl] = f_nearest_target(st_disp_up)
            s4 := na(tn) ? "no clear magnet" : "delivering to " + tn
        txt := "◈ " + s1 + "  →  " + s2 + (na(s3) ? "" : "  →  " + s3) + (na(s5) ? "" : "  →  " + s5) + (na(s4) ? "" : "  →  " + s4)
    table.cell(story, 0, 0, txt, text_color=C_TXT, text_size=size.small)

// ─── STRATEGY STATUS PANEL ────────────────────────────────────────────────────
f_sm_pos() =>
    sm_panel_pos_s == "Top Center" ? position.top_center : sm_panel_pos_s == "Top Left" ? position.top_left : sm_panel_pos_s == "Top Right" ? position.top_right : sm_panel_pos_s == "Bottom Left" ? position.bottom_left : sm_panel_pos_s == "Bottom Right" ? position.bottom_right : position.bottom_center

var table smTable = na
if use_strategy and show_sm_panel and barstate.islast
    if na(smTable)
        smTable := table.new(f_sm_pos(), 1, 1, bgcolor=color.new(C_PANEL, 15), frame_color=color.new(c_bull, 60), frame_width=1)
    string trendTxt = trend_dir == 1 ? "1H BULL" : trend_dir == -1 ? "1H BEAR" : "1H no trend"
    string stateTxt = sm_state == 0 ? "idle — no valid HTF trend" : sm_state == 1 ? "armed — watching 5m sweep + BOS" : sm_state == 2 ? "fib/OTE zone — watching internal sweep" : sm_state == 3 ? "internal sweep ✓ — watching " + entry_ltf + "m BOS" : "in trade · SL " + str.tostring(sm_sl, format.mintick) + " · TP " + str.tostring(sm_tp, format.mintick)
    color panelC = trend_dir == 1 ? c_bull : trend_dir == -1 ? c_bear : C_TXT
    table.cell(smTable, 0, 0, "🧠 " + trendTxt + "  ·  " + stateTxt, text_color=panelC, text_size=size.small)

// ─── ◎ NEXT DRAW OF LIQUIDITY ────────────────────────────────────────────────
var line  dol_ln = line(na)
var label dol_lb = label(na)
if show_dol and barstate.islast
    bool dol_up = struct_dir == 1 ? true : struct_dir == -1 ? false : close < d_eq
    [dol_nm, dol_lv] = f_nearest_target(dol_up)
    if not na(dol_ln)
        line.delete(dol_ln)
    if not na(dol_lb)
        label.delete(dol_lb)
    if not na(dol_lv)
        color dc = dol_up ? c_bull : c_bear
        dol_ln := line.new(bar_index - 20, dol_lv, bar_index, dol_lv, xloc=xloc.bar_index, extend=extend.right, color=color.new(dc, 25), width=2, style=line.style_dotted)
        dol_lb := label.new(bar_index + 6, dol_lv, "◎ NEXT DRAW · " + dol_nm, xloc=xloc.bar_index, yloc=yloc.price, style=dol_up ? label.style_label_lower_left : label.style_label_upper_left, color=color.new(dc, 80), textcolor=C_TXT, size=size.small)
        true

// ─── DELIVERY MAP (right-edge ladder) ────────────────────────────────────────
var table dmap = na
if show_map and barstate.islast
    if na(dmap)
        dmap := table.new(f_map_pos(), 3, map_rows + 1, bgcolor=color.new(C_PANEL, 25), frame_color=color.new(C_SELL, 60), frame_width=1)
    table.clear(dmap, 0, 0, 2, map_rows)
    // gather candidates: name, level, strength(0-1)
    array<string> c_nm = array.new<string>()
    array<float>  c_lv = array.new<float>()
    array<float>  c_st = array.new<float>()
    if array.size(pools) > 0
        for i = 0 to array.size(pools) - 1
            Pool p = array.get(pools, i)
            if not p.swept
                array.push(c_nm, p.buyside ? "BSL" : "SSL")
                array.push(c_lv, p.lvl)
                array.push(c_st, f_strength(p))
    array<float>  m_lv = array.from(pdh, pdl, pwh, pwl, d_eq, w_eq)
    array<string> m_nm = array.from("PDH", "PDL", "PWH", "PWL", "D-EQ", "W-EQ")
    array<float>  m_st = array.from(0.9, 0.9, 1.0, 1.0, 0.6, 0.7)
    for mi = 0 to 5
        array.push(c_nm, array.get(m_nm, mi))
        array.push(c_lv, array.get(m_lv, mi))
        array.push(c_st, array.get(m_st, mi))
    // score = strength − distance penalty; rank descending
    int n = array.size(c_lv)
    array<float> score = array.new<float>()
    for i = 0 to n - 1
        float d_atr = math.abs(array.get(c_lv, i) - close) / math.max(atr, syminfo.mintick)
        array.push(score, array.get(c_st, i) - w_dist * d_atr * 0.08)
    // header
    table.cell(dmap, 0, 0, "MAGNET", text_color=C_TXT, text_size=size.tiny)
    table.cell(dmap, 1, 0, "LEVEL", text_color=C_TXT, text_size=size.tiny)
    table.cell(dmap, 2, 0, "PULL", text_color=C_TXT, text_size=size.tiny)
    int shown = 0
    array<bool> used = array.new<bool>(n, false)
    while shown < map_rows and shown < n
        int bi = -1
        float bs = -1e10
        for i = 0 to n - 1
            if not array.get(used, i) and array.get(score, i) > bs
                bs := array.get(score, i)
                bi := i
        array.set(used, bi, true)
        bool above = array.get(c_lv, bi) > close
        color rc = above ? C_BUY : C_SELL
        string heat = bs > 0.55 ? "███" : bs > 0.3 ? "██░" : bs > 0.05 ? "█░░" : "░░░"
        table.cell(dmap, 0, shown + 1, (shown == 0 ? "▶ " : "") + array.get(c_nm, bi), text_color=rc, text_size=size.tiny)
        table.cell(dmap, 1, shown + 1, str.tostring(array.get(c_lv, bi), format.mintick), text_color=C_TXT, text_size=size.tiny)
        table.cell(dmap, 2, shown + 1, heat, text_color=rc, text_size=size.tiny)
        shown += 1

// ─── WATERMARK ───────────────────────────────────────────────────────────────
var table wm = na
if show_wm and barstate.islast and na(wm)
    wm := table.new(wm_pos_s == "Bottom Left" ? position.bottom_left : wm_pos_s == "Top Right" ? position.top_right : wm_pos_s == "Top Left" ? position.top_left : position.bottom_right, 1, 1)
    table.cell(wm, 0, 0, "MBF & RZ Trading — Liquidity Radar", text_color=color.new(C_TXT, 55), text_size=size.tiny)

// ─── ALERTS ───────────────────────────────────────────────────────────────────
alertcondition(st_5m_confirm_bar == bar_index, title="LTF CHoCH after sweep", message="MBF Radar: LTF change of character confirmed after a liquidity sweep.")
alertcondition(sm_entry_bar == bar_index, title="Strategy entry", message="MBF Radar: Strategy entry triggered — sweep, BOS, fib/OTE, internal sweep, and LTF confirmation all aligned. Check chart for direction, SL, and TP.")
