//@version=6
strategy("Turtle Trading Strategy with ATR Stop + Pyramiding",
     overlay=true,
     initial_capital=100000,
     pyramiding=4,
     process_orders_on_close=true)

//==================================================================================================
// Inputs
//==================================================================================================

entryLength       = input.int(20, "Entry Breakout Length", minval=1)
exitLength        = input.int(10, "Exit Breakout Length", minval=1)
trendMaLength     = input.int(200, "Trend MA Length", minval=1)
useTrendFilter    = input.bool(true, "Use Trend Filter")

atrLength         = input.int(20, "ATR Length", minval=1)
atrStopMultiple   = input.float(2.0, "ATR Stop Multiple", minval=0.1, step=0.1)

riskPctPerEntry   = input.float(25, "Position Size % Per Entry", minval=1, maxval=100)
maxPyramidEntries = input.int(4, "Maximum Pyramid Entries", minval=1, maxval=10)

showTrendMA       = input.bool(true, "Show Trend MA")
showEntryLine     = input.bool(true, "Show Entry Line")
showExitLine      = input.bool(true, "Show Exit Line")
showAtrStop       = input.bool(true, "Show ATR Stop")

//==================================================================================================
// Core calculations
//==================================================================================================

c = close
h = high
l = low

trendMA   = ta.sma(c, trendMaLength)
entryHigh = ta.highest(h[1], entryLength)
exitLow   = ta.lowest(l[1], exitLength)
atrValue  = ta.atr(atrLength)

trendFilter = c > trendMA

// Turtle breakout buy condition
rawBuySignal = c > entryHigh and (not useTrendFilter or trendFilter)

//==================================================================================================
// Pyramiding logic
// Add a new position every 0.5 ATR move higher
//==================================================================================================

var float lastEntryPrice = na
var int pyramidCount = 0
var float atrStop = na

canAddPosition = strategy.position_size == 0 or (
     strategy.position_size > 0 and
     pyramidCount < maxPyramidEntries and
     c >= lastEntryPrice + (0.5 * atrValue)
)

buySignal = rawBuySignal and canAddPosition

//==================================================================================================
// Position sizing
//==================================================================================================

positionValue = strategy.equity * (riskPctPerEntry / 100.0)
qty = positionValue / c

//==================================================================================================
// Entries
//==================================================================================================

if buySignal
    pyramidCount += 1
    lastEntryPrice := c
    
    strategy.entry(
         "Long_" + str.tostring(pyramidCount),
         strategy.long,
         qty=qty
    )

    // Reset stop on first entry
    if strategy.position_size == 0
        atrStop := c - atrValue * atrStopMultiple

// Reset variables when flat
if strategy.position_size == 0
    pyramidCount := 0
    lastEntryPrice := na
    atrStop := na

//==================================================================================================
// ATR stop tracking
//==================================================================================================

if strategy.position_size > 0
    newStop = c - atrValue * atrStopMultiple
    atrStop := na(atrStop) ? newStop : math.max(atrStop, newStop)

//==================================================================================================
// Sell logic
//==================================================================================================

exitSignalChannel = strategy.position_size > 0 and c < exitLow
exitSignalATR     = strategy.position_size > 0 and c < atrStop

rawSellSignal = exitSignalChannel or exitSignalATR
sellSignal = rawSellSignal and not rawSellSignal[1]

//==================================================================================================
// Exit all positions
//==================================================================================================

if strategy.position_size > 0 and not na(atrStop)
    strategy.exit("ATR Stop", stop=atrStop)

if sellSignal
    strategy.close_all("Exit All")

//==================================================================================================
// Plotting
//==================================================================================================

plot(showTrendMA ? trendMA : na, "Trend MA", color=color.blue, linewidth=2)
plot(showEntryLine ? entryHigh : na, "Entry Breakout", color=color.green, linewidth=2)
plot(showExitLine ? exitLow : na, "Exit Breakdown", color=color.red, linewidth=2)
plot(showAtrStop and strategy.position_size > 0 ? atrStop : na, "ATR Stop", color=color.orange, linewidth=2)

plotshape(
     buySignal,
     title="BUY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.green,
     textcolor=color.white,
     size=size.normal,
     text="BUY"
)

plotshape(
     sellSignal,
     title="SELL",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     textcolor=color.white,
     size=size.normal,
     text="SELL"
)

barcolor(
     buySignal ? color.green :
     sellSignal ? color.red :
     na
)

//==================================================================================================
// Alerts
//==================================================================================================

alertcondition(buySignal, title="Buy Alert", message="Turtle Pyramid BUY signal")
alertcondition(sellSignal, title="Sell Alert", message="Turtle SELL signal")