//@version=5
strategy("BTC 4H Momentum — Long Only [Ensar]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=40, commission_type=strategy.commission.percent, commission_value=0.1, slippage=2)

roc_len      = input.int  (20,  "ROC Length",           minval=5)
roc_thr      = input.float(1.0, "ROC Threshold (%)",    minval=0.1)
ema_len      = input.int  (200, "EMA Length (Trend)",   minval=50)
swing_lb     = input.int  (7,   "Swing Lookback",       minval=3)
rr_target    = input.float(3.0, "R:R Target",           minval=1.0)
adx_len      = input.int  (14,  "ADX Length",           minval=5)
adx_thr      = input.int  (20,  "ADX Threshold",        minval=10)
ema_dir_bars = input.int  (10,  "EMA Direction (bars)", minval=3)

ema200    = ta.ema(close, ema_len)
roc       = (close - close[roc_len]) / close[roc_len] * 100
swing_low = ta.lowest(low, swing_lb)
[diplus, diminus, adx] = ta.dmi(adx_len, adx_len)

plot(ema200, color=color.orange, linewidth=2, title="200 EMA")

ema_rising = ema200 > ema200[ema_dir_bars]
long_cond  = close > ema200 and ema_rising and roc > roc_thr and adx > adx_thr
no_pos     = strategy.position_size == 0

if long_cond and no_pos
    sl      = swing_low
    tp      = close + (close - sl) * rr_target
    lbl_txt = "▲ LONG\nentry  " + str.tostring(close, "#,###.00") + "\nstop   " + str.tostring(sl, "#,###.00") + "\ntarget " + str.tostring(tp, "#,###.00")
    strategy.entry("Long", strategy.long)
    strategy.exit("Long TP/SL", "Long", stop=sl, limit=tp, comment_loss="SL", comment_profit="TP")
    label.new(bar_index, low*0.995, lbl_txt, color=color.new(#0d1117,0), textcolor=color.new(#3fb950,0), style=label.style_label_up, size=size.normal)

plotshape(long_cond and no_pos, style=shape.triangleup, location=location.belowbar, color=color.new(#3fb950,0), size=size.small, title="Long Signal")

alertcondition(long_cond and no_pos, title="Long Signal", message="BTC 4H Momentum — Long Signal on {{ticker}}")