plot(show1 ? ma1 : na, "MA MTF 1", color=col1, linewidth=width1, display=display.pane + display.status_line + display.price_scale)
plot(show2 ? ma2 : na, "MA MTF 2", color=col2, linewidth=width2, display=display.pane + display.status_line + display.price_scale)
plot(show3 ? ma3 : na, "MA MTF 3", color=col3, linewidth=width3, display=display.pane + display.status_line + display.price_scale)
