//@version=5
// =============================================================================
// MOMENTUM BREAKOUT STRATEGY
// Pine Script v5 | TradingView Strategy
// =============================================================================
// Logic:
//   Long  — Price crosses ABOVE 200 SMA  AND  MACD > 0  AND  StochRSI %K > 80
//   Short — Price crosses BELOW 200 SMA  AND  MACD < 0  AND  StochRSI %K < 20
//   TP    — Dynamic: most recent swing HIGH (long) / swing LOW (short)
//   SL    — Dynamic: most recent swing LOW  (long) / swing HIGH (short)
// =============================================================================

//#region ── Strategy Declaration ──────────────────────────────────────────────
strategy(
     title             = "Momentum Breakout | 200SMA + MACD + StochRSI",
     shorttitle        = "MomBreakout",
     overlay           = true,
     initial_capital   = 10000,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 10,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.05,
     slippage          = 2,
     calc_on_every_tick = false
     )
//#endregion

//#region ── User Inputs ────────────────────────────────────────────────────────

// ── 200 SMA ──
var GRP_SMA = "200 SMA"
smaLen = input.int(200, "SMA Length", minval = 1, group = GRP_SMA)

// ── MACD ──
var GRP_MACD = "MACD"
macdFast   = input.int(12, "Fast Length",   minval = 1, group = GRP_MACD)
macdSlow   = input.int(26, "Slow Length",   minval = 1, group = GRP_MACD)
macdSignal = input.int(9,  "Signal Length", minval = 1, group = GRP_MACD)

// ── Stochastic RSI ──
var GRP_SRSI = "Stochastic RSI"
rsiLen       = input.int(14, "RSI Length",   minval = 1, group = GRP_SRSI)
stochLen     = input.int(14, "Stoch Length", minval = 1, group = GRP_SRSI)
smoothK      = input.int(3,  "Smooth %K",    minval = 1, group = GRP_SRSI)
smoothD      = input.int(3,  "Smooth %D",    minval = 1, group = GRP_SRSI)
stochBullLvl = input.int(80, "Bull Threshold (Long  Entry)", minval = 50, maxval = 100, group = GRP_SRSI)
stochBearLvl = input.int(20, "Bear Threshold (Short Entry)", minval = 0,  maxval = 50,  group = GRP_SRSI)

// ── Swing Pivot Lookback (for dynamic TP / SL) ──
var GRP_SWING = "Dynamic TP / SL (Swing Pivots)"
swingLookback = input.int(10, "Pivot Lookback Bars (left & right)", minval = 3, maxval = 50, group = GRP_SWING)
tpBuffer      = input.float(0.001, "TP Buffer (fraction beyond pivot)", minval = 0.0, step = 0.001, group = GRP_SWING,
     tooltip = "Adds a small buffer past the swing high/low. 0.001 = 0.1%")
slBuffer      = input.float(0.001, "SL Buffer (fraction beyond pivot)", minval = 0.0, step = 0.001, group = GRP_SWING)

// ── Visuals ──
var GRP_VIS = "Visuals"
showSma    = input.bool(true, "Show 200 SMA",           group = GRP_VIS)
showSwings = input.bool(true, "Show Swing TP/SL Lines", group = GRP_VIS)
showLabels = input.bool(true, "Show Entry Labels",       group = GRP_VIS)

//#endregion

//#region ── Indicator Calculations ────────────────────────────────────────────

// ── 200 SMA ──
sma200 = ta.sma(close, smaLen)

// ── MACD ──
[macdLine, signalLine, _histLine] = ta.macd(close, macdFast, macdSlow, macdSignal)

// ── Stochastic RSI ──
rsiVal     = ta.rsi(close, rsiLen)
stochK_raw = ta.stoch(rsiVal, rsiVal, rsiVal, stochLen)
stochK     = ta.sma(stochK_raw, smoothK)
stochD     = ta.sma(stochK, smoothD)

//#endregion

//#region ── Dynamic Swing High / Low (TP & SL) ────────────────────────────────

var float lastSwingHigh = na
var float lastSwingLow  = na

ph = ta.pivothigh(high, swingLookback, swingLookback)
pl = ta.pivotlow (low,  swingLookback, swingLookback)

if not na(ph)
    lastSwingHigh := ph
if not na(pl)
    lastSwingLow  := pl

//#endregion

//#region ── Entry Conditions ──────────────────────────────────────────────────

crossAboveSma = ta.crossover (close, sma200)
crossBelowSma = ta.crossunder(close, sma200)

longCondition  = crossAboveSma and macdLine > 0 and stochK > stochBullLvl
shortCondition = crossBelowSma and macdLine < 0 and stochK < stochBearLvl

//#endregion

//#region ── Strategy Execution ────────────────────────────────────────────────

if longCondition and not na(lastSwingHigh) and not na(lastSwingLow)
    longTP = lastSwingHigh * (1 + tpBuffer)
    longSL = lastSwingLow  * (1 - slBuffer)
    if longTP > close and longSL < close
        strategy.entry("Long", strategy.long, comment = "Long")
        strategy.exit("Long Exit", from_entry = "Long",
             limit          = longTP,
             stop           = longSL,
             comment_profit = "TP Hit",
             comment_loss   = "SL Hit")
        if showLabels
            label.new(bar_index, low,
                 text      = "▲ LONG\nTP: " + str.tostring(math.round(longTP, 2)) + "\nSL: " + str.tostring(math.round(longSL, 2)),
                 style     = label.style_label_up,
                 color     = color.new(color.teal, 10),
                 textcolor = color.white,
                 size      = size.small)

if shortCondition and not na(lastSwingHigh) and not na(lastSwingLow)
    shortTP = lastSwingLow  * (1 - tpBuffer)
    shortSL = lastSwingHigh * (1 + slBuffer)
    if shortTP < close and shortSL > close
        strategy.entry("Short", strategy.short, comment = "Short")
        strategy.exit("Short Exit", from_entry = "Short",
             limit          = shortTP,
             stop           = shortSL,
             comment_profit = "TP Hit",
             comment_loss   = "SL Hit")
        if showLabels
            label.new(bar_index, high,
                 text      = "▼ SHORT\nTP: " + str.tostring(math.round(shortTP, 2)) + "\nSL: " + str.tostring(math.round(shortSL, 2)),
                 style     = label.style_label_down,
                 color     = color.new(color.red, 10),
                 textcolor = color.white,
                 size      = size.small)

//#endregion

//#region ── Visuals ───────────────────────────────────────────────────────────

plot(showSma ? sma200 : na,
     title     = "200 SMA",
     color     = close > sma200 ? color.new(color.teal, 20) : color.new(color.red, 20),
     linewidth = 2)

plot(showSwings ? lastSwingHigh : na,
     title     = "Last Swing High (TP ref)",
     color     = color.new(color.green, 50),
     style     = plot.style_linebr,
     linewidth = 1)

plot(showSwings ? lastSwingLow : na,
     title     = "Last Swing Low (SL/TP ref)",
     color     = color.new(color.red, 50),
     style     = plot.style_linebr,
     linewidth = 1)

bgcolor(close > sma200 ? color.new(color.teal, 95) : color.new(color.red, 95),
     title = "Trend Background")

plotshape(longCondition,
     title    = "Long Signal",
     location = location.belowbar,
     style    = shape.triangleup,
     color    = color.new(color.teal, 0),
     size     = size.normal)

plotshape(shortCondition,
     title    = "Short Signal",
     location = location.abovebar,
     style    = shape.triangledown,
     color    = color.new(color.red, 0),
     size     = size.normal)

//#endregion

//#region ── Information Table ─────────────────────────────────────────────────

var table infoTable = table.new(
     position.top_right, 2, 7,
     bgcolor      = color.new(color.black, 80),
     border_color = color.new(color.gray, 60),
     border_width = 1,
     frame_color  = color.new(color.gray, 40),
     frame_width  = 1)

if barstate.islast
    table.cell(infoTable, 0, 0, "INDICATOR",  text_color = color.gray,  text_size = size.small, bgcolor = color.new(color.black, 60))
    table.cell(infoTable, 1, 0, "VALUE",       text_color = color.gray,  text_size = size.small, bgcolor = color.new(color.black, 60))

    smaColor = close > sma200 ? color.teal : color.red
    table.cell(infoTable, 0, 1, "200 SMA",     text_color = color.white, text_size = size.small)
    table.cell(infoTable, 1, 1, str.tostring(math.round(sma200, 2)), text_color = smaColor, text_size = size.small)

    macdColor = macdLine > 0 ? color.teal : color.red
    table.cell(infoTable, 0, 2, "MACD Line",   text_color = color.white, text_size = size.small)
    table.cell(infoTable, 1, 2, str.tostring(math.round(macdLine, 4)), text_color = macdColor, text_size = size.small)

    kColor = stochK > stochBullLvl ? color.teal : stochK < stochBearLvl ? color.red : color.yellow
    table.cell(infoTable, 0, 3, "StochRSI %K", text_color = color.white, text_size = size.small)
    table.cell(infoTable, 1, 3, str.tostring(math.round(stochK, 2)), text_color = kColor, text_size = size.small)

    table.cell(infoTable, 0, 4, "Swing High",  text_color = color.white, text_size = size.small)
    table.cell(infoTable, 1, 4, na(lastSwingHigh) ? "n/a" : str.tostring(math.round(lastSwingHigh, 2)), text_color = color.green, text_size = size.small)

    table.cell(infoTable, 0, 5, "Swing Low",   text_color = color.white, text_size = size.small)
    table.cell(infoTable, 1, 5, na(lastSwingLow) ? "n/a" : str.tostring(math.round(lastSwingLow, 2)), text_color = color.red, text_size = size.small)

    posText  = strategy.position_size > 0 ? "LONG ▲" : strategy.position_size < 0 ? "SHORT ▼" : "FLAT —"
    posColor = strategy.position_size > 0 ? color.teal : strategy.position_size < 0 ? color.red : color.gray
    table.cell(infoTable, 0, 6, "Position",    text_color = color.white, text_size = size.small)
    table.cell(infoTable, 1, 6, posText,        text_color = posColor,    text_size = size.small)

//#endregion
// =============================================================================
// END OF SCRIPT
// =============================================================================