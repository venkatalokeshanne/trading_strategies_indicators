//@version=6
indicator("Trade Serene PRO | Options Confluence", 
     shorttitle="Trade Serene PRO", 
     overlay=true, 
     max_labels_count=500)

//====================================================
// TRADE SERENE PRO
// Options Day Trading Confluence Indicator
//
// Designed for:
// SPY / QQQ / high-liquidity stocks
// 3-minute and 5-minute charts
//
// Core Logic:
// ORB + VWAP + EMA Trend + Relative Volume
// + RSI Momentum + Benchmark Confirmation
// + ATR Risk Management
//====================================================


//====================================================
// 1. USER INPUTS
//====================================================

//---------- Opening Range ----------
groupORB = "1. Opening Range Breakout"

orbSession = input.session(
     "0930-0945",
     "Opening Range",
     group=groupORB)

requireORBBreak = input.bool(
     true,
     "Require ORB Breakout",
     group=groupORB)


//---------- Trend ----------
groupTrend = "2. Trend Confirmation"

fastEMA = input.int(
     9,
     "Fast EMA",
     minval=1,
     group=groupTrend)

slowEMA = input.int(
     21,
     "Slow EMA",
     minval=1,
     group=groupTrend)

useVWAP = input.bool(
     true,
     "Require VWAP Confirmation",
     group=groupTrend)


//---------- Volume ----------
groupVolume = "3. Volume Confirmation"

volumeLength = input.int(
     20,
     "Average Volume Length",
     minval=1,
     group=groupVolume)

minimumRVOL = input.float(
     1.20,
     "Minimum Relative Volume",
     minval=0.1,
     step=0.1,
     group=groupVolume)


//---------- Momentum ----------
groupMomentum = "4. Momentum"

rsiLength = input.int(
     14,
     "RSI Length",
     minval=1,
     group=groupMomentum)

bullRSI = input.int(
     55,
     "Bullish RSI Minimum",
     group=groupMomentum)

bearRSI = input.int(
     45,
     "Bearish RSI Maximum",
     group=groupMomentum)


//---------- Market Confirmation ----------
groupMarket = "5. Market Confirmation"

useBenchmark = input.bool(
     true,
     "Use Market Confirmation",
     group=groupMarket)

benchmarkSymbol = input.symbol(
     "AMEX:SPY",
     "Benchmark",
     group=groupMarket)

benchmarkEMA = input.int(
     21,
     "Benchmark EMA",
     group=groupMarket)


//---------- Risk ----------
groupRisk = "6. Risk Management"

atrLength = input.int(
     14,
     "ATR Length",
     group=groupRisk)

atrStopMultiplier = input.float(
     1.0,
     "ATR Stop Multiplier",
     step=0.1,
     group=groupRisk)

maxVWAPDistanceATR = input.float(
     1.5,
     "Maximum Distance From VWAP (ATR)",
     step=0.1,
     group=groupRisk)


//---------- Signal Quality ----------
groupQuality = "7. Signal Quality"

aPlusScore = input.int(
     7,
     "A+ Minimum Score",
     minval=1,
     maxval=8,
     group=groupQuality)

aScore = input.int(
     6,
     "A Minimum Score",
     minval=1,
     maxval=8,
     group=groupQuality)

showASignals = input.bool(
     true,
     "Show A Signals",
     group=groupQuality)


//---------- Display ----------
groupDisplay = "8. Display"

showORB = input.bool(
     true,
     "Show Opening Range",
     group=groupDisplay)

showEMAs = input.bool(
     true,
     "Show EMAs",
     group=groupDisplay)

showVWAPLine = input.bool(
     true,
     "Show VWAP",
     group=groupDisplay)

showTargets = input.bool(
     true,
     "Show Risk Targets",
     group=groupDisplay)

showDashboard = input.bool(
     true,
     "Show Dashboard",
     group=groupDisplay)


//====================================================
// 2. CORE INDICATORS
//====================================================

emaFast = ta.ema(close, fastEMA)
emaSlow = ta.ema(close, slowEMA)

vwapValue = ta.vwap(hlc3)

rsiValue = ta.rsi(close, rsiLength)

atrValue = ta.atr(atrLength)

avgVolume = ta.sma(volume, volumeLength)

relativeVolume =
     avgVolume > 0 ?
     volume / avgVolume :
     0


//====================================================
// 3. OPENING RANGE
//====================================================

inORB =
     not na(
         time(
             timeframe.period,
             orbSession
         )
     )

newORB =
     inORB and
     not inORB[1]

var float orbHigh = na
var float orbLow  = na

if newORB
    orbHigh := high
    orbLow  := low

else if inORB
    orbHigh :=
         math.max(
             nz(orbHigh, high),
             high
         )

    orbLow :=
         math.min(
             nz(orbLow, low),
             low
         )


//====================================================
// 4. ORB BREAK CONDITIONS
//====================================================

orbComplete = not inORB and not na(orbHigh)

bullORBBreak =
     orbComplete and
     close > orbHigh

bearORBBreak =
     orbComplete and
     close < orbLow


//====================================================
// 5. TREND CONDITIONS
//====================================================

bullEMA =
     emaFast > emaSlow and
     close > emaFast

bearEMA =
     emaFast < emaSlow and
     close < emaFast

bullVWAP =
     close > vwapValue

bearVWAP =
     close < vwapValue

bullCandle =
     close > open

bearCandle =
     close < open


//====================================================
// 6. MOMENTUM
//====================================================

bullMomentum =
     rsiValue >= bullRSI

bearMomentum =
     rsiValue <= bearRSI


//====================================================
// 7. VOLUME
//====================================================

volumeConfirmed =
     relativeVolume >= minimumRVOL


//====================================================
// 8. BENCHMARK / MARKET TREND
//====================================================

benchmarkClose =
     request.security(
         benchmarkSymbol,
         timeframe.period,
         close
     )

benchmarkEMAValue =
     request.security(
         benchmarkSymbol,
         timeframe.period,
         ta.ema(close, benchmarkEMA)
     )

benchmarkBull =
     benchmarkClose >
     benchmarkEMAValue

benchmarkBear =
     benchmarkClose <
     benchmarkEMAValue


//====================================================
// 9. EXTENSION / CHASING FILTER
//====================================================

vwapDistance =
     math.abs(close - vwapValue)

tooExtended =
     vwapDistance >
     atrValue *
     maxVWAPDistanceATR

locationValid =
     not tooExtended


//====================================================
// 10. SCORE ENGINE
//====================================================

// Bull Score

int bullScore = 0

bullScore += bullORBBreak ? 1 : 0
bullScore += bullVWAP ? 1 : 0
bullScore += bullEMA ? 1 : 0
bullScore += volumeConfirmed ? 1 : 0
bullScore += bullMomentum ? 1 : 0
bullScore += bullCandle ? 1 : 0
bullScore += benchmarkBull ? 1 : 0
bullScore += locationValid ? 1 : 0


// Bear Score

int bearScore = 0

bearScore += bearORBBreak ? 1 : 0
bearScore += bearVWAP ? 1 : 0
bearScore += bearEMA ? 1 : 0
bearScore += volumeConfirmed ? 1 : 0
bearScore += bearMomentum ? 1 : 0
bearScore += bearCandle ? 1 : 0
bearScore += benchmarkBear ? 1 : 0
bearScore += locationValid ? 1 : 0


//====================================================
// 11. REQUIRED CONDITIONS
//====================================================

bullRequired =
     (not requireORBBreak or bullORBBreak) and
     (not useVWAP or bullVWAP) and
     (not useBenchmark or benchmarkBull) and
     locationValid

bearRequired =
     (not requireORBBreak or bearORBBreak) and
     (not useVWAP or bearVWAP) and
     (not useBenchmark or benchmarkBear) and
     locationValid


//====================================================
// 12. SIGNAL CLASSIFICATION
//====================================================

bullAPlus =
     bullRequired and
     bullScore >= aPlusScore

bearAPlus =
     bearRequired and
     bearScore >= aPlusScore

bullA =
     bullRequired and
     bullScore >= aScore and
     bullScore < aPlusScore

bearA =
     bearRequired and
     bearScore >= aScore and
     bearScore < aPlusScore


//====================================================
// 13. PREVENT REPEATED SIGNALS
//====================================================

newBullAPlus =
     bullAPlus and
     not bullAPlus[1]

newBearAPlus =
     bearAPlus and
     not bearAPlus[1]

newBullA =
     bullA and
     not bullA[1]

newBearA =
     bearA and
     not bearA[1]


//====================================================
// 14. TRADE STATE
//====================================================

var int tradeDirection = 0

//  1 = CALL
// -1 = PUT
//  0 = No Trade

var float tradeEntry = na
var float tradeStop  = na
var float tradeRisk  = na

var float target1 = na
var float target2 = na
var float target3 = na


//====================================================
// 15. CALL ENTRY
//====================================================

callSignal =
     newBullAPlus or
     (showASignals and newBullA)

if callSignal

    tradeDirection := 1

    tradeEntry := close

    atrStop =
         close -
         atrValue *
         atrStopMultiplier

    technicalStop =
         math.min(
             emaSlow,
             vwapValue
         )

    tradeStop :=
         math.min(
             atrStop,
             technicalStop
         )

    tradeRisk :=
         tradeEntry -
         tradeStop

    target1 :=
         tradeEntry +
         tradeRisk

    target2 :=
         tradeEntry +
         tradeRisk * 2

    target3 :=
         tradeEntry +
         tradeRisk * 3


//====================================================
// 16. PUT ENTRY
//====================================================

putSignal =
     newBearAPlus or
     (showASignals and newBearA)

if putSignal

    tradeDirection := -1

    tradeEntry := close

    atrStop =
         close +
         atrValue *
         atrStopMultiplier

    technicalStop =
         math.max(
             emaSlow,
             vwapValue
         )

    tradeStop :=
         math.max(
             atrStop,
             technicalStop
         )

    tradeRisk :=
         tradeStop -
         tradeEntry

    target1 :=
         tradeEntry -
         tradeRisk

    target2 :=
         tradeEntry -
         tradeRisk * 2

    target3 :=
         tradeEntry -
         tradeRisk * 3


//====================================================
// 17. EXIT CONDITIONS
//====================================================

callStop =
     tradeDirection == 1 and
     low <= tradeStop

putStop =
     tradeDirection == -1 and
     high >= tradeStop


callMomentumExit =
     tradeDirection == 1 and
     close < emaFast and
     close < vwapValue

putMomentumExit =
     tradeDirection == -1 and
     close > emaFast and
     close > vwapValue


callTarget3 =
     tradeDirection == 1 and
     high >= target3

putTarget3 =
     tradeDirection == -1 and
     low <= target3


exitCall =
     callStop or
     callMomentumExit or
     callTarget3

exitPut =
     putStop or
     putMomentumExit or
     putTarget3


if exitCall or exitPut

    tradeDirection := 0


//====================================================
// 18. CHART PLOTS
//====================================================

// EMAs

plot(
     showEMAs ? emaFast : na,
     "9 EMA",
     color=color.aqua,
     linewidth=2
)

plot(
     showEMAs ? emaSlow : na,
     "21 EMA",
     color=color.orange,
     linewidth=2
)


// VWAP

plot(
     showVWAPLine ? vwapValue : na,
     "VWAP",
     color=color.purple,
     linewidth=2
)


// Opening Range

plot(
     showORB ? orbHigh : na,
     "ORB High",
     color=color.green,
     linewidth=2,
     style=plot.style_linebr
)

plot(
     showORB ? orbLow : na,
     "ORB Low",
     color=color.red,
     linewidth=2,
     style=plot.style_linebr
)


//====================================================
// 19. SIGNAL MARKERS
//====================================================

plotshape(
     newBullAPlus,
     title="A+ CALL",
     text="A+\nCALL",
     location=location.belowbar,
     style=shape.labelup,
     color=color.green,
     textcolor=color.white,
     size=size.small
)

plotshape(
     newBearAPlus,
     title="A+ PUT",
     text="A+\nPUT",
     location=location.abovebar,
     style=shape.labeldown,
     color=color.red,
     textcolor=color.white,
     size=size.small
)

plotshape(
     showASignals and newBullA,
     title="A CALL",
     text="A\nCALL",
     location=location.belowbar,
     style=shape.labelup,
     color=color.lime,
     textcolor=color.black,
     size=size.tiny
)

plotshape(
     showASignals and newBearA,
     title="A PUT",
     text="A\nPUT",
     location=location.abovebar,
     style=shape.labeldown,
     color=color.maroon,
     textcolor=color.white,
     size=size.tiny
)


//====================================================
// 20. EXIT MARKERS
//====================================================

plotshape(
     exitCall,
     title="Exit CALL",
     text="EXIT",
     location=location.abovebar,
     style=shape.labeldown,
     color=color.yellow,
     textcolor=color.black,
     size=size.tiny
)

plotshape(
     exitPut,
     title="Exit PUT",
     text="EXIT",
     location=location.belowbar,
     style=shape.labelup,
     color=color.yellow,
     textcolor=color.black,
     size=size.tiny
)


//====================================================
// 21. ACTIVE RISK LEVELS
//====================================================

activeTrade =
     tradeDirection != 0

plot(
     showTargets and activeTrade ?
     tradeEntry :
     na,
     "Entry",
     color=color.white,
     linewidth=2,
     style=plot.style_linebr
)

plot(
     showTargets and activeTrade ?
     tradeStop :
     na,
     "Stop",
     color=color.red,
     linewidth=2,
     style=plot.style_linebr
)

plot(
     showTargets and activeTrade ?
     target1 :
     na,
     "1R",
     color=color.yellow,
     linewidth=1,
     style=plot.style_linebr
)

plot(
     showTargets and activeTrade ?
     target2 :
     na,
     "2R",
     color=color.green,
     linewidth=2,
     style=plot.style_linebr
)

plot(
     showTargets and activeTrade ?
     target3 :
     na,
     "3R",
     color=color.teal,
     linewidth=2,
     style=plot.style_linebr
)


//====================================================
// 22. BACKGROUND NO-TRADE WARNING
//====================================================

noTradeZone =
     tooExtended or
     relativeVolume <
     minimumRVOL

bgcolor(
     noTradeZone ?
     color.new(color.gray, 92) :
     na,
     title="No Trade Zone"
)


//====================================================
// 23. DASHBOARD
//====================================================

var table dashboard =
     table.new(
         position.top_right,
         2,
         8,
         border_width=1
     )

if barstate.islast and showDashboard

    trendText =
         bullEMA ?
         "BULLISH" :
         bearEMA ?
         "BEARISH" :
         "NEUTRAL"

    vwapText =
         bullVWAP ?
         "ABOVE" :
         "BELOW"

    momentumText =
         bullMomentum ?
         "BULLISH" :
         bearMomentum ?
         "BEARISH" :
         "NEUTRAL"

    marketText =
         benchmarkBull ?
         "BULLISH" :
         benchmarkBear ?
         "BEARISH" :
         "NEUTRAL"

    setupText =
         bullAPlus ?
         "A+ CALL" :
         bearAPlus ?
         "A+ PUT" :
         bullA ?
         "A CALL" :
         bearA ?
         "A PUT" :
         "WAIT"

    scoreText =
         bullScore > bearScore ?
         str.tostring(bullScore) + "/8 CALL" :
         str.tostring(bearScore) + "/8 PUT"


    table.cell(
         dashboard,
         0,
         0,
         "TRADE SERENE PRO",
         bgcolor=color.black,
         text_color=color.white
    )

    table.cell(
         dashboard,
         1,
         0,
         "OPTIONS",
         bgcolor=color.black,
         text_color=color.white
    )


    table.cell(
         dashboard,
         0,
         1,
         "TREND"
    )

    table.cell(
         dashboard,
         1,
         1,
         trendText
    )


    table.cell(
         dashboard,
         0,
         2,
         "VWAP"
    )

    table.cell(
         dashboard,
         1,
         2,
         vwapText
    )


    table.cell(
         dashboard,
         0,
         3,
         "RVOL"
    )

    table.cell(
         dashboard,
         1,
         3,
         str.tostring(
             relativeVolume,
             "#.##"
         ) + "x"
    )


    table.cell(
         dashboard,
         0,
         4,
         "MOMENTUM"
    )

    table.cell(
         dashboard,
         1,
         4,
         momentumText
    )


    table.cell(
         dashboard,
         0,
         5,
         "MARKET"
    )

    table.cell(
         dashboard,
         1,
         5,
         marketText
    )


    table.cell(
         dashboard,
         0,
         6,
         "SCORE"
    )

    table.cell(
         dashboard,
         1,
         6,
         scoreText
    )


    table.cell(
         dashboard,
         0,
         7,
         "SETUP"
    )

    table.cell(
         dashboard,
         1,
         7,
         setupText
    )


//====================================================
// 24. ALERTS
//====================================================

alertcondition(
     newBullAPlus,
     title="Trade Serene A+ CALL",
     message="Trade Serene PRO: A+ CALL setup detected."
)

alertcondition(
     newBearAPlus,
     title="Trade Serene A+ PUT",
     message="Trade Serene PRO: A+ PUT setup detected."
)

alertcondition(
     newBullA,
     title="Trade Serene A CALL",
     message="Trade Serene PRO: A CALL setup detected."
)

alertcondition(
     newBearA,
     title="Trade Serene A PUT",
     message="Trade Serene PRO: A PUT setup detected."
)

alertcondition(
     exitCall,
     title="Trade Serene Exit CALL",
     message="Trade Serene PRO: CALL exit condition detected."
)

alertcondition(
     exitPut,
     title="Trade Serene Exit PUT",
     message="Trade Serene PRO: PUT exit condition detected."
)