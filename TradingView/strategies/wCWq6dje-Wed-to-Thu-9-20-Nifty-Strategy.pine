//@version=6
strategy('Wed to Thu 9:20 Nifty Strategy', overlay = true, margin_long = 100, margin_short = 100)

// --- Timezone & Time Variables ---
tz = 'Asia/Kolkata'
ist_hour = hour(time, tz)
ist_minute = minute(time, tz)
ist_day = dayofweek(time, tz)

// --- Price Variables ---
var float prev_tue_price = na
var float prev_wed_price = na
var float curr_tue_price = na
var float curr_wed_price = na

// Variable to hold the active reference price for plotting
var float active_ref_price = na

// --- Time Detection ---
// Detect a new week to shift our stored values backward
is_new_week = ta.change(time('W')) != 0
if is_new_week
    prev_tue_price := curr_tue_price
    prev_wed_price := curr_wed_price
    curr_tue_price := na
    curr_wed_price := na
    active_ref_price := na // Reset the line for the new week until Wed 9:20
    active_ref_price

// Detect the 9:15 AM candle (which closes at exactly 9:20 AM)
is_920_time = ist_hour == 9 and ist_minute == 15

// --- Price Recording & Entry Logic ---
// 1. Record Tuesday
if ist_day == dayofweek.tuesday and is_920_time
    curr_tue_price := close
    curr_tue_price

// 2. Wednesday Core Logic
if ist_day == dayofweek.wednesday and is_920_time
    // Set the active reference price (Fallback to Tuesday if Wed is missing)
    active_ref_price := na(prev_wed_price) ? prev_tue_price : prev_wed_price

    // Execute trades if we have a valid historical reference price
    if not na(active_ref_price)
        if close > active_ref_price
            strategy.entry('Long', strategy.long)
        if close < active_ref_price
            strategy.entry('Short', strategy.short)

    // Record this Wednesday's price for next week
    curr_wed_price := close
    curr_wed_price

// --- Exit Logic ---
// 3. Stop Loss Execution (100 points up or down)
if strategy.position_size > 0
    strategy.exit('SL Long', 'Long', stop = strategy.position_avg_price - 100)

if strategy.position_size < 0
    strategy.exit('SL Short', 'Short', stop = strategy.position_avg_price + 100)

// 4. Next Trading Day Time Exit (3:20 PM)
// Since we strictly enter on Wednesday, if we hold a position and it is 3:20 PM on ANY 
// day other than Wednesday, we exit. This seamlessly skips Thursday if it is a holiday.
is_time_exit = strategy.position_size != 0 and ist_day != dayofweek.wednesday and ist_hour == 15 and ist_minute >= 15
if is_time_exit
    strategy.close('Long', comment = 'Next Day 3:20 Exit')
    strategy.close('Short', comment = 'Next Day 3:20 Exit')

// --- Visualizations ---
// Plot the Last Wednesday (or Tuesday) Reference Price
plot(active_ref_price, title = 'Reference Price (Wed/Tue)', color = color.blue, style = plot.style_linebr, linewidth = 2)

// Calculate and Plot the Active Stop Loss Line (100 points)
sl_level = strategy.position_size > 0 ? strategy.position_avg_price - 100 : strategy.position_size < 0 ? strategy.position_avg_price + 100 : na
plot(sl_level, title = 'Active Stop Loss', color = color.red, style = plot.style_linebr, linewidth = 2)
