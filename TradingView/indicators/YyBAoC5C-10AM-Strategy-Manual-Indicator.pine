//@version=6
indicator("10AM Reference Level", "10AM Level", overlay = true)

// Simple reference tool:
// Captures the 10:00 AM New York open and plots that level for the rest of the day.

const string TZ = "America/New_York"

string groupTime = "Time"
int keyHour = input.int(10, "Reference hour (ET)", minval = 0, maxval = 23, group = groupTime)
int keyMinute = input.int(0, "Reference minute (ET)", minval = 0, maxval = 59, group = groupTime)

string groupDisplay = "Display"
bool showLabel = input.bool(true, "Show price label", group = groupDisplay)
int lineWidth = input.int(2, "Line width", minval = 1, maxval = 4, group = groupDisplay)

int etDate = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)
int etMinutes = hour(time, TZ) * 60 + minute(time, TZ)
int keyMinutes = keyHour * 60 + keyMinute

bool newEtDay = na(etDate[1]) or etDate != etDate[1]
bool isKeyBar = timeframe.isintraday and etMinutes == keyMinutes

var float keyOpen = na
var bool keyCaptured = false
var label priceLabel = na

if newEtDay
    keyOpen := na
    keyCaptured := false
    label.delete(priceLabel)
    priceLabel := na

if not keyCaptured and isKeyBar
    keyOpen := math.round(open / syminfo.mintick) * syminfo.mintick
    keyCaptured := true

plot(keyCaptured ? keyOpen : na,
     title = "10:00 ET Open",
     color = color.rgb(30, 144, 255),
     linewidth = lineWidth,
     style = plot.style_linebr)

if barstate.islast
    label.delete(priceLabel)
    priceLabel := na

    if showLabel and keyCaptured
        priceLabel := label.new(
             bar_index + 2,
             keyOpen,
             "10:00 ET  " + str.tostring(keyOpen, format.mintick),
             xloc = xloc.bar_index,
             style = label.style_label_left,
             color = color.rgb(30, 144, 255),
             textcolor = color.white,
             size = size.small)
