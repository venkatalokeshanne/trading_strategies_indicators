// Oryginalny skrypt: "Impulse Alerts" (c) Riccardo Di Giacomo, opublikowany na
// TradingView na licencji MPL-2.0 (kod jawny, wolno go reuzywac i modyfikowac
// pod warunkiem zachowania informacji o licencji i autorstwie oryginalu).
//
// Praca pochodna (derivative work). Zmiany w tej wersji (v9):
// - Podbite do Pine Script v6 (wymog TradingView do publikacji publicznych
//   skryptow) - reszta logiki bez zmian wzgledem v8.
// - Na wykresie rysowane sa TYLKO etykiety ENTRY / RE-ENTRY (SL i TP1-3
//   nadal liczone i wysylane w alert JSON, ale bez SL/TP - tylko ENTRY,
//   ticker, interwal i czas).
// - Filtr trendu EMA200 dla sygnalow BUY/SELL domyslnie WYLACZONY.
// - Panel "Trend Track" (multi-timeframe), FVG re-entry, entry = otwarcie
//   kolejnej swiecy - bez zmian wzgledem v8.
//
// Dystrybuowane na tej samej licencji MPL-2.0.
 
//@version=6
indicator("SharkMarket Impulse v9 (na bazie Impulse Alerts, Riccardo Di Giacomo, MPL-2.0)", shorttitle="SharkMarket Impulse v9", overlay=true, max_boxes_count=300, max_lines_count=200, max_labels_count=200)
 
// ================== KOLORY ==================
grpColor = "Kolory"
colorBull = input.color(color.fuchsia, "BUY / ENTRY dla BUY (różowy)", group=grpColor)
colorBear = input.color(color.blue, "SELL / ENTRY dla SELL (niebieski)", group=grpColor)
 
// ================== ETYKIETA ENTRY ==================
grpLabels = "Etykieta Entry"
labelOffset = input.int(8, "Rozciągnięcie linii/boxa w prawo (barów) - blisko świecy", minval=1, maxval=200, group=grpLabels)
 
drawLevel(_y, _txt, _col) =>
    ln = line.new(bar_index, _y, bar_index + labelOffset, _y, color=_col, style=line.style_dashed, width=1)
    lb = label.new(bar_index + labelOffset, _y, _txt, style=label.style_label_left, color=_col, textcolor=color.white, size=size.small)
    [ln, lb]
 
var line[]  buyLines   = array.new_line()
var label[] buyLabels  = array.new_label()
var line[]  sellLines  = array.new_line()
var label[] sellLabels = array.new_label()
 
clearGroup(line[] lns, label[] lbs) =>
    if array.size(lns) > 0
        for i = 0 to array.size(lns) - 1
            line.delete(array.get(lns, i))
            label.delete(array.get(lbs, i))
        array.clear(lns)
        array.clear(lbs)
 
// ================== EMA 9 / EMA 21 ==================
ma9len = input.int(9, minval=1, title="Length", group="EMA 9")
ma9src = input(close, title="Source", group="EMA 9")
ma9out = ta.ema(ma9src, ma9len)
plot(ma9out, color=color.new(colorBull, 0), title="EMA9", linewidth=2)
 
ema21len = input.int(21, minval=1, title="Length", group="EMA 21")
ema21src = input(close, title="Source", group="EMA 21")
ema21out = ta.ema(ema21src, ema21len)
plot(ema21out, color=color.new(colorBear, 0), title="EMA21", linewidth=2)
 
// ================== EMA 200 - filtr trendu (domyślnie WYŁĄCZONY) ==================
grpTrend = "EMA 200 - filtr trendu"
ema200len = input.int(200, minval=1, title="Length", group=grpTrend)
ema200src = input(close, title="Source", group=grpTrend)
ema200out = ta.ema(ema200src, ema200len)
useTrendFilter = input.bool(false, "BUY tylko powyżej EMA200 / SELL tylko poniżej EMA200", group=grpTrend)
colorBasis = close >= ema200out ? color.new(colorBull, 40) : color.new(colorBear, 40)
plot(ema200out, title="EMA200", color=colorBasis, linewidth=2)
 
// ================== TREND TRACK (WYŻSZE INTERWAŁY) ==================
grpMTF = "Trend Track (wyższe interwały)"
showMTF = input.bool(true, "Pokaż panel Trend Track", group=grpMTF)
tf1 = input.timeframe("5",   "Interwał 1", group=grpMTF)
tf2 = input.timeframe("15",  "Interwał 2", group=grpMTF)
tf3 = input.timeframe("30",  "Interwał 3", group=grpMTF)
tf4 = input.timeframe("60",  "Interwał 4", group=grpMTF)
tf5 = input.timeframe("240", "Interwał 5", group=grpMTF)
tf6 = input.timeframe("D",   "Interwał 6", group=grpMTF)
mtfPosInput = input.string("top_right", "Pozycja panelu", options=["top_right", "top_left", "bottom_right", "bottom_left"], group=grpMTF)
 
tfLabel(tf) =>
    switch tf
        "1"   => "M1"
        "3"   => "M3"
        "5"   => "M5"
        "15"  => "M15"
        "30"  => "M30"
        "60"  => "H1"
        "120" => "H2"
        "240" => "H4"
        "D"   => "D1"
        "W"   => "W1"
        =>  tf
 
getTrendUp(tf) =>
    request.security(syminfo.tickerid, tf, close > ta.ema(close, ema200len), lookahead=barmerge.lookahead_off)
 
trend1 = getTrendUp(tf1)
trend2 = getTrendUp(tf2)
trend3 = getTrendUp(tf3)
trend4 = getTrendUp(tf4)
trend5 = getTrendUp(tf5)
trend6 = getTrendUp(tf6)
 
mtfPos = mtfPosInput == "top_right" ? position.top_right : mtfPosInput == "top_left" ? position.top_left : mtfPosInput == "bottom_right" ? position.bottom_right : position.bottom_left
var table mtfTable = table.new(mtfPos, 6, 2, border_width=1, border_color=color.new(color.gray, 50))
 
fillCell(col, tfName, isUp) =>
    table.cell(mtfTable, col, 0, tfName, bgcolor=color.new(color.black, 15), text_color=color.white, text_size=size.small)
    table.cell(mtfTable, col, 1, isUp ? "▲" : "▼", bgcolor=color.new(isUp ? colorBull : colorBear, 15), text_color=color.white, text_size=size.large)
 
if showMTF and barstate.islast
    fillCell(0, tfLabel(tf1), trend1)
    fillCell(1, tfLabel(tf2), trend2)
    fillCell(2, tfLabel(tf3), trend3)
    fillCell(3, tfLabel(tf4), trend4)
    fillCell(4, tfLabel(tf5), trend5)
    fillCell(5, tfLabel(tf6), trend6)
 
// ================== BOLLINGER BANDS (jasny różowy) ==================
grpBB = "Bollinger Bands"
bbsrc = input(close, group=grpBB)
bblength = input.int(20, minval=1, group=grpBB)
bbmult = input.float(2.0, minval=0.001, maxval=50, group=grpBB)
bbColor = input.color(color.rgb(255, 105, 180), "Kolor chmury BB (jasny różowy)", group=grpBB)
 
basis  = ta.sma(bbsrc, bblength)
dev    = ta.stdev(bbsrc, bblength)
dev2   = bbmult * dev
upper1 = basis + dev
lower1 = basis - dev
upper2 = basis + dev2
lower2 = basis - dev2
 
pUpper1 = plot(upper1, color=color.new(bbColor, 55))
pUpper2 = plot(upper2, color=color.new(bbColor, 55))
pLower1 = plot(lower1, color=color.new(bbColor, 55))
pLower2 = plot(lower2, color=color.new(bbColor, 55))
fill(pUpper1, pUpper2, color=color.new(bbColor, 88))
fill(pLower1, pLower2, color=color.new(bbColor, 88))
 
// ================== SL / TP W PIPSACH (liczone dla alertu, nie rysowane) ==================
grpPips = "SL / TP (pipsy) - tylko do alertu Telegram"
pipSize    = input.float(0.1, "Wielkość 1 pipsa (jednostki ceny)", tooltip="Forex: 0.0001 (pary JPY: 0.01) | Złoto XAUUSD: zwykle 0.1 | Indeksy np. US100/NAS100: zwykle 1.0 - sprawdź u swojego brokera", group=grpPips)
slPips     = input.float(50, "SL (pipsy)", group=grpPips)
tpStepPips = input.float(50, "Odstęp między TP (pipsy)", group=grpPips)
enableAlerts = input.bool(true, "Wysyłaj alert() z JSON do webhooka", group=grpPips)
 
slDist     = slPips * pipSize
tpStepDist = tpStepPips * pipSize
 
// ================== RE-ENTRY PO FVG ==================
grpFVG = "Re-Entry po FVG"
enableFVG     = input.bool(true, "Włącz Re-Entry na retest FVG", group=grpFVG)
maxFvgZones   = input.int(6, "Max aktywnych stref FVG", group=grpFVG)
fvgExtendBars = input.int(30, "Rozciągnięcie strefy FVG (barów)", group=grpFVG)
 
var box[]  fvgBoxes = array.new_box()
var bool[] fvgIsBuy = array.new_bool()
var bool[] fvgUsed  = array.new_bool()
 
// ================== SYGNAŁ: PRZECIĘCIE EMA9 / EMA21 (+ opcjonalny filtr EMA200) ==================
crossUp   = ta.crossover(ma9out, ema21out)
crossDown = ta.crossunder(ma9out, ema21out)
 
buySignal  = crossUp   and (not useTrendFilter or close > ema200out)
sellSignal = crossDown and (not useTrendFilter or close < ema200out)
 
plotshape(buySignal,  title="BUY",  style=shape.labelup,   location=location.belowbar, color=color.new(colorBull, 0), text="BUY",  textcolor=color.white, size=size.small)
plotshape(sellSignal, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.new(colorBear, 0), text="SELL", textcolor=color.white, size=size.small)
 
// ================== ENTRY = OTWARCIE ŚWIECY PO SYGNALE ==================
if buySignal[1]
    entry = open
    sl  = entry - slDist
    tp1 = entry + tpStepDist
    tp2 = entry + tpStepDist * 2
    tp3 = entry + tpStepDist * 3
    clearGroup(buyLines, buyLabels)
    [lnE, lbE] = drawLevel(entry, "ENTRY (" + str.tostring(entry, format.mintick) + ")", colorBull)
    array.push(buyLines, lnE)
    array.push(buyLabels, lbE)
    if enableAlerts
        msg = '{"strategy":"SharkMarket Impulse","ticker":"' + syminfo.ticker + '","action":"BUY","type":"signal","price":' + str.tostring(entry, format.mintick) + ',"timeframe":"' + tfLabel(timeframe.period) + '","time":"' + str.format_time(time, "yyyy-MM-dd HH:mm", "Europe/Warsaw") + '"}'
        alert(msg, alert.freq_once_per_bar)
 
if sellSignal[1]
    entry = open
    sl  = entry + slDist
    tp1 = entry - tpStepDist
    tp2 = entry - tpStepDist * 2
    tp3 = entry - tpStepDist * 3
    clearGroup(sellLines, sellLabels)
    [lnE, lbE] = drawLevel(entry, "ENTRY (" + str.tostring(entry, format.mintick) + ")", colorBear)
    array.push(sellLines, lnE)
    array.push(sellLabels, lbE)
    if enableAlerts
        msg = '{"strategy":"SharkMarket Impulse","ticker":"' + syminfo.ticker + '","action":"SELL","type":"signal","price":' + str.tostring(entry, format.mintick) + ',"timeframe":"' + tfLabel(timeframe.period) + '","time":"' + str.format_time(time, "yyyy-MM-dd HH:mm", "Europe/Warsaw") + '"}'
        alert(msg, alert.freq_once_per_bar)
 
// ================== WYKRYWANIE FVG NA ŚWIECY SYGNAŁOWEJ ==================
bullFVG = low > high[2]
bearFVG = high < low[2]
 
if enableFVG and buySignal[1] and bullFVG
    fBoxB = box.new(bar_index - 2, high[2], bar_index + fvgExtendBars, low, border_color=color.new(colorBull, 0), bgcolor=color.new(colorBull, 82))
    array.push(fvgBoxes, fBoxB)
    array.push(fvgIsBuy, true)
    array.push(fvgUsed, false)
    if array.size(fvgBoxes) > maxFvgZones
        box.delete(array.shift(fvgBoxes))
        array.shift(fvgIsBuy)
        array.shift(fvgUsed)
 
if enableFVG and sellSignal[1] and bearFVG
    fBoxS = box.new(bar_index - 2, high, bar_index + fvgExtendBars, low[2], border_color=color.new(colorBear, 0), bgcolor=color.new(colorBear, 82))
    array.push(fvgBoxes, fBoxS)
    array.push(fvgIsBuy, false)
    array.push(fvgUsed, false)
    if array.size(fvgBoxes) > maxFvgZones
        box.delete(array.shift(fvgBoxes))
        array.shift(fvgIsBuy)
        array.shift(fvgUsed)
 
// ================== RETEST FVG -> RE-ENTRY ==================
retestBuySignal = false
retestSellSignal = false
 
if enableFVG and array.size(fvgBoxes) > 0
    for i = 0 to array.size(fvgBoxes) - 1
        zBox   = array.get(fvgBoxes, i)
        zIsBuy = array.get(fvgIsBuy, i)
        zUsed  = array.get(fvgUsed, i)
        zTop = box.get_top(zBox)
        zBot = box.get_bottom(zBox)
        if not zUsed
            if zIsBuy and low <= zTop and low >= zBot and close > open
                retestBuySignal := true
                array.set(fvgUsed, i, true)
            if not zIsBuy and high >= zBot and high <= zTop and close < open
                retestSellSignal := true
                array.set(fvgUsed, i, true)
 
plotshape(retestBuySignal,  title="Re-Entry BUY",  style=shape.triangleup,   location=location.belowbar, color=color.new(colorBull, 0), size=size.tiny)
plotshape(retestSellSignal, title="Re-Entry SELL", style=shape.triangledown, location=location.abovebar, color=color.new(colorBear, 0), size=size.tiny)
 
// ================== RE-ENTRY: ENTRY = OTWARCIE KOLEJNEJ ŚWIECY ==================
if retestBuySignal[1]
    entryR = open
    slR  = entryR - slDist
    tp1R = entryR + tpStepDist
    tp2R = entryR + tpStepDist * 2
    tp3R = entryR + tpStepDist * 3
    clearGroup(buyLines, buyLabels)
    [lnE, lbE] = drawLevel(entryR, "RE-ENTRY", colorBull)
    array.push(buyLines, lnE)
    array.push(buyLabels, lbE)
    if enableAlerts
        msgR = '{"strategy":"SharkMarket Impulse","ticker":"' + syminfo.ticker + '","action":"BUY","type":"reentry_fvg","price":' + str.tostring(entryR, format.mintick) + ',"timeframe":"' + tfLabel(timeframe.period) + '","time":"' + str.format_time(time, "yyyy-MM-dd HH:mm", "Europe/Warsaw") + '"}'
        alert(msgR, alert.freq_once_per_bar)
 
if retestSellSignal[1]
    entryR = open
    slR  = entryR + slDist
    tp1R = entryR - tpStepDist
    tp2R = entryR - tpStepDist * 2
    tp3R = entryR - tpStepDist * 3
    clearGroup(sellLines, sellLabels)
    [lnE, lbE] = drawLevel(entryR, "RE-ENTRY", colorBear)
    array.push(sellLines, lnE)
    array.push(sellLabels, lbE)
    if enableAlerts
        msgR = '{"strategy":"SharkMarket Impulse","ticker":"' + syminfo.ticker + '","action":"SELL","type":"reentry_fvg","price":' + str.tostring(entryR, format.mintick) + ',"timeframe":"' + tfLabel(timeframe.period) + '","time":"' + str.format_time(time, "yyyy-MM-dd HH:mm", "Europe/Warsaw") + '"}'
        alert(msgR, alert.freq_once_per_bar)
 