// @version=6
strategy("SMA夹层+短线密集策略", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=15)

// --- 参数设置 ---
int len13  = input.int(13, "快线 SMA 13")
int len26  = input.int(26, "基准线 SMA 26")
int len100 = input.int(100, "慢线 SMA 100")
int len200 = input.int(200, "长线 SMA 200")

// 密集度设置：13线与26线的距离百分比
float shortClusterThreshold = input.float(0.3, "13/26密集阈值 (%)", step=0.05) 

// --- 指标计算 ---
float sma13  = ta.sma(close, len13)
float sma26  = ta.sma(close, len26)
float sma100 = ta.sma(close, len100)
float sma200 = ta.sma(close, len200)

// --- 密集度判定 ---
// 计算 13线 和 26线 之间的距离占 13线的百分比
float shortSpread = (math.abs(sma13 - sma26) / sma13) * 100
bool isShortClustered = shortSpread <= shortClusterThreshold

// --- 夹层排列逻辑判定 ---

// 多头：200 > 100 > Close > 13 > 26 (且13/26密集)
bool longCondition = (sma200 > sma100) and (sma100 > close) and (close > sma13) and (sma13 > sma26) and isShortClustered

// 空头：200 < 100 < Close < 13 < 26 (且13/26密集)
bool shortCondition = (sma200 < sma100) and (sma100 < close) and (close < sma13) and (sma13 < sma26) and isShortClustered

// --- 执行交易 (仅在条件成立的第一根K线进入) ---
if longCondition and not longCondition[1]
    strategy.entry("Long", strategy.long)

if shortCondition and not shortCondition[1]
    strategy.entry("Short", strategy.short)

// --- 可视化标签 (黄色标签) ---
plotshape(longCondition and not longCondition[1],  title="多头买入", text="密集夹层\n买入", style=shape.labelup, location=location.belowbar, color=color.yellow, textcolor=color.black, size=size.small)
plotshape(shortCondition and not shortCondition[1], title="空头卖出", text="密集夹层\n卖出", style=shape.labeldown, location=location.abovebar, color=color.yellow, textcolor=color.black, size=size.small)

// --- 离场逻辑 (SMA 13 反向缺口止盈) ---

// 多头离场：K线最高价都低于 SMA 13 (完全脱离)
bool longExit = strategy.position_size > 0 and high < sma13

// 空头离场：K线最低价都高于 SMA 13 (完全脱离)
bool shortExit = strategy.position_size < 0 and low > sma13

if longExit
    strategy.close("Long", comment="多头SMA13缺口止盈")

if shortExit
    strategy.close("Short", comment="空头SMA13缺口止盈")

// --- 绘图展示 ---
plot(sma13,  color=color.aqua,   title="SMA 13", linewidth=1)
plot(sma26,  color=color.orange, title="SMA 26", linewidth=1)
plot(sma100, color=color.white,  title="SMA 100", linewidth=2)
plot(sma200, color=color.red,    title="SMA 200", linewidth=2)

// 辅助背景：当13/26处于密集状态时，显示淡淡的蓝色背景
bgcolor(isShortClustered ? color.new(color.blue, 90) : na)