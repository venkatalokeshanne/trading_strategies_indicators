//@version=6
strategy("SSL MACD - nhuthang83 5 SESSIONS",overlay = false,process_orders_on_close = true,calc_on_every_tick = true,pyramiding = 10)

// ==========================================
// 1. QUẢN LÝ VỐN & HIỂN THỊ 
// ==========================================
grmm = "======= Quản lý vốn (Risk) ======="
riskUSD  = input.float(100.0, "Số tiền rủi ro/lệnh (USD)", group=grmm)
showInfo = input.bool(true, "Hiển thị thông tin Lệnh & Lot", group=grmm)

usdjpy_rate = request.security("OANDA:USDJPY", timeframe.period, close, ignore_invalid_symbol=true)

var float contractSize = 100000.0
if str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD")
    contractSize := 100.0
else
    contractSize := 100000.0

isJPY = syminfo.currency == "JPY"

// ==========================================
// 2. THÔNG SỐ CHỈ BÁO GỐC (GIỮ NGUYÊN)
// ==========================================
slATR = input.float(2,"Stop Loss ATR Mulipler")
tgATR = input.float(3,"Target ATR Mulipler")

gratr = "======= ATR ======="
length = input.int(title="Length", defval=14, minval=1,group = gratr)
smoothing = input.string(title="Smoothing", defval="RMA", options=["RMA", "SMA", "EMA", "WMA"],group = gratr)
ma_function(source, length) =>
    switch smoothing
        "RMA" => ta.rma(source, length)
        "SMA" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        => ta.wma(source, length)

atr = ma_function(ta.tr(true), length)

// ==========================================
// KHU VỰC NÂNG CẤP: 5 KHUNG GIỜ VÀNG
// ==========================================
group_sess = "----------------------- Đa Khung Giờ (5 Sessions) -----------------------"
isCurstomSession = input.bool(true,"Dùng Múi giờ tùy chỉnh",inline = "tz",group = group_sess)
sessionTimeZone = input.string("Asia/Bangkok","",inline="tz",group = group_sess)
sessClr  =  input.color(color.rgb(255, 82, 82, 94),"Màu nền",group = group_sess)

useSession =  input.bool(true,"Bật giới hạn thời gian giao dịch",group = group_sess)

useSess1 = input.bool(true, "Bật Khung giờ 1:", inline="s1", group=group_sess)
Session1 = input.session("0700-1100", "", inline="s1", group=group_sess)

useSess2 = input.bool(true, "Bật Khung giờ 2:", inline="s2", group=group_sess)
Session2 = input.session("1300-1500", "", inline="s2", group=group_sess)

useSess3 = input.bool(false, "Bật Khung giờ 3:", inline="s3", group=group_sess)
Session3 = input.session("1600-1800", "", inline="s3", group=group_sess)

useSess4 = input.bool(false, "Bật Khung giờ 4:", inline="s4", group=group_sess)
Session4 = input.session("1930-2130", "", inline="s4", group=group_sess)

useSess5 = input.bool(false, "Bật Khung giờ 5:", inline="s5", group=group_sess)
Session5 = input.session("2200-2330", "", inline="s5", group=group_sess)

// Xử lý logic thời gian
tz = isCurstomSession ? sessionTimeZone : syminfo.timezone
inSess1 = useSess1 ? not na(time(timeframe.period, Session1 + ":1234567", tz)) : false
inSess2 = useSess2 ? not na(time(timeframe.period, Session2 + ":1234567", tz)) : false
inSess3 = useSess3 ? not na(time(timeframe.period, Session3 + ":1234567", tz)) : false
inSess4 = useSess4 ? not na(time(timeframe.period, Session4 + ":1234567", tz)) : false
inSess5 = useSess5 ? not na(time(timeframe.period, Session5 + ":1234567", tz)) : false

// Lệnh hợp lệ nếu nằm trong BẤT KỲ khung giờ nào đang được BẬT
isInSession = useSession ? (inSess1 or inSess2 or inSess3 or inSess4 or inSess5) : true 
bgcolor(isInSession and useSession ? sessClr : na, title = "Session Background Color")

// ==========================================
// SUPERTREND, SSL, MACD (GIỮ NGUYÊN)
// ==========================================
grst = "=========== Supertrend ========="
atrPeriod = input.int(10,    "ATR Length", minval = 1,group = grst)
factor =    input.float(3.0, "Factor",     minval = 0.01, step = 0.01,group = grst)

[supertrend, direction] = ta.supertrend(factor, atrPeriod)
supertrend := barstate.isfirst ? na : supertrend
upTrend =    plot(direction < 0 ? supertrend : na, "Up Trend",   color = color.green, style = plot.style_linebr)
downTrend =  plot(direction < 0 ? na : supertrend, "Down Trend", color = color.red,   style = plot.style_linebr)
bodyMiddle = plot(barstate.isfirst ? na : (open + close) / 2, "Body Middle",display = display.none)

fill(bodyMiddle, upTrend,   title = "Uptrend background",   color = color.new(color.green, 90), fillgaps = false)
fill(bodyMiddle, downTrend, title = "Downtrend background", color = color.new(color.red,   90), fillgaps = false)

isGreenST  = direction < 0
isBuyST = isGreenST 
isSellST = not isGreenST 

grSsl = "======== SSL channel ========"
period = input(title = 'Period', defval = 10,group = grSsl)
len = input(title = 'Period', defval = 10,group = grSsl)
smaHigh = ta.sma(high, len)
smaLow = ta.sma(low, len)
Hlv = int(na)
Hlv := close > smaHigh ? 1 : close < smaLow ? -1 : Hlv[1]
sslDown = Hlv < 0 ? smaHigh : smaLow
sslUp = Hlv < 0 ? smaLow : smaHigh

plot(sslDown, linewidth = 2, color = color.new(color.red, 0))
plot(sslUp, linewidth = 2, color = color.new(color.lime, 0))

isBuySSL = ta.crossover(sslUp,sslDown)
isSellSSL = ta.crossunder(sslUp,sslDown)

grmacd = "========= MACD ========"
fast_length = input(title = "Fast Length", defval = 12,group = grmacd)
slow_length = input(title = "Slow Length", defval = 26,group = grmacd)
src = input(title = "Source", defval = close,group = grmacd)
signal_length = input.int(title = "Signal Smoothing",  minval = 1, maxval = 50, defval = 9, display = display.data_window,group = grmacd)
sma_source = input.string(title = "Oscillator MA Type",  defval = "EMA", options = ["SMA", "EMA"], display = display.data_window,group = grmacd)
sma_signal = input.string(title = "Signal Line MA Type", defval = "EMA", options = ["SMA", "EMA"], display = display.data_window,group = grmacd)

fast_ma = sma_source == "SMA" ? ta.sma(src, fast_length) : ta.ema(src, fast_length)
slow_ma = sma_source == "SMA" ? ta.sma(src, slow_length) : ta.ema(src, slow_length)
macd = fast_ma - slow_ma
signal = sma_signal == "SMA" ? ta.sma(macd, signal_length) : ta.ema(macd, signal_length)

isBuyMacd = macd > 0
isSellMacd = macd < 0
isGreen = close >= open

// ĐIỀU KIỆN LỆNH GỐC
isBuy = isGreen and isBuyST and isBuySSL and isBuyMacd and isInSession and barstate.isconfirmed
isSell = not isGreen and isSellST and isSellSSL and isSellMacd and isInSession and barstate.isconfirmed

buyMess = ""
sellMess = ""
var float Entry_Price = na
var float StopLoss_Price = na
var float Target_Price = na

isBuyPlot = false
isSellPlot = false
var int ordId = 0

// ==========================================
// 3. THỰC THI LỆNH & ÉP KHỐI LƯỢNG
// ==========================================
if isBuy  
    Entry_Price := close
    StopLoss_Price :=  Entry_Price - slATR*atr
    Target_Price := Entry_Price + tgATR*atr
    
    float sl_dist = math.abs(Entry_Price - StopLoss_Price)
    float adjustedRisk = isJPY and not na(usdjpy_rate) ? (riskUSD * usdjpy_rate) : riskUSD
    float lot_qty = sl_dist > 0 ? (adjustedRisk / (sl_dist * contractSize)) : 0

    isBuyPlot := true
    ordId += 1
    
    if lot_qty > 0
        strategy.entry("Buy"+str.tostring(ordId),strategy.long, qty=lot_qty, alert_message = buyMess)
        strategy.exit("Exit"+str.tostring(ordId), "Buy"+str.tostring(ordId), limit=Target_Price, stop = StopLoss_Price,  comment_profit = "TP",comment_loss = "SL")

        if showInfo
            string infoText = "BUY LOT: " + str.format("{0,number,#.##}", lot_qty) + "\nEntry: " + str.tostring(Entry_Price) + "\nSL: " + str.tostring(StopLoss_Price) + "\nTP: " + str.tostring(Target_Price)
            label.new(bar_index, low - atr, infoText, color=color.green, textcolor=color.white, style=label.style_label_up, size=size.small)

if isSell 
    Entry_Price := close
    StopLoss_Price :=  Entry_Price + slATR*atr
    Target_Price := Entry_Price - tgATR*atr

    float sl_dist = math.abs(Entry_Price - StopLoss_Price)
    float adjustedRisk = isJPY and not na(usdjpy_rate) ? (riskUSD * usdjpy_rate) : riskUSD
    float lot_qty = sl_dist > 0 ? (adjustedRisk / (sl_dist * contractSize)) : 0

    isSellPlot := true
    ordId += 1
    
    if lot_qty > 0
        strategy.entry("Sell"+str.tostring(ordId),strategy.short, qty=lot_qty, alert_message = sellMess)
        strategy.exit("Exit"+str.tostring(ordId), "Sell"+str.tostring(ordId), limit=Target_Price, stop = StopLoss_Price,  comment_profit = "TP",comment_loss = "SL")

        if showInfo
            string infoText = "SELL LOT: " + str.format("{0,number,#.##}", lot_qty) + "\nEntry: " + str.tostring(Entry_Price) + "\nSL: " + str.tostring(StopLoss_Price) + "\nTP: " + str.tostring(Target_Price)
            label.new(bar_index, high + atr, infoText, color=color.red, textcolor=color.white, style=label.style_label_down, size=size.small)

// ==========================================
// 4. VISUALS CỦA TÁC GIẢ
// ==========================================
plotshape(isBuyPlot, 'Buy', text='Buy', style=shape.labelup, color=color.green, textcolor=color.white, size=size.tiny,location=location.belowbar,force_overlay = true)
plotshape(isSellPlot, 'Sell', text='Sell', style=shape.labeldown, color=color.red, textcolor=color.white, size=size.tiny,location=location.abovebar,force_overlay = true)
slplot = plot(strategy.position_size != 0 ? StopLoss_Price : na,"Stop Loss",style = plot.style_circles,color=color.red,force_overlay = true)
limtplot = plot(strategy.position_size != 0 ? Target_Price : na,"Limit",style = plot.style_circles,color=color.green,force_overlay = true)
entryplot = plot(strategy.position_size != 0 ? Entry_Price : na,"Entry",style = plot.style_circles,color=color.black,force_overlay = true)

fill(entryplot,slplot,color = color.rgb(255, 82, 82, 90))
fill(limtplot,entryplot,color = color.rgb(82, 255, 91, 90))
  
if isBuyPlot
    alert("Buy Signal")
if isSellPlot
    alert("Sell Signal")