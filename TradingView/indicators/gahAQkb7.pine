// ============================================================================
// RS ENGINE
// ============================================================================

calcRS(float symbolClose) =>

    ratio =
         benchmarkClose != 0
         ? symbolClose / benchmarkClose
         : na

    levelLine =
         ta.rsi(
             ratio,
             levelLen)

    rocRaw =
         ta.roc(
             ratio,
             rocLen)

    momentumLine =
         ta.rsi(
             rocRaw,
             momSmooth)

    bullLevel =
         levelLine > bullLevelIn

    bearLevel =
         levelLine < bearLevelIn

    bullMom =
         momentumLine > bullLevelIn

    bearMom =
         momentumLine < bearLevelIn

    score =
         (bullLevel ? 1 : 0) +
         (bullMom ? 1 : 0) -
         (bearLevel ? 1 : 0) -
         (bearMom ? 1 : 0)

    score

rs1  = calcRS(close1)
rs2  = calcRS(close2)
rs3  = calcRS(close3)
