//@version=6
indicator("EZ$ S/R Auction Structure v9.0", shorttitle="EZ$ S/R", overlay=true,
     max_boxes_count=220, max_labels_count=500, max_lines_count=220)

//──────────────────────────────────────────────────────────────────────────────
// EZ$ S/R AUCTION STRUCTURE v9.0
//
// Main objective:
//   LOCATION  -> Structural S/R boxes + established market levels + Volume Profile edges
//   VALUE     -> Session Volume Profile (VAH / POC / VAL)
//   REACTION  -> Price action at meaningful structure
//   LIQUIDITY -> Forming + confirmed chart-TF swings tied directly to chart-TF S/R structure
//   CONTROL   -> S/R-backed swing defense / sweep / break + market-structure confirmation
//   ENTRY     -> BUY/SELL only when a chart-TF Swing L/H and its S/R reaction exist together
//   TARGET    -> Next meaningful S/R / profile location
//
// Design rules:
//   • OTE / Parent fib / Child fib / fib projections are completely removed.
//   • S/R boxes remain the clearest location map, but they are NOT the only valid location.
//   • Established levels such as PDH/PDL, PWH/PWL, previous 4H H/L and completed session H/L
//     may start a setup when actual price action defends/reclaims them. These levels are two-way:
//     a prior high can become support after acceptance above, and a prior low can become resistance below.
//   • One previous still-valid 15M+ S/R box per timeframe may remain faded as market memory.
//   • Session Volume Profile is promoted from label-only confluence to AUCTION LOCATION:
//     VAH / VAL may start a setup only when directional price action confirms; POC remains context only.
//   • Overnight VAH/VAL are established at NY open. Developing NY VAH/VAL must mature for the configured
//     number of minutes before they are allowed to start an entry setup.
//   • The profile uses lower-timeframe intrabars and builds a deterministic bar-volume-by-price approximation.
//     It is not TradingView's proprietary tick-level built-in Volume Profile.
//   • Price touching any box, key level or profile edge is never enough. Direction must be proven by
//     rejection/reclaim/defense. A forming chart-TF S/R swing may provide the early entry; MSS confirms control or serves as fallback.
//   • Chart-timeframe swings are subordinate to chart-timeframe S/R. There is no independent liquidity-pivot clock.
//   • A FORMING Swing L/H may appear before the normal confirmed pivot box from the same chart-timeframe
//     local-extreme / rejection process that can create S/R. HTF / VP context can strengthen the setup but is
//     optional for chart-TF execution by default. No signal or visual is backpainted onto an earlier candle.
//   • Forming Support/Swing L uses the same wick/body + ATR geometry as the S/R engine. Forming Resistance/Swing H
//     uses the exact inverse geometry. If a newer extreme forms before confirmation, the candidate follows that new
//     live extreme instead of pretending the old one was already confirmed.
//   • BUY/SELL is allowed ONLY when a live or newly confirmed chart-TF Swing L/H is present.
//   • The live Swing area and BUY/SELL signal are born from the SAME event. No standalone S/R, MSS, or retest entry labels.
//   • When the exact candidate later confirms as the official chart-TF S/R pivot, the forming visual is replaced by
//     the normal confirmed S/R-backed SWING L/H. No duplicate entry is printed.
//   • If the active support thesis closes below its outer edge, or active resistance closes above its outer edge,
//     the signal is invalidated and the associated forming/confirmed structure is no longer a valid trade thesis.
//   • Entry hierarchy: (1) live Swing L/H + S/R rejection = instant BUY/SELL;
//     (2) newly confirmed S/R-backed Swing L/H = fallback BUY/SELL only if the live signal did not fire.
//     MSS and retests remain context/confirmation only and never print a separate BUY/SELL.
//   • Signals may optionally align to the CURRENT CHART timeframe S/R bias only. HTF bias, AMD, FVG/IFVG and OTE do not gate entries.
//   • Adaptive timeframe architecture: execution authority is ALWAYS the current chart TF. 1M uses 1M S/R+Swing,
//     5M uses 5M, 10M uses 10M, 15M uses 15M, 1H uses 1H, etc. Higher-TF S/R is context only.
//   • BUY/SELL signals are never imported from another timeframe; switching charts rebuilds the execution engine on that chart TF.
//   • Entry labels are lifecycle-linked to their chart-TF S/R thesis and may disappear when that exact structure invalidates or is replaced.
//──────────────────────────────────────────────────────────────────────────────

// ───── 1. Price Action / Reaction
groupReaction = "1. Price Action / Reaction"
confirmOnClose = input.bool(true, "Confirm Reactions on Candle Close", group=groupReaction,
     tooltip="Recommended. Rejection, reclaim, structure shift and entry logic wait for a confirmed close.")
atrLength = input.int(14, "ATR Length", minval=1, group=groupReaction)
microLength = input.int(2, "Microstructure Length", minval=1, maxval=10, group=groupReaction)
rejectionWickBody = input.float(1.20, "Rejection Wick ÷ Body", minval=0.25, maxval=5.00, step=0.05, group=groupReaction)
strongCloseLocation = input.float(0.65, "Strong Close Location", minval=0.50, maxval=0.95, step=0.01, group=groupReaction)
displacementATR = input.float(0.80, "Displacement Range × ATR", minval=0.25, maxval=3.00, step=0.05, group=groupReaction)
displacementBodyPct = input.float(0.60, "Displacement Body ÷ Range", minval=0.30, maxval=0.95, step=0.01, group=groupReaction)
useRelativeVolumeConcept = input.bool(false, "Allow Relative-Volume Reaction Concept", group=groupReaction,
     tooltip="OFF is recommended. Price rejection, reclaim, displacement and structure remain primary.")
relativeVolumeLength = input.int(20, "Relative-Volume Average Length", minval=2, group=groupReaction)
relativeVolumeMultiple = input.float(1.20, "High Volume Multiple", minval=1.00, maxval=5.00, step=0.05, group=groupReaction)

// ───── 2. Pivots & Key Levels
groupLevels = "2. Pivots & Key Levels"
showCentralPivot = input.bool(false, "Central Pivot (CP)", group=groupLevels)
showCamarillaH3L3 = input.bool(false, "Camarilla H3 / L3", group=groupLevels)
showCamarillaH4L4 = input.bool(true, "Camarilla H4 / L4", group=groupLevels)
showPreviousDay = input.bool(true, "Previous Day High / Low", group=groupLevels)
showPreviousWeek = input.bool(true, "Previous Week High / Low", group=groupLevels)
showPreviousMonth = input.bool(false, "Previous Month High / Low", group=groupLevels)
showDailyOpen = input.bool(false, "Daily Open", inline="op1", group=groupLevels)
showPreviousDayMid = input.bool(false, "Previous Day Mid", inline="op1", group=groupLevels)
showWeeklyOpen = input.bool(false, "Weekly Open", inline="op2", group=groupLevels)
showPreviousWeekMid = input.bool(false, "Previous Week Mid", inline="op2", group=groupLevels)
showMonthlyOpen = input.bool(false, "Monthly Open", inline="op3", group=groupLevels)
showPreviousMonthMid = input.bool(false, "Previous Month Mid", inline="op3", group=groupLevels)
showPrevious4HLevels = input.bool(true, "Previous 4H High / Low", inline="h4", group=groupLevels)
showCurrent4HOpen = input.bool(false, "4H Open", inline="h4", group=groupLevels)
showPrevious4HMid = input.bool(false, "Previous 4H Mid", group=groupLevels)
showMondayLevels = input.bool(false, "Monday High / Low / Mid", group=groupLevels)
showQuarterLevels = input.bool(false, "Previous Quarter High / Low", inline="q", group=groupLevels)
showQuarterOpenMid = input.bool(false, "Quarter Open / Mid", inline="q", group=groupLevels)
showYearLevels = input.bool(false, "Current Year High / Low", inline="y", group=groupLevels)
showYearOpenMid = input.bool(false, "Year Open / Mid", inline="y", group=groupLevels)
showAsia = input.bool(true, "Completed Asia High / Low", group=groupLevels)
showLondon = input.bool(true, "Completed London High / Low", group=groupLevels)
showNewYork = input.bool(true, "Completed New York High / Low", group=groupLevels)
showSessionOpens = input.bool(false, "Asia / London / New York Opens", group=groupLevels)
show1800ETOpen = input.bool(false, "18:00 ET Open", inline="eto", group=groupLevels)
showMidnightETOpen = input.bool(false, "Midnight ET", inline="eto", group=groupLevels)
show1000ETOpen = input.bool(false, "10:00 ET", inline="eto", group=groupLevels)
showOvernight = input.bool(true, "Completed Overnight High / Low", group=groupLevels)
showLevelLabels = input.bool(true, "Show Small Level Labels", group=groupLevels)

// ───── 3. Sessions
groupSessions = "3. Sessions"
sessionTimeZone = input.string("America/Chicago", "Session Time Zone", group=groupSessions)
asiaSession = input.session("1800-0000", "Asia Session", group=groupSessions)
londonSession = input.session("0200-0500", "London Session", group=groupSessions)
newYorkSession = input.session("0830-1500", "New York Session", group=groupSessions)
overnightSession = input.session("1800-0830", "Overnight / Globex Profile", group=groupSessions)
autoBlockSessionLevels = input.bool(true, "Auto-Block Irrelevant Session Levels", group=groupSessions)
useSessionLevelFreshness = input.bool(true, "Retire Repeatedly Crossed Session Levels", group=groupSessions)
maximumSessionLevelCrosses = input.int(2, "Maximum Session-Level Close Crosses", minval=1, maxval=6, group=groupSessions)

// ───── 4. Structural S/R
groupSR = "4. Structural S/R"
srPivotStrength = input.int(3, "Confirmed Pivot Strength", minval=1, maxval=10, group=groupSR)
srATRLength = input.int(14, "Zone ATR Length", minval=1, group=groupSR)
srMinimumPaddingATR = input.float(0.10, "Minimum Zone Width × ATR", minval=0.01, maxval=1.00, step=0.01, group=groupSR)
showZoneVolume = input.bool(false, "Show Interaction Volume in S/R Boxes", group=groupSR)
showZoneLabels = input.bool(true, "Show Timeframe + Zone Type", group=groupSR)
zoneLabelSize = input.string("Normal", "Zone Label Size", options=["Small", "Normal", "Large"], group=groupSR)
zoneLabelTextColor = input.color(color.black, "Zone Label Text Color", group=groupSR)
zoneLabelTwoLines = input.bool(true, "Stack Timeframe Above Zone Type", group=groupSR)
zoneBorderWidth = input.int(2, "Zone Border Width", minval=1, maxval=4, group=groupSR)
showOnlyChartAndHigherTFBoxes = input.bool(true, "Show Chart + Higher-Timeframe Boxes Only", group=groupSR)

showChartSR = input.bool(true, "Chart Timeframe Zone", group=groupSR)
show5mSR = input.bool(true, "5-Minute Zone", inline="sr1", group=groupSR)
show15mSR = input.bool(true, "15-Minute", inline="sr1", group=groupSR)
show1hSR = input.bool(true, "1-Hour", inline="sr2", group=groupSR)
show2hSR = input.bool(true, "2-Hour", inline="sr2", group=groupSR)
show4hSR = input.bool(true, "4-Hour", inline="sr3", group=groupSR)
show8hSR = input.bool(true, "8-Hour", inline="sr3", group=groupSR)
showDailySR = input.bool(true, "Daily", inline="sr4", group=groupSR)
showWeeklySR = input.bool(true, "Weekly", inline="sr4", group=groupSR)
showPreviousHTFMemory = input.bool(true, "Show Previous 15M+ S/R Memory", group=groupSR,
     tooltip="Keeps one immediately previous still-valid 15M+ zone per timeframe as a faded structural reference.")
showPreviousHTFResistance = input.bool(true, "Previous Resistance", inline="mem", group=groupSR)
showPreviousHTFSupport = input.bool(true, "Previous Support", inline="mem", group=groupSR)
previousHTFMemoryTransparency = input.int(94, "Previous HTF Box Fade", minval=85, maxval=99, group=groupSR)

// ───── 5. Session Volume Profile
groupVP = "5. Session Volume Profile"
showSessionVolumeProfile = input.bool(true, "Show Session Volume Profile", group=groupVP)
profileRows = input.int(24, "Profile Rows", minval=12, maxval=60, group=groupVP,
     tooltip="24 is a clean starting point. More rows increase detail and calculation load.")
profileValueAreaPercent = input.float(70.0, "Value Area %", minval=50.0, maxval=90.0, step=1.0, group=groupVP)
showOvernightVP = input.bool(true, "Overnight VAH / POC / VAL", inline="vp1", group=groupVP)
showNewYorkVP = input.bool(true, "NY Developing VAH / POC / VAL", inline="vp1", group=groupVP)
showProfileHistogram = input.bool(true, "Show Compact Profile Histograms", group=groupVP)
profileHistogramWidth = input.int(10, "Histogram Max Width (bars)", minval=4, maxval=25, group=groupVP)
profileHistogramOffset = input.int(4, "Histogram Offset Right (bars)", minval=1, maxval=30, group=groupVP)
profileLevelToleranceATR = input.float(0.12, "Profile-Level Confluence × ATR", minval=0.02, maxval=1.00, step=0.01, group=groupVP)
profileUseForEntryConfluence = input.bool(true, "Add VAH / POC / VAL to Entry Labels", group=groupVP,
     tooltip="Adds the nearest profile reference to labels. VAH/VAL may also define auction location when the setting below is enabled; POC never starts a setup by itself.")
profileEdgesCanDefineLocation = input.bool(true, "Allow VAH / VAL as Auction Location", group=groupVP,
     tooltip="Recommended. Overnight VAH/VAL and mature NY VAH/VAL may start a setup only when price action rejects/reclaims the edge and market structure confirms. POC remains context only.")
nyProfileLocationMinMinutes = input.int(15, "NY Profile Maturity Before Location (minutes)", minval=5, maxval=60, group=groupVP,
     tooltip="Developing NY VAH/VAL are not allowed to start a setup until this many minutes after the NY session begins. Overnight profile edges are already established at the open.")

// ───── 6. Chart-TF Dynamic S/R Swing Areas
groupSwings = "6. Chart-TF Dynamic S/R Swing Areas"
showSwingAreas = input.bool(true, "Show Confirmed Chart-TF S/R Swings", group=groupSwings,
     tooltip="SWING L/H is tied directly to the same confirmed chart-timeframe pivot that creates the chart-TF Support/Resistance box.")
showFormingSRSwing = input.bool(true, "Show Live Signal-Backed Swing Area", group=groupSwings,
     tooltip="Recommended. The live Swing L/H area appears when the same event is eligible to print BUY/SELL. It is tied to the chart-timeframe S/R origin and never backpaints.")
signalOnFormingSRSwing = input.bool(true, "Enable Instant Swing BUY / SELL", group=groupSwings,
     tooltip="Recommended. BUY requires a live Swing L plus bullish chart-TF S/R rejection. SELL requires a live Swing H plus bearish chart-TF S/R rejection. The Swing area and signal appear from the same event.")
instantSwingMaxBars = input.int(1, "Bars Allowed From Extreme to Instant Swing", minval=0, maxval=3, group=groupSwings,
     tooltip="0 = same bar only. 1 = the extreme bar or the very next chart bar. Recommended: 1 for 1M/5M so the swing is fast without treating older pivots as fresh entries.")
swingAreaStyle = input.string("Wick Zone", "Swing Area", options=["Wick Zone", "S/R Zone"], group=groupSwings,
     tooltip="Wick Zone highlights the swing wick inside the forming/confirmed S/R geometry. S/R Zone mirrors the full chart-timeframe S/R zone.")
swingAreaExtendBars = input.int(3, "Active Area Extension (bars)", minval=0, maxval=10, group=groupSwings)
showSwingAreaLabels = input.bool(true, "Show SWING H / SWING L Labels", group=groupSwings)
showSwingStateLabels = input.bool(true, "Show SWEEP / BREAK Labels", group=groupSwings)
swingActiveTransparency = input.int(88, "Confirmed Swing Area Fade", minval=75, maxval=96, group=groupSwings)
formingSwingTransparency = input.int(92, "Forming Swing Area Fade", minval=82, maxval=98, group=groupSwings)
useSwingAreasForMS = input.bool(true, "Use S/R Swings for Market-Structure Break", group=groupSwings,
     tooltip="Recommended. The active opposing confirmed chart-TF S/R-backed swing becomes the structure level for MSS. If none exists, EZ$ falls back to its smaller pivot structure.")
signalOnSRSwingConfirm = input.bool(true, "Fallback Signal on Newly Confirmed S/R Swing", group=groupSwings,
     tooltip="If the instant Swing signal did not fire, the exact bar where chart-TF Support+Swing L or Resistance+Swing H confirms may print BUY/SELL. No later MSS/retest entry is generated.")

// ───── 7. S/R + Price Action Entry Engine
groupEntry = "7. S/R + Price Action Entry Engine"
showEntryEngine = input.bool(true, "Enable Structure Entry Engine", group=groupEntry)
requireMeaningfulLocation = input.bool(true, "Require Meaningful Structural / Auction Location", group=groupEntry,
     tooltip="Recommended. A setup must begin at an HTF S/R box, faded HTF memory, enabled major key/session level, or qualified VAH/VAL. Turn OFF only if you want chart-timeframe S/R alone to start setups.")
includePreviousHTFMemoryForSetups = input.bool(true, "Allow Faded Previous HTF S/R as Location", group=groupEntry,
     tooltip="The previous zone can be a valid location only if price action actually defends/rejects it.")
useMajorKeyLevelsForLocation = input.bool(true, "Allow Major Key / Session Levels as Location", group=groupEntry,
     tooltip="Recommended. Enabled PDH/PDL, PWH/PWL, previous 4H H/L, prior month H/L and completed Asia/London/NY/Overnight H/L can start a setup after directional price action. These levels are two-way after acceptance/retest.")
majorLevelToleranceATR = input.float(0.10, "Major-Level Reaction Tolerance × ATR", minval=0.02, maxval=0.50, step=0.01, group=groupEntry)
structurePivotStrength = input.int(2, "Fallback Market-Structure Pivot Strength", minval=1, maxval=8, group=groupEntry,
     tooltip="Used only when no active Liquidity Swing Area is available for the opposing structure break.")
structureConfirmWindow = input.int(12, "Bars Allowed: Reaction → Structure Shift", minval=2, maxval=50, group=groupEntry)
retestWindow = input.int(20, "Bars Allowed: Shift → S/R Retest", minval=2, maxval=100, group=groupEntry)
requireExpansionOnShift = input.bool(true, "Require Expansion on Structure Shift", group=groupEntry)
showReadyLabels = input.bool(false, "Show MSS READY Context Labels", group=groupEntry)
showEntryLabels = input.bool(true, "Show BUY / SELL Swing Labels", group=groupEntry)
showHigherTFContextOnSignal = input.bool(true, "Add Nearest Higher-TF S/R to Signal Label", group=groupEntry,
     tooltip="Recommended. Keeps the BUY/SELL authority on the current chart timeframe, but appends the nearest active higher-timeframe S/R confluence (for example 5M+, 15M+, 1H+) when price is reacting there. It never creates a signal by itself.")
showMSSMarkers = input.bool(true, "Show MSS Confirmation Markers", group=groupEntry,
     tooltip="MSS is confirmation/context only in v9.0 and never prints a BUY/SELL signal.")
bool signalOnStructureShift = false
bool showRetestSecondChance = false
chartSREntryTiming = input.string("Live + Close", "Chart-TF S/R Signal Timing", options=["Live + Close", "Close Only"], group=groupEntry,
     tooltip="Live + Close is recommended for 1M/5M execution. A forming S/R signal may appear intrabar as price rejects the live structure; it is provisional until the candle closes. Close Only waits for bar confirmation. S/R invalidation still requires a confirmed close.")
requireContextForChartSREntry = input.bool(false, "Require HTF / VP Context for Chart-TF S/R Signal", group=groupEntry,
     tooltip="OFF recommended for the simplified S/R model. The chart-timeframe S/R + price-action reaction can create the entry by itself; HTF S/R, key levels and VAH/VAL are added as confluence. Turn ON for stricter filtering.")
allowOppositeChartSREntry = input.bool(true, "Allow Opposite Chart-TF S/R Signal", group=groupEntry,
     tooltip="Recommended. A valid new chart-TF resistance can print SHORT even while an earlier support remains structurally valid, and vice versa. The newest opposite S/R signal becomes the active execution thesis; each box still invalidates only on a confirmed close through its outer edge.")
useChartTFBiasForSignals = input.bool(true, "Align Signals With Current Chart S/R Bias", group=groupEntry,
     tooltip="Recommended. 1M signals use 1M S/R bias, 5M signals use 5M S/R bias, 15M signals use 15M S/R bias. Bias is structural, not EMA/HTF bias: the newest forming/confirmed chart-TF Support or Resistance controls execution direction.")
removeInvalidatedSignalLabels = input.bool(true, "Remove Signal When Its Chart S/R Disappears", group=groupEntry,
     tooltip="Recommended for a clean live chart. BUY/SELL labels are deleted when their own chart-TF S/R closes through its invalidation edge, is replaced by newer same-side chart structure, or a live swing never becomes the matching confirmed S/R pivot. Alerts that already fired cannot be recalled.")
allowSROriginEntry = signalOnFormingSRSwing
showOriginInvalidationLabels = input.bool(false, "Show EXIT When Active Chart S/R Invalidates", group=groupEntry,
     tooltip="Optional audit marker. OFF keeps the chart behaving like S/R: when structure invalidates, its signal label disappears too. Alerts still report invalidation.")
entryCooldownBars = input.int(5, "Minimum Bars Between Same-Direction Swing Signals", minval=0, maxval=100, group=groupEntry,
     tooltip="Prevents repeated BUY/SELL labels from nearby same-direction swing attempts. Only Swing-backed signals use this cooldown.")
showStructureDashboard = input.bool(true, "Show Structure / Profile Dashboard", group=groupEntry)

// ───── Core measurements
inAsiaSession = not na(time(timeframe.period, asiaSession, sessionTimeZone))
inLondonSession = not na(time(timeframe.period, londonSession, sessionTimeZone))
inNewYorkSession = not na(time(timeframe.period, newYorkSession, sessionTimeZone))
inOvernightSession = not na(time(timeframe.period, overnightSession, sessionTimeZone))

activeSessionName = inNewYorkSession ? "NEW YORK" : inLondonSession ? "LONDON" : inAsiaSession ? "ASIA" : inOvernightSession ? "OVERNIGHT" : "OFF SESSION"

atr = ta.atr(atrLength)
candleRange = math.max(high - low, syminfo.mintick)
bodySize = math.abs(close - open)
bodyPct = bodySize / candleRange
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
closeLocation = (close - low) / candleRange

bullRejectCandle = close > open and lowerWick >= bodySize * rejectionWickBody and closeLocation >= strongCloseLocation
bearRejectCandle = close < open and upperWick >= bodySize * rejectionWickBody and closeLocation <= 1.0 - strongCloseLocation
bullDisplacement = close > open and candleRange >= atr * displacementATR and bodyPct >= displacementBodyPct
bearDisplacement = close < open and candleRange >= atr * displacementATR and bodyPct >= displacementBodyPct
bullMicroShift = close > ta.highest(high[1], microLength)
bearMicroShift = close < ta.lowest(low[1], microLength)

volumeAverage = ta.sma(volume, relativeVolumeLength)
highRelativeVolume = useRelativeVolumeConcept and not na(volumeAverage) and volume >= volumeAverage * relativeVolumeMultiple
bullVolumeReaction = highRelativeVolume and close > open and closeLocation >= strongCloseLocation
bearVolumeReaction = highRelativeVolume and close < open and closeLocation <= 1.0 - strongCloseLocation

bullReactionCandle = bullRejectCandle or bullDisplacement or bullMicroShift or bullVolumeReaction
bearReactionCandle = bearRejectCandle or bearDisplacement or bearMicroShift or bearVolumeReaction


// ───── Previous-day Camarilla and central pivot
[pdHigh, pdLow, pdClose] = request.security(syminfo.tickerid, "1D",
     [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)

previousDayRange = pdHigh - pdLow
centralPivot = (pdHigh + pdLow + pdClose) / 3.0
camarillaH3 = pdClose + previousDayRange * 1.1 / 4.0
camarillaL3 = pdClose - previousDayRange * 1.1 / 4.0
camarillaH4 = pdClose + previousDayRange * 1.1 / 2.0
camarillaL4 = pdClose - previousDayRange * 1.1 / 2.0

[pwHigh, pwLow, weeklyOpen] = request.security(syminfo.tickerid, "1W",
     [high[1], low[1], open], lookahead=barmerge.lookahead_on)
[pmHigh, pmLow, monthlyOpen] = request.security(syminfo.tickerid, "1M",
     [high[1], low[1], open], lookahead=barmerge.lookahead_on)

dailyOpen = request.security(syminfo.tickerid, "1D", open, lookahead=barmerge.lookahead_on)
previousDayMid = (pdHigh + pdLow) / 2.0
previousWeekMid = (pwHigh + pwLow) / 2.0
previousMonthMid = (pmHigh + pmLow) / 2.0

[pqHigh, pqLow, quarterOpen] = request.security(syminfo.tickerid, "3M",
     [high[1], low[1], open], lookahead=barmerge.lookahead_on)
previousQuarterMid = (pqHigh + pqLow) / 2.0

[currentYearHigh, currentYearLow, yearlyOpen] = request.security(syminfo.tickerid, "12M",
     [high, low, open], lookahead=barmerge.lookahead_off)
currentYearMid = (currentYearHigh + currentYearLow) / 2.0

[previous4HHigh, previous4HLow, current4HOpen] = request.security(syminfo.tickerid, "240",
     [high[1], low[1], open], lookahead=barmerge.lookahead_on)
previous4HMid = (previous4HHigh + previous4HLow) / 2.0

[dailyDayOfWeek, currentDailyHigh, currentDailyLow] = request.security(syminfo.tickerid, "1D",
     [dayofweek, high, low], lookahead=barmerge.lookahead_off)
var float mondayHigh = na
var float mondayLow = na
bool newTradingWeek = ta.change(time("1W")) != 0
if newTradingWeek
    mondayHigh := na
    mondayLow := na
if dailyDayOfWeek == dayofweek.monday
    mondayHigh := currentDailyHigh
    mondayLow := currentDailyLow
mondayMid = not na(mondayHigh) and not na(mondayLow) ? (mondayHigh + mondayLow) / 2.0 : na

// ───── Completed session helpers
f_previous_session(string sessionInput) =>
    bool inSession = not na(time(timeframe.period, sessionInput, sessionTimeZone))
    var float activeHigh = na
    var float activeLow = na
    var float completedHigh = na
    var float completedLow = na

    if inSession and not inSession[1]
        activeHigh := high
        activeLow := low
    else if inSession
        activeHigh := math.max(nz(activeHigh, high), high)
        activeLow := math.min(nz(activeLow, low), low)

    if not inSession and inSession[1]
        completedHigh := activeHigh
        completedLow := activeLow

    [completedHigh, completedLow]

f_latest_session_open(string sessionInput) =>
    bool inSession = not na(time(timeframe.period, sessionInput, sessionTimeZone))
    var float latestOpen = na
    if inSession and not inSession[1]
        latestOpen := open
    latestOpen

[asiaHigh, asiaLow] = f_previous_session(asiaSession)
[londonHigh, londonLow] = f_previous_session(londonSession)
[newYorkHigh, newYorkLow] = f_previous_session(newYorkSession)
[overnightHigh, overnightLow] = f_previous_session(overnightSession)
asiaOpen = f_latest_session_open(asiaSession)
londonOpen = f_latest_session_open(londonSession)
newYorkOpen = f_latest_session_open(newYorkSession)

f_latest_clock_open(int targetHour, int targetMinute, string targetTimeZone) =>
    bool isTargetBar = hour(time, targetTimeZone) == targetHour and minute(time, targetTimeZone) == targetMinute
    var float latestOpen = na
    var int latestTime = na
    if isTargetBar
        latestOpen := open
        latestTime := time
    [latestOpen, latestTime]

