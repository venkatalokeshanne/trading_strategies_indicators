                        line.delete(outerGlowRay)
                        array.set(fanOuterGlowLines, lineIndex, na)
                    if not na(middleGlowRay)
                        line.delete(middleGlowRay)
                        array.set(fanMiddleGlowLines, lineIndex, na)

            int createdFillCount = 0
            int previousVisibleLevel = na
            float previousVisibleRatio = na
            if fanFillInput != FILL_OFF
                for orderIndex = 0 to LEVEL_COUNT - 1
                    int levelIndex = array.get(sortedLevelIndices, orderIndex)
                    if array.get(levelVisible, levelIndex)
                        float ratio = array.get(levelRatios, levelIndex)
                        if not na(previousVisibleLevel) and ratio != previousVisibleRatio
                            line firstRay = array.get(fanLines, lineBaseIndex + previousVisibleLevel)
                            line secondRay = array.get(fanLines, lineBaseIndex + levelIndex)
                            if not na(firstRay) and not na(secondRay)
                                int fillIndex = fillBaseIndex + createdFillCount
                                linefill bandFill = array.get(fanFills, fillIndex)
                                color firstBaseColor = colorSchemeInput == SCHEME_CUSTOM ? array.get(customLevelColors, previousVisibleLevel) : schemeColor(colorSchemeInput, previousVisibleLevel)
                                color secondBaseColor = colorSchemeInput == SCHEME_CUSTOM ? array.get(customLevelColors, levelIndex) : schemeColor(colorSchemeInput, levelIndex)
                                color middleBaseColor = colorSchemeInput == SCHEME_CUSTOM ? array.get(customLevelColors, 2) : schemeColor(colorSchemeInput, 2)
                                color bandBaseColor = fanFillInput == FILL_SOLID ? middleBaseColor : blendColors(firstBaseColor, secondBaseColor)
                                bool currentFanBand = queueHasCurrent and fanIndex == visibleFanCount - 1
                                bool spotlightBand = currentFanBand and previousVisibleLevel == spotlightFirstLevel and levelIndex == spotlightSecondLevel
                                int gradientTargetTime = fanDisplayEndTime
                                float firstBandPrice = projectedPrice(originPrice, originTime, levelPrice(originPrice, endPrice, previousVisibleRatio), endTime, gradientTargetTime)
                                float secondBandPrice = projectedPrice(originPrice, originTime, levelPrice(originPrice, endPrice, ratio), endTime, gradientTargetTime)
                                float spacingDepth = fanFillInput == FILL_GRADIENT ? gradientDepth(math.abs(firstBandPrice - secondBandPrice), nz(chartVisualAtr, syminfo.mintick * 2.0)) : 1.0
                                float graduatedOpacity = fillOpacityInput * spacingDepth
                                float bandOpacity = spotlightBand ? math.min(60.0, graduatedOpacity * 1.75) : graduatedOpacity
                                color bandColor = fadeColor(bandBaseColor, bandOpacity * ageOpacity / 100.0)
                                if na(bandFill)
                                    bandFill := linefill.new(firstRay, secondRay, bandColor)
                                    array.set(fanFills, fillIndex, bandFill)
                                else
                                    linefill.set_color(bandFill, bandColor)
                                createdFillCount += 1
                        previousVisibleLevel := levelIndex
                        previousVisibleRatio := ratio

            if createdFillCount < MAX_FILL_BANDS
                for fillOffset = createdFillCount to MAX_FILL_BANDS - 1
                    int fillIndex = fillBaseIndex + fillOffset
                    linefill bandFill = array.get(fanFills, fillIndex)
                    if not na(bandFill)
                        linefill.delete(bandFill)
                        array.set(fanFills, fillIndex, na)

            line baseline = array.get(baselineLines, fanIndex)
            if showBaselineInput
                color fadedBaselineColor = fadeColor(baselineColorInput, ageOpacity)
                if na(baseline)
                    baseline := line.new(
                        x1 = originTime,
                        y1 = originPrice,
                        x2 = endTime,
                        y2 = endPrice,
                        xloc = xloc.bar_time,
                        extend = extend.none,
                        color = fadedBaselineColor,
                        style = line.style_dashed,
                        width = 1
                    )
                    array.set(baselineLines, fanIndex, baseline)
                else
                    line.set_xy1(baseline, originTime, originPrice)
                    line.set_xy2(baseline, endTime, endPrice)
                    line.set_extend(baseline, extend.none)
                    line.set_color(baseline, fadedBaselineColor)
            else if not na(baseline)
                line.delete(baseline)
                array.set(baselineLines, fanIndex, na)
        else
            for fillOffset = 0 to MAX_FILL_BANDS - 1
                int fillIndex = fillBaseIndex + fillOffset
                linefill bandFill = array.get(fanFills, fillIndex)
                if not na(bandFill)
                    linefill.delete(bandFill)
                    array.set(fanFills, fillIndex, na)
            for levelIndex = 0 to LEVEL_COUNT - 1
                int lineIndex = lineBaseIndex + levelIndex
                line ray = array.get(fanLines, lineIndex)
                if not na(ray)
                    line.delete(ray)
                    array.set(fanLines, lineIndex, na)
                line outerGlowRay = array.get(fanOuterGlowLines, lineIndex)
                if not na(outerGlowRay)
                    line.delete(outerGlowRay)
                    array.set(fanOuterGlowLines, lineIndex, na)
                line middleGlowRay = array.get(fanMiddleGlowLines, lineIndex)
                if not na(middleGlowRay)
                    line.delete(middleGlowRay)
                    array.set(fanMiddleGlowLines, lineIndex, na)
            line baseline = array.get(baselineLines, fanIndex)
            if not na(baseline)
                line.delete(baseline)
                array.set(baselineLines, fanIndex, na)

    bool goldenPocketDrawable = showGoldenPocketInput and sourceSelectionValid and queueHasCurrent and visibleFanCount > 0
    if goldenPocketDrawable
        int currentFanIndex = visibleFanCount - 1
        float currentOriginPrice = array.get(fanOriginPrices, currentFanIndex)
        int currentOriginTime = array.get(fanOriginTimes, currentFanIndex)
        float currentEndPrice = array.get(fanEndPrices, currentFanIndex)
        int currentEndTime = array.get(fanEndTimes, currentFanIndex)
        goldenPocketDrawable := not na(currentOriginPrice) and not na(currentOriginTime) and not na(currentEndPrice) and not na(currentEndTime) and currentOriginTime != currentEndTime and currentOriginPrice != currentEndPrice
        if goldenPocketDrawable
            int pocketEndTime = time
            float pocket618EndPrice = projectedPrice(currentOriginPrice, currentOriginTime, levelPrice(currentOriginPrice, currentEndPrice, GOLDEN_POCKET_RATIO_618), currentEndTime, pocketEndTime)
            float pocket650EndPrice = projectedPrice(currentOriginPrice, currentOriginTime, levelPrice(currentOriginPrice, currentEndPrice, GOLDEN_POCKET_RATIO_650), currentEndTime, pocketEndTime)
            bool infiniteProjection = rayProjectionInput == PROJECTION_INFINITE
            color transparentPocketColor = color.new(GOLDEN_POCKET_COLOR, 100)
            color pocketFillColor = fadeColor(GOLDEN_POCKET_COLOR, GOLDEN_POCKET_OPACITY)
            if na(goldenPocket618Line)
                goldenPocket618Line := line.new(
                    x1 = currentOriginTime,
                    y1 = currentOriginPrice,
                    x2 = pocketEndTime,
                    y2 = pocket618EndPrice,
                    xloc = xloc.bar_time,
                    extend = infiniteProjection ? extend.right : extend.none,
                    color = transparentPocketColor,
                    style = line.style_solid,
                    width = 1
                )
            else
                line.set_xy1(goldenPocket618Line, currentOriginTime, currentOriginPrice)
                line.set_xy2(goldenPocket618Line, pocketEndTime, pocket618EndPrice)
                line.set_extend(goldenPocket618Line, infiniteProjection ? extend.right : extend.none)
                line.set_color(goldenPocket618Line, transparentPocketColor)
                line.set_style(goldenPocket618Line, line.style_solid)
                line.set_width(goldenPocket618Line, 1)
            if na(goldenPocket650Line)
                goldenPocket650Line := line.new(
                    x1 = currentOriginTime,
                    y1 = currentOriginPrice,
                    x2 = pocketEndTime,
                    y2 = pocket650EndPrice,
                    xloc = xloc.bar_time,
                    extend = infiniteProjection ? extend.right : extend.none,
                    color = transparentPocketColor,
                    style = line.style_solid,
                    width = 1
                )
            else
                line.set_xy1(goldenPocket650Line, currentOriginTime, currentOriginPrice)
                line.set_xy2(goldenPocket650Line, pocketEndTime, pocket650EndPrice)
                line.set_extend(goldenPocket650Line, infiniteProjection ? extend.right : extend.none)
                line.set_color(goldenPocket650Line, transparentPocketColor)
                line.set_style(goldenPocket650Line, line.style_solid)
                line.set_width(goldenPocket650Line, 1)
            if na(goldenPocketFill)
                goldenPocketFill := linefill.new(goldenPocket618Line, goldenPocket650Line, pocketFillColor)
            else
                linefill.set_color(goldenPocketFill, pocketFillColor)
    if not goldenPocketDrawable
        if not na(goldenPocketFill)
            linefill.delete(goldenPocketFill)
            goldenPocketFill := na
        if not na(goldenPocket618Line)
            line.delete(goldenPocket618Line)
            goldenPocket618Line := na
        if not na(goldenPocket650Line)
            line.delete(goldenPocket650Line)
            goldenPocket650Line := na

    table.clear(statusTable, 0, 0, 3, 6)
    bool showStatus = showStatusBoardInput or not sourceSelectionValid
    if showStatus
        bool largeBoard = statusBoardSizeInput == BOARD_LARGE
        int ratioColumnWidth = largeBoard ? 4 : 3
        int railColumnWidth = largeBoard ? 10 : 6
        int priceColumnWidth = largeBoard ? 7 : 5
        int stateColumnWidth = largeBoard ? 12 : 8
        int boardRowHeight = largeBoard ? 3 : 2
        string boardTextSize = largeBoard ? size.small : size.tiny
        if not sourceSelectionValid
            setStatusCell(statusTable, 0, 0, "NO FAN", PANEL_WARNING, PANEL_BACKGROUND, ratioColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 1, 0, "────────", PANEL_WARNING, PANEL_BACKGROUND, railColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 2, 0, requestedTimeframe, PANEL_WARNING, PANEL_BACKGROUND, priceColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 3, 0, timeframeWarning, contrastTextColor(PANEL_WARNING), PANEL_WARNING, stateColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 0, 1, "SELECTED", PANEL_MUTED, PANEL_KEY_BACKGROUND, ratioColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 1, 1, "", PANEL_MUTED, PANEL_BACKGROUND, railColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 2, 1, requestedTimeframe, PANEL_TEXT, PANEL_BACKGROUND, priceColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 3, 1, "INVALID", PANEL_WARNING, PANEL_BACKGROUND, stateColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 0, 2, "CHART", PANEL_MUTED, PANEL_KEY_BACKGROUND, ratioColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 1, 2, "", PANEL_MUTED, PANEL_BACKGROUND, railColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 2, 2, timeframe.period, PANEL_TEXT, PANEL_BACKGROUND, priceColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 3, 2, "REQUIRED", PANEL_WARNING, PANEL_BACKGROUND, stateColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 0, 3, "FIX", contrastTextColor(PANEL_WARNING), PANEL_WARNING, ratioColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 1, 3, "", PANEL_WARNING, PANEL_BACKGROUND, railColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 2, 3, timeframeFix, PANEL_WARNING, PANEL_BACKGROUND, priceColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 3, 3, "", PANEL_WARNING, PANEL_BACKGROUND, stateColumnWidth, boardRowHeight, boardTextSize)
            for row = 4 to 5
                setStatusCell(statusTable, 0, row, "", PANEL_MUTED, PANEL_KEY_BACKGROUND, ratioColumnWidth, boardRowHeight, boardTextSize)
                setStatusCell(statusTable, 1, row, "", PANEL_TEXT, PANEL_BACKGROUND, railColumnWidth, boardRowHeight, boardTextSize)
                setStatusCell(statusTable, 2, row, "", PANEL_TEXT, PANEL_BACKGROUND, priceColumnWidth, boardRowHeight, boardTextSize)
                setStatusCell(statusTable, 3, row, "", PANEL_TEXT, PANEL_BACKGROUND, stateColumnWidth, boardRowHeight, boardTextSize)
        else if visibleLevelCount == 0 and not goldenPocketDrawable
            setStatusCell(statusTable, 0, 0, "FIB", PANEL_TEXT, PANEL_KEY_BACKGROUND, ratioColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 1, 0, "────────", PANEL_WARNING, PANEL_BACKGROUND, railColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 2, 0, "NO RAYS", PANEL_WARNING, PANEL_BACKGROUND, priceColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 3, 0, "ALL LEVELS OFF", contrastTextColor(PANEL_WARNING), PANEL_WARNING, stateColumnWidth, boardRowHeight, boardTextSize)
            for row = 1 to 5
                string rowText = row == 1 ? "ENABLE A LEVEL" : ""
                setStatusCell(statusTable, 0, row, row == 1 ? "FIX" : "", PANEL_MUTED, PANEL_KEY_BACKGROUND, ratioColumnWidth, boardRowHeight, boardTextSize)
                setStatusCell(statusTable, 1, row, "", PANEL_TEXT, PANEL_BACKGROUND, railColumnWidth, boardRowHeight, boardTextSize)
                setStatusCell(statusTable, 2, row, "", PANEL_TEXT, PANEL_BACKGROUND, priceColumnWidth, boardRowHeight, boardTextSize)
                setStatusCell(statusTable, 3, row, rowText, row == 1 ? PANEL_WARNING : PANEL_TEXT, PANEL_BACKGROUND, stateColumnWidth, boardRowHeight, boardTextSize)
        else if not queueHasCurrent
            int archivedCount = visibleFanCount
            setStatusCell(statusTable, 0, 0, "FIB", PANEL_TEXT, PANEL_KEY_BACKGROUND, ratioColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 1, 0, "────────", PANEL_WARNING, PANEL_BACKGROUND, railColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 2, 0, "NO CURRENT FAN", PANEL_WARNING, PANEL_BACKGROUND, priceColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 3, 0, "WAITING", contrastTextColor(PANEL_WARNING), PANEL_WARNING, stateColumnWidth, boardRowHeight, boardTextSize)
            for row = 1 to 5
                string waitText = row == 1 ? "ANCHOR OK · " + (useHigherSource ? requestedTimeframe : "CHART") : row == 2 ? selectedState == STATE_WAITING_OPPOSITE ? "NEEDS OPPOSITE PIVOT" : selectedState == STATE_INVALIDATED ? "PRIOR FAN INVALIDATED" : "NEEDS FIRST PIVOT" : row == 3 ? selectedState == STATE_INVALIDATED ? "WAITING: QUALIFIED LEG" : selectedState == STATE_WAITING_OPPOSITE ? "WAITING: QUALIFICATION" : "WAITING: CONFIRMATION" : row == 4 and archivedCount > 0 ? str.tostring(archivedCount) + " ARCHIVED FAN" + (archivedCount == 1 ? "" : "S") + " REMAIN" : ""
                string waitKey = row == 1 ? "SOURCE" : row == 2 ? "CAUSE" : row == 3 ? "NEXT" : row == 4 and archivedCount > 0 ? "HISTORY" : ""
                setStatusCell(statusTable, 0, row, waitKey, PANEL_MUTED, PANEL_KEY_BACKGROUND, ratioColumnWidth, boardRowHeight, boardTextSize)
                setStatusCell(statusTable, 1, row, "", PANEL_TEXT, PANEL_BACKGROUND, railColumnWidth, boardRowHeight, boardTextSize)
                setStatusCell(statusTable, 2, row, "", PANEL_TEXT, PANEL_BACKGROUND, priceColumnWidth, boardRowHeight, boardTextSize)
                setStatusCell(statusTable, 3, row, waitText, row <= 3 ? PANEL_WARNING : PANEL_TEXT, PANEL_BACKGROUND, stateColumnWidth, boardRowHeight, boardTextSize)
        else
            int currentFanIndex = visibleFanCount - 1
            float currentOriginPrice = array.get(fanOriginPrices, currentFanIndex)
            int currentOriginTime = array.get(fanOriginTimes, currentFanIndex)
            float currentEndPrice = array.get(fanEndPrices, currentFanIndex)
            int currentEndTime = array.get(fanEndTimes, currentFanIndex)
            array<float> statusSortValues = array.new_float(LEVEL_COUNT, -1.0e100)
            array<float> statusProjectedPrices = array.new_float(LEVEL_COUNT, na)
            for levelIndex = 0 to LEVEL_COUNT - 1
                if array.get(levelVisible, levelIndex)
                    float ratio = array.get(levelRatios, levelIndex)
                    float constructionPrice = levelPrice(currentOriginPrice, currentEndPrice, ratio)
                    float levelProjectedPrice = projectedPrice(currentOriginPrice, currentOriginTime, constructionPrice, currentEndTime, time)
                    array.set(statusSortValues, levelIndex, levelProjectedPrice)
                    array.set(statusProjectedPrices, levelIndex, levelProjectedPrice)
            array<int> statusLevelOrder = array.sort_indices(statusSortValues, order.descending)
            int levelHeaderRow = goldenPocketDrawable ? 1 : 0
            if goldenPocketDrawable
                string pocketStateText = switch goldenPocketRelationState
                    POCKET_STATE_BELOW => "BELOW ZONE"
                    POCKET_STATE_INSIDE => "IN ZONE"
                    POCKET_STATE_ABOVE => "ABOVE ZONE"
                    => "WAITING"
                color pocketStateBackground = goldenPocketRelationState == POCKET_STATE_WAITING ? PANEL_BACKGROUND : fadeColor(GOLDEN_POCKET_COLOR, 72.0)
                color pocketStateTextColor = goldenPocketRelationState == POCKET_STATE_WAITING ? PANEL_MUTED : contrastTextColor(GOLDEN_POCKET_COLOR)
                setStatusCell(statusTable, 0, 0, "GOLD", contrastTextColor(GOLDEN_POCKET_COLOR), fadeColor(GOLDEN_POCKET_COLOR, 85.0), ratioColumnWidth, boardRowHeight, boardTextSize)
                setStatusCell(statusTable, 1, 0, "████████", GOLDEN_POCKET_COLOR, PANEL_BACKGROUND, railColumnWidth, boardRowHeight, boardTextSize)
                setStatusCell(statusTable, 2, 0, ".618-.650", PANEL_TEXT, PANEL_BACKGROUND, priceColumnWidth, boardRowHeight, boardTextSize)
                setStatusCell(statusTable, 3, 0, pocketStateText, pocketStateTextColor, pocketStateBackground, stateColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 0, levelHeaderRow, "FIB", PANEL_TEXT, PANEL_KEY_BACKGROUND, ratioColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 1, levelHeaderRow, "LEVEL", PANEL_TEXT, PANEL_KEY_BACKGROUND, railColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 2, levelHeaderRow, "PRICE", PANEL_TEXT, PANEL_KEY_BACKGROUND, priceColumnWidth, boardRowHeight, boardTextSize)
            setStatusCell(statusTable, 3, levelHeaderRow, "STATE", PANEL_TEXT, PANEL_KEY_BACKGROUND, stateColumnWidth, boardRowHeight, boardTextSize)
            for row = 1 to LEVEL_COUNT
                int levelIndex = array.get(statusLevelOrder, row - 1)
                int tableRow = row + levelHeaderRow
                bool levelIsVisible = array.get(levelVisible, levelIndex)
                float ratio = array.get(levelRatios, levelIndex)
                float levelProjectedPrice = array.get(statusProjectedPrices, levelIndex)
                color levelBaseColor = colorSchemeInput == SCHEME_CUSTOM ? array.get(customLevelColors, levelIndex) : schemeColor(colorSchemeInput, levelIndex)
                int eventType = array.get(levelInteractionEvents, levelIndex)
                int stableSide = array.get(levelStableSides, levelIndex)
                int eventBar = array.get(levelInteractionBars, levelIndex)
                string ratioText = levelIsVisible ? str.tostring(ratio, "#.###") : str.tostring(ratio, "#.###")
                string railText = levelIsVisible ? "████████" : "········"
                string priceText = levelIsVisible ? str.tostring(levelProjectedPrice, format.mintick) : "—"
                string stateText = levelIsVisible ? interactionEventText(eventType, stableSide, eventBar, confirmedChartBarCount) : "OFF"
                color eventColor = levelIsVisible ? interactionEventColor(eventType, stableSide) : PANEL_MUTED
                color ratioBackground = levelIsVisible ? fadeColor(levelBaseColor, 85.0) : PANEL_KEY_BACKGROUND
                color stateBackground = levelIsVisible ? color.new(eventColor, 18) : PANEL_BACKGROUND
                setStatusCell(statusTable, 0, tableRow, ratioText, levelIsVisible ? contrastTextColor(levelBaseColor) : PANEL_MUTED, ratioBackground, ratioColumnWidth, boardRowHeight, boardTextSize)
                setStatusCell(statusTable, 1, tableRow, railText, levelIsVisible ? levelBaseColor : PANEL_MUTED, PANEL_BACKGROUND, railColumnWidth, boardRowHeight, boardTextSize)
                setStatusCell(statusTable, 2, tableRow, priceText, levelIsVisible ? PANEL_TEXT : PANEL_MUTED, PANEL_BACKGROUND, priceColumnWidth, boardRowHeight, boardTextSize)
                setStatusCell(statusTable, 3, tableRow, stateText, levelIsVisible ? contrastTextColor(eventColor) : PANEL_MUTED, stateBackground, stateColumnWidth, boardRowHeight, boardTextSize)