//@version=5
strategy("EB ICT Gold V5 Pro Premium Sell",
     overlay=true,
     initial_capital=3000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=1,
     pyramiding=0,
     process_orders_on_close=true)

rr = input.float(1.0, "Risk Reward", step=0.1)
liqLookback = input.int(10, "Liquidity Lookback", minval=3)
slLookback = input.int(5, "SL Lookback", minval=3)
signalCooldown = input.int(8, "Signal Cooldown Bars", minval=1)

emaFastLen = input.int(50, "EMA Fast")
emaSlowLen = input.int(200, "EMA Slow")
rsiLen = input.int(14, "RSI Length")
adxLen = input.int(14, "ADX Length")
minAdx = input.float(18, "Min ADX")

entryMode = input.string("Balanced", "Entry Frequency Mode", options=["Strict", "Balanced", "Aggressive"])

useDailyBias = input.bool(false, "Use Daily Bias")
useTrendFilter = input.bool(true, "Use EMA Trend")
useRSIFilter = input.bool(false, "Use RSI Momentum")
useADXFilter = input.bool(false, "Use ADX Filter")
useSession = input.bool(false, "Trade NY Killzone Only")
usePremiumSell = input.bool(true, "Use Premium Sell Above EMA")

showSweeps = input.bool(true, "Show Sweep Labels")
showWait = input.bool(false, "Show WAIT Dots")
showDashboard = input.bool(true, "Show Dashboard")

nyKillzone = input.session("0700-1100", "NY Killzone")

inKillzone = not na(time(timeframe.period, nyKillzone, "America/New_York"))
sessionOK = not useSession or inKillzone

pdh = request.security(syminfo.tickerid, "D", high[1])
pdl = request.security(syminfo.tickerid, "D", low[1])
pdc = request.security(syminfo.tickerid, "D", close[1])
pdMid = (pdh + pdl) / 2

bullBias = pdc > pdMid
bearBias = pdc < pdMid

buyBiasOK = not useDailyBias or bullBias
sellBiasOK = not useDailyBias or bearBias

emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsi = ta.rsi(close, rsiLen)
[plusDI, minusDI, adx] = ta.dmi(adxLen, adxLen)
atr = ta.atr(14)

trendBuy = close > emaFast and emaFast > emaSlow
trendSell = close < emaFast and emaFast < emaSlow

emaSlopeBuy = emaFast > emaFast[3]
emaSlopeSell = emaFast < emaFast[3]

rsiBuy = rsi > 50 and rsi < 75
rsiSell = rsi < 50 and rsi > 25
adxOK = adx >= minAdx

trendBuyOK = not useTrendFilter or trendBuy
trendSellOK = not useTrendFilter or trendSell
rsiBuyOK = not useRSIFilter or rsiBuy
rsiSellOK = not useRSIFilter or rsiSell
adxFilterOK = not useADXFilter or adxOK

sweepATR =
     entryMode == "Strict" ? 0.45 :
     entryMode == "Balanced" ? 0.25 :
     0.10

wickFactor =
     entryMode == "Strict" ? 1.5 :
     entryMode == "Balanced" ? 1.0 :
     0.5

needSlope =
     entryMode == "Strict" ? true :
     entryMode == "Balanced" ? true :
     false

liqHigh = ta.highest(high[1], liqLookback)
liqLow = ta.lowest(low[1], liqLookback)

buySweep = low < liqLow and close > liqLow and (close - low) > atr * sweepATR
sellSweep = high > liqHigh and close < liqHigh and (high - close) > atr * sweepATR

candleBody = math.abs(close - open)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
candleRange = high - low

bullReject =
     close > open and
     lowerWick > candleBody * wickFactor and
     close >= high - (candleRange * 0.40)

bearReject =
     close < open and
     upperWick > candleBody * wickFactor and
     close <= low + (candleRange * 0.40)

buySetupBuilding =
     sessionOK and
     buySweep and
     buyBiasOK and
     trendBuyOK

sellSetupBuilding =
     sessionOK and
     sellSweep and
     sellBiasOK and
     trendSellOK

var int lastBuyBar = na
var int lastSellBar = na

buyCooldownOK = na(lastBuyBar) or (bar_index - lastBuyBar > signalCooldown)
sellCooldownOK = na(lastSellBar) or (bar_index - lastSellBar > signalCooldown)

// ===== MAIN BUY =====
buySignal =
     sessionOK and
     buySweep and
     bullReject and
     buyBiasOK and
     rsiBuyOK and
     adxFilterOK and
     (not needSlope or emaSlopeBuy) and
     buyCooldownOK and
     close > emaFast and
     emaFast > emaSlow and
     barstate.isconfirmed

// ===== SELL PATH 1: TREND SELL BELOW EMA =====
trendSellSignal =
     sessionOK and
     sellSweep and
     bearReject and
     sellBiasOK and
     rsiSellOK and
     adxFilterOK and
     (not needSlope or emaSlopeSell) and
     sellCooldownOK and
     close < emaFast and
     emaFast < emaSlow and
     barstate.isconfirmed

// ===== SELL PATH 2: PREMIUM SELL ABOVE EMA =====
premiumSell =
     usePremiumSell and
     sessionOK and
     sellSweep and
     bearReject and
     close > emaFast and
     close < open and
     emaSlopeSell and
     sellCooldownOK and
     barstate.isconfirmed

sellSignal = trendSellSignal or premiumSell

waitBuy = buySetupBuilding and not buySignal
waitSell = (sellSetupBuilding or premiumSell) and not sellSignal

if buySignal
    lastBuyBar := bar_index

if sellSignal
    lastSellBar := bar_index

buySL = ta.lowest(low, slLookback)
sellSL = ta.highest(high, slLookback)

buyRisk = close - buySL
sellRisk = sellSL - close

buyTP = close + buyRisk * rr
sellTP = close - sellRisk * rr

if buySignal and strategy.position_size == 0 and buyRisk > 0
    strategy.entry("BUY", strategy.long)
    strategy.exit("BUY EXIT", "BUY", stop=buySL, limit=buyTP)

if sellSignal and strategy.position_size == 0 and sellRisk > 0
    strategy.entry("SELL", strategy.short)
    strategy.exit("SELL EXIT", "SELL", stop=sellSL, limit=sellTP)

plot(pdh, "PDH", color=color.new(color.red, 25), linewidth=1)
plot(pdl, "PDL", color=color.new(color.green, 25), linewidth=1)
plot(emaFast, "EMA 50", color=color.orange, linewidth=2)
plot(emaSlow, "EMA 200", color=color.blue, linewidth=2)

plotshape(showSweeps and buySweep, title="SSL Sweep", style=shape.triangleup, location=location.belowbar, text="SSL", color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)

plotshape(showSweeps and sellSweep, title="BSL Sweep", style=shape.triangledown, location=location.abovebar, text="BSL", color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)

plotshape(buySignal, title="BUY", style=shape.labelup, location=location.belowbar, text="BUY", color=color.lime, textcolor=color.black, size=size.normal)

plotshape(trendSellSignal, title="SELL", style=shape.labeldown, location=location.abovebar, text="SELL", color=color.red, textcolor=color.white, size=size.normal)

plotshape(premiumSell, title="PREMIUM SELL", style=shape.labeldown, location=location.abovebar, text="P-SELL", color=color.maroon, textcolor=color.white, size=size.normal)

plotshape(showWait and waitBuy, title="WAIT BUY", style=shape.circle, location=location.belowbar, color=color.gray, size=size.tiny)
plotshape(showWait and waitSell, title="WAIT SELL", style=shape.circle, location=location.abovebar, color=color.gray, size=size.tiny)

var table dash = table.new(position.bottom_right, 3, 12, border_width=1)

score = 0
score += buyBiasOK or sellBiasOK ? 15 : 0
score += trendBuyOK or trendSellOK or premiumSell ? 20 : 0
score += buySweep or sellSweep ? 25 : 0
score += bullReject or bearReject ? 25 : 0
score += emaSlopeBuy or emaSlopeSell ? 15 : 0

biasText = bullBias ? "BULLISH" : bearBias ? "BEARISH" : "NEUTRAL"
trendText = trendBuy ? "BUY" : trendSell ? "SELL" : "CHOP"
slopeText = emaSlopeBuy ? "BUY" : emaSlopeSell ? "SELL" : "FLAT"
sweepText = buySweep ? "SSL TAKEN" : sellSweep ? "BSL TAKEN" : "WAIT"
entryText = buySignal ? "BUY" : premiumSell ? "PREMIUM SELL" : trendSellSignal ? "SELL" : waitBuy ? "BUY WAIT" : waitSell ? "SELL WAIT" : "WAIT"

if showDashboard and barstate.islast
    table.cell(dash, 0, 0, "EB ICT GOLD V5 PRO", text_color=color.white, bgcolor=color.black)
    table.cell(dash, 1, 0, syminfo.ticker, text_color=color.white, bgcolor=color.black)
    table.cell(dash, 2, 0, entryMode, text_color=color.white, bgcolor=color.black)

    table.cell(dash, 0, 1, "Daily Bias", text_color=color.white, bgcolor=color.rgb(35,35,35))
    table.cell(dash, 1, 1, biasText)
    table.cell(dash, 2, 1, useDailyBias ? "ON" : "OFF")

    table.cell(dash, 0, 2, "Session", text_color=color.white, bgcolor=color.rgb(35,35,35))
    table.cell(dash, 1, 2, sessionOK ? "ACTIVE" : "OFF")
    table.cell(dash, 2, 2, useSession ? "ON" : "OFF")

    table.cell(dash, 0, 3, "Trend", text_color=color.white, bgcolor=color.rgb(35,35,35))
    table.cell(dash, 1, 3, trendText)
    table.cell(dash, 2, 3, useTrendFilter ? "ON" : "OFF")

    table.cell(dash, 0, 4, "EMA Slope", text_color=color.white, bgcolor=color.rgb(35,35,35))
    table.cell(dash, 1, 4, slopeText)
    table.cell(dash, 2, 4, needSlope ? "REQ" : "SOFT")

    table.cell(dash, 0, 5, "Sweep", text_color=color.white, bgcolor=color.rgb(35,35,35))
    table.cell(dash, 1, 5, sweepText)
    table.cell(dash, 2, 5, str.tostring(sweepATR))

    table.cell(dash, 0, 6, "Rejection", text_color=color.white, bgcolor=color.rgb(35,35,35))
    table.cell(dash, 1, 6, bullReject ? "BULL" : bearReject ? "BEAR" : "NO")
    table.cell(dash, 2, 6, str.tostring(wickFactor))

    table.cell(dash, 0, 7, "RSI / ADX", text_color=color.white, bgcolor=color.rgb(35,35,35))
    table.cell(dash, 1, 7, str.tostring(rsi, "#.0") + " / " + str.tostring(adx, "#.0"))
    table.cell(dash, 2, 7, (useRSIFilter ? "R" : "-") + "/" + (useADXFilter ? "A" : "-"))

    table.cell(dash, 0, 8, "Cooldown", text_color=color.white, bgcolor=color.rgb(35,35,35))
    table.cell(dash, 1, 8, str.tostring(signalCooldown) + " bars")
    table.cell(dash, 2, 8, buyCooldownOK and sellCooldownOK ? "OK" : "WAIT")

    table.cell(dash, 0, 9, "Score", text_color=color.white, bgcolor=color.rgb(35,35,35))
    table.cell(dash, 1, 9, str.tostring(score) + "%")
    table.cell(dash, 2, 9, score >= 70 ? "READY" : "LOW")

    table.cell(dash, 0, 10, "Signal", text_color=color.white, bgcolor=color.rgb(35,35,35))
    table.cell(dash, 1, 10, entryText)
    table.cell(dash, 2, 10, buySignal or sellSignal ? "TRADE" : "WAIT")

    table.cell(dash, 0, 11, "RR / SL", text_color=color.white, bgcolor=color.rgb(35,35,35))
    table.cell(dash, 1, 11, str.tostring(rr))
    table.cell(dash, 2, 11, str.tostring(slLookback))