//@version=6
indicator("1H BB 2.0 & 3.0 Levels", overlay=true)

// Inputs
length = input.int(20, "BB Length", minval=1)

// 1H Bollinger calculations
basis1H = request.security(syminfo.tickerid, "60", ta.sma(close, length))
stdev1H = request.security(syminfo.tickerid, "60", ta.stdev(close, length))

upper2 = basis1H + (2.0 * stdev1H)
lower2 = basis1H - (2.0 * stdev1H)

upper3 = basis1H + (3.0 * stdev1H)
lower3 = basis1H - (3.0 * stdev1H)

// Plot as step lines
plot(upper2, title="1H +2σ", linewidth=2, style=plot.style_stepline)
plot(lower2, title="1H -2σ", linewidth=2, style=plot.style_stepline)

plot(upper3, title="1H +3σ", linewidth=2, style=plot.style_stepline)
plot(lower3, title="1H -3σ", linewidth=2, style=plot.style_stepline)