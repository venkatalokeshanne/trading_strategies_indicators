// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © Indexrate
// @description: Adaptive signal engine with multi-layer confirmation

//@version=5
strategy("Code A - Terminal Core", overlay=true, initial_capital=1000, pyramiding=0,
     commission_type=strategy.commission.percent, commission_value=0.04,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100, currency=currency.USDT)

// [A] Visual Markers
string _iu = "↿"
string _id = "⇃"

// [B] Engine Core
_p0 = input.bool(true,  "Strategy Active",    group="Engine")
_p1 = input.bool(true,  "Long Signals",       group="Engine")
_p2 = input.bool(true,  "Short Signals",      group="Engine")
_p3 = input.bool(false, "Limit Testing Time", group="Engine")
_p4 = input.time(timestamp("01 Jan 2023 00:00 +0300"), "Start Date", group="Engine")
_p5 = input.time(timestamp("20 Jan 2030 00:00 +0300"), "End Date",   group="Engine")
_p6 = input.bool(true,  "Last Bar Only",      group="Engine")

// [C] Adaptive Trend Layer
_q0 = input.bool(true,  "Show Trend Core",       group="Adaptive Trend Layer")
_q1 = input.bool(false, "Show Divergence Label", group="Adaptive Trend Layer")
_q2 = input.source(hl2, "Source",                group="Adaptive Trend Layer")
_q3 = input.int(15, minval=1, title="Trend Length",group="Adaptive Trend Layer")
_q4 = input.int(5,  minval=0, title="Lookback",  group="Adaptive Trend Layer")

// [D] Signal Engine
_r0 = input.bool(true,  "Show Signals",            group="Signal Engine")
_r1 = input.float(5, minval=0, title="Difference", group="Signal Engine")
_r2 = input.int(0,   minval=0, title="Min Volume", group="Signal Engine")
_r3 = input.int(70, minval=0, maxval=100, title="Strategy #1 Bands", group="Signal Engine")
_r4 = input.int(70, minval=0, maxval=100, title="Strategy #2 Bands", group="Signal Engine")

// [E] Dynamic Ribbon
_s0 = input.bool(true, "EMA Ribbon (A/B/C)", group="Dynamic Ribbon")
_s1 = input.bool(true, "Anchor 100",          group="Dynamic Ribbon")
_s2 = input.bool(true, "Anchor 200",          group="Dynamic Ribbon")
int _sL1  = 13
int _sL2  = 25
int _sL3  = 50
_sSrc     = close
int _sDrp = 1

// [F] Series Counter (Exhaustion Filter)
_t0 = input.int(3, minval=1, maxval=9, title="Max Series Count", group="Series Counter")
_t1 = input.bool(true, "Show Numbers", inline="seriesNum", group="Series Counter")
_t2 = input.bool(true, "Show Series Bar Color", group="Series Counter")

color _cx0  = #00BECE
color _cx1  = #9995A3
bool  _noEd = false
color _cULb = color.new(color.green, 100)
color _cDLb = color.new(color.red,   100)

// [G] Bias Score
_u0 = input.int(5, minval=3, maxval=600, title="Smoothing Period", group="Bias Score")

// [H] Momentum Anchor
_v0 = input.bool(true,  "Show PSAR", group="Momentum Anchor")
_v1 = input.float(0.01, step=0.01, title="PSAR Start", group="Momentum Anchor")
_v2 = input.float(0.01, step=0.01, title="PSAR Step",  group="Momentum Anchor")
_v3 = input.float(0.1,  step=0.1,  title="PSAR Max",   group="Momentum Anchor")

// [I] Position Exit
_w0 = input.bool(true, "Exit by Candle Color",      group="Position Exit")
_w1 = input.bool(true, "Exit by Candle Difference", group="Position Exit")

// [J] Filters
_f0  = input.bool(true,  "Difference Comparison",   group="Filters")
_f1  = input.bool(false, "Wave & EMA Combined",      group="Filters")
_f2  = input.bool(true,  "Wave Cross",               group="Filters")
_f3  = input.bool(true,  "EMA Cross",                group="Filters")
_f4  = input.bool(true,  "Candle Momentum",          group="Filters")
_f5  = input.bool(true,  "High/Low Update",          group="Filters")
_f6  = input.bool(true,  "RSI Bias",                 group="Filters")
_f7  = input.bool(true,  "Money Flow Bias",          group="Filters")
_f8  = input.bool(true,  "CTS Momentum",             group="Filters")
_f9  = input.bool(true,  "Trend Core Gate",          group="Filters")
_f10 = input.bool(true,  "Volume Filter",            group="Filters")
_f11 = input.bool(true,  "Series Filter",            group="Filters")
_f12 = input.bool(true,  "PSAR Bias",                group="Filters")
_f13 = input.bool(true,  "PSAR Direction Change",    group="Filters")
_f14 = input.bool(true,  "Shadowless Filter",        group="Filters")
_f15 = input.bool(true,  "Strategy #1 Filter",       group="Filters")
_f16 = input.bool(true,  "Strategy #2 Filter",       group="Filters")
_f17 = input.bool(true,  "Remove Duplicate Signals", group="Filters")

// --- FUNCTIONS ---

f_a0() =>
    _h  = ta.hma(_q2, _q3)
    _d  = _h[1] - _h[_q4 + 1]
    _dp = _d / _q4
    _nb = _h[1] + _dp
    _cv = _h > _nb ? 1 : -1
    [_h, _nb, _cv]

f_a1(float _s, int _cl, int _al) =>
    _e  = ta.ema(_s, _cl)
    _d  = ta.ema(math.abs(_s - _e), _cl)
    _ci = (_s - _e) / (0.015 * _d)
    _w1 = ta.ema(_ci, _al)
    _w2 = ta.sma(_w1, 3)
    _df = math.round((_w1 - _w2), 1)
    [_w1, _w2, _df]

f_a2(_len, _m, _y) =>
    ta.sma(((close - open) / (high - low)) * _m, _len) - _y

f_a3() =>
    [_w1, _w2, _df] = f_a1(hlc3, 9, 12)
    _mf = f_a2(60, 200, 2.25)
    _k1 = ta.sma(ta.stoch(close, high, low, 40), 2)
    _k2 = ta.sma(ta.stoch(close, high, low, 80), 2)
    [_w1, _w2, _df, _mf, _k1, _k2]

f_a4() =>
    int _s = 0
    for i = 11 to 20
        if close > close[i]
            _s += 1
        else
            _s -= 1
    ta.wma(_s, _u0)

f_a5(float _s, int _n) =>
    na(_s[_n]) ? na : _s

// --- CALCULATIONS ---

[_hLine, _hNext, _hCurve] = f_a0()

_eA = ta.ema(close, 5)
_eB = ta.ema(close, 11)
_eC = ta.ema(close, 33)

[_oA, _oB, _oDf, _oMf, _oK1, _oK2] = f_a3()

float _mA = ta.ema(f_a5(_sSrc, _sDrp), _sL1)
float _mB = ta.ema(f_a5(_sSrc, _sDrp), _sL2)
float _mC = ta.ema(f_a5(_sSrc, _sDrp), _sL3)

// Series counters (Exhaustion logic)
var int _seriesUp = 0
var int _seriesDn = 0
_seriesUp := close > close[4] ? nz(_seriesUp[1]) + 1 : 0
_seriesDn := close < close[4] ? nz(_seriesDn[1]) + 1 : 0
_runUp = _seriesUp - ta.valuewhen(_seriesUp < _seriesUp[1], _seriesUp, 1)
_runDn = _seriesDn - ta.valuewhen(_seriesDn < _seriesDn[1], _seriesDn, 1)

_dA = ta.ema(close, 100)
_dB = ta.ema(close, 200)

_bsVal = f_a4() * (100.0 / 12.0)

_ancVal = ta.sar(_v1, _v2, _v3)

// --- CONDITIONS ---

bool _inTime = false
if _p6
    _inTime := time > _p4
else
    _inTime := time > _p4 and time <= _p5
if not _p3
    _inTime := true

bool _hLime = _hCurve != -1 and _hLine > _hLine[1]
bool _hRed  = _hCurve != 1  and _hLine < _hLine[1]

var bool _gL = true
var bool _gS = true
if not _hLime
    _gL := true
if not _hRed
    _gS := true

bool _cA0 = _f9  ? _hLime              : true
bool _cA1 = _f9  ? _hRed               : true
bool _cA2 = _f6  ? (_oK1 > _oK2)       : true
bool _cA3 = _f6  ? (_oK1 <= _oK2)      : true
bool _cA4 = _f7  ? (_oMf > 0)          : true
bool _cA5 = _f7  ? (_oMf <= 0)         : true
bool _cA6 = _f8  ? (_bsVal > _bsVal[1] or _bsVal >= 83 or _bsVal <= -83) : true
bool _cA7 = _f8  ? (_bsVal < _bsVal[1] or _bsVal <= -83 or _bsVal >= 83) : true
bool _cA8 = _f10 ? (volume >= _r2)     : true
bool _cA9 = _f11 ? (_runUp <= _t0)      : true
bool _cB0 = _f11 ? (_runDn <= _t0)      : true
bool _cB1 = _f12 ? (close > _ancVal)   : true
bool _cB2 = _f12 ? (close < _ancVal)   : true
bool _cB3 = _f4  ? (open > open[1] and close > close[1]) : true
bool _cB4 = _f4  ? (open < open[1] and close < close[1]) : true
bool _cB5 = _f5  ? (high[1] < high)    : true
bool _cB6 = _f5  ? (low[1]  > low)     : true
bool _cB7 = _f14 ? (math.min(open, close) == low)  : true
bool _cB8 = _f14 ? (math.max(open, close) == high) : true
bool _cB9 = _f16 ? (_oB < _r4)         : true
bool _cC0 = _f16 ? (_oB > -_r4)        : true
bool _cC1 = _f15 ? (_oB < -_r3)        : true
bool _cC2 = _f15 ? (_oB > _r3)         : true
bool _cC3 = _f0  ? (_oDf >= _r1)       : true
bool _cC4 = _f0  ? (_oDf <= -_r1)      : true

bool _xwL = _f2 ? (ta.crossover(_oA, _oB)  or ta.crossover(_oA[2], _oB[2]))  : false
bool _xwS = _f2 ? (ta.crossunder(_oA, _oB) or ta.crossunder(_oA[2], _oB[2])) : false
bool _xeL = _f3 ? ta.crossover(_eB, _eC)  : false
bool _xeS = _f3 ? ta.crossunder(_eA, _eB) : false

if _f2 == false and _f3 == false
    _xwL := true
    _xwS := true
    _xeL := true
    _xeS := true

bool _xL = _f1 ? (_xeL and _xwL) : (_xeL or _xwL)
bool _xS = _f1 ? (_xeS and _xwS) : (_xeS or _xwS)

bool _pAL = _oB > 0 and _cA4 and _cB9
bool _pAS = _oB < 0 and _cA5 and _cC0
bool _pBL = _oB < 0 and _cA2 and _cC1
bool _pBS = _oB > 0 and _cA3 and _cC2

bool _sigL_A = _cB5 and _xL  and _cA9 and _cB1
bool _sigL_B = _cB3 and _cB7 and _cC3
bool _sigL_C = _cA0 and (_pAL or _pBL) and _cA6 and _cA8 and _gL
bool _sigUp  = _sigL_A and _sigL_B and _sigL_C

bool _sigS_A = _cB6 and _xS  and _cB0 and _cB2
bool _sigS_B = _cB4 and _cB8 and _cC4
bool _sigS_C = _cA1 and (_pAS or _pBS) and _cA7 and _cA8 and _gS
bool _sigDn  = _sigS_A and _sigS_B and _sigS_C

if _f17
    if _sigUp
        _gL := false
    if _sigDn
        _gS := false

bool _anyOn = _f0 or _f2 or _f3 or _f4 or _f5 or _f6 or _f7 or
 _f8 or _f9 or _f10 or _f11 or _f12 or _f13 or _f14 or _f15 or _f16
if not _anyOn
    _sigUp := false
    _sigDn := false

bool _xLC = _w0 ? (close < open) : true
bool _xSC = _w0 ? (close > open) : true
bool _xLD = _w1 ? (_oDf <= 0.2)  : true
bool _xSD = _w1 ? (_oDf >= 0.2)  : true

bool _exitL = _xLC and _xLD
bool _exitS = _xSC and _xSD

if not _w0 and not _w1
    _exitL := false
    _exitS := false

// --- VISUALS ---

_dspM = display.all - display.status_line
_dspH = display.all - display.status_line

plotchar(_r0 ? _sigUp : na, "LongSignal",  _iu, location.belowbar, #00BECE, size=size.small, display=_dspM, text="LONG",  textcolor=#00BECE)
plotchar(_r0 ? _sigDn : na, "ShortSignal", _id, location.abovebar, #9995A3, size=size.small, display=_dspM, text="SHORT", textcolor=#9995A3)

_hBrC = _hLine > _hLine[1] ? color(#dbdbdb) : color(#d91702)
_hBlC = _hLine < _hLine[1] ? color(#dbdbdb) : color(#03FC04)
color _hCol = _hCurve != -1 ? _hBlC : _hBrC
plot(_q0 ? _hLine : na, title="Trend Core", color=_hCol, linewidth=2)

float _dVal = math.round(_hLine - _hNext, precision=4)
color _dCol = if _hCurve < 0 and _dVal[1] > _dVal
    color.red
else if _hCurve < 0 and _dVal[1] < _dVal
    color.rgb(255, 255, 255)
else if _hCurve > 0 and _dVal[1] < _dVal
    color.green
else
    color.rgb(255, 255, 255)

label _dLbl = _q1 ? label.new(x=bar_index, y=close,
 text="Divergence:\n" + str.tostring(_dVal), yloc=yloc.belowbar,
 color=_dCol, textcolor=color.black,
 style=label.style_label_up, size=size.small) : na
label.delete(_dLbl[1])

plot(_s0 ? _mA : na, title="Layer A", color=#0e8e00, linewidth=1)
plot(_s0 ? _mB : na, title="Layer B", color=#a87cff, linewidth=1)
plot(_s0 ? _mC : na, title="Layer C", color=#FF9700, linewidth=1)

_seriesDsp = display.all - display.status_line - display.data_window

plotshape(_t1 and _runUp==1, style=shape.triangledown, text="1", textcolor=_cx0, location=location.abovebar, color=_cULb, editable=_noEd, display=_seriesDsp)
plotshape(_t1 and _runUp==2, style=shape.triangledown, text="2", textcolor=_cx0, location=location.abovebar, color=_cULb, editable=_noEd, display=_seriesDsp)
plotshape(_t1 and _runUp==3, style=shape.triangledown, text="3", textcolor=_cx0, location=location.abovebar, color=_cULb, editable=_noEd, display=_seriesDsp)
plotshape(_t1 and _runUp==4, style=shape.triangledown, text="4", textcolor=_cx0, location=location.abovebar, color=_cULb, editable=_noEd, display=_seriesDsp)
plotshape(_t1 and _runUp==5, style=shape.triangledown, text="5", textcolor=_cx0, location=location.abovebar, color=_cULb, editable=_noEd, display=_seriesDsp)
plotshape(_t1 and _runUp==6, style=shape.triangledown, text="6", textcolor=_cx0, location=location.abovebar, color=_cULb, editable=_noEd, display=_seriesDsp)
plotshape(_t1 and _runUp==7, style=shape.triangledown, text="7", textcolor=_cx0, location=location.abovebar, color=_cULb, editable=_noEd, display=_seriesDsp)
plotshape(_t1 and _runUp==8, style=shape.triangledown, text="8", textcolor=_cx0, location=location.abovebar, color=_cULb, editable=_noEd, display=_seriesDsp)
plotshape(_t1 and _runUp==9, style=shape.triangledown, text="9", textcolor=_cx0, location=location.abovebar, color=_cULb, editable=_noEd, display=_seriesDsp)

plotshape(_t1 and _runDn==1, style=shape.triangledown, text="1", textcolor=_cx1, location=location.belowbar, color=_cDLb, editable=_noEd, display=_seriesDsp)
plotshape(_t1 and _runDn==2, style=shape.triangledown, text="2", textcolor=_cx1, location=location.belowbar, color=_cDLb, editable=_noEd, display=_seriesDsp)
plotshape(_t1 and _runDn==3, style=shape.triangleup,   text="3", textcolor=_cx1, location=location.belowbar, color=_cDLb, editable=_noEd, display=_seriesDsp)
plotshape(_t1 and _runDn==4, style=shape.triangleup,   text="4", textcolor=_cx1, location=location.belowbar, color=_cDLb, editable=_noEd, display=_seriesDsp)
plotshape(_t1 and _runDn==5, style=shape.triangleup,   text="5", textcolor=_cx1, location=location.belowbar, color=_cDLb, editable=_noEd, display=_seriesDsp)
plotshape(_t1 and _runDn==6, style=shape.triangleup,   text="6", textcolor=_cx1, location=location.belowbar, color=_cDLb, editable=_noEd, display=_seriesDsp)
plotshape(_t1 and _runDn==7, style=shape.triangleup,   text="7", textcolor=_cx1, location=location.belowbar, color=_cDLb, editable=_noEd, display=_seriesDsp)
plotshape(_t1 and _runDn==8, style=shape.triangleup,   text="8", textcolor=_cx1, location=location.belowbar, color=_cDLb, editable=_noEd, display=_seriesDsp)
plotshape(_t1 and _runDn==9, style=shape.triangleup,   text="9", textcolor=_cx1, location=location.belowbar, color=_cDLb, editable=_noEd, display=_seriesDsp)

barcolor(_t2 and _seriesUp >= 9 ? #FF0000 : _t2 and _seriesDn >= 9 ? #00FF00 : close >= open ? _cx0 : close < open ? _cx1 : na)

plot(_s1 ? _dA : na, title="Anchor 100", color=#0022ff,   linewidth=1, display=_dspH)
plot(_s2 ? _dB : na, title="Anchor 200", color=color.red, linewidth=1, display=_dspH)

_ancDsp = display.all - display.status_line - display.price_scale
plot(_ancVal, "Momentum Anchor", _v0 ? (close > _ancVal ? _cx0 : _cx1) : na, 1, plot.style_linebr, display=_ancDsp)

plot(volume, title="Volume", color=color.gray, editable=false, display=display.status_line)

// --- STRATEGY EXECUTION ---

if _p0 and _inTime
    if _sigUp and _p1
        strategy.entry("L+", strategy.long)
    if _sigDn and _p2
        strategy.entry("S-", strategy.short)
    if _exitL
        strategy.close("L+")
    if _exitS
        strategy.close("S-")

_dbDsp = display.data_window
plot(_seriesUp, title="Series Up", color=color.white, display=_dbDsp, editable=false)
plot(_seriesDn, title="Series Down", display=_dbDsp, editable=false)
