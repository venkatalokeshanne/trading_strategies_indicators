        // row := row + 1

        // table.cell(dashboard, 0, row, 'Weekend Trading', text_color = c_gray, text_size = dash_text_size)
        // table.merge_cells(dashboard, 1, row, 4, row)
        // table.cell(dashboard, 1, row, allow_weekend ? 'ENABLED' : 'DISABLED', text_color = allow_weekend ? c_green : c_red, text_size = dash_text_size)
        // row := row + 1

    table.cell(dashboard, 0, row, 'Session Status', text_color = c_gray, text_size = dash_text_size)
    table.merge_cells(dashboard, 1, row, 4, row)
    table.cell(dashboard, 1, row, session_status, text_color = session_color, text_size = dash_text_size)
    row := row + 1

    // ========================================
    // VISUAL EFFECTS - Position Infos
    // ========================================    
    table.merge_cells(dashboard, 0, row, 4, row)
    table.cell(dashboard, 0, row, '════  Current Position: '+(strategy.position_size < 0 ? 'SHORT '+str.tostring(strategy.position_size) +' ═════' : strategy.position_size > 0 ? 'LONG '+str.tostring(strategy.position_size) + '  ═════' : 'FLAT  ═════'), text_color = strategy.position_size < 0 ? c_red : strategy.position_size > 0 ? c_green : c_blue, bgcolor = bg_gray, text_size = dash_text_size)
    row := row + 1

    // Stop & Factors
