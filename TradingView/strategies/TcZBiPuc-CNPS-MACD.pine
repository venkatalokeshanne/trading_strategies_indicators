//Tác giả: https://phaisinh.online/
//Nhóm cộng đồng: https://zalo.me/g/jvaykb078
//@version=5
strategy("CNPS1-MACD", overlay=true, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1)

// ===== INPUT =====
useTP      = input.bool(true, "Sử dụng Chốt lời (TP)")
tradeMode  = input.string("Both", "Chế độ giao dịch", options = ["Long Only", "Short Only", "Both"])
sl_points  = input.float(10, "Dừng lỗ (points)")
tp_points  = input.float(30, "Chốt lời (points)")

// ===== MACD =====
[macdLine, signalLine, hist] = ta.macd(close, 12, 26, 9)

// ===== ĐIỀU KIỆN =====
// Mua
longCondition  = ta.crossover(macdLine, signalLine)
closeLongCond  = ta.crossunder(macdLine, signalLine)

// Bán
shortCondition = ta.crossunder(macdLine, signalLine)
closeShortCond = ta.crossover(macdLine, signalLine)

// ===== GIÁ SL/TP =====
long_sl = strategy.position_avg_price - sl_points
long_tp = strategy.position_avg_price + tp_points

short_sl = strategy.position_avg_price + sl_points
short_tp = strategy.position_avg_price - tp_points

// ===== VÀO LỆNH =====
if (longCondition and (tradeMode == "Both" or tradeMode == "Long Only"))
    strategy.entry("Long", strategy.long)

if (shortCondition and (tradeMode == "Both" or tradeMode == "Short Only"))
    strategy.entry("Short", strategy.short)

// ===== THOÁT LỆNH =====
// Long
if (strategy.position_size > 0)
    strategy.exit("Exit Long", "Long",
         stop = long_sl,
         limit = useTP ? long_tp : na)

    if (closeLongCond)
        strategy.close("Long")

// Short
if (strategy.position_size < 0)
    strategy.exit("Exit Short", "Short",
         stop = short_sl,
         limit = useTP ? short_tp : na)

    if (closeShortCond)
        strategy.close("Short")

// ===== HIỂN THỊ =====
// SL/TP plot
plot(strategy.position_size > 0 ? long_sl : na, title="Long SL", color=color.red, style=plot.style_linebr)
plot(strategy.position_size > 0 and useTP ? long_tp : na, title="Long TP", color=color.green, style=plot.style_linebr)

plot(strategy.position_size < 0 ? short_sl : na, title="Short SL", color=color.red, style=plot.style_linebr)
plot(strategy.position_size < 0 and useTP ? short_tp : na, title="Short TP", color=color.green, style=plot.style_linebr)