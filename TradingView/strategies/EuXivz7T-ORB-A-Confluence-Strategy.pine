// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
//@version=6
strategy(
     "ORB A+ Confluence Strategy",
     shorttitle = "ORB A+",
     overlay = true,
     initial_capital = 1000000,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     pyramiding = 0,
     commission_type = strategy.commission.percent,
     commission_value = 0,
     process_orders_on_close = true)

// ============================================================================
// GROUPS
// ============================================================================
string GROUP_RANGE   = "Opening Range"
string GROUP_TREND   = "A+ Trend Filters"
string GROUP_SCORE   = "A+ Setup Scoring"
string GROUP_VOLUME  = "Volume Confirmation"
string GROUP_RISK    = "Trade Targets"
string GROUP_PROP    = "Prop-Style Risk Rules"
string GROUP_STYLE   = "Style"

// ============================================================================
// OPENING RANGE INPUTS
// ============================================================================
string rangeSessionInput = input.session(
     "0930-1000:23456",
     "Opening range session",
     group = GROUP_RANGE)

string sessionTimezoneInput = input.string(
     "America/New_York",
     "Session timezone",
     options = ["America/New_York", "Etc/UTC", "Europe/London", "Asia/Tokyo"],
     group = GROUP_RANGE)

bool showMidpointInput = input.bool(
     true,
     "Show ORB midpoint",
     group = GROUP_RANGE)

bool allowInsideOrbInput = input.bool(
     true,
     "Allow A/A+ setups inside ORB",
     group = GROUP_RANGE,
     tooltip = "Allows high-confluence continuation/rejection trades while price remains inside the completed opening range.")

// ============================================================================
// TREND FILTERS
// ============================================================================
int emaLengthInput = input.int(
     20,
     "EMA length",
     minval = 1,
     group = GROUP_TREND)

int emaSlopeLookbackInput = input.int(
     3,
     "EMA slope lookback",
     minval = 1,
     group = GROUP_TREND)

bool useVwapInput = input.bool(
     true,
     "Use VWAP confirmation",
     group = GROUP_TREND)

bool useEmaInput = input.bool(
     true,
     "Use EMA confirmation",
     group = GROUP_TREND)

bool useEmaSlopeInput = input.bool(
     true,
     "Use EMA slope confirmation",
     group = GROUP_TREND)

// ============================================================================
// VOLUME
// ============================================================================
int volumeLengthInput = input.int(
     20,
     "Volume average length",
     minval = 1,
     group = GROUP_VOLUME)

float volumeMultiplierInput = input.float(
     1.25,
     "Strong volume multiplier",
     minval = 0.1,
     step = 0.05,
     group = GROUP_VOLUME)

float extremeVolumeMultiplierInput = input.float(
     1.6,
     "A+ volume multiplier",
     minval = 0.1,
     step = 0.05,
     group = GROUP_VOLUME)

// ============================================================================
// A+ SCORING
// ============================================================================
int minimumAScoreInput = input.int(
     5,
     "Minimum score for A setup",
     minval = 1,
     maxval = 8,
     group = GROUP_SCORE)

int minimumAPlusScoreInput = input.int(
     7,
     "Minimum score for A+ setup",
     minval = 1,
     maxval = 8,
     group = GROUP_SCORE)

float retestToleranceAtrInput = input.float(
     0.25,
     "Retest tolerance (ATR)",
     minval = 0.05,
     step = 0.05,
     group = GROUP_SCORE)

float maxExtensionAtrInput = input.float(
     1.25,
     "Maximum EMA extension (ATR)",
     minval = 0.25,
     step = 0.05,
     group = GROUP_SCORE,
     tooltip = "Avoids chasing price when it is already excessively extended away from the 20 EMA.")

bool requireConfirmationCandleInput = input.bool(
     true,
     "Require confirmation candle",
     group = GROUP_SCORE)

// ============================================================================
// RISK
// ============================================================================
int atrLengthInput = input.int(
     14,
     "ATR length",
     minval = 1,
     group = GROUP_RISK)

float stopAtrMultiplierInput = input.float(
     1.25,
     "Stop ATR multiplier",
     minval = 0.1,
     step = 0.05,
     group = GROUP_RISK)

float riskRewardInput = input.float(
     2.0,
     "Risk-to-reward",
     minval = 0.5,
     step = 0.25,
     group = GROUP_RISK)

bool useBreakEvenInput = input.bool(
     true,
     "Move stop to break-even",
     group = GROUP_RISK)

float breakEvenTriggerInput = input.float(
     1.0,
     "Break-even trigger (R)",
     minval = 0.25,
     step = 0.25,
     group = GROUP_RISK)

bool useTrendExitInput = input.bool(
     true,
     "Enable trend failure exit",
     group = GROUP_RISK,
     tooltip = "Closes a trade early when price loses both the EMA and VWAP against the position.")

// ============================================================================
// PROP RULES
// ============================================================================
bool enablePropRulesInput = input.bool(
     true,
     "Enable prop guardrails",
     group = GROUP_PROP)

float propAccountSizeInput = input.float(
     50000,
     "Prop account size",
     minval = 1,
     step = 1000,
     group = GROUP_PROP)

float dailyLossLimitInput = input.float(
     3.0,
     "Daily loss limit (%)",
     minval = 0.1,
     step = 0.1,
     group = GROUP_PROP)

float maxDrawdownInput = input.float(
     6.0,
     "Trailing max drawdown (%)",
     minval = 0.1,
     step = 0.1,
     group = GROUP_PROP)

int maxTradesInput = input.int(
     3,
     "Maximum entries per day",
     minval = 1,
     group = GROUP_PROP)

float evaluationTargetInput = input.float(
     6.0,
     "Evaluation target (%)",
     minval = 0.1,
     step = 0.1,
     group = GROUP_PROP)

// ============================================================================
// STYLE
// ============================================================================
bool showEmaInput = input.bool(true, "Show 20 EMA", group = GROUP_STYLE)
bool showVwapStyleInput = input.bool(true, "Show VWAP", group = GROUP_STYLE)
bool showScoreInput = input.bool(true, "Show A/A+ labels", group = GROUP_STYLE)

color rangeHighColorInput = input.color(
     #089981,
     "ORB high",
     group = GROUP_STYLE)

color rangeLowColorInput = input.color(
     #f23645,
     "ORB low",
     group = GROUP_STYLE)

color midpointColorInput = input.color(
     #5b9cf6,
     "ORB midpoint",
     group = GROUP_STYLE)

// ============================================================================
// SESSION
// ============================================================================
int dayStamp = time("D", "0000-2359", sessionTimezoneInput)

bool newDay =
     not na(dayStamp) and
     (na(dayStamp[1]) or dayStamp != dayStamp[1])

bool inRangeSession =
     not na(time(timeframe.period, rangeSessionInput, sessionTimezoneInput))

bool wasInRangeSession =
     bar_index > 0 and inRangeSession[1]

bool rangeSessionStart =
     inRangeSession and not wasInRangeSession

bool rangeSessionEnd =
     not inRangeSession and wasInRangeSession

var float rangeHigh = na
var float rangeLow = na
var bool rangeReady = false

if newDay
    rangeHigh := na
    rangeLow := na
    rangeReady := false

if rangeSessionStart
    rangeHigh := high
    rangeLow := low
    rangeReady := false

else if inRangeSession
    rangeHigh := math.max(rangeHigh, high)
    rangeLow := math.min(rangeLow, low)

if rangeSessionEnd
    rangeReady := true

float rangeMid =
     not na(rangeHigh) and not na(rangeLow)
     ? (rangeHigh + rangeLow) / 2.0
     : na

// ============================================================================
// INDICATORS
// ============================================================================
float ema20 = ta.ema(close, emaLengthInput)
float sessionVwap = ta.vwap(hlc3)
float atrValue = ta.atr(atrLengthInput)
float volumeAverage = ta.sma(volume, volumeLengthInput)

bool strongVolume =
     not na(volumeAverage) and
     volume >= volumeAverage * volumeMultiplierInput

bool extremeVolume =
     not na(volumeAverage) and
     volume >= volumeAverage * extremeVolumeMultiplierInput

bool emaRising =
     ema20 > ema20[emaSlopeLookbackInput]

bool emaFalling =
     ema20 < ema20[emaSlopeLookbackInput]

bool aboveEMA = close > ema20
bool belowEMA = close < ema20

bool aboveVWAP = close > sessionVwap
bool belowVWAP = close < sessionVwap

// ============================================================================
// CANDLE QUALITY
// ============================================================================
float candleRange = high - low

float candleBody =
     math.abs(close - open)

float bodyPercent =
     candleRange > 0
     ? candleBody / candleRange
     : 0.0

bool bullishCandle =
     close > open

bool bearishCandle =
     close < open

bool strongBullCandle =
     bullishCandle and
     bodyPercent >= 0.55 and
     close >= high - candleRange * 0.25

bool strongBearCandle =
     bearishCandle and
     bodyPercent >= 0.55 and
     close <= low + candleRange * 0.25

// ============================================================================
// LOCATION
// ============================================================================
bool outsideLong =
     rangeReady and
     close > rangeHigh

bool outsideShort =
     rangeReady and
     close < rangeLow

bool insideORB =
     rangeReady and
     close <= rangeHigh and
     close >= rangeLow

bool upperHalf =
     insideORB and
     close > rangeMid

bool lowerHalf =
     insideORB and
     close < rangeMid

// ============================================================================
// BREAKOUT DETECTION
// ============================================================================
bool longBreakout =
     rangeReady and
     close > rangeHigh and
     close[1] <= rangeHigh

bool shortBreakout =
     rangeReady and
     close < rangeLow and
     close[1] >= rangeLow

// ============================================================================
// RETEST DETECTION
// ============================================================================
float retestTolerance =
     atrValue * retestToleranceAtrInput

bool longOrbRetest =
     rangeReady and
     low <= rangeHigh + retestTolerance and
     low >= rangeHigh - retestTolerance and
     close > rangeHigh

bool shortOrbRetest =
     rangeReady and
     high >= rangeLow - retestTolerance and
     high <= rangeLow + retestTolerance and
     close < rangeLow

bool longEmaRetest =
     low <= ema20 + retestTolerance and
     close > ema20 and
     bullishCandle

bool shortEmaRetest =
     high >= ema20 - retestTolerance and
     close < ema20 and
     bearishCandle

bool longVwapRetest =
     low <= sessionVwap + retestTolerance and
     close > sessionVwap and
     bullishCandle

bool shortVwapRetest =
     high >= sessionVwap - retestTolerance and
     close < sessionVwap and
     bearishCandle

// ============================================================================
// ORB EDGE REJECTIONS
// These allow high quality setups INSIDE the ORB.
// ============================================================================
bool longLowRejection =
     insideORB and
     low <= rangeLow + retestTolerance and
     close > rangeLow + retestTolerance and
     bullishCandle

bool shortHighRejection =
     insideORB and
     high >= rangeHigh - retestTolerance and
     close < rangeHigh - retestTolerance and
     bearishCandle

// ============================================================================
// MIDPOINT CONTINUATION
// ============================================================================
bool longMidContinuation =
     insideORB and
     close > rangeMid and
     close[1] <= rangeMid and
     aboveEMA and
     aboveVWAP and
     strongBullCandle

bool shortMidContinuation =
     insideORB and
     close < rangeMid and
     close[1] >= rangeMid and
     belowEMA and
     belowVWAP and
     strongBearCandle

// ============================================================================
// CHASE FILTER
// ============================================================================
float emaDistance =
     math.abs(close - ema20)

bool notOverextended =
     emaDistance <= atrValue * maxExtensionAtrInput

// ============================================================================
// LONG SCORE
//
// Maximum score = 8
// ============================================================================
int longScore = 0

longScore += aboveVWAP ? 1 : 0
longScore += aboveEMA ? 1 : 0
longScore += emaRising ? 1 : 0
longScore += strongVolume ? 1 : 0
longScore += strongBullCandle ? 1 : 0

longScore += (
     longOrbRetest or
     longEmaRetest or
     longVwapRetest or
     longLowRejection or
     longMidContinuation
     ) ? 1 : 0

longScore += (
     outsideLong or
     upperHalf or
     longLowRejection
     ) ? 1 : 0

longScore += extremeVolume ? 1 : 0

// ============================================================================
// SHORT SCORE
// ============================================================================
int shortScore = 0

shortScore += belowVWAP ? 1 : 0
shortScore += belowEMA ? 1 : 0
shortScore += emaFalling ? 1 : 0
shortScore += strongVolume ? 1 : 0
shortScore += strongBearCandle ? 1 : 0

shortScore += (
     shortOrbRetest or
     shortEmaRetest or
     shortVwapRetest or
     shortHighRejection or
     shortMidContinuation
     ) ? 1 : 0

shortScore += (
     outsideShort or
     lowerHalf or
     shortHighRejection
     ) ? 1 : 0

shortScore += extremeVolume ? 1 : 0

// ============================================================================
// CONFIRMATION
// ============================================================================
bool longConfirmation =
     not requireConfirmationCandleInput or
     strongBullCandle

bool shortConfirmation =
     not requireConfirmationCandleInput or
     strongBearCandle

// ============================================================================
// A / A+ GRADES
// ============================================================================
bool longAPlus =
     longScore >= minimumAPlusScoreInput

bool shortAPlus =
     shortScore >= minimumAPlusScoreInput

bool longA =
     longScore >= minimumAScoreInput and
     longScore < minimumAPlusScoreInput

bool shortA =
     shortScore >= minimumAScoreInput and
     shortScore < minimumAPlusScoreInput

// ============================================================================
// VALID SETUP LOCATION
// ============================================================================
bool validLongLocation =
     outsideLong or
     (
         allowInsideOrbInput and
         insideORB and
         (
             upperHalf or
             longLowRejection or
             longMidContinuation
         )
     )

bool validShortLocation =
     outsideShort or
     (
         allowInsideOrbInput and
         insideORB and
         (
             lowerHalf or
             shortHighRejection or
             shortMidContinuation
         )
     )

// ============================================================================
// PROP ACCOUNT CONTROLS
// ============================================================================
var float baseStrategyEquity = na
var float dayStartPropEquity = na
var float peakPropEquity = na

var int tradesToday = 0

var bool dailyLossBreached = false
var bool maxDrawdownBreached = false
var bool accountTargetReached = false

if na(baseStrategyEquity)
    baseStrategyEquity := strategy.equity

float simulatedPropEquity =
     propAccountSizeInput +
     strategy.equity -
     baseStrategyEquity

if na(dayStartPropEquity) or newDay
    dayStartPropEquity := simulatedPropEquity
    tradesToday := 0
    dailyLossBreached := false

if na(peakPropEquity)
    peakPropEquity := simulatedPropEquity
else
    peakPropEquity :=
         math.max(
             peakPropEquity,
             simulatedPropEquity)

float dailyLossAmount =
     propAccountSizeInput *
     dailyLossLimitInput / 100.0

float maxDrawdownAmount =
     propAccountSizeInput *
     maxDrawdownInput / 100.0

float evaluationTargetAmount =
     propAccountSizeInput *
     evaluationTargetInput / 100.0

if enablePropRulesInput

    if simulatedPropEquity <=
         dayStartPropEquity - dailyLossAmount
        dailyLossBreached := true

    if simulatedPropEquity <=
         peakPropEquity - maxDrawdownAmount
        maxDrawdownBreached := true

    if simulatedPropEquity >=
         propAccountSizeInput +
         evaluationTargetAmount
        accountTargetReached := true

bool propLockout =
     enablePropRulesInput and
     (
         dailyLossBreached or
         maxDrawdownBreached or
         accountTargetReached
     )

bool propTradingAllowed =
     not enablePropRulesInput or
     (
         not propLockout and
         tradesToday < maxTradesInput
     )

// ============================================================================
// ENTRY CONDITIONS
// ============================================================================
bool baseTradePermission =
     barstate.isconfirmed and
     rangeReady and
     not inRangeSession and
     strategy.position_size == 0 and
     propTradingAllowed and
     notOverextended

bool longTrendValid =
     (not useVwapInput or aboveVWAP) and
     (not useEmaInput or aboveEMA) and
     (not useEmaSlopeInput or emaRising)

bool shortTrendValid =
     (not useVwapInput or belowVWAP) and
     (not useEmaInput or belowEMA) and
     (not useEmaSlopeInput or emaFalling)

bool longSignal =
     baseTradePermission and
     validLongLocation and
     longTrendValid and
     longConfirmation and
     longScore >= minimumAScoreInput

bool shortSignal =
     baseTradePermission and
     validShortLocation and
     shortTrendValid and
     shortConfirmation and
     shortScore >= minimumAScoreInput

// Prevent simultaneous signals
bool finalLongSignal =
     longSignal and
     not shortSignal

bool finalShortSignal =
     shortSignal and
     not longSignal

// ============================================================================
// ENTRY TYPE
// ============================================================================
string longGrade =
     longAPlus ? "A+" : "A"

string shortGrade =
     shortAPlus ? "A+" : "A"

string longLocation =
     outsideLong
     ? "ORB BREAK"
     : longLowRejection
     ? "ORL REJECT"
     : longMidContinuation
     ? "MID CONT"
     : "INSIDE ORB"

string shortLocation =
     outsideShort
     ? "ORB BREAK"
     : shortHighRejection
     ? "ORH REJECT"
     : shortMidContinuation
     ? "MID CONT"
     : "INSIDE ORB"

// ============================================================================
// ENTRIES
// ============================================================================
if finalLongSignal

    tradesToday += 1

    strategy.entry(
         "Long",
         strategy.long,
         comment = longGrade + " LONG",
         alert_message =
             longGrade +
             " LONG | Score " +
             str.tostring(longScore) +
             "/8 | " +
             longLocation)

if finalShortSignal

    tradesToday += 1

    strategy.entry(
         "Short",
         strategy.short,
         comment = shortGrade + " SHORT",
         alert_message =
             shortGrade +
             " SHORT | Score " +
             str.tostring(shortScore) +
             "/8 | " +
             shortLocation)

// ============================================================================
// TRADE RISK STORAGE
// ============================================================================
var float longInitialRisk = na
var float shortInitialRisk = na

bool newLongPosition =
     strategy.position_size > 0 and
     strategy.position_size[1] <= 0

bool newShortPosition =
     strategy.position_size < 0 and
     strategy.position_size[1] >= 0

if newLongPosition
    longInitialRisk :=
         atrValue *
         stopAtrMultiplierInput

if newShortPosition
    shortInitialRisk :=
         atrValue *
         stopAtrMultiplierInput

if strategy.position_size == 0
    longInitialRisk := na
    shortInitialRisk := na

// ============================================================================
// STOPS AND TARGETS
// ============================================================================
float longBaseStop =
     strategy.position_size > 0 and
     not na(longInitialRisk)
     ? strategy.position_avg_price -
       longInitialRisk
     : na

float longTarget =
     strategy.position_size > 0 and
     not na(longInitialRisk)
     ? strategy.position_avg_price +
       longInitialRisk *
       riskRewardInput
     : na

float shortBaseStop =
     strategy.position_size < 0 and
     not na(shortInitialRisk)
     ? strategy.position_avg_price +
       shortInitialRisk
     : na

float shortTarget =
     strategy.position_size < 0 and
     not na(shortInitialRisk)
     ? strategy.position_avg_price -
       shortInitialRisk *
       riskRewardInput
     : na

// ============================================================================
// BREAK EVEN
// ============================================================================
bool longBreakEvenReached =
     strategy.position_size > 0 and
     useBreakEvenInput and
     not na(longInitialRisk) and
     high >=
         strategy.position_avg_price +
         longInitialRisk *
         breakEvenTriggerInput

bool shortBreakEvenReached =
     strategy.position_size < 0 and
     useBreakEvenInput and
     not na(shortInitialRisk) and
     low <=
         strategy.position_avg_price -
         shortInitialRisk *
         breakEvenTriggerInput

var bool longBEActive = false
var bool shortBEActive = false

if newLongPosition
    longBEActive := false

if newShortPosition
    shortBEActive := false

if longBreakEvenReached
    longBEActive := true

if shortBreakEvenReached
    shortBEActive := true

if strategy.position_size == 0
    longBEActive := false
    shortBEActive := false

float activeLongStop =
     longBEActive
     ? math.max(
         longBaseStop,
         strategy.position_avg_price)
     : longBaseStop

float activeShortStop =
     shortBEActive
     ? math.min(
         shortBaseStop,
         strategy.position_avg_price)
     : shortBaseStop

// ============================================================================
// HARD EXITS
// ============================================================================
strategy.exit(
     "Long Target/Stop",
     from_entry = "Long",
     stop = activeLongStop,
     limit = longTarget,
     alert_message = "EXIT LONG: target/stop")

strategy.exit(
     "Short Target/Stop",
     from_entry = "Short",
     stop = activeShortStop,
     limit = shortTarget,
     alert_message = "EXIT SHORT: target/stop")

// ============================================================================
// TREND FAILURE EXITS
// ============================================================================
bool longTrendFailure =
     useTrendExitInput and
     strategy.position_size > 0 and
     close < ema20 and
     close < sessionVwap and
     bearishCandle

bool shortTrendFailure =
     useTrendExitInput and
     strategy.position_size < 0 and
     close > ema20 and
     close > sessionVwap and
     bullishCandle

if longTrendFailure
    strategy.close(
         "Long",
         comment = "Trend Exit",
         alert_message = "EXIT LONG: lost EMA + VWAP")

if shortTrendFailure
    strategy.close(
         "Short",
         comment = "Trend Exit",
         alert_message = "EXIT SHORT: lost EMA + VWAP")

// ============================================================================
// PROP LOCKOUT
// ============================================================================
if propLockout and
     strategy.position_size != 0

    strategy.close_all(
         comment = "Prop Lockout",
         alert_message = "PROP RULE LOCKOUT")

// ============================================================================
// VISUALS
// ============================================================================
bool showRange =
     inRangeSession or
     rangeReady

rangeHighPlot = plot(
     showRange ? rangeHigh : na,
     "ORB High",
     color = rangeHighColorInput,
     linewidth = 2,
     style = plot.style_linebr)

rangeLowPlot = plot(
     showRange ? rangeLow : na,
     "ORB Low",
     color = rangeLowColorInput,
     linewidth = 2,
     style = plot.style_linebr)

plot(
     showMidpointInput and showRange
     ? rangeMid
     : na,
     "ORB Midpoint",
     color = midpointColorInput,
     linewidth = 1,
     style = plot.style_linebr)

fill(
     rangeHighPlot,
     rangeLowPlot,
     color = color.new(
         midpointColorInput,
         94),
     title = "Opening Range")

plot(
     showEmaInput
     ? ema20
     : na,
     "20 EMA",
     color = color.orange,
     linewidth = 2)

plot(
     showVwapStyleInput
     ? sessionVwap
     : na,
     "VWAP",
     color = color.purple,
     linewidth = 2)

// ============================================================================
// ENTRY SIGNALS
// ============================================================================
plotshape(
     showScoreInput and
     finalLongSignal and
     longAPlus,
     title = "A+ Long",
     style = shape.labelup,
     location = location.belowbar,
     color = #00a86b,
     text = "A+ LONG",
     textcolor = color.white,
     size = size.small)

plotshape(
     showScoreInput and
     finalLongSignal and
     longA,
     title = "A Long",
     style = shape.labelup,
     location = location.belowbar,
     color = #089981,
     text = "A LONG",
     textcolor = color.white,
     size = size.tiny)

plotshape(
     showScoreInput and
     finalShortSignal and
     shortAPlus,
     title = "A+ Short",
     style = shape.labeldown,
     location = location.abovebar,
     color = #d60000,
     text = "A+ SHORT",
     textcolor = color.white,
     size = size.small)

plotshape(
     showScoreInput and
     finalShortSignal and
     shortA,
     title = "A Short",
     style = shape.labeldown,
     location = location.abovebar,
     color = #f23645,
     text = "A SHORT",
     textcolor = color.white,
     size = size.tiny)

// ============================================================================
// EXIT SIGNALS
// ============================================================================
plotshape(
     longTrendFailure,
     title = "Exit Long",
     style = shape.xcross,
     location = location.abovebar,
     color = #f23645,
     text = "EXIT L",
     textcolor = color.white,
     size = size.tiny)

plotshape(
     shortTrendFailure,
     title = "Exit Short",
     style = shape.xcross,
     location = location.belowbar,
     color = #089981,
     text = "EXIT S",
     textcolor = color.white,
     size = size.tiny)

// ============================================================================
// ACTIVE STOP / TARGET
// ============================================================================
plot(
     strategy.position_size > 0
     ? activeLongStop
     : strategy.position_size < 0
     ? activeShortStop
     : na,
     "Active Stop",
     color = #f23645,
     linewidth = 1,
     style = plot.style_linebr)

plot(
     strategy.position_size > 0
     ? longTarget
     : strategy.position_size < 0
     ? shortTarget
     : na,
     "Profit Target",
     color = #089981,
     linewidth = 1,
     style = plot.style_linebr)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(
     finalLongSignal and longAPlus,
     "A+ LONG",
     "A+ ORB LONG setup")

alertcondition(
     finalShortSignal and shortAPlus,
     "A+ SHORT",
     "A+ ORB SHORT setup")

alertcondition(
     finalLongSignal and longA,
     "A LONG",
     "A-grade ORB LONG setup")

alertcondition(
     finalShortSignal and shortA,
     "A SHORT",
     "A-grade ORB SHORT setup")

alertcondition(
     longTrendFailure,
     "EXIT LONG",
     "Long lost EMA and VWAP")

alertcondition(
     shortTrendFailure,
     "EXIT SHORT",
     "Short lost EMA and VWAP")

alertcondition(
     propLockout,
     "PROP LOCKOUT",
     "Trading locked by prop risk rules")