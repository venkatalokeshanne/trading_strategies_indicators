//@version=6
indicator("Vasyl Ivanov | Previous Day Liquidity + Swings", overlay = true, max_lines_count = 6)

// A swing is confirmed only after `swingBars` bars have closed to its right.
int swingBars = input.int(2, "Swing bars left/right", minval = 1)
string alertTrigger = input.string("Close crossing", "Alert trigger", options = ["Close crossing", "Wick crossing"])
bool showSignalMarkers = input.bool(true, "Show alert markers")

color previousDayColor = color.gray
color previousSwingColor = color.white

// Return the latest stored pivot high that is both earlier than `beforeTime`
// and strictly above `abovePrice`.
findPreviousHigherPivot(array<int> pivotTimes, array<float> pivotPrices, int beforeTime, float abovePrice) =>
    float foundPrice = na
    int foundTime = na
    int i = array.size(pivotTimes) - 1
    while i >= 0 and na(foundTime)
        int candidateTime = array.get(pivotTimes, i)
        float candidatePrice = array.get(pivotPrices, i)
        if candidateTime < beforeTime and candidatePrice > abovePrice
            foundTime := candidateTime
            foundPrice := candidatePrice
        i -= 1
    [foundPrice, foundTime]

// Return the latest stored pivot low that is both earlier than `beforeTime`
// and strictly below `belowPrice`.
findPreviousLowerPivot(array<int> pivotTimes, array<float> pivotPrices, int beforeTime, float belowPrice) =>
    float foundPrice = na
    int foundTime = na
    int i = array.size(pivotTimes) - 1
    while i >= 0 and na(foundTime)
        int candidateTime = array.get(pivotTimes, i)
        float candidatePrice = array.get(pivotPrices, i)
        if candidateTime < beforeTime and candidatePrice < belowPrice
            foundTime := candidateTime
            foundPrice := candidatePrice
        i -= 1
    [foundPrice, foundTime]

// Confirmed swing history.
var array<int> swingHighTimes = array.new<int>()
var array<float> swingHighPrices = array.new<float>()
var array<int> swingLowTimes = array.new<int>()
var array<float> swingLowPrices = array.new<float>()

float confirmedSwingHigh = ta.pivothigh(high, swingBars, swingBars)
float confirmedSwingLow = ta.pivotlow(low, swingBars, swingBars)

if not na(confirmedSwingHigh)
    array.push(swingHighTimes, time[swingBars])
    array.push(swingHighPrices, confirmedSwingHigh)
    if array.size(swingHighTimes) > 10000
        array.shift(swingHighTimes)
        array.shift(swingHighPrices)

if not na(confirmedSwingLow)
    array.push(swingLowTimes, time[swingBars])
    array.push(swingLowPrices, confirmedSwingLow)
    if array.size(swingLowTimes) > 10000
        array.shift(swingLowTimes)
        array.shift(swingLowPrices)

// Extremes and time boundaries of the day currently being accumulated.
var float activeDayHigh = na
var float activeDayLow = na
var int activeDayHighTime = na
var int activeDayLowTime = na
var int activeDayStartTime = na
var int activeDayEndTime = na

// The last fully completed day.
var float previousDayHigh = na
var float previousDayLow = na
var int previousDayHighTime = na
var int previousDayLowTime = na
var int previousDayStartTime = na
var int previousDayEndTime = na

// Six drawing objects are sufficient: two daily levels, two preceding swings,
// and two vertical day boundaries.
var line previousDayHighLine = na
var line previousDayLowLine = na
var line previousSwingHighLine = na
var line previousSwingLowLine = na
var line previousDayStartLine = na
var line previousDayEndLine = na
var int drawnSwingHighTime = na
var int drawnSwingLowTime = na
var float previousSwingHighPrice = na
var float previousSwingLowPrice = na

bool newDay = timeframe.change("1D")

if na(activeDayHigh)
    activeDayHigh := high
    activeDayLow := low
    activeDayHighTime := time
    activeDayLowTime := time
    activeDayStartTime := time
    activeDayEndTime := time_close
else if newDay
    // Freeze the day that has just ended.
    previousDayHigh := activeDayHigh
    previousDayLow := activeDayLow
    previousDayHighTime := activeDayHighTime
    previousDayLowTime := activeDayLowTime
    previousDayStartTime := activeDayStartTime
    previousDayEndTime := activeDayEndTime

    // Only the latest completed day should remain on the chart.
    if not na(previousDayHighLine)
        line.delete(previousDayHighLine)
    if not na(previousDayLowLine)
        line.delete(previousDayLowLine)
    if not na(previousSwingHighLine)
        line.delete(previousSwingHighLine)
    if not na(previousSwingLowLine)
        line.delete(previousSwingLowLine)
    if not na(previousDayStartLine)
        line.delete(previousDayStartLine)
    if not na(previousDayEndLine)
        line.delete(previousDayEndLine)

    previousSwingHighLine := na
    previousSwingLowLine := na
    drawnSwingHighTime := na
    drawnSwingLowTime := na
    previousSwingHighPrice := na
    previousSwingLowPrice := na

    previousDayHighLine := line.new(previousDayHighTime, previousDayHigh, time, previousDayHigh, xloc = xloc.bar_time, color = previousDayColor, width = 1)
    previousDayLowLine := line.new(previousDayLowTime, previousDayLow, time, previousDayLow, xloc = xloc.bar_time, color = previousDayColor, width = 1)

    // Extend both day boundaries vertically through the whole chart pane.
    float verticalTop = previousDayHigh == previousDayLow ? previousDayHigh + syminfo.mintick : previousDayHigh
    previousDayStartLine := line.new(previousDayStartTime, previousDayLow, previousDayStartTime, verticalTop, xloc = xloc.bar_time, extend = extend.both, color = previousDayColor, width = 1)
    previousDayEndLine := line.new(previousDayEndTime, previousDayLow, previousDayEndTime, verticalTop, xloc = xloc.bar_time, extend = extend.both, color = previousDayColor, width = 1)

    // Start accumulating the new day with its first bar.
    activeDayHigh := high
    activeDayLow := low
    activeDayHighTime := time
    activeDayLowTime := time
    activeDayStartTime := time
    activeDayEndTime := time_close
else
    activeDayEndTime := time_close
    if high > activeDayHigh
        activeDayHigh := high
        activeDayHighTime := time
    if low < activeDayLow
        activeDayLow := low
        activeDayLowTime := time

// Re-evaluate on every bar. This matters when a pivot immediately before the
// completed day's extreme is confirmed only after the new day has begun.
if not na(previousDayHighTime)
    [foundSwingHighPrice, foundSwingHighTime] = findPreviousHigherPivot(swingHighTimes, swingHighPrices, previousDayHighTime, previousDayHigh)
    if not na(foundSwingHighTime) and (na(drawnSwingHighTime) or foundSwingHighTime != drawnSwingHighTime)
        if not na(previousSwingHighLine)
            line.delete(previousSwingHighLine)
        previousSwingHighLine := line.new(foundSwingHighTime, foundSwingHighPrice, time, foundSwingHighPrice, xloc = xloc.bar_time, color = previousSwingColor, width = 1)
        drawnSwingHighTime := foundSwingHighTime
        previousSwingHighPrice := foundSwingHighPrice

if not na(previousDayLowTime)
    [foundSwingLowPrice, foundSwingLowTime] = findPreviousLowerPivot(swingLowTimes, swingLowPrices, previousDayLowTime, previousDayLow)
    if not na(foundSwingLowTime) and (na(drawnSwingLowTime) or foundSwingLowTime != drawnSwingLowTime)
        if not na(previousSwingLowLine)
            line.delete(previousSwingLowLine)
        previousSwingLowLine := line.new(foundSwingLowTime, foundSwingLowPrice, time, foundSwingLowPrice, xloc = xloc.bar_time, color = previousSwingColor, width = 1)
        drawnSwingLowTime := foundSwingLowTime
        previousSwingLowPrice := foundSwingLowPrice

// Keep all four horizontal levels attached to the latest bar.
if not na(previousDayHighLine)
    line.set_x2(previousDayHighLine, time)
if not na(previousDayLowLine)
    line.set_x2(previousDayLowLine, time)
if not na(previousSwingHighLine)
    line.set_x2(previousSwingHighLine, time)
if not na(previousSwingLowLine)
    line.set_x2(previousSwingLowLine, time)

// A level must remain unchanged for at least one bar. This prevents false
// crosses when the previous-day levels are replaced at the start of a new day
// or when a newly confirmed swing becomes available.
crossedUp(float level) =>
    bool stableLevel = not na(level) and not na(level[1]) and level == level[1]
    bool closeCross = ta.crossover(close, level)
    bool wickCross = high >= level and high[1] < level
    stableLevel and (alertTrigger == "Close crossing" ? closeCross : wickCross)

crossedDown(float level) =>
    bool stableLevel = not na(level) and not na(level[1]) and level == level[1]
    bool closeCross = ta.crossunder(close, level)
    bool wickCross = low <= level and low[1] > level
    stableLevel and (alertTrigger == "Close crossing" ? closeCross : wickCross)

bool previousDayHighCrossed = crossedUp(previousDayHigh) or crossedDown(previousDayHigh)
bool previousDayLowCrossed = crossedUp(previousDayLow) or crossedDown(previousDayLow)
bool previousSwingHighCrossed = crossedUp(previousSwingHighPrice) or crossedDown(previousSwingHighPrice)
bool previousSwingLowCrossed = crossedUp(previousSwingLowPrice) or crossedDown(previousSwingLowPrice)

bool anyGrayLevelCrossed = previousDayHighCrossed or previousDayLowCrossed
bool anyWhiteLevelCrossed = previousSwingHighCrossed or previousSwingLowCrossed
bool anyLevelCrossed = anyGrayLevelCrossed or anyWhiteLevelCrossed

alertcondition(previousDayHighCrossed, "Previous Day High crossed", "Price crossed the previous day high (gray line) on {{ticker}} at {{close}}.")
alertcondition(previousDayLowCrossed, "Previous Day Low crossed", "Price crossed the previous day low (gray line) on {{ticker}} at {{close}}.")
alertcondition(previousSwingHighCrossed, "Previous Swing High crossed", "Price crossed the previous higher swing (white line) on {{ticker}} at {{close}}.")
alertcondition(previousSwingLowCrossed, "Previous Swing Low crossed", "Price crossed the previous lower swing (white line) on {{ticker}} at {{close}}.")
alertcondition(anyGrayLevelCrossed, "Any gray level crossed", "Price crossed a previous-day gray level on {{ticker}} at {{close}}.")
alertcondition(anyWhiteLevelCrossed, "Any white level crossed", "Price crossed a previous-swing white level on {{ticker}} at {{close}}.")
alertcondition(anyLevelCrossed, "Any indicator level crossed", "Price crossed a gray or white indicator level on {{ticker}} at {{close}}.")

plotshape(showSignalMarkers and anyGrayLevelCrossed, title = "Gray level cross marker", style = shape.circle, location = location.abovebar, color = color.gray, size = size.tiny)
plotshape(showSignalMarkers and anyWhiteLevelCrossed, title = "White level cross marker", style = shape.circle, location = location.belowbar, color = color.white, size = size.tiny)

if not timeframe.isintraday
    runtime.error("Use this indicator on an intraday chart.")
