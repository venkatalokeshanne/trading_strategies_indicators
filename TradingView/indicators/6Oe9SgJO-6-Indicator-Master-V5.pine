//@version=6
indicator("6 Indicator Master V5", shorttitle="6X MASTER V5", overlay=true, max_labels_count=500)

//==================================================
// SETTINGS
//==================================================
atrLength = input.int(14, "ATR Length", minval=1)
atrMultiplier = input.float(1.0, "ATR Stop Multiplier", minval=0.1, step=0.1)
showLevels = input.bool(true, "Show Entry / SL / TP")

//==================================================
// 1. CM MACD
//==================================================
macdFast = ta.ema(close, 12)
macdSlow = ta.ema(close, 26)
macdLine = macdFast - macdSlow
macdSignal = ta.sma(macdLine, 9)
macdHist = macdLine - macdSignal

macdBear = macdLine < macdSignal and macdHist <= 0
macdBull = macdLine > macdSignal and macdHist >= 0

//==================================================
// 2. SQUEEZE MOMENTUM
//==================================================
sqLen = 20

sqHigh = ta.highest(high, sqLen)
sqLow = ta.lowest(low, sqLen)
sqAverage = ta.sma(close, sqLen)

sqSource = close - ((sqHigh + sqLow) / 2 + sqAverage) / 2
sqValue = ta.linreg(sqSource, sqLen, 0)

sqBear = sqValue < 0 and sqValue < sqValue[1]
sqBull = sqValue > 0 and sqValue > sqValue[1]

//==================================================
// 3. WAVETREND
//==================================================
wtN1 = 10
wtN2 = 21

wtAP = hlc3
wtESA = ta.ema(wtAP, wtN1)
wtD = ta.ema(math.abs(wtAP - wtESA), wtN1)

wtCI = wtD != 0 ? (wtAP - wtESA) / (0.015 * wtD) : 0

wt1 = ta.ema(wtCI, wtN2)
wt2 = ta.sma(wt1, 4)

wtBear = wt1 < wt2
wtBull = wt1 > wt2

//==================================================
// 4. BULL BEAR POWER TREND
//==================================================
bullTrend = (close - ta.lowest(low, 50)) / ta.atr(5)
bearTrend = (ta.highest(high, 50) - close) / ta.atr(5)

bbTrend = bullTrend - bearTrend

bbBear = bbTrend < 0
bbBull = bbTrend > 0

//==================================================
// 5. SUPERTREND
//==================================================
[stLine, stDirection] = ta.supertrend(3.0, 10)

stBear = stDirection > 0
stBull = stDirection < 0

//==================================================
// 6. TRADE PRO REJECTION ZONE
//==================================================
fastMA = ta.ema(close, 20)
slowMA = ta.ema(close, 50)

rzBear = fastMA < slowMA
rzBull = fastMA > slowMA

//==================================================
// COUNT
//==================================================
bearCount = 0
bearCount := bearCount + (macdBear ? 1 : 0)
bearCount := bearCount + (sqBear ? 1 : 0)
bearCount := bearCount + (wtBear ? 1 : 0)
bearCount := bearCount + (bbBear ? 1 : 0)
bearCount := bearCount + (stBear ? 1 : 0)
bearCount := bearCount + (rzBear ? 1 : 0)

bullCount = 0
bullCount := bullCount + (macdBull ? 1 : 0)
bullCount := bullCount + (sqBull ? 1 : 0)
bullCount := bullCount + (bbBull ? 1 : 0)
bullCount := bullCount + (wtBull ? 1 : 0)
bullCount := bullCount + (stBull ? 1 : 0)
bullCount := bullCount + (rzBull ? 1 : 0)

allBear = bearCount == 6
allBull = bullCount == 6

bearTrigger = allBear and not allBear[1]
bullTrigger = allBull and not allBull[1]

//==================================================
// ATR / 1:1 RR
//==================================================
atrValue = ta.atr(atrLength)
riskDistance = atrValue * atrMultiplier

//==================================================
// TRADE VARIABLES
//==================================================
var bool tradeActive = false
var int tradeDirection = 0
var float entryPrice = na
var float stopPrice = na
var float targetPrice = na

var int totalTrades = 0
var int winningTrades = 0
var int losingTrades = 0

//==================================================
// NEW LONG
//==================================================
if bullTrigger and not tradeActive
    tradeActive := true
    tradeDirection := 1
    entryPrice := close
    stopPrice := close - riskDistance
    targetPrice := close + riskDistance
    totalTrades := totalTrades + 1

//==================================================
// NEW SHORT
//==================================================
if bearTrigger and not tradeActive
    tradeActive := true
    tradeDirection := -1
    entryPrice := close
    stopPrice := close + riskDistance
    targetPrice := close - riskDistance
    totalTrades := totalTrades + 1

//==================================================
// LONG RESULT
//==================================================
if tradeActive and tradeDirection == 1

    longStopHit = low <= stopPrice
    longTargetHit = high >= targetPrice

    if longStopHit and longTargetHit
        losingTrades := losingTrades + 1
        tradeActive := false
        tradeDirection := 0

    else if longStopHit
        losingTrades := losingTrades + 1
        tradeActive := false
        tradeDirection := 0

    else if longTargetHit
        winningTrades := winningTrades + 1
        tradeActive := false
        tradeDirection := 0

//==================================================
// SHORT RESULT
//==================================================
if tradeActive and tradeDirection == -1

    shortStopHit = high >= stopPrice
    shortTargetHit = low <= targetPrice

    if shortStopHit and shortTargetHit
        losingTrades := losingTrades + 1
        tradeActive := false
        tradeDirection := 0

    else if shortStopHit
        losingTrades := losingTrades + 1
        tradeActive := false
        tradeDirection := 0

    else if shortTargetHit
        winningTrades := winningTrades + 1
        tradeActive := false
        tradeDirection := 0

//==================================================
// STATISTICS
//==================================================
closedTrades = winningTrades + losingTrades

winRate = closedTrades > 0 ? winningTrades * 100.0 / closedTrades : 0.0

//==================================================
// SIGNALS
//==================================================
plotshape(bearTrigger, title="6/6 Bearish", style=shape.labeldown, location=location.abovebar, text="6/6 BEAR", color=color.red, textcolor=color.white)

plotshape(bullTrigger, title="6/6 Bullish", style=shape.labelup, location=location.belowbar, text="6/6 BULL", color=color.green, textcolor=color.white)

//==================================================
// ENTRY / SL / TP
//==================================================
plot(showLevels and tradeActive ? entryPrice : na, title="Entry", color=color.blue, linewidth=2, style=plot.style_linebr)

plot(showLevels and tradeActive ? stopPrice : na, title="Stop Loss", color=color.red, linewidth=2, style=plot.style_linebr)

plot(showLevels and tradeActive ? targetPrice : na, title="Take Profit", color=color.green, linewidth=2, style=plot.style_linebr)

//==================================================
// ALERTS
//==================================================
alertcondition(bearTrigger, title="V5 - 6/6 BEARISH", message="V5: ALL 6 INDICATORS ARE BEARISH")

alertcondition(bullTrigger, title="V5 - 6/6 BULLISH", message="V5: ALL 6 INDICATORS ARE BULLISH")

//==================================================
// DASHBOARD
//==================================================
var table dash = table.new(position.top_right, 2, 12, border_width=1)

if barstate.islast

    table.cell(dash, 0, 0, "6X MASTER V5", bgcolor=color.black, text_color=color.white)
    table.cell(dash, 1, 0, "STATISTICS", bgcolor=color.black, text_color=color.white)

    table.cell(dash, 0, 1, "Bearish")
    table.cell(dash, 1, 1, str.tostring(bearCount) + " / 6", bgcolor=allBear ? color.red : color.gray, text_color=color.white)

    table.cell(dash, 0, 2, "Bullish")
    table.cell(dash, 1, 2, str.tostring(bullCount) + " / 6", bgcolor=allBull ? color.green : color.gray, text_color=color.white)

    table.cell(dash, 0, 3, "Total Trades")
    table.cell(dash, 1, 3, str.tostring(totalTrades))

    table.cell(dash, 0, 4, "Wins")
    table.cell(dash, 1, 4, str.tostring(winningTrades), bgcolor=color.green, text_color=color.white)

    table.cell(dash, 0, 5, "Losses")
    table.cell(dash, 1, 5, str.tostring(losingTrades), bgcolor=color.red, text_color=color.white)

    table.cell(dash, 0, 6, "Win Rate")
    table.cell(dash, 1, 6, str.tostring(winRate, "#.##") + "%", bgcolor=winRate >= 50 ? color.green : color.red, text_color=color.white)

    table.cell(dash, 0, 7, "Risk : Reward")
    table.cell(dash, 1, 7, "1 : 1")

    table.cell(dash, 0, 8, "ATR")
    table.cell(dash, 1, 8, str.tostring(atrValue, "#.#####"))

    table.cell(dash, 0, 9, "Current Trade")
    table.cell(dash, 1, 9, tradeActive ? tradeDirection == 1 ? "LONG" : "SHORT" : "NONE", bgcolor=tradeActive ? tradeDirection == 1 ? color.green : color.red : color.gray, text_color=color.white)

    table.cell(dash, 0, 10, "MASTER")
    table.cell(dash, 1, 10, allBear ? "BEARISH" : allBull ? "BULLISH" : "WAIT", bgcolor=allBear ? color.red : allBull ? color.green : color.gray, text_color=color.white)

    table.cell(dash, 0, 11, "Closed")
    table.cell(dash, 1, 11, str.tostring(closedTrades))