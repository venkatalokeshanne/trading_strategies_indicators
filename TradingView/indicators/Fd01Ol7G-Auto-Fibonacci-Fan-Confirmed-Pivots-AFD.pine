                else if priorStableSide == SIDE_TESTING
                    array.set(levelStableSides, levelIndex, currentSide)
                else if currentSide != priorStableSide
                    eventType := currentSide == SIDE_ABOVE ? EVENT_BREAK_UP : EVENT_BREAK_DOWN
                    array.set(levelBreakSides, levelIndex, currentSide)
