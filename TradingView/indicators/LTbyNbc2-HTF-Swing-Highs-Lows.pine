//@version=6
indicator(
     "HTF Swing Highs & Lows",
     overlay = true,
     max_lines_count = 500,
     max_labels_count = 500)

//=============================================================================
// Inputs
//=============================================================================

string GROUP_SWINGS = "Swing Detection"

int weeklyStrength = input.int(2, "Weekly pivot strength", minval = 1, group = GROUP_SWINGS)
int dailyStrength = input.int(3, "Daily pivot strength", minval = 1, group = GROUP_SWINGS)
int fourHourStrength = input.int(4, "4H pivot strength", minval = 1, group = GROUP_SWINGS)
int oneHourStrength = input.int(5, "1H pivot strength", minval = 1, group = GROUP_SWINGS)
int thirtyMinuteStrength = input.int(6, "30m pivot strength", minval = 1, group = GROUP_SWINGS)

//=============================================================================
// Visibility
//=============================================================================

string GROUP_VISIBILITY = "Visibility"

bool showWeekly = input.bool(true, "Weekly levels", group = GROUP_VISIBILITY)
bool showDaily = input.bool(true, "Daily levels", group = GROUP_VISIBILITY)
bool showFourHour = input.bool(true, "4H levels", group = GROUP_VISIBILITY)
bool showOneHour = input.bool(false, "1H levels", group = GROUP_VISIBILITY)
bool showThirtyMinute = input.bool(false, "30m levels", group = GROUP_VISIBILITY)

bool hierarchicalVisibility = input.bool(
     true,
     "Only on equal or lower chart timeframes",
     tooltip = "W displays on Weekly and lower charts. D on Daily and lower. H4 on 4H and lower. H1 on 1H and lower. M30 on 30m and lower.",
     group = GROUP_VISIBILITY)

//=============================================================================
// Level Management
//=============================================================================

string GROUP_MANAGEMENT = "Level Management"

string breakMethod = input.string(
     "Wick",
     "Invalidation method",
     options = ["Wick", "Close", "Never"],
     group = GROUP_MANAGEMENT)

string breakAction = input.string(
     "Stop",
     "When invalidated",
     options = ["Stop", "Delete"],
     group = GROUP_MANAGEMENT)

int maximumLevelsPerSet = input.int(
     25,
     "Maximum levels per timeframe and direction",
     minval = 1,
     maxval = 50,
     group = GROUP_MANAGEMENT)

//=============================================================================
// TF Labels
//=============================================================================

string GROUP_LABELS = "TF Labels"

bool showTfLabels = input.bool(
     true,
     "Timeframe labels",
     group = GROUP_LABELS)

int labelOffsetBars = input.int(
     -6,
     "Base label offset bars",
     tooltip = "Moves the whole label stack left/right. M30 uses this base position.",
     minval = -20,
     maxval = 20,
     group = GROUP_LABELS)

int labelOffsetTicks = input.int(
     2,
     "Label vertical offset ticks",
     tooltip = "Moves timeframe text slightly above its horizontal level.",
     minval = 0,
     maxval = 20,
     group = GROUP_LABELS)

string labelSizeInput = input.string(
     "Small",
     "Label size",
     options = ["Tiny", "Small", "Normal"],
     group = GROUP_LABELS)

f_labelSize() =>
    labelSizeInput == "Tiny" ? size.tiny :
     labelSizeInput == "Normal" ? size.normal :
     size.small

//=============================================================================
// Style
//=============================================================================

string GROUP_STYLE = "Style"

color weeklyHighColor = input.color(color.red, "Weekly swing highs", group = GROUP_STYLE)
color weeklyLowColor = input.color(color.lime, "Weekly swing lows", group = GROUP_STYLE)

color dailyHighColor = input.color(color.orange, "Daily swing highs", group = GROUP_STYLE)
color dailyLowColor = input.color(color.aqua, "Daily swing lows", group = GROUP_STYLE)

color fourHourHighColor = input.color(color.fuchsia, "4H swing highs", group = GROUP_STYLE)
color fourHourLowColor = input.color(color.blue, "4H swing lows", group = GROUP_STYLE)

color oneHourHighColor = input.color(color.maroon, "1H swing highs", group = GROUP_STYLE)
color oneHourLowColor = input.color(color.teal, "1H swing lows", group = GROUP_STYLE)

color thirtyMinuteHighColor = input.color(color.yellow, "30m swing highs", group = GROUP_STYLE)
color thirtyMinuteLowColor = input.color(color.purple, "30m swing lows", group = GROUP_STYLE)

int weeklyWidth = input.int(3, "Weekly line width", minval = 1, maxval = 5, group = GROUP_STYLE)
int dailyWidth = input.int(2, "Daily line width", minval = 1, maxval = 5, group = GROUP_STYLE)
int fourHourWidth = input.int(1, "4H line width", minval = 1, maxval = 5, group = GROUP_STYLE)
int oneHourWidth = input.int(1, "1H line width", minval = 1, maxval = 5, group = GROUP_STYLE)
int thirtyMinuteWidth = input.int(1, "30m line width", minval = 1, maxval = 5, group = GROUP_STYLE)

//=============================================================================
// Timeframes
//=============================================================================

string WEEKLY_TF = "1W"
string DAILY_TF = "1D"
string FOUR_HOUR_TF = "240"
string ONE_HOUR_TF = "60"
string THIRTY_MINUTE_TF = "30"

//=============================================================================
// Label offsets by timeframe
//=============================================================================

int THIRTY_MINUTE_LABEL_OFFSET = 0
int ONE_HOUR_LABEL_OFFSET = 3
int FOUR_HOUR_LABEL_OFFSET = 6
int DAILY_LABEL_OFFSET = 9
int WEEKLY_LABEL_OFFSET = 12

//=============================================================================
// Pivot Calculations
//=============================================================================

f_pivotHigh(int strength) =>
    ta.pivothigh(high, strength, strength)

f_pivotLow(int strength) =>
    ta.pivotlow(low, strength, strength)

f_pivotHighTime(int strength) =>
    float pivotValue = ta.pivothigh(high, strength, strength)
    int result = na

    if not na(pivotValue)
        result := time[strength]

    result

f_pivotLowTime(int strength) =>
    float pivotValue = ta.pivotlow(low, strength, strength)
    int result = na

    if not na(pivotValue)
        result := time[strength]

    result

//=============================================================================
// Visibility
//=============================================================================

f_isTimeframeVisible(string sourceTimeframe) =>
    float chartSeconds = timeframe.in_seconds(timeframe.period)
    float sourceSeconds = timeframe.in_seconds(sourceTimeframe)

    bool visible = true

    if hierarchicalVisibility
        visible := na(chartSeconds) or
             na(sourceSeconds) or
             chartSeconds <= sourceSeconds

    visible

//=============================================================================
// Invalidation
//=============================================================================

f_levelIsBroken(float levelPrice, bool isSwingHigh) =>
    bool result = false

    if breakMethod == "Wick"
        result := isSwingHigh
             ? high > levelPrice
             : low < levelPrice

    else if breakMethod == "Close"
        result := isSwingHigh
             ? close > levelPrice
             : close < levelPrice

    else
        result := false

    result

//=============================================================================
// Object Management
//=============================================================================

f_removeOldest(
     array<line> lineArray,
     array<label> labelArray,
     array<float> priceArray,
     array<bool> activeArray) =>

    bool removed = false

    if array.size(lineArray) > 0
        line oldestLine = array.shift(lineArray)
        label oldestLabel = array.shift(labelArray)

        array.shift(priceArray)
        array.shift(activeArray)

        if not na(oldestLine)
            line.delete(oldestLine)

        if not na(oldestLabel)
            label.delete(oldestLabel)

        removed := true

    removed

f_limitCollection(
     array<line> lineArray,
     array<label> labelArray,
     array<float> priceArray,
     array<bool> activeArray) =>

    bool trimmed = false

    while array.size(lineArray) > maximumLevelsPerSet
        f_removeOldest(
             lineArray,
             labelArray,
             priceArray,
             activeArray)

        trimmed := true

    trimmed

f_addLevel(
     array<line> lineArray,
     array<label> labelArray,
     array<float> priceArray,
     array<bool> activeArray,
     int swingTime,
     float swingPrice,
     color levelColor,
     int levelWidth,
     string levelStyle,
     string tfText,
     int tfOffset) =>

    line newLevel = line.new(
         x1 = swingTime,
         y1 = swingPrice,
         x2 = time,
         y2 = swingPrice,
         xloc = xloc.bar_time,
         extend = extend.right,
         color = levelColor,
         style = levelStyle,
         width = levelWidth)

    label newLabel = na

    if showTfLabels
        float labelY = swingPrice + syminfo.mintick * labelOffsetTicks

        newLabel := label.new(
             x = bar_index + labelOffsetBars + tfOffset,
             y = labelY,
             text = tfText,
             xloc = xloc.bar_index,
             style = label.style_none,
             textcolor = levelColor,
             color = color.new(color.black, 100),
             size = f_labelSize())

    array.push(lineArray, newLevel)
    array.push(labelArray, newLabel)
    array.push(priceArray, swingPrice)
    array.push(activeArray, true)

    f_limitCollection(
         lineArray,
         labelArray,
         priceArray,
         activeArray)

    true

f_manageLevels(
     array<line> lineArray,
     array<label> labelArray,
     array<float> priceArray,
     array<bool> activeArray,
     bool isSwingHigh) =>

    bool changed = false
    int numberOfLevels = array.size(lineArray)

    if numberOfLevels > 0
        for index = numberOfLevels - 1 to 0
            bool levelIsActive = array.get(
                 activeArray,
                 index)

            if levelIsActive
                float levelPrice = array.get(
                     priceArray,
                     index)

                bool levelBroken = f_levelIsBroken(
                     levelPrice,
                     isSwingHigh)

                if levelBroken
                    line levelLine = array.get(
                         lineArray,
                         index)

                    label levelLabel = array.get(
                         labelArray,
                         index)

                    if breakAction == "Delete"
                        if not na(levelLine)
                            line.delete(levelLine)

                        if not na(levelLabel)
                            label.delete(levelLabel)

                        array.remove(
                             lineArray,
                             index)

                        array.remove(
                             labelArray,
                             index)

                        array.remove(
                             priceArray,
                             index)

                        array.remove(
                             activeArray,
                             index)

                        changed := true

                    else
                        if not na(levelLine)
                            line.set_extend(
                                 levelLine,
                                 extend.none)

                            line.set_x2(
                                 levelLine,
                                 time)

                        array.set(
                             activeArray,
                             index,
                             false)

                        changed := true

    changed

f_updateLabels(
     array<label> labelArray,
     array<float> priceArray,
     array<bool> activeArray,
     int tfOffset) =>

    bool updated = false
    int count = array.size(labelArray)

    if count > 0
        for index = 0 to count - 1
            label currentLabel = array.get(
                 labelArray,
                 index)

            if not na(currentLabel)
                bool isActive = array.get(
                     activeArray,
                     index)

                if isActive
                    float levelPrice = array.get(
                         priceArray,
                         index)

                    float labelY =
                         levelPrice +
                         syminfo.mintick * labelOffsetTicks

                    label.set_x(
                         currentLabel,
                         bar_index + labelOffsetBars + tfOffset)

                    label.set_y(
                         currentLabel,
                         labelY)

                    label.set_size(
                         currentLabel,
                         f_labelSize())

                    updated := true

    updated

//=============================================================================
// Persistent Arrays
//=============================================================================

// Weekly
var array<line> weeklyHighLines = array.new<line>()
var array<label> weeklyHighLabels = array.new<label>()
var array<float> weeklyHighPrices = array.new<float>()
var array<bool> weeklyHighActive = array.new<bool>()

var array<line> weeklyLowLines = array.new<line>()
var array<label> weeklyLowLabels = array.new<label>()
var array<float> weeklyLowPrices = array.new<float>()
var array<bool> weeklyLowActive = array.new<bool>()

// Daily
var array<line> dailyHighLines = array.new<line>()
var array<label> dailyHighLabels = array.new<label>()
var array<float> dailyHighPrices = array.new<float>()
var array<bool> dailyHighActive = array.new<bool>()

var array<line> dailyLowLines = array.new<line>()
var array<label> dailyLowLabels = array.new<label>()
var array<float> dailyLowPrices = array.new<float>()
var array<bool> dailyLowActive = array.new<bool>()

// 4H
var array<line> fourHourHighLines = array.new<line>()
var array<label> fourHourHighLabels = array.new<label>()
var array<float> fourHourHighPrices = array.new<float>()
var array<bool> fourHourHighActive = array.new<bool>()

var array<line> fourHourLowLines = array.new<line>()
var array<label> fourHourLowLabels = array.new<label>()
var array<float> fourHourLowPrices = array.new<float>()
var array<bool> fourHourLowActive = array.new<bool>()

// 1H
var array<line> oneHourHighLines = array.new<line>()
var array<label> oneHourHighLabels = array.new<label>()
var array<float> oneHourHighPrices = array.new<float>()
var array<bool> oneHourHighActive = array.new<bool>()

var array<line> oneHourLowLines = array.new<line>()
var array<label> oneHourLowLabels = array.new<label>()
var array<float> oneHourLowPrices = array.new<float>()
var array<bool> oneHourLowActive = array.new<bool>()

// 30m
var array<line> thirtyMinuteHighLines = array.new<line>()
var array<label> thirtyMinuteHighLabels = array.new<label>()
var array<float> thirtyMinuteHighPrices = array.new<float>()
var array<bool> thirtyMinuteHighActive = array.new<bool>()

var array<line> thirtyMinuteLowLines = array.new<line>()
var array<label> thirtyMinuteLowLabels = array.new<label>()
var array<float> thirtyMinuteLowPrices = array.new<float>()
var array<bool> thirtyMinuteLowActive = array.new<bool>()

//=============================================================================
// Weekly Data
//=============================================================================

float weeklyPivotHigh = request.security(
     syminfo.tickerid,
     WEEKLY_TF,
     f_pivotHigh(weeklyStrength),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off)

int weeklyPivotHighTime = request.security(
     syminfo.tickerid,
     WEEKLY_TF,
     f_pivotHighTime(weeklyStrength),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off)

float weeklyPivotLow = request.security(
     syminfo.tickerid,
     WEEKLY_TF,
     f_pivotLow(weeklyStrength),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off)

int weeklyPivotLowTime = request.security(
     syminfo.tickerid,
     WEEKLY_TF,
     f_pivotLowTime(weeklyStrength),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off)

//=============================================================================
// Daily Data
//=============================================================================

float dailyPivotHigh = request.security(
     syminfo.tickerid,
     DAILY_TF,
     f_pivotHigh(dailyStrength),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off)

int dailyPivotHighTime = request.security(
     syminfo.tickerid,
     DAILY_TF,
     f_pivotHighTime(dailyStrength),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off)

float dailyPivotLow = request.security(
     syminfo.tickerid,
     DAILY_TF,
     f_pivotLow(dailyStrength),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off)

int dailyPivotLowTime = request.security(
     syminfo.tickerid,
     DAILY_TF,
     f_pivotLowTime(dailyStrength),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off)

//=============================================================================
// 4H Data
//=============================================================================

float fourHourPivotHigh = request.security(
     syminfo.tickerid,
     FOUR_HOUR_TF,
     f_pivotHigh(fourHourStrength),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off)

int fourHourPivotHighTime = request.security(
     syminfo.tickerid,
     FOUR_HOUR_TF,
     f_pivotHighTime(fourHourStrength),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off)

float fourHourPivotLow = request.security(
     syminfo.tickerid,
     FOUR_HOUR_TF,
     f_pivotLow(fourHourStrength),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off)

int fourHourPivotLowTime = request.security(
     syminfo.tickerid,
     FOUR_HOUR_TF,
     f_pivotLowTime(fourHourStrength),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off)

//=============================================================================
// 1H Data
//=============================================================================

float oneHourPivotHigh = request.security(
     syminfo.tickerid,
     ONE_HOUR_TF,
     f_pivotHigh(oneHourStrength),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off)

int oneHourPivotHighTime = request.security(
     syminfo.tickerid,
     ONE_HOUR_TF,
     f_pivotHighTime(oneHourStrength),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off)

float oneHourPivotLow = request.security(
     syminfo.tickerid,
     ONE_HOUR_TF,
     f_pivotLow(oneHourStrength),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off)

int oneHourPivotLowTime = request.security(
     syminfo.tickerid,
     ONE_HOUR_TF,
     f_pivotLowTime(oneHourStrength),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off)

//=============================================================================
// 30m Data
//=============================================================================

float thirtyMinutePivotHigh = request.security(
     syminfo.tickerid,
     THIRTY_MINUTE_TF,
     f_pivotHigh(thirtyMinuteStrength),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off)

int thirtyMinutePivotHighTime = request.security(
     syminfo.tickerid,
     THIRTY_MINUTE_TF,
     f_pivotHighTime(thirtyMinuteStrength),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off)

float thirtyMinutePivotLow = request.security(
     syminfo.tickerid,
     THIRTY_MINUTE_TF,
     f_pivotLow(thirtyMinuteStrength),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off)

int thirtyMinutePivotLowTime = request.security(
     syminfo.tickerid,
     THIRTY_MINUTE_TF,
     f_pivotLowTime(thirtyMinuteStrength),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off)

//=============================================================================
// Visibility States
//=============================================================================

bool weeklyVisible =
     showWeekly and
     f_isTimeframeVisible(WEEKLY_TF)

bool dailyVisible =
     showDaily and
     f_isTimeframeVisible(DAILY_TF)

bool fourHourVisible =
     showFourHour and
     f_isTimeframeVisible(FOUR_HOUR_TF)

bool oneHourVisible =
     showOneHour and
     f_isTimeframeVisible(ONE_HOUR_TF)

bool thirtyMinuteVisible =
     showThirtyMinute and
     f_isTimeframeVisible(THIRTY_MINUTE_TF)

//=============================================================================
// Add Weekly Levels
//=============================================================================

if weeklyVisible
    if not na(weeklyPivotHigh) and not na(weeklyPivotHighTime)
        f_addLevel(
             weeklyHighLines,
             weeklyHighLabels,
             weeklyHighPrices,
             weeklyHighActive,
             weeklyPivotHighTime,
             weeklyPivotHigh,
             weeklyHighColor,
             weeklyWidth,
             line.style_solid,
             "W",
             WEEKLY_LABEL_OFFSET)

    if not na(weeklyPivotLow) and not na(weeklyPivotLowTime)
        f_addLevel(
             weeklyLowLines,
             weeklyLowLabels,
             weeklyLowPrices,
             weeklyLowActive,
             weeklyPivotLowTime,
             weeklyPivotLow,
             weeklyLowColor,
             weeklyWidth,
             line.style_solid,
             "W",
             WEEKLY_LABEL_OFFSET)

//=============================================================================
// Add Daily Levels
//=============================================================================

if dailyVisible
    if not na(dailyPivotHigh) and not na(dailyPivotHighTime)
        f_addLevel(
             dailyHighLines,
             dailyHighLabels,
             dailyHighPrices,
             dailyHighActive,
             dailyPivotHighTime,
             dailyPivotHigh,
             dailyHighColor,
             dailyWidth,
             line.style_dashed,
             "D",
             DAILY_LABEL_OFFSET)

    if not na(dailyPivotLow) and not na(dailyPivotLowTime)
        f_addLevel(
             dailyLowLines,
             dailyLowLabels,
             dailyLowPrices,
             dailyLowActive,
             dailyPivotLowTime,
             dailyPivotLow,
             dailyLowColor,
             dailyWidth,
             line.style_dashed,
             "D",
             DAILY_LABEL_OFFSET)

//=============================================================================
// Add 4H Levels
//=============================================================================

if fourHourVisible
    if not na(fourHourPivotHigh) and not na(fourHourPivotHighTime)
        f_addLevel(
             fourHourHighLines,
             fourHourHighLabels,
             fourHourHighPrices,
             fourHourHighActive,
             fourHourPivotHighTime,
             fourHourPivotHigh,
             fourHourHighColor,
             fourHourWidth,
             line.style_dotted,
             "H4",
             FOUR_HOUR_LABEL_OFFSET)

    if not na(fourHourPivotLow) and not na(fourHourPivotLowTime)
        f_addLevel(
             fourHourLowLines,
             fourHourLowLabels,
             fourHourLowPrices,
             fourHourLowActive,
             fourHourPivotLowTime,
             fourHourPivotLow,
             fourHourLowColor,
             fourHourWidth,
             line.style_dotted,
             "H4",
             FOUR_HOUR_LABEL_OFFSET)

//=============================================================================
// Add 1H Levels
//=============================================================================

if oneHourVisible
    if not na(oneHourPivotHigh) and not na(oneHourPivotHighTime)
        f_addLevel(
             oneHourHighLines,
             oneHourHighLabels,
             oneHourHighPrices,
             oneHourHighActive,
             oneHourPivotHighTime,
             oneHourPivotHigh,
             oneHourHighColor,
             oneHourWidth,
             line.style_dashed,
             "H1",
             ONE_HOUR_LABEL_OFFSET)

    if not na(oneHourPivotLow) and not na(oneHourPivotLowTime)
        f_addLevel(
             oneHourLowLines,
             oneHourLowLabels,
             oneHourLowPrices,
             oneHourLowActive,
             oneHourPivotLowTime,
             oneHourPivotLow,
             oneHourLowColor,
             oneHourWidth,
             line.style_dashed,
             "H1",
             ONE_HOUR_LABEL_OFFSET)

//=============================================================================
// Add 30m Levels
//=============================================================================

if thirtyMinuteVisible
    if not na(thirtyMinutePivotHigh) and not na(thirtyMinutePivotHighTime)
        f_addLevel(
             thirtyMinuteHighLines,
             thirtyMinuteHighLabels,
             thirtyMinuteHighPrices,
             thirtyMinuteHighActive,
             thirtyMinutePivotHighTime,
             thirtyMinutePivotHigh,
             thirtyMinuteHighColor,
             thirtyMinuteWidth,
             line.style_dotted,
             "M30",
             THIRTY_MINUTE_LABEL_OFFSET)

    if not na(thirtyMinutePivotLow) and not na(thirtyMinutePivotLowTime)
        f_addLevel(
             thirtyMinuteLowLines,
             thirtyMinuteLowLabels,
             thirtyMinuteLowPrices,
             thirtyMinuteLowActive,
             thirtyMinutePivotLowTime,
             thirtyMinutePivotLow,
             thirtyMinuteLowColor,
             thirtyMinuteWidth,
             line.style_dotted,
             "M30",
             THIRTY_MINUTE_LABEL_OFFSET)

//=============================================================================
// Manage Weekly Levels
//=============================================================================

if weeklyVisible
    f_manageLevels(
         weeklyHighLines,
         weeklyHighLabels,
         weeklyHighPrices,
         weeklyHighActive,
         true)

    f_manageLevels(
         weeklyLowLines,
         weeklyLowLabels,
         weeklyLowPrices,
         weeklyLowActive,
         false)

//=============================================================================
// Manage Daily Levels
//=============================================================================

if dailyVisible
    f_manageLevels(
         dailyHighLines,
         dailyHighLabels,
         dailyHighPrices,
         dailyHighActive,
         true)

    f_manageLevels(
         dailyLowLines,
         dailyLowLabels,
         dailyLowPrices,
         dailyLowActive,
         false)

//=============================================================================
// Manage 4H Levels
//=============================================================================

if fourHourVisible
    f_manageLevels(
         fourHourHighLines,
         fourHourHighLabels,
         fourHourHighPrices,
         fourHourHighActive,
         true)

    f_manageLevels(
         fourHourLowLines,
         fourHourLowLabels,
         fourHourLowPrices,
         fourHourLowActive,
         false)

//=============================================================================
// Manage 1H Levels
//=============================================================================

if oneHourVisible
    f_manageLevels(
         oneHourHighLines,
         oneHourHighLabels,
         oneHourHighPrices,
         oneHourHighActive,
         true)

    f_manageLevels(
         oneHourLowLines,
         oneHourLowLabels,
         oneHourLowPrices,
         oneHourLowActive,
         false)

//=============================================================================
// Manage 30m Levels
//=============================================================================

if thirtyMinuteVisible
    f_manageLevels(
         thirtyMinuteHighLines,
         thirtyMinuteHighLabels,
         thirtyMinuteHighPrices,
         thirtyMinuteHighActive,
         true)

    f_manageLevels(
         thirtyMinuteLowLines,
         thirtyMinuteLowLabels,
         thirtyMinuteLowPrices,
         thirtyMinuteLowActive,
         false)

//=============================================================================
// Keep Active Labels Anchored Right
//=============================================================================

if weeklyVisible
    f_updateLabels(
         weeklyHighLabels,
         weeklyHighPrices,
         weeklyHighActive,
         WEEKLY_LABEL_OFFSET)

    f_updateLabels(
         weeklyLowLabels,
         weeklyLowPrices,
         weeklyLowActive,
         WEEKLY_LABEL_OFFSET)

if dailyVisible
    f_updateLabels(
         dailyHighLabels,
         dailyHighPrices,
         dailyHighActive,
         DAILY_LABEL_OFFSET)

    f_updateLabels(
         dailyLowLabels,
         dailyLowPrices,
         dailyLowActive,
         DAILY_LABEL_OFFSET)

if fourHourVisible
    f_updateLabels(
         fourHourHighLabels,
         fourHourHighPrices,
         fourHourHighActive,
         FOUR_HOUR_LABEL_OFFSET)

    f_updateLabels(
         fourHourLowLabels,
         fourHourLowPrices,
         fourHourLowActive,
         FOUR_HOUR_LABEL_OFFSET)

if oneHourVisible
    f_updateLabels(
         oneHourHighLabels,
         oneHourHighPrices,
         oneHourHighActive,
         ONE_HOUR_LABEL_OFFSET)

    f_updateLabels(
         oneHourLowLabels,
         oneHourLowPrices,
         oneHourLowActive,
         ONE_HOUR_LABEL_OFFSET)

if thirtyMinuteVisible
    f_updateLabels(
         thirtyMinuteHighLabels,
         thirtyMinuteHighPrices,
         thirtyMinuteHighActive,
         THIRTY_MINUTE_LABEL_OFFSET)

    f_updateLabels(
         thirtyMinuteLowLabels,
         thirtyMinuteLowPrices,
         thirtyMinuteLowActive,
         THIRTY_MINUTE_LABEL_OFFSET)