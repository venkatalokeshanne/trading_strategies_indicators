//@version=6
indicator("Statistical Reversal Zones", overlay=true, max_labels_count=500)

//=============================================================================
// SALQITRADER -  STATISTICAL REVERSAL ZONES
//=============================================================================
// Daily statistical levels are anchored to the CURRENT DAY'S OPEN.
//
//   R1 +0.33%   R2 +0.64%   R3 +1.02%   R4 +1.38%
//   S1 -0.47%   S2 -0.84%   S3 -1.31%   S4 -1.76%
//
// Instead of showing only a single line, this version creates a configurable
// ZONE around every statistical level.
//
// DEFAULT zone half-width = 0.05 percentage points of the Daily Open.
// Example:
//   R1 center = +0.33%
//   R1 zone   = +0.28% to +0.38%
//
// The zones are intended as statistical reaction areas around the historical
// Price daily movement levels. No probability values are displayed.
//=============================================================================


//=============================================================================
// 1. INPUTS
//=============================================================================
groupLevels = "1. Statistical Zone Centers"

r1Pct = input.float(0.33, "R1 center % above Open", step=0.01, group=groupLevels)
r2Pct = input.float(0.64, "R2 center % above Open", step=0.01, group=groupLevels)
r3Pct = input.float(1.02, "R3 center % above Open", step=0.01, group=groupLevels)
r4Pct = input.float(1.38, "R4 center % above Open", step=0.01, group=groupLevels)

s1Pct = input.float(0.47, "S1 center % below Open", step=0.01, group=groupLevels)
s2Pct = input.float(0.84, "S2 center % below Open", step=0.01, group=groupLevels)
s3Pct = input.float(1.31, "S3 center % below Open", step=0.01, group=groupLevels)
s4Pct = input.float(1.76, "S4 center % below Open", step=0.01, group=groupLevels)


groupZones = "2. Reversal Zone Width"
zoneHalfWidthPct = input.float(
     0.05,
     "Zone Half Width (% of Daily Open)",
     minval=0.01,
     step=0.01,
     group=groupZones,
     tooltip="Default 0.05 means each zone extends 0.05 percentage points on both sides of its center. Example: R1 +0.33% becomes +0.28% to +0.38%.")

showR1 = input.bool(true, "Show R1 Zone", group=groupZones)
showR2 = input.bool(true, "Show R2 Zone", group=groupZones)
showR3 = input.bool(true, "Show R3 Zone", group=groupZones)
showR4 = input.bool(true, "Show R4 Zone", group=groupZones)
showS1 = input.bool(true, "Show S1 Zone", group=groupZones)
showS2 = input.bool(true, "Show S2 Zone", group=groupZones)
showS3 = input.bool(true, "Show S3 Zone", group=groupZones)
showS4 = input.bool(true, "Show S4 Zone", group=groupZones)


groupSignals = "3. Zone Entry / Reversal Indications"
confirmZoneEntryOnClose = input.bool(
     true,
     "Confirm Zone Entry on Candle Close",
     group=groupSignals,
     tooltip="ON is recommended for non-repainting signals. The label appears after the chart candle closes.")

showZoneEntryLabels = input.bool(true, "Show Zone Entry Labels", group=groupSignals)
showConfirmedReversal = input.bool(true, "Show Confirmed Rejection Labels", group=groupSignals)

showZonePrices = input.bool(true, "Show Zone Price Range in Labels", group=groupSignals)


groupDisplay = "4. Display"
showDayOpen = input.bool(true, "Show Daily Open", group=groupDisplay)
showCenterLines = input.bool(false, "Show Zone Center Lines", group=groupDisplay)
showDashboard = input.bool(true, "Show Dashboard", group=groupDisplay)
zoneTransparency = input.int(84, "Zone Transparency", minval=0, maxval=100, group=groupDisplay)


groupAlerts = "5. Alerts"
enableDynamicAlerts = input.bool(true, "Enable alert() Messages", group=groupAlerts)


//=============================================================================
// 2. DAILY OPEN
//=============================================================================
// The Daily Open is fixed as soon as the session begins.
// lookahead_on is safe specifically for DAILY OPEN because the value is already
// known on the first intraday bar. This keeps historical labels, plotted zones,
// and the dashboard anchored to the exact same day's Open.
dayOpen = request.security(
     syminfo.tickerid,
     "D",
     open,
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

newDay = ta.change(time("D")) != 0


//=============================================================================
// 3. CENTER LEVELS
//=============================================================================
r1Center = dayOpen * (1.0 + r1Pct / 100.0)
r2Center = dayOpen * (1.0 + r2Pct / 100.0)
r3Center = dayOpen * (1.0 + r3Pct / 100.0)
r4Center = dayOpen * (1.0 + r4Pct / 100.0)

s1Center = dayOpen * (1.0 - s1Pct / 100.0)
s2Center = dayOpen * (1.0 - s2Pct / 100.0)
s3Center = dayOpen * (1.0 - s3Pct / 100.0)
s4Center = dayOpen * (1.0 - s4Pct / 100.0)


//=============================================================================
// 4. ZONE BOUNDARIES
//=============================================================================
// Resistance:
// lower = inner edge, closer to Daily Open
// upper = outer edge, farther above Daily Open
r1Lower = dayOpen * (1.0 + (r1Pct - zoneHalfWidthPct) / 100.0)
r1Upper = dayOpen * (1.0 + (r1Pct + zoneHalfWidthPct) / 100.0)

r2Lower = dayOpen * (1.0 + (r2Pct - zoneHalfWidthPct) / 100.0)
r2Upper = dayOpen * (1.0 + (r2Pct + zoneHalfWidthPct) / 100.0)

r3Lower = dayOpen * (1.0 + (r3Pct - zoneHalfWidthPct) / 100.0)
r3Upper = dayOpen * (1.0 + (r3Pct + zoneHalfWidthPct) / 100.0)

r4Lower = dayOpen * (1.0 + (r4Pct - zoneHalfWidthPct) / 100.0)
r4Upper = dayOpen * (1.0 + (r4Pct + zoneHalfWidthPct) / 100.0)

// Support:
// upper = inner edge, closer to Daily Open
// lower = outer edge, farther below Daily Open
s1Upper = dayOpen * (1.0 - (s1Pct - zoneHalfWidthPct) / 100.0)
s1Lower = dayOpen * (1.0 - (s1Pct + zoneHalfWidthPct) / 100.0)

s2Upper = dayOpen * (1.0 - (s2Pct - zoneHalfWidthPct) / 100.0)
s2Lower = dayOpen * (1.0 - (s2Pct + zoneHalfWidthPct) / 100.0)

s3Upper = dayOpen * (1.0 - (s3Pct - zoneHalfWidthPct) / 100.0)
s3Lower = dayOpen * (1.0 - (s3Pct + zoneHalfWidthPct) / 100.0)

s4Upper = dayOpen * (1.0 - (s4Pct - zoneHalfWidthPct) / 100.0)
s4Lower = dayOpen * (1.0 - (s4Pct + zoneHalfWidthPct) / 100.0)


//=============================================================================
// 5. PLOT DAILY OPEN + REVERSAL ZONES
//=============================================================================
plot(
     showDayOpen ? dayOpen : na,
     "Daily Open",
     color=color.new(color.yellow, 0),
     linewidth=2,
     style=plot.style_linebr)

// R1
r1LowPlot = plot(showR1 ? r1Lower : na, "R1 Zone Inner", color=color.new(color.red, 45), linewidth=1, style=plot.style_linebr)
r1UpPlot  = plot(showR1 ? r1Upper : na, "R1 Zone Outer", color=color.new(color.red, 45), linewidth=1, style=plot.style_linebr)
fill(r1LowPlot, r1UpPlot, color=color.new(color.red, zoneTransparency), title="R1 Reversal Zone")

// R2
r2LowPlot = plot(showR2 ? r2Lower : na, "R2 Zone Inner", color=color.new(color.red, 35), linewidth=1, style=plot.style_linebr)
r2UpPlot  = plot(showR2 ? r2Upper : na, "R2 Zone Outer", color=color.new(color.red, 35), linewidth=1, style=plot.style_linebr)
fill(r2LowPlot, r2UpPlot, color=color.new(color.red, zoneTransparency - 4 < 0 ? 0 : zoneTransparency - 4), title="R2 Reversal Zone")

// R3
r3LowPlot = plot(showR3 ? r3Lower : na, "R3 Zone Inner", color=color.new(color.red, 20), linewidth=1, style=plot.style_linebr)
r3UpPlot  = plot(showR3 ? r3Upper : na, "R3 Zone Outer", color=color.new(color.red, 20), linewidth=1, style=plot.style_linebr)
fill(r3LowPlot, r3UpPlot, color=color.new(color.red, zoneTransparency - 8 < 0 ? 0 : zoneTransparency - 8), title="R3 Reversal Zone")

// R4
r4LowPlot = plot(showR4 ? r4Lower : na, "R4 Zone Inner", color=color.new(color.maroon, 5), linewidth=1, style=plot.style_linebr)
r4UpPlot  = plot(showR4 ? r4Upper : na, "R4 Zone Outer", color=color.new(color.maroon, 5), linewidth=1, style=plot.style_linebr)
fill(r4LowPlot, r4UpPlot, color=color.new(color.maroon, zoneTransparency - 12 < 0 ? 0 : zoneTransparency - 12), title="R4 Reversal Zone")

// S1
s1LowPlot = plot(showS1 ? s1Lower : na, "S1 Zone Outer", color=color.new(color.lime, 45), linewidth=1, style=plot.style_linebr)
s1UpPlot  = plot(showS1 ? s1Upper : na, "S1 Zone Inner", color=color.new(color.lime, 45), linewidth=1, style=plot.style_linebr)
fill(s1LowPlot, s1UpPlot, color=color.new(color.lime, zoneTransparency), title="S1 Reversal Zone")

// S2
s2LowPlot = plot(showS2 ? s2Lower : na, "S2 Zone Outer", color=color.new(color.lime, 35), linewidth=1, style=plot.style_linebr)
s2UpPlot  = plot(showS2 ? s2Upper : na, "S2 Zone Inner", color=color.new(color.lime, 35), linewidth=1, style=plot.style_linebr)
fill(s2LowPlot, s2UpPlot, color=color.new(color.lime, zoneTransparency - 4 < 0 ? 0 : zoneTransparency - 4), title="S2 Reversal Zone")

// S3
s3LowPlot = plot(showS3 ? s3Lower : na, "S3 Zone Outer", color=color.new(color.lime, 20), linewidth=1, style=plot.style_linebr)
s3UpPlot  = plot(showS3 ? s3Upper : na, "S3 Zone Inner", color=color.new(color.lime, 20), linewidth=1, style=plot.style_linebr)
fill(s3LowPlot, s3UpPlot, color=color.new(color.lime, zoneTransparency - 8 < 0 ? 0 : zoneTransparency - 8), title="S3 Reversal Zone")

// S4
s4LowPlot = plot(showS4 ? s4Lower : na, "S4 Zone Outer", color=color.new(color.teal, 5), linewidth=1, style=plot.style_linebr)
s4UpPlot  = plot(showS4 ? s4Upper : na, "S4 Zone Inner", color=color.new(color.teal, 5), linewidth=1, style=plot.style_linebr)
fill(s4LowPlot, s4UpPlot, color=color.new(color.teal, zoneTransparency - 12 < 0 ? 0 : zoneTransparency - 12), title="S4 Reversal Zone")

// Optional center lines
plot(showCenterLines and showR1 ? r1Center : na, "R1 Center", color=color.new(color.red, 0), linewidth=1, style=plot.style_linebr)
plot(showCenterLines and showR2 ? r2Center : na, "R2 Center", color=color.new(color.red, 0), linewidth=1, style=plot.style_linebr)
plot(showCenterLines and showR3 ? r3Center : na, "R3 Center", color=color.new(color.red, 0), linewidth=1, style=plot.style_linebr)
plot(showCenterLines and showR4 ? r4Center : na, "R4 Center", color=color.new(color.maroon, 0), linewidth=1, style=plot.style_linebr)

plot(showCenterLines and showS1 ? s1Center : na, "S1 Center", color=color.new(color.lime, 0), linewidth=1, style=plot.style_linebr)
plot(showCenterLines and showS2 ? s2Center : na, "S2 Center", color=color.new(color.lime, 0), linewidth=1, style=plot.style_linebr)
plot(showCenterLines and showS3 ? s3Center : na, "S3 Center", color=color.new(color.lime, 0), linewidth=1, style=plot.style_linebr)
plot(showCenterLines and showS4 ? s4Center : na, "S4 Center", color=color.new(color.teal, 0), linewidth=1, style=plot.style_linebr)


//=============================================================================
// 6. DAILY STATE
//=============================================================================
var bool r1Entered = false
var bool r2Entered = false
var bool r3Entered = false
var bool r4Entered = false

var bool s1Entered = false
var bool s2Entered = false
var bool s3Entered = false
var bool s4Entered = false

var bool r1Rejected = false
var bool r2Rejected = false
var bool r3Rejected = false
var bool r4Rejected = false

var bool s1Rejected = false
var bool s2Rejected = false
var bool s3Rejected = false
var bool s4Rejected = false

// Persistent BROKEN state for the current trading day.
// Once a confirmed candle closes beyond the OUTER edge of a zone,
// that zone remains BROKEN in the dashboard for the rest of the day.
var bool r1BrokenDay = false
var bool r2BrokenDay = false
var bool r3BrokenDay = false
var bool r4BrokenDay = false
var bool s1BrokenDay = false
var bool s2BrokenDay = false
var bool s3BrokenDay = false
var bool s4BrokenDay = false

// Separate rejection counters for every zone.
// Example: R1 can print 1, 2, 3... independently from S1.
// All counters reset at the start of each trading day.
var int r1Count = 0
var int r2Count = 0
var int r3Count = 0
var int r4Count = 0
var int s1Count = 0
var int s2Count = 0
var int s3Count = 0
var int s4Count = 0

if newDay
    r1Entered := false
    r2Entered := false
    r3Entered := false
    r4Entered := false

    s1Entered := false
    s2Entered := false
    s3Entered := false
    s4Entered := false

    r1Rejected := false
    r2Rejected := false
    r3Rejected := false
    r4Rejected := false

    s1Rejected := false
    s2Rejected := false
    s3Rejected := false
    s4Rejected := false

    r1BrokenDay := false
    r2BrokenDay := false
    r3BrokenDay := false
    r4BrokenDay := false
    s1BrokenDay := false
    s2BrokenDay := false
    s3BrokenDay := false
    s4BrokenDay := false

    r1Count := 0
    r2Count := 0
    r3Count := 0
    r4Count := 0
    s1Count := 0
    s2Count := 0
    s3Count := 0
    s4Count := 0


//=============================================================================
// 7. ZONE ENTRY DETECTION
//=============================================================================
// Candle range overlaps the zone.
r1Inside = high >= r1Lower and low <= r1Upper
r2Inside = high >= r2Lower and low <= r2Upper
r3Inside = high >= r3Lower and low <= r3Upper
r4Inside = high >= r4Lower and low <= r4Upper

s1Inside = high >= s1Lower and low <= s1Upper
s2Inside = high >= s2Lower and low <= s2Upper
s3Inside = high >= s3Lower and low <= s3Upper
s4Inside = high >= s4Lower and low <= s4Upper

entryAllowed = not confirmZoneEntryOnClose or barstate.isconfirmed

// A fresh entry occurs when price transitions from outside the zone into it.
// After a confirmed rejection, that zone becomes ready to count the next
// separate touch/rejection cycle as 2, 3, 4...
r1FreshEntry = r1Inside and not r1Inside[1]
r2FreshEntry = r2Inside and not r2Inside[1]
r3FreshEntry = r3Inside and not r3Inside[1]
r4FreshEntry = r4Inside and not r4Inside[1]

s1FreshEntry = s1Inside and not s1Inside[1]
s2FreshEntry = s2Inside and not s2Inside[1]
s3FreshEntry = s3Inside and not s3Inside[1]
s4FreshEntry = s4Inside and not s4Inside[1]

r1EntryNow = entryAllowed and showR1 and r1FreshEntry
r2EntryNow = entryAllowed and showR2 and r2FreshEntry
r3EntryNow = entryAllowed and showR3 and r3FreshEntry
r4EntryNow = entryAllowed and showR4 and r4FreshEntry

s1EntryNow = entryAllowed and showS1 and s1FreshEntry
s2EntryNow = entryAllowed and showS2 and s2FreshEntry
s3EntryNow = entryAllowed and showS3 and s3FreshEntry
s4EntryNow = entryAllowed and showS4 and s4FreshEntry


//=============================================================================
// 8. LABEL HELPERS
//=============================================================================
// Display behavior:
// First reversal at a zone: one detailed label beginning with "1 •".
// Second and later reversals: only small number labels "2", "3", "4"... are shown.
// No separate number "1" label is plotted.
//=============================================================================
f_zoneText(string name, float lower, float upper, string side) =>
    txt = "1 • " + name + " REVERSAL ZONE"
    txt += side == "R" ? "\nResistance watch" : "\nSupport watch"
    txt += showZonePrices ? "\n" + str.tostring(lower, format.mintick) + " - " + str.tostring(upper, format.mintick) : ""
    txt

f_rejectionText(string name, string arrow) =>
    name + " REJECTION " + arrow


//=============================================================================
// 9. PROCESS ZONE ENTRIES
//=============================================================================
if r1EntryNow
    r1Rejected := false
    r1Entered := true
    // Show the detailed zone label only before the FIRST confirmed rejection.
    // From rejection 2 onward, only the numbered rejection label is displayed.
    if showZoneEntryLabels and r1Count == 0
        label.new(bar_index, r1Upper, f_zoneText("R1", r1Lower, r1Upper, "R"),
             style=label.style_label_down, color=color.new(color.red, 5), textcolor=color.white, size=size.small)
    if enableDynamicAlerts
        alert("Price entered R1 reversal zone", alert.freq_once_per_bar_close)

if r2EntryNow
    r2Rejected := false
    r2Entered := true
    // Show the detailed zone label only before the FIRST confirmed rejection.
    // From rejection 2 onward, only the numbered rejection label is displayed.
    if showZoneEntryLabels and r2Count == 0
        label.new(bar_index, r2Upper, f_zoneText("R2", r2Lower, r2Upper, "R"),
             style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.small)
    if enableDynamicAlerts
        alert("Price entered R2 reversal zone", alert.freq_once_per_bar_close)

if r3EntryNow
    r3Rejected := false
    r3Entered := true
    // Show the detailed zone label only before the FIRST confirmed rejection.
    // From rejection 2 onward, only the numbered rejection label is displayed.
    if showZoneEntryLabels and r3Count == 0
        label.new(bar_index, r3Upper, f_zoneText("R3", r3Lower, r3Upper, "R"),
             style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.small)
    if enableDynamicAlerts
        alert("Price entered R3 reversal zone", alert.freq_once_per_bar_close)

if r4EntryNow
    r4Rejected := false
    r4Entered := true
    // Show the detailed zone label only before the FIRST confirmed rejection.
    // From rejection 2 onward, only the numbered rejection label is displayed.
    if showZoneEntryLabels and r4Count == 0
        label.new(bar_index, r4Upper, f_zoneText("R4", r4Lower, r4Upper, "R"),
             style=label.style_label_down, color=color.new(color.maroon, 0), textcolor=color.white, size=size.small)
    if enableDynamicAlerts
        alert("Price entered R4 reversal zone", alert.freq_once_per_bar_close)

if s1EntryNow
    s1Rejected := false
    s1Entered := true
    // Show the detailed zone label only before the FIRST confirmed rejection.
    // From rejection 2 onward, only the numbered rejection label is displayed.
    if showZoneEntryLabels and s1Count == 0
        label.new(bar_index, s1Lower, f_zoneText("S1", s1Lower, s1Upper, "S"),
             style=label.style_label_up, color=color.new(color.green, 5), textcolor=color.white, size=size.small)
    if enableDynamicAlerts
        alert("Price entered S1 reversal zone", alert.freq_once_per_bar_close)

if s2EntryNow
    s2Rejected := false
    s2Entered := true
    // Show the detailed zone label only before the FIRST confirmed rejection.
    // From rejection 2 onward, only the numbered rejection label is displayed.
    if showZoneEntryLabels and s2Count == 0
        label.new(bar_index, s2Lower, f_zoneText("S2", s2Lower, s2Upper, "S"),
             style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.small)
    if enableDynamicAlerts
        alert("Price entered S2 reversal zone", alert.freq_once_per_bar_close)

if s3EntryNow
    s3Rejected := false
    s3Entered := true
    // Show the detailed zone label only before the FIRST confirmed rejection.
    // From rejection 2 onward, only the numbered rejection label is displayed.
    if showZoneEntryLabels and s3Count == 0
        label.new(bar_index, s3Lower, f_zoneText("S3", s3Lower, s3Upper, "S"),
             style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.small)
    if enableDynamicAlerts
        alert("Price entered S3 reversal zone", alert.freq_once_per_bar_close)

if s4EntryNow
    s4Rejected := false
    s4Entered := true
    // Show the detailed zone label only before the FIRST confirmed rejection.
    // From rejection 2 onward, only the numbered rejection label is displayed.
    if showZoneEntryLabels and s4Count == 0
        label.new(bar_index, s4Lower, f_zoneText("S4", s4Lower, s4Upper, "S"),
             style=label.style_label_up, color=color.new(color.teal, 0), textcolor=color.white, size=size.small)
    if enableDynamicAlerts
        alert("Price entered S4 reversal zone", alert.freq_once_per_bar_close)


//=============================================================================
// 10. BROKEN ZONE DETECTION
//=============================================================================
// A resistance zone is BROKEN when a confirmed candle closes ABOVE its OUTER edge.
// A support zone is BROKEN when a confirmed candle closes BELOW its OUTER edge.
//
// This is intentionally separate from "IN/TOUCHED" and "REJECTED" states.

// "Break event" occurs on the first confirmed close through the OUTER edge.
r1BreakNow = barstate.isconfirmed and not r1BrokenDay and close > r1Upper
r2BreakNow = barstate.isconfirmed and not r2BrokenDay and close > r2Upper
r3BreakNow = barstate.isconfirmed and not r3BrokenDay and close > r3Upper
r4BreakNow = barstate.isconfirmed and not r4BrokenDay and close > r4Upper

s1BreakNow = barstate.isconfirmed and not s1BrokenDay and close < s1Lower
s2BreakNow = barstate.isconfirmed and not s2BrokenDay and close < s2Lower
s3BreakNow = barstate.isconfirmed and not s3BrokenDay and close < s3Lower
s4BreakNow = barstate.isconfirmed and not s4BrokenDay and close < s4Lower

if r1BreakNow
    r1BrokenDay := true
if r2BreakNow
    r2BrokenDay := true
if r3BreakNow
    r3BrokenDay := true
if r4BreakNow
    r4BrokenDay := true

if s1BreakNow
    s1BrokenDay := true
if s2BreakNow
    s2BrokenDay := true
if s3BreakNow
    s3BrokenDay := true
if s4BreakNow
    s4BrokenDay := true


//=============================================================================
// 11. CONFIRMED REJECTION / REVERSAL REACTION
//=============================================================================
// Resistance rejection:
// price entered the zone and a confirmed candle closes BELOW the INNER edge.
//
// Support rejection:
// price entered the zone and a confirmed candle closes ABOVE the INNER edge.
//
// This gives a live reaction confirmation. It is not a prediction.
//
// Each confirmed touch -> rejection cycle increments that zone's own counter.
// Example for R1 during one day:
//   first R1 rejection  = label 1
//   second R1 rejection = label 2
//   third R1 rejection  = label 3
//
// S1/S2/S3/S4 and R2/R3/R4 maintain their own independent counters.
r1RejectNow = showConfirmedReversal and r1Entered and barstate.isconfirmed and close < r1Lower
r2RejectNow = showConfirmedReversal and r2Entered and barstate.isconfirmed and close < r2Lower
r3RejectNow = showConfirmedReversal and r3Entered and barstate.isconfirmed and close < r3Lower
r4RejectNow = showConfirmedReversal and r4Entered and barstate.isconfirmed and close < r4Lower

s1RejectNow = showConfirmedReversal and s1Entered and barstate.isconfirmed and close > s1Upper
s2RejectNow = showConfirmedReversal and s2Entered and barstate.isconfirmed and close > s2Upper
s3RejectNow = showConfirmedReversal and s3Entered and barstate.isconfirmed and close > s3Upper
s4RejectNow = showConfirmedReversal and s4Entered and barstate.isconfirmed and close > s4Upper

if r1RejectNow
    r1Rejected := true
    r1Entered := false
    r1Count += 1
    // The first reversal number is already included in the detailed zone label.
    // Starting from the second reversal, display only the small numbered label.
    if r1Count > 1
        label.new(bar_index, high, str.tostring(r1Count),
             style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.small,
             tooltip=f_rejectionText("R1", "↓"))

if r2RejectNow
    r2Rejected := true
    r2Entered := false
    r2Count += 1
    // The first reversal number is already included in the detailed zone label.
    // Starting from the second reversal, display only the small numbered label.
    if r2Count > 1
        label.new(bar_index, high, str.tostring(r2Count),
             style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.small,
             tooltip=f_rejectionText("R2", "↓"))

if r3RejectNow
    r3Rejected := true
    r3Entered := false
    r3Count += 1
    // The first reversal number is already included in the detailed zone label.
    // Starting from the second reversal, display only the small numbered label.
    if r3Count > 1
        label.new(bar_index, high, str.tostring(r3Count),
             style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.small,
             tooltip=f_rejectionText("R3", "↓"))

if r4RejectNow
    r4Rejected := true
    r4Entered := false
    r4Count += 1
    // The first reversal number is already included in the detailed zone label.
    // Starting from the second reversal, display only the small numbered label.
    if r4Count > 1
        label.new(bar_index, high, str.tostring(r4Count),
             style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.small,
             tooltip=f_rejectionText("R4", "↓"))

if s1RejectNow
    s1Rejected := true
    s1Entered := false
    s1Count += 1
    // The first reversal number is already included in the detailed zone label.
    // Starting from the second reversal, display only the small numbered label.
    if s1Count > 1
        label.new(bar_index, low, str.tostring(s1Count),
             style=label.style_label_up, color=color.aqua, textcolor=color.black, size=size.small,
             tooltip=f_rejectionText("S1", "↑"))

if s2RejectNow
    s2Rejected := true
    s2Entered := false
    s2Count += 1
    // The first reversal number is already included in the detailed zone label.
    // Starting from the second reversal, display only the small numbered label.
    if s2Count > 1
        label.new(bar_index, low, str.tostring(s2Count),
             style=label.style_label_up, color=color.aqua, textcolor=color.black, size=size.small,
             tooltip=f_rejectionText("S2", "↑"))

if s3RejectNow
    s3Rejected := true
    s3Entered := false
    s3Count += 1
    // The first reversal number is already included in the detailed zone label.
    // Starting from the second reversal, display only the small numbered label.
    if s3Count > 1
        label.new(bar_index, low, str.tostring(s3Count),
             style=label.style_label_up, color=color.aqua, textcolor=color.black, size=size.small,
             tooltip=f_rejectionText("S3", "↑"))

if s4RejectNow
    s4Rejected := true
    s4Entered := false
    s4Count += 1
    // The first reversal number is already included in the detailed zone label.
    // Starting from the second reversal, display only the small numbered label.
    if s4Count > 1
        label.new(bar_index, low, str.tostring(s4Count),
             style=label.style_label_up, color=color.aqua, textcolor=color.black, size=size.small,
             tooltip=f_rejectionText("S4", "↑"))


//=============================================================================
// 12. DASHBOARD
//=============================================================================
// LOW/HIGH always use the exact same lower/upper prices printed in zone labels.
// BROKEN is persistent for the entire trading day after a confirmed close
// beyond the zone's outer edge.
//=============================================================================
var table dash = table.new(
     position.top_right,
     4,
     10,
     bgcolor=color.new(color.black, 15),
     border_width=1,
     frame_width=1)

f_state(bool entered, bool rejected, bool broken) =>
    broken ? "BROKEN" : rejected ? "REJECTED" : entered ? "IN/TOUCHED" : "WAITING"

f_stateColor(bool entered, bool rejected, bool broken) =>
    broken ? color.new(color.red, 0) : rejected ? color.new(color.aqua, 15) : entered ? color.new(color.yellow, 15) : color.new(color.gray, 75)

if barstate.islast and showDashboard
    table.cell(dash, 0, 0, "ZONE", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 0, "LOW", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 2, 0, "HIGH", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 3, 0, "STATE", text_color=color.white, bgcolor=color.new(color.black, 0))

    table.cell(dash, 0, 1, "R1", text_color=color.red)
    table.cell(dash, 1, 1, str.tostring(r1Lower, format.mintick), text_color=color.white)
    table.cell(dash, 2, 1, str.tostring(r1Upper, format.mintick), text_color=color.white)
    table.cell(dash, 3, 1, f_state(r1Entered, r1Rejected, r1BrokenDay), text_color=color.white, bgcolor=f_stateColor(r1Entered, r1Rejected, r1BrokenDay))

    table.cell(dash, 0, 2, "R2", text_color=color.red)
    table.cell(dash, 1, 2, str.tostring(r2Lower, format.mintick), text_color=color.white)
    table.cell(dash, 2, 2, str.tostring(r2Upper, format.mintick), text_color=color.white)
    table.cell(dash, 3, 2, f_state(r2Entered, r2Rejected, r2BrokenDay), text_color=color.white, bgcolor=f_stateColor(r2Entered, r2Rejected, r2BrokenDay))

    table.cell(dash, 0, 3, "R3", text_color=color.red)
    table.cell(dash, 1, 3, str.tostring(r3Lower, format.mintick), text_color=color.white)
    table.cell(dash, 2, 3, str.tostring(r3Upper, format.mintick), text_color=color.white)
    table.cell(dash, 3, 3, f_state(r3Entered, r3Rejected, r3BrokenDay), text_color=color.white, bgcolor=f_stateColor(r3Entered, r3Rejected, r3BrokenDay))

    table.cell(dash, 0, 4, "R4", text_color=color.maroon)
    table.cell(dash, 1, 4, str.tostring(r4Lower, format.mintick), text_color=color.white)
    table.cell(dash, 2, 4, str.tostring(r4Upper, format.mintick), text_color=color.white)
    table.cell(dash, 3, 4, f_state(r4Entered, r4Rejected, r4BrokenDay), text_color=color.white, bgcolor=f_stateColor(r4Entered, r4Rejected, r4BrokenDay))

    table.cell(dash, 0, 5, "S1", text_color=color.lime)
    table.cell(dash, 1, 5, str.tostring(s1Lower, format.mintick), text_color=color.white)
    table.cell(dash, 2, 5, str.tostring(s1Upper, format.mintick), text_color=color.white)
    table.cell(dash, 3, 5, f_state(s1Entered, s1Rejected, s1BrokenDay), text_color=color.white, bgcolor=f_stateColor(s1Entered, s1Rejected, s1BrokenDay))

    table.cell(dash, 0, 6, "S2", text_color=color.lime)
    table.cell(dash, 1, 6, str.tostring(s2Lower, format.mintick), text_color=color.white)
    table.cell(dash, 2, 6, str.tostring(s2Upper, format.mintick), text_color=color.white)
    table.cell(dash, 3, 6, f_state(s2Entered, s2Rejected, s2BrokenDay), text_color=color.white, bgcolor=f_stateColor(s2Entered, s2Rejected, s2BrokenDay))

    table.cell(dash, 0, 7, "S3", text_color=color.lime)
    table.cell(dash, 1, 7, str.tostring(s3Lower, format.mintick), text_color=color.white)
    table.cell(dash, 2, 7, str.tostring(s3Upper, format.mintick), text_color=color.white)
    table.cell(dash, 3, 7, f_state(s3Entered, s3Rejected, s3BrokenDay), text_color=color.white, bgcolor=f_stateColor(s3Entered, s3Rejected, s3BrokenDay))

    table.cell(dash, 0, 8, "S4", text_color=color.teal)
    table.cell(dash, 1, 8, str.tostring(s4Lower, format.mintick), text_color=color.white)
    table.cell(dash, 2, 8, str.tostring(s4Upper, format.mintick), text_color=color.white)
    table.cell(dash, 3, 8, f_state(s4Entered, s4Rejected, s4BrokenDay), text_color=color.white, bgcolor=f_stateColor(s4Entered, s4Rejected, s4BrokenDay))

    table.cell(dash, 0, 9, "OPEN", text_color=color.yellow)
    table.cell(dash, 1, 9, str.tostring(dayOpen, format.mintick), text_color=color.yellow)
    table.cell(dash, 2, 9, "ZONE WIDTH", text_color=color.silver)
    table.cell(dash, 3, 9, "ACTIVE", text_color=color.silver)

if barstate.islast and not showDashboard
    table.clear(dash, 0, 0, 3, 9)

