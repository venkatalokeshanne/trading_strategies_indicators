//@version=6
indicator("144000人", overlay=true, max_bars_back=5000, max_lines_count=500, max_labels_count=500)
//启示录第14章（羔羊与144000人在锡安山）
//启示录 14:1：我又观看，见羔羊站在锡安山，同他又有十四万四千人，都有他的名t和他的父的名写在额上。
//启示录 14:3：他们在宝座前、并在四活物和众长老前唱歌，仿佛是新歌；除了从地上买来的那十四万四千人以外，没有人能学这歌。
// === 1440 均值 + 标准差通道 ===//作者：芥菜种子/

mean_last_bars = ta.ema(close, 1440)
stdev_last_bars = ta.stdev(close, 1440)

// === 12条通道线的价格计算 ===
dev_p30 = mean_last_bars + 3.0 * stdev_last_bars
dev_p25 = mean_last_bars + 2.5 * stdev_last_bars
dev_p20 = mean_last_bars + 2.0 * stdev_last_bars
dev_p15 = mean_last_bars + 1.5 * stdev_last_bars
dev_p10 = mean_last_bars + 1.0 * stdev_last_bars
dev_p05 = mean_last_bars + 0.5 * stdev_last_bars

dev_m05 = mean_last_bars - 0.5 * stdev_last_bars
dev_m10 = mean_last_bars - 1.0 * stdev_last_bars
dev_m15 = mean_last_bars - 1.5 * stdev_last_bars
dev_m20 = mean_last_bars - 2.0 * stdev_last_bars
dev_m25 = mean_last_bars - 2.5 * stdev_last_bars
dev_m30 = mean_last_bars - 3.0 * stdev_last_bars

// === 颜色定义 (共12种独立色彩 + 白色中线) ===
c_p30 = #FF1744 // 极高位：鲜红
c_p25 = #FF5252 // 高位：珊瑚红
c_p20 = #FF9100 // 偏高：橙色
c_p15 = #FFEA00 // 中高：金黄
c_p10 = #76FF03 // 微微高：黄绿
c_p05 = #00E676 // 偏中心高：浅绿

c_mid = color.white // 中线：白色 (2号粗度)

c_m05 = #1DE9B6 // 偏中心低：青绿
c_m10 = #00E5FF // 微微低：天蓝
c_m15 = #2979FF // 中低：亮蓝
c_m20 = #651FFF // 偏低：靛蓝
c_m25 = #D500F9 // 低位：品红
c_m30 = #F50057 // 极低位：深粉红

// === 绘制通道线 ===
// 上边界 6 条 (1号粗度)
plot(dev_p30, " +3.0 SD", color=c_p30, linewidth=1)
plot(dev_p25, " +2.5 SD", color=c_p25, linewidth=1)
plot(dev_p20, " +2.0 SD", color=c_p20, linewidth=1)
plot(dev_p15, " +1.5 SD", color=c_p15, linewidth=1)
plot(dev_p10, " +1.0 SD", color=c_p10, linewidth=1)
plot(dev_p05, " +0.5 SD", color=c_p05, linewidth=1)

// 白色中线 (2号粗度)
plot(mean_last_bars, "1440 EMA 中线", color=c_mid, linewidth=2)

// 下边界 6 条 (1号粗度)
plot(dev_m05, " -0.5 SD", color=c_m05, linewidth=1)
plot(dev_m10, " -1.0 SD", color=c_m10, linewidth=1)
plot(dev_m15, " -1.5 SD", color=c_m15, linewidth=1)
plot(dev_m20, " -2.0 SD", color=c_m20, linewidth=1)
plot(dev_m25, " -2.5 SD", color=c_m25, linewidth=1)
plot(dev_m30, " -3.0 SD", color=c_m30, linewidth=1)

// === 在最后一根K线右侧显示价格标签 ===
if barstate.islast
    // 中线标签
    label.new(bar_index + 1, mean_last_bars, str.tostring(mean_last_bars, format.mintick),
              style=label.style_label_left, textcolor=color.black, color=c_mid, size=size.tiny)

    // 正数部分标签
    label.new(bar_index + 1, dev_p30, str.tostring(dev_p30, format.mintick), style=label.style_label_left, textcolor=color.white, color=c_p30, size=size.tiny)
    label.new(bar_index + 1, dev_p25, str.tostring(dev_p25, format.mintick), style=label.style_label_left, textcolor=color.white, color=c_p25, size=size.tiny)
    label.new(bar_index + 1, dev_p20, str.tostring(dev_p20, format.mintick), style=label.style_label_left, textcolor=color.black, color=c_p20, size=size.tiny)
    label.new(bar_index + 1, dev_p15, str.tostring(dev_p15, format.mintick), style=label.style_label_left, textcolor=color.black, color=c_p15, size=size.tiny)
    label.new(bar_index + 1, dev_p10, str.tostring(dev_p10, format.mintick), style=label.style_label_left, textcolor=color.black, color=c_p10, size=size.tiny)
    label.new(bar_index + 1, dev_p05, str.tostring(dev_p05, format.mintick), style=label.style_label_left, textcolor=color.black, color=c_p05, size=size.tiny)

    // 负数部分标签
    label.new(bar_index + 1, dev_m05, str.tostring(dev_m05, format.mintick), style=label.style_label_left, textcolor=color.black, color=c_m05, size=size.tiny)
    label.new(bar_index + 1, dev_m10, str.tostring(dev_m10, format.mintick), style=label.style_label_left, textcolor=color.black, color=c_m10, size=size.tiny)
    label.new(bar_index + 1, dev_m15, str.tostring(dev_m15, format.mintick), style=label.style_label_left, textcolor=color.white, color=c_m15, size=size.tiny)
    label.new(bar_index + 1, dev_m20, str.tostring(dev_m20, format.mintick), style=label.style_label_left, textcolor=color.white, color=c_m20, size=size.tiny)
    label.new(bar_index + 1, dev_m25, str.tostring(dev_m25, format.mintick), style=label.style_label_left, textcolor=color.white, color=c_m25, size=size.tiny)
    label.new(bar_index + 1, dev_m30, str.tostring(dev_m30, format.mintick), style=label.style_label_left, textcolor=color.white, color=c_m30, size=size.tiny)