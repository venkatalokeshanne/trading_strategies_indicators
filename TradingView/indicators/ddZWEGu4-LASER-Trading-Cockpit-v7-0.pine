string squeezeFireSymbol = squeezeFireSizeInput == "Micro" ? "·" : "•"

//=============================================================================
// 08 — VOLUME / ABSORPTION CANDLES
//=============================================================================
string G_VOL = "08 — Volume / Absorption Candles"
bool showVolumeMoves = input.bool(true, "Show Volume-Supported Moves", group = G_VOL)
