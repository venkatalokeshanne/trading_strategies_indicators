//Viva la libertad, carajo!
//@version=5
strategy("3 Soldiers 3 Crows + 8 differend MA", 
     overlay=true, 
     initial_capital=1000, 
     default_qty_value=1000, 
     default_qty_type=strategy.cash, 
     pyramiding=1, 
     commission_type=strategy.commission.percent, 
     commission_value=0.05,
     margin_long=10,
     margin_short=10)

// ==========================================
// === ВЫБОР ИСТОЧНИКА И ТИПА MA ===
// ==========================================
grp_ma = "Настройки фильтров MA"

// Дефолтный источник изменен на High
src_input = input.source(high, "Источник цены (Source)", group=grp_ma)

// Дефолты: SMA 22
ma1_type = input.string("SMA", "Тип MA 1 (Быстрая)", options=["SMA", "EMA", "WMA", "DEMA", "HMA", "VAR", "ZLEMA", "RMA"], group=grp_ma)
ma1_length = input.int(22, "Период MA 1", group=grp_ma)

// Дефолты: ZLEMA 210
ma2_type = input.string("ZLEMA", "Тип MA 2 (Медленная)", options=["SMA", "EMA", "WMA", "DEMA", "HMA", "VAR", "ZLEMA", "RMA"], group=grp_ma)
ma2_length = input.int(210, "Период MA 2", group=grp_ma)

// === КАСТОМНЫЕ ФУНКЦИИ МА ===
Var_Func(src, length) =>
    valpha = 2 / (length + 1)
    vud1 = src > src[1] ? src - src[1] : 0
    vdd1 = src < src[1] ? src[1] - src : 0
    vUD = math.sum(vud1, 9)
    vDD = math.sum(vdd1, 9)
    vCMO = nz((vUD - vDD) / (vUD + vDD))
    var float VAR = 0.0
    VAR := nz(valpha * math.abs(vCMO) * src) + (1 - valpha * math.abs(vCMO)) * nz(VAR[1])
    VAR

DEMA_Func(src, length) =>
    ema1 = ta.ema(src, length)
    ema2 = ta.ema(ema1, length)
    2 * ema1 - ema2

HMA_Func(src, length) =>
    wma1 = ta.wma(src, length / 2)
    wma2 = ta.wma(src, length)
    ta.wma(2 * wma1 - wma2, math.round(math.sqrt(length)))

ZLEMA_Func(src, length) =>
    int lag = math.floor((length - 1) / 2)
    float ema_data = src + (src - nz(src[lag]))
    ta.ema(ema_data, length)

getMA(src, length, type) =>
    switch type
        "SMA"   => ta.sma(src, length)
        "EMA"   => ta.ema(src, length)
        "WMA"   => ta.wma(src, length)
        "DEMA"  => DEMA_Func(src, length)
        "HMA"   => HMA_Func(src, length)
        "VAR"   => Var_Func(src, length)
        "ZLEMA" => ZLEMA_Func(src, length)
        "RMA"   => ta.rma(src, length)
        => ta.sma(src, length)

ma1 = getMA(src_input, ma1_length, ma1_type)
ma2 = getMA(src_input, ma2_length, ma2_type)

// === ЛОГИКА ПАТТЕРНОВ ===
three_white_soldiers = close > open and close[1] > open[1] and close[2] > open[2] and 
     open[1] <= close[2] and close[1] > close[2] and 
     open <= close[1] and close > close[1]

three_black_crows = close < open and close[1] < open[1] and close[2] < open[2] and 
     open[1] >= close[2] and close[1] < close[2] and 
     open >= close[1] and close < close[1]

// === КУЛДАУН ===
grp_cool = "Кулдаун Фильтр"
useCooldown = input.bool(true, "Использовать Cooldown", group=grp_cool)
cooldownPeriod = input.int(212, "Cooldown (свечей)", group=grp_cool)

var int lastBuyBar = 0
var int lastSellBar = 0

canBuy = (bar_index - lastBuyBar) > cooldownPeriod
canSell = (bar_index - lastSellBar) > cooldownPeriod

// === СИГНАЛЫ И ИСПОЛНЕНИЕ ===
buy_signal = three_white_soldiers and close > ma1 and close > ma2 and (not useCooldown or canBuy)
sell_signal = three_black_crows and close < ma1 and close < ma2 and (not useCooldown or canSell)

if buy_signal
    strategy.entry("Long", strategy.long, comment="Soldiers")
    lastBuyBar := bar_index

if sell_signal
    strategy.entry("Short", strategy.short, comment="Crows")
    lastSellBar := bar_index

// === ВИЗУАЛИЗАЦИЯ ===
plot(ma1, "Fast MA", color=color.new(color.orange, 0), linewidth=2)
plot(ma2, "Slow MA", color=color.new(color.blue, 0), linewidth=2)

// Метки BUY/SELL удалены по просьбе пользователя
