// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/ MPL-2.0
//@version=6
indicator("Confluência Master MTF", shorttitle = "Confluência Master", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 50, max_polylines_count = 100, calc_bars_count = 5000)

// --- Constantes ---
string GROUP_MODULES = "Módulos de análise"
string GROUP_TREND = "1. Tendência / Triple EMA"
string GROUP_MOMENTUM = "2. RSI / Estocástico RSI"
string GROUP_MACD = "3. MACD MTF"
string GROUP_FORCE = "4. JR Index / PMV Force / ADX"
string GROUP_CANDLE = "5. Candle 2 / Candle 3"
string GROUP_LIQUIDITY = "6. Liquidez / EQH-EQL"
string GROUP_STRUCTURE = "7. Market Structure / Scatter"
string GROUP_PROFILE = "8. Order Flow / Delta Profile"
string GROUP_SESSION = "9. Killzones / Sessão"
string GROUP_NEWS = "8. Notícias"
string GROUP_SCORE = "9. Confluência"
string GROUP_RISK = "10. Risco / projeção"
string GROUP_STYLE = "Estilo"

// --- Inputs: módulos ---
modeInput = input.string("Forex / MT5", "Modo operacional", options = ["Forex / MT5", "Binárias 10m", "Cripto / Bybit"], group = GROUP_MODULES)
sourceInput = input.source(hlc3, "Fonte principal", group = GROUP_MODULES)

ema1LengthInput = input.int(8, "EMA 1 rápida", minval = 2, group = GROUP_TREND)
ema2LengthInput = input.int(80, "EMA 2 intermediária", minval = 3, group = GROUP_TREND)
ema3LengthInput = input.int(200, "EMA 3 tendência", minval = 20, group = GROUP_TREND)
trendTimeframeInput = input.timeframe("60", "Timeframe da tendência", group = GROUP_TREND)
useStrictTrendInput = input.bool(true, "Exigir alinhamento das três EMAs", group = GROUP_TREND)

rsiLengthInput = input.int(14, "RSI período", minval = 2, group = GROUP_MOMENTUM)
rsiBullLevelInput = input.float(52, "RSI mínimo compra", minval = 0, maxval = 100, step = 0.5, group = GROUP_MOMENTUM)
rsiBearLevelInput = input.float(48, "RSI máximo venda", minval = 0, maxval = 100, step = 0.5, group = GROUP_MOMENTUM)
stochRsiLengthInput = input.int(13, "Stoch RSI período RSI", minval = 2, group = GROUP_MOMENTUM)
stochLengthInput = input.int(9, "Stoch RSI período estocástico", minval = 2, group = GROUP_MOMENTUM)
stochKLengthInput = input.int(10, "Suavização K", minval = 1, group = GROUP_MOMENTUM)
stochDLengthInput = input.int(2, "Suavização D", minval = 1, group = GROUP_MOMENTUM)
stochOversoldInput = input.float(20, "Stoch RSI sobrevendido", minval = 0, maxval = 100, step = 1, group = GROUP_MOMENTUM)
stochOverboughtInput = input.float(80, "Stoch RSI sobrecomprado", minval = 0, maxval = 100, step = 1, group = GROUP_MOMENTUM)

macdFastLengthInput = input.int(12, "MACD rápido", minval = 1, group = GROUP_MACD)
macdSlowLengthInput = input.int(26, "MACD lento", minval = 2, group = GROUP_MACD)
macdSignalLengthInput = input.int(9, "MACD sinal", minval = 1, group = GROUP_MACD)
macdTimeframeInput = input.timeframe("60", "Timeframe do MACD", group = GROUP_MACD)
requireMacdZeroInput = input.bool(true, "Exigir MACD acima/abaixo de zero", group = GROUP_MACD)

cciLengthInput = input.int(14, "CCI / JR período", minval = 2, group = GROUP_FORCE)
jrFastLengthInput = input.int(12, "JR rápido", minval = 2, group = GROUP_FORCE)
jrSlowLengthInput = input.int(26, "JR lento", minval = 3, group = GROUP_FORCE)
cciOversoldInput = input.float(-100, "CCI sobrevendido", group = GROUP_FORCE)
cciOverboughtInput = input.float(100, "CCI sobrecomprado", group = GROUP_FORCE)
diLengthInput = input.int(7, "PMV DI Length", minval = 2, group = GROUP_FORCE)
adxSmoothingInput = input.int(7, "PMV ADX Smoothing", minval = 2, group = GROUP_FORCE)
forceNeutralInput = input.float(0.10, "PMV linha neutra", minval = 0, step = 0.01, group = GROUP_FORCE)
adxMinimumInput = input.float(18, "ADX mínimo", minval = 0, step = 0.5, group = GROUP_FORCE)

candleAtrLengthInput = input.int(16, "ATR dos candles", minval = 2, group = GROUP_CANDLE)
wickThresholdInput = input.float(40, "Fechamento favorável (%)", minval = 0, maxval = 100, step = 1, group = GROUP_CANDLE)
reversalBodyAtrInput = input.float(0.40, "Corpo mínimo em ATR", minval = 0, step = 0.05, group = GROUP_CANDLE)
expansionFactorInput = input.float(1.30, "Fator de expansão", minval = 1, step = 0.05, group = GROUP_CANDLE)
expansionAverageLengthInput = input.int(20, "Média de range", minval = 2, group = GROUP_CANDLE)

pivotLeftInput = input.int(10, "Pivot esquerdo", minval = 1, group = GROUP_LIQUIDITY)
pivotRightInput = input.int(2, "Pivot direito", minval = 1, group = GROUP_LIQUIDITY)
equalityThresholdInput = input.float(0.03, "Igualdade máxima (%)", minval = 0.001, step = 0.001, group = GROUP_LIQUIDITY)
liquidityProximityInput = input.float(0.06, "Proximidade da liquidez (%)", minval = 0.001, step = 0.001, group = GROUP_LIQUIDITY)
showLiquidityInput = input.bool(true, "Mostrar zonas EQH/EQL", group = GROUP_LIQUIDITY)

structurePivotLengthInput = input.int(10, "Market Structure Pivot Length", minval = 2, group = GROUP_STRUCTURE)
showStructureInput = input.bool(true, "Mostrar BOS / CHoCH", group = GROUP_STRUCTURE)
structureHeatmapInput = input.bool(false, "Heatmap Scatter nos candles", group = GROUP_STRUCTURE)
heatmapModeInput = input.string("Pullback", "Modo do Scatter", options = ["Combined", "Impulse", "Pullback"], group = GROUP_STRUCTURE)

profileLengthInput = input.int(200, "Order Flow Length", minval = 20, maxval = 2500, group = GROUP_PROFILE)
profileBucketsInput = input.int(25, "Buckets do perfil", minval = 5, maxval = 30, group = GROUP_PROFILE)
profileValueAreaInput = input.float(70, "Value Area (%)", minval = 1, maxval = 100, group = GROUP_PROFILE)
profilePlacementInput = input.string("Right of Price", "Posição do perfil", options = ["On Candles", "Right of Price"], group = GROUP_PROFILE)
profileAlignmentInput = input.string("Center", "Alinhamento do perfil", options = ["Left", "Center", "Right"], group = GROUP_PROFILE)
profileWidthInput = input.float(0.5, "Largura do perfil", minval = 0.1, maxval = 1, step = 0.1, group = GROUP_PROFILE)
profileDepthXInput = input.float(0.08, "Profundidade X", minval = -1, maxval = 1, step = 0.02, group = GROUP_PROFILE)
profileDepthYInput = input.float(0.5, "Profundidade Y", minval = -2, maxval = 2, step = 0.1, group = GROUP_PROFILE)
showProfileInput = input.bool(true, "Mostrar perfil 3D", group = GROUP_PROFILE)
profileAnomalyInput = input.bool(true, "Destacar candles de volume anormal", group = GROUP_PROFILE)
profileAnomalyMultiplierInput = input.float(2.5, "Fator de anomalia", minval = 1, step = 0.5, group = GROUP_PROFILE)

killzoneTimezoneInput = input.string("America/New_York", "Fuso das killzones", options = ["America/New_York", "Europe/London", "America/Sao_Paulo", "Etc/UTC"], group = GROUP_SESSION)
useAsiaInput = input.bool(true, "Asia 20:00-00:00", group = GROUP_SESSION)
useLondonInput = input.bool(true, "London 02:00-05:00", group = GROUP_SESSION)
useNyAmInput = input.bool(true, "NY AM 09:30-11:00", group = GROUP_SESSION)
useNyLunchInput = input.bool(false, "NY Lunch 12:00-13:00", group = GROUP_SESSION)
useNyPmInput = input.bool(true, "NY PM 13:30-16:00", group = GROUP_SESSION)

newsBlockMinutesInput = input.int(15, "Bloqueio antes/depois (min)", minval = 0, maxval = 240, group = GROUP_NEWS)
newsTime1Input = input.time(0, "Notícia 1", group = GROUP_NEWS)
newsTime2Input = input.time(0, "Notícia 2", group = GROUP_NEWS)

cooldownInput = input.int(3, "Cooldown entre sinais", minval = 0, maxval = 100, group = GROUP_SCORE)

atrLengthInput = input.int(14, "ATR do stop", minval = 2, group = GROUP_RISK)
atrMultiplierInput = input.float(1.5, "Stop em ATR", minval = 0.1, step = 0.1, group = GROUP_RISK)
riskRewardInput = input.float(2.5, "Risco / retorno", minval = 0.1, step = 0.1, group = GROUP_RISK)
showRiskLevelsInput = input.bool(true, "Mostrar entrada, stop e alvo", group = GROUP_RISK)

bullColorInput = input.color(#089981, "Cor compradora", group = GROUP_STYLE)
bearColorInput = input.color(#f23645, "Cor vendedora", group = GROUP_STYLE)
neutralColorInput = input.color(#5b9cf6, "Cor neutra", group = GROUP_STYLE)
showDashboardInput = input.bool(true, "Mostrar painel modular", group = GROUP_STYLE)

// --- Funções Auxiliares ---
isEventBlocked(int eventTime, int blockMilliseconds) =>
    eventTime > 0 and time <= eventTime + blockMilliseconds and time_close >= eventTime - blockMilliseconds

statusText(bool bullish, bool bearish) =>
    bullish ? "ALTA" : bearish ? "BAIXA" : "NEUTRA"

statusColor(bool bullish, bool bearish) =>
    bullish ? bullColorInput : bearish ? bearColorInput : neutralColorInput

// --- 1. Análise de tendência ---
emaFast = ta.ema(sourceInput, ema1LengthInput)
emaMedium = ta.ema(sourceInput, ema2LengthInput)
emaSlow = ta.ema(sourceInput, ema3LengthInput)
htfTrendEma = request.security(syminfo.tickerid, trendTimeframeInput, ta.ema(sourceInput, ema3LengthInput)[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

emaAlignmentBull = emaFast > emaMedium and emaMedium > emaSlow
emaAlignmentBear = emaFast < emaMedium and emaMedium < emaSlow
trendBull = (useStrictTrendInput ? emaAlignmentBull : emaFast > emaMedium) and close > emaSlow and close > htfTrendEma
trendBear = (useStrictTrendInput ? emaAlignmentBear : emaFast < emaMedium) and close < emaSlow and close < htfTrendEma

// --- 2. Market Structure ---
structurePivotHigh = ta.pivothigh(high, structurePivotLengthInput, structurePivotLengthInput)
structurePivotLow = ta.pivotlow(low, structurePivotLengthInput, structurePivotLengthInput)
var float structureTopY = na
var float structureBottomY = na
var int structureTrend = 0

if not na(structurePivotHigh)
    structureTopY := structurePivotHigh
if not na(structurePivotLow)
    structureBottomY := structurePivotLow

if not na(structureTopY) and close > structureTopY
    structureTrend := 1
if not na(structureBottomY) and close < structureBottomY
    structureTrend := -1

// --- 3. Análise RSI e Stoch RSI ---
rsiValue = ta.rsi(sourceInput, rsiLengthInput)
rsiBull = rsiValue >= rsiBullLevelInput
rsiBear = rsiValue <= rsiBearLevelInput
stochRsiBase = ta.rsi(sourceInput, stochRsiLengthInput)
stochRsiRaw = ta.stoch(stochRsiBase, stochRsiBase, stochRsiBase, stochLengthInput)
stochK = ta.sma(stochRsiRaw, stochKLengthInput)
stochD = ta.sma(stochK, stochDLengthInput)
stochBull = stochK > stochD and stochK > 50
stochBear = stochK < stochD and stochK < 50

// --- 4. Análise MACD atual e MTF ---
[macdLine, macdSignal, macdHistogram] = ta.macd(sourceInput, macdFastLengthInput, macdSlowLengthInput, macdSignalLengthInput)
macdBull = macdLine > macdSignal and (not requireMacdZeroInput or macdHistogram > 0)
macdBear = macdLine < macdSignal and (not requireMacdZeroInput or macdHistogram < 0)

// --- 5. Análise JR Index e PMV Force ---
cciValue = ta.cci(sourceInput, cciLengthInput)
jrFast = ta.ema(cciValue, jrFastLengthInput)
jrSlow = ta.ema(cciValue, jrSlowLengthInput)
cciBull = jrFast > jrSlow and cciValue > 0
cciBear = jrFast < jrSlow and cciValue < 0

[plusDI, minusDI, adxValue] = ta.dmi(diLengthInput, adxSmoothingInput)
forceValue = (plusDI - minusDI) / 100
forceBull = plusDI > minusDI and forceValue >= forceNeutralInput
forceBear = minusDI > plusDI and forceValue <= -forceNeutralInput
adxBull = adxValue >= adxMinimumInput and plusDI > minusDI
adxBear = adxValue >= adxMinimumInput and minusDI > plusDI

// --- 6. Análise Candle 2 / Candle 3 ---
candleAtr = ta.atr(candleAtrLengthInput)
barRange = math.max(high - low, syminfo.mintick)
barBody = math.abs(close - open)
closeStrengthBull = (close - low) / barRange * 100
closeStrengthBear = (high - close) / barRange * 100
rangeAverage = ta.sma(high - low, expansionAverageLengthInput)
bullReversal = close > open and close[1] < open[1] and closeStrengthBull >= wickThresholdInput and barBody >= candleAtr * reversalBodyAtrInput
bearReversal = close < open and close[1] > open[1] and closeStrengthBear >= wickThresholdInput and barBody >= candleAtr * reversalBodyAtrInput
candleBull = bullReversal or (close > open and barRange > rangeAverage * expansionFactorInput)
candleBear = bearReversal or (close < open and barRange > rangeAverage * expansionFactorInput)

// --- 7. Análise de liquidez EQH / EQL ---
pivotHigh = ta.pivothigh(high, pivotLeftInput, pivotRightInput)
pivotLow = ta.pivotlow(low, pivotLeftInput, pivotRightInput)
var float lastPivotHigh = na
var float previousPivotHigh = na
var float lastPivotLow = na
var float previousPivotLow = na

if not na(pivotHigh)
    previousPivotHigh := lastPivotHigh
    lastPivotHigh := pivotHigh
if not na(pivotLow)
    previousPivotLow := lastPivotLow
    lastPivotLow := pivotLow

equalHigh = not na(lastPivotHigh) and not na(previousPivotHigh) and math.abs(lastPivotHigh - previousPivotHigh) / close * 100 <= equalityThresholdInput
equalLow = not na(lastPivotLow) and not na(previousPivotLow) and math.abs(lastPivotLow - previousPivotLow) / close * 100 <= equalityThresholdInput
liquidityBull = equalLow and math.abs(close - lastPivotLow) / close * 100 <= liquidityProximityInput
liquidityBear = equalHigh and math.abs(close - lastPivotHigh) / close * 100 <= liquidityProximityInput

// --- 8. Order Flow (Simplificado para o peso direcional) ---
profileBarDelta = close > open ? nz(volume) : close < open ? -nz(volume) : 0
profileRollingDelta = ta.sma(profileBarDelta, profileLengthInput)
profileBull = profileRollingDelta > 0
profileBear = profileRollingDelta < 0

// =====================================================================================
// CONTAGEM RÍGIDA DE VOTOS (A MÁGICA ACONTECE AQUI)
// =====================================================================================
int buyVotes = (trendBull ? 1 : 0) + (rsiBull ? 1 : 0) + (stochBull ? 1 : 0) + (macdBull ? 1 : 0) + (cciBull ? 1 : 0) + ((forceBull and adxBull) ? 1 : 0) + (candleBull ? 1 : 0) + (liquidityBull ? 1 : 0) + (structureTrend == 1 ? 1 : 0) + (profileBull ? 1 : 0)
int sellVotes = (trendBear ? 1 : 0) + (rsiBear ? 1 : 0) + (stochBear ? 1 : 0) + (macdBear ? 1 : 0) + (cciBear ? 1 : 0) + ((forceBear and adxBear) ? 1 : 0) + (candleBear ? 1 : 0) + (liquidityBear ? 1 : 0) + (structureTrend == -1 ? 1 : 0) + (profileBear ? 1 : 0)

var int lastSignalBar = na
cooldownPassed = na(lastSignalBar) or bar_index - lastSignalBar >= cooldownInput

// Regras exigidas: Pelo menos 5 a favor e 0 contra para Sinal Forte
bool sinalCompra = buyVotes >= 5 and sellVotes == 0 and cooldownPassed
bool sinalVenda = sellVotes >= 5 and buyVotes == 0 and cooldownPassed

// Regras exigidas: 3 ou 4 a favor e 0 contra para Atenção
bool atencaoCompra = (buyVotes == 3 or buyVotes == 4) and sellVotes == 0
bool atencaoVenda = (sellVotes == 3 or sellVotes == 4) and buyVotes == 0

if sinalCompra or sinalVenda
    lastSignalBar := bar_index

// Plotagem das Setas de Sinal
plotshape(sinalCompra, title = "COMPRAR", style = shape.labelup, location = location.belowbar, color = bullColorInput, text = "COMPRAR", textcolor = color.white, size = size.normal)
plotshape(sinalVenda, title = "VENDER", style = shape.labeldown, location = location.abovebar, color = bearColorInput, text = "VENDER", textcolor = color.white, size = size.normal)

// =====================================================================================
// PAINEL MODULAR CENTRALIZADO E ATUALIZADO
// =====================================================================================
// Alterado para position.top_center conforme sua requisição
var table dashboard = table.new(position.top_center, 4, 15, bgcolor = color.new(chart.bg_color, 8), frame_color = color.new(chart.fg_color, 70), frame_width = 1)

if barstate.islast and showDashboardInput
    table.cell(dashboard, 0, 0, "MÓDULO", text_color = chart.fg_color, text_size = size.small)
    table.cell(dashboard, 1, 0, "ESTADO", text_color = chart.fg_color, text_size = size.small)
    table.cell(dashboard, 2, 0, "COMPRA", text_color = bullColorInput, text_size = size.small)
    table.cell(dashboard, 3, 0, "VENDA", text_color = bearColorInput, text_size = size.small)
    
    table.cell(dashboard, 0, 1, "Tendência", text_color = chart.fg_color, text_size = size.small)
    table.cell(dashboard, 1, 1, statusText(trendBull, trendBear), text_color = statusColor(trendBull, trendBear), text_size = size.small)
    table.cell(dashboard, 2, 1, trendBull ? "1" : "0", text_color = bullColorInput, text_size = size.small)
    table.cell(dashboard, 3, 1, trendBear ? "1" : "0", text_color = bearColorInput, text_size = size.small)
    
    table.cell(dashboard, 0, 2, "RSI", text_color = chart.fg_color, text_size = size.small)
    table.cell(dashboard, 1, 2, statusText(rsiBull, rsiBear), text_color = statusColor(rsiBull, rsiBear), text_size = size.small)
    table.cell(dashboard, 2, 2, rsiBull ? "1" : "0", text_color = bullColorInput, text_size = size.small)
    table.cell(dashboard, 3, 2, rsiBear ? "1" : "0", text_color = bearColorInput, text_size = size.small)
    
    table.cell(dashboard, 0, 3, "Stoch RSI", text_color = chart.fg_color, text_size = size.small)
    table.cell(dashboard, 1, 3, statusText(stochBull, stochBear), text_color = statusColor(stochBull, stochBear), text_size = size.small)
    table.cell(dashboard, 2, 3, stochBull ? "1" : "0", text_color = bullColorInput, text_size = size.small)
    table.cell(dashboard, 3, 3, stochBear ? "1" : "0", text_color = bearColorInput, text_size = size.small)
    
    table.cell(dashboard, 0, 4, "MACD MTF", text_color = chart.fg_color, text_size = size.small)
    table.cell(dashboard, 1, 4, statusText(macdBull, macdBear), text_color = statusColor(macdBull, macdBear), text_size = size.small)
    table.cell(dashboard, 2, 4, macdBull ? "1" : "0", text_color = bullColorInput, text_size = size.small)
    table.cell(dashboard, 3, 4, macdBear ? "1" : "0", text_color = bearColorInput, text_size = size.small)
    
    table.cell(dashboard, 0, 5, "JR / CCI", text_color = chart.fg_color, text_size = size.small)
    table.cell(dashboard, 1, 5, statusText(cciBull, cciBear), text_color = statusColor(cciBull, cciBear), text_size = size.small)
    table.cell(dashboard, 2, 5, cciBull ? "1" : "0", text_color = bullColorInput, text_size = size.small)
    table.cell(dashboard, 3, 5, cciBear ? "1" : "0", text_color = bearColorInput, text_size = size.small)
    
    table.cell(dashboard, 0, 6, "PMV / ADX", text_color = chart.fg_color, text_size = size.small)
    table.cell(dashboard, 1, 6, statusText(forceBull, forceBear), text_color = statusColor(forceBull, forceBear), text_size = size.small)
    table.cell(dashboard, 2, 6, (forceBull and adxBull) ? "1" : "0", text_color = bullColorInput, text_size = size.small)
    table.cell(dashboard, 3, 6, (forceBear and adxBear) ? "1" : "0", text_color = bearColorInput, text_size = size.small)
    
    table.cell(dashboard, 0, 7, "Candle 2/3", text_color = chart.fg_color, text_size = size.small)
    table.cell(dashboard, 1, 7, statusText(candleBull, candleBear), text_color = statusColor(candleBull, candleBear), text_size = size.small)
    table.cell(dashboard, 2, 7, candleBull ? "1" : "0", text_color = bullColorInput, text_size = size.small)
    table.cell(dashboard, 3, 7, candleBear ? "1" : "0", text_color = bearColorInput, text_size = size.small)
    
    table.cell(dashboard, 0, 8, "Liquidez", text_color = chart.fg_color, text_size = size.small)
    table.cell(dashboard, 1, 8, statusText(liquidityBull, liquidityBear), text_color = statusColor(liquidityBull, liquidityBear), text_size = size.small)
    table.cell(dashboard, 2, 8, liquidityBull ? "1" : "0", text_color = bullColorInput, text_size = size.small)
    table.cell(dashboard, 3, 8, liquidityBear ? "1" : "0", text_color = bearColorInput, text_size = size.small)

    table.cell(dashboard, 0, 9, "Structure", text_color = chart.fg_color, text_size = size.small)
    table.cell(dashboard, 1, 9, statusText(structureTrend == 1, structureTrend == -1), text_color = statusColor(structureTrend == 1, structureTrend == -1), text_size = size.small)
    table.cell(dashboard, 2, 9, structureTrend == 1 ? "1" : "0", text_color = bullColorInput, text_size = size.small)
    table.cell(dashboard, 3, 9, structureTrend == -1 ? "1" : "0", text_color = bearColorInput, text_size = size.small)

    table.cell(dashboard, 0, 10, "Delta Profile", text_color = chart.fg_color, text_size = size.small)
    table.cell(dashboard, 1, 10, statusText(profileBull, profileBear), text_color = statusColor(profileBull, profileBear), text_size = size.small)
    table.cell(dashboard, 2, 10, profileBull ? "1" : "0", text_color = bullColorInput, text_size = size.small)
    table.cell(dashboard, 3, 10, profileBear ? "1" : "0", text_color = bearColorInput, text_size = size.small)
    
    table.cell(dashboard, 0, 11, "PONTUAÇÃO", text_color = chart.fg_color, text_size = size.small)
    table.cell(dashboard, 1, 11, "MÍN 5", text_color = neutralColorInput, text_size = size.small)
    table.cell(dashboard, 2, 11, str.tostring(buyVotes) + "/10", text_color = bullColorInput, text_size = size.small)
    table.cell(dashboard, 3, 11, str.tostring(sellVotes) + "/10", text_color = bearColorInput, text_size = size.small)
    
    // Lógica do novo Status
    string statusTextUI = sinalCompra ? "COMPRAR" : sinalVenda ? "VENDER" : (atencaoCompra or atencaoVenda) ? "ATENÇÃO!" : "AGUARDAR"
    color statusColorUI = sinalCompra ? bullColorInput : sinalVenda ? bearColorInput : (atencaoCompra or atencaoVenda) ? color.yellow : neutralColorInput
    
    table.cell(dashboard, 0, 12, "STATUS", text_color = chart.fg_color, text_size = size.small)
    table.cell(dashboard, 1, 12, statusTextUI, text_color = statusColorUI, text_size = size.small)
    table.cell(dashboard, 2, 12, "ADX " + str.tostring(adxValue, "#.0"), text_color = neutralColorInput, text_size = size.small)
    table.cell(dashboard, 3, 12, "RSI " + str.tostring(rsiValue, "#.0"), text_color = neutralColorInput, text_size = size.small)

// --- Alertas ---
alertcondition(sinalCompra, "Compra Master", "Sinal forte de COMPRA! 5+ Indicadores confluindo em {{ticker}}.")
alertcondition(sinalVenda, "Venda Master", "Sinal forte de VENDA! 5+ Indicadores confluindo em {{ticker}}.")