//@version=6
indicator("SHFE_ag_au", overlay=false)

// === 参数 ===
xag_symbol = input.symbol("OANDA:XAGUSD", "国际白银 XAGUSD")
ag_symbol  = input.symbol("SHFE:AG1!",   "沪银")
xau_symbol = input.symbol("OANDA:XAUUSD", "国际黄金 XAUUSD")
au_symbol  = input.symbol("SHFE:AU1!",   "沪金")

// === OANDA 实时数据 ===
xag = request.security(xag_symbol, timeframe.period, close)
xau = request.security(xau_symbol, timeframe.period, close)

// === 上期所沪银：只有新K线时才有值 ===
ag_new      = request.security(ag_symbol, timeframe.period, close, gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
ag_time_new = request.security(ag_symbol, timeframe.period, time,  gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
has_new_shfe_ag = not na(ag_new)

// === 上期所沪金：只有新K线时才有值 ===
au_new      = request.security(au_symbol, timeframe.period, close, gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
au_time_new = request.security(au_symbol, timeframe.period, time,  gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
has_new_shfe_au = not na(au_new)

// === 全包含倍率：直接 = 沪价 / 国际价 ===
// 已包含汇率、盎司→克/公斤、增值税、溢价等所有因素
// 用法：国际价(美元) × 倍率 = 上期所价
//   沪银 AG1! 是元/千克 → 倍率≈240
//   沪金 AU1! 是元/克   → 倍率≈0.22
// --- 白银 ---
var float ag_ratio      = na
var float last_ag_price = na
var int   last_ag_time  = na
// --- 黄金 ---
var float au_ratio      = na
var float last_au_price = na
var int   last_au_time  = na

if has_new_shfe_ag and not na(xag) and xag != 0
    ag_ratio      := ag_new / xag
    last_ag_price := ag_new
    last_ag_time  := ag_time_new

if has_new_shfe_au and not na(xau) and xau != 0
    au_ratio      := au_new / xau
    last_au_price := au_new
    last_au_time  := au_time_new

// === 用最新倍率实时折算 ===
xag_to_shfe = xag * ag_ratio
xau_to_shfe = xau * au_ratio

// === 输出 ===
// 主图：沪银倍率走右轴，沪金倍率走左轴（右键沪金线 → Pin to scale → Left）
plot(ag_ratio, title="沪银全包含倍率 (沪银/XAG)", color=color.orange, linewidth=2)
plot(au_ratio, title="沪金全包含倍率 (沪金/XAU)", color=color.black,  linewidth=2)  // ← 右键此线 Pin 到左轴

// 数据窗口辅助信息（真实值）
plot(xag_to_shfe,   title="XAGUSD实时折算沪银价",   display=display.data_window)
plot(xag,           title="XAGUSD",                display=display.data_window)
plot(last_ag_price, title="最近一次上期所沪银价",   display=display.data_window)
plot(xau_to_shfe,   title="XAUUSD实时折算沪金价",   display=display.data_window)
plot(xau,           title="XAUUSD",                display=display.data_window)
plot(last_au_price, title="最近一次上期所沪金价",   display=display.data_window)

// === 实时数值表格（右上角）===
var table t = table.new(position.top_right, 1, 8, border_width=1)
if barstate.islast
    // 白银
    table.cell(t, 0, 0, "沪银倍率: "  + str.tostring(ag_ratio, "#.####"),   text_color=color.black, bgcolor=color.new(color.orange, 80))
    table.cell(t, 0, 1, "XAGUSD: "    + str.tostring(xag, "#.###"),        text_color=color.black, bgcolor=color.new(color.blue, 85))
    table.cell(t, 0, 2, "折算沪银价: " + str.tostring(xag_to_shfe, "#.##"),  text_color=color.black, bgcolor=color.new(color.green, 85))
    table.cell(t, 0, 3, "上期所沪银: " + str.tostring(last_ag_price, "#.##"), text_color=color.black, bgcolor=color.new(color.gray, 85))
    // 黄金
    table.cell(t, 0, 4, "沪金倍率: "  + str.tostring(au_ratio, "#.####"),   text_color=color.black, bgcolor=color.new(color.yellow, 80))
    table.cell(t, 0, 5, "XAUUSD: "    + str.tostring(xau, "#.###"),        text_color=color.black, bgcolor=color.new(color.blue, 85))
    table.cell(t, 0, 6, "折算沪金价: " + str.tostring(xau_to_shfe, "#.##"),  text_color=color.black, bgcolor=color.new(color.green, 85))
    table.cell(t, 0, 7, "上期所沪金: " + str.tostring(last_au_price, "#.##"), text_color=color.black, bgcolor=color.new(color.gray, 85))