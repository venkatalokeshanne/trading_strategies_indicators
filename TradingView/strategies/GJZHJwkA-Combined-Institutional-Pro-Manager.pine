//@version=5
strategy("Combined Institutional Pro Manager", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500, calc_on_every_tick=false)

// ============================================================================
// --- INPUTS ---
// ============================================================================
grpRisk = "Risk & Reward Parameters"
rewardRatio = input.float(2.0, "Risk:Reward Ratio (TP)", minval=0.1, group=grpRisk)
fixedSL     = input.int(200, "Fixed Stop Loss (Ticks/Points)", minval=10, group=grpRisk)

grpExec = "Execution & Buffers (Ticks)"
execBuffer  = input.int(2, "Execution Ticks Beyond Limit", minval=0, group=grpExec, tooltip="Ticks price must pass limit to execute")
tpBuffer    = input.int(2, "TP Ticks Beyond Line", minval=0, group=grpExec, tooltip="Ticks price must pass TP to win. SL remains strict.")
expBars     = input.int(15, "Max Bars to Wait for Limit", minval=1, group=grpExec, tooltip="Cancels limit order if not triggered in time")

grpBE = "Break-Even (BE) Settings"
useBE       = input.bool(true, "Enable Break-Even", group=grpBE)
beRatio     = input.float(1.0, "RR to Trigger BE (e.g. 1.0 = 1:1)", minval=0.1, step=0.1, group=grpBE)

grpTrend = "Trend & Institutional Filters"
useTrend    = input.bool(true, "Enable SMA & EMA Trend Filter", group=grpTrend)
smaLen      = input.int(290, "SMA Length", minval=1, group=grpTrend)
emaLen      = input.int(200, "EMA Length", minval=1, group=grpTrend)
volMult     = input.float(1.5, "Inst. Volume Multiplier", step=0.1, group=grpTrend)
fvgLookback = input.int(5, "FVG Lookback for BOS", group=grpTrend)

// ============================================================================
// --- CORE LOGIC & FILTERS (Intersection of the 3 Indicators) ---
// ============================================================================
tick = syminfo.mintick

// 1. Trend Filter
smaVal = ta.sma(close, smaLen)
emaVal = ta.ema(close, emaLen)
bullishTrend = not useTrend or (close > smaVal and close > emaVal)
bearishTrend = not useTrend or (close < smaVal and close < emaVal)

// 2. Institutional Volume
volConfirm = volume > ta.sma(volume, 20) * volMult

// 3. FVG Logic
bullFVG = high[2] < low[0] and close[1] > high[2]
bearFVG = low[2] > high[0] and close[1] < low[2]
hasRecentBullFVG = ta.barssince(bullFVG) <= fvgLookback
hasRecentBearFVG = ta.barssince(bearFVG) <= fvgLookback

// 4. Structure Logic (BOS)
swingH = ta.pivothigh(high, 10, 10)
swingL = ta.pivotlow(low, 10, 10)
var float lastH = na
var float lastL = na
if not na(swingH)
    lastH := swingH
if not na(swingL)
    lastL := swingL
bullBOS = ta.crossover(close, lastH)
bearBOS = ta.crossunder(close, lastL)

// 5. AGREEMENT SIGNAL
// All 3 indicators must agree: Trend + BOS + Recent FVG + Institutional Volume
longSignal  = bullishTrend and bullBOS and hasRecentBullFVG and volConfirm
shortSignal = bearishTrend and bearBOS and hasRecentBearFVG and volConfirm

// ============================================================================
// --- STATE MACHINE & TRACKING ---
// ============================================================================
// States: 0 = Flat, 1 = Pending Long, -1 = Pending Short, 2 = Active Long, -2 = Active Short
var int state = 0 
var int pendingBar = na

var float ep = na       
var float sl = na       
var float tp = na       
var float beTrig = na  
var bool beActive = false 

var line l_ep = na
var line l_sl = na
var line l_tp = na
var line l_be = na

var int wins = 0
var int losses = 0
var int bes = 0

// ============================================================================
// --- TRADE EXECUTION & LINE MANAGEMENT ---
// ============================================================================

// 1. GENERATE PENDING LIMIT ORDER SETUP
if state == 0
    if longSignal
        state := 1
        pendingBar := bar_index
        ep := low[0] // Anchor limit to signal candle low
        sl := ep - (fixedSL * tick)
        risk = ep - sl
        tp := ep + (risk * rewardRatio)
        beTrig := ep + (risk * beRatio)
        
        l_ep := line.new(bar_index, ep, bar_index, ep, color=color.blue, width=2, style=line.style_solid, xloc=xloc.bar_index)
        l_sl := line.new(bar_index, sl, bar_index, sl, color=color.red, width=2, style=line.style_solid, xloc=xloc.bar_index)
        l_tp := line.new(bar_index, tp, bar_index, tp, color=color.green, width=2, style=line.style_solid, xloc=xloc.bar_index)
        if useBE
            l_be := line.new(bar_index, beTrig, bar_index, beTrig, color=color.orange, width=1, style=line.style_dashed, xloc=xloc.bar_index)
            
    else if shortSignal
        state := -1
        pendingBar := bar_index
        ep := high[0] // Anchor limit to signal candle high
        sl := ep + (fixedSL * tick)
        risk = sl - ep
        tp := ep - (risk * rewardRatio)
        beTrig := ep - (risk * beRatio)
        
        l_ep := line.new(bar_index, ep, bar_index, ep, color=color.purple, width=2, style=line.style_solid, xloc=xloc.bar_index)
        l_sl := line.new(bar_index, sl, bar_index, sl, color=color.red, width=2, style=line.style_solid, xloc=xloc.bar_index)
        l_tp := line.new(bar_index, tp, bar_index, tp, color=color.green, width=2, style=line.style_solid, xloc=xloc.bar_index)
        if useBE
            l_be := line.new(bar_index, beTrig, bar_index, beTrig, color=color.orange, width=1, style=line.style_dashed, xloc=xloc.bar_index)

// 2. UPDATE VISUALS (Keep lines tracking the current bar while active or pending)
if state != 0
    line.set_x2(l_ep, bar_index)
    line.set_x2(l_sl, bar_index)
    line.set_x2(l_tp, bar_index)
    if useBE and not na(l_be)
        line.set_x2(l_be, bar_index)

// 3. PENDING STATE LOGIC (Activation or Expiration)
if state == 1
    if (bar_index - pendingBar) > expBars
        state := 0 // Expired
        line.delete(l_ep), line.delete(l_sl), line.delete(l_tp)
        if useBE
            line.delete(l_be)
    else if low <= ep - (execBuffer * tick)
        state := 2
        beActive := false
        strategy.entry("Long", strategy.long, limit=ep)
        label.new(bar_index, ep, "BUY ACTIVE", color=color.blue, textcolor=color.white, style=label.style_label_up, size=size.small)

if state == -1
    if (bar_index - pendingBar) > expBars
        state := 0 // Expired
        line.delete(l_ep), line.delete(l_sl), line.delete(l_tp)
        if useBE
            line.delete(l_be)
    else if high >= ep + (execBuffer * tick)
        state := -2
        beActive := false
        strategy.entry("Short", strategy.short, limit=ep)
        label.new(bar_index, ep, "SELL ACTIVE", color=color.purple, textcolor=color.white, style=label.style_label_down, size=size.small)

// 4. ACTIVE TRADE LOGIC (SL Strict, TP with Buffer, BE Check)
if state == 2 // Active Long
    // BE Check
    if useBE and not beActive and high >= beTrig
        beActive := true
        sl := ep 
        line.set_y1(l_sl, ep) 
        line.set_y2(l_sl, ep)
        label.new(bar_index, beTrig, "BE MOVED", color=color.orange, textcolor=color.white, style=label.style_label_down, size=size.tiny)
        
    // Exit Check
    if low <= sl // Strict touch for SL
        if beActive
            bes += 1
            label.new(bar_index, sl, "BE HIT", color=color.orange, textcolor=color.white, style=label.style_label_up, size=size.small)
        else
            losses += 1
            label.new(bar_index, sl, "LOSS", color=color.red, textcolor=color.white, style=label.style_label_up, size=size.small)
        state := 0 
        strategy.close("Long", comment=beActive ? "BE" : "LOSS")
        
    else if high >= tp + (tpBuffer * tick) // Ticks beyond required for TP
        wins += 1
        label.new(bar_index, tp, "WIN", color=color.green, textcolor=color.white, style=label.style_label_down, size=size.small)
        state := 0
        strategy.close("Long", comment="WIN")

if state == -2 // Active Short
    // BE Check
    if useBE and not beActive and low <= beTrig
        beActive := true
        sl := ep 
        line.set_y1(l_sl, ep) 
        line.set_y2(l_sl, ep)
        label.new(bar_index, beTrig, "BE MOVED", color=color.orange, textcolor=color.white, style=label.style_label_up, size=size.tiny)
        
    // Exit Check
    if high >= sl // Strict touch for SL
        if beActive
            bes += 1
            label.new(bar_index, sl, "BE HIT", color=color.orange, textcolor=color.white, style=label.style_label_down, size=size.small)
        else
            losses += 1
            label.new(bar_index, sl, "LOSS", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.small)
        state := 0
        strategy.close("Short", comment=beActive ? "BE" : "LOSS")
        
    else if low <= tp - (tpBuffer * tick) // Ticks beyond required for TP
        wins += 1
        label.new(bar_index, tp, "WIN", color=color.green, textcolor=color.white, style=label.style_label_up, size=size.small)
        state := 0
        strategy.close("Short", comment="WIN")

// ============================================================================
// --- DASHBOARD ---
// ============================================================================
var table statsTable = table.new(position.top_right, 2, 3, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray)
if barstate.islast
    table.cell(statsTable, 0, 0, "Wins", text_color=color.green, text_halign=text.align_left)
    table.cell(statsTable, 1, 0, str.tostring(wins), text_color=color.green, text_halign=text.align_right)
    table.cell(statsTable, 0, 1, "Losses", text_color=color.red, text_halign=text.align_left)
    table.cell(statsTable, 1, 1, str.tostring(losses), text_color=color.red, text_halign=text.align_right)
    table.cell(statsTable, 0, 2, "Break Evens", text_color=color.orange, text_halign=text.align_left)
    table.cell(statsTable, 1, 2, str.tostring(bes), text_color=color.orange, text_halign=text.align_right)

plotshape(longSignal and state == 0, style=shape.triangleup, location=location.belowbar, color=color.blue, size=size.small, title="Bullish Setup")
plotshape(shortSignal and state == 0, style=shape.triangledown, location=location.abovebar, color=color.purple, size=size.small, title="Bearish Setup")