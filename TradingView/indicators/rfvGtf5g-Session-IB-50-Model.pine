// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
// =====================================================================================================
// Session Initial Balance — 50% Retracement Model
// -----------------------------------------------------------------------------------------------------
//                   - Entry / stop / target prices anchor to the END or the CENTER of their line.
//                   - Independent bar offset per level, applied on top of the anchor.
//                   - Center placement switches the labels to a downward pointer so the line does
//                     not strike through the text; End keeps the left pointer as before.
// -----------------------------------------------------------------------------------------------------
// 2026-08-13        - Removed the Standard Deviation module in full: the sigma inputs, the SD stop
//                     override, the ladder rungs with their labels and alerts, and the dashboard
//                     SD column. Entry / stop / target now come only from the session range.
//                   - Dashboard footer reports the session window that is live right now, and the
//                     chart timeframe is printed with its unit ("1m") instead of a bare "1".
// =====================================================================================================
indicator("Session IB 50% Model", "IB 50%", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ============================ Constants ============================
const string G_SESS  = "Sessions"
const string G_LOGIC = "Model Logic"
const string G_MARK  = "Range Markers"
const string G_LVL   = "Entry / Stop / Target"
const string G_DASH  = "Dashboard"

const color BULL_COLOR = #089981
const color BEAR_COLOR = #f23645
const color NEUT_COLOR = #787b86

const int ST_PENDING = 0
const int ST_ACTIVE  = 1
const int ST_WIN     = 2
const int ST_LOSS    = 3
const int ST_VOID    = 4

// ============================ Inputs — Sessions ============================
string tzSel = input.string("America/New_York", "Session Timezone", options = ["America/New_York", "America/Chicago", "America/Los_Angeles", "Europe/London", "Asia/Tokyo", "UTC", "Exchange"], group = G_SESS, tooltip = "All session windows are evaluated in this timezone. 'Exchange' uses the symbol's native timezone.")
string tz    = tzSel == "Exchange" ? syminfo.timezone : tzSel

bool   s1On = input.bool(true, "", inline = "s1", group = G_SESS)
string s1Nm = input.string("Globex", "", inline = "s1", group = G_SESS)
string s1Tm = input.session("1800-1900", "", inline = "s1", group = G_SESS)

bool   s2On = input.bool(true, "", inline = "s2", group = G_SESS)
string s2Nm = input.string("Asia", "", inline = "s2", group = G_SESS)
string s2Tm = input.session("1900-2000", "", inline = "s2", group = G_SESS)

bool   s3On = input.bool(true, "", inline = "s3", group = G_SESS)
string s3Nm = input.string("London", "", inline = "s3", group = G_SESS)
string s3Tm = input.session("0300-0400", "", inline = "s3", group = G_SESS)

bool   s4On = input.bool(true, "", inline = "s4", group = G_SESS)
string s4Nm = input.string("New York", "", inline = "s4", group = G_SESS)
string s4Tm = input.session("0930-1030", "", inline = "s4", group = G_SESS)

bool   s5On = input.bool(false, "", inline = "s5", group = G_SESS, tooltip = "A fifth, fully user-defined session window — set its own name and time range below.")
string s5Nm = input.string("Custom", "", inline = "s5", group = G_SESS)
string s5Tm = input.session("0000-0100", "", inline = "s5", group = G_SESS)

// ============================ Inputs — Logic ============================
float  entryPct    = input.float(50, "Entry Retracement (%)", minval = 1, maxval = 99, step = 0.5, group = G_LOGIC, tooltip = "Measured from the session low for longs and from the session high for shorts. 50 = midpoint either way.")
string tieMode     = input.string("Candle Direction", "Same-Bar Tie-Break", options = ["Candle Direction", "Assume Low First", "Assume High First", "Skip Session"], group = G_LOGIC, tooltip = "Used when one bar sets both the session high and low. 'Candle Direction' assumes a bullish bar printed its low first.")
string bothHit     = input.string("Stop First", "Stop & Target Hit Same Bar", options = ["Stop First", "Target First"], group = G_LOGIC, tooltip = "Bar-level data cannot resolve the true sequence. 'Stop First' is the conservative assumption.")
bool   sameBarExit = input.bool(true, "Allow Exit On Entry Bar", group = G_LOGIC)
bool   anchorStart = input.bool(true, "Anchor 50% Line To Session Start", group = G_LOGIC)
int    maxWait     = input.int(0, "Cancel Pending Setup After N Bars", minval = 0, group = G_LOGIC, tooltip = "0 = never expire on bar count.")
bool   cancelOnNew = input.bool(true, "Cancel Unresolved Setup At Session Reopen", group = G_LOGIC)
int    maxSetups   = input.int(5, "Setups Kept Per Session", minval = 1, maxval = 50, group = G_LOGIC)
bool   useAlerts   = input.bool(true, "Enable Alerts", group = G_LOGIC, tooltip = "Create the alert with 'Any alert() function call'.")

// ============================ Inputs — Range Markers ============================
bool   showBox    = input.bool(true, "Show Session Range Box", group = G_MARK)
int    boxTransp  = input.int(90, "Box Transparency", minval = 0, maxval = 100, group = G_MARK)
color  formingCol = input.color(NEUT_COLOR, "Forming Color", group = G_MARK)
color  hiCircCol  = input.color(BEAR_COLOR, "High First", inline = "cc", group = G_MARK)
color  loCircCol  = input.color(BULL_COLOR, "Low First", inline = "cc", group = G_MARK)
int    circSizePt = input.int(5, "Circle Size (pt)", minval = 1, maxval = 36, group = G_MARK, tooltip = "Typographic points. v6 accepts int label sizes, which go finer and smaller than the size.* constants. size.tiny is roughly 7pt, so anything below that is smaller than the smallest named size.")
bool   showBoth   = input.bool(false, "Also Mark Second Extreme", group = G_MARK)

// ============================ Inputs — Levels ============================
color  longCol      = input.color(BULL_COLOR, "Long", inline = "bias", group = G_LVL)
color  shortCol     = input.color(BEAR_COLOR, "Short", inline = "bias", group = G_LVL)
int    entryW       = input.int(2, "Entry Line", minval = 1, maxval = 5, inline = "e", group = G_LVL)
string entryStyleIn = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "e", group = G_LVL)
color  stopCol      = input.color(#f23645, "Stop Line", inline = "s", group = G_LVL)
int    stopW        = input.int(1, "", minval = 1, maxval = 5, inline = "s", group = G_LVL)
string stopStyleIn  = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], inline = "s", group = G_LVL)
color  tgtCol       = input.color(#089981, "Target Line", inline = "t", group = G_LVL)
int    tgtW         = input.int(1, "", minval = 1, maxval = 5, inline = "t", group = G_LVL)
string tgtStyleIn   = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], inline = "t", group = G_LVL)
bool   showLbls     = input.bool(true, "Show Level Labels", inline = "lbl", group = G_LVL)
bool   showPx       = input.bool(true, "With Price", inline = "lbl", group = G_LVL)
string lblSizeIn    = input.string("Small", "Label Size", options = ["Tiny", "Small", "Normal", "Large"], group = G_LVL)
string lblPos       = input.string("End of Line", "Label Position", options = ["End of Line", "Center of Line"], group = G_LVL, tooltip = "End of Line rides the right edge of each level as it extends. Center of Line sits at the midpoint between the line's start and its current end, so it drifts right at half speed while the level is live.")
int    offEntry     = input.int(0, "Offset — Entry", minval = -100, maxval = 100, group = G_LVL, tooltip = "Bars. Applied after the anchor above. Negative pulls the label back into the chart.")
int    offStop      = input.int(0, "Offset — Stop", minval = -100, maxval = 100, group = G_LVL)
int    offTgt       = input.int(0, "Offset — Target", minval = -100, maxval = 100, group = G_LVL)
bool   ebOn         = input.bool(true, "Color Entry Bar", group = G_LVL, tooltip = "Repaints the bar that trades through the 50% so the trigger is easy to find. Body, border and wick are set independently.")
color  ebBodyCol    = input.color(#ffeb3b, "Body", inline = "eb", group = G_LVL)
color  ebBordCol    = input.color(#ffeb3b, "Border", inline = "eb", group = G_LVL)
color  ebWickCol    = input.color(#ffeb3b, "Wick", inline = "eb", group = G_LVL)

// ============================ Inputs — Dashboard ============================
bool   showDash  = input.bool(true, "Show Dashboard", group = G_DASH)
string dashPos   = input.string("Top Right", "Position", options = ["Top Right", "Middle Right", "Bottom Right", "Top Left", "Middle Left", "Bottom Left"], group = G_DASH)
string dashSize  = input.string("Small", "Text Size", options = ["Tiny", "Small", "Normal", "Large"], group = G_DASH)
bool   showRec   = input.bool(true, "Show W-L Record", group = G_DASH)

// ============================ Helpers ============================
f_size(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : size.large

f_lstyle(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

f_tpos(string s) =>
    s == "Top Left" ? position.top_left : s == "Middle Left" ? position.middle_left : s == "Bottom Left" ? position.bottom_left : s == "Middle Right" ? position.middle_right : s == "Bottom Right" ? position.bottom_right : position.top_right

f_px(float p) =>
    str.tostring(p, format.mintick)

// Chart timeframe as a readable label — timeframe.period alone prints a bare "1" on a 1-minute chart
string tfTxt = timeframe.isseconds ? str.tostring(timeframe.multiplier) + "s" : timeframe.isminutes ? (timeframe.multiplier >= 60 and timeframe.multiplier % 60 == 0 ? str.tostring(int(timeframe.multiplier / 60)) + "h" : str.tostring(timeframe.multiplier) + "m") : timeframe.isdaily ? str.tostring(timeframe.multiplier) + "D" : timeframe.isweekly ? str.tostring(timeframe.multiplier) + "W" : timeframe.ismonthly ? str.tostring(timeframe.multiplier) + "M" : timeframe.period

// Label anchor: end or midpoint of the owning line, plus a per-level bar offset
f_lblX(line ln, int off) =>
    int x2 = line.get_x2(ln)
    (lblPos == "Center of Line" ? int(math.round((line.get_x1(ln) + x2) / 2)) : x2) + off

f_lvlTxt(string tag, float p) =>
    showPx ? tag + "  " + f_px(p) : tag

string lvlLblStyle = lblPos == "Center of Line" ? label.style_label_down : label.style_label_left

f_stateTxt(int st) =>
    st == ST_PENDING ? "Waiting" : st == ST_ACTIVE ? "In Trade" : st == ST_WIN ? "SUCCESS" : st == ST_LOSS ? "FAILED" : "Void"

f_stateCol(int st) =>
    st == ST_WIN ? tgtCol : st == ST_LOSS ? stopCol : st == ST_ACTIVE ? chart.fg_color : color.new(chart.fg_color, 35)

// ============================ Types ============================
type Setup
    int          sIdx
    bool         isLong
    float        entry
    float        stop
    float        target
    int          state
    int          waited
    int          entryIdx
    box          ibBox
    label        circA
    label        circB
    line         entryLine
    label        entryLbl
    line         stopLine
    label        stopLbl
    line         tgtLine
    label        tgtLbl
    bool         purged

type SessionState
    string name
    string spec
    bool   enabled
    bool   inSess
    float  hi
    float  lo
    int    hiIdx
    int    loIdx
    int    startIdx
    bool   tieBull
    box    liveBox
    Setup  cur
    int    wins
    int    losses

// ============================ Storage ============================
var array<SessionState> sessions = array.new<SessionState>()
var array<Setup>        setups   = array.new<Setup>()

if barstate.isfirst
    sessions.push(SessionState.new(name = s1Nm, spec = s1Tm, enabled = s1On, inSess = false, tieBull = false, wins = 0, losses = 0))
    sessions.push(SessionState.new(name = s2Nm, spec = s2Tm, enabled = s2On, inSess = false, tieBull = false, wins = 0, losses = 0))
    sessions.push(SessionState.new(name = s3Nm, spec = s3Tm, enabled = s3On, inSess = false, tieBull = false, wins = 0, losses = 0))
    sessions.push(SessionState.new(name = s4Nm, spec = s4Tm, enabled = s4On, inSess = false, tieBull = false, wins = 0, losses = 0))
    sessions.push(SessionState.new(name = s5Nm, spec = s5Tm, enabled = s5On, inSess = false, tieBull = false, wins = 0, losses = 0))

// ============================ Methods ============================
method f_void(Setup s) =>
    if not s.purged
        s.state := ST_VOID
        line.set_color(s.entryLine, color.new(chart.fg_color, 55))
        line.set_style(s.entryLine, line.style_dotted)
        if not na(s.entryLbl)
            label.set_text(s.entryLbl, (s.isLong ? "LONG" : "SHORT") + "  —")
            label.set_textcolor(s.entryLbl, color.new(chart.fg_color, 45))
        if not na(s.stopLine)
            line.set_color(s.stopLine, color.new(chart.fg_color, 65))
        if not na(s.tgtLine)
            line.set_color(s.tgtLine, color.new(chart.fg_color, 65))

method f_step(Setup s) =>
    bool triggered = false
    if not s.purged and (s.state == ST_PENDING or s.state == ST_ACTIVE)
        // ---- waiting for the 50% to be wicked ----
        if s.state == ST_PENDING
            line.set_x2(s.entryLine, bar_index)
            if not na(s.entryLbl)
                label.set_x(s.entryLbl, f_lblX(s.entryLine, offEntry))

            if low <= s.entry and high >= s.entry
                s.state    := ST_ACTIVE
                s.entryIdx := bar_index
                triggered  := true

                s.stopLine := line.new(bar_index, s.stop, bar_index, s.stop, color = stopCol, width = stopW, style = f_lstyle(stopStyleIn))
                s.tgtLine  := line.new(bar_index, s.target, bar_index, s.target, color = tgtCol, width = tgtW, style = f_lstyle(tgtStyleIn))
                if showLbls
                    s.stopLbl := label.new(f_lblX(s.stopLine, offStop), s.stop, f_lvlTxt("STOP", s.stop), color = #00000000, textcolor = stopCol, style = lvlLblStyle, size = f_size(lblSizeIn))
                    s.tgtLbl  := label.new(f_lblX(s.tgtLine, offTgt), s.target, f_lvlTxt("TARGET", s.target), color = #00000000, textcolor = tgtCol, style = lvlLblStyle, size = f_size(lblSizeIn))

                if useAlerts
                    alert(sessions.get(s.sIdx).name + " IB " + (s.isLong ? "LONG" : "SHORT") + " entry tagged @ " + f_px(s.entry), alert.freq_once_per_bar)
            else
                s.waited += 1
                if maxWait > 0 and s.waited >= maxWait
                    s.f_void()

        // ---- live trade management ----
        if s.state == ST_ACTIVE and (sameBarExit or s.entryIdx < bar_index)
            line.set_x2(s.stopLine, bar_index)
            line.set_x2(s.tgtLine, bar_index)
            if not na(s.stopLbl)
                label.set_x(s.stopLbl, f_lblX(s.stopLine, offStop))
            if not na(s.tgtLbl)
                label.set_x(s.tgtLbl, f_lblX(s.tgtLine, offTgt))

            bool hitT = s.isLong ? high >= s.target : low <= s.target
            bool hitS = s.isLong ? low <= s.stop : high >= s.stop
            int  nxt  = hitT and hitS ? (bothHit == "Target First" ? ST_WIN : ST_LOSS) : hitT ? ST_WIN : hitS ? ST_LOSS : ST_ACTIVE

            if nxt != ST_ACTIVE
                s.state := nxt
                bool win = nxt == ST_WIN
                SessionState st = sessions.get(s.sIdx)
                if win
                    st.wins += 1
                else
                    st.losses += 1

                line.set_color(s.stopLine, win ? color.new(stopCol, 70) : stopCol)
                line.set_color(s.tgtLine, win ? tgtCol : color.new(tgtCol, 70))
                if not na(s.entryLbl)
                    label.set_text(s.entryLbl, (s.isLong ? "LONG" : "SHORT") + (win ? "  ✓" : "  ✗") + (showPx ? "  " + f_px(s.entry) : ""))
                if useAlerts
                    alert(st.name + " IB " + (s.isLong ? "LONG" : "SHORT") + (win ? " TARGET hit @ " + f_px(s.target) : " STOP hit @ " + f_px(s.stop)), alert.freq_once_per_bar)
    triggered

// ============================ Session Windows ============================
bool tfOK = timeframe.isintraday and timeframe.in_seconds() <= 3600

bool in1 = s1On and tfOK and not na(time(timeframe.period, s1Tm, tz))
bool in2 = s2On and tfOK and not na(time(timeframe.period, s2Tm, tz))
bool in3 = s3On and tfOK and not na(time(timeframe.period, s3Tm, tz))
bool in4 = s4On and tfOK and not na(time(timeframe.period, s4Tm, tz))
bool in5 = s5On and tfOK and not na(time(timeframe.period, s5Tm, tz))
array<bool> inFlags = array.from(in1, in2, in3, in4, in5)

// ============================ Range Build / Finalize ============================
for i = 0 to sessions.size() - 1
    SessionState st = sessions.get(i)
    if not st.enabled
        continue

    bool inNow = inFlags.get(i)

    if inNow and not st.inSess
        // ---- window open ----
        if cancelOnNew and not na(st.cur)
            if st.cur.state == ST_PENDING or st.cur.state == ST_ACTIVE
                st.cur.f_void()
        st.hi       := high
        st.lo       := low
        st.hiIdx    := bar_index
        st.loIdx    := bar_index
        st.startIdx := bar_index
        st.tieBull  := close > open
        st.liveBox  := showBox ? box.new(bar_index, high, bar_index, low, border_color = color.new(formingCol, 40), bgcolor = color.new(formingCol, boxTransp)) : na

    else if inNow
        // ---- inside the window: strict comparisons keep the EARLIER index on ties ----
        if high > st.hi
            st.hi      := high
            st.hiIdx   := bar_index
            st.tieBull := close > open
        if low < st.lo
            st.lo      := low
            st.loIdx   := bar_index
            st.tieBull := close > open
        if not na(st.liveBox)
            box.set_right(st.liveBox, bar_index)
            box.set_top(st.liveBox, st.hi)
            box.set_bottom(st.liveBox, st.lo)

    else if st.inSess
        // ---- window closed: build the setup ----
        float rng  = st.hi - st.lo
        bool  tie  = st.hiIdx == st.loIdx
        bool  skip = na(rng) or rng <= 0 or (tie and tieMode == "Skip Session")

        if not skip
            bool  firstHigh = tie ? (tieMode == "Assume High First" ? true : tieMode == "Assume Low First" ? false : not st.tieBull) : st.hiIdx < st.loIdx
            bool  isLong    = not firstHigh
            float entryP    = isLong ? st.lo + rng * entryPct / 100.0 : st.hi - rng * entryPct / 100.0
            float tgtP      = isLong ? st.hi : st.lo
            float stopP     = isLong ? st.lo : st.hi
            color biasCol   = isLong ? longCol : shortCol

            if not na(st.liveBox)
                box.set_bgcolor(st.liveBox, color.new(biasCol, boxTransp))
                box.set_border_color(st.liveBox, color.new(biasCol, 40))

            int   fIdx = firstHigh ? st.hiIdx : st.loIdx
            float fPx  = firstHigh ? st.hi : st.lo
            color fCol = firstHigh ? hiCircCol : loCircCol
            int   nIdx = firstHigh ? st.loIdx : st.hiIdx
            float nPx  = firstHigh ? st.lo : st.hi
            color nCol = firstHigh ? loCircCol : hiCircCol

            label cA = label.new(fIdx, fPx, "", color = fCol, style = label.style_circle, size = circSizePt)
            label cB = showBoth ? label.new(nIdx, nPx, "", color = color.new(nCol, 60), style = label.style_circle, size = circSizePt) : na

            int   anchor = anchorStart ? st.startIdx : bar_index
            line  eLine  = line.new(anchor, entryP, bar_index, entryP, color = biasCol, width = entryW, style = f_lstyle(entryStyleIn))
            label eLbl   = showLbls ? label.new(f_lblX(eLine, offEntry), entryP, f_lvlTxt(isLong ? "LONG" : "SHORT", entryP), color = #00000000, textcolor = biasCol, style = lvlLblStyle, size = f_size(lblSizeIn)) : na

            Setup nw = Setup.new(sIdx = i, isLong = isLong, entry = entryP, stop = stopP, target = tgtP, state = ST_PENDING, waited = 0, entryIdx = na, ibBox = st.liveBox, circA = cA, circB = cB, entryLine = eLine, entryLbl = eLbl, stopLine = na, stopLbl = na, tgtLine = na, tgtLbl = na, purged = false)
            setups.push(nw)
            st.cur := nw

            if useAlerts
                alert(st.name + " IB armed " + (isLong ? "LONG" : "SHORT") + " | entry " + f_px(entryP) + " | stop " + f_px(stopP) + " | target " + f_px(tgtP), alert.freq_once_per_bar)
        else
            box.delete(st.liveBox)
        st.liveBox := na

    st.inSess := inNow

// ============================ Setup Management ============================
if setups.size() > 0
    for i = 0 to setups.size() - 1
        setups.get(i).f_step()

// Entry bar highlight — keyed off each setup's stored entryIdx rather than the
// one-shot trigger tick. On a live, still-forming bar the trigger tick can occur
// several recalculations before the bar closes; f_step() only reports "triggered"
// on that single tick (it's gated behind "state == ST_PENDING", which is already
// false by later ticks), so relying on that return value let the highlight get
// dropped by the time the bar committed to history. entryIdx is a stored field
// that, once set, stays bar_index for that bar on every recalculation — including
// the bar's closing one — so checking it directly makes the highlight persist.
bool entryBarNow = false
if setups.size() > 0
    for i = 0 to setups.size() - 1
        if setups.get(i).entryIdx == bar_index
            entryBarNow := true

// Entry bar highlight — body, border and wick are independent
plotcandle(ebOn and entryBarNow ? open : na, ebOn and entryBarNow ? high : na, ebOn and entryBarNow ? low : na, ebOn and entryBarNow ? close : na, title = "Entry Bar", color = ebBodyCol, wickcolor = ebWickCol, bordercolor = ebBordCol, editable = false)

// Prune the oldest RESOLVED setups so drawing counts stay bounded
int cap = maxSetups * 4
bool pruned = true
while setups.size() > cap and pruned
    pruned := false
    for i = 0 to setups.size() - 1
        Setup s = setups.get(i)
        if s.state != ST_PENDING and s.state != ST_ACTIVE
            s.purged := true
            box.delete(s.ibBox)
            label.delete(s.circA)
            label.delete(s.circB)
            line.delete(s.entryLine)
            label.delete(s.entryLbl)
            line.delete(s.stopLine)
            label.delete(s.stopLbl)
            line.delete(s.tgtLine)
            label.delete(s.tgtLbl)
            setups.remove(i)
            pruned := true
            break

// ============================ Dashboard ============================
var table dash = na

int cRec = showRec ? 6 : -1
int nCol = 6 + (cRec >= 0 ? 1 : 0)

int nRow = sessions.size() + 2

if showDash and barstate.islast
    if na(dash)
        dash := table.new(f_tpos(dashPos), nCol, nRow, border_width = 1, frame_width = 1, frame_color = color.new(chart.fg_color, 70), border_color = color.new(chart.fg_color, 80))

    color  hdrBg  = color.new(chart.fg_color, 90)
    color  cellBg = color.new(chart.bg_color, 20)
    string tsz    = f_size(dashSize)

    table.cell(dash, 0, 0, "SESSION", text_color = chart.fg_color, bgcolor = hdrBg, text_size = tsz)
    table.cell(dash, 1, 0, "BIAS",    text_color = chart.fg_color, bgcolor = hdrBg, text_size = tsz)
    table.cell(dash, 2, 0, "ENTRY",   text_color = chart.fg_color, bgcolor = hdrBg, text_size = tsz)
    table.cell(dash, 3, 0, "STOP",    text_color = chart.fg_color, bgcolor = hdrBg, text_size = tsz)
    table.cell(dash, 4, 0, "TARGET",  text_color = chart.fg_color, bgcolor = hdrBg, text_size = tsz)
    table.cell(dash, 5, 0, "RESULT",  text_color = chart.fg_color, bgcolor = hdrBg, text_size = tsz)
    if cRec >= 0
        table.cell(dash, cRec, 0, "W-L", text_color = chart.fg_color, bgcolor = hdrBg, text_size = tsz)

    // Session window(s) open on this bar, collected while the rows are drawn
    string liveSess = ""

    for i = 0 to sessions.size() - 1
        SessionState st = sessions.get(i)
        int r = i + 1
        if st.enabled and st.inSess
            liveSess += (liveSess == "" ? "" : ",  ") + st.name + " " + st.spec

        string biasTxt = "—"
        string entTxt  = "—"
        string stpTxt  = "—"
        string tgtTxt  = "—"
        string resTxt  = st.enabled ? (st.inSess ? "Forming" : "—") : "Off"
        color  biasCl  = color.new(chart.fg_color, 45)
        color  resCl   = color.new(chart.fg_color, 45)

        if st.enabled and not na(st.cur)
            Setup s = st.cur
            biasTxt := s.isLong ? "LONG" : "SHORT"
            biasCl  := s.isLong ? longCol : shortCol
            entTxt  := f_px(s.entry)
            stpTxt  := f_px(s.stop)
            tgtTxt  := f_px(s.target)
            if not st.inSess
                resTxt := f_stateTxt(s.state)
                resCl  := f_stateCol(s.state)

        table.cell(dash, 0, r, st.name, text_color = st.enabled ? chart.fg_color : color.new(chart.fg_color, 60), bgcolor = cellBg, text_size = tsz)
        table.cell(dash, 1, r, biasTxt, text_color = biasCl, bgcolor = cellBg, text_size = tsz)
        table.cell(dash, 2, r, entTxt,  text_color = color.new(chart.fg_color, 15), bgcolor = cellBg, text_size = tsz)
        table.cell(dash, 3, r, stpTxt,  text_color = stopCol, bgcolor = cellBg, text_size = tsz)
        table.cell(dash, 4, r, tgtTxt,  text_color = tgtCol, bgcolor = cellBg, text_size = tsz)
        table.cell(dash, 5, r, resTxt,  text_color = resCl, bgcolor = cellBg, text_size = tsz)
        if cRec >= 0
            table.cell(dash, cRec, r, str.tostring(st.wins) + "-" + str.tostring(st.losses), text_color = color.new(chart.fg_color, 25), bgcolor = cellBg, text_size = tsz)

    int footerRow = sessions.size() + 1
    string warn    = tfOK ? "" : "  ⚠ use an intraday TF ≤ 60m"
    string sessTxt = liveSess == "" ? "no session live" : liveSess
    table.cell(dash, 0, footerRow, tz + "  ·  " + sessTxt + "  ·  " + tfTxt + warn, text_color = color.new(chart.fg_color, 40), bgcolor = hdrBg, text_size = tsz, text_halign = text.align_left)
    table.merge_cells(dash, 0, footerRow, nCol - 1, footerRow)
