//@version=6
indicator(
     "Equalhigh - GAPO Easy Mode",
     shorttitle = "GAPO Easy",
     overlay = false,
     precision = 1
)

// =============================================================================
// 1. INPUTS
// =============================================================================

groupGapo = "1. GAPO calculation"
gapoLength = input.int(14, "GAPO period", minval = 2, maxval = 100, group = groupGapo)
rankLength = input.int(252, "Percentile lookback", minval = 50, maxval = 1000, group = groupGapo)

groupRegime = "2. Volatility regime"
compressionLevel = input.float(20.0, "Compression threshold", minval = 1.0, maxval = 40.0, step = 1.0, group = groupRegime)
highVariabilityLevel = input.float(80.0, "High variability threshold", minval = 60.0, maxval = 99.0, step = 1.0, group = groupRegime)
expansionBars = input.int(2, "Rising bars required", minval = 1, maxval = 5, group = groupRegime)

groupBreakout = "3. Breakout confirmation"
breakoutLength = input.int(20, "Donchian breakout period", minval = 2, maxval = 200, group = groupBreakout)
activationWindow = input.int(15, "Maximum bars after compression", minval = 1, maxval = 100, group = groupBreakout)
trendLength = input.int(50, "Direction filter EMA", minval = 2, maxval = 300, group = groupBreakout)
confirmAtClose = input.bool(true, "Confirm signals at bar close", group = groupBreakout)

groupDisplay = "4. Display"
showBackground = input.bool(true, "Color the volatility regime", group = groupDisplay)
showSignals = input.bool(true, "Show breakout signals", group = groupDisplay)
showDashboard = input.bool(true, "Show Easy Mode dashboard", group = groupDisplay)
showDonchianData = input.bool(false, "Show Donchian values in Data Window", group = groupDisplay)

// =============================================================================
// 2. ORIGINAL GAPO AND PERCENTILE NORMALIZATION
// =============================================================================

highestPrice = ta.highest(high, gapoLength)
lowestPrice = ta.lowest(low, gapoLength)
priceRange = highestPrice - lowestPrice

// Original Gopalakrishnan Range Index:
// GAPO = ln(highest high - lowest low) / ln(period)
gapoRaw = priceRange > 0.0 ? math.log(priceRange) / math.log(gapoLength) : na

// The raw GAPO depends on the price scale. Its rolling percentile is easier to
// interpret and always ranges from 0 to 100.
gapoPercentile = ta.percentrank(gapoRaw, rankLength)

// =============================================================================
// 3. REGIME DETECTION
// =============================================================================

barConfirmed = not confirmAtClose or barstate.isconfirmed
isCompression = gapoPercentile <= compressionLevel
isHighVariability = gapoPercentile >= highVariabilityLevel
isExpanding = gapoPercentile > compressionLevel and ta.rising(gapoPercentile, expansionBars)

barsSinceCompression = ta.barssince(isCompression)
recentCompression = not na(barsSinceCompression) and barsSinceCompression <= activationWindow

trendEma = ta.ema(close, trendLength)
bullishExpansion = recentCompression and isExpanding and close > trendEma
bearishExpansion = recentCompression and isExpanding and close < trendEma

newCompression = barConfirmed and isCompression and not isCompression[1]
newBullishExpansion = barConfirmed and bullishExpansion and not bullishExpansion[1]
newBearishExpansion = barConfirmed and bearishExpansion and not bearishExpansion[1]

// =============================================================================
// 4. DIRECTIONAL BREAKOUTS AFTER COMPRESSION
// =============================================================================

// [1] excludes the current bar so that the current close can genuinely break
// the previous Donchian boundary.
previousDonchianHigh = ta.highest(high, breakoutLength)[1]
previousDonchianLow = ta.lowest(low, breakoutLength)[1]

priceCrossesUp = ta.crossover(close, previousDonchianHigh)
priceCrossesDown = ta.crossunder(close, previousDonchianLow)

bullishBreakout = barConfirmed and recentCompression and isExpanding and priceCrossesUp
bearishBreakout = barConfirmed and recentCompression and isExpanding and priceCrossesDown

// =============================================================================
// 5. EASY MODE DISPLAY
// =============================================================================

compressionLine = hline(compressionLevel, "Compression threshold", color = color.new(color.blue, 25), linestyle = hline.style_dashed)
highVariabilityLine = hline(highVariabilityLevel, "High variability", color = color.new(color.orange, 25), linestyle = hline.style_dashed)
zeroLine = hline(0.0, "Minimum", color = color.new(color.white, 100), display = display.none)
maximumLine = hline(100.0, "Maximum", color = color.new(color.white, 100), display = display.none)
middleLine = hline(50.0, "Median percentile", color = color.new(color.gray, 75), linestyle = hline.style_dotted)

fill(zeroLine, compressionLine, color = color.new(color.blue, 90), title = "Compression zone")
fill(highVariabilityLine, maximumLine, color = color.new(color.orange, 92), title = "High variability zone")

gapoColor = isCompression ? color.blue : bullishExpansion ? color.lime : bearishExpansion ? color.red : isHighVariability ? color.orange : color.gray

plot(
     gapoPercentile,
     "GAPO percentile",
     color = gapoColor,
     linewidth = 3
)

// Raw values remain available for audit without cluttering the panel.
plot(gapoRaw, "Original GAPO", color = color.new(color.gray, 100), display = display.data_window)
plot(showDonchianData ? previousDonchianHigh : na, "Previous Donchian high", color = color.new(color.green, 100), display = display.data_window)
plot(showDonchianData ? previousDonchianLow : na, "Previous Donchian low", color = color.new(color.red, 100), display = display.data_window)

plotshape(
     showSignals and bullishBreakout,
     title = "Bullish volatility breakout",
     style = shape.labelup,
     location = location.bottom,
     color = color.green,
     textcolor = color.white,
     size = size.tiny,
     text = "BUY"
)

plotshape(
     showSignals and bearishBreakout,
     title = "Bearish volatility breakout",
     style = shape.labeldown,
     location = location.top,
     color = color.red,
     textcolor = color.white,
     size = size.tiny,
     text = "SELL"
)

regimeBackground = isCompression ? color.new(color.blue, 91) : bullishExpansion ? color.new(color.green, 92) : bearishExpansion ? color.new(color.red, 92) : na
bgcolor(showBackground ? regimeBackground : na, title = "GAPO regime")

// =============================================================================
// 6. DASHBOARD
// =============================================================================

string stateText = isCompression ? "COMPRESSION" : bullishBreakout ? "BULL BREAKOUT" : bearishBreakout ? "BEAR BREAKOUT" : bullishExpansion ? "BULLISH RELEASE" : bearishExpansion ? "BEARISH RELEASE" : isHighVariability ? "HIGH VARIABILITY" : "NEUTRAL"
color stateColor = isCompression ? color.blue : bullishBreakout ? color.green : bearishBreakout ? color.red : bullishExpansion ? color.green : bearishExpansion ? color.red : isHighVariability ? color.orange : color.gray
string armedText = recentCompression ? "YES" : "NO"

var table dashboard = table.new(
     position.top_right,
     2,
     3,
     border_width = 1,
     border_color = color.new(color.gray, 50)
)

if barstate.islast and showDashboard
    table.cell(dashboard, 0, 0, "GAPO STATE", bgcolor = color.new(color.black, 10), text_color = color.white, text_size = size.small)
    table.cell(dashboard, 1, 0, stateText, bgcolor = stateColor, text_color = color.white, text_size = size.small)
    table.cell(dashboard, 0, 1, "PERCENTILE", bgcolor = color.new(color.black, 10), text_color = color.white, text_size = size.small)
    table.cell(dashboard, 1, 1, str.tostring(gapoPercentile, "#.0"), bgcolor = color.new(stateColor, 65), text_color = color.white, text_size = size.small)
    table.cell(dashboard, 0, 2, "BREAKOUT ARMED", bgcolor = color.new(color.black, 10), text_color = color.white, text_size = size.small)
    table.cell(dashboard, 1, 2, armedText, bgcolor = recentCompression ? color.new(color.blue, 45) : color.new(color.gray, 65), text_color = color.white, text_size = size.small)

// =============================================================================
// 7. ALERTS
// =============================================================================

alertcondition(newCompression, "GAPO - New compression", "GAPO entered compression on {{ticker}} ({{interval}}). Prepare for a possible volatility release.")
alertcondition(newBullishExpansion, "GAPO - Bullish release", "GAPO volatility is expanding with a bullish bias on {{ticker}} ({{interval}}).")
alertcondition(newBearishExpansion, "GAPO - Bearish release", "GAPO volatility is expanding with a bearish bias on {{ticker}} ({{interval}}).")
alertcondition(bullishBreakout, "GAPO - Bullish breakout", "Bullish Donchian breakout after GAPO compression on {{ticker}} ({{interval}}).")
alertcondition(bearishBreakout, "GAPO - Bearish breakout", "Bearish Donchian breakout after GAPO compression on {{ticker}} ({{interval}}).")

