// ───── Previous HTF S/R memory boxes (15M and higher only)
f_memory_box_visible(bool enabled, string sourceTimeframe) =>
    float sourceSeconds = timeframe.in_seconds(sourceTimeframe)
    enabled and showPreviousHTFMemory and
         (not showOnlyChartAndHigherTFBoxes or
          (not na(boxChartSeconds) and not na(sourceSeconds) and sourceSeconds >= boxChartSeconds))

f_previous_zone_text(string tfLabel, bool bullishZone) =>
    showZoneLabels ? "PREV " + tfLabel + " " + (bullishZone ? "SUPPORT" : "RESISTANCE") : ""

f_manage_memory_box(box existingBox, bool enabled, int startTime, float topPrice, float bottomPrice, bool bullishZone, string tfLabel) =>
    box outputBox = existingBox
    bool validZone = enabled and not na(startTime) and not na(topPrice) and not na(bottomPrice)
    color memoryBase = bullishZone ? color.green : color.red
    color memoryBackground = color.new(memoryBase, previousHTFMemoryTransparency)
    int memoryBorderTransparency = math.max(previousHTFMemoryTransparency - 10, 70)
    color memoryBorder = color.new(memoryBase, memoryBorderTransparency)
    color memoryText = color.new(zoneLabelTextColor, 55)

    if validZone
        if na(outputBox)
            outputBox := box.new(left=startTime, top=topPrice, right=time, bottom=bottomPrice,
                 xloc=xloc.bar_time, extend=extend.right, bgcolor=memoryBackground,
                 border_color=memoryBorder, border_width=1, text=f_previous_zone_text(tfLabel, bullishZone),
                 text_color=memoryText, text_size=size.small, text_halign=text.align_right, text_valign=text.align_center)
        else
            box.set_left(outputBox, startTime)
            box.set_top(outputBox, topPrice)
            box.set_bottom(outputBox, bottomPrice)
            box.set_bgcolor(outputBox, memoryBackground)
            box.set_border_color(outputBox, memoryBorder)
            box.set_border_width(outputBox, 1)
            box.set_text(outputBox, f_previous_zone_text(tfLabel, bullishZone))
            box.set_text_color(outputBox, memoryText)
            box.set_text_size(outputBox, size.small)
    else if not na(outputBox)
        box.delete(outputBox)
        outputBox := na
    outputBox

