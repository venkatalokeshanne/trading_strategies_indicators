//@version=6
indicator('6 Indicator Master', shorttitle = '6X MASTER', overlay = true)

//==================================================
// 1. CM MACD
//==================================================
macdFast = ta.ema(close, 12)
macdSlow = ta.ema(close, 26)
macdLine = macdFast - macdSlow
macdSignal = ta.sma(macdLine, 9)
macdHist = macdLine - macdSignal

macdBear = macdLine < macdSignal and macdHist <= 0
macdBull = macdLine > macdSignal and macdHist >= 0

//==================================================
// 2. SQUEEZE MOMENTUM
//==================================================
sqLen = 20

sqHigh = ta.highest(high, sqLen)
sqLow = ta.lowest(low, sqLen)
sqAverage = ta.sma(close, sqLen)

sqSource = close - ((sqHigh + sqLow) / 2 + sqAverage) / 2

sqValue = ta.linreg(sqSource, sqLen, 0)

sqBear = sqValue < 0 and sqValue < sqValue[1]
sqBull = sqValue > 0 and sqValue > sqValue[1]

//==================================================
// 3. WAVETREND
//==================================================
wtN1 = 10
wtN2 = 21

wtAP = hlc3
wtESA = ta.ema(wtAP, wtN1)
wtD = ta.ema(math.abs(wtAP - wtESA), wtN1)

wtCI = wtD != 0 ? (wtAP - wtESA) / (0.015 * wtD) : 0

wt1 = ta.ema(wtCI, wtN2)
wt2 = ta.sma(wt1, 4)

wtBear = wt1 < wt2
wtBull = wt1 > wt2

//==================================================
// 4. BULL BEAR POWER TREND
//==================================================
bullTrend = (close - ta.lowest(low, 50)) / ta.atr(5)
bearTrend = (ta.highest(high, 50) - close) / ta.atr(5)

bbTrend = bullTrend - bearTrend

bbBear = bbTrend < 0
bbBull = bbTrend > 0

//==================================================
// 5. SUPERTREND
//==================================================
[stLine, stDirection] = ta.supertrend(3.0, 10)

stBear = stDirection > 0
stBull = stDirection < 0

//==================================================
// 6. TRADE PRO REJECTION ZONE
//==================================================
fastMA = ta.ema(close, 20)
slowMA = ta.ema(close, 50)

rzBear = fastMA < slowMA
rzBull = fastMA > slowMA

//==================================================
// COUNT
//==================================================
bearCount = 0
bearCount := bearCount + (macdBear ? 1 : 0)
bearCount := bearCount + (sqBear ? 1 : 0)
bearCount := bearCount + (wtBear ? 1 : 0)
bearCount := bearCount + (bbBear ? 1 : 0)
bearCount := bearCount + (stBear ? 1 : 0)
bearCount := bearCount + (rzBear ? 1 : 0)

bullCount = 0
bullCount := bullCount + (macdBull ? 1 : 0)
bullCount := bullCount + (sqBull ? 1 : 0)
bullCount := bullCount + (wtBull ? 1 : 0)
bullCount := bullCount + (bbBull ? 1 : 0)
bullCount := bullCount + (stBull ? 1 : 0)
bullCount := bullCount + (rzBull ? 1 : 0)

allBear = bearCount == 6
allBull = bullCount == 6

bearTrigger = allBear and not allBear[1]
bullTrigger = allBull and not allBull[1]

//==================================================
// ALERTS
//==================================================
alertcondition(bearTrigger, title = '6/6 BEARISH', message = 'ALL 6 INDICATORS ARE BEARISH')
alertcondition(bullTrigger, title = '6/6 BULLISH', message = 'ALL 6 INDICATORS ARE BULLISH')

//==================================================
// CHART SIGNAL
//==================================================
plotshape(bearTrigger, title = '6/6 Bearish', style = shape.labeldown, location = location.abovebar, text = '6/6 BEAR', color = color.red, textcolor = color.white)

plotshape(bullTrigger, title = '6/6 Bullish', style = shape.labelup, location = location.belowbar, text = '6/6 BULL', color = color.green, textcolor = color.white)

//==================================================
// DASHBOARD
//==================================================
var table dash = table.new(position.top_right, 3, 9, border_width = 1)

if barstate.islast

    table.cell(dash, 0, 0, '#', bgcolor = color.black, text_color = color.white)
    table.cell(dash, 1, 0, 'INDICATOR', bgcolor = color.black, text_color = color.white)
    table.cell(dash, 2, 0, 'STATUS', bgcolor = color.black, text_color = color.white)

    table.cell(dash, 0, 1, '1')
    table.cell(dash, 1, 1, 'MACD')
    table.cell(dash, 2, 1, macdBear ? 'BEAR' : macdBull ? 'BULL' : 'NEUTRAL', bgcolor = macdBear ? color.red : macdBull ? color.green : color.gray, text_color = color.white)

    table.cell(dash, 0, 2, '2')
    table.cell(dash, 1, 2, 'SQUEEZE')
    table.cell(dash, 2, 2, sqBear ? 'BEAR' : sqBull ? 'BULL' : 'NEUTRAL', bgcolor = sqBear ? color.red : sqBull ? color.green : color.gray, text_color = color.white)

    table.cell(dash, 0, 3, '3')
    table.cell(dash, 1, 3, 'WAVETREND')
    table.cell(dash, 2, 3, wtBear ? 'BEAR' : wtBull ? 'BULL' : 'NEUTRAL', bgcolor = wtBear ? color.red : wtBull ? color.green : color.gray, text_color = color.white)

    table.cell(dash, 0, 4, '4')
    table.cell(dash, 1, 4, 'BBPT')
    table.cell(dash, 2, 4, bbBear ? 'BEAR' : bbBull ? 'BULL' : 'NEUTRAL', bgcolor = bbBear ? color.red : bbBull ? color.green : color.gray, text_color = color.white)

    table.cell(dash, 0, 5, '5')
    table.cell(dash, 1, 5, 'SUPERTREND')
    table.cell(dash, 2, 5, stBear ? 'BEAR' : stBull ? 'BULL' : 'NEUTRAL', bgcolor = stBear ? color.red : stBull ? color.green : color.gray, text_color = color.white)

    table.cell(dash, 0, 6, '6')
    table.cell(dash, 1, 6, 'REJECTION')
    table.cell(dash, 2, 6, rzBear ? 'BEAR' : rzBull ? 'BULL' : 'NEUTRAL', bgcolor = rzBear ? color.red : rzBull ? color.green : color.gray, text_color = color.white)

    table.cell(dash, 1, 7, 'BEAR COUNT')
    table.cell(dash, 2, 7, str.tostring(bearCount) + ' / 6', bgcolor = allBear ? color.red : color.gray, text_color = color.white)

    table.cell(dash, 1, 8, 'MASTER')
    table.cell(dash, 2, 8, allBear ? 'BEARISH' : allBull ? 'BULLISH' : 'WAIT', bgcolor = allBear ? color.red : allBull ? color.green : color.gray, text_color = color.white)
