//@version=6

indicator('Multi_MA', overlay = true)

ma(source, length, type) =>
    switch type
        'SMA' => ta.sma(source, length)
        'EMA' => ta.ema(source, length)
        'RMA' => ta.rma(source, length)
        'WMA' => ta.wma(source, length)
        'VWMA' => ta.vwma(source, length)

maType = input.string(defval = 'SMA', options = ['SMA', 'EMA', 'RMA', 'WMA', 'VWMA'], group = 'MA')

src = close

ia = input(7,'input1', group = 'MA')
ib = input(21, 'input2',group = 'MA')
ic = input(60, 'input3',group = 'MA')
id = input(120, 'input4',group = 'MA')

a = ma(close, ia, maType)
b = ma(close, ib, maType)
c = ma(close, ic, maType)
d = ma(close, id, maType)

// 골든크로스 / 데드크로스 분리
goldenCross = ta.crossover(c, d)   // c가 d를 위로 돌파 (상승 전환)
deadCross   = ta.crossunder(c, d)  // c가 d를 아래로 이탈 (하락 전환)

plotshape(goldenCross, title = 'Golden Cross', text = 'GC', textcolor = color.white, style = shape.labelup, location = location.belowbar, color = color.rgb(34, 139, 34), size = size.small)
plotshape(deadCross, title = 'Dead Cross', text = 'DC', textcolor = color.white, style = shape.labeldown, location = location.abovebar, color = color.rgb(200, 40, 40), size = size.small)

plot(a, 'plot1', color = color.rgb(233, 33, 243), linewidth = math.max(1, input(defval = 1, title = 'size1')))
plot(b, 'plot2',color = color.rgb(161, 118, 53), linewidth = math.max(1, input(defval = 1, title = 'size2')))
plot(c, 'plot3',color = color.rgb(79, 199, 109), linewidth = math.max(1, input(defval = 1, title = 'size3')))
plot(d, 'plot4',color = color.rgb(6, 164, 243), linewidth = math.max(1, input(defval = 1, title = 'size4')))

// 알림
alertcondition(goldenCross, title = 'Golden Cross', message = 'Golden Cross: MA{{plot("plot3")}} crossed above MA{{plot("plot4")}}')
alertcondition(deadCross, title = 'Dead Cross', message = 'Dead Cross: MA crossed below')