//@version=6
indicator(
     "Moneybagg Flem Indicator v1.4",
     overlay = true,
     max_labels_count = 100,
     max_lines_count = 50
)

//====================================================
// INPUT GROUPS
//====================================================

string groupRisk      = "1. Risk Management"
string groupSignals   = "2. Signal Settings"
string groupFlow      = "3. Order Flow Proxy"
string groupChart     = "4. Chart Display"
string groupDashboard = "5. Dashboard"
string groupLevels    = "6. Key Levels"

//====================================================
// RISK MANAGEMENT
//====================================================

float riskAmount = input.float(
     2000,
     "Maximum Dollar Risk",
     minval = 1,
     step = 100,
     group = groupRisk
)

string symbolType = input.string(
     "MNQ",
     "Futures Contract",
     options = ["NQ", "MNQ", "ES", "MES", "YM", "MYM", "GC", "MGC"],
     group = groupRisk
)

int atrLength = input.int(
     10,
     "ATR Length",
     minval = 1,
     group = groupRisk
)

float atrMultiplier = input.float(
     1.5,
     "Stop-Loss ATR Multiplier",
     minval = 0.1,
     step = 0.1,
     group = groupRisk
)

float tp1RR = input.float(
     2.0,
     "TP1 Risk-to-Reward",
     minval = 0.1,
     step = 0.1,
     group = groupRisk
)

float tp2RR = input.float(
     3.0,
     "TP2 Risk-to-Reward",
     minval = 0.1,
     step = 0.1,
     group = groupRisk
)

//====================================================
// SIGNAL SETTINGS
//====================================================

int fastEmaLength = input.int(
     21,
     "Fast EMA",
     minval = 1,
     group = groupSignals
)

int slowEmaLength = input.int(
     50,
     "Slow EMA",
     minval = 2,
     group = groupSignals
)

int rsiLength = input.int(
     14,
     "RSI Length",
     minval = 1,
     group = groupSignals
)

float longRsiMinimum = input.float(
     50,
     "Minimum RSI for BUY",
     minval = 1,
     maxval = 99,
     step = 1,
     group = groupSignals
)

float shortRsiMaximum = input.float(
     50,
     "Maximum RSI for SELL",
     minval = 1,
     maxval = 99,
     step = 1,
     group = groupSignals
)

int volumeLength = input.int(
     20,
     "Volume Average Length",
     minval = 1,
     group = groupSignals
)

string signalMode = input.string(
     "More Signals",
     "Signal Mode",
     options = ["More Signals", "Balanced", "Strict"],
     group = groupSignals
)

int minimumMtfScore = input.int(
     3,
     "Minimum Multi-Timeframe Score",
     minval = 1,
     maxval = 6,
     group = groupSignals
)

int signalCooldownBars = input.int(
     5,
     "Cooldown Between Signals",
     minval = 0,
     group = groupSignals
)

bool confirmAtClose = input.bool(
     true,
     "Confirm Signal at Candle Close",
     group = groupSignals
)

//====================================================
// ORDER FLOW PROXY
//====================================================

bool requireOrderFlow = input.bool(
     false,
     "Require Order Flow Confirmation",
     group = groupFlow
)

float volumeSpikeMultiplier = input.float(
     1.20,
     "Volume Spike Multiplier",
     minval = 0.1,
     step = 0.05,
     group = groupFlow
)

int liquidityLookback = input.int(
     15,
     "Liquidity Sweep Lookback",
     minval = 2,
     group = groupFlow
)

float keyLevelDistance = input.float(
     30,
     "Key-Level Distance in Points",
     minval = 0,
     step = 1,
     group = groupFlow
)

//====================================================
// CHART DISPLAY
//====================================================

bool showBuySellArrows = input.bool(
     true,
     "Show BUY/SELL Signals",
     group = groupChart
)

bool showSignalLabels = input.bool(
     true,
     "Show Entry Information",
     group = groupChart
)

string signalSizeInput = input.string(
     "Large",
     "Signal Arrow Size",
     options = ["Tiny", "Small", "Normal", "Large", "Huge"],
     group = groupChart
)

bool showLatestTradeLevels = input.bool(
     false,
     "Show Latest Entry / Stop / Targets",
     group = groupChart
)

int tradeLevelLength = input.int(
     20,
     "Trade-Level Line Length",
     minval = 1,
     maxval = 200,
     group = groupChart
)

bool showFastEma = input.bool(
     false,
     "Show Fast EMA",
     group = groupChart
)

bool showSlowEma = input.bool(
     false,
     "Show Slow EMA",
     group = groupChart
)

bool showVwap = input.bool(
     true,
     "Show VWAP",
     group = groupChart
)

bool colorOrderFlowCandles = input.bool(
     false,
     "Color Order Flow Candles",
     group = groupChart
)

//====================================================
// DASHBOARD
//====================================================

bool showDashboard = input.bool(
     true,
     "Show Dashboard",
     group = groupDashboard
)

string dashboardSizeInput = input.string(
     "Small",
     "Dashboard Size",
     options = ["Tiny", "Small", "Normal", "Large"],
     group = groupDashboard
)

string dashboardPositionInput = input.string(
     "Bottom Left",
     "Dashboard Position",
     options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right"],
     group = groupDashboard
)

//====================================================
// KEY LEVELS
//====================================================

bool showDailyLevels = input.bool(
     false,
     "Show Previous Daily High/Low",
     group = groupLevels
)

bool showWeeklyLevels = input.bool(
     false,
     "Show Previous Weekly High/Low",
     group = groupLevels
)

bool showMonthlyLevels = input.bool(
     false,
     "Show Previous Monthly High/Low",
     group = groupLevels
)

bool showPeriodOpens = input.bool(
     false,
     "Show Daily / Weekly / Monthly Opens",
     group = groupLevels
)

//====================================================
// DASHBOARD DISPLAY SETTINGS
//====================================================

dashboardTextSize =
     dashboardSizeInput == "Tiny"  ? size.tiny :
     dashboardSizeInput == "Small" ? size.small :
     dashboardSizeInput == "Large" ? size.large :
     size.normal

dashboardPosition =
     dashboardPositionInput == "Top Left" ? position.top_left :
     dashboardPositionInput == "Top Right" ? position.top_right :
     dashboardPositionInput == "Bottom Right" ? position.bottom_right :
     position.bottom_left

//====================================================
// FUTURES POINT VALUES
//====================================================

float pointValue =
     symbolType == "NQ"  ? 20.0 :
     symbolType == "MNQ" ? 2.0 :
     symbolType == "ES"  ? 50.0 :
     symbolType == "MES" ? 5.0 :
     symbolType == "YM"  ? 5.0 :
     symbolType == "MYM" ? 0.5 :
     symbolType == "GC"  ? 100.0 :
     symbolType == "MGC" ? 10.0 :
     1.0

//====================================================
// CORE CALCULATIONS
//====================================================

float atrValue = ta.atr(atrLength)

float stopDistance = atrValue * atrMultiplier
float tp1Distance = stopDistance * tp1RR
float tp2Distance = stopDistance * tp2RR

float riskPerContract = stopDistance * pointValue

float calculatedContracts =
     riskPerContract > 0
     ? math.floor(riskAmount / riskPerContract)
     : 0

float contracts = math.max(calculatedContracts, 0)

float fastEma = ta.ema(close, fastEmaLength)
float slowEma = ta.ema(close, slowEmaLength)

float rsiValue = ta.rsi(close, rsiLength)
float volumeAverage = ta.sma(volume, volumeLength)
float vwapValue = ta.vwap(hlc3)

//====================================================
// MULTI-TIMEFRAME FUNCTIONS
//====================================================

getFastEma(string timeframe) =>
    request.security(
         syminfo.tickerid,
         timeframe,
         ta.ema(close, fastEmaLength),
         gaps = barmerge.gaps_off,
         lookahead = barmerge.lookahead_off
    )

getSlowEma(string timeframe) =>
    request.security(
         syminfo.tickerid,
         timeframe,
         ta.ema(close, slowEmaLength),
         gaps = barmerge.gaps_off,
         lookahead = barmerge.lookahead_off
    )

//====================================================
// MULTI-TIMEFRAME VALUES
//====================================================

float fast1m = getFastEma("1")
float slow1m = getSlowEma("1")

float fast5m = getFastEma("5")
float slow5m = getSlowEma("5")

float fast15m = getFastEma("15")
float slow15m = getSlowEma("15")

float fast30m = getFastEma("30")
float slow30m = getSlowEma("30")

float fast1h = getFastEma("60")
float slow1h = getSlowEma("60")

float fast4h = getFastEma("240")
float slow4h = getSlowEma("240")

//====================================================
// MULTI-TIMEFRAME TREND
//====================================================

bool bull1m = fast1m > slow1m
bool bull5m = fast5m > slow5m
bool bull15m = fast15m > slow15m
bool bull30m = fast30m > slow30m
bool bull1h = fast1h > slow1h
bool bull4h = fast4h > slow4h

bool bear1m = fast1m < slow1m
bool bear5m = fast5m < slow5m
bool bear15m = fast15m < slow15m
bool bear30m = fast30m < slow30m
bool bear1h = fast1h < slow1h
bool bear4h = fast4h < slow4h

int bullScore =
     (bull1m ? 1 : 0) +
     (bull5m ? 1 : 0) +
     (bull15m ? 1 : 0) +
     (bull30m ? 1 : 0) +
     (bull1h ? 1 : 0) +
     (bull4h ? 1 : 0)

int bearScore =
     (bear1m ? 1 : 0) +
     (bear5m ? 1 : 0) +
     (bear15m ? 1 : 0) +
     (bear30m ? 1 : 0) +
     (bear1h ? 1 : 0) +
     (bear4h ? 1 : 0)

//====================================================
// HIGHER-TIMEFRAME KEY LEVELS
//====================================================

float previousDailyHigh = request.security(
     syminfo.tickerid,
     "D",
     high[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

float previousDailyLow = request.security(
     syminfo.tickerid,
     "D",
     low[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

float dailyOpen = request.security(
     syminfo.tickerid,
     "D",
     open,
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

float previousWeeklyHigh = request.security(
     syminfo.tickerid,
     "W",
     high[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

float previousWeeklyLow = request.security(
     syminfo.tickerid,
     "W",
     low[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

float weeklyOpen = request.security(
     syminfo.tickerid,
     "W",
     open,
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

float previousMonthlyHigh = request.security(
     syminfo.tickerid,
     "M",
     high[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

float previousMonthlyLow = request.security(
     syminfo.tickerid,
     "M",
     low[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

float monthlyOpen = request.security(
     syminfo.tickerid,
     "M",
     open,
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

//====================================================
// ORDER FLOW PROXY
//====================================================

bool volumeSpike =
     volume > volumeAverage * volumeSpikeMultiplier

float candleRange =
     math.max(high - low, syminfo.mintick)

bool buyPressure =
     close > open and
     close >= high - candleRange * 0.35 and
     volumeSpike

bool sellPressure =
     close < open and
     close <= low + candleRange * 0.35 and
     volumeSpike

float priorLowestLow =
     ta.lowest(low[1], liquidityLookback)

float priorHighestHigh =
     ta.highest(high[1], liquidityLookback)

bool bullishSweep =
     low < priorLowestLow and
     close > priorLowestLow

bool bearishSweep =
     high > priorHighestHigh and
     close < priorHighestHigh

bool aboveVwap = close > vwapValue
bool belowVwap = close < vwapValue

//====================================================
// KEY LEVEL PROXIMITY
//====================================================

bool nearDailySupport =
     math.abs(close - previousDailyLow) <= keyLevelDistance

bool nearWeeklySupport =
     math.abs(close - previousWeeklyLow) <= keyLevelDistance

bool nearMonthlySupport =
     math.abs(close - previousMonthlyLow) <= keyLevelDistance

bool nearDailyResistance =
     math.abs(close - previousDailyHigh) <= keyLevelDistance

bool nearWeeklyResistance =
     math.abs(close - previousWeeklyHigh) <= keyLevelDistance

bool nearMonthlyResistance =
     math.abs(close - previousMonthlyHigh) <= keyLevelDistance

bool nearOpen =
     math.abs(close - dailyOpen) <= keyLevelDistance or
     math.abs(close - weeklyOpen) <= keyLevelDistance or
     math.abs(close - monthlyOpen) <= keyLevelDistance

bool nearSupport =
     nearDailySupport or
     nearWeeklySupport or
     nearMonthlySupport or
     nearOpen

bool nearResistance =
     nearDailyResistance or
     nearWeeklyResistance or
     nearMonthlyResistance or
     nearOpen

//====================================================
// ORDER FLOW CONDITIONS
//====================================================

bool bullishOrderFlow =
     buyPressure and
     aboveVwap and
     (bullishSweep or nearSupport)

bool bearishOrderFlow =
     sellPressure and
     belowVwap and
     (bearishSweep or nearResistance)

//====================================================
// SIGNAL MODE
//====================================================

int requiredScore =
     signalMode == "More Signals"
     ? math.max(minimumMtfScore - 1, 1)
     : signalMode == "Strict"
     ? math.min(minimumMtfScore + 1, 6)
     : minimumMtfScore

bool volumeConfirmed =
     signalMode == "More Signals"
     ? volume >= volumeAverage * 0.75
     : signalMode == "Strict"
     ? volume > volumeAverage * 1.15
     : volume > volumeAverage

//====================================================
// ENTRY TRIGGERS
//====================================================

bool bullishCross = ta.crossover(close, fastEma)
bool bearishCross = ta.crossunder(close, fastEma)

bool bullishPullback =
     close > fastEma and
     low <= fastEma and
     close > open

bool bearishPullback =
     close < fastEma and
     high >= fastEma and
     close < open

bool bullishTrigger =
     signalMode == "More Signals"
     ? bullishCross or bullishPullback
     : bullishCross

bool bearishTrigger =
     signalMode == "More Signals"
     ? bearishCross or bearishPullback
     : bearishCross

//====================================================
// BUY/SELL CONDITIONS
//====================================================

bool longSetup =
     bullScore >= requiredScore and
     fastEma > slowEma and
     aboveVwap and
     rsiValue >= longRsiMinimum and
     volumeConfirmed and
     bullishTrigger and
     (not requireOrderFlow or bullishOrderFlow)

bool shortSetup =
     bearScore >= requiredScore and
     fastEma < slowEma and
     belowVwap and
     rsiValue <= shortRsiMaximum and
     volumeConfirmed and
     bearishTrigger and
     (not requireOrderFlow or bearishOrderFlow)

//====================================================
// SIGNAL COOLDOWN
//====================================================

var int lastSignalBar = na

bool cooldownComplete =
     na(lastSignalBar) or
     bar_index - lastSignalBar > signalCooldownBars

bool signalBarConfirmed =
     not confirmAtClose or
     barstate.isconfirmed

bool buySignal =
     longSetup and
     cooldownComplete and
     signalBarConfirmed

bool sellSignal =
     shortSetup and
     cooldownComplete and
     signalBarConfirmed

if buySignal or sellSignal
    lastSignalBar := bar_index

//====================================================
// TRADE LEVELS
//====================================================

float buyEntry = close
float buyStop = buyEntry - stopDistance
float buyTP1 = buyEntry + tp1Distance
float buyTP2 = buyEntry + tp2Distance

float sellEntry = close
float sellStop = sellEntry + stopDistance
float sellTP1 = sellEntry - tp1Distance
float sellTP2 = sellEntry - tp2Distance

//====================================================
// CLEAN CHART PLOTS
//====================================================

plot(
     showFastEma ? fastEma : na,
     title = "Fast EMA",
     color = color.yellow,
     linewidth = 1
)

plot(
     showSlowEma ? slowEma : na,
     title = "Slow EMA",
     color = color.orange,
     linewidth = 1
)

plot(
     showVwap ? vwapValue : na,
     title = "VWAP",
     color = color.aqua,
     linewidth = 2
)

//====================================================
// KEY LEVEL PLOTS
//====================================================

plot(
     showDailyLevels ? previousDailyHigh : na,
     title = "Previous Daily High",
     color = color.new(color.red, 35),
     linewidth = 1,
     style = plot.style_stepline
)

plot(
     showDailyLevels ? previousDailyLow : na,
     title = "Previous Daily Low",
     color = color.new(color.green, 35),
     linewidth = 1,
     style = plot.style_stepline
)

plot(
     showWeeklyLevels ? previousWeeklyHigh : na,
     title = "Previous Weekly High",
     color = color.new(color.red, 15),
     linewidth = 2,
     style = plot.style_stepline
)

plot(
     showWeeklyLevels ? previousWeeklyLow : na,
     title = "Previous Weekly Low",
     color = color.new(color.green, 15),
     linewidth = 2,
     style = plot.style_stepline
)

plot(
     showMonthlyLevels ? previousMonthlyHigh : na,
     title = "Previous Monthly High",
     color = color.new(color.fuchsia, 10),
     linewidth = 2,
     style = plot.style_stepline
)

plot(
     showMonthlyLevels ? previousMonthlyLow : na,
     title = "Previous Monthly Low",
     color = color.new(color.purple, 10),
     linewidth = 2,
     style = plot.style_stepline
)

plot(
     showPeriodOpens ? dailyOpen : na,
     title = "Daily Open",
     color = color.new(color.gray, 25),
     linewidth = 1,
     style = plot.style_stepline
)

plot(
     showPeriodOpens ? weeklyOpen : na,
     title = "Weekly Open",
     color = color.new(color.blue, 25),
     linewidth = 1,
     style = plot.style_stepline
)

plot(
     showPeriodOpens ? monthlyOpen : na,
     title = "Monthly Open",
     color = color.new(color.purple, 25),
     linewidth = 1,
     style = plot.style_stepline
)

//====================================================
// BUY ARROWS
//====================================================

plotshape(
     showBuySellArrows and buySignal and signalSizeInput == "Tiny",
     title = "BUY Tiny",
     style = shape.arrowup,
     location = location.belowbar,
     color = color.lime,
     text = "BUY",
     textcolor = color.white,
     size = size.tiny
)

plotshape(
     showBuySellArrows and buySignal and signalSizeInput == "Small",
     title = "BUY Small",
     style = shape.arrowup,
     location = location.belowbar,
     color = color.lime,
     text = "BUY",
     textcolor = color.white,
     size = size.small
)

plotshape(
     showBuySellArrows and buySignal and signalSizeInput == "Normal",
     title = "BUY Normal",
     style = shape.arrowup,
     location = location.belowbar,
     color = color.lime,
     text = "BUY",
     textcolor = color.white,
     size = size.normal
)

plotshape(
     showBuySellArrows and buySignal and signalSizeInput == "Large",
     title = "BUY Large",
     style = shape.arrowup,
     location = location.belowbar,
     color = color.lime,
     text = "BUY",
     textcolor = color.white,
     size = size.large
)

plotshape(
     showBuySellArrows and buySignal and signalSizeInput == "Huge",
     title = "BUY Huge",
     style = shape.arrowup,
     location = location.belowbar,
     color = color.lime,
     text = "BUY",
     textcolor = color.white,
     size = size.huge
)

//====================================================
// SELL ARROWS
//====================================================

plotshape(
     showBuySellArrows and sellSignal and signalSizeInput == "Tiny",
     title = "SELL Tiny",
     style = shape.arrowdown,
     location = location.abovebar,
     color = color.red,
     text = "SELL",
     textcolor = color.white,
     size = size.tiny
)

plotshape(
     showBuySellArrows and sellSignal and signalSizeInput == "Small",
     title = "SELL Small",
     style = shape.arrowdown,
     location = location.abovebar,
     color = color.red,
     text = "SELL",
     textcolor = color.white,
     size = size.small
)

plotshape(
     showBuySellArrows and sellSignal and signalSizeInput == "Normal",
     title = "SELL Normal",
     style = shape.arrowdown,
     location = location.abovebar,
     color = color.red,
     text = "SELL",
     textcolor = color.white,
     size = size.normal
)

plotshape(
     showBuySellArrows and sellSignal and signalSizeInput == "Large",
     title = "SELL Large",
     style = shape.arrowdown,
     location = location.abovebar,
     color = color.red,
     text = "SELL",
     textcolor = color.white,
     size = size.large
)

plotshape(
     showBuySellArrows and sellSignal and signalSizeInput == "Huge",
     title = "SELL Huge",
     style = shape.arrowdown,
     location = location.abovebar,
     color = color.red,
     text = "SELL",
     textcolor = color.white,
     size = size.huge
)

//====================================================
// OPTIONAL ORDER-FLOW CANDLE COLOR
//====================================================

barcolor(
     colorOrderFlowCandles
     ? bullishOrderFlow
         ? color.lime
         : bearishOrderFlow
         ? color.red
         : na
     : na
)

//====================================================
// LATEST TRADE OBJECTS
//====================================================

var line latestEntryLine = na
var line latestStopLine = na
var line latestTP1Line = na
var line latestTP2Line = na
var label latestSignalLabel = na

//====================================================
// BUY DISPLAY
//====================================================

if buySignal

    if not na(latestEntryLine)
        line.delete(latestEntryLine)

    if not na(latestStopLine)
        line.delete(latestStopLine)

    if not na(latestTP1Line)
        line.delete(latestTP1Line)

    if not na(latestTP2Line)
        line.delete(latestTP2Line)

    if not na(latestSignalLabel)
        label.delete(latestSignalLabel)

    latestEntryLine := na
    latestStopLine := na
    latestTP1Line := na
    latestTP2Line := na
    latestSignalLabel := na

    if showLatestTradeLevels

        latestEntryLine := line.new(
             bar_index,
             buyEntry,
             bar_index + tradeLevelLength,
             buyEntry,
             color = color.white,
             width = 2
        )

        latestStopLine := line.new(
             bar_index,
             buyStop,
             bar_index + tradeLevelLength,
             buyStop,
             color = color.red,
             width = 2
        )

        latestTP1Line := line.new(
             bar_index,
             buyTP1,
             bar_index + tradeLevelLength,
             buyTP1,
             color = color.green,
             width = 2
        )

        latestTP2Line := line.new(
             bar_index,
             buyTP2,
             bar_index + tradeLevelLength,
             buyTP2,
             color = color.lime,
             width = 2
        )

    if showSignalLabels

        latestSignalLabel := label.new(
             bar_index,
             low,
             "BUY\n" +
             "Entry: " + str.tostring(buyEntry, format.mintick) +
             "\nStop: " + str.tostring(buyStop, format.mintick) +
             "\nTP1: " + str.tostring(buyTP1, format.mintick) +
             "\nTP2: " + str.tostring(buyTP2, format.mintick) +
             "\nScore: " + str.tostring(bullScore) + "/6" +
             "\nContracts: " + str.tostring(contracts, "#"),
             style = label.style_label_up,
             color = color.green,
             textcolor = color.white,
             size = size.small
        )

//====================================================
// SELL DISPLAY
//====================================================

if sellSignal

    if not na(latestEntryLine)
        line.delete(latestEntryLine)

    if not na(latestStopLine)
        line.delete(latestStopLine)

    if not na(latestTP1Line)
        line.delete(latestTP1Line)

    if not na(latestTP2Line)
        line.delete(latestTP2Line)

    if not na(latestSignalLabel)
        label.delete(latestSignalLabel)

    latestEntryLine := na
    latestStopLine := na
    latestTP1Line := na
    latestTP2Line := na
    latestSignalLabel := na

    if showLatestTradeLevels

        latestEntryLine := line.new(
             bar_index,
             sellEntry,
             bar_index + tradeLevelLength,
             sellEntry,
             color = color.white,
             width = 2
        )

        latestStopLine := line.new(
             bar_index,
             sellStop,
             bar_index + tradeLevelLength,
             sellStop,
             color = color.red,
             width = 2
        )

        latestTP1Line := line.new(
             bar_index,
             sellTP1,
             bar_index + tradeLevelLength,
             sellTP1,
             color = color.green,
             width = 2
        )

        latestTP2Line := line.new(
             bar_index,
             sellTP2,
             bar_index + tradeLevelLength,
             sellTP2,
             color = color.lime,
             width = 2
        )

    if showSignalLabels

        latestSignalLabel := label.new(
             bar_index,
             high,
             "SELL\n" +
             "Entry: " + str.tostring(sellEntry, format.mintick) +
             "\nStop: " + str.tostring(sellStop, format.mintick) +
             "\nTP1: " + str.tostring(sellTP1, format.mintick) +
             "\nTP2: " + str.tostring(sellTP2, format.mintick) +
             "\nScore: " + str.tostring(bearScore) + "/6" +
             "\nContracts: " + str.tostring(contracts, "#"),
             style = label.style_label_down,
             color = color.red,
             textcolor = color.white,
             size = size.small
        )

//====================================================
// DASHBOARD FUNCTIONS
//====================================================

trendText(bool bullish, bool bearish) =>
    bullish ? "BULL" :
     bearish ? "BEAR" :
     "NEUTRAL"

trendColor(bool bullish, bool bearish) =>
    bullish ? color.green :
     bearish ? color.red :
     color.gray

//====================================================
// DASHBOARD STATUS
//====================================================

string flowText =
     bullishOrderFlow
     ? "BULL FLOW"
     : bearishOrderFlow
     ? "BEAR FLOW"
     : "NEUTRAL"

color flowColor =
     bullishOrderFlow
     ? color.green
     : bearishOrderFlow
     ? color.red
     : color.gray

string overallBias =
     bullScore > bearScore
     ? "BULLISH"
     : bearScore > bullScore
     ? "BEARISH"
     : "NEUTRAL"

color overallBiasColor =
     bullScore > bearScore
     ? color.green
     : bearScore > bullScore
     ? color.red
     : color.gray

string marketStatus =
     buySignal
     ? "BUY"
     : sellSignal
     ? "SELL"
     : bullScore >= requiredScore
     ? "WATCH LONG"
     : bearScore >= requiredScore
     ? "WATCH SHORT"
     : "WAIT"

color marketStatusColor =
     buySignal
     ? color.lime
     : sellSignal
     ? color.red
     : bullScore >= requiredScore
     ? color.green
     : bearScore >= requiredScore
     ? color.orange
     : color.gray

//====================================================
// DASHBOARD - SMALL / BOTTOM LEFT
//====================================================

var table dashboard = table.new(
     dashboardPosition,
     3,
     14,
     border_width = 1
)

if barstate.islast

    table.clear(
         dashboard,
         0,
         0,
         2,
         13
    )

    if showDashboard

        table.cell(
             dashboard,
             0,
             0,
             "MONEYBAGG FLEM",
             bgcolor = color.rgb(25, 25, 25),
             text_color = color.white,
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             1,
             0,
             symbolType,
             bgcolor = color.rgb(25, 25, 25),
             text_color = color.white,
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             2,
             0,
             "v1.4",
             bgcolor = color.rgb(25, 25, 25),
             text_color = color.white,
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             0,
             1,
             "STATUS",
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             1,
             1,
             marketStatus,
             bgcolor = marketStatusColor,
             text_color = color.white,
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             2,
             1,
             signalMode,
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             0,
             2,
             "Bias",
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             1,
             2,
             overallBias,
             bgcolor = overallBiasColor,
             text_color = color.white,
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             2,
             2,
             str.tostring(math.max(bullScore, bearScore)) + "/6",
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             0,
             3,
             "ATR",
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             1,
             3,
             str.tostring(atrValue, "#.##"),
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             2,
             3,
             "SL " + str.tostring(stopDistance, "#.##"),
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             0,
             4,
             "Risk",
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             1,
             4,
             "$" + str.tostring(riskAmount, "#"),
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             2,
             4,
             str.tostring(contracts, "#") + " ctr",
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             0,
             5,
             "Flow",
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             1,
             5,
             flowText,
             bgcolor = flowColor,
             text_color = color.white,
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             2,
             5,
             requireOrderFlow ? "REQ" : "INFO",
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             0,
             6,
             "VWAP",
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
