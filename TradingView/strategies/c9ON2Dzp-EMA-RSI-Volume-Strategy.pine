//@version=6
strategy("EMA RSI Volume Strategy", overlay = false)

// EMA Settings
ema1Length = input.int(defval = 9, title = "EMA1 Length", inline = "EMA1", group = "EMA1 Settings")
ema1Source = input.source(defval = close, title = "EMA1 Source", inline = "EMA1", group = "EMA1 Settings")
ema1Color = input.color(defval = color.green, title = "EMA1 Color", inline = "EMA1", group = "EMA1 Settings")

ema1 = ta.ema(ema1Source, ema1Length)

plot(ema1, title = "EMA1", color = ema1Color, force_overlay = true)

// EMA2 Settings
ema2Length = input.int(defval = 26, title = "EMA2 Length", inline = "EMA2", group = "EMA2 Settings")
ema2Source = input.source(defval = close, title = "EMA2 Source", inline = "EMA2", group = "EMA2 Settings")
ema2Color = input.color(defval = color.orange, title = "EMA2 Color", inline = "EMA2", group = "EMA2 Settings")

ema2 = ta.ema(ema2Source, ema2Length)

plot(ema2, title = "EMA2", color = ema2Color, force_overlay = true)

// RSI Settings
rsiSource = input.source(defval = close, title = "RSI Source", inline = "RSI", group = "RSI Settings")
rsiLength = input.int(defval = 14, title = "RSI Length", inline = "RSI", group = "RSI Settings")
rsiColor = input.color(defval = color.blue, title = "RSI Color", inline = "RSI", group = "RSI Settings")

rsi = ta.rsi(rsiSource, rsiLength)

upperLine = plot(70, title = "Upper Line", color = color.gray, linestyle = plot.linestyle_dashed)
middleLine = plot(50, title = "Middle Line", color = color.gray, linestyle = plot.linestyle_dashed)
lowerLine = plot(30, title = "Lower Line", color = color.gray, linestyle = plot.linestyle_dashed)

plot(rsi, title = "RSI", color = rsiColor)
fill(upperLine, lowerLine, color = color.new(color.blue, 95))

// Indicator Settings
greenMinRsi = input.int(defval = 50, title = "Green RSI Min", inline = "Green RSI", group = "Indicator Settings")
greenMaxRsi = input.int(defval = 70, title = "Green RSI Max", inline = "Green RSI", group = "Indicator Settings")

numberOfBars = input.int(defval = 3, title = "Number of Bars", tooltip = "Number of previous candles used to calculate average volume", group = "Indicator Settings", minval = 1)
volumeMultiplier = input.int(defval = 1, title = "Volume Multiplier", tooltip = "Current volume must be this many times the average volume", group = "Indicator Settings", minval = 1)

// Market Conditions
longCondition = ema1 > ema2 and rsi > greenMinRsi and rsi < greenMaxRsi
shortCondition = ema1 < ema2 and rsi > greenMinRsi and rsi < greenMaxRsi

finalColor = longCondition ? color.teal : color.red
plot(close + 10, title = "Market Condition", color = finalColor, force_overlay = true)

// Volume Conditions
averageVolume = ta.sma(volume[1], numberOfBars)
highVolume = volume >= averageVolume * volumeMultiplier

buyCondition = longCondition and highVolume
sellCondition = shortCondition and highVolume

// Entry Conditions
if buyCondition and strategy.position_size <= 0
    strategy.close("SELL", comment = "SELL EXIT")
    strategy.entry("BUY", direction = strategy.long)

if sellCondition and strategy.position_size >= 0
    strategy.close("BUY", comment = "BUY EXIT")
    strategy.entry("SELL", direction = strategy.short)

// Risk Management
slPoints = input.float(defval = 20.0, title = "Stop Loss (Points)", group = "Risk Management")
tpPoints = input.float(defval = 40.0, title = "Take Profit (Points)", group = "Risk Management")

longSL = strategy.position_avg_price - slPoints
longTP = strategy.position_avg_price + tpPoints

shortSL = strategy.position_avg_price + slPoints
shortTP = strategy.position_avg_price - tpPoints

strategy.exit("BUY EXIT", from_entry = "BUY", stop = longSL, limit = longTP)
strategy.exit("SELL EXIT", from_entry = "SELL", stop = shortSL, limit = shortTP)

// Alerts
alertcondition(buyCondition, title = "BUY ENTRY", message = "BUY ENTRY")