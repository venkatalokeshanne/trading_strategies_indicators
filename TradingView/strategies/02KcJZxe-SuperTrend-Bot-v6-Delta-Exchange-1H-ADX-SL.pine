//@version=6
strategy(
    title             = "SuperTrend Bot v6 — Delta Exchange [1H + ADX + SL]",
    overlay           = true,
    default_qty_type  = strategy.fixed,
    default_qty_value = 1,
    initial_capital   = 100000,
    currency          = currency.USD,
    commission_type   = strategy.commission.percent,
    commission_value  = 0.05,
    pyramiding        = 0
)

// ═══════════════════════════════════════════════════════════
//  GROUP 1 — SUPERTREND SETTINGS
// ═══════════════════════════════════════════════════════════
int   atrLen   = input.int(10,    "ATR Length",          minval=1,   group="SuperTrend Settings")
float factor   = input.float(3.0, "Factor (Multiplier)", minval=0.1, step=0.1, group="SuperTrend Settings")

// ═══════════════════════════════════════════════════════════
//  GROUP 2 — ADX FILTER  (Fix #2: only trade in trending market)
// ═══════════════════════════════════════════════════════════
bool  useADX   = input.bool(true, "Enable ADX Trend Filter",      group="ADX Filter")
int   adxLen   = input.int(14,   "ADX Length",                    group="ADX Filter", minval=1)
float adxMin   = input.float(20.0,"Min ADX to trade (≥20 = trend)", group="ADX Filter", minval=5, step=1.0)

// ═══════════════════════════════════════════════════════════
//  GROUP 3 — HIGHER TIMEFRAME FILTER  (Fix #3: 4H alignment)
// ═══════════════════════════════════════════════════════════
bool  useHTF   = input.bool(true,  "Enable 4H SuperTrend Filter", group="HTF Filter")
int   htfAtr   = input.int(10,     "4H ATR Length",               group="HTF Filter", minval=1)
float htfFact  = input.float(3.0,  "4H Factor",                   group="HTF Filter", minval=0.1, step=0.1)

// ═══════════════════════════════════════════════════════════
//  GROUP 4 — STOP-LOSS  (Fix #1: protect every trade)
// ═══════════════════════════════════════════════════════════
bool  useSL    = input.bool(true,  "Enable Stop-Loss",            group="Stop-Loss")
float slPct    = input.float(1.5,  "Stop-Loss % from entry",      group="Stop-Loss", minval=0.1, maxval=10.0, step=0.1)
bool  useTP    = input.bool(true,  "Enable Take-Profit",          group="Stop-Loss")
float tpPct    = input.float(3.0,  "Take-Profit % from entry",    group="Stop-Loss", minval=0.1, maxval=20.0, step=0.1)

// ═══════════════════════════════════════════════════════════
//  GROUP 5 — ORDER & DISPLAY
// ═══════════════════════════════════════════════════════════
int   qty      = input.int(1,     "Order Quantity (contracts)",   group="Order & Display", minval=1)
bool  showLbls = input.bool(true, "Show BUY / SELL labels",       group="Order & Display")
bool  showInfo = input.bool(true, "Show filter status table",     group="Order & Display")

// ═══════════════════════════════════════════════════════════
//  CALCULATIONS
// ═══════════════════════════════════════════════════════════

// 1. Primary SuperTrend (on current chart = 1H)
[supertrend, direction] = ta.supertrend(factor, atrLen)
bool isBullish = direction == -1
bool isBearish = direction ==  1
bool buyFlip   = isBullish and direction[1] == 1
bool sellFlip  = isBearish and direction[1] == -1

// 2. ADX filter — only trade when ADX ≥ adxMin
[_, adxLine, _] = ta.dmi(adxLen, adxLen)
bool adxOk = not useADX or adxLine >= adxMin

// 3. Higher timeframe (4H) SuperTrend filter
[htfST, htfDir] = request.security(
    syminfo.tickerid, "240",
    ta.supertrend(htfFact, htfAtr),
    lookahead = barmerge.lookahead_off
)
bool htfBullish = htfDir == -1
bool htfBearish = htfDir ==  1
bool htfOk_long  = not useHTF or htfBullish
bool htfOk_short = not useHTF or htfBearish

// 4. Final entry conditions (ALL filters must pass)
bool goLong  = buyFlip  and adxOk and htfOk_long
bool goShort = sellFlip and adxOk and htfOk_short

// ═══════════════════════════════════════════════════════════
//  STRATEGY ORDERS WITH STOP-LOSS & TAKE-PROFIT
// ═══════════════════════════════════════════════════════════
if goLong
    strategy.entry("Long", strategy.long, qty=qty)
    if useSL or useTP
        float sl_long = useSL ? strategy.position_avg_price * (1 - slPct / 100) : na
        float tp_long = useTP ? strategy.position_avg_price * (1 + tpPct / 100) : na
        strategy.exit("Long Exit", "Long", stop=sl_long, limit=tp_long)

if goShort
    strategy.entry("Short", strategy.short, qty=qty)
    if useSL or useTP
        float sl_short = useSL ? strategy.position_avg_price * (1 + slPct / 100) : na
        float tp_short = useTP ? strategy.position_avg_price * (1 - tpPct / 100) : na
        strategy.exit("Short Exit", "Short", stop=sl_short, limit=tp_short)

// ═══════════════════════════════════════════════════════════
//  PLOTS — SUPERTREND LINES
// ═══════════════════════════════════════════════════════════
plot(
    isBullish ? supertrend : na,
    title    = "Uptrend Line",
    color    = color.new(color.green, 0),
    linewidth = 2,
    style    = plot.style_linebr
)
plot(
    isBearish ? supertrend : na,
    title    = "Downtrend Line",
    color    = color.new(color.red, 0),
    linewidth = 2,
    style    = plot.style_linebr
)

// 4H SuperTrend background shading (subtle)
bgcolor(
    useHTF ? (htfBullish ? color.new(color.green, 95) : color.new(color.red, 95)) : na,
    title = "4H trend background"
)

// ═══════════════════════════════════════════════════════════
//  LABELS — BUY / SELL signals
// ═══════════════════════════════════════════════════════════
if showLbls
    if goLong
        label.new(
            bar_index, low,
            text      = "BUY\nADX:" + str.tostring(math.round(adxLine, 1)),
            style     = label.style_label_up,
            color     = color.green,
            textcolor = color.white,
            size      = size.small
        )
    if goShort
        label.new(
            bar_index, high,
            text      = "SELL\nADX:" + str.tostring(math.round(adxLine, 1)),
            style     = label.style_label_down,
            color     = color.red,
            textcolor = color.white,
            size      = size.small
        )
    // Signals that were FILTERED OUT — shown as grey dots
    if buyFlip and not goLong
        label.new(
            bar_index, low,
            text      = "filtered",
            style     = label.style_label_up,
            color     = color.gray,
            textcolor = color.white,
            size      = size.tiny
        )
    if sellFlip and not goShort
        label.new(
            bar_index, high,
            text      = "filtered",
            style     = label.style_label_down,
            color     = color.gray,
            textcolor = color.white,
            size      = size.tiny
        )

// ═══════════════════════════════════════════════════════════
//  STATUS TABLE — live filter status on chart
// ═══════════════════════════════════════════════════════════
if showInfo and barstate.islast
    var table t = table.new(position.top_right, 2, 5,
         border_width=1, border_color=color.new(color.gray, 70),
         bgcolor=color.new(color.white, 15))
    table.cell(t, 0, 0, "Filter",     text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 0, "Status",     text_color=color.gray,  text_size=size.small)
    table.cell(t, 0, 1, "SuperTrend", text_color=color.black, text_size=size.small)
    table.cell(t, 1, 1, isBullish ? "BULL" : "BEAR",
         text_color=isBullish ? color.green : color.red, text_size=size.small)
    table.cell(t, 0, 2, "ADX(" + str.tostring(adxLen) + ")",
         text_color=color.black, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(math.round(adxLine, 1)) + (adxOk ? " OK" : " LOW"),
         text_color=adxOk ? color.green : color.orange, text_size=size.small)
    table.cell(t, 0, 3, "4H Trend",   text_color=color.black, text_size=size.small)
    table.cell(t, 1, 3, htfBullish ? "BULL" : "BEAR",
         text_color=htfBullish ? color.green : color.red, text_size=size.small)
    table.cell(t, 0, 4, "Signal",     text_color=color.black, text_size=size.small)
    table.cell(t, 1, 4,
         goLong ? "LONG READY" : goShort ? "SHORT READY" : "NO SIGNAL",
         text_color=goLong ? color.green : goShort ? color.red : color.gray,
         text_size=size.small)

// ═══════════════════════════════════════════════════════════
//  ALERT CONDITION — for Delta Exchange webhook
// ═══════════════════════════════════════════════════════════
alertcondition(
    goLong or goShort,
    title   = "SuperTrend Signal [Filtered]",
    message = '{"symbol":"{{ticker}}", "side":"{{strategy.order.action}}", "qty":{{strategy.order.contracts}}, "trigger_time":"{{timenow}}"}'
)