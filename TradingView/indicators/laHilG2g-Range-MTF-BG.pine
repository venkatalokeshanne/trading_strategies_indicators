//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  RANGE MTF BG
//
//  Overlay companion to "Range MTF Lines". Instead of drawing one direction
//  row per timeframe in its own pane, this shades the CHART BACKGROUND when
//  every enabled timeframe's range carries the SAME direction:
//    all UP   -> up shade
//    all DOWN -> down shade
//    mixed, or any enabled slot still on its neutral first range -> no shade
//
//  Range logic (identical to the boxes / lines scripts, so all three agree)
//  -----------------------------------------------------------------------
//  1. The first available candle defines the initial range (its high / low).
//  2. The range stays alive while candles CLOSE inside it.
//  3. The first candle that CLOSES outside the range terminates it, and that
//     same candle's high / low becomes the NEW range.
//  4. Repeat forever.
//
//  Every range is born from a break and carries a direction: UP when created
//  by a close ABOVE the old range, DOWN when created by a close BELOW it. The
//  very first range has no parent, so it is neutral and blocks agreement.
//
//  A slot's direction only changes when a candle of ITS OWN timeframe closes:
//  a 60m slot cannot flip until the 60m candle is done, whatever price does
//  inside it. Nothing repaints.
// ═══════════════════════════════════════════════════════════════════════════
indicator("Range MTF BG", shorttitle = "Range MTF BG", overlay = true)

// ───────────────────────────── Display ─────────────────────────────
grpS   = "Display"
colUp  = input.color(color.new(color.green, 82), "Up shade",   group = grpS, inline = "c")
colDn  = input.color(color.new(color.red, 82),   "Down shade", group = grpS, inline = "c")
alrOn  = input.bool(false, "Alert when all timeframes align", group = grpS,
     tooltip = "Fires once on the bar close where every enabled timeframe first agrees on a direction.")

// ───────────────────────────── Slot inputs ─────────────────────────
grpT = "Timeframes"
en1  = input.bool(true, "Use", group = grpT, inline = "1")
tf1  = input.timeframe("5", "TF 1", group = grpT, inline = "1")
en2  = input.bool(true, "Use", group = grpT, inline = "2")
tf2  = input.timeframe("15", "TF 2", group = grpT, inline = "2")
en3  = input.bool(true, "Use", group = grpT, inline = "3")
tf3  = input.timeframe("30", "TF 3", group = grpT, inline = "3")
en4  = input.bool(true, "Use", group = grpT, inline = "4")
tf4  = input.timeframe("60", "TF 4", group = grpT, inline = "4")

// ───────────────────────── Core state machine ──────────────────────
// Runs on whatever timeframe it is evaluated in (chart or HTF via security).
// dir carries how the live range was born: 1 = broke up, -1 = broke down,
// 0 = the very first range (no parent).
rangeState() =>
    var float rH  = na
    var float rL  = na
    var int   dir = 0
    if na(rH)
        rH := high
        rL := low
    else if close > rH or close < rL
        dir := close > rH ? 1 : -1
        rH  := high
        rL  := low
    dir

// State of the last CLOSED bar of the requested timeframe. Referencing [1]
// inside the request.security expression together with lookahead_on is the
// standard non-repainting MTF idiom — barstate.isconfirmed does not work inside
// request.security. Without this the forming HTF bar is used, so a slot flips
// the moment price pokes outside the range mid-candle and can flip straight
// back: the range must only change when that timeframe's candle CLOSES.
rangeStateClosed() =>
    d = rangeState()
    d[1]

// Slot TF == chart TF is evaluated natively. On the forming chart bar the last
// confirmed value is held, so the shade only moves on the close there too.
getDir(simple string tf) =>
    simple bool isChart = tf == "" or tf == timeframe.period
    int nd = rangeState()
    int xd = request.security(syminfo.tickerid, tf, rangeStateClosed(), lookahead = barmerge.lookahead_on)
    isChart ? (barstate.isconfirmed ? nd : nd[1]) : xd

// ─────────────────────────────── Wiring ────────────────────────────
d1 = getDir(tf1)
d2 = getDir(tf2)
d3 = getDir(tf3)
d4 = getDir(tf4)

anyOn = en1 or en2 or en3 or en4

// A disabled slot never blocks agreement; an enabled slot must match, and a
// neutral (first-range) slot can never match either side.
allUp = anyOn and (not en1 or d1 == 1)  and (not en2 or d2 == 1)  and (not en3 or d3 == 1)  and (not en4 or d4 == 1)
allDn = anyOn and (not en1 or d1 == -1) and (not en2 or d2 == -1) and (not en3 or d3 == -1) and (not en4 or d4 == -1)

bgcolor(allUp ? colUp : allDn ? colDn : na, title = "Alignment shade")

// ─────────────────────────────── Alerts ────────────────────────────
alignedUp = allUp and not allUp[1]
alignedDn = allDn and not allDn[1]

if alrOn and barstate.isconfirmed and alignedUp
    alert("Range MTF BG — all timeframes aligned UP", alert.freq_once_per_bar)
if alrOn and barstate.isconfirmed and alignedDn
    alert("Range MTF BG — all timeframes aligned DOWN", alert.freq_once_per_bar)