//@version=6
indicator("Stop Loss from CMP", overlay=true, max_lines_count=50)

// === Inputs ===
slType    = input.string("Percentage", "Stop Loss Type", options=["Percentage", "Points", "ATR"])
slPct     = input.float(5.0, "Stop Loss %", step=0.1)
slPoints  = input.float(10.0, "Stop Loss Points")
atrLen    = input.int(14, "ATR Length")
atrMult   = input.float(2.0, "ATR Multiplier")
direction = input.string("Long", "Direction", options=["Long", "Short"])
lookbackDays = input.int(22, "Line Length (trading days back)", minval=1, tooltip="~22 trading days = 1 month")

// === Calculate SL level ===
cmp = close
atrVal = ta.atr(atrLen)

slDistance = slType == "Percentage" ? cmp * slPct / 100 :
             slType == "Points"     ? slPoints :
             atrVal * atrMult

slLevel = direction == "Long" ? cmp - slDistance : cmp + slDistance

// === Draw fine horizontal dashed line, limited to lookback window ===
var line slLine = na
var label slLabel = na

if barstate.islast
    line.delete(slLine)
    label.delete(slLabel)

    startBar = bar_index - lookbackDays
    slLine := line.new(x1=startBar, y1=slLevel, x2=bar_index, y2=slLevel,
         xloc=xloc.bar_index, extend=extend.none,
         color=color.red, style=line.style_dashed, width=1)

    slLabel := label.new(bar_index, slLevel,
         "SL: " + str.tostring(slLevel, format.mintick) + " (" + str.tostring(slDistance, format.mintick) + ")",
         color=color.red, style=label.style_label_left, textcolor=color.white, size=size.small)

// Alerts
alertcondition(low <= slLevel and direction == "Long", "SL Hit - Long", "Stop loss triggered")
alertcondition(high >= slLevel and direction == "Short", "SL Hit - Short", "Stop loss triggered")
