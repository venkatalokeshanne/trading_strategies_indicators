//@version=5
strategy("NQ 21 EMA Root Pullback v4 Strong Confirmation", overlay=true, default_qty_type=strategy.fixed, default_qty_value=2, commission_type=strategy.commission.cash_per_contract, commission_value=4)

// Date Range
startDate = timestamp(2026, 4, 1, 0, 0)
endDate   = timestamp(2026, 5, 1, 23, 59)
inDateRange = time >= startDate and time <= endDate

// Session filter
tradeSession = not na(time(timeframe.period, "0930-1200"))

// EMA channel
emaClose = ta.ema(close, 21)
emaHigh  = ta.ema(high, 21)
emaLow   = ta.ema(low, 21)

// Root = SMA smoothing line of EMA close
root = ta.sma(emaClose, 21)

// Root trend filter
validLongTrend = root < emaClose
validShortTrend = root > emaClose

// Strong trend distance filter
trendDistance = 10.0
strongLongTrend = close > emaClose + trendDistance
strongShortTrend = close < emaClose - trendDistance

// Trade limiter
var int tradesToday = 0
newDay = ta.change(time("D"))

if newDay
    tradesToday := 0

maxTradesPerDay = 2

// Pullback logic
longPullback = low[1] <= emaClose[1]
shortPullback = high[1] >= emaClose[1]

// Strong confirmation
longConfirmation = close > open and close > high[1] and close > emaClose
shortConfirmation = close < open and close < low[1] and close < emaClose

// Entry conditions
longCondition = inDateRange and tradeSession and validLongTrend and strongLongTrend and longPullback and longConfirmation and tradesToday < maxTradesPerDay
shortCondition = inDateRange and tradeSession and validShortTrend and strongShortTrend and shortPullback and shortConfirmation and tradesToday < maxTradesPerDay

// Risk
stopTicks = 20
takeTicks = 80

// Entries
if longCondition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    tradesToday += 1

if shortCondition and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    tradesToday += 1

// Exits
strategy.exit("Long Exit", from_entry="Long", loss=stopTicks, profit=takeTicks)
strategy.exit("Short Exit", from_entry="Short", loss=stopTicks, profit=takeTicks)

// Plots
plot(emaClose, color=color.yellow, title="21 EMA Close")
plot(emaHigh, color=color.green, title="21 EMA High")
plot(emaLow, color=color.red, title="21 EMA Low")
plot(root, color=color.blue, title="Root SMA 21")