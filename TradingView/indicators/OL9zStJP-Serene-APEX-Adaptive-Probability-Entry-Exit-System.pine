//@version=6
indicator("TradeSerene APEX — Adaptive Probability Entry & Exit System", shorttitle="TradeSerene APEX", overlay=true, max_labels_count=500, max_lines_count=500)

// ============================================================================
// TRADESERENE APEX
// Adaptive Probability Entry & Exit System
//
// Designed for intraday directional trading.
// Particularly useful for traders using the underlying chart to time
// CALL / PUT option entries.
//
// Core components:
// 1. Opening Range Breakout
// 2. VWAP trend
// 3. EMA trend structure
// 4. Higher timeframe trend
// 5. RSI momentum
// 6. Volume confirmation
// 7. Candle strength
// 8. Liquidity sweep / rejection
// 9. ATR volatility
// 10. Don't-Chase filter
// 11. Risk / Reward filtering
// 12. Trade Quality Score: 0-100
// ============================================================================


// ============================================================================
// INPUTS
// ============================================================================

groupGeneral = "1. General Settings"

tradeSession = input.session("0930-1600", "Regular Trading Session", group=groupGeneral)
orbSession   = input.session("0930-1000", "Opening Range", group=groupGeneral)

minimumScore = input.int(
     75,
     "Minimum Entry Score",
     minval=50,
     maxval=100,
     group=groupGeneral,
     tooltip="APEX will only display CALL/PUT entry signals when the score reaches this level."
)

eliteScore = input.int(
     85,
     "A+ Setup Score",
     minval=60,
     maxval=100,
     group=groupGeneral
)

confirmOnClose = input.bool(
     true,
     "Confirm Signals After Candle Closes",
     group=groupGeneral,
     tooltip="Recommended. Helps prevent signals from appearing before the candle is completed."
)


// ============================================================================
// TREND SETTINGS
// ============================================================================

groupTrend = "2. Trend Settings"

fastEMA = input.int(9, "Fast EMA", group=groupTrend)
mediumEMA = input.int(21, "Medium EMA", group=groupTrend)
slowEMA = input.int(50, "Slow EMA", group=groupTrend)

useHTF = input.bool(true, "Use Higher Timeframe Confirmation", group=groupTrend)

higherTF = input.timeframe(
     "15",
     "Higher Timeframe",
     group=groupTrend
)


// ============================================================================
// MOMENTUM SETTINGS
// ============================================================================

groupMomentum = "3. Momentum Settings"

rsiLength = input.int(14, "RSI Length", group=groupMomentum)

bullRSI = input.int(
     55,
     "Bullish RSI Threshold",
     minval=50,
     maxval=80,
     group=groupMomentum
)

bearRSI = input.int(
     45,
     "Bearish RSI Threshold",
     minval=20,
     maxval=50,
     group=groupMomentum
)


// ============================================================================
// VOLUME SETTINGS
// ============================================================================

groupVolume = "4. Volume Settings"

volumeLength = input.int(
     20,
     "Average Volume Length",
     group=groupVolume
)

volumeMultiplier = input.float(
     1.20,
     "Volume Confirmation Multiplier",
     step=0.05,
     group=groupVolume
)


// ============================================================================
// RISK SETTINGS
// ============================================================================

groupRisk = "5. Risk Management"

atrLength = input.int(
     14,
     "ATR Length",
     group=groupRisk
)

stopATR = input.float(
     1.25,
     "Stop Loss ATR",
     step=0.05,
     group=groupRisk
)

target1RR = input.float(
     1.5,
     "Target 1 Risk/Reward",
     step=0.25,
     group=groupRisk
)

target2RR = input.float(
     2.5,
     "Target 2 Risk/Reward",
     step=0.25,
     group=groupRisk
)


// ============================================================================
// DON'T CHASE SETTINGS
// ============================================================================

groupChase = "6. Don't Chase Filter"

useChaseFilter = input.bool(
     true,
     "Enable Don't-Chase Filter",
     group=groupChase
)

maxVWAPATR = input.float(
     1.75,
     "Maximum ATR Distance From VWAP",
     step=0.05,
     group=groupChase,
     tooltip="Blocks entries when price is excessively extended away from VWAP."
)


// ============================================================================
// DISPLAY SETTINGS
// ============================================================================

groupDisplay = "7. Display"

showVWAP = input.bool(true, "Show VWAP", group=groupDisplay)
showEMAs = input.bool(true, "Show EMAs", group=groupDisplay)
showORB = input.bool(true, "Show Opening Range", group=groupDisplay)

showTargets = input.bool(
     true,
     "Show Stop & Targets",
     group=groupDisplay
)

showDashboard = input.bool(
     true,
     "Show APEX Dashboard",
     group=groupDisplay
)

showScoreLabels = input.bool(
     true,
     "Show Entry Score",
     group=groupDisplay
)


// ============================================================================
// SESSION DETECTION
// ============================================================================

inTradeSession = not na(time(timeframe.period, tradeSession))
inORB = not na(time(timeframe.period, orbSession))

newORB = inORB and not inORB[1]


// ============================================================================
// OPENING RANGE
// ============================================================================

var float orbHigh = na
var float orbLow = na

if newORB
    orbHigh := high
    orbLow := low

if inORB
    orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
    orbLow := na(orbLow) ? low : math.min(orbLow, low)


// ============================================================================
// CORE INDICATORS
// ============================================================================

emaFast = ta.ema(close, fastEMA)
emaMedium = ta.ema(close, mediumEMA)
emaSlow = ta.ema(close, slowEMA)

vwapValue = ta.vwap(hlc3)

rsi = ta.rsi(close, rsiLength)

atr = ta.atr(atrLength)

averageVolume = ta.sma(volume, volumeLength)


// ============================================================================
// HIGHER TIMEFRAME TREND
// ============================================================================

htfClose = request.security(
     syminfo.tickerid,
     higherTF,
     close,
     lookahead=barmerge.lookahead_off
)

htfEMA = request.security(
     syminfo.tickerid,
     higherTF,
     ta.ema(close, mediumEMA),
     lookahead=barmerge.lookahead_off
)

htfBull = htfClose > htfEMA
htfBear = htfClose < htfEMA


// ============================================================================
// TREND CONDITIONS
// ============================================================================

bullEMA =
     close > emaFast and
     emaFast > emaMedium and
     emaMedium > emaSlow

bearEMA =
     close < emaFast and
     emaFast < emaMedium and
     emaMedium < emaSlow

bullVWAP =
     close > vwapValue and
     vwapValue > vwapValue[1]

bearVWAP =
     close < vwapValue and
     vwapValue < vwapValue[1]


// ============================================================================
// MOMENTUM
// ============================================================================

bullMomentum =
     rsi >= bullRSI and
     rsi > rsi[1]

bearMomentum =
     rsi <= bearRSI and
     rsi < rsi[1]


// ============================================================================
// VOLUME CONFIRMATION
// ============================================================================

strongVolume =
     volume > averageVolume * volumeMultiplier

moderateVolume =
     volume > averageVolume


// ============================================================================
// CANDLE QUALITY
// ============================================================================

candleRange = math.max(high - low, syminfo.mintick)

bodySize = math.abs(close - open)

bodyPercent = bodySize / candleRange

upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

strongBullCandle =
     close > open and
     bodyPercent >= 0.60 and
     close >= high - candleRange * 0.25

strongBearCandle =
     close < open and
     bodyPercent >= 0.60 and
     close <= low + candleRange * 0.25


// ============================================================================
// ENGULFING CANDLES
// ============================================================================

bullEngulfing =
     close > open and
     close[1] < open[1] and
     close >= open[1] and
     open <= close[1]

bearEngulfing =
     close < open and
     close[1] > open[1] and
     close <= open[1] and
     open >= close[1]


// ============================================================================
// LIQUIDITY SWEEP
// ============================================================================

swingLength = 5

priorLow = ta.lowest(low[1], swingLength)
priorHigh = ta.highest(high[1], swingLength)

bullLiquiditySweep =
     low < priorLow and
     close > priorLow and
     close > open

bearLiquiditySweep =
     high > priorHigh and
     close < priorHigh and
     close < open


// ============================================================================
// OPENING RANGE CONDITIONS
// ============================================================================

orbComplete = not inORB and not na(orbHigh) and not na(orbLow)

bullORB =
     orbComplete and
     close > orbHigh

bearORB =
     orbComplete and
     close < orbLow

bullORBBreak =
     orbComplete and
     ta.crossover(close, orbHigh)

bearORBBreak =
     orbComplete and
     ta.crossunder(close, orbLow)


// ============================================================================
// DON'T CHASE FILTER
// ============================================================================

distanceFromVWAP =
     atr > 0 ?
     math.abs(close - vwapValue) / atr :
     0

bullExtended =
     close > vwapValue and
     distanceFromVWAP > maxVWAPATR

bearExtended =
     close < vwapValue and
     distanceFromVWAP > maxVWAPATR

bullChaseBlocked =
     useChaseFilter and bullExtended

bearChaseBlocked =
     useChaseFilter and bearExtended


// ============================================================================
// SCORE ENGINE
// ============================================================================

// Maximum score = 100

float bullScore = 0
float bearScore = 0


// ----------------------------------------------------------------------------
// VWAP — 15 POINTS
// ----------------------------------------------------------------------------

if bullVWAP
    bullScore += 15

if bearVWAP
    bearScore += 15


// ----------------------------------------------------------------------------
// EMA STRUCTURE — 15 POINTS
// ----------------------------------------------------------------------------

if bullEMA
    bullScore += 15

if bearEMA
    bearScore += 15


// ----------------------------------------------------------------------------
// OPENING RANGE — 15 POINTS
// ----------------------------------------------------------------------------

if bullORB
    bullScore += 15

if bearORB
    bearScore += 15


// ----------------------------------------------------------------------------
// MOMENTUM — 10 POINTS
// ----------------------------------------------------------------------------

if bullMomentum
    bullScore += 10

if bearMomentum
    bearScore += 10


// ----------------------------------------------------------------------------
// VOLUME — 15 POINTS
// ----------------------------------------------------------------------------

if strongVolume
    bullScore += 15
    bearScore += 15
else if moderateVolume
    bullScore += 7
    bearScore += 7


// ----------------------------------------------------------------------------
// CANDLE QUALITY — 10 POINTS
// ----------------------------------------------------------------------------

if strongBullCandle or bullEngulfing
    bullScore += 10

if strongBearCandle or bearEngulfing
    bearScore += 10


// ----------------------------------------------------------------------------
// HIGHER TIMEFRAME — 10 POINTS
// ----------------------------------------------------------------------------

if useHTF
    if htfBull
        bullScore += 10
    if htfBear
        bearScore += 10
else
    bullScore += 10
    bearScore += 10


// ----------------------------------------------------------------------------
// LIQUIDITY / PRICE ACTION — 10 POINTS
// ----------------------------------------------------------------------------

if bullLiquiditySweep
    bullScore += 10

if bearLiquiditySweep
    bearScore += 10


// ============================================================================
// SCORE PENALTIES
// ============================================================================

// Extended price = major penalty

if bullChaseBlocked
    bullScore := math.max(0, bullScore - 25)

if bearChaseBlocked
    bearScore := math.max(0, bearScore - 25)


// Wrong side of VWAP penalty

if close < vwapValue
    bullScore := math.max(0, bullScore - 15)

if close > vwapValue
    bearScore := math.max(0, bearScore - 15)


// ============================================================================
// FINAL SCORES
// ============================================================================

bullScoreFinal = math.min(100, bullScore)
bearScoreFinal = math.min(100, bearScore)


// ============================================================================
// CONFIRMATION
// ============================================================================

confirmed =
     confirmOnClose ?
     barstate.isconfirmed :
     true


// ============================================================================
// ENTRY LOGIC
// ============================================================================

bullQualified =
     inTradeSession and
     confirmed and
     bullScoreFinal >= minimumScore and
     bullScoreFinal > bearScoreFinal and
     not bullChaseBlocked

bearQualified =
     inTradeSession and
     confirmed and
     bearScoreFinal >= minimumScore and
     bearScoreFinal > bullScoreFinal and
     not bearChaseBlocked


// Prevent repeated labels every candle

newBullSignal =
     bullQualified and
     not bullQualified[1]

newBearSignal =
     bearQualified and
     not bearQualified[1]


// ============================================================================
// TRADE STATE
// ============================================================================

var int tradeDirection = 0

//  1 = CALL
// -1 = PUT
//  0 = FLAT

var float tradeEntry = na
var float tradeStop = na
var float tradeTarget1 = na
var float tradeTarget2 = na


// ============================================================================
// CALL ENTRY
// ============================================================================

if newBullSignal and tradeDirection <= 0

    tradeDirection := 1

    tradeEntry := close

    tradeStop :=
         math.min(
              close - atr * stopATR,
              emaMedium
         )

    callRisk =
         math.max(
              tradeEntry - tradeStop,
              atr * 0.5
         )

    tradeTarget1 :=
         tradeEntry +
         callRisk * target1RR

    tradeTarget2 :=
         tradeEntry +
         callRisk * target2RR


// ============================================================================
// PUT ENTRY
// ============================================================================

if newBearSignal and tradeDirection >= 0

    tradeDirection := -1

    tradeEntry := close

    tradeStop :=
         math.max(
              close + atr * stopATR,
              emaMedium
         )

    putRisk =
         math.max(
              tradeStop - tradeEntry,
              atr * 0.5
         )

    tradeTarget1 :=
         tradeEntry -
         putRisk * target1RR

    tradeTarget2 :=
         tradeEntry -
         putRisk * target2RR


// ============================================================================
// EXIT LOGIC
// ============================================================================

callMomentumFailure =
     tradeDirection == 1 and
     close < emaFast and
     rsi < 50

putMomentumFailure =
     tradeDirection == -1 and
     close > emaFast and
     rsi > 50


callVWAPFailure =
     tradeDirection == 1 and
     close < vwapValue

putVWAPFailure =
     tradeDirection == -1 and
     close > vwapValue


callStopHit =
     tradeDirection == 1 and
     low <= tradeStop

putStopHit =
     tradeDirection == -1 and
     high >= tradeStop


callExit =
     confirmed and
     (
         callMomentumFailure or
         callVWAPFailure or
         callStopHit
     )

putExit =
     confirmed and
     (
         putMomentumFailure or
         putVWAPFailure or
         putStopHit
     )


// ============================================================================
// EXIT LABELS
// ============================================================================

if callExit

    label.new(
         bar_index,
         high,
         callStopHit ?
         "EXIT CALL\nSTOP / INVALIDATION" :
         "EXIT CALL\nMOMENTUM FAILURE",
         style=label.style_label_down,
         color=color.red,
         textcolor=color.white,
         size=size.small
    )

    tradeDirection := 0


if putExit

    label.new(
         bar_index,
         low,
         putStopHit ?
         "EXIT PUT\nSTOP / INVALIDATION" :
         "EXIT PUT\nMOMENTUM FAILURE",
         style=label.style_label_up,
         color=color.red,
         textcolor=color.white,
         size=size.small
    )

    tradeDirection := 0


// ============================================================================
// ENTRY LABELS
// ============================================================================

if newBullSignal

    signalGrade =
         bullScoreFinal >= eliteScore ?
         "A+ CALL" :
         "CALL"

    if showScoreLabels
        label.new(
             bar_index,
             low - atr * 0.30,
             signalGrade +
             "\nENTER CALL" +
             "\nScore: " +
             str.tostring(bullScoreFinal, "#") +
             "/100" +
             "\nEntry: " +
             str.tostring(close, format.mintick) +
             "\nStop: " +
             str.tostring(tradeStop, format.mintick) +
             "\nT1: " +
             str.tostring(tradeTarget1, format.mintick) +
             "\nT2: " +
             str.tostring(tradeTarget2, format.mintick),
             style=label.style_label_up,
             color=color.green,
             textcolor=color.white,
             size=size.small
        )


if newBearSignal

    signalGrade =
         bearScoreFinal >= eliteScore ?
         "A+ PUT" :
         "PUT"

    if showScoreLabels
        label.new(
             bar_index,
             high + atr * 0.30,
             signalGrade +
             "\nENTER PUT" +
             "\nScore: " +
             str.tostring(bearScoreFinal, "#") +
             "/100" +
             "\nEntry: " +
             str.tostring(close, format.mintick) +
             "\nStop: " +
             str.tostring(tradeStop, format.mintick) +
             "\nT1: " +
             str.tostring(tradeTarget1, format.mintick) +
             "\nT2: " +
             str.tostring(tradeTarget2, format.mintick),
             style=label.style_label_down,
             color=color.red,
             textcolor=color.white,
             size=size.small
        )


// ============================================================================
// DON'T CHASE WARNING
// ============================================================================

newBullChaseWarning =
     bullChaseBlocked and
     not bullChaseBlocked[1]

newBearChaseWarning =
     bearChaseBlocked and
     not bearChaseBlocked[1]


if newBullChaseWarning and bullScoreFinal >= 50

    label.new(
         bar_index,
         high,
         "DO NOT CHASE\nWait for CALL pullback",
         style=label.style_label_down,
         color=color.orange,
         textcolor=color.white,
         size=size.tiny
    )


if newBearChaseWarning and bearScoreFinal >= 50

    label.new(
         bar_index,
         low,
         "DO NOT CHASE\nWait for PUT pullback",
         style=label.style_label_up,
         color=color.orange,
         textcolor=color.white,
         size=size.tiny
    )


// ============================================================================
// CHART PLOTS
// ============================================================================

plot(
     showVWAP ? vwapValue : na,
     "VWAP",
     color=color.purple,
     linewidth=2
)

plot(
     showEMAs ? emaFast : na,
     "9 EMA",
     color=color.yellow,
     linewidth=1
)

plot(
     showEMAs ? emaMedium : na,
     "21 EMA",
     color=color.blue,
     linewidth=2
)

plot(
     showEMAs ? emaSlow : na,
     "50 EMA",
     color=color.gray,
     linewidth=2
)


// ============================================================================
// OPENING RANGE PLOTS
// ============================================================================

plot(
     showORB and not inORB ? orbHigh : na,
     "ORB High",
     color=color.green,
     linewidth=2,
     style=plot.style_linebr
)

plot(
     showORB and not inORB ? orbLow : na,
     "ORB Low",
     color=color.red,
     linewidth=2,
     style=plot.style_linebr
)


// ============================================================================
// ACTIVE STOP / TARGET LINES
// ============================================================================

plot(
     showTargets and tradeDirection != 0 ?
     tradeEntry :
     na,
     "Active Entry",
     color=color.white,
     linewidth=1,
     style=plot.style_linebr
)

plot(
     showTargets and tradeDirection != 0 ?
     tradeStop :
     na,
     "Active Stop",
     color=color.red,
     linewidth=2,
     style=plot.style_linebr
)

plot(
     showTargets and tradeDirection != 0 ?
     tradeTarget1 :
     na,
     "Target 1",
     color=color.green,
     linewidth=1,
     style=plot.style_linebr
)

plot(
     showTargets and tradeDirection != 0 ?
     tradeTarget2 :
     na,
     "Target 2",
     color=color.green,
     linewidth=2,
     style=plot.style_linebr
)


// ============================================================================
// ENTRY TRIANGLES
// ============================================================================

plotshape(
     newBullSignal,
     title="CALL Entry",
     location=location.belowbar,
     style=shape.triangleup,
     size=size.small,
     color=color.lime,
     text="CALL"
)

plotshape(
     newBearSignal,
     title="PUT Entry",
     location=location.abovebar,
     style=shape.triangledown,
     size=size.small,
     color=color.red,
     text="PUT"
)


// ============================================================================
// BACKGROUND — ELITE SETUPS
// ============================================================================

bgcolor(
     bullScoreFinal >= eliteScore and
     bullScoreFinal > bearScoreFinal ?
     color.new(color.green, 93) :
     bearScoreFinal >= eliteScore and
     bearScoreFinal > bullScoreFinal ?
     color.new(color.red, 93) :
     na
)


// ============================================================================
// DASHBOARD
// ============================================================================

var table dashboard =
     table.new(
         position.top_right,
         2,
         10,
         border_width=1
     )


if barstate.islast and showDashboard

    directionText =
         bullScoreFinal >= minimumScore and
         bullScoreFinal > bearScoreFinal ?
         "CALL BIAS" :
         bearScoreFinal >= minimumScore and
         bearScoreFinal > bullScoreFinal ?
         "PUT BIAS" :
         "WAIT"

    directionColor =
         directionText == "CALL BIAS" ?
         color.green :
         directionText == "PUT BIAS" ?
         color.red :
         color.gray

    table.cell(
         dashboard,
         0,
         0,
         "TRADESERENE",
         bgcolor=color.black,
         text_color=color.white
    )

    table.cell(
         dashboard,
         1,
         0,
         "APEX",
         bgcolor=color.black,
         text_color=color.white
    )

    table.cell(
         dashboard,
         0,
         1,
         "STATUS",
         text_color=color.white
    )

    table.cell(
         dashboard,
         1,
         1,
         directionText,
         bgcolor=directionColor,
         text_color=color.white
    )

    table.cell(
         dashboard,
         0,
         2,
         "CALL SCORE"
    )

    table.cell(
         dashboard,
         1,
         2,
         str.tostring(bullScoreFinal, "#") + "/100"
    )

    table.cell(
         dashboard,
         0,
         3,
         "PUT SCORE"
    )

    table.cell(
         dashboard,
         1,
         3,
         str.tostring(bearScoreFinal, "#") + "/100"
    )

    table.cell(
         dashboard,
         0,
         4,
         "VWAP"
    )

    table.cell(
         dashboard,
         1,
         4,
         close > vwapValue ?
         "BULLISH" :
         "BEARISH"
    )

    table.cell(
         dashboard,
         0,
         5,
         "TREND"
    )

    table.cell(
         dashboard,
         1,
         5,
         bullEMA ?
         "BULLISH" :
         bearEMA ?
         "BEARISH" :
         "MIXED"
    )

    table.cell(
         dashboard,
         0,
         6,
         "VOLUME"
    )

    table.cell(
         dashboard,
         1,
         6,
         strongVolume ?
         "STRONG" :
         "NORMAL"
    )

    table.cell(
         dashboard,
         0,
         7,
         "ORB"
    )

    table.cell(
         dashboard,
         1,
         7,
         bullORB ?
         "ABOVE" :
         bearORB ?
         "BELOW" :
         "INSIDE"
    )

    table.cell(
         dashboard,
         0,
         8,
         "CHASE"
    )

    table.cell(
         dashboard,
         1,
         8,
         bullChaseBlocked or bearChaseBlocked ?
         "WAIT" :
         "OK"
    )

    table.cell(
         dashboard,
         0,
         9,
         "RSI"
    )

    table.cell(
         dashboard,
         1,
         9,
         str.tostring(rsi, "#.0")
    )


// ============================================================================
// ALERT CONDITIONS
// ============================================================================

alertcondition(
     newBullSignal,
     title="TradeSerene APEX — CALL Entry",
     message="TradeSerene APEX CALL setup detected on {{ticker}} at {{close}}."
)

alertcondition(
     newBearSignal,
     title="TradeSerene APEX — PUT Entry",
     message="TradeSerene APEX PUT setup detected on {{ticker}} at {{close}}."
)

alertcondition(
     callExit,
     title="TradeSerene APEX — EXIT CALL",
     message="TradeSerene APEX CALL exit condition detected on {{ticker}} at {{close}}."
)

alertcondition(
     putExit,
     title="TradeSerene APEX — EXIT PUT",
     message="TradeSerene APEX PUT exit condition detected on {{ticker}} at {{close}}."
)

alertcondition(
     newBullChaseWarning or newBearChaseWarning,
     title="TradeSerene APEX — DON'T CHASE",
     message="TradeSerene APEX: Price is extended on {{ticker}}. WAIT for a better entry."
)


// ============================================================================
// DYNAMIC ALERTS
// ============================================================================

if newBullSignal

    alert(
         "TRADESERENE APEX — CALL ENTRY\n" +
         syminfo.ticker +
         "\nScore: " +
         str.tostring(bullScoreFinal, "#") +
         "/100\nEntry: " +
         str.tostring(close, format.mintick) +
         "\nStop: " +
         str.tostring(tradeStop, format.mintick) +
         "\nTarget 1: " +
         str.tostring(tradeTarget1, format.mintick) +
         "\nTarget 2: " +
         str.tostring(tradeTarget2, format.mintick),
         alert.freq_once_per_bar_close
    )


if newBearSignal

    alert(
         "TRADESERENE APEX — PUT ENTRY\n" +
         syminfo.ticker +
         "\nScore: " +
         str.tostring(bearScoreFinal, "#") +
         "/100\nEntry: " +
         str.tostring(close, format.mintick) +
         "\nStop: " +
         str.tostring(tradeStop, format.mintick) +
         "\nTarget 1: " +
         str.tostring(tradeTarget1, format.mintick) +
         "\nTarget 2: " +
         str.tostring(tradeTarget2, format.mintick),
         alert.freq_once_per_bar_close
    )