// ============================================================================
// TEXT
// ============================================================================

rsText(int score) =>
    score == 2 ? "B2" :
     score == 1 ? "B1" :
     score == -2 ? "S2" :
     score == -1 ? "S1" :
     "-"

// ============================================================================
// BIAS
// ============================================================================

getBias(
     int bullDiv,
     int bearDiv,
     int rsScore) =>

    bullish =
         bullDiv >= minDivForSignal and
         rsScore > 0 and
         bullDiv > bearDiv

    bearish =
         bearDiv >= minDivForSignal and
         rsScore < 0 and
         bearDiv > bullDiv

    bullish ? "BULL" :
     bearish ? "BEAR" :
     "NEUT"

// ============================================================================
// COLORS
// ============================================================================

bullDivColor(int value) =>
    value >= 5 ? color.green :
     value >= 3 ? color.new(color.green, 72) :
     color.white

bearDivColor(int value) =>
    value >= 5 ? color.red :
     value >= 3 ? color.new(color.red, 72) :
     color.white

divTextColor(int value) =>
    value >= 5 ? color.white : color.black

rsColor(int score) =>
    score > 0 ? color.new(color.green, 70) :
     score < 0 ? color.new(color.red, 70) :
     color.white

rsTextColor(int score) =>
    score == 2 or score == -2 ? color.white : color.black

biasColor(
     int bullDiv,
     int bearDiv,
     int rsScore) =>

    bullish =
         bullDiv >= minDivForSignal and
         rsScore > 0 and
         bullDiv > bearDiv

    bearish =
         bearDiv >= minDivForSignal and
         rsScore < 0 and
         bearDiv > bullDiv

    bullish ? color.green :
     bearish ? color.red :
     color.white

biasTextColor(
     int bullDiv,
     int bearDiv,
     int rsScore) =>

    bullish =
         bullDiv >= minDivForSignal and
         rsScore > 0 and
         bullDiv > bearDiv

    bearish =
         bearDiv >= minDivForSignal and
         rsScore < 0 and
         bearDiv > bullDiv

    bullish or bearish ? color.white : color.black

// ============================================================================
// TABLE SETTINGS
// ============================================================================

getTablePosition(pos) =>
    switch pos
        "Top Right" =>
             position.top_right
        "Top Left" =>
             position.top_left
        "Bottom Right" =>
             position.bottom_right
        "Bottom Left" =>
             position.bottom_left
        =>
             position.top_right

getTableSize(sizeInput) =>
    switch sizeInput
        "Tiny" =>
             size.tiny
        "Small" =>
             size.small
        "Normal" =>
             size.normal
        "Large" =>
             size.large
        =>
             size.tiny

tableTextSize =
     getTableSize(tableSizeInput)

// ============================================================================
// TABLE
// ============================================================================

var table scannerTable =
     table.new(
         getTablePosition(tablePositionInput),
         5,
         31,
         border_width=1)

// ============================================================================
// ROW FUNCTION
// ============================================================================

setRow(
     int row,
     string ticker,
     int bullDiv,
     int bearDiv,
     int rsScore) =>

    bias =
         getBias(
             bullDiv,
             bearDiv,
             rsScore)

    shouldShow =
         not showOnlySignals or
         bias != "NEUT"

    if shouldShow

        table.cell(
             scannerTable,
             0,
             row,
             ticker,
             text_color=color.black,
             bgcolor=color.white,
             text_size=tableTextSize)

        table.cell(
             scannerTable,
             1,
             row,
             str.tostring(bullDiv) + "/7",
             text_color=divTextColor(bullDiv),
             bgcolor=bullDivColor(bullDiv),
             text_size=tableTextSize)

        table.cell(
             scannerTable,
             2,
             row,
             str.tostring(bearDiv) + "/7",
             text_color=divTextColor(bearDiv),
             bgcolor=bearDivColor(bearDiv),
             text_size=tableTextSize)

        table.cell(
             scannerTable,
             3,
             row,
             rsText(rsScore),
             text_color=rsTextColor(rsScore),
             bgcolor=rsColor(rsScore),
             text_size=tableTextSize)

        table.cell(
             scannerTable,
             4,
             row,
             bias,
             text_color=biasTextColor(
                 bullDiv,
                 bearDiv,
                 rsScore),
             bgcolor=biasColor(
                 bullDiv,
                 bearDiv,
                 rsScore),
             text_size=tableTextSize)

    else

        table.cell(
             scannerTable,
             0,
             row,
             ticker,
             text_color=color.gray,
             bgcolor=color.new(color.gray, 90),
             text_size=tableTextSize)

        table.cell(
             scannerTable,
             1,
             row,
             str.tostring(bullDiv) + "/7",
             text_color=color.gray,
             bgcolor=color.new(color.gray, 90),
             text_size=tableTextSize)

        table.cell(
             scannerTable,
             2,
             row,
             str.tostring(bearDiv) + "/7",
             text_color=color.gray,
             bgcolor=color.new(color.gray, 90),
             text_size=tableTextSize)

        table.cell(
             scannerTable,
             3,
             row,
             rsText(rsScore),
             text_color=color.gray,
             bgcolor=color.new(color.gray, 90),
             text_size=tableTextSize)

        table.cell(
             scannerTable,
             4,
             row,
             bias,
             text_color=color.gray,
             bgcolor=color.new(color.gray, 90),
             text_size=tableTextSize)

// ============================================================================
// DRAW TABLE
// ============================================================================

if barstate.islast

    table.cell(
         scannerTable,
         0,
         0,
         "TICKER",
         text_color=color.white,
         bgcolor=color.gray,
         text_size=tableTextSize)

    table.cell(
         scannerTable,
         1,
         0,
         "BULL",
         text_color=color.white,
         bgcolor=color.green,
         text_size=tableTextSize)

    table.cell(
         scannerTable,
         2,
         0,
         "BEAR",
         text_color=color.white,
         bgcolor=color.red,
         text_size=tableTextSize)

    table.cell(
         scannerTable,
         3,
         0,
         "RS",
         text_color=color.white,
         bgcolor=color.gray,
         text_size=tableTextSize)

    table.cell(
         scannerTable,
         4,
         0,
         "BIAS",
         text_color=color.white,
         bgcolor=color.gray,
         text_size=tableTextSize)

    setRow(1,  ticker1,  bull1,  bear1,  rs1)
    setRow(2,  ticker2,  bull2,  bear2,  rs2)
    setRow(3,  ticker3,  bull3,  bear3,  rs3)
    setRow(4,  ticker4,  bull4,  bear4,  rs4)
    setRow(5,  ticker5,  bull5,  bear5,  rs5)
    setRow(6,  ticker6,  bull6,  bear6,  rs6)
    setRow(7,  ticker7,  bull7,  bear7,  rs7)
    setRow(8,  ticker8,  bull8,  bear8,  rs8)
    setRow(9,  ticker9,  bull9,  bear9,  rs9)
    setRow(10, ticker10, bull10, bear10, rs10)
    setRow(11, ticker11, bull11, bear11, rs11)
    setRow(12, ticker12, bull12, bear12, rs12)
    setRow(13, ticker13, bull13, bear13, rs13)
    setRow(14, ticker14, bull14, bear14, rs14)
    setRow(15, ticker15, bull15, bear15, rs15)
    setRow(16, ticker16, bull16, bear16, rs16)
    setRow(17, ticker17, bull17, bear17, rs17)
    setRow(18, ticker18, bull18, bear18, rs18)
    setRow(19, ticker19, bull19, bear19, rs19)
    setRow(20, ticker20, bull20, bear20, rs20)
    setRow(21, ticker21, bull21, bear21, rs21)
    setRow(22, ticker22, bull22, bear22, rs22)
    setRow(23, ticker23, bull23, bear23, rs23)
    setRow(24, ticker24, bull24, bear24, rs24)
    setRow(25, ticker25, bull25, bear25, rs25)
    setRow(26, ticker26, bull26, bear26, rs26)
    setRow(27, ticker27, bull27, bear27, rs27)
    setRow(28, ticker28, bull28, bear28, rs28)
    setRow(29, ticker29, bull29, bear29, rs29)
    setRow(30, ticker30, bull30, bear30, rs30)