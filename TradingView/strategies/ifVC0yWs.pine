//@version=6
strategy("Reversal-Strategie v1", overlay=true, pyramiding=0)
// =========================
// Eingaben
// =========================
leftBars         = input.int(3,   "Pivot links", minval=1)
rightBars        = input.int(3,   "Pivot rechts", minval=1)
confirmTolTicks  = input.int(150, "HTF-Bestätigungstoleranz (Ticks)", minval=1)
entryBufferTicks = input.int(100, "Entry-Puffer (Ticks)", minval=1)
stopBufferTicks  = input.int(100, "Stop-Puffer (Ticks)", minval=1)
rr               = input.float(1.0, "CRV", minval=0.1, step=0.1)

closeHour        = input.int(23, "Trades schließen um Stunde", minval=0, maxval=23)
closeMinute      = input.int(0,  "Trades schließen um Minute", minval=0, maxval=59)

showZones        = input.bool(true, "Zonen anzeigen")

// =========================
// Basiswerte
// =========================
float tick        = syminfo.mintick
float confirmTol  = confirmTolTicks * tick
float entryBuffer = entryBufferTicks * tick
float stopBuffer  = stopBufferTicks * tick

bool isM5 = timeframe.in_seconds() == timeframe.in_seconds("5")

// =========================
// Hilfsfunktion
// =========================
nearLevel(float a, float b, float tol) =>
    not na(a) and not na(b) and math.abs(a - b) <= tol

// =========================
// H4 / D1 / W1 Pivot-Zonen
// confirmed / non-repainting
// =========================
float h4PivotHigh = request.security(syminfo.tickerid, "240", ta.pivothigh(high, leftBars, rightBars)[1], lookahead=barmerge.lookahead_off)
float h4PivotLow  = request.security(syminfo.tickerid, "240", ta.pivotlow(low, leftBars, rightBars)[1],   lookahead=barmerge.lookahead_off)

float d1PivotHigh = request.security(syminfo.tickerid, "1D", ta.pivothigh(high, leftBars, rightBars)[1], lookahead=barmerge.lookahead_off)
float d1PivotLow  = request.security(syminfo.tickerid, "1D", ta.pivotlow(low, leftBars, rightBars)[1],   lookahead=barmerge.lookahead_off)

float w1PivotHigh = request.security(syminfo.tickerid, "1W", ta.pivothigh(high, leftBars, rightBars)[1], lookahead=barmerge.lookahead_off)
float w1PivotLow  = request.security(syminfo.tickerid, "1W", ta.pivotlow(low, leftBars, rightBars)[1],   lookahead=barmerge.lookahead_off)

// Letzte bestätigte Levels speichern
var float h4Res = na
var float h4Sup = na
var float d1Res = na
var float d1Sup = na
var float w1Res = na
var float w1Sup = na

if not na(h4PivotHigh)
    h4Res := h4PivotHigh
if not na(h4PivotLow)
    h4Sup := h4PivotLow

if not na(d1PivotHigh)
    d1Res := d1PivotHigh
if not na(d1PivotLow)
    d1Sup := d1PivotLow

if not na(w1PivotHigh)
    w1Res := w1PivotHigh
if not na(w1PivotLow)
    w1Sup := w1PivotLow

// =========================
// Bestätigung der H4-Zone durch D1 oder W1
// =========================
bool supportConfirmed = not na(h4Sup) and (
    nearLevel(h4Sup, d1Sup, confirmTol * 2) or
    nearLevel(h4Sup, w1Sup, confirmTol * 2)
)

bool resistanceConfirmed = not na(h4Res) and (
    nearLevel(h4Res, d1Res, confirmTol * 2) or
    nearLevel(h4Res, w1Res, confirmTol * 2)
)
// =========================
// Reversal-Logik
// Vorige Kerze berührt Zone
// Aktuelle Kerze bestätigt die Abkehr
// =========================
// Reversal-Logik: vorige Kerze berührt Zone, aktuelle Kerze bestätigt die Umkehr
bool supportTouchedRecent = supportConfirmed and not na(h4Sup) and (
    low <= h4Sup + entryBuffer or low[1] <= h4Sup + entryBuffer
)

bool resistanceTouchedRecent = resistanceConfirmed and not na(h4Res) and (
    high >= h4Res - entryBuffer or high[1] >= h4Res - entryBuffer
)

bool bullishReversal = close > open and close > close[1] and close > h4Sup
bool bearishReversal = close < open and close < close[1] and close < h4Res

bool longSignal = (
    barstate.isconfirmed and
    strategy.position_size == 0 and
    supportTouchedRecent and
    bullishReversal
)

bool shortSignal = (
    barstate.isconfirmed and
    strategy.position_size == 0 and
    resistanceTouchedRecent and
    bearishReversal
)


// =========================
// Entries + 1:1 Exit
// =========================
if longSignal
    float longStop   = h4Sup - stopBuffer
    float longRisk   = close - longStop
    float longTarget = close + (longRisk * rr)

    if longRisk > 0
        strategy.entry("Long", strategy.long)
        strategy.exit("Long Exit", "Long", stop=longStop, limit=longTarget)

if shortSignal
    float shortStop   = h4Res + stopBuffer
    float shortRisk   = shortStop - close
    float shortTarget = close - (shortRisk * rr)

    if shortRisk > 0
        strategy.entry("Short", strategy.short)
        strategy.exit("Short Exit", "Short", stop=shortStop, limit=shortTarget)

// =========================
// Tagesende: alles schließen
// =========================
bool forceClose = hour(time) == closeHour and minute(time) == closeMinute
// if forceClose
//     strategy.close_all(comment="Tagesende")

// =========================
// Visualisierung
// =========================
plot(showZones ? h4Sup : na, "H4 Support", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)
plot(showZones ? h4Res : na, "H4 Resistance", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)

plot(showZones ? d1Sup : na, "D1 Support", color=color.new(color.green, 60), style=plot.style_linebr)
plot(showZones ? d1Res : na, "D1 Resistance", color=color.new(color.red, 60), style=plot.style_linebr)

plot(showZones ? w1Sup : na, "W1 Support", color=color.new(color.green, 80), style=plot.style_linebr)
plot(showZones ? w1Res : na, "W1 Resistance", color=color.new(color.red, 80), style=plot.style_linebr)

plotshape(longSignal,  title="Long Signal",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.green, 0), size=size.tiny, text="L")
plotshape(shortSignal, title="Short Signal", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0),   size=size.tiny, text="S")
