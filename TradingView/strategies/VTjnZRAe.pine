//@version=5
strategy("A策略优化版 - EMA + 斐波那契分批低吸高抛", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.07)

// ==================== 输入参数 ====================
emaFast   = input.int(9, "EMA 快线")
emaSlow   = input.int(21, "EMA 慢线")
emaTrend  = input.int(50, "日线趋势EMA")
fibLevel  = input.float(0.5, "斐波那契位")
rsiLen    = input.int(14, "RSI长度")
adxLen    = input.int(14, "ADX长度")
atrLen    = input.int(14, "ATR长度")
riskPct   = input.float(1.0, "单笔风险%")

// ==================== 计算指标 ====================
ema9   = ta.ema(close, emaFast)
ema21  = ta.ema(close, emaSlow)
ema50  = request.security(syminfo.tickerid, "D", ta.ema(close, emaTrend))
rsi    = ta.rsi(close, rsiLen)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
atr    = ta.atr(atrLen)

// ==================== 趋势过滤（日线） ====================
trendUp = close > ema50

// ==================== 入场条件（优化版） ====================
pullback = close <= ema21 * 1.005 and close[1] > ema21
fibPullback = close <= ta.highest(high, 20) * (1 - fibLevel) and close[1] > ta.highest(high, 20) * (1 - fibLevel)

longCond1 = trendUp and pullback and rsi > 45 and adx > 15 and volume > ta.sma(volume, 20) * 1.05
longCond2 = trendUp and fibPullback and rsi > 45 and adx > 15

// ==================== 分批买入（2批） ====================
if longCond1 and strategy.position_size == 0
    strategy.entry("批次1", strategy.long, qty=strategy.equity * 0.4 / close)

if longCond2 and strategy.position_size > 0 and strategy.position_size < strategy.equity * 0.75 / close
    strategy.entry("批次2", strategy.long, qty=strategy.equity * 0.35 / close)

// ==================== 分批卖出 ====================
if strategy.position_size > 0
    // 第一批获利了结
    tp1 = strategy.position_avg_price + (strategy.position_avg_price - (strategy.position_avg_price - atr * 1.5)) * 1.8
    strategy.exit("卖出50%", "批次1", limit=tp1, qty_percent=50)
    
    // 第二批获利了结
    tp2 = strategy.position_avg_price + (strategy.position_avg_price - (strategy.position_avg_price - atr * 1.5)) * 2.5
    strategy.exit("卖出剩余", "批次2", limit=tp2, qty_percent=100)

// ==================== 止损 ====================
if strategy.position_size > 0
    stop = strategy.position_avg_price - atr * 1.5
    strategy.exit("止损", "批次1", stop=stop)
    strategy.exit("止损", "批次2", stop=stop)

// ==================== 可视化 ====================
plot(ema9, color=color.blue, title="EMA9")
plot(ema21, color=color.orange, title="EMA21")
plot(ema50, color=color.red, title="EMA50(日线)")
bgcolor(trendUp ? color.new(color.green, 90) : na)