//@version=5
strategy("BB + RSI | 1:2 Rentable en 4 horas", overlay=true, initial_capital=1000)

// === 1. PARÁMETROS ===
groupBB = "Bandas de Bollinger"
bb_length = input.int(20, "Longitud BB", group=groupBB)
bb_mult   = input.float(2.0, "Desviación Estándar", group=groupBB)

groupRSI = "RSI"
rsi_length = input.int(14, "Longitud RSI", group=groupRSI)
rsi_ob     = input.int(70, "Sobrecompra RSI", group=groupRSI)
rsi_os     = input.int(30, "Sobreventa RSI", group=groupRSI)

groupGest = "Gestión de Riesgo Fija"
riesgo_usd = input.float(100.0, "Riesgo Máximo por Operación ($)", group=groupGest)
ratio_rb   = input.float(2.0, "Ratio Riesgo/Beneficio (Ej. 2 = $200)", group=groupGest)
dist_sl_perc = input.float(0.5, "Distancia del Stop Loss (%)", step=0.1, group=groupGest) / 100

// === 2. INDICADORES ===
[basis, upper, lower] = ta.bb(close, bb_length, bb_mult)
rsi = ta.rsi(close, rsi_length)

// === 3. CONDICIONES ===
longCondition  = (close < lower) and (rsi < rsi_os)
shortCondition = (close > upper) and (rsi > rsi_ob)

// === 4. EJECUCIÓN (Arriesga 100, Busca 200) ===
var float sl_price = na
var float tp_price = na

// Lote Automático
tamano_posicion = (riesgo_usd / dist_sl_perc) / close

if (longCondition and strategy.position_size == 0)
    sl_price := close * (1 - dist_sl_perc)
    tp_price := close * (1 + (dist_sl_perc * ratio_rb))
    strategy.entry("Compra", strategy.long, qty=tamano_posicion)
    strategy.exit("Salida Compra", "Compra", stop=sl_price, limit=tp_price)

if (shortCondition and strategy.position_size == 0)
    sl_price := close * (1 + dist_sl_perc)
    tp_price := close * (1 - (dist_sl_perc * ratio_rb))
    strategy.entry("Venta", strategy.short, qty=tamano_posicion)
    strategy.exit("Salida Venta", "Venta", stop=sl_price, limit=tp_price)

// === 5. GRÁFICOS (ESTILO CAJAS COMO EN TU IMAGEN) ===
// Dibujamos las Bandas suaves de fondo
plot(basis, "Media BB", color=color.new(color.gray, 50))
p_upper = plot(upper, "Banda Sup", color=color.new(color.red, 50), display=display.none)
p_lower = plot(lower, "Banda Inf", color=color.new(color.green, 50), display=display.none)
fill(p_upper, p_lower, color=color.new(color.blue, 95), title="Fondo BB")

// Extraemos el precio real en el que entró el robot (solo existe si hay operación abierta)
float precio_entrada = strategy.position_size != 0 ? strategy.position_avg_price : na

// Recalculamos matemáticamente los niveles visuales basándonos en la entrada real
float nivel_tp = na
float nivel_sl = na

if strategy.position_size > 0 // Si es Compra (Long)
    nivel_tp := precio_entrada * (1 + (dist_sl_perc * ratio_rb))
    nivel_sl := precio_entrada * (1 - dist_sl_perc)
else if strategy.position_size < 0 // Si es Venta (Short)
    nivel_tp := precio_entrada * (1 - (dist_sl_perc * ratio_rb))
    nivel_sl := precio_entrada * (1 + dist_sl_perc)

// Dibujamos las líneas de los límites
p_avg = plot(precio_entrada, title="Línea de Entrada", color=color.new(color.blue, 0), style=plot.style_linebr, linewidth=2)
p_tp  = plot(nivel_tp, title="Línea Take Profit", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)
p_sl  = plot(nivel_sl, title="Línea Stop Loss", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)

// Rellenamos el espacio para crear las "Cajas" (Verde para Profit, Rojo para Loss)
fill(p_avg, p_tp, color=color.new(color.green, 85), title="Caja Profit")
fill(p_avg, p_sl, color=color.new(color.red, 85), title="Caja Loss")