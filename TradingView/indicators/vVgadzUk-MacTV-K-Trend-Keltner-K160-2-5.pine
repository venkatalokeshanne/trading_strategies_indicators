//@version=6
// K-Trend — Keltner K160/2.5 long/flat trend following
//   ENTER long when a candle CLOSES above EMA(160) + 2.5 × ATR(14)
//   EXIT to cash when a candle CLOSES below EMA(160)
// Intended timeframe: 4h (a warning shows on any other TF).

indicator("Mactv K-Trend (Keltner K160/2.5)", overlay = true)

emaLen    = input.int(160, "Midline EMA (exit rail)", minval = 1)
atrLen    = input.int(14, "ATR length", minval = 1)
mult      = input.float(2.5, "ATR multiplier (entry band)", step = 0.1)
showLower = input.bool(false, "Show lower band (cosmetic — strategy never uses it)")
showState = input.bool(true, "Tint background while long")

TEAL  = #2DD4BF
AMBER = #F0B90B
UP    = #2EBD85
DN    = #F6465D

mid   = ta.ema(close, emaLen)
atrV  = ta.atr(atrLen)
upper = mid + mult * atrV
lower = mid - mult * atrV

// long/flat state machine — evaluated on closed candles
var int pos = 0
longEntry = pos == 0 and close > upper
longExit  = pos == 1 and close < mid
if longEntry
    pos := 1
if longExit
    pos := 0

plot(mid, "Exit rail (EMA160)", color = AMBER, linewidth = 2)
pUp = plot(upper, "Entry band", color = TEAL, linewidth = 1, style = plot.style_line)
plot(showLower ? lower : na, "Lower band", color = color.new(TEAL, 60), style = plot.style_line)
pMid = plot(mid, "", color = color.new(AMBER, 100), editable = false, display = display.none)
fill(pUp, pMid, color = color.new(TEAL, 94), title = "Channel fill")

plotshape(longEntry, "Entry", style = shape.triangleup,   location = location.belowbar, color = UP, size = size.small, text = "BUY",  textcolor = UP)
plotshape(longExit,  "Exit",  style = shape.triangledown, location = location.abovebar, color = DN, size = size.small, text = "EXIT", textcolor = DN)
bgcolor(showState and pos == 1 ? color.new(TEAL, 93) : na, title = "In-position tint")

// set these with "Once Per Bar Close" so they fire on the decision candle
alertcondition(longEntry, "K-Trend BUY",  "K-Trend: {{ticker}} closed above the upper Keltner band — go LONG")
alertcondition(longExit,  "K-Trend EXIT", "K-Trend: {{ticker}} closed below EMA160 — exit to cash")

// wrong-timeframe warning
var table warn = table.new(position.top_right, 1, 1)
if barstate.islast
    if timeframe.period != "240"
        table.cell(warn, 0, 0, "⚠ K-Trend is designed for 4h — this chart is " + timeframe.period,
                   text_color = color.orange, bgcolor = color.new(color.black, 15), text_size = size.small)
    else
        table.clear(warn, 0, 0)