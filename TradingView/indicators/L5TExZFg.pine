    label.delete(lbl1)
    label.delete(lbl2)
    label.delete(lbl3)
    label.delete(lbl4)
    label.delete(lbl5)
    label.delete(lbl6)

    line.delete(g1)
    line.delete(g2)
    line.delete(g3)
    line.delete(g4)
    line.delete(g5)
    line.delete(g6)

    label.delete(p11)
