//=============================================================================
// CALCULS MTF
//=============================================================================

ma1 = request.security(syminfo.tickerid, tf1, f_ma(type1, len1), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
ma2 = request.security(syminfo.tickerid, tf2, f_ma(type2, len2), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
ma3 = request.security(syminfo.tickerid, tf3, f_ma(type3, len3), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
ma4 = request.security(syminfo.tickerid, tf4, f_ma(type4, len4), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
ma5 = request.security(syminfo.tickerid, tf5, f_ma(type5, len5), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
ma6 = request.security(syminfo.tickerid, tf6, f_ma(type6, len6), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

slope1 = request.security(syminfo.tickerid, tf1, f_maSlope(type1, len1, slopeLookback), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
slope2 = request.security(syminfo.tickerid, tf2, f_maSlope(type2, len2, slopeLookback), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
slope3 = request.security(syminfo.tickerid, tf3, f_maSlope(type3, len3, slopeLookback), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
slope4 = request.security(syminfo.tickerid, tf4, f_maSlope(type4, len4, slopeLookback), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
slope5 = request.security(syminfo.tickerid, tf5, f_maSlope(type5, len5, slopeLookback), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
slope6 = request.security(syminfo.tickerid, tf6, f_maSlope(type6, len6, slopeLookback), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

name1 = f_name(custom1, type1, len1, tf1)
name2 = f_name(custom2, type2, len2, tf2)
name3 = f_name(custom3, type3, len3, tf3)
name4 = f_name(custom4, type4, len4, tf4)
name5 = f_name(custom5, type5, len5, tf5)
name6 = f_name(custom6, type6, len6, tf6)

short1 = f_shortName(type1, len1, tf1)
short2 = f_shortName(type2, len2, tf2)
short3 = f_shortName(type3, len3, tf3)
short4 = f_shortName(type4, len4, tf4)
short5 = f_shortName(type5, len5, tf5)
short6 = f_shortName(type6, len6, tf6)

labelSize1 = f_labelSize(labelSize1Input)
labelSize2 = f_labelSize(labelSize2Input)
labelSize3 = f_labelSize(labelSize3Input)
labelSize4 = f_labelSize(labelSize4Input)
labelSize5 = f_labelSize(labelSize5Input)
labelSize6 = f_labelSize(labelSize6Input)

//=============================================================================
// TEMPS POUR PROJECTION
//=============================================================================

chartTfSeconds = timeframe.in_seconds(timeframe.period)

tfSeconds1 = timeframe.in_seconds(tf1)
tfSeconds2 = timeframe.in_seconds(tf2)
tfSeconds3 = timeframe.in_seconds(tf3)
tfSeconds4 = timeframe.in_seconds(tf4)
tfSeconds5 = timeframe.in_seconds(tf5)
tfSeconds6 = timeframe.in_seconds(tf6)

//=============================================================================
// TABLEAUX INTERNES CROSS
//=============================================================================

maValues = array.from(ma1, ma2, ma3, ma4, ma5, ma6)
maNames = array.from(short1, short2, short3, short4, short5, short6)
maTypes = array.from(type1, type2, type3, type4, type5, type6)
maLengths = array.from(len1, len2, len3, len4, len5, len6)
maTfs = array.from(tf1, tf2, tf3, tf4, tf5, tf6)
maColors = array.from(col1, col2, col3, col4, col5, col6)

dur1 = len1 * timeframe.in_seconds(tf1)
dur2 = len2 * timeframe.in_seconds(tf2)
dur3 = len3 * timeframe.in_seconds(tf3)
dur4 = len4 * timeframe.in_seconds(tf4)
dur5 = len5 * timeframe.in_seconds(tf5)
dur6 = len6 * timeframe.in_seconds(tf6)

maDurations = array.from(dur1, dur2, dur3, dur4, dur5, dur6)

//=============================================================================
// CROSS 1
//=============================================================================

c1ai = f_maIndex(cross1A) - 1
c1bi = f_maIndex(cross1B) - 1

c1a = array.get(maValues, c1ai)
c1b = array.get(maValues, c1bi)

c1durA = array.get(maDurations, c1ai)
c1durB = array.get(maDurations, c1bi)

c1fastIsA = c1durA <= c1durB

c1fast = c1fastIsA ? c1a : c1b
c1slow = c1fastIsA ? c1b : c1a

c1fastIndex = c1fastIsA ? c1ai : c1bi
c1slowIndex = c1fastIsA ? c1bi : c1ai

c1fastName = array.get(maNames, c1fastIndex)
c1slowName = array.get(maNames, c1slowIndex)
c1fastColor = array.get(maColors, c1fastIndex)
c1slowColor = array.get(maColors, c1slowIndex)

c1fastType = array.get(maTypes, c1fastIndex)
c1slowType = array.get(maTypes, c1slowIndex)

c1fastLen = array.get(maLengths, c1fastIndex)
c1slowLen = array.get(maLengths, c1slowIndex)

c1fastTf = array.get(maTfs, c1fastIndex)
c1slowTf = array.get(maTfs, c1slowIndex)

c1valid = c1ai != c1bi

c1BullRaw = c1valid and ta.crossover(c1fast, c1slow)
c1BearRaw = c1valid and ta.crossunder(c1fast, c1slow)

c1Bull = crossModule and cross1Enabled and c1BullRaw and (not cross1Close or barstate.isconfirmed)
c1Bear = crossModule and cross1Enabled and c1BearRaw and (not cross1Close or barstate.isconfirmed)

c1GoldenPair = f_isGoldenPair(c1fastType, c1fastLen, c1fastTf, c1slowType, c1slowLen, c1slowTf)

//=============================================================================
