//@version=6
indicator("AnPhat May", overlay=true)

//===== INPUT =====
emaFastLen = input.int(9, "EMA nhanh", minval=1)
emaSlowLen = input.int(21, "EMA cham", minval=1)
emaTrendLen = input.int(34, "EMA xu huong", minval=1)
src = input.source(close, "Nguon gia")

greenCloudColor = input.color(color.new(color.lime, 80), "Mau may xanh")
redCloudColor = input.color(color.new(color.red, 80), "Mau may do")
greenLineColor = input.color(color.lime, "Mau vien khi may xanh")
redLineColor = input.color(color.red, "Mau vien khi may do")
lineWidth = input.int(2, "Do day vien EMA9/EMA21", minval=1, maxval=5)

showEma34 = input.bool(true, "Hien EMA34")
ema34GreenColor = input.color(color.lime, "Mau EMA34 khi gia tren")
ema34RedColor = input.color(color.red, "Mau EMA34 khi gia duoi")
ema34Width = input.int(2, "Do day EMA34", minval=1, maxval=5)

showCrossSignal = input.bool(true, "Hien tin hieu cat EMA")

//===== EMA =====
emaFast = ta.ema(src, emaFastLen)
emaSlow = ta.ema(src, emaSlowLen)
emaTrend = ta.ema(src, emaTrendLen)

//===== MAY EMA9/EMA21 =====
isGreenCloud = emaFast >= emaSlow

lineColor = isGreenCloud ? greenLineColor : redLineColor
cloudColor = isGreenCloud ? greenCloudColor : redCloudColor

pFast = plot(emaFast, "EMA9", color=lineColor, linewidth=lineWidth)
pSlow = plot(emaSlow, "EMA21", color=lineColor, linewidth=lineWidth)

fill(pFast, pSlow, color=cloudColor, title="AnPhat May")

//===== EMA34 DOI MAU THEO GIA =====
ema34Color = close >= emaTrend ? ema34GreenColor : ema34RedColor

plot(showEma34 ? emaTrend : na, "EMA34", color=ema34Color, linewidth=ema34Width)

//===== TIN HIEU CAT =====
buySignal = ta.crossover(emaFast, emaSlow)
sellSignal = ta.crossunder(emaFast, emaSlow)

plotshape(showCrossSignal and buySignal, title="BUY", style=shape.triangleup,
     location=location.belowbar, color=color.lime, textcolor=color.lime,
     size=size.small, text="BUY")

plotshape(showCrossSignal and sellSignal, title="SELL", style=shape.triangledown,
     location=location.abovebar, color=color.red, textcolor=color.red,
     size=size.small, text="SELL")

//===== ALERT =====
alertcondition(buySignal, title="EMA9 cat EMA21 di len", message="AnPhat May: EMA9 cat EMA21 di len, may chuyen xanh")
alertcondition(sellSignal, title="EMA9 cat EMA21 di xuong", message="AnPhat May: EMA9 cat EMA21 di xuong, may chuyen do")