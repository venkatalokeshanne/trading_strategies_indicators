//@version=5
strategy("Stable Main Force System v6", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// =========================
// 1. 基础指标
// =========================
ema21 = ta.ema(close, 21)
ema50 = ta.ema(close, 50)
vwapVal = ta.vwap(hlc3)

volMA = ta.sma(volume, 20)
atr = ta.atr(14)

// =========================
// 2. 手写 OBV（稳定版）
// =========================
obv_raw = ta.cum(close > close[1] ? volume : close < close[1] ? -volume : 0)
obv = ta.ema(obv_raw, 5)
obvMA = ta.sma(obv, 20)

// =========================
// 3. 趋势结构
// =========================
trend = ema21 > ema50
aboveStructure = close > ema50

// =========================
// 4. 吸筹 & 洗盘
// =========================
accum = close > ema50 and close < ema21 and obv > obvMA
wash = close > ema50 and close < ema21 and volume < volMA

// =========================
// 5. 突破（启动）
// =========================
breakout = close > ta.highest(high[1], 20) and volume > volMA * 1.2
entrySignal = breakout and trend and obv > obvMA

// =========================
// 6. 止损（结构）
// =========================
swingLow = ta.lowest(low, 10)
stopLoss = math.min(swingLow, ema50)
stopLoss := stopLoss - atr * 0.5

// =========================
// 7. R计算
// =========================
riskPerShare = close - stopLoss
riskPerShare := riskPerShare > 0 ? riskPerShare : na

// =========================
// 8. 入场
// =========================
if entrySignal and not na(riskPerShare)
    strategy.entry("Long", strategy.long)

// =========================
// 9. 出场（2R止盈）
// =========================
takeProfit = close + riskPerShare * 2
strategy.exit("Exit", "Long", stop=stopLoss, limit=takeProfit)

// =========================
// 10. 可视化
// =========================
plot(ema21, color=color.blue)
plot(ema50, color=color.orange)
plot(vwapVal, color=color.purple)

// =========================
// 11. 信号标签
// =========================
if accum
    label.new(bar_index, low, "吸筹", color=color.green,size =size.small)

if wash
    label.new(bar_index, low, "洗盘", color=color.yellow, textcolor=color.black,size =size.small)

if entrySignal
    label.new(bar_index, high, "启动", color=color.blue,size =size.small)

// =========================
// 12. 信息面板
// =========================
var label info = na
label.delete(info)

info := label.new(bar_index, high,
     "R: " + str.tostring(riskPerShare, format.mintick),
     style=label.style_label_left,
     color=color.black,
     textcolor=color.white)