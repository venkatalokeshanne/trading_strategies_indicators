    table.cell(dashboard, 2, row, 'Mirror Price: ', text_color = c_gray, text_size = dash_text_size)
    table.cell(dashboard, 3, row, str.format("{0,number,#,##0.00}", otherInstrumentClose) , text_color = c_purple, text_size = dash_text_size)
