//@version=6
strategy(
    "System 2 - Structure Continuation",
    overlay = true,
    initial_capital = 10000,
    pyramiding = 0
)

// =====================
// INPUTS
// =====================
riskPercent   = input.float(2.0, "Risk %", step = 0.1)
rr            = input.float(2.0, "RR", step = 0.1)
dispMult      = input.float(1.5, "Displacement Strength (ATR Mult)", step = 0.1)
pullbackBars  = input.int(10, "Max Pullback Bars", minval = 3)
cooldownBars  = input.int(10, "Cooldown Bars", minval = 0)

// =====================
// HELPERS
// =====================
calcQty(entryPrice, stopPrice) =>
    riskCash = strategy.equity * (riskPercent / 100.0)
    riskPerUnit = math.abs(entryPrice - stopPrice)
    riskPerUnit > 0 ? (riskCash / riskPerUnit) : 0.0

atr = ta.atr(14)

// =====================
// STEP 1: DISPLACEMENT
// =====================
bullDisplacement = (close - open) > atr * dispMult
bearDisplacement = (open - close) > atr * dispMult

// =====================
// STATE VARIABLES
// =====================
var int dispBar = na
var float dispLow = na
var float dispHigh = na
var bool bullishActive = false
var bool bearishActive = false

// Track displacement
if bullDisplacement
    dispBar := bar_index
    dispLow := low
    bullishActive := true
    bearishActive := false

if bearDisplacement
    dispBar := bar_index
    dispHigh := high
    bearishActive := true
    bullishActive := false

// =====================
// STEP 2: STRUCTURE (PULLBACK)
// =====================
barsSinceDisp = bar_index - dispBar

validPullback = not na(dispBar) and barsSinceDisp > 0 and barsSinceDisp <= pullbackBars

// Bullish structure = higher low (price holds above displacement low)
bullStructure = bullishActive and validPullback and low > dispLow

// Bearish structure = lower high
bearStructure = bearishActive and validPullback and high < dispHigh

// =====================
// STEP 3: ENTRY TRIGGER
// =====================
// Continuation = bullish candle after pullback

bullEntry = bullStructure and close > open
bearEntry = bearStructure and close < open

// =====================
// TRADE CONTROL
// =====================
var int lastTradeBar = na
cooldownOK = na(lastTradeBar) or (bar_index - lastTradeBar > cooldownBars)
flatOK = strategy.position_size == 0

longCondition = bullEntry and cooldownOK and flatOK
shortCondition = bearEntry and cooldownOK and flatOK

// =====================
// EXECUTION
// =====================
if longCondition
    entryPrice = close
    stopPrice = dispLow
    riskDist = entryPrice - stopPrice
    targetPrice = entryPrice + (riskDist * rr)
    qty = calcQty(entryPrice, stopPrice)

    if riskDist > syminfo.mintick
        strategy.entry("Long", strategy.long, qty = qty)
        strategy.exit("Long Exit", "Long", stop = stopPrice, limit = targetPrice)
        lastTradeBar := bar_index
        bullishActive := false

if shortCondition
    entryPrice = close
    stopPrice = dispHigh
    riskDist = stopPrice - entryPrice
    targetPrice = entryPrice - (riskDist * rr)
    qty = calcQty(entryPrice, stopPrice)

    if riskDist > syminfo.mintick
        strategy.entry("Short", strategy.short, qty = qty)
        strategy.exit("Short Exit", "Short", stop = stopPrice, limit = targetPrice)
        lastTradeBar := bar_index
        bearishActive := false

// =====================
// VISUALS
// =====================
plotshape(bullDisplacement, title="Bull Displacement", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.tiny)
plotshape(bearDisplacement, title="Bear Displacement", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.tiny)

plotshape(longCondition, title="BUY", location=location.belowbar, color=color.green, style=shape.labelup, text="BUY")
plotshape(shortCondition, title="SELL", location=location.abovebar, color=color.red, style=shape.labeldown, text="SELL")