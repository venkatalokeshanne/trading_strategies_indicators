//@version=6
indicator("Implied Sigma Map", shorttitle = "Implied Sigma Map", overlay = true, format = format.price, precision = 2, max_lines_count = 70, max_labels_count = 70, max_boxes_count = 12)
const string INDICATOR_NAME = "Implied Sigma Map"
const string INDICATOR_AUTHOR = "Yulien Diaz"
const string INDICATOR_LICENSE = "MIT License"
const string INDICATOR_VERSION = "1.5.3"
const string INDICATOR_MODIFIED = "2026-08-14"
const int MAX_DRAWING_BARS_BACK = 5000
const float VIX_TRADING_DAYS = 252.0
max_bars_back(time, MAX_DRAWING_BARS_BACK)
const string GROUP_CORE = "Core Calculation"
const string GROUP_DIRECT = "Direct Daily IV Inputs"
const string GROUP_ANNUAL = "Annualized IV Inputs"
const string GROUP_CBOE = "CBOE Data and Freshness"
const string GROUP_VIX1D = "VIX1D"
const string GROUP_VIX = "VIX Daily Equivalent"
const string GROUP_CONTRACT = "Contract Information"
const string GROUP_LEVELS = "Sigma Levels"
const string GROUP_VISUALS = "Visuals"
const string GROUP_STRUCTURE = "Market Structure Levels"
const string GROUP_DASHBOARD = "Dashboard"
const string GROUP_ALERTS = "Alerts"
const string MAP_CURRENT = "Current Session"
const string MAP_NEXT = "Next Session"
const string ANCHOR_AUTO = "Automatic"
const string ANCHOR_MANUAL = "Manual"
const string ANCHOR_SOURCE_PREVIOUS = "Previous Session Close"
const string ANCHOR_SOURCE_CURRENT_RTH = "Current Session Final RTH Close"
const string ANCHOR_SOURCE_MANUAL = "Manual"
const string CONSUMPTION_ATM = "ATM IV"
const string CONSUMPTION_VIX1D = "VIX1D"
const string CONSUMPTION_VIX = "VIX Daily Equivalent"
const string ATM_SHAPE_SYMMETRIC = "Symmetric"
const string ATM_SHAPE_ASYMMETRIC = "Asymmetric"
const string FEED_AUTO = "Auto"
const string FEED_REALTIME = "Real-Time"
const string FEED_DELAYED = "Delayed ~15m"
const string FEED_STATUS_UNAVAILABLE = "DATA UNAVAILABLE"
const string FEED_STATUS_CURRENT = "CURRENT"
const string FEED_STATUS_EXPECTED_DELAY = "EXPECTED DELAY"
const string FEED_STATUS_STALE = "STALE"
const string FEED_STATUS_FINAL = "FINAL"
const string FEED_STATUS_HISTORICAL = "HISTORICAL / UNVERIFIED"
const string FEED_STATUS_INVALID_SOURCE_TF = "INVALID SOURCE TF"
const string CBOE_TF_STATUS_VALID = "VALID"
const string CBOE_TF_STATUS_SOURCE_ABOVE_CHART = "SOURCE TF > CHART TF"
const string CBOE_TF_STATUS_SOURCE_UNAVAILABLE = "SOURCE TF UNAVAILABLE"
const string CBOE_TF_STATUS_CHART_UNAVAILABLE = "CHART TF UNAVAILABLE"
const string SNAPSHOT_REFERENCE_MANUAL = "Manual Price"
const string SNAPSHOT_REFERENCE_ANCHOR = "Anchor"
const string BENCHMARK_AUTO = "Auto"
const string BENCHMARK_SPX_LINKED = "SPX-Linked"
const string BENCHMARK_CONTEXT_ONLY = "Context Only"
const string ALERT_CONFIRM_BAR_CLOSE = "Bar Close"
const string ALERT_CONFIRM_INTRABAR = "Intrabar"
const string METHOD_DIRECT = "Direct Daily ATM IV"
const string METHOD_ANNUAL = "Annualized ATM IV"
const string LABEL_SIGMA_PRICE = "Sigma + Price"
const string LABEL_SIGMA_DISTANCE = "Sigma + Distance"
const string LABEL_SIGMA_PRICE_DISTANCE = "Sigma + Price + Distance"
const string LABEL_NONE = "No Labels"
const string STYLE_SOLID = "Solid"
const string STYLE_DASHED = "Dashed"
const string STYLE_DOTTED = "Dotted"
const string DIRECT_METHOD_TOOLTIP = "Use this mode when your broker provides daily option implied volatility directly. Example: IBKR Daily Midpoint IV."
const string ANNUAL_METHOD_TOOLTIP = "Use this mode when your broker provides annualized implied volatility. The indicator converts it to daily volatility using sqrt(Trading Days Per Year)."
f_line_style(string selectedStyle) =>
    string result = line.style_solid
    if selectedStyle == STYLE_DASHED
        result := line.style_dashed
    else if selectedStyle == STYLE_DOTTED
        result := line.style_dotted
    result
f_dashboard_position(string selectedPosition) =>
    string result = position.top_right
    if selectedPosition == "Top Left"
        result := position.top_left
    else if selectedPosition == "Middle Right"
        result := position.middle_right
    else if selectedPosition == "Middle Left"
        result := position.middle_left
    else if selectedPosition == "Bottom Right"
        result := position.bottom_right
    else if selectedPosition == "Bottom Left"
        result := position.bottom_left
    result
f_text_size(string selectedSize) =>
    string result = size.small
    if selectedSize == "Tiny"
        result := size.tiny
    else if selectedSize == "Normal"
        result := size.normal
    result
f_number(float value, string numberFormat) =>
    string result = "—"
    if not na(value)
        result := str.tostring(value, numberFormat)
    result
f_signed(float value, string numberFormat) =>
    string result = "—"
    if not na(value)
        float normalizedValue = value
        if math.abs(normalizedValue) < 0.0000001
            normalizedValue := 0.0
        if normalizedValue > 0.0
            result := "+" + str.tostring(normalizedValue, numberFormat)
        else
            result := str.tostring(normalizedValue, numberFormat)
    result
f_date_key(int timestampValue, string timezoneValue) =>
    int result = na
    if not na(timestampValue)
        result := year(timestampValue, timezoneValue) * 10000 + month(timestampValue, timezoneValue) * 100 + dayofmonth(timestampValue, timezoneValue)
    result
f_same_date(int firstTimestamp, int secondTimestamp, string timezoneValue) =>
    bool result = false
    int firstDateKey = f_date_key(firstTimestamp, timezoneValue)
    int secondDateKey = f_date_key(secondTimestamp, timezoneValue)
    if not na(firstDateKey) and not na(secondDateKey)
        result := firstDateKey == secondDateKey
    result
f_parse_expiration_date_key(string expirationText, string timezoneValue) =>
    int result = na
    if str.length(expirationText) == 10
        bool separatorsValid = str.substring(expirationText, 4, 5) == "-" and str.substring(expirationText, 7, 8) == "-"
        if separatorsValid
            float parsedYear = str.tonumber(str.substring(expirationText, 0, 4))
            float parsedMonth = str.tonumber(str.substring(expirationText, 5, 7))
            float parsedDay = str.tonumber(str.substring(expirationText, 8, 10))
            if not na(parsedYear) and not na(parsedMonth) and not na(parsedDay)
                int expirationYear = int(parsedYear)
                int expirationMonth = int(parsedMonth)
                int expirationDay = int(parsedDay)
                int normalizedTimestamp = timestamp(timezoneValue, expirationYear, expirationMonth, expirationDay, 12, 0)
                bool normalizedDateMatches = year(normalizedTimestamp, timezoneValue) == expirationYear and month(normalizedTimestamp, timezoneValue) == expirationMonth and dayofmonth(normalizedTimestamp, timezoneValue) == expirationDay
                if normalizedDateMatches
                    result := expirationYear * 10000 + expirationMonth * 100 + expirationDay
    result
f_feed_mode_label(string selectedFeedMode, int expectedDelayMinutes) =>
    string result = "AUTO / UNKNOWN"
    if selectedFeedMode == FEED_REALTIME
        result := "REAL-TIME — USER"
    else if selectedFeedMode == FEED_DELAYED
        result := "DELAYED ~" + str.tostring(expectedDelayMinutes) + "m — USER"
    result
f_observed_freshness(string selectedFeedMode, bool dataValid, float sourceAgeMinutes, float currentToleranceMinutes, int expectedDelayMinutes, bool realtimeContext, bool finalObservation) =>
    string result = FEED_STATUS_UNAVAILABLE
    if dataValid
        if finalObservation
            result := FEED_STATUS_FINAL
        else if not realtimeContext
            result := FEED_STATUS_HISTORICAL
        else if na(sourceAgeMinutes)
            result := FEED_STATUS_STALE
        else if sourceAgeMinutes <= currentToleranceMinutes
            result := FEED_STATUS_CURRENT
        else if selectedFeedMode != FEED_REALTIME and sourceAgeMinutes <= currentToleranceMinutes + expectedDelayMinutes
            result := FEED_STATUS_EXPECTED_DELAY
        else
            result := FEED_STATUS_STALE
    result
f_cboe_source_payload(int finalEndHour, int finalEndMinute, string timezoneValue) =>
    int configuredFinalTimestamp = timestamp(timezoneValue, year(time, timezoneValue), month(time, timezoneValue), dayofmonth(time, timezoneValue), finalEndHour, finalEndMinute)
    var float finalSessionValue = na
    var int finalSessionTime = na
    bool configuredFinalBarClosed = time_close == configuredFinalTimestamp and time_close <= timenow
    if configuredFinalBarClosed and not na(close) and close > 0.0
        finalSessionValue := close
        finalSessionTime := time_close
    [close, time, time_close, close[1], time[1], time_close[1], finalSessionValue, finalSessionTime]
f_update_line(line lineId, int leftBar, int rightBar, float levelPrice, bool visible, color baseColor, int transparency, int lineWidth, string selectedStyle) =>
    float safePrice = levelPrice
    if na(safePrice)
        safePrice := close
    line.set_xy1(lineId, leftBar, safePrice)
    line.set_xy2(lineId, rightBar, safePrice)
    line.set_width(lineId, lineWidth)
    line.set_style(lineId, f_line_style(selectedStyle))
    color displayColor = color.new(baseColor, 100)
    if visible
        displayColor := color.new(baseColor, transparency)
    line.set_color(lineId, displayColor)
f_update_structure_label(label labelId, int labelBar, float levelPrice, string levelName, bool visible, color baseColor, int transparency, string selectedSize) =>
    float safePrice = levelPrice
    if na(safePrice)
        safePrice := close
    label.set_xy(labelId, labelBar, safePrice)
    label.set_size(labelId, f_text_size(selectedSize))
    label.set_color(labelId, color.new(color.black, 100))
    if visible
        label.set_text(labelId, levelName + " | " + f_number(levelPrice, "0.00"))
        label.set_textcolor(labelId, color.new(baseColor, transparency))
    else
        label.set_text(labelId, "")
        label.set_textcolor(labelId, color.new(baseColor, 100))
f_sigma_label_text(bool isUpper, string sigmaText, float levelPrice, float distancePoints, string modelPrefix, string selectedMode) =>
    string signText = "-"
    if isUpper
        signText := "+"
    string sigmaValueText = signText + sigmaText + "σ"
    if str.length(modelPrefix) > 0
        sigmaValueText := modelPrefix + " " + sigmaValueText
    string priceText = f_number(levelPrice, "0.00")
    string distanceText = f_signed(distancePoints, "0.00") + " pts"
    string result = sigmaValueText
    if selectedMode == LABEL_SIGMA_PRICE
        result := sigmaValueText + " | " + priceText
    else if selectedMode == LABEL_SIGMA_DISTANCE
        result := sigmaValueText + " | " + distanceText
    else if selectedMode == LABEL_SIGMA_PRICE_DISTANCE
        result := sigmaValueText + " | " + priceText + " | " + distanceText
    result
f_update_sigma_label(label labelId, int labelBar, float levelPrice, float distancePoints, string sigmaText, bool isUpper, bool visible, color baseColor, int transparency, string modelPrefix, string selectedMode, string selectedSize) =>
    float safePrice = levelPrice
    if na(safePrice)
        safePrice := close
    label.set_xy(labelId, labelBar, safePrice)
    label.set_size(labelId, f_text_size(selectedSize))
    label.set_color(labelId, color.new(color.black, 100))
    if visible
        label.set_text(labelId, f_sigma_label_text(isUpper, sigmaText, levelPrice, distancePoints, modelPrefix, selectedMode))
        label.set_textcolor(labelId, color.new(baseColor, transparency))
    else
        label.set_text(labelId, "")
        label.set_textcolor(labelId, color.new(baseColor, 100))
f_update_zone(box zoneBox, int leftBar, int rightBar, float topPrice, float bottomPrice, bool visible, color baseColor, int transparency) =>
    float safeTop = topPrice
    float safeBottom = bottomPrice
    if na(safeTop)
        safeTop := close
    if na(safeBottom)
        safeBottom := close
    box.set_left(zoneBox, leftBar)
    box.set_right(zoneBox, rightBar)
    box.set_top(zoneBox, safeTop)
    box.set_bottom(zoneBox, safeBottom)
    box.set_border_color(zoneBox, color.new(baseColor, 100))
    color zoneColor = color.new(baseColor, 100)
    if visible
        zoneColor := color.new(baseColor, transparency)
    box.set_bgcolor(zoneBox, zoneColor)
f_dashboard_row(table tableId, int row, string fieldText, string valueText, color valueColor, string selectedSize) =>
    color fieldColor = color.new(color.white, 35)
    color rowBackground = color.new(color.rgb(15, 20, 30), 8)
    table.cell(tableId, 0, row, fieldText, text_color = fieldColor, text_size = f_text_size(selectedSize), text_halign = text.align_left, bgcolor = rowBackground)
    table.cell(tableId, 1, row, valueText, text_color = valueColor, text_size = f_text_size(selectedSize), text_halign = text.align_right, bgcolor = rowBackground)
string mapMode = input.string(MAP_CURRENT, "Map Mode", options = [MAP_CURRENT, MAP_NEXT], group = GROUP_CORE, tooltip = "Current Session uses the previous confirmed trading-session close. Next Session captures the current session's final confirmed regular-session close and keeps it fixed for the following session.")
bool showAtmMap = input.bool(true, "Show ATM Map", group = GROUP_CORE, tooltip = "Primary expiration-specific volatility map.")
bool showVix1dMap = input.bool(false, "Show VIX1D Map", group = GROUP_CORE, tooltip = "Short-horizon market-wide reference derived from the annualized CBOE VIX1D Index.")
bool showVixMap = input.bool(false, "Show VIX Map", group = GROUP_CORE, tooltip = "30-day VIX volatility-regime reference converted to a daily equivalent.")
string atmMapShape = input.string(ATM_SHAPE_SYMMETRIC, "ATM Map Shape", options = [ATM_SHAPE_SYMMETRIC, ATM_SHAPE_ASYMMETRIC], group = GROUP_CORE, tooltip = "Symmetric uses the Call/Put average on both sides. Asymmetric uses Call Daily IV above the Anchor and Put Daily IV below it as reference distances; it is not an exact probability distribution.")
string anchorMode = input.string(ANCHOR_AUTO, "Anchor Mode", options = [ANCHOR_AUTO, ANCHOR_MANUAL], group = GROUP_CORE, tooltip = "Automatic resolves the Anchor from Map Mode. Manual uses Manual Anchor Price without changing the automatic state.")
float manualAnchorPrice = input.float(0.0, "Manual Anchor Price", minval = 0.0, step = 0.25, group = GROUP_CORE, tooltip = "Used only when Anchor Mode is Manual. Must be greater than zero.")
string automaticRthSession = input.session("0930-1600", "Automatic RTH Session", group = GROUP_CORE, tooltip = "Regular trading session used to capture the automatic closing Anchor. The default is the U.S. cash session.")
string automaticRthTimezone = input.string("America/New_York", "Automatic RTH Timezone", group = GROUP_CORE, tooltip = "IANA timezone used to evaluate Automatic RTH Session. Keep America/New_York for U.S. cash products and related derivatives.")
string ivCalculationMethod = input.string(METHOD_DIRECT, "IV Calculation Method", options = [METHOD_DIRECT, METHOD_ANNUAL], group = GROUP_CORE, tooltip = DIRECT_METHOD_TOOLTIP + "\n\n" + ANNUAL_METHOD_TOOLTIP)
int tradingDaysPerYear = input.int(252, "Trading Days Per Year", minval = 1, maxval = 366, group = GROUP_CORE, tooltip = "Used only by Annualized ATM IV. Direct Daily ATM IV ignores this conversion setting.")
string consumptionReference = input.string(CONSUMPTION_ATM, "Consumption Reference", options = [CONSUMPTION_ATM, CONSUMPTION_VIX1D, CONSUMPTION_VIX], group = GROUP_CORE, tooltip = "ATM IV uses the fixed session map and retains Move Consumed terminology. VIX1D and VIX use a live denominator in Current Session mode and are therefore labeled as vol-normalized distance rather than fixed-move consumption.")
bool previewNextSessionMovementMetrics = input.bool(false, "Preview Next-Session Movement Metrics", group = GROUP_CORE, tooltip = "Advanced research override. When disabled, a prepared Next Session map does not calculate movement metrics until its regular session begins. Manual Anchor does not override session timing.")
float callDailyIvPct = input.float(0.0, "ATM Call Daily IV %", minval = 0.0, step = 0.0001, group = GROUP_DIRECT, tooltip = DIRECT_METHOD_TOOLTIP)
float putDailyIvPct = input.float(0.0, "ATM Put Daily IV %", minval = 0.0, step = 0.0001, group = GROUP_DIRECT, tooltip = DIRECT_METHOD_TOOLTIP)
float callAnnualIvPct = input.float(0.0, "ATM Call Annualized IV %", minval = 0.0, step = 0.01, group = GROUP_ANNUAL, tooltip = ANNUAL_METHOD_TOOLTIP)
float putAnnualIvPct = input.float(0.0, "ATM Put Annualized IV %", minval = 0.0, step = 0.01, group = GROUP_ANNUAL, tooltip = ANNUAL_METHOD_TOOLTIP)
string cboeFeedMode = input.string(FEED_AUTO, "CBOE Feed Mode", options = [FEED_AUTO, FEED_REALTIME, FEED_DELAYED], group = GROUP_CBOE, tooltip = "Pine cannot inspect your CBOE market-data entitlement. Real-Time and Delayed are authoritative user selections. Auto is only a best-effort timestamp estimate on realtime bars.")
string cboeSourceTimeframe = input.timeframe("1", "CBOE Source Timeframe", options = ["1", "3", "5"], group = GROUP_CBOE, tooltip = "Dedicated VIX/VIX1D source resolution. One minute is recommended so CBOE responsiveness and finalization do not depend on the chart timeframe. The selected resolution must be less than or equal to the chart timeframe.")
int freshnessBufferMinutes = input.int(2, "Freshness Buffer Minutes", minval = 0, maxval = 15, group = GROUP_CBOE, tooltip = "Small technical allowance added to the CBOE source resolution when classifying observed timestamp freshness. It is independent from the chart timeframe.")
int delayedFeedMinutes = input.int(15, "Delayed Feed Minutes", minval = 1, maxval = 60, group = GROUP_CBOE)
int catchUpBufferMinutes = input.int(2, "Catch-Up Buffer Minutes", minval = 0, maxval = 15, group = GROUP_CBOE)
string cboeFinalSession = input.session("0931-1615", "CBOE Final Session", group = GROUP_CBOE, tooltip = "Session whose ending timestamp is required before a Next Session CBOE value is considered final. The default follows VIX1D dissemination through approximately 16:15 ET. If a cash-only chart stops producing bars before this time, Pine must wait for the next host-chart update; the indicator will report that state explicitly rather than use future data.")
string cboeTimezone = input.string("America/New_York", "CBOE Timezone", group = GROUP_CBOE)
string vixBenchmarkApplicabilityInput = input.string(BENCHMARK_AUTO, "VIX Benchmark Applicability", options = [BENCHMARK_AUTO, BENCHMARK_SPX_LINKED, BENCHMARK_CONTEXT_ONLY], group = GROUP_CBOE, tooltip = "Auto conservatively recognizes common SPX/SPY/ES/MES relationships. Manual selections are authoritative. Context Only keeps the maps visible but labels them as SPX volatility proxies rather than the chart instrument's own implied volatility.")
string vix1dSymbol = input.symbol("CBOE:VIX1D", "VIX1D Symbol", group = GROUP_VIX1D, tooltip = "TradingView symbol for Cboe's annualized one-business-day expected-volatility index.")
color vix1dLevelColor = input.color(color.rgb(70, 205, 190), "VIX1D Level Color", group = GROUP_VIX1D)
int vix1dLevelWidth = input.int(1, "VIX1D Level Width", minval = 1, maxval = 4, group = GROUP_VIX1D)
string vix1dLevelStyle = input.string(STYLE_DASHED, "VIX1D Level Style", options = [STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], group = GROUP_VIX1D)
int vix1dLevelTransparency = input.int(15, "VIX1D Level Transparency", minval = 0, maxval = 100, group = GROUP_VIX1D)
bool showVix1dLabels = input.bool(true, "Show VIX1D Labels", group = GROUP_VIX1D)
string vixSymbol = input.symbol("CBOE:VIX", "VIX Symbol", group = GROUP_VIX, tooltip = "TradingView symbol used for the VIX volatility-regime reference.")
float volDiscountThreshold = input.float(0.80, "Discount Ratio Threshold", minval = 0.01, step = 0.05, group = GROUP_VIX)
float volPremiumThreshold = input.float(1.20, "Premium Ratio Threshold", minval = 0.01, step = 0.05, group = GROUP_VIX)
color vixLevelColor = input.color(color.rgb(175, 135, 235), "VIX Level Color", group = GROUP_VIX)
int vixLevelWidth = input.int(1, "VIX Level Width", minval = 1, maxval = 4, group = GROUP_VIX)
string vixLevelStyle = input.string(STYLE_DOTTED, "VIX Level Style", options = [STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED], group = GROUP_VIX)
int vixLevelTransparency = input.int(25, "VIX Level Transparency", minval = 0, maxval = 100, group = GROUP_VIX)
bool showVixLabels = input.bool(true, "Show VIX Labels", group = GROUP_VIX)
float atmStrike = input.float(0.0, "ATM Strike", minval = 0.0, step = 0.01, group = GROUP_CONTRACT, tooltip = "Enter the strike used to source the Call and Put IV values. It is used only for the distance sanity check and does not change the volatility calculations.")
string ivSnapshotReferenceMode = input.string(SNAPSHOT_REFERENCE_MANUAL, "IV Snapshot Reference", options = [SNAPSHOT_REFERENCE_MANUAL, SNAPSHOT_REFERENCE_ANCHOR], group = GROUP_CONTRACT, tooltip = "Manual Price is the safest default and validates the strike against the underlying price observed when IV was captured. Anchor is an explicit convenience for snapshots taken at the map Anchor; it is never used implicitly.")
float ivSnapshotUnderlyingPrice = input.float(0.0, "Underlying Price at IV Snapshot", minval = 0.0, step = 0.01, group = GROUP_CONTRACT, tooltip = "Primary reference for ATM Strike validation when IV Snapshot Reference is Manual Price. Zero means reference not provided.")
float atmStrikeDistanceThresholdPct = input.float(0.50, "ATM Strike Distance Threshold %", minval = 0.05, maxval = 10.0, step = 0.05, group = GROUP_CONTRACT, tooltip = "A larger distance produces CHECK STRIKE but does not block the ATM map.")
float maximumDailyAtmIvPct = input.float(10.0, "Maximum Daily ATM IV %", minval = 0.10, maxval = 100.0, step = 0.10, group = GROUP_CONTRACT, tooltip = "Sanity ceiling applied after resolving direct or annualized inputs to daily percentages.")
string expirationLabel = input.string("", "Expiration Date", group = GROUP_CONTRACT, tooltip = "Enter the expiration as YYYY-MM-DD so Pine can perform a calendar sanity check. Holidays and exchange-specific expiry rules cannot be inferred from this text field.")
bool ivConfirmedForExpiration = input.bool(false, "IV Confirmed for Selected Expiration", group = GROUP_CONTRACT, tooltip = "User attestation only. Pine cannot independently prove that manually entered IV belongs to the selected strike and expiration.")
bool atmIvCurrentSnapshot = input.bool(false, "ATM IV Entered From Current Snapshot", group = GROUP_CONTRACT, tooltip = "User attestation used only for comparison confidence. Pine cannot timestamp manually entered IV values.")
bool showAnchor = input.bool(true, "Show Anchor", group = GROUP_LEVELS)
bool show025 = input.bool(false, "Show 0.25σ", group = GROUP_LEVELS)
