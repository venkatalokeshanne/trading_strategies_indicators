//@version=5
strategy("SENSEX Disciplined Sniper V4", overlay=true, initial_capital=100000, currency=currency.INR)

// --- 1. SETTINGS: 5 LOTS (100 UNITS) ---
numLots      = input.int(5, "Number of Lots")
unitsPerLot  = 20
totalUnits   = numLots * unitsPerLot 
maxDaily     = input.int(4, "Max Daily Trades") // STOP AFTER 4 TRADES

// Reward/Risk Math: 80 Index Pts * 100 Units = ₹8,000
targetPoints = 80  
stopPoints   = 80  

// --- 2. DAILY TRADE TRACKER ---
var int tradesToday = 0
if ta.change(time("D"))
    tradesToday := 0

// --- 3. THE "PROFIT RATIO" FILTERS ---
// A. Time Filter (09:20-12:00 & 13:30-14:30) - Skips the midday chop
session1 = time(timeframe.period, "0920-1200")
session2 = time(timeframe.period, "1330-1430")
isTradeWindow = not na(session1) or not na(session2)

// B. Trend Filter (ADX > 20) - Only trade when the market is actually moving
[diPlus, diMinus, adx] = ta.dmi(14, 14)
isTrending = adx > 20
isHighVol  = volume > ta.sma(volume, 20)

// --- 4. SIGNALS ---
// Only fire if we are under the 3-trade daily limit and inside the time window
canTrade = isTradeWindow and tradesToday < maxDaily and strategy.position_size == 0

ema200 = ta.ema(close, 200)
rsiVal = ta.rsi(close, 14)

buyCE = canTrade and close > ema200 and rsiVal > 60 and isTrending and isHighVol
buyPE = canTrade and close < ema200 and rsiVal < 40 and isTrending and isHighVol

// --- 5. EXECUTION & ACCURATE PRICE LOGGING ---
atmStrike = math.round(close / 100) * 100

if (buyCE)
    float entryP = close
    strategy.entry("CE", strategy.long, qty=totalUnits, comment="BUY CE " + str.tostring(atmStrike) + " @ " + str.tostring(entryP))
    tradesToday := tradesToday + 1
    strategy.exit("Exit CE", "CE", limit=entryP + targetPoints, stop=entryP - stopPoints, 
         comment_profit="SELL @ " + str.tostring(entryP + targetPoints) + " | WIN: ₹10000", 
         comment_loss="SELL @ " + str.tostring(entryP - stopPoints) + " | LOSS: ₹4000")

if (buyPE)
    float entryP = close
    strategy.entry("PE", strategy.short, qty=totalUnits, comment="BUY PE " + str.tostring(atmStrike) + " @ " + str.tostring(entryP))
    tradesToday := tradesToday + 1
    strategy.exit("Exit PE", "PE", limit=entryP - targetPoints, stop=entryP + stopPoints, 
         comment_profit="SELL @ " + str.tostring(entryP - targetPoints) + " | WIN: ₹10000", 
         comment_loss="SELL @ " + str.tostring(entryP + stopPoints) + " | LOSS: ₹4000")

// Visual Indicators
plot(ema200, color=color.new(color.yellow, 50), title="EMA 200")
bgcolor(tradesToday >= maxDaily ? color.new(color.gray, 90) : (not isTradeWindow ? color.new(color.red, 95) : na))