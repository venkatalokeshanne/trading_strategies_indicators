//@version=6
strategy("AS 1M SMART MONEY STRATEGY", overlay=true, 
     initial_capital=10000, 
     default_qty_type=strategy.percent_of_equity, 
     default_qty_value=10)

//────────────────────
// INPUTS & OPTIMIZATION
//────────────────────
len_sma9   = input.int(7, "Trigger SMA (Entry/Color/Alert)")
len_sma20  = input.int(20, "Fast-term Trend")
len_sma50  = input.int(50, "Short-term Trend")
len_sma89  = input.int(89, "Classic-term Trend")
len_sma200 = input.int(200, "Standard Trend Filter")
len_sma500 = input.int(500, "Macro Trend Filter")
fvg_extend = input.int(5, "FVG Visibility")

// Session Visuals
show_session = input.bool(true, "Highlight US Session on Chart")
session_color = input.color(color.new(color.blue, 90), "Session Background Color")

// Risk Management
tp_mult = input.float(2.5, "Take Profit (ATR Mult)")
sl_mult = input.float(1.5, "Stop Loss (ATR Mult)")

// Time Filter
use_time = input.bool(true, "Trade only during US Session")
is_us_session = time(timeframe.period, "0930-1600:23456") 

//────────────────────
// CORE CALCULATIONS
//────────────────────
sma9   = ta.sma(close, len_sma9)
sma20  = ta.sma(close, len_sma20)
sma50  = ta.sma(close, len_sma50)
sma89  = ta.sma(close, len_sma89)
sma200 = ta.sma(close, len_sma200)
sma500 = ta.sma(close, len_sma500)

atr = ta.atr(14)
atrShort = ta.atr(5)

// Volatility Logic
bbBasis = ta.sma(close, 20)
bbDev   = ta.stdev(close, 20)
bbUpper = bbBasis + bbDev * 2
bbLower = bbBasis - bbDev * 2
bbWidth = (bbUpper - bbLower) / bbBasis

isExpansion = atrShort > atr
isSqueeze   = bbWidth < ta.lowest(bbWidth, 50) * 1.1
validMarket = isExpansion and not isSqueeze

// Liquidity & FVG
swingHigh = ta.highest(high, 15)
swingLow  = ta.lowest(low, 15)
liqSweepHigh = high > swingHigh[1] and close < swingHigh[1]
liqSweepLow  = low < swingLow[1] and close > swingLow[1]

bull_fvg = low > high[2]
bear_fvg = high < low[2]

// Trend & Cross
bullTrend = close > sma50 and sma50 > sma500
bearTrend = close < sma50 and sma50 < sma500
bullCross = ta.crossover(close, sma9)
bearCross = ta.crossunder(close, sma9)

//────────────────────
// SCORE ENGINE
//────────────────────
scoreLong = (bullTrend ? 1 : 0) + (bullCross ? 1 : 0) + (bull_fvg ? 1 : 0) + (liqSweepLow ? 1 : 0)
scoreShort = (bearTrend ? 1 : 0) + (bearCross ? 1 : 0) + (bear_fvg ? 1 : 0) + (liqSweepHigh ? 1 : 0)

confLong  = scoreLong * 25
confShort = scoreShort * 25

timeCondition = use_time ? not na(is_us_session) : true
longSignal  = scoreLong >= 3 and validMarket and timeCondition
shortSignal = scoreShort >= 3 and validMarket and timeCondition

//────────────────────
// EXECUTION & ALERTS
//────────────────────
if longSignal
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", "Long", stop=close - atr * sl_mult, limit=close + atr * tp_mult)

if shortSignal
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", "Short", stop=close + atr * sl_mult, limit=close - atr * tp_mult)

alertcondition(longSignal, "🚀 ULTRA LONG", "Smart Money Entry Long")
alertcondition(shortSignal, "💥 ULTRA SHORT", "Smart Money Entry Short")

//────────────────────
// VISUALS
//────────────────────
bgcolor(show_session and not na(is_us_session) ? session_color : na)
barcolor(longSignal ? color.green : shortSignal ? color.red : close > sma9 ? color.new(#00ff08, 70) : color.new(#ff0000, 70))

plot(sma500, color=color.new(#7f009c, 50), style = plot.style_stepline, linewidth=2, title="Macro Trend")
plot(sma200, color=color.new(#0059a1, 50), style = plot.style_stepline, linewidth=2, title="Normal Trend")
plot(sma89, color=color.new(#6b6b6b, 59), style = plot.style_stepline, linewidth=2, title="Classic Term Trend")
plot(sma50, color=color.new(#a10000, 50), style = plot.style_stepline, linewidth=1, title="Short Term Trend")
plot(sma20, color=color.new(#a1a100, 74), style = plot.style_stepline, linewidth=1, title="Fast Term Trend")
plot(sma9, color=color.new(#5a5a5a, 70), style = plot.style_stepline, linewidth=1, title="Trigger SMA")

// FVG Boxes (Zoptymalizowane wyświetlanie)
if bull_fvg
    box.new(bar_index-2, low, bar_index+fvg_extend, high[2], bgcolor=color.new(color.green, 85), border_color=na)
if bear_fvg
    box.new(bar_index-2, low[2], bar_index+fvg_extend, high, bgcolor=color.new(color.red, 85), border_color=na)

//────────────────────
// DASHBOARD
//────────────────────
var table dash = table.new(position.bottom_left, 2, 4, border_width=1)
if barstate.islast
    trendTxt = bullTrend ? "UP" : bearTrend ? "DOWN" : "RANGE"
    trendCol = bullTrend ? color.green : bearTrend ? color.red : color.gray
    
    table.cell(dash, 0, 0, "Trend", bgcolor=color.new(color.gray, 90))
    table.cell(dash, 1, 0, trendTxt, text_color=trendCol)
    table.cell(dash, 0, 1, "Long %", bgcolor=color.new(color.gray, 90))
    table.cell(dash, 1, 1, str.tostring(confLong) + "%", text_color=confLong >= 75 ? color.green : color.white)
    table.cell(dash, 0, 2, "Short %", bgcolor=color.new(color.gray, 90))
    table.cell(dash, 1, 2, str.tostring(confShort) + "%", text_color=confShort >= 75 ? color.red : color.white)
    table.cell(dash, 0, 3, "Volatility", bgcolor=color.new(color.gray, 90))
    table.cell(dash, 1, 3, isExpansion ? "EXPANSION" : "SQUEEZE", text_color=isExpansion ? color.green : color.orange)
