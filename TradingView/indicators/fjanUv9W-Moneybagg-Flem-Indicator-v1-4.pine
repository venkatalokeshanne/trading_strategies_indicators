             trendText(bull1m, bear1m),
             bgcolor = trendColor(bull1m, bear1m),
             text_color = color.white,
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             0,
             8,
             "5m",
             text_size = dashboardTextSize
        )

        table.cell(
             dashboard,
             1,
