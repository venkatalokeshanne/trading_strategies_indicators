//@version=5
strategy("Liquidity Sweep & RSI Divergence (Fixed $ Risk)", overlay=true, initial_capital=1000, currency=currency.USD, default_qty_type=strategy.cash)

// --- Inputs ---
riskPerTrade      = input.float(50.0, "Risk Per Trade ($)", tooltip="Amount to lose if SL is hit")
rrRatio           = input.float(2.5, "Risk:Reward Ratio")
bodyPercent       = input.float(10.0, "Max Body % of Range")
wickPercent       = input.float(70.0, "Min Wick % of Range")
liquidityLookback = input.int(50, "Liquidity Lookback")
rsiLength         = input.int(14, "RSI Length")

// --- Indicators ---
rsiValue = ta.rsi(close, rsiLength)

// --- Candlestick Detection ---
candleRange = high - low
bodySize    = math.abs(open - close)
upperWick   = high - math.max(open, close)
lowerWick   = math.min(open, close) - low
isDoji      = candleRange > 0 and bodySize <= (candleRange * (bodyPercent / 100))

isDragonfly  = isDoji and lowerWick >= (candleRange * (wickPercent / 100)) and upperWick <= (candleRange * 0.1)
isGravestone = isDoji and upperWick >= (candleRange * (wickPercent / 100)) and lowerWick <= (candleRange * 0.1)

// --- Liquidity Sweep & Divergence ---
prevLowLevel   = ta.lowest(low[1], liquidityLookback)
longSweep      = low < prevLowLevel
prevRsiLow     = ta.lowest(rsiValue[1], liquidityLookback)
bullDivergence = rsiValue > prevRsiLow

prevHighLevel  = ta.highest(high[1], liquidityLookback)
shortSweep     = high > prevHighLevel
prevRsiHigh    = ta.highest(rsiValue[1], liquidityLookback)
bearDivergence = rsiValue < prevRsiHigh

// --- Position Sizing Logic ---
// We calculate how many units to buy so that (Entry - SL) * Qty = $50
get_qty(sl_price) =>
    risk_per_share = math.abs(close - sl_price)
    risk_per_share > 0 ? (riskPerTrade / risk_per_share) : 0

// --- Execution Logic ---

// LONG ENTRY
if isDragonfly and longSweep and bullDivergence and strategy.position_size == 0
    float sl = low
    float qty = get_qty(sl)
    if qty > 0
        float tp = close + (math.abs(close - sl) * rrRatio)
        strategy.entry("Long", strategy.long, qty=qty, comment="Risk $50")
        strategy.exit("Exit Long", "Long", stop=sl, limit=tp, comment_loss="SL -50", comment_profit="TP +125")

// SHORT ENTRY
if isGravestone and shortSweep and bearDivergence and strategy.position_size == 0
    float sl = high
    float qty = get_qty(sl)
    if qty > 0
        float tp = close - (math.abs(sl - close) * rrRatio)
        strategy.entry("Short", strategy.short, qty=qty, comment="Risk $50")
        strategy.exit("Exit Short", "Short", stop=sl, limit=tp, comment_loss="SL -50", comment_profit="TP +125")

// --- Visuals ---
plot(prevLowLevel, color=color.new(color.blue, 50), style=plot.style_line, title="Liquidity Low")
plot(prevHighLevel, color=color.new(color.red, 50), style=plot.style_line, title="Liquidity High")
plotshape(strategy.position_size == 0 and isDragonfly and longSweep and bullDivergence, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(strategy.position_size == 0 and isGravestone and shortSweep and bearDivergence, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)