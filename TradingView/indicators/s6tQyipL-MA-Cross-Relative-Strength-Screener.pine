// RS base logic © bharatTrader; combined/modified

//@version=6
indicator("MA Cross + Relative Strength Screener", shorttitle="MA+RS Scr", overlay=false)

// === Inputs ===
source              = input(close, "Source")
fastLen             = input.int(10, "Fast EMA Length")
slowLen             = input.int(40, "Slow EMA Length")
comparativeTickerId = input.symbol("NSE:NIFTYSMLCAP250", "Comparative Symbol (RS Benchmark)")
rsLength            = input.int(123, "RS Period", minval=1)
rsThreshold         = input.float(0.0, "RS Threshold (bullish trigger)")
sensitivity         = input.float(8.0, "Composite Sensitivity", minval=0.1, tooltip="Avg % divergence (MA% + RS%)/2 that maps to ~76 score. Lower = line saturates faster near ±100. Raise if too many stocks are pinned at exactly 100.")

// === Calculations ===
fastMA = ta.ema(source, fastLen)
slowMA = ta.ema(source, slowLen)
maCondition = fastMA > slowMA

baseSymbol = request.security(syminfo.tickerid, timeframe.period, source, lookahead=barmerge.lookahead_off)
comparativeSymbol = request.security(comparativeTickerId, timeframe.period, source, lookahead=barmerge.lookahead_off)
res = baseSymbol / baseSymbol[rsLength] / (comparativeSymbol / comparativeSymbol[rsLength]) - 1
rsCondition = res > rsThreshold

// === Flag Logic ===
// 3 = BULLISH (both true) -> Green
// 2 = HOLD (exactly one true) -> Orange
// 1 = BEARISH (both false) -> Red
bothTrue   = maCondition and rsCondition
eitherTrue = maCondition != rsCondition
flag       = bothTrue ? 3 : eitherTrue ? 2 : 1
flagLabel  = bothTrue ? "BULLISH" : eitherTrue ? "HOLD" : "BEARISH"
flagColor  = bothTrue ? color.green : eitherTrue ? color.orange : color.red

// === Composite Score (MA signal + RS signal, smoothly scaled -100 to +100) ===
// tanh-based scaling: avoids hard clipping so strongly-trending stocks don't all pin at exactly 100
maSignalPct    = (fastMA - slowMA) / slowMA * 100
rsSignalPct    = res * 100
rawComposite   = (maSignalPct + rsSignalPct) / 2
tanhInput      = rawComposite / sensitivity
expTerm        = math.exp(2 * tanhInput)
tanhVal        = (expTerm - 1) / (expTerm + 1)
compositeScore = 100 * tanhVal

// === Bars since last Bearish flag (flag == 1) ===
barsSinceBearish = ta.barssince(flag == 1)

// === Plot ===
plot(compositeScore, title="Composite Score", color=flagColor, linewidth=3)
hline(0, "Zero Line", color=color.gray, linestyle=hline.style_dashed)
hline(100, "Upper Bound", color=color.new(color.gray, 70))
hline(-100, "Lower Bound", color=color.new(color.gray, 70))

bgcolor(bothTrue ? color.new(color.green, 90) : eitherTrue ? color.new(color.orange, 90) : color.new(color.red, 90))

plotchar(flag, "Flag Value (1/2/3)", "", location.top, size=size.tiny)
plot(barsSinceBearish, title="Bars Since Bearish", display=display.data_window)

// === Table (visible per-chart summary; useful when flipping through watchlist) ===
var table infoTable = table.new(position.top_right, 2, 3, bgcolor=color.new(color.black, 70))
if barstate.islast
    table.cell(infoTable, 0, 0, "Flag", text_color=color.white)
    table.cell(infoTable, 1, 0, flagLabel, text_color=flagColor)
    table.cell(infoTable, 0, 1, "Score", text_color=color.white)
    table.cell(infoTable, 1, 1, str.tostring(compositeScore, "#.##"), text_color=flagColor)
    table.cell(infoTable, 0, 2, "Bars/Bearish", text_color=color.white)
    table.cell(infoTable, 1, 2, str.tostring(barsSinceBearish), text_color=color.white)

// === Alerts (for scanning across a watchlist) ===
alertcondition(bothTrue, "Bullish Flag (3)", "Both MA and RS conditions bullish")
alertcondition(eitherTrue, "Hold Flag (2)", "Only one condition bullish")
alertcondition(not maCondition and not rsCondition, "Bearish Flag (1)", "Both conditions bearish")
