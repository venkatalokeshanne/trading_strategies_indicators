//@version=5
strategy("5 Min Liquidity Sweep Short 1:3 RR", overlay=true, initial_capital=100000, pyramiding=0)

// Only run on 5-minute timeframe
isFiveMin = timeframe.isintraday and timeframe.multiplier == 5

// Track current day's running high
var float dayHigh = na
newDay = ta.change(time("D"))

if newDay
    dayHigh := high
else
    dayHigh := math.max(dayHigh, high)

// Conditions
prevBullish = close[1] > open[1]
prevHighAtDayHigh = high[1] >= dayHigh[1]
latestCloseBelowPrevOpen = close < open[1]
latestHighCrossAbovePrevHigh = high > high[1]

// Final short condition
shortCondition = isFiveMin and prevBullish and prevHighAtDayHigh and latestCloseBelowPrevOpen and latestHighCrossAbovePrevHigh

// Variables to freeze stop and target after entry
var float shortSL = na
var float shortTP = na

if shortCondition and strategy.position_size == 0
    shortSL := high
    entryPrice = close
    risk = shortSL - entryPrice
    shortTP := entryPrice - (risk * 1.0)

    if risk > 0
        strategy.entry("Short", strategy.short)
        strategy.exit("Short Exit", "Short", stop=shortSL, limit=shortTP)

// Plots
plot(dayHigh, title="Day High", color=color.orange, linewidth=2)
plot(shortSL, title="Short SL", color=color.red, linewidth=1, style=plot.style_linebr)
plot(shortTP, title="Short TP 1:3", color=color.green, linewidth=1, style=plot.style_linebr)

plotshape(shortCondition, title="Short Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SHORT")