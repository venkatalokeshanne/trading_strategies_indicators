//@version=6
indicator("VPA & Wyckoff: Accumulation & Distribution", overlay=true, max_lines_count=500)

// ==========================================
// INPUTS & PARAMETERS
// ==========================================
grp1 = "Part 1: Moving Averages & Volume"
smaLen = input.int(20, title="Volume & Spread SMA Length", group=grp1)
trendLen = input.int(50, title="Trend SMA Length", group=grp1)

grp2 = "Part 2: Margin Settings"
// Use 2% for Stocks/Crypto, lower to 0.1% or 0.2% for Forex
stMarginPct = input.float(2.0, title="Secondary Test Margin (%)", group=grp2, step=0.1) / 100 


// ==========================================
// CORE VARIABLES (Shared for Buy & Sell)
// ==========================================
v = volume
avgV = ta.sma(v, smaLen)
spread = high - low
avgSpread = ta.sma(spread, smaLen)
lowerWick = math.min(open, close) - low
upperWick = high - math.max(open, close)
ma50 = ta.sma(close, trendLen)
c2_volAnomaly = v > (avgV * 2) // Shared Volume Anomaly (The Effort)


// ==========================================
// ACCUMULATION (BUYING LOGIC)
// ==========================================
// Stopping Volume (Selling Climax) Conditions
c1_downtrend = (close < ma50) and (close < close[10])
c3a_hammer = lowerWick > (0.5 * spread)
c3b_narrowDown = (spread < avgSpread) and (close < open)
stoppingVolume = c1_downtrend and c2_volAnomaly and (c3a_hammer or c3b_narrowDown)

plotshape(stoppingVolume, title="Selling Climax (SC)", style=shape.triangleup, location=location.belowbar, color=color.blue, size=size.small, text="SC")

// Accumulation State Tracking
var int acc_state = 0 // 0 = Inactive, 1 = Tracking AR, 2 = AR Locked
var float scLow = na
var float arHigh = na
var line scLine = na
var line arLineBuy = na

isBuyST = false
isSpring = false
isSOS = false

if stoppingVolume
    acc_state := 1
    scLow := low
    arHigh := high 
    scLine := line.new(bar_index, scLow, bar_index, scLow, color=color.green, width=2, style=line.style_solid)
    arLineBuy := line.new(bar_index, arHigh, bar_index, arHigh, color=color.red, width=2, style=line.style_dashed)

if acc_state > 0
    line.set_x2(scLine, bar_index)
    line.set_x2(arLineBuy, bar_index)

    if acc_state == 1
        arHigh := math.max(arHigh, high)
        line.set_y1(arLineBuy, arHigh)
        line.set_y2(arLineBuy, arHigh)

    stUpperBand = scLow * (1 + stMarginPct)
    if acc_state == 1 and (low <= stUpperBand) and (low >= scLow) and (v < avgV) and not stoppingVolume
        acc_state := 2
        isBuyST := true

    if (low < scLow) and (close > scLow) and (v > avgV) and not stoppingVolume
        isSpring := true
        acc_state := 2 

    if (close > arHigh) and (v > avgV) and (close > open)
        isSOS := true
        acc_state := 0 

    if (close < scLow) and not isSpring
        acc_state := 0 

plotshape(isBuyST, title="Buy Secondary Test (ST)", style=shape.circle, location=location.belowbar, color=color.orange, size=size.tiny, text="ST")
plotshape(isSpring, title="Spring", style=shape.arrowup, location=location.belowbar, color=color.teal, size=size.small, text="Spring")
plotshape(isSOS, title="Sign of Strength (SOS)", style=shape.labelup, location=location.belowbar, color=color.green, size=size.small, text="SOS", textcolor=color.white)


// ==========================================
// DISTRIBUTION (SELLING LOGIC)
// ==========================================
// Stopping Volume (Buying Climax) Conditions
c1_uptrend = (close > ma50) and (close > close[10])
c3a_shootingStar = upperWick > (0.5 * spread)
c3b_narrowUp = (spread < avgSpread) and (close > open)
buyingClimax = c1_uptrend and c2_volAnomaly and (c3a_shootingStar or c3b_narrowUp)

plotshape(buyingClimax, title="Buying Climax (BC)", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="BC")

// Distribution State Tracking
var int dist_state = 0 // 0 = Inactive, 1 = Tracking AR, 2 = AR Locked
var float bcHigh = na
var float arLow = na
var line bcLine = na
var line arLineSell = na

isSellST = false
isUTAD = false
isSOW = false

if buyingClimax
    dist_state := 1
    bcHigh := high
    arLow := low 
    bcLine := line.new(bar_index, bcHigh, bar_index, bcHigh, color=color.red, width=2, style=line.style_solid)
    arLineSell := line.new(bar_index, arLow, bar_index, arLow, color=color.green, width=2, style=line.style_dashed)

if dist_state > 0
    line.set_x2(bcLine, bar_index)
    line.set_x2(arLineSell, bar_index)

    if dist_state == 1
        arLow := math.min(arLow, low)
        line.set_y1(arLineSell, arLow)
        line.set_y2(arLineSell, arLow)

    stLowerBand = bcHigh * (1 - stMarginPct)
    if dist_state == 1 and (high >= stLowerBand) and (high <= bcHigh) and (v < avgV) and not buyingClimax
        dist_state := 2
        isSellST := true

    if (high > bcHigh) and (close < bcHigh) and (v > avgV) and not buyingClimax
        isUTAD := true
        dist_state := 2 

    if (close < arLow) and (v > avgV) and (close < open)
        isSOW := true
        dist_state := 0 

    if (close > bcHigh) and not isUTAD
        dist_state := 0 

plotshape(isSellST, title="Sell Secondary Test (ST)", style=shape.circle, location=location.abovebar, color=color.orange, size=size.tiny, text="ST")
plotshape(isUTAD, title="Upthrust (UTAD)", style=shape.arrowdown, location=location.abovebar, color=color.fuchsia, size=size.small, text="UTAD")
plotshape(isSOW, title="Sign of Weakness (SOW)", style=shape.labeldown, location=location.abovebar, color=color.red, size=size.small, text="SOW", textcolor=color.white)