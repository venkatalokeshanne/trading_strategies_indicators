//@version=6
indicator("50 EMA / 200 EMA Crossover Signals", overlay=true)

// EMA Calculations
ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)

// Plot EMAs
plot(ema50, color=color.blue, linewidth=2, title="50 EMA")
plot(ema200, color=color.green, linewidth=4, title="200 EMA")

// Crossover Conditions
buySignal = ta.crossover(ema50, ema200)
sellSignal = ta.crossunder(ema50, ema200)

// Plot Buy Signal
plotshape(
     buySignal,
     title="BUY",
     location=location.belowbar,
     style=shape.labelup,
     text="BUY",
     color=color.green,
     textcolor=color.white,
     size=size.large)

// Plot Sell Signal
plotshape(
     sellSignal,
     title="SELL",
     location=location.abovebar,
     style=shape.labeldown,
     text="SELL",
     color=color.red,
     textcolor=color.white,
     size=size.large)

// Background Highlight
bgcolor(buySignal ? color.new(color.green, 90) : na)
bgcolor(sellSignal ? color.new(color.red, 90) : na)

// Alerts
alertcondition(buySignal, title="Golden Cross Buy", message="50 EMA crossed ABOVE 200 EMA")
alertcondition(sellSignal, title="Death Cross Sell", message="50 EMA crossed BELOW 200 EMA")