//@version=5
strategy("Ellis US30 Combo Strategy", overlay=true, initial_capital=1000, pyramiding=0, calc_on_order_fills=true, calc_on_every_tick=false, process_orders_on_close=true)

// =========================
// INPUTS
// =========================
useNySession      = input.bool(true, "Trade Only New York Session")
nySession         = input.session("0930-1600", "New York Session")

useDailyProfit    = input.bool(true, "Use Daily Profit Target ($)")
dailyProfitTarget = input.float(100.0, "Daily Profit Target ($)", minval=1)

useDailyLoss      = input.bool(true, "Use Daily Loss Limit ($)")
dailyLossLimit    = input.float(100.0, "Daily Loss Limit ($)", minval=1)

stopLossPoints    = input.float(300.0, "Stop Loss (Points)", minval=1)
takeProfitPoints  = input.float(600.0, "Take Profit (Points)", minval=1)

smaFastLen        = input.int(21, "SMA Fast", minval=1)
smaMidLen         = input.int(50, "SMA Mid", minval=1)
smaSlowLen        = input.int(200, "SMA Slow", minval=1)

macdFastLen       = input.int(12, "MACD Fast Length", minval=1)
macdSlowLen       = input.int(26, "MACD Slow Length", minval=1)
macdSignalLen     = input.int(9, "MACD Signal Length", minval=1)

stochKLen         = input.int(3, "Stoch RSI K", minval=1)
stochDLen         = input.int(3, "Stoch RSI D", minval=1)
stochRsiLen       = input.int(14, "Stoch RSI RSI Length", minval=1)
stochLen          = input.int(12, "Stoch RSI Length", minval=1)
stochOversold     = input.float(25.0, "Stoch RSI Oversold")
stochOverbought   = input.float(75.0, "Stoch RSI Overbought")

rsiDivPeriod      = input.int(14, "RSI Div Period", minval=1)
divPivotLeft      = input.int(5, "RSI Div Pivot Left", minval=1)
divPivotRight     = input.int(5, "RSI Div Pivot Right", minval=1)
divFloating       = input.float(50.0, "RSI Div Floating")
divScanLength     = input.int(50, "RSI Div Length", minval=5)

showSignals       = input.bool(true, "Show Buy/Sell Labels")
showPanel         = input.bool(true, "Show Moving Chart Panel")

// =========================
// SESSION
// =========================
inNySession = not na(time(timeframe.period, nySession))
sessionOk   = useNySession ? inNySession : true

// =========================
// INDICATORS
// =========================
sma21  = ta.sma(close, smaFastLen)
sma50  = ta.sma(close, smaMidLen)
sma200 = ta.sma(close, smaSlowLen)

rsiStochSource = ta.rsi(close, stochRsiLen)
rsiDiv         = ta.rsi(close, rsiDivPeriod)

lowestRsi   = ta.lowest(rsiStochSource, stochLen)
highestRsi  = ta.highest(rsiStochSource, stochLen)
rawStochRsi = highestRsi - lowestRsi == 0 ? 50.0 : ((rsiStochSource - lowestRsi) / (highestRsi - lowestRsi)) * 100.0
k           = ta.sma(rawStochRsi, stochKLen)
d           = ta.sma(k, stochDLen)

[macdLine, signalLine, histLine] = ta.macd(close, macdFastLen, macdSlowLen, macdSignalLen)

// =========================
// RSI DIVERGENCE
// =========================
pivotLowPrice  = ta.pivotlow(low, divPivotLeft, divPivotRight)
pivotHighPrice = ta.pivothigh(high, divPivotLeft, divPivotRight)
pivotLowRsi    = ta.pivotlow(rsiDiv, divPivotLeft, divPivotRight)
pivotHighRsi   = ta.pivothigh(rsiDiv, divPivotLeft, divPivotRight)

var float prevBullPrice = na
var float lastBullPrice = na
var float prevBullRsi   = na
var float lastBullRsi   = na
var int   lastBullBar   = na

var float prevBearPrice = na
var float lastBearPrice = na
var float prevBearRsi   = na
var float lastBearRsi   = na
var int   lastBearBar   = na

if not na(pivotLowPrice) and not na(pivotLowRsi)
    prevBullPrice := lastBullPrice
    prevBullRsi   := lastBullRsi
    lastBullPrice := pivotLowPrice
    lastBullRsi   := pivotLowRsi
    lastBullBar   := bar_index - divPivotRight

if not na(pivotHighPrice) and not na(pivotHighRsi)
    prevBearPrice := lastBearPrice
    prevBearRsi   := lastBearRsi
    lastBearPrice := pivotHighPrice
    lastBearRsi   := pivotHighRsi
    lastBearBar   := bar_index - divPivotRight

bullishDivergence = not na(prevBullPrice) and not na(lastBullPrice) and not na(prevBullRsi) and not na(lastBullRsi) and lastBullPrice < prevBullPrice and lastBullRsi > prevBullRsi and not na(lastBullBar) and (bar_index - lastBullBar <= divScanLength)
bearishDivergence = not na(prevBearPrice) and not na(lastBearPrice) and not na(prevBearRsi) and not na(lastBearRsi) and lastBearPrice > prevBearPrice and lastBearRsi < prevBearRsi and not na(lastBearBar) and (bar_index - lastBearBar <= divScanLength)

// =========================
// STRATEGY CONDITIONS
// =========================
stockBuy  = sma21 > sma50 and ta.crossover(k, d) and math.min(k, d) <= stochOversold
stockSell = sma21 < sma50 and ta.crossunder(k, d) and math.max(k, d) >= stochOverbought

macdBuy   = sma21 > sma50 and sma21 > sma200 and sma50 > sma200 and ta.crossover(macdLine, signalLine) and macdLine < 0 and signalLine < 0 and rsiDiv > divFloating and bullishDivergence
macdSell  = sma21 < sma50 and sma21 < sma200 and sma50 < sma200 and ta.crossunder(macdLine, signalLine) and macdLine > 0 and signalLine > 0 and rsiDiv < divFloating and bearishDivergence

buySignal  = stockBuy or macdBuy
sellSignal = stockSell or macdSell

// =========================
// DAILY P/L CONTROL
// =========================
newDay = ta.change(time("D"))

var float dayStartNetProfit = 0.0
if newDay
    dayStartNetProfit := strategy.netprofit

dailyClosedPnL = strategy.netprofit - dayStartNetProfit
dailyProfitHit = useDailyProfit and dailyClosedPnL >= dailyProfitTarget
dailyLossHit   = useDailyLoss and dailyClosedPnL <= -dailyLossLimit
dailyBlocked   = dailyProfitHit or dailyLossHit

// =========================
// ORDERS
// =========================
pointValue = syminfo.mintick

longStop   = close - stopLossPoints * pointValue
longTp     = close + takeProfitPoints * pointValue
shortStop  = close + stopLossPoints * pointValue
shortTp    = close - takeProfitPoints * pointValue

allowTrade = sessionOk and not dailyBlocked and barstate.isconfirmed

enterLong  = allowTrade and buySignal and strategy.position_size <= 0 and not sellSignal
enterShort = allowTrade and sellSignal and strategy.position_size >= 0 and not buySignal

longComment  = stockBuy and macdBuy ? "Stock+MACD" : stockBuy ? "Stock" : "MACD"
shortComment = stockSell and macdSell ? "Stock+MACD" : stockSell ? "Stock" : "MACD"

if enterLong
    strategy.entry("Buy", strategy.long, comment=longComment)
    strategy.exit("Buy Exit", "Buy", stop=longStop, limit=longTp)

if enterShort
    strategy.entry("Sell", strategy.short, comment=shortComment)
    strategy.exit("Sell Exit", "Sell", stop=shortStop, limit=shortTp)

// =========================
// ALERTS
// =========================
if enterLong
    alert("BUY signal on " + syminfo.ticker + " " + timeframe.period + " | " + longComment, alert.freq_once_per_bar_close)

if enterShort
    alert("SELL signal on " + syminfo.ticker + " " + timeframe.period + " | " + shortComment, alert.freq_once_per_bar_close)

alertcondition(enterLong, "Ellis BUY", "BUY signal")
alertcondition(enterShort, "Ellis SELL", "SELL signal")
alertcondition(stockBuy, "Stock Strategy BUY", "Stock Strategy BUY")
alertcondition(stockSell, "Stock Strategy SELL", "Stock Strategy SELL")
alertcondition(macdBuy, "MACD Strategy BUY", "MACD Strategy BUY")
alertcondition(macdSell, "MACD Strategy SELL", "MACD Strategy SELL")

// =========================
// LABELS / SIGNALS
// =========================
plotshape(showSignals and enterLong, title="BUY", text="BUY", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 0), textcolor=color.white, size=size.small)
plotshape(showSignals and enterShort, title="SELL", text="SELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), textcolor=color.white, size=size.small)

plotshape(showSignals and stockBuy, title="Stock Buy", text="Stock", style=shape.circle, location=location.belowbar, color=color.new(color.lime, 0), size=size.tiny)
plotshape(showSignals and stockSell, title="Stock Sell", text="Stock", style=shape.circle, location=location.abovebar, color=color.new(color.maroon, 0), size=size.tiny)

plotshape(showSignals and macdBuy, title="MACD Buy", text="MACD", style=shape.triangleup, location=location.belowbar, color=color.new(color.blue, 0), size=size.tiny)
plotshape(showSignals and macdSell, title="MACD Sell", text="MACD", style=shape.triangledown, location=location.abovebar, color=color.new(color.orange, 0), size=size.tiny)

// =========================
// PLOTS
// =========================
plot(sma21, "SMA 21", color=color.new(color.green, 0))
plot(sma50, "SMA 50", color=color.new(color.orange, 0))
plot(sma200, "SMA 200", color=color.new(color.red, 0))

// =========================
// MOVING PANEL
// =========================
var label infoLabel = na

dailyStatusText = dailyProfitHit ? "TARGET HIT" : dailyLossHit ? "LOSS HIT" : "ACTIVE"
stockText       = stockBuy ? "BUY" : stockSell ? "SELL" : "WAIT"
macdText        = macdBuy ? "BUY" : macdSell ? "SELL" : "WAIT"
finalText       = buySignal ? "BUY" : sellSignal ? "SELL" : "WAIT"
positionText    = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"

panelText = "Ellis US30 Combo\nSession: " + (sessionOk ? "OPEN" : "CLOSED") + "\nDaily P/L: " + str.tostring(dailyClosedPnL) + "\nProfit Target: " + (useDailyProfit ? "$" + str.tostring(dailyProfitTarget) : "OFF") + "\nLoss Limit: " + (useDailyLoss ? "-$" + str.tostring(dailyLossLimit) : "OFF") + "\nDaily Status: " + dailyStatusText + "\nStock Strategy: " + stockText + "\nMACD Strategy: " + macdText + "\nFinal Signal: " + finalText + "\nPosition: " + positionText

panelY = high + ta.atr(14) * 2.0

if showPanel and barstate.islast
    if not na(infoLabel)
        label.delete(infoLabel)
    infoLabel := label.new(bar_index, panelY, panelText, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, textcolor=color.white, color=color.new(color.black, 15), size=size.small)