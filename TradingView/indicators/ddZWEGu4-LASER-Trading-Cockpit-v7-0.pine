float stopBufferATR = input.float(0.10, "Stop Buffer — ATR", minval = 0, step = 0.05, group = G_LOC)
float maximumStop = input.float(60.0, "Maximum Stop — Points", minval = 1, step = 5, group = G_LOC)
float tp1R = input.float(1.0, "TP1 — R", minval = 0.25, step = 0.25, group = G_LOC)
float tp2R = input.float(2.0, "TP2 — R", minval = 0.5, step = 0.25, group = G_LOC)
float minimumRoomR = input.float(0.5, "Minimum Open Space — R", minval = 0.25, step = 0.25, group = G_LOC)

//=============================================================================
// 11 — HELPERS
//=============================================================================
f_near(float level, float atrValue, float proximity) => not na(level) and math.abs(close - level) <= atrValue * proximity
f_longRisk(float stopPrice) => na(stopPrice) ? na : close - stopPrice
f_shortRisk(float stopPrice) => na(stopPrice) ? na : stopPrice - close
f_longRiskAt(float stopPrice, float entryPrice) => na(stopPrice) or na(entryPrice) ? na : entryPrice - stopPrice
f_shortRiskAt(float stopPrice, float entryPrice) => na(stopPrice) or na(entryPrice) ? na : stopPrice - entryPrice
f_riskPass(float risk) => not na(risk) and risk > syminfo.mintick and risk <= maximumStop
f_countTrue(bool condition, int length) =>
    int result = 0
    for i = 0 to length - 1
        if condition[i]
            result += 1
    result

f_above(float candidate, float existing) =>
    float result = existing
    if not na(candidate) and candidate > close
        if na(result) or candidate < result
            result := candidate
    result

f_below(float candidate, float existing) =>
    float result = existing
    if not na(candidate) and candidate < close
        if na(result) or candidate > result
            result := candidate
    result


// Project a user-defined two-point trendline to any timestamp.
f_manualTlValue(
     int t1,
     float p1,
     int t2,
     float p2,
     int targetTime) =>

    float result = na

    if t1 > 0 and
       t2 > t1 and
       p1 > 0 and
       p2 > 0

        float progress =
             float(targetTime - t1) /
             float(t2 - t1)

        result :=
             p1 +
             (p2 - p1) * progress

    result


//=============================================================================
// 12 — TIMEFRAME / EMA CALCULATIONS
//=============================================================================
bool is1m = timeframe.isminutes and timeframe.multiplier == 1
bool is5m = timeframe.isminutes and timeframe.multiplier == 5
bool isOther = not is1m and not is5m
bool profileEnabled = is1m ? enable1m : is5m ? enable5m : enableOther

float ema1mFastNative = ta.ema(close, length1mFast)
float ema1mSlowNative = ta.ema(close, length1mSlow)
float ema1mTrendNative = ta.ema(close, length1mTrend)
float ema1mRegimeNative = ta.ema(close, length1mRegime)

[ema1mFastHtf, ema1mSlowHtf, ema1mTrendHtf, ema1mRegimeHtf] = request.security(
     syminfo.tickerid, "1",
     [ta.ema(close, length1mFast), ta.ema(close, length1mSlow), ta.ema(close, length1mTrend), ta.ema(close, length1mRegime)],
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

float ema2m200 = request.security(syminfo.tickerid, "2", ta.ema(close, 200), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
float ema5mFast = ta.ema(close, length5mFast)
float ema5mTrend = ta.ema(close, length5mTrend)
float ema5mRegime = ta.ema(close, length5mRegime)
float emaOtherFast = ta.ema(close, lengthOtherFast)
float emaOtherTrend = ta.ema(close, lengthOtherTrend)
float emaOtherRegime = ta.ema(close, lengthOtherRegime)

bool useProjected1mNow = (is5m and enable5m and use1mEmasOn5m) or (isOther and enableOther and use1mEmasOnOther)
float laserFastEma = is1m ? ema1mFastNative : useProjected1mNow ? ema1mFastHtf : is5m ? ema5mFast : emaOtherFast
float laserTrendEma = is1m ? ema1mTrendNative : useProjected1mNow ? ema1mTrendHtf : is5m ? ema5mTrend : emaOtherTrend
float laserRegimeEma = is1m ? ema1mRegimeNative : useProjected1mNow ? ema1mRegimeHtf : is5m ? ema5mRegime : emaOtherRegime
float laserSlowEma = is1m ? ema1mSlowNative : useProjected1mNow ? ema1mSlowHtf : na

// Futures-session VWAP
bool newFuturesSession = session.isfirstbar
float futuresSessionVwap = ta.vwap(hlc3, newFuturesSession)
[vwapSdBase, vwapSdUpperBase, vwapSdLowerBase] = ta.vwap(hlc3, newFuturesSession, 1.0)
float futuresVwapSd = vwapSdUpperBase - vwapSdBase
float futuresVwapUpper1 = futuresSessionVwap + futuresVwapSd * vwapSdMultiplier1
float futuresVwapLower1 = futuresSessionVwap - futuresVwapSd * vwapSdMultiplier1
float futuresVwapUpper2 = futuresSessionVwap + futuresVwapSd * vwapSdMultiplier2
float futuresVwapLower2 = futuresSessionVwap - futuresVwapSd * vwapSdMultiplier2
float futuresVwapUpper3 = futuresSessionVwap + futuresVwapSd * vwapSdMultiplier3
float futuresVwapLower3 = futuresSessionVwap - futuresVwapSd * vwapSdMultiplier3

bool inRthVwap = not na(time(timeframe.period, rthVwapSession, sessionTimezone))
bool newRthVwap = inRthVwap and (bar_index == 0 or not inRthVwap[1])
var float rthCumPV = 0.0
var float rthCumV = 0.0
if newRthVwap
    rthCumPV := hlc3 * nz(volume, 0)
    rthCumV := nz(volume, 0)
else if inRthVwap
    rthCumPV += hlc3 * nz(volume, 0)
    rthCumV += nz(volume, 0)
float rthVwap = rthCumV > 0 ? rthCumPV / rthCumV : na

// EMA / VWAP plots
//
// IMPORTANT: Pine caps scripts at 64 plot counts. Input/series colors can make
// one plot() consume TWO counts. The old version used separate plot() calls for
// native 1m, projected 1m, native 5m, and native higher-TF EMAs. They were
// visually mutually exclusive, so v5.1 routes each conceptual EMA through ONE
// plot. This preserves the displayed values while saving ~20 plot counts.

bool displayFast =
     (is1m and enable1m and show1mFast) or
     (useProjected1mNow and show1mFast) or
     (is5m and enable5m and not use1mEmasOn5m and show5mFast) or
     (isOther and enableOther and not use1mEmasOnOther and showOtherFast)

bool displaySlow =
     (is1m and enable1m and show1mSlow) or
     (useProjected1mNow and show1mSlow)

bool displayTrend =
     (is1m and enable1m and show1mTrend) or
     (useProjected1mNow and show1mTrend) or
     (is5m and enable5m and not use1mEmasOn5m and show5mTrend) or
     (isOther and enableOther and not use1mEmasOnOther and showOtherTrend)

bool displayRegime =
     (is1m and enable1m and show1mRegime) or
     (useProjected1mNow and show1mRegime) or
     (is5m and enable5m and not use1mEmasOn5m and show5mRegime) or
     (isOther and enableOther and not use1mEmasOnOther and showOtherRegime)

color activeFastColor =
     (is1m or useProjected1mNow) ? fast1mColor : fast5mColor

plot(displayFast ? laserFastEma : na, "Active Fast EMA", activeFastColor, emaLineWidth)
plot(displaySlow ? laserSlowEma : na, "Active Slow EMA", slow1mColor, emaLineWidth)
plot(displayTrend ? laserTrendEma : na, "Active Trend EMA", trendColor, emaLineWidth)
plot(displayRegime ? laserRegimeEma : na, "Active Regime EMA", regimeColor, emaLineWidth)
plot(is5m and enable5m and show2m200On5m ? ema2m200 : na, "2m 200 EMA on 5m", ema2m200Color, emaLineWidth)

bool showSessionVwapNow = profileEnabled and (is1m ? showSessionVwap1m : is5m ? showSessionVwap5m : showSessionVwapOther)
plot(showSessionVwapNow ? futuresSessionVwap : na, "Futures Session VWAP", sessionVwapColor, vwapLineWidth)
plot(showSessionVwapNow and showVwapSdBands and showVwapSdBand1 ? futuresVwapUpper1 : na, "VWAP +SD1", vwapSdColor1, vwapSdLineWidth)
plot(showSessionVwapNow and showVwapSdBands and showVwapSdBand1 ? futuresVwapLower1 : na, "VWAP -SD1", vwapSdColor1, vwapSdLineWidth)
plot(showSessionVwapNow and showVwapSdBands and showVwapSdBand2 ? futuresVwapUpper2 : na, "VWAP +SD2", vwapSdColor2, vwapSdLineWidth)
plot(showSessionVwapNow and showVwapSdBands and showVwapSdBand2 ? futuresVwapLower2 : na, "VWAP -SD2", vwapSdColor2, vwapSdLineWidth)
plot(showSessionVwapNow and showVwapSdBands and showVwapSdBand3 ? futuresVwapUpper3 : na, "VWAP +SD3", vwapSdColor3, vwapSdLineWidth)
plot(showSessionVwapNow and showVwapSdBands and showVwapSdBand3 ? futuresVwapLower3 : na, "VWAP -SD3", vwapSdColor3, vwapSdLineWidth)
bool showRthVwapNow = showRthVwap and inRthVwap and profileEnabled and (is1m ? showRthVwap1m : is5m ? showRthVwap5m : false)
plot(showRthVwapNow ? rthVwap : na, "NYSE RTH VWAP", rthVwapColor, vwapLineWidth)

//=============================================================================
// 13 — INTERNAL RSI
//=============================================================================
float rsi = ta.rsi(close, rsiLength)
float rsiROC = rsi - rsi[1]
float rsiAccel = rsiROC - rsiROC[1]
float rsiSlope = ta.linreg(rsi, rsiComparisonBars, 0) - ta.linreg(rsi, rsiComparisonBars, 1)
bool rsiSharpDown = rsiROC <= -sharpRsiROC
bool rsiSharpUp = rsiROC >= sharpRsiROC
bool rsiAbove50 = rsi > 50
bool rsiBelow50 = rsi < 50

// Regular pivot divergence.
// Bullish: price makes LL while RSI makes HL.
// Bearish: price makes HH while RSI makes LH.
bool rsiPlFound = not na(ta.pivotlow(rsi, rsiDivLeft, rsiDivRight))
bool rsiPhFound = not na(ta.pivothigh(rsi, rsiDivLeft, rsiDivRight))
float rsiLBR = rsi[rsiDivRight]
float priceLowLBR = low[rsiDivRight]
float priceHighLBR = high[rsiDivRight]

float prevRsiLowPivot = ta.valuewhen(rsiPlFound, rsiLBR, 1)
float prevRsiHighPivot = ta.valuewhen(rsiPhFound, rsiLBR, 1)
float prevPriceLowPivot = ta.valuewhen(rsiPlFound, priceLowLBR, 1)
float prevPriceHighPivot = ta.valuewhen(rsiPhFound, priceHighLBR, 1)

// Regular pivot divergence only.
bool rsiBullDiv = useRsiDivergence and rsiPlFound and rsiLBR > prevRsiLowPivot and priceLowLBR < prevPriceLowPivot
bool rsiBearDiv = useRsiDivergence and rsiPhFound and rsiLBR < prevRsiHighPivot and priceHighLBR > prevPriceHighPivot

// Divergence quality measurements. Price overshoot is emphasized in the cockpit;
// raw RSI pivot separation is retained for explanation but is not given an extra
// quality bonus by itself.
float divAtrSeries = ta.atr(atrLength)
float pivotAtr = divAtrSeries[rsiDivRight]
float bullDivRsiGapNow = rsiBullDiv ? rsiLBR - prevRsiLowPivot : na
float bearDivRsiGapNow = rsiBearDiv ? prevRsiHighPivot - rsiLBR : na
float bullDivPriceAtrNow = rsiBullDiv and not na(pivotAtr) and pivotAtr > 0 ? (prevPriceLowPivot - priceLowLBR) / pivotAtr : na
float bearDivPriceAtrNow = rsiBearDiv and not na(pivotAtr) and pivotAtr > 0 ? (priceHighLBR - prevPriceHighPivot) / pivotAtr : na

var float lastBullDivRsiGap = na
var float lastBearDivRsiGap = na
var float lastBullDivPriceAtr = na
var float lastBearDivPriceAtr = na
var float lastBullDivPivotRsi = na
var float lastBearDivPivotRsi = na

if rsiBullDiv
    lastBullDivRsiGap := bullDivRsiGapNow
    lastBullDivPriceAtr := bullDivPriceAtrNow
    lastBullDivPivotRsi := rsiLBR

if rsiBearDiv
    lastBearDivRsiGap := bearDivRsiGapNow
    lastBearDivPriceAtr := bearDivPriceAtrNow
    lastBearDivPivotRsi := rsiLBR

int barsSinceRsiBullDiv = ta.barssince(rsiBullDiv)
int barsSinceRsiBearDiv = ta.barssince(rsiBearDiv)
bool recentRsiBullDiv = not na(barsSinceRsiBullDiv) and barsSinceRsiBullDiv <= rsiDivMemoryBars
bool recentRsiBearDiv = not na(barsSinceRsiBearDiv) and barsSinceRsiBearDiv <= rsiDivMemoryBars
bool bullDivStrongPrice = recentRsiBullDiv and not na(lastBullDivPriceAtr) and lastBullDivPriceAtr >= divStrongPriceATR
bool bearDivStrongPrice = recentRsiBearDiv and not na(lastBearDivPriceAtr) and lastBearDivPriceAtr >= divStrongPriceATR
bool bullDivInZone = recentRsiBullDiv and not na(lastBullDivPivotRsi) and lastBullDivPivotRsi <= bullDivZone
bool bearDivInZone = recentRsiBearDiv and not na(lastBearDivPivotRsi) and lastBearDivPivotRsi >= bearDivZone

// Confirmation markers are optional and are placed on the bar where divergence
// becomes knowable, not on the earlier pivot bar.
if showRsiDivMarkers and rsiBullDiv
    string bullDivTooltip = "Bullish RSI divergence confirmed.\nPivot was " + str.tostring(rsiDivRight) + " bars earlier.\nRSI pivot separation: " + str.tostring(bullDivRsiGapNow, "#.1") + "\nPrice overshoot: " + str.tostring(bullDivPriceAtrNow, "#.2") + " ATR"
    label.new(bar_index, low, "B DIV", yloc = yloc.belowbar, style = label.style_label_up, color = color.new(color.green, 45), textcolor = color.white, size = size.tiny, tooltip = bullDivTooltip)

if showRsiDivMarkers and rsiBearDiv
    string bearDivTooltip = "Bearish RSI divergence confirmed.\nPivot was " + str.tostring(rsiDivRight) + " bars earlier.\nRSI pivot separation: " + str.tostring(bearDivRsiGapNow, "#.1") + "\nPrice overshoot: " + str.tostring(bearDivPriceAtrNow, "#.2") + " ATR"
    label.new(bar_index, high, "S DIV", yloc = yloc.abovebar, style = label.style_label_down, color = color.new(color.red, 45), textcolor = color.white, size = size.tiny, tooltip = bearDivTooltip)

//=============================================================================
// 14 — INTERNAL SQZMOM — corrected BB multiplier
//=============================================================================
float bbBasis = ta.sma(close, bbLength)
float bbDeviation = bbMult * ta.stdev(close, bbLength)
float upperBB = bbBasis + bbDeviation
float lowerBB = bbBasis - bbDeviation
float kcBasis = ta.sma(close, kcLength)
float kcRange = sqzUseTrueRange ? ta.tr(true) : high - low
float kcRangeMA = ta.sma(kcRange, kcLength)
float upperKC = kcBasis + kcRangeMA * kcMult
float lowerKC = kcBasis - kcRangeMA * kcMult
bool squeezeOn = lowerBB > lowerKC and upperBB < upperKC
bool squeezeOff = lowerBB < lowerKC and upperBB > upperKC
bool squeezeFired = squeezeOn[1] and squeezeOff
float rangeMiddle = math.avg(ta.highest(high, kcLength), ta.lowest(low, kcLength))
float momentumBasis = math.avg(rangeMiddle, ta.sma(close, kcLength))
float sqzMomentum = ta.linreg(close - momentumBasis, kcLength, 0)
float sqzROC = sqzMomentum - sqzMomentum[1]
float sqzAccel = sqzROC - sqzROC[1]
bool sqzBullAccel = sqzMomentum > 0 and sqzROC > 0
bool sqzBullDecel = sqzMomentum > 0 and sqzROC < 0
bool sqzBearAccel = sqzMomentum < 0 and sqzROC < 0
bool sqzBearDecel = sqzMomentum < 0 and sqzROC > 0
bool sqzBullReAccel = sqzBullAccel and sqzAccel > 0
bool sqzBearReAccel = sqzBearAccel and sqzAccel < 0
bool bullZeroCross = ta.crossover(sqzMomentum, 0)
bool bearZeroCross = ta.crossunder(sqzMomentum, 0)
var int squeezeBars = 0
var int positiveMomentumBars = 0
var int negativeMomentumBars = 0
if squeezeOn
    squeezeBars += 1
else
    squeezeBars := 0
if sqzMomentum > 0
    positiveMomentumBars += 1
    negativeMomentumBars := 0
else if sqzMomentum < 0
    negativeMomentumBars += 1
    positiveMomentumBars := 0
else
    positiveMomentumBars := 0
    negativeMomentumBars := 0
int barsSinceRelease = ta.barssince(squeezeFired)
bool recentRelease = not na(barsSinceRelease) and barsSinceRelease <= recentReleaseBars
bool prolongedCompression = squeezeOn and squeezeBars >= pressureSqueezeBars
bool matureBearMomentum = negativeMomentumBars[1] >= matureMomentumBars
bool matureBullMomentum = positiveMomentumBars[1] >= matureMomentumBars
// Small text-dot drawing object instead of a circle label.
// "Micro" is deliberately smaller than Pine's label.style_circle at size.tiny.
if showSqueezeFires and squeezeFired
    label.new(
         bar_index,
         low,
         squeezeFireSymbol,
         yloc = yloc.belowbar,
         style = label.style_none,
         color = color.new(color.white, 100),
         textcolor = color.white,
         size = squeezeFireTextSize)

//=============================================================================
// 15 — VOLUME / ABSORPTION
//=============================================================================
float avgVolume = ta.sma(volume, volumeAvgLength)
float relativeVolume = avgVolume > 0 ? volume / avgVolume : 0
float volumeATR = ta.atr(volumeATRLength)
float candleRange = high - low
float candleBody = math.abs(close - open)
float bodyPct = candleRange > 0 ? candleBody / candleRange * 100 : 0
float upperWick = high - math.max(open, close)
float lowerWick = math.min(open, close) - low
float upperWickPct = candleRange > 0 ? upperWick / candleRange * 100 : 0
float lowerWickPct = candleRange > 0 ? lowerWick / candleRange * 100 : 0
float candleMid = (high + low) / 2
bool volumeSignalAllowed = not volumeRequireClose or barstate.isconfirmed
bool volumeBullMove = showVolumeMoves and volumeSignalAllowed and close > open and relativeVolume >= moveVolumeMult and candleRange >= volumeATR * moveRangeATR and bodyPct >= moveBodyPct and close >= high - candleRange * moveClosePct / 100
bool volumeBearMove = showVolumeMoves and volumeSignalAllowed and close < open and relativeVolume >= moveVolumeMult and candleRange >= volumeATR * moveRangeATR and bodyPct >= moveBodyPct and close <= low + candleRange * moveClosePct / 100
bool sellingAbsorbed = showAbsorption and volumeSignalAllowed and relativeVolume >= absVolumeMult and bodyPct <= absMaxBody and lowerWickPct >= absMinWick and lowerWick >= upperWick * absWickDominance and (not absRequireMidpoint or close >= candleMid)
bool buyingAbsorbed = showAbsorption and volumeSignalAllowed and relativeVolume >= absVolumeMult and bodyPct <= absMaxBody and upperWickPct >= absMinWick and upperWick >= lowerWick * absWickDominance and (not absRequireMidpoint or close <= candleMid)
bool finalBullMove = volumeBullMove and not sellingAbsorbed and not buyingAbsorbed
bool finalBearMove = volumeBearMove and not sellingAbsorbed and not buyingAbsorbed
bool volumeCandleSignal = finalBullMove or finalBearMove or sellingAbsorbed or buyingAbsorbed
color signalBody = na
color signalWick = na
color signalBorder = na
if sellingAbsorbed
    signalBody := color.new(bullAbsorbColor, 100)
    signalWick := bullAbsorbColor
    signalBorder := bullAbsorbColor
else if buyingAbsorbed
    signalBody := color.new(bearAbsorbColor, 100)
    signalWick := bearAbsorbColor
    signalBorder := bearAbsorbColor
else if finalBullMove
    signalBody := bullMoveColor
    signalWick := bullMoveColor
    signalBorder := bullMoveColor
else if finalBearMove
    signalBody := bearMoveColor
    signalWick := bearMoveColor
    signalBorder := bearMoveColor
barcolor(volumeCandleSignal ? color.new(color.white, 100) : na)
plotcandle(volumeCandleSignal ? open : na, volumeCandleSignal ? high : na, volumeCandleSignal ? low : na, volumeCandleSignal ? close : na, title = "Volume Signal Candles", color = signalBody, wickcolor = signalWick, bordercolor = signalBorder)

//=============================================================================
// 16 — PREVIOUS ASIA / LONDON / NYSE SESSION H/L
//=============================================================================
bool inAsia = not na(time(timeframe.period, asiaSession, sessionTimezone))
bool asiaStart = inAsia and (bar_index == 0 or not inAsia[1])
bool asiaEnd = not inAsia and bar_index > 0 and inAsia[1]
var float asiaCurH = na
var float asiaCurL = na
var float prevAsiaH = na
var float prevAsiaL = na
if asiaStart
    asiaCurH := high
    asiaCurL := low
else if inAsia
    asiaCurH := na(asiaCurH) ? high : math.max(asiaCurH, high)
    asiaCurL := na(asiaCurL) ? low : math.min(asiaCurL, low)
if asiaEnd
    prevAsiaH := asiaCurH
    prevAsiaL := asiaCurL

bool inLondon = not na(time(timeframe.period, londonSession, sessionTimezone))
bool londonStart = inLondon and (bar_index == 0 or not inLondon[1])
bool londonEnd = not inLondon and bar_index > 0 and inLondon[1]
var float londonCurH = na
var float londonCurL = na
var float prevLondonH = na
var float prevLondonL = na
if londonStart
    londonCurH := high
    londonCurL := low
else if inLondon
    londonCurH := na(londonCurH) ? high : math.max(londonCurH, high)
    londonCurL := na(londonCurL) ? low : math.min(londonCurL, low)
if londonEnd
    prevLondonH := londonCurH
    prevLondonL := londonCurL

bool inNyse = not na(time(timeframe.period, nyseSession, sessionTimezone))
bool nyseStart = inNyse and (bar_index == 0 or not inNyse[1])
bool nyseEnd = not inNyse and bar_index > 0 and inNyse[1]
var float nyseCurH = na
var float nyseCurL = na
var float prevNyseH = na
var float prevNyseL = na
if nyseStart
    nyseCurH := high
    nyseCurL := low
else if inNyse
    nyseCurH := na(nyseCurH) ? high : math.max(nyseCurH, high)
    nyseCurL := na(nyseCurL) ? low : math.min(nyseCurL, low)
if nyseEnd
    prevNyseH := nyseCurH
    prevNyseL := nyseCurL

float pwh = request.security(syminfo.tickerid, "W", high[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
float pwl = request.security(syminfo.tickerid, "W", low[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

//=============================================================================
// 17 — MECHANICAL DEVELOPING GLOBEX VP + PREVIOUS GLOBEX H/L
//=============================================================================
[ltTime, ltHigh, ltLow, ltVolume] = request.security_lower_tf(syminfo.tickerid, vpLowerTF, [time, high, low, volume], ignore_invalid_timeframe = true, calc_bars_count = 3000)
int ltCount = array.size(ltTime)
bool haveIntrabarData = ltCount > 0
var map<int, float> globexMap = map.new<int, float>()
var int globexMinKey = na
var int globexMaxKey = na
var int currentGlobexKey = na
var bool currentGlobexClean = false
var float globexDevH = na
var float globexDevL = na
var float previousGlobexHigh = na
var float previousGlobexLow = na
var float globexPOC = na
var float globexVAH = na
var float globexVAL = na

f_globexKey(int ts) =>
    int h = hour(ts, sessionTimezone)
    int y = year(ts, sessionTimezone)
    int m = month(ts, sessionTimezone)
    int d = dayofmonth(ts, sessionTimezone)
    int addDay = h >= 17 ? 1 : 0
    timestamp(sessionTimezone, y, m, d + addDay, 12, 0)

f_profile(map<int, float> profile, int minKey, int maxKey, float binSize, float vaPct) =>
    float outPOC = na
    float outVAH = na
    float outVAL = na
    if profile.size() > 0 and not na(minKey) and not na(maxKey)
        float totalVol = 0.0
        float maxVol = -1.0
        int pocKey = minKey
        for k = minKey to maxKey
            float v = profile.contains(k) ? profile.get(k) : 0.0
            totalVol += v
            if v > maxVol
                maxVol := v
                pocKey := k
        float target = totalVol * vaPct / 100
        int vaLo = pocKey
        int vaHi = pocKey
        float acc = profile.contains(pocKey) ? profile.get(pocKey) : 0.0
        while acc < target and (vaLo > minKey or vaHi < maxKey)
            float below = vaLo > minKey ? (profile.contains(vaLo - 1) ? profile.get(vaLo - 1) : 0.0) : -1.0
            float above = vaHi < maxKey ? (profile.contains(vaHi + 1) ? profile.get(vaHi + 1) : 0.0) : -1.0
            if above >= below and vaHi < maxKey
                vaHi += 1
                acc += profile.contains(vaHi) ? profile.get(vaHi) : 0.0
            else if vaLo > minKey
                vaLo -= 1
                acc += profile.contains(vaLo) ? profile.get(vaLo) : 0.0
            else
                vaHi += 1
                acc += profile.contains(vaHi) ? profile.get(vaHi) : 0.0
        outPOC := (pocKey + 0.5) * binSize
        outVAL := vaLo * binSize
        outVAH := (vaHi + 1.0) * binSize
    [outPOC, outVAH, outVAL]

if barstate.isconfirmed and haveIntrabarData
    for i = 0 to ltCount - 1
        int t = array.get(ltTime, i)
        float hi = array.get(ltHigh, i)
        float lo = array.get(ltLow, i)
        float vol = array.get(ltVolume, i)
        int h = hour(t, sessionTimezone)
        bool insideGlobex = h >= 17 or h < 16
        if insideGlobex
            int thisKey = f_globexKey(t)
            if na(currentGlobexKey)
                currentGlobexKey := thisKey
                currentGlobexClean := h >= 17
            else if thisKey != currentGlobexKey
                if currentGlobexClean
                    previousGlobexHigh := globexDevH
                    previousGlobexLow := globexDevL
                globexMap.clear()
                globexMinKey := na
                globexMaxKey := na
                globexDevH := na
                globexDevL := na
                currentGlobexKey := thisKey
                currentGlobexClean := true
            globexDevH := na(globexDevH) ? hi : math.max(globexDevH, hi)
            globexDevL := na(globexDevL) ? lo : math.min(globexDevL, lo)
            int lowKey = int(math.floor(lo / vpPrimaryPoints))
            int highKey = int(math.floor(hi / vpPrimaryPoints))
            globexMinKey := na(globexMinKey) ? lowKey : math.min(globexMinKey, lowKey)
            globexMaxKey := na(globexMaxKey) ? highKey : math.max(globexMaxKey, highKey)
            float rng = hi - lo
            if rng <= 0
                float old = globexMap.contains(lowKey) ? globexMap.get(lowKey) : 0.0
                globexMap.put(lowKey, old + vol)
            else
                for k = lowKey to highKey
                    float binLo = k * vpPrimaryPoints
                    float binHi = binLo + vpPrimaryPoints
                    float overlap = math.max(math.min(hi, binHi) - math.max(lo, binLo), 0)
                    if overlap > 0
                        float alloc = vol * overlap / rng
                        float old = globexMap.contains(k) ? globexMap.get(k) : 0.0
                        globexMap.put(k, old + alloc)

[gPOC, gVAH, gVAL] = f_profile(globexMap, globexMinKey, globexMaxKey, vpPrimaryPoints, vpValueAreaPct)
if currentGlobexClean and not na(gPOC)
    globexPOC := gPOC
    globexVAH := gVAH
    globexVAL := gVAL

//=============================================================================
// 18 — RIGHT-SIDE ACTIVE PROFILE
// For RTH / Visible / Fixed modes, this exact profile supplies LASER live VAH/POC/VAL.
// Non-Globex modes suppress historical FIREs to avoid non-causal backtest claims.
// The histogram shows distribution shape only; POC is shown once as the thin POC line.
//=============================================================================
int visibleLeftTime = na(chart.left_visible_bar_time) ? time : chart.left_visible_bar_time
int visibleRightTime = na(chart.right_visible_bar_time) ? time : chart.right_visible_bar_time
int barDurationMS = math.max(1, int(timeframe.in_seconds() * 1000))
bool newTradingDay = ta.change(time_tradingday) != 0
int currentSessionBars = nz(ta.barssince(newTradingDay), 0) + 1
int visibleRangeBars = math.max(1, math.round((visibleRightTime - visibleLeftTime) / barDurationMS) + 1)

bool vpInRth = not na(time(timeframe.period, vpRthSession, sessionTimezone))
bool vpRthOpen = vpInRth and (bar_index == 0 or not vpInRth[1])
var int vpRthStart = na
var int vpRthEnd = na
if vpRthOpen
    vpRthStart := bar_index
    vpRthEnd := bar_index
else if vpInRth
    if na(vpRthStart)
        vpRthStart := bar_index
    vpRthEnd := bar_index

int requestedBars = vpMode == "Visible Range" ? visibleRangeBars : vpMode == "Fixed Lookback" ? vpFixedLookback : currentSessionBars
int contiguousBars = math.max(1, math.min(requestedBars, math.min(3000, bar_index + 1)))
int vpNewestOffset = 0
int vpOldestOffset = contiguousBars - 1
int vpBarCount = contiguousBars
bool visualVpValid = true
if vpMode == "NYSE RTH Snapshot"
    visualVpValid := not na(vpRthStart) and not na(vpRthEnd)
    if visualVpValid
        vpNewestOffset := bar_index - vpRthEnd
        vpOldestOffset := bar_index - vpRthStart
        vpBarCount := vpRthEnd - vpRthStart + 1
        if vpNewestOffset < 0 or vpOldestOffset < vpNewestOffset or vpOldestOffset > 4999
            visualVpValid := false

var array<line> vpRowLines = array.new_line()
var array<float> vpVolumes = array.new_float()
var line vpPocLine = na
var line vpVahLine = na
var line vpValLine = na
var float liveVisualPOC = na
var float liveVisualVAH = na
var float liveVisualVAL = na

if barstate.isfirst
    for i = 0 to vpRows - 1
        array.push(vpRowLines, line.new(bar_index, close, bar_index, close, width = vpThickness))
        array.push(vpVolumes, 0.0)
    vpPocLine := line.new(time, close, time, close, xloc = xloc.bar_time)
    vpVahLine := line.new(time, close, time, close, xloc = xloc.bar_time)
    vpValLine := line.new(time, close, time, close, xloc = xloc.bar_time)

if barstate.islast and visualVpValid and array.size(vpVolumes) == vpRows
    array.fill(vpVolumes, 0.0)
    float vpHighest = high[vpNewestOffset]
    float vpLowest = low[vpNewestOffset]
    for i = vpNewestOffset to vpOldestOffset
        vpHighest := math.max(vpHighest, high[i])
        vpLowest := math.min(vpLowest, low[i])
    float vpInterval = math.max((vpHighest - vpLowest) / math.max(vpRows - 1, 1), syminfo.mintick)
    for i = vpNewestOffset to vpOldestOffset
        for j = 0 to vpRows - 1
            float level = vpLowest + vpInterval * j
            if level >= low[i] and level < high[i]
                array.set(vpVolumes, j, array.get(vpVolumes, j) + volume[i])
    float maxVol = array.max(vpVolumes)
    int maxIdx = array.indexof(vpVolumes, maxVol)
    float totalVol = array.sum(vpVolumes)
    float targetVA = totalVol * vpValueAreaPct / 100
    int vaDn = maxIdx
    int vaUp = maxIdx
    float vaSum = maxVol
    while vaSum < targetVA
        float upVol = vaUp < vpRows - 1 ? array.get(vpVolumes, vaUp + 1) : 0
        float dnVol = vaDn > 0 ? array.get(vpVolumes, vaDn - 1) : 0
        if upVol == 0 and dnVol == 0
            break
        if upVol >= dnVol
            vaUp += 1
            vaSum += upVol
        else
            vaDn -= 1
            vaSum += dnVol
    liveVisualPOC := vpLowest + vpInterval * maxIdx
    liveVisualVAH := vpLowest + vpInterval * vaUp
    liveVisualVAL := vpLowest + vpInterval * vaDn
    int x2 = bar_index + vpRightOffset
    float divisor = maxVol / math.max(vpBarCount, 1) / (vpWidth / 100.0)
    if showRightProfile
        for i = 0 to vpRows - 1
            float rowVol = array.get(vpVolumes, i)
            int scaled = divisor > 0 ? math.round(rowVol / divisor) : 0
            float y = vpLowest + vpInterval * i
            line row = array.get(vpRowLines, i)
            line.set_xy1(row, x2 - scaled, y)
            line.set_xy2(row, x2, y)
            line.set_width(row, vpThickness)
            bool inVA = y >= liveVisualVAL and y <= liveVisualVAH
            line.set_color(row, inVA ? vpValueColor : vpOutsideColor)
    else
        for i = 0 to vpRows - 1
            line.set_color(array.get(vpRowLines, i), color.new(vpOutsideColor, 100))

float activePOC = vpMode == "Globex Developing" ? globexPOC : liveVisualPOC
float activeVAH = vpMode == "Globex Developing" ? globexVAH : liveVisualVAH
float activeVAL = vpMode == "Globex Developing" ? globexVAL : liveVisualVAL
bool liveOnlyVpMode = vpMode != "Globex Developing"
string vpState = vpMode == "Globex Developing" ? "GLOBEX DEV" : vpMode == "NYSE RTH Snapshot" ? "RTH SNAP" : vpMode == "Visible Range" ? "VISIBLE" : "FIXED"

f_keyGeometry() =>
    int rightT = keyLevelAnchorMode == "Visible Chart" ? visibleRightTime : time + keyLabelOffset * barDurationMS
    int leftT = keyLevelAnchorMode == "Visible Chart" ? visibleLeftTime : (na(time[keyLevelBarsBack]) ? time : time[keyLevelBarsBack])
    int lineEndT = rightT - keyLabelGapBars * barDurationMS
    if lineEndT <= leftT
        lineEndT := rightT
    [leftT, lineEndT, rightT]

[levelLeftTime, levelEndTime, levelLabelTime] = f_keyGeometry()

if barstate.islast
    if showActiveVpLines and not na(activePOC) and not na(activeVAH) and not na(activeVAL)
        int vpDisplayEndTime = showVpLevelLabels ? levelEndTime : levelLabelTime
        line.set_xy1(vpPocLine, levelLeftTime, activePOC)
        line.set_xy2(vpPocLine, vpDisplayEndTime, activePOC)
        line.set_color(vpPocLine, vpPocColor)
        line.set_width(vpPocLine, vpLevelLineWidth)

        line.set_xy1(vpVahLine, levelLeftTime, activeVAH)
        line.set_xy2(vpVahLine, vpDisplayEndTime, activeVAH)
        line.set_color(vpVahLine, vpLineColor)
        line.set_width(vpVahLine, vpLevelLineWidth)

        line.set_xy1(vpValLine, levelLeftTime, activeVAL)
        line.set_xy2(vpValLine, vpDisplayEndTime, activeVAL)
        line.set_color(vpValLine, vpLineColor)
        line.set_width(vpValLine, vpLevelLineWidth)
    else
        line.set_color(vpPocLine, color.new(vpPocColor, 100))
        line.set_color(vpVahLine, color.new(vpLineColor, 100))
        line.set_color(vpValLine, color.new(vpLineColor, 100))

//=============================================================================
// 18B — CURRENT KEY LEVEL DISPLAY
// Current-only drawing objects: no progressive/stair-step history.
// Visible Chart mode anchors the levels to the chart window itself.
// Lines stop before labels so the text is never struck through.
//=============================================================================

var line asiaHighLine = na
var line asiaLowLine = na
var line londonHighLine = na
var line londonLowLine = na
var line nyseHighLine = na
var line nyseLowLine = na
var line globexHighLine = na
var line globexLowLine = na
var line weekHighLine = na
var line weekLowLine = na

var label asiaHighLabel = na
var label asiaLowLabel = na
var label londonHighLabel = na
var label londonLowLabel = na
var label nyseHighLabel = na
var label nyseLowLabel = na
var label globexHighLabel = na
var label globexLowLabel = na
var label weekHighLabel = na
var label weekLowLabel = na
var label vahLabel = na
var label pocLabel = na
var label valLabel = na

f_updateLevelLine(line existingLine, bool showLabel, bool showLevel, float level, color levelColor) =>
    line result = existingLine
    int displayEndTime = showLabel ? levelEndTime : levelLabelTime
    if showLevel and not na(level)
        if na(result)
            result := line.new(
                 levelLeftTime, level,
                 displayEndTime, level,
                 xloc = xloc.bar_time,
                 extend = extend.none,
                 color = levelColor,
                 width = keyLevelLineWidth)
        else
            line.set_xy1(result, levelLeftTime, level)
            line.set_xy2(result, displayEndTime, level)
            line.set_color(result, levelColor)
            line.set_width(result, keyLevelLineWidth)
    else
        if not na(result)
            line.delete(result)
        result := na
    result

f_updateLevelLabel(label existingLabel, bool showLabel, bool showLevel, float level, string levelName, color levelColor) =>
    label result = existingLabel
    if showLabel and showLevel and not na(level)
        string txt = showKeyLevelPrices ? levelName + "  " + str.tostring(level, format.mintick) : levelName
        if na(result)
            result := label.new(
                 levelLabelTime,
                 level,
                 txt,
                 xloc = xloc.bar_time,
                 yloc = yloc.price,
                 style = label.style_none,
                 color = color.new(color.black, 100),
                 textcolor = levelColor,
                 size = keyLabelTextSize)
        else
            label.set_xy(result, levelLabelTime, level)
            label.set_text(result, txt)
            label.set_textcolor(result, levelColor)
            label.set_color(result, color.new(color.black, 100))
            label.set_style(result, label.style_none)
            label.set_size(result, keyLabelTextSize)
    else
        if not na(result)
            label.delete(result)
        result := na
    result

if barstate.islast
    asiaHighLine := f_updateLevelLine(asiaHighLine, showSessionLevelLabels, showPrevAsiaHL, prevAsiaH, asiaColor)
    asiaLowLine := f_updateLevelLine(asiaLowLine, showSessionLevelLabels, showPrevAsiaHL, prevAsiaL, asiaColor)
    londonHighLine := f_updateLevelLine(londonHighLine, showSessionLevelLabels, showPrevLondonHL, prevLondonH, londonColor)
    londonLowLine := f_updateLevelLine(londonLowLine, showSessionLevelLabels, showPrevLondonHL, prevLondonL, londonColor)
    nyseHighLine := f_updateLevelLine(nyseHighLine, showSessionLevelLabels, showPrevNyseHL, prevNyseH, nyseColor)
    nyseLowLine := f_updateLevelLine(nyseLowLine, showSessionLevelLabels, showPrevNyseHL, prevNyseL, nyseColor)
    globexHighLine := f_updateLevelLine(globexHighLine, showSessionLevelLabels, showPreviousGlobexLines, previousGlobexHigh, globexColor)
    globexLowLine := f_updateLevelLine(globexLowLine, showSessionLevelLabels, showPreviousGlobexLines, previousGlobexLow, globexColor)
    weekHighLine := f_updateLevelLine(weekHighLine, showSessionLevelLabels, showPreviousWeekLines, pwh, weekColor)
    weekLowLine := f_updateLevelLine(weekLowLine, showSessionLevelLabels, showPreviousWeekLines, pwl, weekColor)

    asiaHighLabel := f_updateLevelLabel(asiaHighLabel, showSessionLevelLabels, showPrevAsiaHL, prevAsiaH, "Asia H", asiaColor)
    asiaLowLabel := f_updateLevelLabel(asiaLowLabel, showSessionLevelLabels, showPrevAsiaHL, prevAsiaL, "Asia L", asiaColor)
    londonHighLabel := f_updateLevelLabel(londonHighLabel, showSessionLevelLabels, showPrevLondonHL, prevLondonH, "London H", londonColor)
    londonLowLabel := f_updateLevelLabel(londonLowLabel, showSessionLevelLabels, showPrevLondonHL, prevLondonL, "London L", londonColor)
    nyseHighLabel := f_updateLevelLabel(nyseHighLabel, showSessionLevelLabels, showPrevNyseHL, prevNyseH, "NYSE H", nyseColor)
    nyseLowLabel := f_updateLevelLabel(nyseLowLabel, showSessionLevelLabels, showPrevNyseHL, prevNyseL, "NYSE L", nyseColor)
    globexHighLabel := f_updateLevelLabel(globexHighLabel, showSessionLevelLabels, showPreviousGlobexLines, previousGlobexHigh, "PGH", globexColor)
    globexLowLabel := f_updateLevelLabel(globexLowLabel, showSessionLevelLabels, showPreviousGlobexLines, previousGlobexLow, "PGL", globexColor)
    weekHighLabel := f_updateLevelLabel(weekHighLabel, showSessionLevelLabels, showPreviousWeekLines, pwh, "PWH", weekColor)
    weekLowLabel := f_updateLevelLabel(weekLowLabel, showSessionLevelLabels, showPreviousWeekLines, pwl, "PWL", weekColor)

    vahLabel := f_updateLevelLabel(vahLabel, showVpLevelLabels, showActiveVpLines, activeVAH, "VAH", vpLineColor)
    pocLabel := f_updateLevelLabel(pocLabel, showVpLevelLabels, showActiveVpLines, activePOC, "POC", vpPocColor)
    valLabel := f_updateLevelLabel(valLabel, showVpLevelLabels, showActiveVpLines, activeVAL, "VAL", vpLineColor)

//=============================================================================
// 19 — STRUCTURE / PRICE-MOMENTUM DISAGREEMENT
//=============================================================================
float atr = ta.atr(atrLength)
float priorResistance = ta.highest(high[1], structureLookback)
float priorSupport = ta.lowest(low[1], structureLookback)
float microResistance = ta.highest(high[1], microLookback)
float microSupport = ta.lowest(low[1], microLookback)
bool breakResistance = close > priorResistance
bool breakSupport = close < priorSupport
bool microBullBreak = close > microResistance
bool microBearBreak = close < microSupport
bool sweepHigh = high > priorResistance and close < priorResistance
bool sweepLow = low < priorSupport and close > priorSupport
int barsSinceSweepHigh = ta.barssince(sweepHigh)
int barsSinceSweepLow = ta.barssince(sweepLow)
bool freshSweepHigh = not na(barsSinceSweepHigh) and barsSinceSweepHigh <= 1
bool freshSweepLow = not na(barsSinceSweepLow) and barsSinceSweepLow <= 1
float lastSweepHigh = ta.valuewhen(sweepHigh, high, 0)
float lastSweepLow = ta.valuewhen(sweepLow, low, 0)
bool higherLow = low > low[1] and low[1] >= low[2]
bool lowerHigh = high < high[1] and high[1] <= high[2]

float rawBody = math.max(math.abs(close - open), syminfo.mintick)
float rawLowerWick = math.min(open, close) - low
float rawUpperWick = high - math.max(open, close)
bool bullReject = close > open and rawLowerWick > rawBody
bool bearReject = close < open and rawUpperWick > rawBody
bool bullImpulse = close > open and close > close[1]
bool bearImpulse = close < open and close < close[1]

float priceChange = close - close[rsiComparisonBars - 1]
float priceSlope = ta.linreg(close, rsiComparisonBars, 0) - ta.linreg(close, rsiComparisonBars, 1)
float sqzSlope = ta.linreg(sqzMomentum, rsiComparisonBars, 0) - ta.linreg(sqzMomentum, rsiComparisonBars, 1)
bool bearishDisagreement = priceChange >= 5 and priceSlope > 0 and rsiSlope < 0 and sqzSlope < 0
bool bullishDisagreement = priceChange <= -5 and priceSlope < 0 and rsiSlope > 0 and sqzSlope > 0

//=============================================================================
// 19B — MANUAL STRUCTURE ENGINE
//
// STRUCTURE TLs are major structural references.
// IMPULSE TLs are secondary / tactical references.
//
// Bull Structure:
//      HOLD / RECLAIM = bullish.
//      ACCEPTED BREAK + failed reclaim = bearish.
//
// Bear Structure:
//      HOLD / RECLAIM = bearish.
//      ACCEPTED BREAK + failed reclaim = bullish.
//
// Impulse lines behave similarly but carry less structural authority.
//=============================================================================

float manualTlBand =
     atr * manualTlToleranceATR


//-----------------------------------------------------------------------------
// LINE DEFINITIONS / PROJECTIONS
//-----------------------------------------------------------------------------

bool bullStructDefined =
     enableManualStructure and
     useBullStructureTL and
     bullStructP1 > 0 and
     bullStructP2 > 0 and
     bullStructT1 > 0 and
     bullStructT2 > bullStructT1

bool bearStructDefined =
     enableManualStructure and
     useBearStructureTL and
     bearStructP1 > 0 and
     bearStructP2 > 0 and
     bearStructT1 > 0 and
     bearStructT2 > bearStructT1

bool bullImpulseDefined =
     enableManualStructure and
     useBullImpulseTL and
     bullImpulseP1 > 0 and
     bullImpulseP2 > 0 and
     bullImpulseT1 > 0 and
     bullImpulseT2 > bullImpulseT1

bool bearImpulseDefined =
     enableManualStructure and
     useBearImpulseTL and
     bearImpulseP1 > 0 and
     bearImpulseP2 > 0 and
     bearImpulseT1 > 0 and
     bearImpulseT2 > bearImpulseT1


float bullStructNow =
     bullStructDefined ?
     f_manualTlValue(
          bullStructT1,
          bullStructP1,
          bullStructT2,
          bullStructP2,
          time) :
     na

float bearStructNow =
     bearStructDefined ?
     f_manualTlValue(
          bearStructT1,
          bearStructP1,
          bearStructT2,
          bearStructP2,
          time) :
     na

float bullImpulseTlNow =
     bullImpulseDefined ?
     f_manualTlValue(
          bullImpulseT1,
          bullImpulseP1,
          bullImpulseT2,
          bullImpulseP2,
          time) :
     na

float bearImpulseTlNow =
     bearImpulseDefined ?
     f_manualTlValue(
          bearImpulseT1,
          bearImpulseP1,
          bearImpulseT2,
          bearImpulseP2,
          time) :
     na


// Do NOT let Point 2 affect LASER logic before Point 2 existed.
bool bullStructUsable =
     bullStructDefined and time >= bullStructT2

bool bearStructUsable =
     bearStructDefined and time >= bearStructT2

bool bullImpulseUsable =
     bullImpulseDefined and time >= bullImpulseT2

bool bearImpulseUsable =
     bearImpulseDefined and time >= bearImpulseT2


//-----------------------------------------------------------------------------
// PROXIMITY / TOUCH
//-----------------------------------------------------------------------------

bool nearBullStructTL =
     bullStructUsable and
     low <= bullStructNow + manualTlBand and
     high >= bullStructNow - manualTlBand

bool nearBearStructTL =
     bearStructUsable and
     high >= bearStructNow - manualTlBand and
     low <= bearStructNow + manualTlBand

bool nearBullImpulseTL =
     bullImpulseUsable and
     low <= bullImpulseTlNow + manualTlBand and
     high >= bullImpulseTlNow - manualTlBand

bool nearBearImpulseTL =
     bearImpulseUsable and
     high >= bearImpulseTlNow - manualTlBand and
     low <= bearImpulseTlNow + manualTlBand


//-----------------------------------------------------------------------------
// NORMAL HOLD
//-----------------------------------------------------------------------------

bool bullStructHold =
     nearBullStructTL and
     close >= bullStructNow

bool bearStructHold =
     nearBearStructTL and
     close <= bearStructNow

bool bullImpulseTlHold =
     nearBullImpulseTL and
     close >= bullImpulseTlNow

bool bearImpulseTlHold =
     nearBearImpulseTL and
     close <= bearImpulseTlNow


int barsSinceBullStructHold =
     ta.barssince(bullStructHold)

int barsSinceBearStructHold =
     ta.barssince(bearStructHold)

int barsSinceBullImpulseTlHold =
     ta.barssince(bullImpulseTlHold)

int barsSinceBearImpulseTlHold =
     ta.barssince(bearImpulseTlHold)


bool recentBullStructHold =
     not na(barsSinceBullStructHold) and
     barsSinceBullStructHold <= 2

bool recentBearStructHold =
     not na(barsSinceBearStructHold) and
     barsSinceBearStructHold <= 2

bool recentBullImpulseTlHold =
     not na(barsSinceBullImpulseTlHold) and
     barsSinceBullImpulseTlHold <= 2

bool recentBearImpulseTlHold =
     not na(barsSinceBearImpulseTlHold) and
     barsSinceBearImpulseTlHold <= 2


//-----------------------------------------------------------------------------
// MAJOR STRUCTURE BREAKS
//-----------------------------------------------------------------------------

bool bullStructBelow =
     bullStructUsable and
     close < bullStructNow - manualTlBand

bool bearStructAbove =
     bearStructUsable and
     close > bearStructNow + manualTlBand


bool bullStructBreakEvent =
     bullStructUsable and
     bullStructUsable[1] and
     close < bullStructNow - manualTlBand and
     close[1] >= bullStructNow[1] - manualTlBand[1]

bool bearStructBreakEvent =
     bearStructUsable and
     bearStructUsable[1] and
     close > bearStructNow + manualTlBand and
     close[1] <= bearStructNow[1] + manualTlBand[1]


int barsSinceBullStructBreak =
     ta.barssince(bullStructBreakEvent)

int barsSinceBearStructBreak =
     ta.barssince(bearStructBreakEvent)


// Calculate acceptance counts on EVERY bar.
// Do not place f_countTrue() inside a short-circuited conditional expression.
int bullStructBelowCloseCount =
     f_countTrue(
          bullStructBelow,
          manualBreakAcceptCloses)

int bearStructAboveCloseCount =
     f_countTrue(
          bearStructAbove,
          manualBreakAcceptCloses)


// Bull Structure support has failed only after the required number
// of closes remain below the projected structural trendline.
bool bullStructBreakAcceptedNow =
     not na(barsSinceBullStructBreak) and
     barsSinceBullStructBreak <= manualBreakMemoryBars and
     bullStructBelowCloseCount >= manualBreakAcceptCloses


// Bear Structure resistance has failed only after the required number
// of closes remain above the projected structural trendline.
bool bearStructBreakAcceptedNow =
     not na(barsSinceBearStructBreak) and
     barsSinceBearStructBreak <= manualBreakMemoryBars and
     bearStructAboveCloseCount >= manualBreakAcceptCloses


// Only the FIRST bar where acceptance becomes established is the structural
// change-of-state event.
bool bullStructBreakConfirmed =
     bullStructBreakAcceptedNow and
     not bullStructBreakAcceptedNow[1]

bool bearStructBreakConfirmed =
     bearStructBreakAcceptedNow and
     not bearStructBreakAcceptedNow[1]


//-----------------------------------------------------------------------------
// PERSISTENT BROKEN / FLIPPED STATE
//
// Once accepted, a structural TL stays flipped until price actually reclaims it.
//-----------------------------------------------------------------------------

var bool bullStructBrokenState = false
var bool bearStructBrokenState = false


bool bullStructReclaimEvent =
     bullStructUsable and
     bullStructBrokenState and
     close > bullStructNow + manualTlBand and
     close[1] <= bullStructNow[1] + manualTlBand[1]

bool bearStructReclaimEvent =
     bearStructUsable and
     bearStructBrokenState and
     close < bearStructNow - manualTlBand and
     close[1] >= bearStructNow[1] - manualTlBand[1]


if not bullStructUsable
    bullStructBrokenState := false
else
    if bullStructBreakConfirmed
        bullStructBrokenState := true

    if bullStructReclaimEvent
        bullStructBrokenState := false


if not bearStructUsable
    bearStructBrokenState := false
else
    if bearStructBreakConfirmed
        bearStructBrokenState := true

    if bearStructReclaimEvent
        bearStructBrokenState := false


//-----------------------------------------------------------------------------
// FAILED RECLAIM / RETEST AFTER STRUCTURAL BREAK
//
// Broken bull support retested from below and rejected = SHORT information.
// Broken bear resistance retested from above and held = LONG information.
//-----------------------------------------------------------------------------

bool bullStructFailedReclaim =
     bullStructUsable and
     bullStructBrokenState and
     nearBullStructTL and
     close < bullStructNow

bool bearStructFailedReclaim =
     bearStructUsable and
     bearStructBrokenState and
     nearBearStructTL and
     close > bearStructNow


bool bullStructFailedReclaimEvent =
     bullStructFailedReclaim and
     not bullStructFailedReclaim[1]

bool bearStructFailedReclaimEvent =
     bearStructFailedReclaim and
     not bearStructFailedReclaim[1]


// These are true STRUCTURE FLIPS.
// They are allowed to participate in LASER's reversal/change-of-character logic.
bool manualBearishStructureFlipEvent =
     bullStructBreakConfirmed or
     bullStructFailedReclaimEvent

bool manualBullishStructureFlipEvent =
     bearStructBreakConfirmed or
     bearStructFailedReclaimEvent


// Persistent failure state for continuation invalidation.
bool manualBearishStructureFailure =
     bullStructBrokenState

bool manualBullishStructureFailure =
     bearStructBrokenState


//-----------------------------------------------------------------------------
// IMPULSE TL BREAKS
//
// These are useful information, but an impulse-line break alone is NOT allowed
// to pretend that major structural trend has reversed.
//-----------------------------------------------------------------------------

bool bullImpulseTlBreakEvent =
     bullImpulseUsable and
     bullImpulseUsable[1] and
     close < bullImpulseTlNow - manualTlBand and
     close[1] >= bullImpulseTlNow[1] - manualTlBand[1]

bool bearImpulseTlBreakEvent =
     bearImpulseUsable and
     bearImpulseUsable[1] and
     close > bearImpulseTlNow + manualTlBand and
     close[1] <= bearImpulseTlNow[1] + manualTlBand[1]


int barsSinceBullImpulseTlBreak =
     ta.barssince(bullImpulseTlBreakEvent)

int barsSinceBearImpulseTlBreak =
     ta.barssince(bearImpulseTlBreakEvent)


bool recentBullImpulseTlBreak =
     not na(barsSinceBullImpulseTlBreak) and
     barsSinceBullImpulseTlBreak <= 2

bool recentBearImpulseTlBreak =
     not na(barsSinceBearImpulseTlBreak) and
     barsSinceBearImpulseTlBreak <= 2


//-----------------------------------------------------------------------------
// MANUAL STRUCTURE EVIDENCE
//-----------------------------------------------------------------------------

bool manualStructureLongEvidence =
     enableManualStructure and
     (
          recentBullStructHold or
          bullStructReclaimEvent or
          bearStructBreakConfirmed or
          bearStructFailedReclaim
     )

bool manualStructureShortEvidence =
     enableManualStructure and
     (
          recentBearStructHold or
          bearStructReclaimEvent or
          bullStructBreakConfirmed or
          bullStructFailedReclaim
     )


bool manualImpulseLongEvidence =
     enableManualStructure and
     (
          recentBullImpulseTlHold or
          recentBearImpulseTlBreak
     )

bool manualImpulseShortEvidence =
     enableManualStructure and
     (
          recentBearImpulseTlHold or
          recentBullImpulseTlBreak
     )


//=============================================================================
// MANUAL TRENDLINE VISUALS
//=============================================================================

var line bullStructVisual = na
var line bearStructVisual = na
var line bullImpulseVisual = na
var line bearImpulseVisual = na


if barstate.islast

    // Bull Structure
    if showManualTrendlines and bullStructDefined
        if na(bullStructVisual)
            bullStructVisual :=
                 line.new(
                      bullStructT1,
                      bullStructP1,
                      bullStructT2,
                      bullStructP2,
                      xloc = xloc.bar_time,
                      extend = extend.right,
                      color = bullStructTlColor,
                      style = line.style_solid,
                      width = 1)
        else
            line.set_xy1(
                 bullStructVisual,
                 bullStructT1,
                 bullStructP1)

            line.set_xy2(
                 bullStructVisual,
                 bullStructT2,
                 bullStructP2)
    else
        if not na(bullStructVisual)
            line.delete(bullStructVisual)
            bullStructVisual := na


    // Bear Structure
    if showManualTrendlines and bearStructDefined
        if na(bearStructVisual)
            bearStructVisual :=
                 line.new(
                      bearStructT1,
                      bearStructP1,
                      bearStructT2,
                      bearStructP2,
                      xloc = xloc.bar_time,
                      extend = extend.right,
                      color = bearStructTlColor,
                      style = line.style_solid,
                      width = 1)
        else
            line.set_xy1(
                 bearStructVisual,
                 bearStructT1,
                 bearStructP1)

            line.set_xy2(
                 bearStructVisual,
                 bearStructT2,
                 bearStructP2)
    else
        if not na(bearStructVisual)
            line.delete(bearStructVisual)
            bearStructVisual := na


    // Bull Impulse
    if showManualTrendlines and bullImpulseDefined
        if na(bullImpulseVisual)
            bullImpulseVisual :=
                 line.new(
                      bullImpulseT1,
                      bullImpulseP1,
                      bullImpulseT2,
                      bullImpulseP2,
                      xloc = xloc.bar_time,
                      extend = extend.right,
                      color = bullImpulseTlColor,
                      style = line.style_solid,
                      width = 1)
        else
            line.set_xy1(
                 bullImpulseVisual,
                 bullImpulseT1,
                 bullImpulseP1)

            line.set_xy2(
                 bullImpulseVisual,
                 bullImpulseT2,
                 bullImpulseP2)
    else
        if not na(bullImpulseVisual)
            line.delete(bullImpulseVisual)
            bullImpulseVisual := na


    // Bear Impulse
    if showManualTrendlines and bearImpulseDefined
        if na(bearImpulseVisual)
            bearImpulseVisual :=
                 line.new(
                      bearImpulseT1,
                      bearImpulseP1,
                      bearImpulseT2,
                      bearImpulseP2,
                      xloc = xloc.bar_time,
                      extend = extend.right,
                      color = bearImpulseTlColor,
                      style = line.style_solid,
                      width = 1)
        else
            line.set_xy1(
                 bearImpulseVisual,
                 bearImpulseT1,
                 bearImpulseP1)

            line.set_xy2(
                 bearImpulseVisual,
                 bearImpulseT2,
                 bearImpulseP2)
    else
        if not na(bearImpulseVisual)
            line.delete(bearImpulseVisual)
            bearImpulseVisual := na

//=============================================================================
// 20 — TREND / BALANCE REGIME
//=============================================================================
float close15 = request.security(
     syminfo.tickerid, "15", close,
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off)

float ema15 = request.security(
     syminfo.tickerid, "15", ta.ema(close, 50),
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off)

float close60 = request.security(
     syminfo.tickerid, "60", close,
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off)

float ema60 = request.security(
     syminfo.tickerid, "60", ta.ema(close, 50),
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off)


//=============================================================================
// LOCAL TREND OWNERSHIP
//
// 5m owns the trade thesis.
// 15m is important structural/alignment context.
// 60m is background context only and cannot manufacture the local trend.
//=============================================================================

float trendEmaSlope = laserTrendEma - laserTrendEma[3]

bool bull15Context = close15 > ema15
bool bear15Context = close15 < ema15

bool bull60Context = close60 > ema60
bool bear60Context = close60 < ema60


// The local 5m must actually look bullish/bearish.
// HTF alignment cannot override this.
bool localBullTrendCore =
     laserFastEma > laserTrendEma and
     trendEmaSlope > 0

bool localBearTrendCore =
     laserFastEma < laserTrendEma and
     trendEmaSlope < 0


// Give a healthy pullback a little room below/above the trend EMA
// without instantly declaring the local trend dead.
bool localBullTrend =
     localBullTrendCore and
     close >= laserTrendEma - atr * 0.35

bool localBearTrend =
     localBearTrendCore and
     close <= laserTrendEma + atr * 0.35


// Diagnostic score only.
// Notice that the LOCAL 5m trend supplies the majority of the score.
float bullTrendScore =
     (localBullTrend ? 3.0 : 0.0) +
     (close > futuresSessionVwap ? 1.0 : 0.0) +
     (bull15Context ? 1.0 : 0.0) +
     (bull60Context ? 0.5 : 0.0)

float bearTrendScore =
     (localBearTrend ? 3.0 : 0.0) +
     (close < futuresSessionVwap ? 1.0 : 0.0) +
     (bear15Context ? 1.0 : 0.0) +
     (bear60Context ? 0.5 : 0.0)


// These are now LOCAL 5m states.
bool bullTrend = localBullTrend
bool bearTrend = localBearTrend

// Strong trend gets confirmation from VWAP + 15m.
// 60m still does NOT get veto power.
bool strongBullTrend =
     bullTrend and
     close > futuresSessionVwap and
     bull15Context

bool strongBearTrend =
     bearTrend and
     close < futuresSessionVwap and
     bear15Context

float efficiencyTravel = 0.0
for i = 0 to efficiencyLookback - 2
    efficiencyTravel += math.abs(close[i] - close[i + 1])
float efficiencyNet = math.abs(close - close[efficiencyLookback - 1])
float directionalEfficiency = efficiencyTravel > 0 ? efficiencyNet / efficiencyTravel : 0
float meanClusterHigh = math.max(futuresSessionVwap, math.max(laserFastEma, laserTrendEma))
float meanClusterLow = math.min(futuresSessionVwap, math.min(laserFastEma, laserTrendEma))
bool meanClusterCompressed = meanClusterHigh - meanClusterLow <= atr * 0.75
bool crossedFast = ta.cross(close, laserFastEma)
bool crossedTrend = ta.cross(close, laserTrendEma)
bool crossedVWAP = ta.cross(close, futuresSessionVwap)
int meanCrossCount = 0
for i = 0 to meanCrossLookback - 1
    if crossedFast[i]
        meanCrossCount += 1
    if crossedTrend[i]
        meanCrossCount += 1
    if crossedVWAP[i]
        meanCrossCount += 1
float currentRange = math.max(high - low, syminfo.mintick)
float previousRange = math.max(high[1] - low[1], syminfo.mintick)
float overlapAmount = math.max(0, math.min(high, high[1]) - math.max(low, low[1]))
float overlapRatio = overlapAmount / math.min(currentRange, previousRange)
float averageOverlap = ta.sma(overlapRatio, overlapLookback)
bool validValueArea = not na(activeVAH) and not na(activeVAL) and activeVAH > activeVAL
bool deepInsideValue = validValueArea and close < activeVAH - (activeVAH - activeVAL) * 0.15 and close > activeVAL + (activeVAH - activeVAL) * 0.15
float balanceScore = 0
if directionalEfficiency <= 0.30
    balanceScore += 25
if meanClusterCompressed
    balanceScore += 20
if meanCrossCount >= 5
    balanceScore += 20
else if meanCrossCount >= 3
    balanceScore += 10
if averageOverlap >= 0.45
    balanceScore += 20
else if averageOverlap >= 0.30
    balanceScore += 10
if deepInsideValue
    balanceScore += 10
if relativeVolume <= 0.70
    balanceScore += 5
balanceScore := math.min(balanceScore, 100)
bool hardBalanceRegime = balanceScore >= hardBalanceThreshold and not strongBullTrend and not strongBearTrend
bool balanceRegime = balanceScore >= softBalanceThreshold and not strongBullTrend and not strongBearTrend
string regime = hardBalanceRegime ? "BALANCE" : strongBullTrend ? "STRONG UP" : strongBearTrend ? "STRONG DOWN" : bullTrend ? "TREND UP" : bearTrend ? "TREND DOWN" : balanceRegime ? "BALANCE" : "TRANSITION"

float bullImpulseSize = close - ta.lowest(low, matureImpulseLookback)
float bearImpulseSize = ta.highest(high, matureImpulseLookback) - close
bool matureBullImpulse = bullImpulseSize >= atr * matureImpulseATR
bool matureBearImpulse = bearImpulseSize >= atr * matureImpulseATR
float recentHigh = ta.highest(high[1], 5)
float recentLow = ta.lowest(low[1], 5)
bool bullProgressFailure = high <= recentHigh and (bearReject or buyingAbsorbed or close < open)
bool bearProgressFailure = low >= recentLow and (bullReject or sellingAbsorbed or close > open)
int barsSinceBullProgressFailure = ta.barssince(bullProgressFailure)
int barsSinceBearProgressFailure = ta.barssince(bearProgressFailure)
bool recentBullProgressFailure = not na(barsSinceBullProgressFailure) and barsSinceBullProgressFailure <= failedAuctionMemory
bool recentBearProgressFailure = not na(barsSinceBearProgressFailure) and barsSinceBearProgressFailure <= failedAuctionMemory

//=============================================================================
// 21 — LOCATION STATES / WEIGHTING
//=============================================================================
bool nearVAH = f_near(activeVAH, atr, locationATR)
bool nearVAL = f_near(activeVAL, atr, locationATR)
bool nearPOC = f_near(activePOC, atr, locationATR)
bool nearPGH = usePreviousGlobexHL and f_near(previousGlobexHigh, atr, locationATR)
bool nearPGL = usePreviousGlobexHL and f_near(previousGlobexLow, atr, locationATR)
bool nearPWH = usePreviousWeek and f_near(pwh, atr, locationATR)
bool nearPWL = usePreviousWeek and f_near(pwl, atr, locationATR)
bool nearPAH = usePrevAsiaHL and f_near(prevAsiaH, atr, locationATR)
bool nearPAL = usePrevAsiaHL and f_near(prevAsiaL, atr, locationATR)
bool nearPLH = usePrevLondonHL and f_near(prevLondonH, atr, locationATR)
bool nearPLL = usePrevLondonHL and f_near(prevLondonL, atr, locationATR)
bool nearPNH = usePrevNyseHL and f_near(prevNyseH, atr, locationATR)
bool nearPNL = usePrevNyseHL and f_near(prevNyseL, atr, locationATR)
float dynamicAnchorTolerance = atr * locationATR

// Dynamic anchor proximity includes BOTH close proximity and wick interaction.
// This is important because a 5m candle may react violently from the 1m200/VWAP
// and close well away from the actual level.
bool nearVWAP =
     not na(futuresSessionVwap) and
     (
         math.abs(close - futuresSessionVwap) <= dynamicAnchorTolerance or
         (low <= futuresSessionVwap + dynamicAnchorTolerance and
          high >= futuresSessionVwap - dynamicAnchorTolerance)
     )

bool near1m200 =
     not na(ema1mRegimeHtf) and
     (
         math.abs(close - ema1mRegimeHtf) <= dynamicAnchorTolerance or
         (low <= ema1mRegimeHtf + dynamicAnchorTolerance and
          high >= ema1mRegimeHtf - dynamicAnchorTolerance)
     )

bool near2m200 =
     not na(ema2m200) and
     (
         math.abs(close - ema2m200) <= dynamicAnchorTolerance or
         (low <= ema2m200 + dynamicAnchorTolerance and
          high >= ema2m200 - dynamicAnchorTolerance)
     )

bool nearStructureHigh = f_near(priorResistance, atr, locationATR)
bool nearStructureLow = f_near(priorSupport, atr, locationATR)


//=============================================================================
// MANUAL STRUCTURE LOCATION OWNERSHIP
//
// An intact Bull Structure TL is support.
// A BROKEN Bull Structure TL becomes resistance.
//
// An intact Bear Structure TL is resistance.
// A BROKEN Bear Structure TL becomes support.
//=============================================================================

bool manualLongStructuralLocation =
     (
          nearBullStructTL and
          not bullStructBrokenState
     ) or
     (
          nearBearStructTL and
          bearStructBrokenState
     )

bool manualShortStructuralLocation =
     (
          nearBearStructTL and
          not bearStructBrokenState
     ) or
     (
          nearBullStructTL and
          bullStructBrokenState
     )


bool manualLongImpulseLocation =
     (
          nearBullImpulseTL and
          not recentBullImpulseTlBreak
     ) or
     (
          nearBearImpulseTL and
          recentBearImpulseTlBreak
     )

bool manualShortImpulseLocation =
     (
          nearBearImpulseTL and
          not recentBearImpulseTlBreak
     ) or
     (
          nearBullImpulseTL and
          recentBullImpulseTlBreak
     )


// Independent structural stack.
// Manual TL + one of LASER's other meaningful anchors deserves extra weight.
bool nearIndependentMajorAnchor =
     nearVWAP or
     near1m200 or
     nearVAH or
     nearVAL or
     nearPOC or
     nearPGH or
     nearPGL or
     nearPWH or
     nearPWL or
     nearPNH or
     nearPNL or
     nearPLH or
     nearPLL or
     nearPAH or
     nearPAL

bool manualLongStacked =
     (
          manualLongStructuralLocation or
          manualLongImpulseLocation
     ) and
     nearIndependentMajorAnchor

bool manualShortStacked =
     (
          manualShortStructuralLocation or
          manualShortImpulseLocation
     ) and
     nearIndependentMajorAnchor

float supportLocation = 0
float resistanceLocation = 0
string supportWhy = ""
string resistanceWhy = ""

if nearVAH
    if close >= activeVAH
        supportLocation += 5
        supportWhy += "VAH; "
    if close <= activeVAH
        resistanceLocation += 5
        resistanceWhy += "VAH; "
if nearVAL
    if close >= activeVAL
        supportLocation += 5
        supportWhy += "VAL; "
    if close <= activeVAL
        resistanceLocation += 5
        resistanceWhy += "VAL; "
if nearPOC
    if close >= activePOC
        supportLocation += 4
        supportWhy += "POC; "
    if close <= activePOC
        resistanceLocation += 4
        resistanceWhy += "POC; "

// Globex/week retain higher weighting.
if nearPGH
    if close >= previousGlobexHigh
        supportLocation += 4.5
        supportWhy += "PGH; "
    if close <= previousGlobexHigh
        resistanceLocation += 4.5
        resistanceWhy += "PGH; "
if nearPGL
    if close >= previousGlobexLow
        supportLocation += 4.5
        supportWhy += "PGL; "
    if close <= previousGlobexLow
        resistanceLocation += 4.5
        resistanceWhy += "PGL; "
if nearPWH
    if close >= pwh
        supportLocation += 4.5
        supportWhy += "PWH; "
    if close <= pwh
        resistanceLocation += 4.5
        resistanceWhy += "PWH; "
if nearPWL
    if close >= pwl
        supportLocation += 4.5
        supportWhy += "PWL; "
    if close <= pwl
        resistanceLocation += 4.5
        resistanceWhy += "PWL; "

// Previous NYSE > London > Asia by default.
if nearPNH
    if close >= prevNyseH
        supportLocation += 4.0
        supportWhy += "P-NYSE-H; "
    if close <= prevNyseH
        resistanceLocation += 4.0
        resistanceWhy += "P-NYSE-H; "
if nearPNL
    if close >= prevNyseL
        supportLocation += 4.0
        supportWhy += "P-NYSE-L; "
    if close <= prevNyseL
        resistanceLocation += 4.0
        resistanceWhy += "P-NYSE-L; "
if nearPLH
    if close >= prevLondonH
        supportLocation += 3.5
        supportWhy += "P-LON-H; "
    if close <= prevLondonH
        resistanceLocation += 3.5
        resistanceWhy += "P-LON-H; "
if nearPLL
    if close >= prevLondonL
        supportLocation += 3.5
        supportWhy += "P-LON-L; "
    if close <= prevLondonL
        resistanceLocation += 3.5
        resistanceWhy += "P-LON-L; "
if nearPAH
    if close >= prevAsiaH
        supportLocation += 3.0
        supportWhy += "P-ASIA-H; "
    if close <= prevAsiaH
        resistanceLocation += 3.0
        resistanceWhy += "P-ASIA-H; "
if nearPAL
    if close >= prevAsiaL
        supportLocation += 3.0
        supportWhy += "P-ASIA-L; "
    if close <= prevAsiaL
        resistanceLocation += 3.0
        resistanceWhy += "P-ASIA-L; "

if nearStructureLow
    supportLocation += 4
    supportWhy += "Structure; "

if nearStructureHigh
    resistanceLocation += 4
    resistanceWhy += "Structure; "


// Manual structural TLs outrank ordinary automated local structure.
if manualLongStructuralLocation
    supportLocation += 7
    supportWhy += "Manual Structure TL; "

if manualShortStructuralLocation
    resistanceLocation += 7
    resistanceWhy += "Manual Structure TL; "


// Impulse TLs matter, but they do not carry the authority of structural TLs.
if manualLongImpulseLocation
    supportLocation += 4.5
    supportWhy += "Manual Impulse TL; "

if manualShortImpulseLocation
    resistanceLocation += 4.5
    resistanceWhy += "Manual Impulse TL; "


// Spatial stacking of INDEPENDENT levels is materially stronger.
if manualLongStacked
    supportLocation += 2.5
    supportWhy += "STACKED STRUCTURE; "

if manualShortStacked
    resistanceLocation += 2.5
    resistanceWhy += "STACKED STRUCTURE; "


// VWAP and the 1m 200 are Tier-1 dynamic structural anchors.
if nearVWAP
    if close >= futuresSessionVwap
        supportLocation += 5.5
        supportWhy += "VWAP; "
    if close <= futuresSessionVwap
        resistanceLocation += 5.5
        resistanceWhy += "VWAP; "

if near1m200
    if close >= ema1mRegimeHtf
        supportLocation += 5.5
        supportWhy += "1m200; "
    if close <= ema1mRegimeHtf
        resistanceLocation += 5.5
        resistanceWhy += "1m200; "
if near2m200
    if close >= ema2m200
        supportLocation += 2.5
        supportWhy += "2m200; "
    if close <= ema2m200
        resistanceLocation += 2.5
        resistanceWhy += "2m200; "
supportLocation := math.min(supportLocation, 10)
resistanceLocation := math.min(resistanceLocation, 10)

//=============================================================================
// 22 — AUCTION STATE / PRESSURE
//=============================================================================
bool aboveVAH = not na(activeVAH) and close > activeVAH
bool belowVAL = not na(activeVAL) and close < activeVAL
int closesAboveVAH = f_countTrue(aboveVAH, acceptanceLookback)
int closesBelowVAL = f_countTrue(belowVAL, acceptanceLookback)
bool acceptedAboveVAH = aboveVAH and closesAboveVAH >= acceptanceCloses
bool acceptedBelowVAL = belowVAL and closesBelowVAL >= acceptanceCloses
bool excursionAboveVAH = not na(activeVAH) and high > activeVAH and not acceptedAboveVAH
bool excursionBelowVAL = not na(activeVAL) and low < activeVAL and not acceptedBelowVAL
bool failedAuctionAboveVAH = not na(activeVAH) and high > activeVAH and close < activeVAH and (buyingAbsorbed or bearReject or rsiROC < 0)
bool failedAuctionBelowVAL = not na(activeVAL) and low < activeVAL and close > activeVAL and (sellingAbsorbed or bullReject or rsiROC > 0)
int barsSinceFailedVAH = ta.barssince(failedAuctionAboveVAH)
int barsSinceFailedVAL = ta.barssince(failedAuctionBelowVAL)
bool recentFailedVAH = not na(barsSinceFailedVAH) and barsSinceFailedVAH <= failedAuctionMemory
bool recentFailedVAL = not na(barsSinceFailedVAL) and barsSinceFailedVAL <= failedAuctionMemory
string auctionState = acceptedAboveVAH ? "ACCEPT > VAH" : acceptedBelowVAL ? "ACCEPT < VAL" : failedAuctionAboveVAH ? "FAIL > VAH" : failedAuctionBelowVAL ? "FAIL < VAL" : excursionAboveVAH ? "TEST > VAH" : excursionBelowVAL ? "TEST < VAL" : "INSIDE VALUE"

bool resistanceTest = not na(priorResistance) and high >= priorResistance - atr * boundaryToleranceATR
bool supportTest = not na(priorSupport) and low <= priorSupport + atr * boundaryToleranceATR
int resistanceTests = f_countTrue(resistanceTest, pressureTestLookback)
int supportTests = f_countTrue(supportTest, pressureTestLookback)
bool repeatedResistancePressure = resistanceTests >= minimumBoundaryTests
bool repeatedSupportPressure = supportTests >= minimumBoundaryTests

//-----------------------------------------------------------------------------
// BULLISH / BEARISH COMPRESSION — pivot-defined structure
//
// Bullish compression:
//   3 rising pivot lows pressing into a flat/repeated ceiling.
//
// Bearish compression:
//   3 falling pivot highs pressing into a flat/repeated floor.
//
// Compression is STRUCTURE, not a separate thesis family.
//-----------------------------------------------------------------------------

int compPivotLeft = 2
int compPivotRight = 2

float compPivotLow = ta.pivotlow(low, compPivotLeft, compPivotRight)
float compPivotHigh = ta.pivothigh(high, compPivotLeft, compPivotRight)

bool compPivotLowFound = not na(compPivotLow)
bool compPivotHighFound = not na(compPivotHigh)

float compLow0 = ta.valuewhen(compPivotLowFound, compPivotLow, 0)
float compLow1 = ta.valuewhen(compPivotLowFound, compPivotLow, 1)
float compLow2 = ta.valuewhen(compPivotLowFound, compPivotLow, 2)

int compLowBar0 = ta.valuewhen(compPivotLowFound, bar_index - compPivotRight, 0)
int compLowBar1 = ta.valuewhen(compPivotLowFound, bar_index - compPivotRight, 1)

float compHigh0 = ta.valuewhen(compPivotHighFound, compPivotHigh, 0)
float compHigh1 = ta.valuewhen(compPivotHighFound, compPivotHigh, 1)
float compHigh2 = ta.valuewhen(compPivotHighFound, compPivotHigh, 2)

int compHighBar0 = ta.valuewhen(compPivotHighFound, bar_index - compPivotRight, 0)
int compHighBar1 = ta.valuewhen(compPivotHighFound, bar_index - compPivotRight, 1)

float compBoundaryBand =
     atr * math.max(boundaryToleranceATR * 1.50, 0.20)

float compLineTolerance =
     atr * math.max(boundaryToleranceATR, 0.15)

int compMaxAge = structureLookback * 3

// Three progressively higher structural lows.
bool compThreeRisingLows =
     not na(compLow2) and
     compLow0 >= compLow1 + syminfo.mintick * 2 and
     compLow1 >= compLow2 + syminfo.mintick * 2

// Three progressively lower structural highs.
bool compThreeFallingHighs =
     not na(compHigh2) and
     compHigh0 <= compHigh1 - syminfo.mintick * 2 and
     compHigh1 <= compHigh2 - syminfo.mintick * 2

// Repeated highs clustered around the same ceiling.
bool compFlatCeiling =
     not na(compHigh1) and
     math.abs(compHigh0 - compHigh1) <= compBoundaryBand

// Repeated lows clustered around the same floor.
bool compFlatFloor =
     not na(compLow1) and
     math.abs(compLow0 - compLow1) <= compBoundaryBand

bool compBullFresh =
     not na(compLowBar0) and
     not na(compHighBar0) and
     bar_index - compLowBar0 <= compMaxAge and
     bar_index - compHighBar0 <= compMaxAge

bool compBearFresh =
     not na(compHighBar0) and
     not na(compLowBar0) and
     bar_index - compHighBar0 <= compMaxAge and
     bar_index - compLowBar0 <= compMaxAge

// Rising support projected from the two most recent pivot lows.
float bullCompressionSupportSlope =
     not na(compLowBar0) and
     not na(compLowBar1) and
     compLowBar0 > compLowBar1 ?
     (compLow0 - compLow1) / float(compLowBar0 - compLowBar1) :
     na

// Falling resistance projected from the two most recent pivot highs.
float bearCompressionResistanceSlope =
     not na(compHighBar0) and
     not na(compHighBar1) and
     compHighBar0 > compHighBar1 ?
     (compHigh0 - compHigh1) / float(compHighBar0 - compHighBar1) :
     na

float bullCompressionSupportNow =
     not na(bullCompressionSupportSlope) ?
     compLow0 +
     bullCompressionSupportSlope * float(bar_index - compLowBar0) :
     na

float bearCompressionResistanceNow =
     not na(bearCompressionResistanceSlope) ?
     compHigh0 +
     bearCompressionResistanceSlope * float(bar_index - compHighBar0) :
     na

float bullCompressionCeiling =
     not na(compHigh1) ?
     (compHigh0 + compHigh1) / 2.0 :
     na

float bearCompressionFloor =
     not na(compLow1) ?
     (compLow0 + compLow1) / 2.0 :
     na

// Actual Bullish Compression structure:
// rising lows + repeated ceiling.
bool bullCompressionStructure =
     compThreeRisingLows and
     compFlatCeiling and
     compBullFresh and
     not na(bullCompressionSupportSlope) and
     bullCompressionSupportSlope > 0 and
     not na(bullCompressionSupportNow) and
     not na(bullCompressionCeiling) and
     bullCompressionSupportNow <
     bullCompressionCeiling - syminfo.mintick * 4

// Actual Bearish Compression structure:
// falling highs + repeated floor.
bool bearCompressionStructure =
     compThreeFallingHighs and
     compFlatFloor and
     compBearFresh and
     not na(bearCompressionResistanceSlope) and
     bearCompressionResistanceSlope < 0 and
     not na(bearCompressionResistanceNow) and
     not na(bearCompressionFloor) and
     bearCompressionResistanceNow >
     bearCompressionFloor + syminfo.mintick * 4

// Structural failure.
bool bullCompressionInvalidated =
     bullCompressionStructure and
     close < bullCompressionSupportNow - compLineTolerance

bool bearCompressionInvalidated =
     bearCompressionStructure and
     close > bearCompressionResistanceNow + compLineTolerance

// Pressure finally releases through the ceiling/floor.
bool bullCompressionBreakout =
     bullCompressionStructure and
     close > bullCompressionCeiling + compLineTolerance

bool bearCompressionBreakout =
     bearCompressionStructure and
     close < bearCompressionFloor - compLineTolerance

bool bullCompressionActive =
     bullCompressionStructure and
     not bullCompressionInvalidated and
     not bullCompressionBreakout

bool bearCompressionActive =
     bearCompressionStructure and
     not bearCompressionInvalidated and
     not bearCompressionBreakout

// Mature = third repeated test of the fixed boundary is also clustered.
bool bullCompressionMature =
     bullCompressionStructure and
     not na(compHigh2) and
     math.abs(compHigh0 - compHigh2) <= compBoundaryBand

bool bearCompressionMature =
     bearCompressionStructure and
     not na(compLow2) and
     math.abs(compLow0 - compLow2) <= compBoundaryBand

// Did price actually return to the pressure line?
bool bullCompressionSupportTouch =
     bullCompressionActive and
     low <= bullCompressionSupportNow + compLineTolerance and
     high >= bullCompressionSupportNow - compLineTolerance

bool bearCompressionResistanceTouch =
     bearCompressionActive and
     high >= bearCompressionResistanceNow - compLineTolerance and
     low <= bearCompressionResistanceNow + compLineTolerance

int barsSinceBullCompressionTouch =
     ta.barssince(bullCompressionSupportTouch)

int barsSinceBearCompressionTouch =
     ta.barssince(bearCompressionResistanceTouch)

bool recentBullCompressionSupportTouch =
     not na(barsSinceBullCompressionTouch) and
     barsSinceBullCompressionTouch <= 2

bool recentBearCompressionResistanceTouch =
     not na(barsSinceBearCompressionTouch) and
     barsSinceBearCompressionTouch <= 2

// The pressure line itself is legitimate LASER Location.
if bullCompressionSupportTouch
    supportLocation += 6
    supportWhy += "Rising compression support; "

if bearCompressionResistanceTouch
    resistanceLocation += 6
    resistanceWhy += "Falling compression resistance; "

supportLocation := math.min(supportLocation, 10)
resistanceLocation := math.min(resistanceLocation, 10)

// Preserve the old general pressure detector, but upgrade it with
// true pivot-defined compression.
bool bullPressureShape =
     (higherLow and repeatedResistancePressure) or
     bullCompressionActive

bool bearPressureShape =
     (lowerHigh and repeatedSupportPressure) or
     bearCompressionActive
float compressionRange = ta.highest(high, structureLookback) - ta.lowest(low, structureLookback)
float compressionRangeATR = atr > 0 ? compressionRange / atr : 0
bool majorHTFClose = (timeframe.change("15") ? 1 : 0) + (timeframe.change("30") ? 1 : 0) + (timeframe.change("60") ? 1 : 0) + (timeframe.change("240") ? 1 : 0) >= 3
float pressureScore = 0
if squeezeOn
    pressureScore += 20
if prolongedCompression
    pressureScore += 15
if squeezeBars >= 12
    pressureScore += 20
else if squeezeBars >= 6
    pressureScore += 10
if bullPressureShape or bearPressureShape
    pressureScore += 20
if math.abs(sqzMomentum) <= atr * 0.50
    pressureScore += 10
if compressionRangeATR <= 3
    pressureScore += 10
if majorHTFClose
    pressureScore += 5
pressureScore := math.min(pressureScore, 100)
string energyState = squeezeOn and pressureScore >= 70 ? "PRESSURIZED" : squeezeOn ? "COMPRESSED" : squeezeFired ? "EARLY EXPANSION" : sqzBullReAccel ? "BULL RE-EXPAND" : sqzBearReAccel ? "BEAR RE-EXPAND" : sqzBullAccel ? "BULL EXPAND" : sqzBearAccel ? "BEAR EXPAND" : sqzBullDecel ? "BULL DECEL" : sqzBearDecel ? "BEAR DECEL" : "NEUTRAL"

//=============================================================================
// 23 — STRUCTURE SHIFT / RETEST
//=============================================================================
bool automaticBearishStructureShift =
     microBearBreak and
     (
          recentBullProgressFailure or
          recentFailedVAH or
          buyingAbsorbed or
          bearishDisagreement or
          recentRsiBearDiv
     )

bool automaticBullishStructureShift =
     microBullBreak and
     (
          recentBearProgressFailure or
          recentFailedVAL or
          sellingAbsorbed or
          bullishDisagreement or
          recentRsiBullDiv
     )


// A confirmed failure of a MAJOR manually defined structural trendline
// is itself legitimate structural information.
//
// Impulse TL breaks intentionally do NOT get this authority.
bool bearishStructureShift =
     automaticBearishStructureShift or
     manualBearishStructureFlipEvent

bool bullishStructureShift =
     automaticBullishStructureShift or
     manualBullishStructureFlipEvent


int barsSinceBearShift =
     ta.barssince(bearishStructureShift)

int barsSinceBullShift =
     ta.barssince(bullishStructureShift)

bool recentBearShift =
     not na(barsSinceBearShift) and
     barsSinceBearShift <= structureBreakMemory

bool recentBullShift =
     not na(barsSinceBullShift) and
     barsSinceBullShift <= structureBreakMemory


// Preserve the actual structural level that caused the shift.
float bearShiftSourceLevel =
     manualBearishStructureFlipEvent and
     not na(bullStructNow) ?
     bullStructNow :
     microSupport

float bullShiftSourceLevel =
     manualBullishStructureFlipEvent and
     not na(bearStructNow) ?
     bearStructNow :
     microResistance


float bearShiftLevel =
     ta.valuewhen(
          bearishStructureShift,
          bearShiftSourceLevel,
          0)

float bullShiftLevel =
     ta.valuewhen(
          bullishStructureShift,
          bullShiftSourceLevel,
          0)


bool bearShiftRetest =
     recentBearShift and
     (
          (
               high >= ema1mRegimeHtf - atr * locationATR and
               close < ema1mRegimeHtf
          ) or
          (
               not na(bearShiftLevel) and
               high >= bearShiftLevel - atr * locationATR and
               close < bearShiftLevel
          ) or
          bullStructFailedReclaim
     )

bool bullShiftRetest =
     recentBullShift and
     (
          (
               low <= ema1mRegimeHtf + atr * locationATR and
               close > ema1mRegimeHtf
          ) or
          (
               not na(bullShiftLevel) and
               low <= bullShiftLevel + atr * locationATR and
               close > bullShiftLevel
          ) or
          bearStructFailedReclaim
     )

//=============================================================================
// 24 — ROOM / STOPS
//=============================================================================

// External / meaningful reference levels.
// Continuation Room uses THESE, because breaking recent local structure
// is part of the continuation thesis.
float nearestAboveExternal = na
float nearestBelowExternal = na

nearestAboveExternal := f_above(activeVAH, nearestAboveExternal)
nearestAboveExternal := f_above(activePOC, nearestAboveExternal)
nearestAboveExternal := f_above(activeVAL, nearestAboveExternal)

nearestBelowExternal := f_below(activeVAH, nearestBelowExternal)
nearestBelowExternal := f_below(activePOC, nearestBelowExternal)
nearestBelowExternal := f_below(activeVAL, nearestBelowExternal)

if usePreviousGlobexHL
    nearestAboveExternal := f_above(previousGlobexHigh, nearestAboveExternal)
    nearestAboveExternal := f_above(previousGlobexLow, nearestAboveExternal)
    nearestBelowExternal := f_below(previousGlobexHigh, nearestBelowExternal)
    nearestBelowExternal := f_below(previousGlobexLow, nearestBelowExternal)

if usePreviousWeek
    nearestAboveExternal := f_above(pwh, nearestAboveExternal)
    nearestAboveExternal := f_above(pwl, nearestAboveExternal)
    nearestBelowExternal := f_below(pwh, nearestBelowExternal)
    nearestBelowExternal := f_below(pwl, nearestBelowExternal)

if usePrevAsiaHL
    nearestAboveExternal := f_above(prevAsiaH, nearestAboveExternal)
    nearestAboveExternal := f_above(prevAsiaL, nearestAboveExternal)
    nearestBelowExternal := f_below(prevAsiaH, nearestBelowExternal)
    nearestBelowExternal := f_below(prevAsiaL, nearestBelowExternal)

if usePrevLondonHL
    nearestAboveExternal := f_above(prevLondonH, nearestAboveExternal)
    nearestAboveExternal := f_above(prevLondonL, nearestAboveExternal)
    nearestBelowExternal := f_below(prevLondonH, nearestBelowExternal)
    nearestBelowExternal := f_below(prevLondonL, nearestBelowExternal)

if usePrevNyseHL
    nearestAboveExternal := f_above(prevNyseH, nearestAboveExternal)
    nearestAboveExternal := f_above(prevNyseL, nearestAboveExternal)
    nearestBelowExternal := f_below(prevNyseH, nearestBelowExternal)
    nearestBelowExternal := f_below(prevNyseL, nearestBelowExternal)

// Manual STRUCTURAL trendlines are legitimate opposing targets/blockers.
// Impulse lines are intentionally excluded from Room because they are tactical
// and should not over-restrict otherwise valid trades.

if enableManualStructure

    if bullStructUsable
        nearestAboveExternal :=
             f_above(
                  bullStructNow,
                  nearestAboveExternal)

        nearestBelowExternal :=
             f_below(
                  bullStructNow,
                  nearestBelowExternal)

    if bearStructUsable
        nearestAboveExternal :=
             f_above(
                  bearStructNow,
                  nearestAboveExternal)

        nearestBelowExternal :=
             f_below(
                  bearStructNow,
                  nearestBelowExternal)
// Full Room set.
// MR still respects recent local structure because an MR is rotating INTO
// existing structure rather than expecting an established trend to break it.
float nearestAbove = f_above(priorResistance, nearestAboveExternal)
float nearestBelow = f_below(priorSupport, nearestBelowExternal)

f_longRoomTo(float risk, float blocker) =>
    float result = 0.0
    if not na(risk) and risk > 0
        float roomPts = na(blocker) ? risk * 10.0 : math.max(0.0, blocker - close)
        result := roomPts / risk
    result

f_shortRoomTo(float risk, float blocker) =>
    float result = 0.0
    if not na(risk) and risk > 0
        float roomPts = na(blocker) ? risk * 10.0 : math.max(0.0, close - blocker)
        result := roomPts / risk
    result

float standardContLongBase =
     ta.lowest(low, microLookback)

float standardContShortBase =
     ta.highest(high, microLookback)


// If manual structure is actually driving the reaction, use that structural
// level for invalidation rather than an arbitrary local micro low/high.
float manualLongStopBase =
     recentBullStructHold or bullStructReclaimEvent ?
     bullStructNow :
     bearStructBreakConfirmed or bearStructFailedReclaim ?
     bearStructNow :
     recentBullImpulseTlHold ?
     bullImpulseTlNow :
     recentBearImpulseTlBreak and nearBearImpulseTL ?
     bearImpulseTlNow :
     na

float manualShortStopBase =
     recentBearStructHold or bearStructReclaimEvent ?
     bearStructNow :
     bullStructBreakConfirmed or bullStructFailedReclaim ?
     bullStructNow :
     recentBearImpulseTlHold ?
     bearImpulseTlNow :
     recentBullImpulseTlBreak and nearBullImpulseTL ?
     bullImpulseTlNow :
     na

float contLongBase =
     not na(manualLongStopBase) ?
     manualLongStopBase :
     recentBullCompressionSupportTouch and
     bullCompressionActive and
     not na(bullCompressionSupportNow) ?
     bullCompressionSupportNow :
     standardContLongBase

float contShortBase =
     not na(manualShortStopBase) ?
     manualShortStopBase :
     recentBearCompressionResistanceTouch and
     bearCompressionActive and
     not na(bearCompressionResistanceNow) ?
     bearCompressionResistanceNow :
     standardContShortBase

float mrFallbackLow = ta.lowest(low, 3)
float mrFallbackHigh = ta.highest(high, 3)

float contLongStop =
     contLongBase - atr * stopBufferATR

float contShortStop =
     contShortBase + atr * stopBufferATR
float mrLongStop = freshSweepLow and not na(lastSweepLow) ? lastSweepLow - atr * stopBufferATR : mrFallbackLow - atr * stopBufferATR
float mrShortStop = freshSweepHigh and not na(lastSweepHigh) ? lastSweepHigh + atr * stopBufferATR : mrFallbackHigh + atr * stopBufferATR

float contLongRisk = f_longRisk(contLongStop)
float contShortRisk = f_shortRisk(contShortStop)
float mrLongRisk = f_longRisk(mrLongStop)
float mrShortRisk = f_shortRisk(mrShortStop)
float contLongRoom = f_longRoomTo(contLongRisk, nearestAboveExternal)
float contShortRoom = f_shortRoomTo(contShortRisk, nearestBelowExternal)

float mrLongRoom = f_longRoomTo(mrLongRisk, nearestAbove)
float mrShortRoom = f_shortRoomTo(mrShortRisk, nearestBelow)

//=============================================================================
// 24B — 1-MINUTE EXECUTION TIMING LAYER (5m chart only)
//=============================================================================
// L/A/S remain 5-minute concepts. This layer answers only E: when did the
// pullback/reversal actually begin to resolve inside the current 5m candle?
// The first qualifying lower-TF trigger is retained as the candidate entry.
[execOArr, execHArr, execLArr, execCArr, execFastArr, execRsiArr] = request.security_lower_tf(
     syminfo.tickerid,
     executionLowerTF,
     [open, high, low, close, ta.ema(close, length1mFast), ta.rsi(close, rsiLength)],
     ignore_invalid_timeframe = true,
     calc_bars_count = 5000)

int execCount = array.size(execCArr)

// Lower-TF E is allowed only when the selected execution source is
// genuinely lower than the chart timeframe.
//
// This prevents combinations such as:
//   5m chart + Execution Source 5m + lower-TF timing ON
// from entering the intrabar execution branch.
//
// Invalid/non-lower selections simply fall back to normal chart-TF E.
float chartTfSeconds = timeframe.in_seconds(timeframe.period)
float executionTfSeconds = timeframe.in_seconds(executionLowerTF)

bool executionSourceIsLower =
     not na(chartTfSeconds) and
     not na(executionTfSeconds) and
     executionTfSeconds < chartTfSeconds

bool execLayerActive =
     useOneMinuteExecution and
     is5m and
     executionSourceIsLower and
     execCount > 0

bool execLongTrigger = false
bool execShortTrigger = false
float execLongPrice = na
float execShortPrice = na
float execLongTriggerLow = na
float execShortTriggerHigh = na

if execLayerActive
    for i = 0 to execCount - 1
        float eo = array.get(execOArr, i)
        float eh = array.get(execHArr, i)
        float el = array.get(execLArr, i)
        float ec = array.get(execCArr, i)
        float ef = array.get(execFastArr, i)
        float er = array.get(execRsiArr, i)
        float pc = i > 0 ? array.get(execCArr, i - 1) : open
        float ph = i > 0 ? array.get(execHArr, i - 1) : na
        float pl = i > 0 ? array.get(execLArr, i - 1) : na
        float pf = i > 0 ? array.get(execFastArr, i - 1) : ef
        float pr = i > 0 ? array.get(execRsiArr, i - 1) : er

        bool oneMinBullBody = ec > eo
        bool oneMinBearBody = ec < eo
        bool oneMinRsiUp = not na(er) and not na(pr) and er > pr
        bool oneMinRsiDown = not na(er) and not na(pr) and er < pr
        bool oneMinLongReclaim = not na(ef) and not na(pf) and ec > ef and pc <= pf
        bool oneMinShortReclaim = not na(ef) and not na(pf) and ec < ef and pc >= pf
        bool oneMinBullBreak = i > 0 and not na(ph) and ec > ph
        bool oneMinBearBreak = i > 0 and not na(pl) and ec < pl

        bool thisLongTrigger = oneMinBullBody and oneMinRsiUp and (oneMinLongReclaim or oneMinBullBreak)
        bool thisShortTrigger = oneMinBearBody and oneMinRsiDown and (oneMinShortReclaim or oneMinBearBreak)

        if thisLongTrigger and not execLongTrigger
            execLongTrigger := true
            execLongPrice := ec
            execLongTriggerLow := el
        if thisShortTrigger and not execShortTrigger
            execShortTrigger := true
            execShortPrice := ec
            execShortTriggerHigh := eh

//=============================================================================
// 25 — LASER THESIS ENGINE
//=============================================================================
//
// C:
// EXISTING 5m TREND
//      -> IMPULSE
//      -> PULLBACK AGAINST TREND
//      -> HOLD / REACTION
//      -> E
//      -> FIRE
//
// MR:
// ESTABLISHED 5m TREND
//      -> DETERIORATION / EXHAUSTION
//      -> FAILURE
//      -> OPPOSITE STRUCTURE SHIFT
//      -> E
//      -> FIRE
//
// Scores measure QUALITY.
// Scores do NOT manufacture the pattern.
//=============================================================================


//=============================================================================
// A — DYNAMIC PULLBACK LOCATION
//=============================================================================

float longTouchStrength = supportLocation
float shortTouchStrength = resistanceLocation

// VWAP + 1m200 are the dominant dynamic anchors.
if nearVWAP
    longTouchStrength := math.max(longTouchStrength, 6.0)
    shortTouchStrength := math.max(shortTouchStrength, 6.0)

if near1m200
    longTouchStrength := math.max(longTouchStrength, 6.0)
    shortTouchStrength := math.max(shortTouchStrength, 6.0)

if near2m200
    longTouchStrength := math.max(longTouchStrength, 3.5)
    shortTouchStrength := math.max(shortTouchStrength, 3.5)

if low <= laserFastEma
    longTouchStrength := math.max(longTouchStrength, 2.5)

if low <= laserTrendEma
    longTouchStrength := math.max(longTouchStrength, 3.0)

if high >= laserFastEma
    shortTouchStrength := math.max(shortTouchStrength, 2.5)

if high >= laserTrendEma
    shortTouchStrength := math.max(shortTouchStrength, 3.0)


//=============================================================================
// S — ESTABLISHED LOCAL TREND
//
// A single bar is not enough to establish a directional regime.
//=============================================================================

int bullTrendVotes = f_countTrue(bullTrend, 4)
int bearTrendVotes = f_countTrue(bearTrend, 4)

bool bullTrendEstablished =
     bullTrend and bullTrendVotes >= 2

bool bearTrendEstablished =
     bearTrend and bearTrendVotes >= 2

// Preserve the established 5m regime through a normal pullback.
// The trend does not cease to exist just because the current pullback
// temporarily makes the instantaneous trend state neutral.
int barsSinceBullTrendContext = ta.barssince(bullTrendEstablished)
int barsSinceBearTrendContext = ta.barssince(bearTrendEstablished)

bool recentBullTrendContext =
     not na(barsSinceBullTrendContext) and
     barsSinceBullTrendContext <= 4

bool recentBearTrendContext =
     not na(barsSinceBearTrendContext) and
     barsSinceBearTrendContext <= 4
//=============================================================================
// S — DIRECTIONAL DRIVE / IMPULSE EVENT
//
// Continuation needs a discrete directional push BEFORE the pullback.
// A bullish/bearish trend by itself is not enough.
//=============================================================================

bool bullDriveEvent =
     bullTrendEstablished and
     rsiROC > 0 and
     (
         bullImpulse or
         microBullBreak or
         breakResistance or
         sqzBullAccel or
         sqzBullReAccel or
         (close > laserFastEma and high > high[1])
     )

bool bearDriveEvent =
     bearTrendEstablished and
     rsiROC < 0 and
     (
         bearImpulse or
         microBearBreak or
         breakSupport or
         sqzBearAccel or
         sqzBearReAccel or
         (close < laserFastEma and low < low[1])
     )

int barsSinceBullImpulse = ta.barssince(bullDriveEvent)
int barsSinceBearImpulse = ta.barssince(bearDriveEvent)

// Must be at least ONE bar after the drive.
// This forces:
// DRIVE -> THEN PULLBACK
// rather than allowing both to occur simultaneously.
bool recentBullImpulse =
     not na(barsSinceBullImpulse) and
     barsSinceBullImpulse >= 1 and
     barsSinceBullImpulse <= 8

bool recentBearImpulse =
     not na(barsSinceBearImpulse) and
     barsSinceBearImpulse >= 1 and
     barsSinceBearImpulse <= 8

float lastBullDriveHigh =
     ta.valuewhen(bullDriveEvent, high, 0)

float lastBullDriveLow =
     ta.valuewhen(bullDriveEvent, low, 0)

float lastBearDriveHigh =
     ta.valuewhen(bearDriveEvent, high, 0)

float lastBearDriveLow =
     ta.valuewhen(bearDriveEvent, low, 0)


//=============================================================================
// S — REAL PULLBACK
//
// Touching an EMA by itself is NOT a pullback.
// Price must actually move against an established directional leg.
//=============================================================================

bool longPullbackAgainstTrend =
     recentBullImpulse and
     (
         close < close[1] or
         low < low[1]
     ) and
     (
         na(lastBullDriveHigh) or
         low < lastBullDriveHigh
     )

bool shortPullbackAgainstTrend =
     recentBearImpulse and
     (
         close > close[1] or
         high > high[1]
     ) and
     (
         na(lastBearDriveLow) or
         high > lastBearDriveLow
     )


bool longPullbackLocation =
     near1m200 or
     nearVWAP or
     supportLocation >= 4 or
     (
         low <= laserFastEma and
         low >= laserTrendEma - atr * 0.50
     ) or
     (
         low <= laserTrendEma and
         close >= laserTrendEma
     )

bool shortPullbackLocation =
     near1m200 or
     nearVWAP or
     resistanceLocation >= 4 or
     (
         high >= laserFastEma and
         high <= laserTrendEma + atr * 0.50
     ) or
     (
         high >= laserTrendEma and
         close <= laserTrendEma
     )


// Prevent an ordinary continuation from surviving an obviously excessive
// structural failure unless it is interacting with a major LASER anchor.
bool longPullbackDepthOk =
     low >= laserTrendEma - atr * 1.25 or
     near1m200 or
     nearVWAP or
     supportLocation >= 5

bool shortPullbackDepthOk =
     high <= laserTrendEma + atr * 1.25 or
     near1m200 or
     nearVWAP or
     resistanceLocation >= 5

//=============================================================================
// PULLBACK INVALIDATION
//
// If price destroys the local trend structure, this is no longer a normal C.
// It may later become MR in the opposite direction.
//=============================================================================

bool longContinuationBroken =
     breakSupport or
     manualBearishStructureFailure or
     (
          close < laserTrendEma - atr * 0.75 and
          not near1m200 and
          not nearVWAP
     )

bool shortContinuationBroken =
     breakResistance or
     manualBullishStructureFailure or
     (
          close > laserTrendEma + atr * 0.75 and
          not near1m200 and
          not nearVWAP
     )


bool continuationLongContext =
     recentBullTrendContext and
     not bearTrendEstablished

bool continuationShortContext =
     recentBearTrendContext and
     not bullTrendEstablished


bool longPullbackTouch =
     continuationLongContext and
     recentBullImpulse and
     longPullbackAgainstTrend and
     longPullbackLocation and
     longPullbackDepthOk and
     not longContinuationBroken

bool shortPullbackTouch =
     continuationShortContext and
     recentBearImpulse and
     shortPullbackAgainstTrend and
     shortPullbackLocation and
     shortPullbackDepthOk and
     not shortContinuationBroken


int barsSinceLongPB = ta.barssince(longPullbackTouch)
int barsSinceShortPB = ta.barssince(shortPullbackTouch)

bool recentLongPB =
     not na(barsSinceLongPB) and
     barsSinceLongPB <= 2

bool recentShortPB =
     not na(barsSinceShortPB) and
     barsSinceShortPB <= 2


float longTouchScore =
     nz(ta.valuewhen(longPullbackTouch, longTouchStrength, 0), 0)

float shortTouchScore =
     nz(ta.valuewhen(shortPullbackTouch, shortTouchStrength, 0), 0)


//=============================================================================
// MOMENTUM RE-ACCELERATION
//=============================================================================

bool longReAccel =
     rsiROC > 0 and
     (sqzBullAccel or sqzBullReAccel or bullImpulse)

bool shortReAccel =
     rsiROC < 0 and
     (sqzBearAccel or sqzBearReAccel or bearImpulse)


//=============================================================================
// DETERIORATION
//
// Use RECENT progress failure rather than only the current candle.
//=============================================================================

int bullDeterioration =
     (rsiSharpDown ? 1 : 0) +
     (sqzBullDecel ? 1 : 0) +
     (bearishDisagreement ? 1 : 0) +
     (recentBullProgressFailure ? 1 : 0) +
     (recentRsiBearDiv ? 1 : 0)

int bearDeterioration =
     (rsiSharpUp ? 1 : 0) +
     (sqzBearDecel ? 1 : 0) +
     (bullishDisagreement ? 1 : 0) +
     (recentBearProgressFailure ? 1 : 0) +
     (recentRsiBullDiv ? 1 : 0)


//=============================================================================
// EVIDENCE MODIFIERS
//=============================================================================

bool sweepLongEvidence =
     useSweepEvidence and freshSweepLow

bool sweepShortEvidence =
     useSweepEvidence and freshSweepHigh

bool exhaustionLongEvidence =
     useExhaustionEvidence and
     matureBearImpulse and
     bearDeterioration >= 2

bool exhaustionShortEvidence =
     useExhaustionEvidence and
     matureBullImpulse and
     bullDeterioration >= 2

bool absorptionLongEvidence =
     useAbsorptionEvidence and sellingAbsorbed

bool absorptionShortEvidence =
     useAbsorptionEvidence and buyingAbsorbed

bool structureLongEvidence =
     (
          useStructureRetestEvidence and
          bullShiftRetest
     ) or
     manualStructureLongEvidence or
     manualImpulseLongEvidence

bool structureShortEvidence =
     (
          useStructureRetestEvidence and
          bearShiftRetest
     ) or
     manualStructureShortEvidence or
     manualImpulseShortEvidence

bool rsiDivLongEvidence =
     useRsiDivEvidence and recentRsiBullDiv

bool rsiDivShortEvidence =
     useRsiDivEvidence and recentRsiBearDiv

bool failedAuctionLongEvidence =
     useFailedAuctionEvidence and recentFailedVAL

bool failedAuctionShortEvidence =
     useFailedAuctionEvidence and recentFailedVAH

bool breakoutLongEvidence =
     useBreakoutAcceptanceEvidence and acceptedAboveVAH

bool breakoutShortEvidence =
     useBreakoutAcceptanceEvidence and acceptedBelowVAL

bool squeezeLongEvidence =
     recentRelease or squeezeFired or sqzBullReAccel

bool squeezeShortEvidence =
     recentRelease or squeezeFired or sqzBearReAccel

bool supportedVolume = relativeVolume >= 1.50
bool highVolume = relativeVolume >= 1.75
bool extremeVolume = relativeVolume >= 2.25


bool divLongStrong =
     rsiDivLongEvidence and bullDivStrongPrice

bool divShortStrong =
     rsiDivShortEvidence and bearDivStrongPrice

bool divLongZone =
     rsiDivLongEvidence and bullDivInZone

bool divShortZone =
     rsiDivShortEvidence and bearDivInZone

bool divLongExhaustionCombo =
     rsiDivLongEvidence and exhaustionLongEvidence

bool divShortExhaustionCombo =
     rsiDivShortEvidence and exhaustionShortEvidence

bool divLongFailedAuctionCombo =
     rsiDivLongEvidence and failedAuctionLongEvidence

bool divShortFailedAuctionCombo =
     rsiDivShortEvidence and failedAuctionShortEvidence


//=============================================================================
// L / S — TIER-1 ANCHOR REACTION
//=============================================================================

bool long1m200Hold =
     near1m200 and
     close >= ema1mRegimeHtf

bool short1m200Hold =
     near1m200 and
     close <= ema1mRegimeHtf

bool longVwapHold =
     nearVWAP and
     close >= futuresSessionVwap

bool shortVwapHold =
     nearVWAP and
     close <= futuresSessionVwap

bool longTopTierHold =
     long1m200Hold or longVwapHold

bool shortTopTierHold =
     short1m200Hold or shortVwapHold


//=============================================================================
// S — PULLBACK HOLD
//
// A pullback must now show evidence that it actually HELD.
// The 1m E trigger may provide the earliest proof of that hold.
//=============================================================================

bool longPullbackHold =
     recentLongPB and
     not longContinuationBroken and
     (
         longTopTierHold or
         higherLow or
         bullReject or
         absorptionLongEvidence or
         structureLongEvidence or
         (execLayerActive and execLongTrigger)
     )

bool shortPullbackHold =
     recentShortPB and
     not shortContinuationBroken and
     (
         shortTopTierHold or
         lowerHigh or
         bearReject or
         absorptionShortEvidence or
         structureShortEvidence or
         (execLayerActive and execShortTrigger)
     )


//=============================================================================
// C — CONTINUATION SEQUENCE
//
// IMPORTANT:
// structureLongEvidence / structureShortEvidence may STRENGTHEN continuation,
// but can no longer manufacture a continuation by themselves.
//=============================================================================

bool contLongExecution =
     execLayerActive ?
     execLongTrigger :
     (longReAccel and close > laserFastEma)

bool contShortExecution =
     execLayerActive ?
     execShortTrigger :
     (shortReAccel and close < laserFastEma)


//=============================================================================
// C — MANUAL STRUCTURE PATHWAY
//
// Major structural TLs can CREATE a trade opportunity.
//
// But classification still matters:
//
// If a recent established BEAR trend is reversing bullish, the trade belongs
// to MR — not C.
//
// If a recent established BULL trend is reversing bearish, the trade belongs
// to MR — not C.
//
// Impulse-line reactions can create C only when the established local trend
// already agrees with them.
//=============================================================================

bool manualStructureLongSetup =
     enableContinuation and
     not recentBearTrendContext and
     manualStructureLongEvidence

bool manualStructureShortSetup =
     enableContinuation and
     not recentBullTrendContext and
     manualStructureShortEvidence


bool manualImpulseLongSetup =
     enableContinuation and
     recentBullTrendContext and
     not recentBearTrendContext and
     manualImpulseLongEvidence

bool manualImpulseShortSetup =
     enableContinuation and
     recentBearTrendContext and
     not recentBullTrendContext and
     manualImpulseShortEvidence


bool manualLongSetup =
     manualStructureLongSetup or
     manualImpulseLongSetup

bool manualShortSetup =
     manualStructureShortSetup or
     manualImpulseShortSetup


//=============================================================================
// C — COMPRESSION PATHWAY
//
// Compression remains a Structure state inside Continuation.
// We can trade reactions from the pressure line OR the eventual release.
//=============================================================================

bool bullCompressionLongSetup =
     enableContinuation and
     bullCompressionActive and
     recentBullCompressionSupportTouch and
     not bullCompressionInvalidated and
     (
         bullReject or
         absorptionLongEvidence or
         rsiROC > 0 or
         (execLayerActive and execLongTrigger)
     )

bool bearCompressionShortSetup =
     enableContinuation and
     bearCompressionActive and
     recentBearCompressionResistanceTouch and
     not bearCompressionInvalidated and
     (
         bearReject or
         absorptionShortEvidence or
         rsiROC < 0 or
         (execLayerActive and execShortTrigger)
     )

// Eventual release of accumulated pressure.
bool bullCompressionBreakoutSetup =
     enableContinuation and
     bullCompressionBreakout and
     (
         rsiROC > 0 or
         sqzBullAccel or
         sqzBullReAccel or
         microBullBreak
     )

bool bearCompressionBreakoutSetup =
     enableContinuation and
     bearCompressionBreakout and
     (
         rsiROC < 0 or
         sqzBearAccel or
         sqzBearReAccel or
         microBearBreak
     )
bool contTrendLongSetup =
     enableContinuation and
     continuationLongContext and
     recentBullImpulse and
     recentLongPB and
     longPullbackHold and
     (
         not hardBalanceRegime or
         longTopTierHold
     )

bool contTrendShortSetup =
     enableContinuation and
     continuationShortContext and
     recentBearImpulse and
     recentShortPB and
     shortPullbackHold and
     (
         not hardBalanceRegime or
         shortTopTierHold
     )


// Compatibility names retained, but these no longer create trades alone.
bool contStructLongSetup =
     contTrendLongSetup and structureLongEvidence

bool contStructShortSetup =
     contTrendShortSetup and structureShortEvidence


bool contTrendLongBase =
     contTrendLongSetup and contLongExecution

bool contTrendShortBase =
     contTrendShortSetup and contShortExecution

bool contStructLongBase =
     contTrendLongBase and structureLongEvidence

bool contStructShortBase =
     contTrendShortBase and structureShortEvidence


bool bullCompressionLongBase =
     (bullCompressionLongSetup or bullCompressionBreakoutSetup) and
     contLongExecution

bool bearCompressionShortBase =
     (bearCompressionShortSetup or bearCompressionBreakoutSetup) and
     contShortExecution


// Manual Structure still requires E.
// Structure creates the opportunity; Execution authorizes the FIRE.
bool manualLongBase =
     manualLongSetup and
     contLongExecution

bool manualShortBase =
     manualShortSetup and
     contShortExecution


bool continuationLongEligible =
     contTrendLongBase or
     bullCompressionLongBase or
     manualLongBase

bool continuationShortEligible =
     contTrendShortBase or
     bearCompressionShortBase or
     manualShortBase


//=============================================================================
// MR — REVERSAL ENGINE
//
// MR means the FIRST credible reversal of an established 5m trend.
// Once the opposite trend establishes, later entries are continuation.
//=============================================================================


// VWAP standard deviation is still valuable EXTENSION information,
// but it no longer defines reversal by itself.
bool mrLongSd1 =
     not na(futuresVwapLower1) and low <= futuresVwapLower1

bool mrLongSd2 =
     not na(futuresVwapLower2) and low <= futuresVwapLower2

bool mrLongSd3 =
     not na(futuresVwapLower3) and low <= futuresVwapLower3

bool mrShortSd1 =
     not na(futuresVwapUpper1) and high >= futuresVwapUpper1

bool mrShortSd2 =
     not na(futuresVwapUpper2) and high >= futuresVwapUpper2

bool mrShortSd3 =
     not na(futuresVwapUpper3) and high >= futuresVwapUpper3


float mrLongSdLocation =
     mrLongSd3 ? 10.0 :
     mrLongSd2 ? 8.0 :
     mrLongSd1 ? 6.0 :
     0.0

float mrShortSdLocation =
     mrShortSd3 ? 10.0 :
     mrShortSd2 ? 8.0 :
     mrShortSd1 ? 6.0 :
     0.0


// Preserve these names for downstream HUD/tooltips.
bool meaningfulLongExtreme = mrLongSd1
bool meaningfulShortExtreme = mrShortSd1


// Remember the trend that existed BEFORE the reversal.
int barsSinceEstablishedBullTrend =
     ta.barssince(bullTrendEstablished)

int barsSinceEstablishedBearTrend =
     ta.barssince(bearTrendEstablished)

bool recentEstablishedBullTrend =
     not na(barsSinceEstablishedBullTrend) and
     barsSinceEstablishedBullTrend <= 3

bool recentEstablishedBearTrend =
     not na(barsSinceEstablishedBearTrend) and
     barsSinceEstablishedBearTrend <= 3


// Mature impulse is a quality booster, not an absolute requirement.
// A legitimate local 5m trend can reverse without traveling 2.5 ATR first.
int barsSinceMatureBullMove =
     ta.barssince(bullTrend and matureBullImpulse)

int barsSinceMatureBearMove =
     ta.barssince(bearTrend and matureBearImpulse)

bool recentMatureBullMove =
     not na(barsSinceMatureBullMove) and
     barsSinceMatureBullMove <= 4

bool recentMatureBearMove =
     not na(barsSinceMatureBearMove) and
     barsSinceMatureBearMove <= 4


// Reversal must happen at a meaningful LASER location.
// VWAP / 1m200 can legitimately anchor the entire thesis.
bool mrLongLocationReady =
     mrLongSd1 or
     supportLocation >= 5 or
     near1m200 or
     nearVWAP or
     freshSweepLow

bool mrShortLocationReady =
     mrShortSd1 or
     resistanceLocation >= 5 or
     near1m200 or
     nearVWAP or
     freshSweepHigh


bool mrLongReaction =
     absorptionLongEvidence or
     bullReject or
     failedAuctionLongEvidence or
     bullishDisagreement or
     recentBullShift

bool mrShortReaction =
     absorptionShortEvidence or
     bearReject or
     failedAuctionShortEvidence or
     bearishDisagreement or
     recentBearShift


bool mrLongMomentumRotation =
     sqzBearDecel or
     rsiSharpUp or
     bullishDisagreement or
     bullZeroCross or
     rsiDivLongEvidence

bool mrShortMomentumRotation =
     sqzBullDecel or
     rsiSharpDown or
     bearishDisagreement or
     bearZeroCross or
     rsiDivShortEvidence


// Keep the actual MR window narrow.
// This prevents repeated MR labels halfway through a newly established trend.
//=============================================================================
// REVERSAL DETERIORATION MUST PRECEDE THE STRUCTURE FLIP
//=============================================================================

bool bullDeterioratingNow =
     bullDeterioration >= 2

bool bearDeterioratingNow =
     bearDeterioration >= 2

int barsSinceBullDeterioration =
     ta.barssince(bullDeterioratingNow)

int barsSinceBearDeterioration =
     ta.barssince(bearDeterioratingNow)

bool recentBullDeterioration =
     not na(barsSinceBullDeterioration) and
     barsSinceBullDeterioration <= 3

bool recentBearDeterioration =
     not na(barsSinceBearDeterioration) and
     barsSinceBearDeterioration <= 3

bool mrLongStructureShift =
     recentBearDeterioration and
     recentBullShift and
     barsSinceBullShift <= 1

bool mrShortStructureShift =
     recentBullDeterioration and
     recentBearShift and
     barsSinceBearShift <= 1


bool mrLongChangeState =
     execLayerActive ?
     (mrLongStructureShift and execLongTrigger) :
     (mrLongStructureShift and
      (microBullBreak or bullImpulse or bullZeroCross))

bool mrShortChangeState =
     execLayerActive ?
     (mrShortStructureShift and execShortTrigger) :
     (mrShortStructureShift and
      (microBearBreak or bearImpulse or bearZeroCross))


// Compatibility names.
bool mrLongExcursion = mrLongLocationReady
bool mrShortExcursion = mrShortLocationReady


// Reversal thesis can become ARMED before E actually triggers.
bool mrLongSetupReady =
     enableMeanReversion and
     recentEstablishedBearTrend and
     not bullTrendEstablished and
     mrLongLocationReady and
     bearDeterioration >= 2 and
     mrLongReaction and
     mrLongMomentumRotation and
     mrLongStructureShift

bool mrShortSetupReady =
     enableMeanReversion and
     recentEstablishedBullTrend and
     not bearTrendEstablished and
     mrShortLocationReady and
     bullDeterioration >= 2 and
     mrShortReaction and
     mrShortMomentumRotation and
     mrShortStructureShift

// E still controls actual eligibility/FIRE.
bool meanReversionLongEligible =
     mrLongSetupReady and
     mrLongChangeState

bool meanReversionShortEligible =
     mrShortSetupReady and
     mrShortChangeState


//=============================================================================
// 26 — THESIS QUALITY SCORING
//
// ELIGIBILITY comes from the sequence above.
// SCORE tells us how GOOD the valid setup is.
//=============================================================================

float continuationLongScore = 0
float continuationShortScore = 0


//-----------------------------------------------------------------------------
// CONTINUATION LONG
//-----------------------------------------------------------------------------

if contTrendLongSetup or
   bullCompressionLongSetup or
   bullCompressionBreakoutSetup or
   manualLongSetup

    continuationLongScore := 50

// A — local trend/alignment
if strongBullTrend
    continuationLongScore += 8
else
    continuationLongScore += 4

    if bull15Context
        continuationLongScore += 6
    else
        continuationLongScore -= 4

    if bull60Context
        continuationLongScore += 2

    // L — pullback location
    continuationLongScore += math.min(longTouchScore, 8)

    if near1m200
        continuationLongScore += 10

    if nearVWAP
        continuationLongScore += 10

    if near1m200 and nearVWAP
        continuationLongScore += 3

        // S — hold / structure

    if bullCompressionActive
        continuationLongScore += 10

    if bullCompressionMature
        continuationLongScore += 4

    if recentBullCompressionSupportTouch
        continuationLongScore += 5

    if bullCompressionBreakout
        continuationLongScore += 8

    if longTopTierHold
        continuationLongScore += 6

    if higherLow or bullReject
        continuationLongScore += 4

    if structureLongEvidence
        continuationLongScore += 5

    if absorptionLongEvidence
        continuationLongScore += 5

    // E / momentum
    if sqzBullReAccel
        continuationLongScore += 6

    if rsiROC > 0
        continuationLongScore += 4

    if finalBullMove
        continuationLongScore += 4

    if breakoutLongEvidence
        continuationLongScore += 3

    // Opposing evidence matters.
    if absorptionShortEvidence or finalBearMove
        continuationLongScore -= 10

    // R — definable risk and room
    if f_riskPass(contLongRisk) and
       contLongRoom >= minimumRoomR
        continuationLongScore += 8


//-----------------------------------------------------------------------------
// CONTINUATION SHORT
//-----------------------------------------------------------------------------

if contTrendShortSetup or
   bearCompressionShortSetup or
   bearCompressionBreakoutSetup or
   manualShortSetup

    continuationShortScore := 50

if strongBearTrend
    continuationShortScore += 8
else
    continuationShortScore += 4

    if bear15Context
        continuationShortScore += 6
    else
        continuationShortScore -= 4

    if bear60Context
        continuationShortScore += 2

    continuationShortScore += math.min(shortTouchScore, 8)

    if near1m200
        continuationShortScore += 10

    if nearVWAP
        continuationShortScore += 10

    if near1m200 and nearVWAP
        continuationShortScore += 3

    if bearCompressionActive
        continuationShortScore += 10

    if bearCompressionMature
        continuationShortScore += 4

    if recentBearCompressionResistanceTouch
        continuationShortScore += 5

    if bearCompressionBreakout
        continuationShortScore += 8

    if shortTopTierHold
        continuationShortScore += 6

    if lowerHigh or bearReject
        continuationShortScore += 4

    if structureShortEvidence
        continuationShortScore += 5

    if absorptionShortEvidence
        continuationShortScore += 5

    if sqzBearReAccel
        continuationShortScore += 6

    if rsiROC < 0
        continuationShortScore += 4

    if finalBearMove
        continuationShortScore += 4

    if breakoutShortEvidence
        continuationShortScore += 3

    if absorptionLongEvidence or finalBullMove
        continuationShortScore -= 10

    if f_riskPass(contShortRisk) and
       contShortRoom >= minimumRoomR
        continuationShortScore += 8

//=============================================================================
// MANUAL STRUCTURE QUALITY
//
// Structural TL > Impulse TL.
// Spatial stack of independent levels receives an additional bonus.
//=============================================================================

if manualStructureLongSetup
    continuationLongScore += 12
    continuationLongScore +=
         math.min(supportLocation, 8)

if manualStructureShortSetup
    continuationShortScore += 12
    continuationShortScore +=
         math.min(resistanceLocation, 8)


if manualImpulseLongSetup
    continuationLongScore += 6

if manualImpulseShortSetup
    continuationShortScore += 6


if manualLongSetup and manualLongStacked
    continuationLongScore += 8

if manualShortSetup and manualShortStacked
    continuationShortScore += 8

continuationLongScore :=
     math.max(0, math.min(continuationLongScore, 100))

continuationShortScore :=
     math.max(0, math.min(continuationShortScore, 100))


//=============================================================================
// MR / REVERSAL QUALITY
//=============================================================================

float meanReversionLongScore = 0
float meanReversionShortScore = 0


//-----------------------------------------------------------------------------
// MR LONG — bearish 5m trend reversing bullish
//-----------------------------------------------------------------------------

if mrLongSetupReady

    meanReversionLongScore := 35

    // Previous trend had real maturity.
    if recentMatureBearMove
        meanReversionLongScore += 8

    // L
    meanReversionLongScore +=
         math.min(supportLocation, 8)

    meanReversionLongScore +=
         mrLongSdLocation * 1.2

    if near1m200
        meanReversionLongScore += 10

    if nearVWAP
        meanReversionLongScore += 10

    // A/S — deterioration and failure
    meanReversionLongScore +=
         math.min(float(bearDeterioration) * 5.0, 15.0)

    if absorptionLongEvidence
        meanReversionLongScore += 8

    if failedAuctionLongEvidence
        meanReversionLongScore += 6

    if rsiDivLongEvidence
        meanReversionLongScore += 8

    if divLongStrong
        meanReversionLongScore += 4

    if sqzBearDecel
        meanReversionLongScore += 6

    if rsiSharpUp
        meanReversionLongScore += 6

    // Structure change is mandatory and deserves weight.
    if mrLongStructureShift
        meanReversionLongScore += 10

    // E
    if execLayerActive and execLongTrigger
        meanReversionLongScore += 8

    // HTF can SUPPORT the local reversal but never veto it.
    if bull15Context
        meanReversionLongScore += 5

    if bull60Context
        meanReversionLongScore += 2

    if finalBearMove
        meanReversionLongScore -= 10

    // R
    if f_riskPass(mrLongRisk) and
       mrLongRoom >= minimumRoomR
        meanReversionLongScore += 8


//-----------------------------------------------------------------------------
// MR SHORT — bullish 5m trend reversing bearish
//-----------------------------------------------------------------------------

if mrShortSetupReady

    meanReversionShortScore := 35

    if recentMatureBullMove
        meanReversionShortScore += 8

    meanReversionShortScore +=
         math.min(resistanceLocation, 8)

    meanReversionShortScore +=
         mrShortSdLocation * 1.2

    if near1m200
        meanReversionShortScore += 10

    if nearVWAP
        meanReversionShortScore += 10

    meanReversionShortScore +=
         math.min(float(bullDeterioration) * 5.0, 15.0)

    if absorptionShortEvidence
        meanReversionShortScore += 8

    if failedAuctionShortEvidence
        meanReversionShortScore += 6

    if rsiDivShortEvidence
        meanReversionShortScore += 8

    if divShortStrong
        meanReversionShortScore += 4

    if sqzBullDecel
        meanReversionShortScore += 6

    if rsiSharpDown
        meanReversionShortScore += 6

    if mrShortStructureShift
        meanReversionShortScore += 10

    if execLayerActive and execShortTrigger
        meanReversionShortScore += 8

    if bear15Context
        meanReversionShortScore += 5

    if bear60Context
        meanReversionShortScore += 2

    if finalBullMove
        meanReversionShortScore -= 10

    if f_riskPass(mrShortRisk) and
       mrShortRoom >= minimumRoomR
        meanReversionShortScore += 8


meanReversionLongScore :=
     math.max(0, math.min(meanReversionLongScore, 100))

meanReversionShortScore :=
     math.max(0, math.min(meanReversionShortScore, 100))

//=============================================================================
// 27 — ROUTER / DECISION
//=============================================================================
float requiredScore = preset == "Aggressive" ? 60 : preset == "Conservative" ? 80 : 70

float bestLongScore = 0
string bestLongCode = ""

// Trend-aligned continuation owns the thesis when it exists.
// Outside a directional trend, eligible theses may still compete by score.
bool continuationOwnsLong = bullTrend and continuationLongEligible

if continuationLongEligible and continuationLongScore > bestLongScore
    bestLongScore := continuationLongScore
    bestLongCode := "C"

if meanReversionLongEligible and not continuationOwnsLong and meanReversionLongScore > bestLongScore
    bestLongScore := meanReversionLongScore
    bestLongCode := "MR"


float bestShortScore = 0
string bestShortCode = ""

bool continuationOwnsShort = bearTrend and continuationShortEligible

if continuationShortEligible and continuationShortScore > bestShortScore
    bestShortScore := continuationShortScore
    bestShortCode := "C"

if meanReversionShortEligible and not continuationOwnsShort and meanReversionShortScore > bestShortScore
    bestShortScore := meanReversionShortScore
    bestShortCode := "MR"

float bestLongStop = bestLongCode == "C" ? contLongStop : bestLongCode == "MR" ? mrLongStop : na
float bestShortStop = bestShortCode == "C" ? contShortStop : bestShortCode == "MR" ? mrShortStop : na
float bestLongEntry = execLayerActive and execLongTrigger and not na(execLongPrice) ? execLongPrice : close
float bestShortEntry = execLayerActive and execShortTrigger and not na(execShortPrice) ? execShortPrice : close
float bestLongRisk = f_longRiskAt(bestLongStop, bestLongEntry)
float bestShortRisk = f_shortRiskAt(bestShortStop, bestShortEntry)
float bestLongRoom =
     bestLongCode == "C" ? f_longRoomTo(bestLongRisk, nearestAboveExternal) :
     bestLongCode == "MR" ? f_longRoomTo(bestLongRisk, nearestAbove) :
     0.0

float bestShortRoom =
     bestShortCode == "C" ? f_shortRoomTo(bestShortRisk, nearestBelowExternal) :
     bestShortCode == "MR" ? f_shortRoomTo(bestShortRisk, nearestBelow) :
     0.0

bool haveQualifiedLong = bestLongCode != "" and bestLongScore >= requiredScore
bool haveQualifiedShort = bestShortCode != "" and bestShortScore >= requiredScore
string thesisState = hardBalanceRegime and not haveQualifiedLong and not haveQualifiedShort ? "WAIT — BALANCE" : haveQualifiedLong and not haveQualifiedShort ? "LONG " + bestLongCode : haveQualifiedShort and not haveQualifiedLong ? "SHORT " + bestShortCode : haveQualifiedLong and haveQualifiedShort ? (bestLongScore > bestShortScore ? "LONG " + bestLongCode : bestShortScore > bestLongScore ? "SHORT " + bestShortCode : "CONFLICT") : "WAIT"

// Viewport-dependent VP modes are live-only; developing Globex can evaluate normally.
bool vpSignalAllowed = not liveOnlyVpMode or barstate.islast

//=============================================================================
// 28 — FIRE / ACTIVE TRADE STATE — v7.2 intrabar-priced
//=============================================================================
// Lightweight live state only. Historical research counters are intentionally
// absent from the cockpit build.
var bool tradeActive = false
var int tradeDirectionState = 0
var int tradeEntryBar = na
var int tradeEntryTime = na
var float tradeEntry = na
var float tradeStop = na
var float tradeTP1 = na
var float tradeTP2 = na
var float tradeRisk = na
var float tradeScore = na
var string tradeCode = ""
var string tradeGrade = ""
var string tradeReason = ""
var string tradeModifiers = ""
var bool tradeTP1Done = false
var int lastSignalBar = na
var string lastTradeSummary = "—"
//=============================================================================
// REALTIME FIRE LATCH
// First visible FIRE owns its Entry / SL / TP.
// It may repaint until its confirmation window closes.
//=============================================================================
varip bool liveFireProvisional = false
varip bool liveFireConfirmed = false

varip int liveFireDir = 0
varip int liveFireEntryBar = na
varip int liveFireBucket = na

varip float liveFireEntry = na
varip float liveFireStop = na
varip float liveFireRisk = na
varip float liveFireTP1 = na
varip float liveFireTP2 = na
varip float liveFireScore = na

varip string liveFireCode = ""
varip string liveFireGrade = ""
varip string liveFireReason = ""
varip string liveFireModifiers = ""

var line entryLine = na
var line stopLine = na
var line tp1Line = na
var line tp2Line = na
var label latestTradeLabel = na
var label activeTradeLabel = na

//=============================================================================
// ACTIVE SIMULATED TRADE RESET
//
// This affects ONLY the currently displayed/tracked simulated trade.
// Historical FIRE labels and independent outcome records remain untouched.
//
// 1. Every new futures/Globex session clears stale active trade state.
// 2. Manual Trade Clear Cutoff clears any tracked trade entered at/before
//    the selected cutoff time.
//=============================================================================

int manualTradeClearCutoff =
     manualClearYear > 0 ?
     timestamp(
          sessionTimezone,
          manualClearYear,
          manualClearMonth,
          manualClearDay,
          manualClearHour,
          manualClearMinute,
          0) :
     0

bool manualTrackedTradeExpired =
     manualTradeClearCutoff > 0 and
     tradeActive and
     not na(tradeEntryTime) and
     tradeEntryTime <= manualTradeClearCutoff

bool autoGlobexTradeReset =
     newFuturesSession and
     tradeActive

if autoGlobexTradeReset or manualTrackedTradeExpired
    tradeActive := false
    tradeDirectionState := 0
    tradeEntryBar := na
    tradeEntryTime := na

    tradeEntry := na
    tradeStop := na
    tradeTP1 := na
    tradeTP2 := na
    tradeRisk := na
    tradeScore := na

    tradeCode := ""
    tradeGrade := ""
    tradeReason := ""
    tradeModifiers := ""

    tradeTP1Done := false
    activeTradeLabel := na
    lastTradeSummary := "—"

//=============================================================================
// INDEPENDENT HISTORICAL FIRE OUTCOME TRACKING
//=============================================================================
var int signalSerial = 0
var int latestTrackedSignalId = na

var array<int> histIds = array.new_int()
var array<int> histDirs = array.new_int()
var array<int> histBars = array.new_int()
var array<float> histStops = array.new_float()
var array<float> histTP1s = array.new_float()
var array<label> histLabels = array.new_label()
var array<string> histReasons = array.new_string()

int visibleSignalBars = math.max(1, math.round((visibleRightTime - visibleLeftTime) / barDurationMS) + 1)
signalTabTextSize = switch signalTabSizeInput
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal
    "Large"  => size.large
    => visibleSignalBars >= 140 ? size.tiny : visibleSignalBars >= 70 ? size.small : size.normal
    // Keep existing FIRE tabs synchronized with Auto sizing as viewport changes.
if barstate.islast
    int signalLabelCount = array.size(histLabels)

    if signalLabelCount > 0
        for i = 0 to signalLabelCount - 1
            label sigLabel = array.get(histLabels, i)

            if not na(sigLabel)
                label.set_size(sigLabel, signalTabTextSize)

    if not na(activeTradeLabel)
        label.set_size(activeTradeLabel, signalTabTextSize)

    if not na(latestTradeLabel)
        label.set_size(latestTradeLabel, signalTabTextSize)

f_modifiers(bool sw, bool exh, bool absb, bool strc, bool div, bool fa, bool boa, bool sqz, bool hv, bool strongDiv) =>
    string t = ""
    if div
        t += strongDiv ? "DIV+ " : "DIV "
    if exh
        t += "EXH "
    if fa
        t += "FA "
    if sw
        t += "SW "
    if strc
        t += "STR "
    if absb
        t += "ABS "
    if boa
        t += "BOA "
    if sqz
        t += "SQZ "
    if hv
        t += "HV "
    t == "" ? "—" : t

f_grade(float score, bool divPresent, bool divStrongPriceNow, bool divExh, bool divFa) =>
    string g = score >= 90 ? "A+" : score >= 80 ? "A" : "B"
    if divPresent and divStrongPriceNow and (divExh or divFa)
        g := "A+"
    else if divPresent and (divStrongPriceNow or divExh or divFa) and g == "B"
        g := "A"
    g

f_divHud(bool recentDiv, bool strongPriceDiv, bool inZone, int age, float priceAtr) =>
    string d = "—"
    if recentDiv
        d := strongPriceDiv ? "DIV+" : "DIV"
        d += " a" + str.tostring(age)
        if not na(priceAtr)
            d += " " + str.tostring(priceAtr, "#.2") + "A"
        if inZone
            d += " Z"
    d

bool barAllowed = (not requireClosedBar or barstate.isconfirmed) and vpSignalAllowed
bool cooldownComplete = na(lastSignalBar) or bar_index - lastSignalBar >= signalCooldown
bool allowLong = tradeDirection != "Short Only"
bool allowShort = tradeDirection != "Long Only"

//=============================================================================
// SIGNAL GENERATION IS INDEPENDENT OF SIMULATED TRADE TRACKING
//
// tradeActive is informational only.
// An older simulated Entry / SL / TP state can NEVER veto a new valid FIRE.
//=============================================================================

bool longQualified =
     allowLong and
     barAllowed and
     cooldownComplete and
     haveQualifiedLong and
     f_riskPass(bestLongRisk)

bool shortQualified =
     allowShort and
     barAllowed and
     cooldownComplete and
     haveQualifiedShort and
     f_riskPass(bestShortRisk)

bool longFire =
     longQualified and
     (not shortQualified or bestLongScore > bestShortScore)

bool shortFire =
     shortQualified and
     (not longQualified or bestShortScore > bestLongScore)

//=============================================================================
// FINAL FIRE GATE DIAGNOSTIC
//=============================================================================

string longFireGate = "NO THESIS"
string shortFireGate = "NO THESIS"

// LONG
if longFire
    longFireGate := "FIRE"
else if not allowLong
    longFireGate := "LONG DISABLED"
else if not barAllowed
    longFireGate := "BAR / VP BLOCK"
else if not cooldownComplete
    longFireGate := "COOLDOWN"
else if not haveQualifiedLong
    longFireGate := "SETUP NOT ELIGIBLE"
else if not f_riskPass(bestLongRisk)
    longFireGate := "RISK BLOCK"
else if na(bestLongRoom) or bestLongRoom < minimumRoomR
    longFireGate := "ROOM BLOCK"
else if shortQualified and bestShortScore >= bestLongScore
    longFireGate := "OPPOSING / TIE"
else
    longFireGate := "READY"

// SHORT
if shortFire
    shortFireGate := "FIRE"
else if not allowShort
    shortFireGate := "SHORT DISABLED"
else if not barAllowed
    shortFireGate := "BAR / VP BLOCK"
else if not cooldownComplete
    shortFireGate := "COOLDOWN"
else if not haveQualifiedShort
    shortFireGate := "SETUP NOT ELIGIBLE"
else if not f_riskPass(bestShortRisk)
    shortFireGate := "RISK BLOCK"
else if na(bestShortRoom) or bestShortRoom < minimumRoomR
    shortFireGate := "ROOM BLOCK"
else if longQualified and bestLongScore >= bestShortScore
    shortFireGate := "OPPOSING / TIE"
else
    shortFireGate := "READY"


//=============================================================================
// EXACT REALTIME FIRE PRICE
//
// The lower-TF layer still determines whether E exists.
// But once LASER actually displays FIRE, the modeled entry is the LIVE price
// at that exact update — not a price that is allowed to keep moving later.
//=============================================================================

float liveLongRiskNow = f_longRiskAt(bestLongStop, close)
float liveShortRiskNow = f_shortRiskAt(bestShortStop, close)

float liveLongRoomNow =
     bestLongCode == "C" ? f_longRoomTo(liveLongRiskNow, nearestAboveExternal) :
     bestLongCode == "MR" ? f_longRoomTo(liveLongRiskNow, nearestAbove) :
     0.0

float liveShortRoomNow =
     bestShortCode == "C" ? f_shortRoomTo(liveShortRiskNow, nearestBelowExternal) :
     bestShortCode == "MR" ? f_shortRoomTo(liveShortRiskNow, nearestBelow) :
     0.0

// Because the actual modeled entry is now the FIRE-tick price, make sure
// that exact entry still passes LASER's risk and room requirements.
bool liveLongFireCanLatch =
     longFire and
     f_riskPass(liveLongRiskNow)

bool liveShortFireCanLatch =
     shortFire and
     f_riskPass(liveShortRiskNow)


//=============================================================================
// CONFIRMATION WINDOW
//
// With 1m execution enabled on the 5m chart:
// provisional FIRE survives/repaints until that 1m time window finishes.
//
// Without lower-TF execution:
// provisional FIRE survives/repaints until the chart bar finishes.
//=============================================================================

float confirmTfSeconds =
     execLayerActive ?
     executionTfSeconds :
     timeframe.in_seconds(timeframe.period)

int confirmTfMs =
     int(math.max(nz(confirmTfSeconds, 60.0), 1.0) * 1000.0)

int currentConfirmBucket =
     int(math.floor(float(timenow) / float(confirmTfMs)))


// Event booleans.
// Unlike longFire/shortFire, these are TRUE only on the update where
// a NEW FIRE actually appears.
bool longFireEvent = false
bool shortFireEvent = false


// Every new chart bar starts with no uncommitted realtime FIRE.
if barstate.isnew
    liveFireProvisional := false
    liveFireConfirmed := false
    liveFireDir := 0
    liveFireEntryBar := na
    liveFireBucket := na

    liveFireEntry := na
    liveFireStop := na
    liveFireRisk := na
    liveFireTP1 := na
    liveFireTP2 := na
    liveFireScore := na

    liveFireCode := ""
    liveFireGrade := ""
    liveFireReason := ""
    liveFireModifiers := ""


//=============================================================================
// REALTIME PROVISIONAL FIRE MANAGEMENT
//=============================================================================

if barstate.isrealtime

    // ------------------------------------------------------------
    // A FIRE already appeared but its confirmation window is open.
    // ------------------------------------------------------------
    if liveFireProvisional

        bool provisionalStillValid =
             liveFireDir == 1 ? longFire : shortFire

        // Signal repainted before confirmation.
        // Drop the provisional latch completely.
        if not provisionalStillValid
            liveFireProvisional := false
            liveFireConfirmed := false
            liveFireDir := 0

        // Signal survived its confirmation window.
        // Entry / SL / TP remain EXACTLY where they originally fired.
        else if barstate.isconfirmed or currentConfirmBucket > liveFireBucket
            liveFireProvisional := false
            liveFireConfirmed := true


    // ------------------------------------------------------------
    // Nothing currently latched:
    // the first valid FIRE owns the entry.
    // ------------------------------------------------------------
    if not liveFireProvisional and not liveFireConfirmed and
       (liveLongFireCanLatch or liveShortFireCanLatch)

        bool fireLongNow = liveLongFireCanLatch

        float fireScoreNow =
             fireLongNow ? bestLongScore : bestShortScore

        string fireCodeNow =
             fireLongNow ? bestLongCode : bestShortCode

        float fireEntryNow = close

        float fireStopNow =
             fireLongNow ? bestLongStop : bestShortStop

        float fireRiskNow =
             fireLongNow ? liveLongRiskNow : liveShortRiskNow

        float fireRoomNow =
             fireLongNow ? liveLongRoomNow : liveShortRoomNow

        bool fireSweepNow =
             fireLongNow ? sweepLongEvidence : sweepShortEvidence

        bool fireExhaustionNow =
             fireLongNow ? exhaustionLongEvidence : exhaustionShortEvidence

        bool fireAbsorptionNow =
             fireLongNow ? absorptionLongEvidence : absorptionShortEvidence

        bool fireStructureNow =
             fireLongNow ? structureLongEvidence : structureShortEvidence

        bool fireDivNow =
             fireLongNow ? rsiDivLongEvidence : rsiDivShortEvidence

        bool fireFaNow =
             fireLongNow ? failedAuctionLongEvidence : failedAuctionShortEvidence

        bool fireBoaNow =
             fireLongNow ? breakoutLongEvidence : breakoutShortEvidence

        bool fireSqzNow =
             fireLongNow ? squeezeLongEvidence : squeezeShortEvidence

        bool fireStrongDivNow =
             fireLongNow ? divLongStrong : divShortStrong

        bool fireDivZoneNow =
             fireLongNow ? divLongZone : divShortZone

        bool fireDivExhNow =
             fireLongNow ? divLongExhaustionCombo : divShortExhaustionCombo

        bool fireDivFaNow =
             fireLongNow ? divLongFailedAuctionCombo : divShortFailedAuctionCombo

        int fireDivAgeNow =
             fireDivNow ?
             (fireLongNow ? barsSinceRsiBullDiv : barsSinceRsiBearDiv) :
             na

        float fireDivGapNow =
             fireDivNow ?
             (fireLongNow ? lastBullDivRsiGap : lastBearDivRsiGap) :
             na

        float fireDivPriceAtrNow =
             fireDivNow ?
             (fireLongNow ? lastBullDivPriceAtr : lastBearDivPriceAtr) :
             na

        float fireDivPivotRsiNow =
             fireDivNow ?
             (fireLongNow ? lastBullDivPivotRsi : lastBearDivPivotRsi) :
             na

        float fireLocationNow =
             fireLongNow ? supportLocation : resistanceLocation

        string fireWhyNow =
             fireLongNow ? supportWhy : resistanceWhy

        string modsNow =
             f_modifiers(
                  fireSweepNow,
                  fireExhaustionNow,
                  fireAbsorptionNow,
                  fireStructureNow,
                  fireDivNow,
                  fireFaNow,
                  fireBoaNow,
                  fireSqzNow,
                  highVolume,
                  fireStrongDivNow)

        string gradeNow =
             f_grade(
                  fireScoreNow,
                  fireDivNow,
                  fireStrongDivNow,
                  fireDivExhNow,
                  fireDivFaNow)

        string thesisExplanationNow = ""

        if fireCodeNow == "MR"
            thesisExplanationNow := "REVERSAL: established 5m trend deteriorated, structure shifted, and execution confirmed."
        else
            thesisExplanationNow := "CONTINUATION: trend, impulse, pullback, hold, and execution are aligned."

        string reasonNow =
             (fireLongNow ? "LASER LONG " : "LASER SHORT ") +
             fireCodeNow +
             "  [" +
             gradeNow +
             "]"

        reasonNow += "\n" + thesisExplanationNow

        reasonNow +=
             "\nScore: " +
             str.tostring(fireScoreNow, "#.0") +
             "/100  |  Required: " +
             str.tostring(requiredScore, "#")

        reasonNow += "\nModifiers: " + modsNow

        reasonNow +=
             "\n\nRegime: " +
             regime +
             "  |  Balance: " +
             str.tostring(balanceScore, "#") +
             "%"

        reasonNow +=
             "\nAuction: " +
             auctionState +
             "  |  Energy: " +
             energyState

        reasonNow +=
             "\nLocation: " +
             str.tostring(fireLocationNow, "#.0") +
             "/10  |  " +
             (fireWhyNow == "" ? "No named level" : fireWhyNow)

        reasonNow +=
             "\nVolume: " +
             str.tostring(relativeVolume, "#.00") +
             "x"

        reasonNow +=
             "\nRSI: " +
             str.tostring(rsi, "#.1") +
             "  Δ " +
             str.tostring(rsiROC, "#.00") +
             "  A " +
             str.tostring(rsiAccel, "#.00")

        if fireDivNow
            reasonNow += "\n\nRSI DIVERGENCE CONFIRMATION"

            reasonNow +=
                 "\nAge: " +
                 str.tostring(fireDivAgeNow) +
                 " bars since confirmation"

            reasonNow +=
                 "\nPrice overshoot: " +
                 str.tostring(fireDivPriceAtrNow, "#.2") +
                 " ATR" +
                 (fireStrongDivNow ? "  [STRONG]" : "")

            reasonNow +=
                 "\nRSI pivot separation: " +
                 str.tostring(fireDivGapNow, "#.1") +
                 " points"

            reasonNow +=
                 "\nSecond-pivot RSI: " +
                 str.tostring(fireDivPivotRsiNow, "#.1") +
                 (fireDivZoneNow ? "  [ZONE]" : "")

            if fireDivExhNow
                reasonNow += "\nDIV + exhaustion confluence"

            if fireDivFaNow
                reasonNow += "\nDIV + failed-auction confluence"

        reasonNow +=
             "\nSQZ: " +
             str.tostring(sqzMomentum, "#.00") +
             "  Δ " +
             str.tostring(sqzROC, "#.00") +
             "  A " +
             str.tostring(sqzAccel, "#.00")

        reasonNow +=
             "\n\nRisk: " +
             str.tostring(fireRiskNow, "#.1") +
             " pts  |  Room: " +
             str.tostring(fireRoomNow, "#.2") +
             "R"

        reasonNow +=
             "\nEntry: " +
             str.tostring(fireEntryNow, format.mintick) +
             "  |  SL: " +
             str.tostring(fireStopNow, format.mintick)

        reasonNow +=
             "\nExecution: " +
             (execLayerActive ?
              "1m change-of-state; price locked at FIRE" :
              "chart-TF change-of-state; price locked at FIRE")

        if fireCodeNow == "MR"
            reasonNow +=
                 "  |  VWAP SD: " +
                 str.tostring(
                      fireLongNow ?
                      mrLongSdLocation :
                      mrShortSdLocation,
                      "#.0") +
                 "/10"

        float fireTP1Now =
             fireLongNow ?
             fireEntryNow + fireRiskNow * tp1R :
             fireEntryNow - fireRiskNow * tp1R

        float fireTP2Now =
             fireLongNow ?
             fireEntryNow + fireRiskNow * tp2R :
             fireEntryNow - fireRiskNow * tp2R

        reasonNow +=
             "\nTP1: " +
             str.tostring(fireTP1Now, format.mintick)


        // --------------------------
        // LATCH THE FIRE
        // --------------------------

        liveFireDir := fireLongNow ? 1 : -1
        liveFireEntryBar := bar_index
        liveFireBucket := currentConfirmBucket

        liveFireEntry := fireEntryNow
        liveFireStop := fireStopNow
        liveFireRisk := fireRiskNow
        liveFireTP1 := fireTP1Now
        liveFireTP2 := fireTP2Now
        liveFireScore := fireScoreNow

        liveFireCode := fireCodeNow
        liveFireGrade := gradeNow
        liveFireReason := reasonNow
        liveFireModifiers := modsNow

        liveFireProvisional := not barstate.isconfirmed
        liveFireConfirmed := barstate.isconfirmed

        longFireEvent := fireLongNow
        shortFireEvent := not fireLongNow


// Historical bars cannot reproduce the exact realtime tick that originally
// caused FIRE, so retain the existing historical qualification behavior.
else
    longFireEvent := longFire
    shortFireEvent := shortFire


//=============================================================================
// DISPLAY / TRADE STATE
//=============================================================================

bool renderFire =
     barstate.isrealtime ?
     (liveFireProvisional or liveFireConfirmed) :
     (longFire or shortFire)

if renderFire

    bool fireLong =
         barstate.isrealtime ?
         liveFireDir == 1 :
         longFire

    float fireScore =
         barstate.isrealtime ?
         liveFireScore :
         (fireLong ? bestLongScore : bestShortScore)

    string fireCode =
         barstate.isrealtime ?
         liveFireCode :
         (fireLong ? bestLongCode : bestShortCode)

    float fireStop =
         barstate.isrealtime ?
         liveFireStop :
         (fireLong ? bestLongStop : bestShortStop)

    float fireEntry =
         barstate.isrealtime ?
         liveFireEntry :
         (fireLong ? bestLongEntry : bestShortEntry)

    float fireRisk =
         barstate.isrealtime ?
         liveFireRisk :
         (fireLong ? bestLongRisk : bestShortRisk)

    float fireTP1 =
         barstate.isrealtime ?
         liveFireTP1 :
         (fireLong ?
          fireEntry + fireRisk * tp1R :
          fireEntry - fireRisk * tp1R)

    float fireTP2 =
         barstate.isrealtime ?
         liveFireTP2 :
         (fireLong ?
          fireEntry + fireRisk * tp2R :
          fireEntry - fireRisk * tp2R)

    int fireEntryBar =
         barstate.isrealtime ?
         liveFireEntryBar :
         bar_index

    string mods = ""
    string grade = ""
    string reason = ""

    if barstate.isrealtime

        mods := liveFireModifiers
        grade := liveFireGrade
        reason := liveFireReason

    else

        float fireRoom =
             fireLong ? bestLongRoom : bestShortRoom

        float fireLocation =
             fireLong ? supportLocation : resistanceLocation

        string fireWhy =
             fireLong ? supportWhy : resistanceWhy

        bool fireSweep =
             fireLong ? sweepLongEvidence : sweepShortEvidence

        bool fireExhaustion =
             fireLong ? exhaustionLongEvidence : exhaustionShortEvidence

        bool fireAbsorption =
             fireLong ? absorptionLongEvidence : absorptionShortEvidence

        bool fireStructure =
             fireLong ? structureLongEvidence : structureShortEvidence

        bool fireDiv =
             fireLong ? rsiDivLongEvidence : rsiDivShortEvidence

        bool fireFa =
             fireLong ? failedAuctionLongEvidence : failedAuctionShortEvidence

        bool fireBoa =
             fireLong ? breakoutLongEvidence : breakoutShortEvidence

        bool fireSqz =
             fireLong ? squeezeLongEvidence : squeezeShortEvidence

        bool fireStrongDiv =
             fireLong ? divLongStrong : divShortStrong

        bool fireDivZone =
             fireLong ? divLongZone : divShortZone

        bool fireDivExh =
             fireLong ? divLongExhaustionCombo : divShortExhaustionCombo

        bool fireDivFa =
             fireLong ? divLongFailedAuctionCombo : divShortFailedAuctionCombo

        int fireDivAge =
             fireDiv ?
             (fireLong ? barsSinceRsiBullDiv : barsSinceRsiBearDiv) :
             na

        float fireDivGap =
             fireDiv ?
             (fireLong ? lastBullDivRsiGap : lastBearDivRsiGap) :
             na

        float fireDivPriceAtr =
             fireDiv ?
             (fireLong ? lastBullDivPriceAtr : lastBearDivPriceAtr) :
             na

        float fireDivPivotRsi =
             fireDiv ?
             (fireLong ? lastBullDivPivotRsi : lastBearDivPivotRsi) :
             na

        mods :=
             f_modifiers(
                  fireSweep,
                  fireExhaustion,
                  fireAbsorption,
                  fireStructure,
                  fireDiv,
                  fireFa,
                  fireBoa,
                  fireSqz,
                  highVolume,
                  fireStrongDiv)

        grade :=
             f_grade(
                  fireScore,
                  fireDiv,
                  fireStrongDiv,
                  fireDivExh,
                  fireDivFa)

        string thesisExplanation = ""

        if fireCode == "MR"
            thesisExplanation := "REVERSAL: established 5m trend deteriorated, structure shifted, and execution confirmed."
        else
            thesisExplanation := "CONTINUATION: trend, impulse, pullback, hold, and execution are aligned."

        reason :=
             (fireLong ? "LASER LONG " : "LASER SHORT ") +
             fireCode +
             "  [" +
             grade +
             "]"

        reason += "\n" + thesisExplanation

        reason +=
             "\nScore: " +
             str.tostring(fireScore, "#.0") +
             "/100  |  Required: " +
             str.tostring(requiredScore, "#")

        reason += "\nModifiers: " + mods

        reason +=
             "\n\nRegime: " +
             regime +
             "  |  Balance: " +
             str.tostring(balanceScore, "#") +
             "%"

        reason +=
             "\nAuction: " +
             auctionState +
             "  |  Energy: " +
             energyState

        reason +=
             "\nLocation: " +
             str.tostring(fireLocation, "#.0") +
             "/10  |  " +
             (fireWhy == "" ? "No named level" : fireWhy)

        reason +=
             "\nVolume: " +
             str.tostring(relativeVolume, "#.00") +
             "x"

        reason +=
             "\nRSI: " +
             str.tostring(rsi, "#.1") +
             "  Δ " +
             str.tostring(rsiROC, "#.00") +
             "  A " +
             str.tostring(rsiAccel, "#.00")

        if fireDiv
            reason += "\n\nRSI DIVERGENCE CONFIRMATION"
            reason += "\nAge: " + str.tostring(fireDivAge) + " bars since confirmation"
            reason += "\nPrice overshoot: " + str.tostring(fireDivPriceAtr, "#.2") + " ATR" + (fireStrongDiv ? "  [STRONG]" : "")
            reason += "\nRSI pivot separation: " + str.tostring(fireDivGap, "#.1") + " points"
            reason += "\nSecond-pivot RSI: " + str.tostring(fireDivPivotRsi, "#.1") + (fireDivZone ? "  [ZONE]" : "")

            if fireDivExh
                reason += "\nDIV + exhaustion confluence"

            if fireDivFa
                reason += "\nDIV + failed-auction confluence"

        reason +=
             "\nSQZ: " +
             str.tostring(sqzMomentum, "#.00") +
             "  Δ " +
             str.tostring(sqzROC, "#.00") +
             "  A " +
             str.tostring(sqzAccel, "#.00")

        reason +=
             "\n\nRisk: " +
             str.tostring(fireRisk, "#.1") +
             " pts  |  Room: " +
             str.tostring(fireRoom, "#.2") +
             "R"

        reason +=
             "\nEntry: " +
             str.tostring(fireEntry, format.mintick) +
             "  |  SL: " +
             str.tostring(fireStop, format.mintick)

        reason +=
             "\nExecution: " +
             (execLayerActive ?
              "1m change-of-state" :
              "chart-TF change-of-state")

        if fireCode == "MR"
            reason +=
                 "  |  VWAP SD: " +
                 str.tostring(
                      fireLong ?
                      mrLongSdLocation :
                      mrShortSdLocation,
                      "#.0") +
                 "/10"

        reason +=
             "\nTP1: " +
             str.tostring(fireTP1, format.mintick)


    // ------------------------------------------------------------
    // Use the LOCKED values for everything downstream.
    // ------------------------------------------------------------

    tradeActive := true
    tradeDirectionState := fireLong ? 1 : -1
    tradeEntryBar := fireEntryBar

    // Realtime uses the actual FIRE time.
    // Historical reconstruction uses the chart bar timestamp.
    tradeEntryTime := barstate.isrealtime ? timenow : time

    tradeEntry := fireEntry
    tradeStop := fireStop
    tradeRisk := fireRisk
    tradeTP1 := fireTP1
    tradeTP2 := fireTP2

    tradeScore := fireScore
    tradeCode := fireCode
    tradeGrade := grade
    tradeReason := reason
    tradeModifiers := mods

    tradeTP1Done := false

    lastTradeSummary :=
         (fireLong ? "L " : "S ") +
         fireCode +
         " " +
         grade +
         " ACTIVE"


    // ------------------------------------------------------------
    // Signal tab
    // ------------------------------------------------------------

    bool permanentCommit =
         not barstate.isrealtime or
         (liveFireConfirmed and barstate.isconfirmed)

    label newTradeLabel = na

    if signalDisplayMode != "Off"

        // Do not destroy the prior permanent Latest label while the
        // new signal is still provisional.
        if signalDisplayMode == "Latest Only" and
           (not barstate.isrealtime or liveFireConfirmed)

            if not na(latestTradeLabel)
                label.delete(latestTradeLabel)

        string tabText =
             (fireLong ? "L " : "S ") +
             fireCode +
             " " +
             grade

        if signalTabTextMode == "With Modifiers" and mods != "—"
            tabText += "\n" + mods

        newTradeLabel :=
             label.new(
                  bar_index,
                  fireLong ? low : high,
                  tabText,
                  yloc = fireLong ? yloc.belowbar : yloc.abovebar,
                  style = fireLong ? label.style_label_up : label.style_label_down,
                  color = fireCode == "MR" ?
                       color.new(color.orange, 0) :
                       color.new(color.blue, 0),
                  textcolor = color.white,
                  size = signalTabTextSize,
                  tooltip = reason)

        activeTradeLabel := newTradeLabel

        if signalDisplayMode == "Latest Only" and
           (not barstate.isrealtime or liveFireConfirmed)

            latestTradeLabel := newTradeLabel

    else
        activeTradeLabel := na


    // ------------------------------------------------------------
    // Permanent historical record.
    //
    // Realtime provisional FIREs DO NOT enter the historical arrays.
    // They enter history only after surviving confirmation and the
    // enclosing chart bar commits.
    // ------------------------------------------------------------

    if permanentCommit

        lastSignalBar := bar_index

        signalSerial += 1
        latestTrackedSignalId := signalSerial

        array.push(histIds, signalSerial)
        array.push(histDirs, tradeDirectionState)
        array.push(histBars, tradeEntryBar)
        array.push(histStops, tradeStop)
        array.push(histTP1s, tradeTP1)
        array.push(histLabels, activeTradeLabel)
        array.push(histReasons, tradeReason)

// Active trade horizontal levels — independently toggleable.
if tradeActive
    int activeRight = bar_index + 10

    // ENTRY
    if showEntryLine
        if na(entryLine)
            entryLine := line.new(
                 tradeEntryBar, tradeEntry,
                 activeRight, tradeEntry,
                 xloc = xloc.bar_index,
                 color = color.new(color.white, 15),
                 width = 1)
        else
            line.set_xy1(entryLine, tradeEntryBar, tradeEntry)
            line.set_xy2(entryLine, activeRight, tradeEntry)
    else
        if not na(entryLine)
            line.delete(entryLine)
            entryLine := na

    // STOP LOSS
    if showStopLine
        if na(stopLine)
            stopLine := line.new(
                 tradeEntryBar, tradeStop,
                 activeRight, tradeStop,
                 xloc = xloc.bar_index,
                 color = color.new(color.red, 0),
                 width = 1)
        else
            line.set_xy1(stopLine, tradeEntryBar, tradeStop)
            line.set_xy2(stopLine, activeRight, tradeStop)
    else
        if not na(stopLine)
            line.delete(stopLine)
            stopLine := na

    // TAKE PROFIT
    if showTargetLines
        if na(tp1Line)
            tp1Line := line.new(
                 tradeEntryBar, tradeTP1,
                 activeRight, tradeTP1,
                 xloc = xloc.bar_index,
                 color = color.new(color.green, 0),
                 width = 1)
        else
            line.set_xy1(tp1Line, tradeEntryBar, tradeTP1)
            line.set_xy2(tp1Line, activeRight, tradeTP1)

        if trackTP2
            if na(tp2Line)
                tp2Line := line.new(
                     tradeEntryBar, tradeTP2,
                     activeRight, tradeTP2,
                     xloc = xloc.bar_index,
                     color = color.new(color.green, 45),
                     width = 1)
            else
                line.set_xy1(tp2Line, tradeEntryBar, tradeTP2)
                line.set_xy2(tp2Line, activeRight, tradeTP2)
        else
            if not na(tp2Line)
                line.delete(tp2Line)
                tp2Line := na
    else
        if not na(tp1Line)
            line.delete(tp1Line)
            tp1Line := na

        if not na(tp2Line)
            line.delete(tp2Line)
            tp2Line := na

else
    // No simulated trade is currently active.
    // Remove only ACTIVE tracking lines; historical FIRE labels remain intact.
    if not na(entryLine)
        line.delete(entryLine)
        entryLine := na

    if not na(stopLine)
        line.delete(stopLine)
        stopLine := na

    if not na(tp1Line)
        line.delete(tp1Line)
        tp1Line := na

    if not na(tp2Line)
        line.delete(tp2Line)
        tp2Line := na
        
//=============================================================================
// INDEPENDENT HISTORICAL FIRE RESOLUTION
// Each FIRE remains tracked until its own TP1 or SL resolves.
//=============================================================================

int histI = array.size(histIds) - 1

while histI >= 0
    int sId = array.get(histIds, histI)
    int sDir = array.get(histDirs, histI)
    int sBar = array.get(histBars, histI)
    float sStop = array.get(histStops, histI)
    float sTP1 = array.get(histTP1s, histI)
    label sLabel = array.get(histLabels, histI)
    string sReason = array.get(histReasons, histI)

    // Preserve current behavior: do not judge outcome on the FIRE's own 5m bar.
    if bar_index > sBar
        bool sStopTouched = sDir == 1 ? low <= sStop : high >= sStop
        bool sTP1Touched = sDir == 1 ? high >= sTP1 : low <= sTP1

        bool resolved = false

        // Only recolor a label that is still supposed to be visible.
        // In "All Fires", every historical tab remains visible.
        // In "Latest Only", only the newest tab remains visible.
        bool labelVisible =
             signalDisplayMode == "All Fires" or
             sId == latestTrackedSignalId

        // TP and SL touched in same chart bar = ambiguous.
        if sStopTouched and sTP1Touched
            resolved := true

            if showOutcomes and labelVisible and not na(sLabel)
                label.set_color(sLabel, color.gray)
                label.set_textcolor(sLabel, color.white)
                label.set_tooltip(
                     sLabel,
                     sReason +
                     "\n\nRESULT: AMBIGUOUS" +
                     "\nTP1 and SL were both touched inside the same chart bar.")

            if sId == latestTrackedSignalId
                tradeActive := false
                lastTradeSummary :=
                     (sDir == 1 ? "L " : "S ") +
                     tradeCode + " ?"

        // SL before TP1 = LOSS.
        else if sStopTouched
            resolved := true

            if showOutcomes and labelVisible and not na(sLabel)
                label.set_color(sLabel, color.red)
                label.set_textcolor(sLabel, color.white)
                label.set_tooltip(
                     sLabel,
                     sReason +
                     "\n\nRESULT: SL" +
                     "\nStop loss reached before TP1.")

            if sId == latestTrackedSignalId
                tradeActive := false
                lastTradeSummary :=
                     (sDir == 1 ? "L " : "S ") +
                     tradeCode + " SL"

        // TP1 before SL = WIN.
        else if sTP1Touched
            resolved := true

            if showOutcomes and labelVisible and not na(sLabel)
                label.set_color(sLabel, color.green)
                label.set_textcolor(sLabel, color.white)
                label.set_tooltip(
                     sLabel,
                     sReason +
                     "\n\nRESULT: TP1✓" +
                     "\nFirst profit target reached.")

            if sId == latestTrackedSignalId
                tradeActive := false
                lastTradeSummary :=
                     (sDir == 1 ? "L " : "S ") +
                     tradeCode + " TP1✓"

        // Once resolved, remove ONLY the tracking record.
        // The actual historical label remains on the chart.
        if resolved
            array.remove(histIds, histI)
            array.remove(histDirs, histI)
            array.remove(histBars, histI)
            array.remove(histStops, histI)
            array.remove(histTP1s, histI)
            array.remove(histLabels, histI)
            array.remove(histReasons, histI)

    histI -= 1

//=============================================================================
// 29 — LASER TRADING COCKPIT HUD — CLEAN
//=============================================================================
//
// HUD PURPOSE:
// Tell the trader, at a glance:
//
// 1. What is the thesis?
// 2. How strong is it?
// 3. What is the 5m doing?
// 4. Does 15m context support it?
// 5. What state is the setup in?
// 6. What is RSI / momentum doing?
// 7. Where are we?
// 8. Is risk / room acceptable?
// 9. Has E triggered?
//
// Internal diagnostics stay internal.
//=============================================================================


//-----------------------------------------------------------------------------
// HUD DIRECTION / THESIS
//-----------------------------------------------------------------------------

int hudDirection = 0
string hudCode = ""
float hudScore = na

// Active trade always owns the HUD.
if tradeActive
    hudDirection := tradeDirectionState
    hudCode := tradeCode
    hudScore := tradeScore

else
    // Continuation setup before E.
    if contTrendLongSetup and not contTrendShortSetup
        hudDirection := 1
        hudCode := "C"
        hudScore := continuationLongScore

    else if contTrendShortSetup and not contTrendLongSetup
        hudDirection := -1
        hudCode := "C"
        hudScore := continuationShortScore

    // Reversal setup before E.
    else if mrLongSetupReady and not mrShortSetupReady
        hudDirection := 1
        hudCode := "MR"
        hudScore := meanReversionLongScore

    else if mrShortSetupReady and not mrLongSetupReady
        hudDirection := -1
        hudCode := "MR"
        hudScore := meanReversionShortScore

    // If a qualified candidate already exists, use the strongest one.
    else if bestLongCode != "" or bestShortCode != ""
        if bestLongScore > bestShortScore
            hudDirection := 1
            hudCode := bestLongCode
            hudScore := bestLongScore
        else if bestShortScore > bestLongScore
            hudDirection := -1
            hudCode := bestShortCode
            hudScore := bestShortScore


string hudDirectionText =
     hudDirection == 1 ? "LONG" :
     hudDirection == -1 ? "SHORT" :
     ""

string hudThesisText =
     hudCode == "" ?
     "NO THESIS" :
     hudCode + " " + hudDirectionText

string hudScoreText =
     not na(hudScore) and hudScore > 0 ?
     str.tostring(hudScore, "#") + "/100" :
     "—"


//-----------------------------------------------------------------------------
// MAIN STATUS
//-----------------------------------------------------------------------------

string hudStatus = "WAIT"

if tradeActive
    hudStatus := "FIRE / ACTIVE"

else if hardBalanceRegime
    hudStatus := "WAIT — BALANCE"


else if hudDirection == 1 and hudCode == "C"
    if contLongExecution
        hudStatus := "E TRIGGERED"
    else if longPullbackHold
        hudStatus := "ARMED"
    else if recentLongPB
        hudStatus := "PULLBACK"
    else
        hudStatus := "WATCH"

else if hudDirection == -1 and hudCode == "C"
    if contShortExecution
        hudStatus := "E TRIGGERED"
    else if shortPullbackHold
        hudStatus := "ARMED"
    else if recentShortPB
        hudStatus := "PULLBACK"
    else
        hudStatus := "WATCH"

else if hudDirection == 1 and hudCode == "MR"
    if meanReversionLongEligible
        hudStatus := "E TRIGGERED"
    else
        hudStatus := "REVERSAL ARMED"

else if hudDirection == -1 and hudCode == "MR"
    if meanReversionShortEligible
        hudStatus := "E TRIGGERED"
    else
        hudStatus := "REVERSAL ARMED"

else
    if recentEstablishedBullTrend and bullDeterioration >= 2
        hudStatus := "REVERSAL WATCH"
    else if recentEstablishedBearTrend and bearDeterioration >= 2
        hudStatus := "REVERSAL WATCH"


//-----------------------------------------------------------------------------
// STATUS COLORS
//-----------------------------------------------------------------------------

color hudStatusColor = color.silver

if tradeActive
    hudStatusColor := color.lime

else if hudStatus == "ARMED" or hudStatus == "REVERSAL ARMED"
    hudStatusColor := color.orange

else if hudStatus == "E TRIGGERED"
    hudStatusColor := color.lime

else if hudStatus == "REVERSAL WATCH"
    hudStatusColor := color.orange

else if hardBalanceRegime
    hudStatusColor := color.gray


//-----------------------------------------------------------------------------
// 5m TREND
//-----------------------------------------------------------------------------

string hud5mTrend = "TRANSITION"
string hud5mStrength = ""

if strongBullTrend
    hud5mTrend := "BULLISH"
    hud5mStrength := "STRONG"

else if bullTrendEstablished
    hud5mTrend := "BULLISH"
    hud5mStrength := "ESTABLISHED"

else if strongBearTrend
    hud5mTrend := "BEARISH"
    hud5mStrength := "STRONG"

else if bearTrendEstablished
    hud5mTrend := "BEARISH"
    hud5mStrength := "ESTABLISHED"

else if hardBalanceRegime or balanceRegime
    hud5mTrend := "BALANCE"
    hud5mStrength := ""

color hud5mColor =
     hud5mTrend == "BULLISH" ? color.lime :
     hud5mTrend == "BEARISH" ? color.red :
     color.silver


//-----------------------------------------------------------------------------
// 15m CONTEXT
//
// This is honest about what LASER currently knows:
// 15m close relative to its EMA context.
// It is NOT pretending to know your manually drawn trendlines.
//-----------------------------------------------------------------------------

string hud15mState =
     bull15Context ? "BULLISH" :
     bear15Context ? "BEARISH" :
     "NEUTRAL"

string hud15mRelation = "NEUTRAL"

if hudDirection == 1
    hud15mRelation :=
         bull15Context ? "SUPPORTIVE" :
         bear15Context ? "OPPOSING" :
         "NEUTRAL"

else if hudDirection == -1
    hud15mRelation :=
         bear15Context ? "SUPPORTIVE" :
         bull15Context ? "OPPOSING" :
         "NEUTRAL"

color hud15mColor =
     hud15mRelation == "SUPPORTIVE" ? color.lime :
     hud15mRelation == "OPPOSING" ? color.orange :
     color.white


//-----------------------------------------------------------------------------
// STRUCTURE / PATTERN STATE
//-----------------------------------------------------------------------------

string hudStructure = "WAIT"
string hudStructureDetail = ""

if hudDirection == 1 and hudCode == "C"

    if bullCompressionBreakout
        hudStructure := "BULL COMPRESSION"
        hudStructureDetail := "CEILING BREAK"

    else if bullCompressionActive
        hudStructure := "BULL COMPRESSION"
        hudStructureDetail :=
             recentBullCompressionSupportTouch ?
             "SUPPORT REACTION" :
             "ASCENDING PRESSURE"

    else if longPullbackHold
        hudStructure := "PULLBACK"
        hudStructureDetail := "HOLDING"

    else if recentLongPB
        hudStructure := "PULLBACK"
        hudStructureDetail := "DEVELOPING"

    else
        hudStructure := "TREND"
        hudStructureDetail := "WAITING"

else if hudDirection == -1 and hudCode == "C"
    if shortPullbackHold
        hudStructure := "PULLBACK"
        hudStructureDetail := "HOLDING"

    else if recentShortPB
        hudStructure := "PULLBACK"
        hudStructureDetail := "DEVELOPING"

    else
        hudStructure := "TREND"
        hudStructureDetail := "WAITING"

else if hudDirection == 1 and hudCode == "MR"
    hudStructure := "REVERSAL"
    hudStructureDetail :=
         mrLongStructureShift ?
         "STRUCTURE SHIFT" :
         "DEVELOPING"

else if hudDirection == -1 and hudCode == "MR"
    hudStructure := "REVERSAL"
    hudStructureDetail :=
         mrShortStructureShift ?
         "STRUCTURE SHIFT" :
         "DEVELOPING"

else if hardBalanceRegime
    hudStructure := "BALANCE"
    hudStructureDetail := "NO EDGE"


//-----------------------------------------------------------------------------
// RSI — VALUE + PLAIN-ENGLISH STATE
//-----------------------------------------------------------------------------

string hudRsiState = "FLAT"

if recentRsiBullDiv
    hudRsiState := "BULL DIV"

else if recentRsiBearDiv
    hudRsiState := "BEAR DIV"

else if rsiROC > 0 and rsiAccel > 0
    hudRsiState := "RISING FAST"

else if rsiROC > 0
    hudRsiState := "RISING"

else if rsiROC < 0 and rsiAccel < 0
    hudRsiState := "FALLING FAST"

else if rsiROC < 0
    hudRsiState := "FALLING"

string hudRsiValue =
     str.tostring(rsi, "#.1")

color hudRsiColor =
     rsiROC > 0 ? color.lime :
     rsiROC < 0 ? color.red :
     color.white


//-----------------------------------------------------------------------------
// MOMENTUM / SQUEEZE — PLAIN ENGLISH
//-----------------------------------------------------------------------------

string hudMomentum = "NEUTRAL"
string hudMomentumDetail = ""

if squeezeOn
    hudMomentum := "COMPRESSED"
    hudMomentumDetail :=
         pressureScore >= 70 ?
         "PRESSURIZED" :
         "BUILDING"

else if sqzBullReAccel
    hudMomentum := "BULLISH"
    hudMomentumDetail := "RE-ACCEL"

else if sqzBearReAccel
    hudMomentum := "BEARISH"
    hudMomentumDetail := "RE-ACCEL"

else if sqzBullAccel
    hudMomentum := "BULLISH"
    hudMomentumDetail := "EXPANDING"

else if sqzBearAccel
    hudMomentum := "BEARISH"
    hudMomentumDetail := "EXPANDING"

else if sqzBullDecel
    hudMomentum := "BULLISH"
    hudMomentumDetail := "FADING"

else if sqzBearDecel
    hudMomentum := "BEARISH"
    hudMomentumDetail := "FADING"

else if squeezeFired
    hudMomentum := "RELEASE"
    hudMomentumDetail := "EARLY"

color hudMomentumColor =
     hudMomentum == "BULLISH" ? color.lime :
     hudMomentum == "BEARISH" ? color.red :
     hudMomentum == "COMPRESSED" ? color.orange :
     color.white


//-----------------------------------------------------------------------------
// LOCATION — LASER L
//-----------------------------------------------------------------------------

float hudLocationScore =
     hudDirection == 1 ?
     supportLocation :
     hudDirection == -1 ?
     resistanceLocation :
     math.max(supportLocation, resistanceLocation)

string hudLocationQuality = "WEAK"

if hudLocationScore >= 8
    hudLocationQuality := "EXCELLENT"

else if hudLocationScore >= 6
    hudLocationQuality := "STRONG"

else if hudLocationScore >= 4
    hudLocationQuality := "GOOD"

else if hudLocationScore >= 2
    hudLocationQuality := "FAIR"


// Show the most important nearby anchor first.
string hudLocationAnchor = "—"

if near1m200 and nearVWAP
    hudLocationAnchor := "VWAP + 1m200"

else if near1m200
    hudLocationAnchor := "1m200"

else if nearVWAP
    hudLocationAnchor := "VWAP"

else if nearVAH
    hudLocationAnchor := "VAH"

else if nearVAL
    hudLocationAnchor := "VAL"

else if nearPOC
    hudLocationAnchor := "POC"

else if hudDirection == 1 and recentBullCompressionSupportTouch
    hudLocationAnchor := "RISING SUPPORT"

else if hudDirection == -1 and recentBearCompressionResistanceTouch
    hudLocationAnchor := "FALLING RESIST"

else if nearStructureLow or nearStructureHigh
    hudLocationAnchor := "STRUCTURE"

color hudLocationColor =
     hudLocationScore >= 6 ? color.lime :
     hudLocationScore >= 4 ? color.white :
     color.silver


//-----------------------------------------------------------------------------
// RISK / ROOM — LASER R
//-----------------------------------------------------------------------------

float hudRisk = na
float hudRoom = na

if tradeActive
    hudRisk := tradeRisk

else if hudDirection == 1
    hudRisk := bestLongRisk
    hudRoom := bestLongRoom

else if hudDirection == -1
    hudRisk := bestShortRisk
    hudRoom := bestShortRoom


string hudRiskText =
     not na(hudRisk) ?
     str.tostring(hudRisk, "#.1") + " pts" :
     "—"

string hudRoomText =
     tradeActive ?
     "TP1 " + str.tostring(tp1R, "#.##") + "R" :
     not na(hudRoom) ?
     str.tostring(hudRoom, "#.1") + "R ROOM" :
     "—"


//-----------------------------------------------------------------------------
// EXECUTION — LASER E
//-----------------------------------------------------------------------------

string hudExecution = "WAITING"
string hudExecutionDetail =
     execLayerActive ?
     "1m E" :
     "5m E"

if tradeActive
    hudExecution := "TRIGGERED"

else if hudDirection == 1
    if contLongExecution or meanReversionLongEligible
        hudExecution := "TRIGGERED"

else if hudDirection == -1
    if contShortExecution or meanReversionShortEligible
        hudExecution := "TRIGGERED"

color hudExecutionColor =
     hudExecution == "TRIGGERED" ?
     color.lime :
     color.white

//-----------------------------------------------------------------------------
// SCORE TO FIRE
//-----------------------------------------------------------------------------

string hudThresholdScore = "— / " + str.tostring(requiredScore, "#")
string hudThresholdState = "WAITING FOR SETUP"

if not na(hudScore) and hudScore > 0
    hudThresholdScore :=
         str.tostring(hudScore, "#") +
         " / " +
         str.tostring(requiredScore, "#")

    if hudScore >= requiredScore
        hudThresholdState := "SCORE QUALIFIED"
    else
        float scoreNeeded = requiredScore - hudScore
        hudThresholdState :=
             "NEEDS " +
             str.tostring(scoreNeeded, "#")

//-----------------------------------------------------------------------------
// FINAL FIRE GATE — HUD
//-----------------------------------------------------------------------------

string hudFireGate =
     hudDirection == 1 ? longFireGate :
     hudDirection == -1 ? shortFireGate :
     "NO THESIS"

color hudFireGateColor =
     hudFireGate == "FIRE" ? color.lime :
     hudFireGate == "READY" ? color.lime :
     hudFireGate == "NO THESIS" ? color.silver :
     color.orange
//-----------------------------------------------------------------------------
// ACTIVE LEVELS
//-----------------------------------------------------------------------------

string hudEntryText =
     tradeActive ?
     str.tostring(tradeEntry, format.mintick) :
     "—"

string hudStopText =
     tradeActive ?
     str.tostring(tradeStop, format.mintick) :
     "—"

string hudTargetText =
     tradeActive ?
     str.tostring(tradeTP1, format.mintick) :
     "—"


//=============================================================================
// HUD TABLE
//=============================================================================

var table hud =
     table.new(
          position.top_right,
          3,
          10,
          border_width = 1)

if barstate.islast

    table.clear(hud, 0, 0, 2, 9)

    if showHUD

        color bg = color.new(color.black, 8)
        color labelColor = color.silver
        color valueColor = color.white

        // ------------------------------------------------------------
        // ROW 0 — THESIS / SCORE / STATUS
        // ------------------------------------------------------------

        color headerBg =
             tradeActive ?
             color.new(color.green, 72) :
             hudCode == "MR" ?
             color.new(color.orange, 72) :
             hudDirection != 0 ?
             color.new(color.blue, 72) :
             color.new(color.gray, 80)

        table.cell(
             hud, 0, 0,
             "LASER",
             bgcolor = headerBg,
             text_color = color.white,
             text_size = hudTextSize)

        table.cell(
             hud, 1, 0,
             hudThesisText + "  " + hudScoreText,
             bgcolor = headerBg,
             text_color = color.white,
             text_size = hudTextSize)

        table.cell(
             hud, 2, 0,
             hudStatus,
             bgcolor = headerBg,
             text_color = hudStatusColor,
             text_size = hudTextSize)


        // ------------------------------------------------------------
        // ROW 1 — 5m TREND
        // ------------------------------------------------------------

        table.cell(
             hud, 0, 1,
             "5m Trend",
             bgcolor = bg,
             text_color = labelColor,
             text_size = hudTextSize)

        table.cell(
             hud, 1, 1,
             hud5mTrend,
             bgcolor = bg,
             text_color = hud5mColor,
             text_size = hudTextSize)

        table.cell(
             hud, 2, 1,
             hud5mStrength,
             bgcolor = bg,
             text_color = valueColor,
             text_size = hudTextSize)


        // ------------------------------------------------------------
        // ROW 2 — 15m CONTEXT
        // ------------------------------------------------------------

        table.cell(
             hud, 0, 2,
             "15m Context",
             bgcolor = bg,
             text_color = labelColor,
             text_size = hudTextSize)

        table.cell(
             hud, 1, 2,
             hud15mState,
             bgcolor = bg,
             text_color = valueColor,
             text_size = hudTextSize)

        table.cell(
             hud, 2, 2,
             hud15mRelation,
             bgcolor = bg,
             text_color = hud15mColor,
             text_size = hudTextSize)


        // ------------------------------------------------------------
        // ROW 3 — STRUCTURE
        // ------------------------------------------------------------

        table.cell(
             hud, 0, 3,
             "Structure",
             bgcolor = bg,
             text_color = labelColor,
             text_size = hudTextSize)

        table.cell(
             hud, 1, 3,
             hudStructure,
             bgcolor = bg,
             text_color = valueColor,
             text_size = hudTextSize)

        table.cell(
             hud, 2, 3,
             hudStructureDetail,
             bgcolor = bg,
             text_color = valueColor,
             text_size = hudTextSize)


        // ------------------------------------------------------------
        // ROW 4 — RSI
        // ------------------------------------------------------------

        table.cell(
             hud, 0, 4,
             "RSI",
             bgcolor = bg,
             text_color = labelColor,
             text_size = hudTextSize)

        table.cell(
             hud, 1, 4,
             hudRsiValue,
             bgcolor = bg,
             text_color = hudRsiColor,
             text_size = hudTextSize)

        table.cell(
             hud, 2, 4,
             hudRsiState,
             bgcolor = bg,
             text_color = hudRsiColor,
             text_size = hudTextSize)


        // ------------------------------------------------------------
        // ROW 5 — MOMENTUM
        // ------------------------------------------------------------

        table.cell(
             hud, 0, 5,
             "Momentum",
             bgcolor = bg,
             text_color = labelColor,
             text_size = hudTextSize)

        table.cell(
             hud, 1, 5,
             hudMomentum,
             bgcolor = bg,
             text_color = hudMomentumColor,
             text_size = hudTextSize)

        table.cell(
             hud, 2, 5,
             hudMomentumDetail,
             bgcolor = bg,
             text_color = hudMomentumColor,
             text_size = hudTextSize)


        // ------------------------------------------------------------
        // ROW 6 — LOCATION
        // ------------------------------------------------------------

        table.cell(
             hud, 0, 6,
             "Location",
             bgcolor = bg,
             text_color = labelColor,
             text_size = hudTextSize)

        table.cell(
             hud, 1, 6,
             hudLocationQuality +
             " " +
             str.tostring(hudLocationScore, "#") +
             "/10",
             bgcolor = bg,
             text_color = hudLocationColor,
             text_size = hudTextSize)

        table.cell(
             hud, 2, 6,
             hudLocationAnchor,
             bgcolor = bg,
             text_color = hudLocationColor,
             text_size = hudTextSize)


        // ------------------------------------------------------------
        // ROW 7 — RISK / ROOM
        // ------------------------------------------------------------

        table.cell(
             hud, 0, 7,
             "Risk / Room",
             bgcolor = bg,
             text_color = labelColor,
             text_size = hudTextSize)

        table.cell(
             hud, 1, 7,
             hudRiskText,
             bgcolor = bg,
             text_color = valueColor,
             text_size = hudTextSize)

        table.cell(
             hud, 2, 7,
             hudRoomText,
             bgcolor = bg,
             text_color = valueColor,
             text_size = hudTextSize)


        // ------------------------------------------------------------
        // ROW 8 — EXECUTION
        // ------------------------------------------------------------

        table.cell(
             hud, 0, 8,
             "Execution",
             bgcolor = bg,
             text_color = labelColor,
             text_size = hudTextSize)

        table.cell(
             hud, 1, 8,
             hudExecution,
             bgcolor = bg,
             text_color = hudExecutionColor,
             text_size = hudTextSize)

        table.cell(
             hud, 2, 8,
             hudExecutionDetail,
             bgcolor = bg,
             text_color = valueColor,
             text_size = hudTextSize)


                // ------------------------------------------------------------
        // ROW 9 — SCORE / FINAL FIRE GATE
        // ------------------------------------------------------------

        table.cell(
             hud, 0, 9,
             tradeActive ? "Trade" : "Score",
             bgcolor = bg,
             text_color = labelColor,
             text_size = hudTextSize)

        table.cell(
             hud, 1, 9,
             tradeActive ?
             "E " + hudEntryText + "  SL " + hudStopText :
             hudThresholdScore,
             bgcolor = bg,
             text_color = valueColor,
             text_size = hudTextSize)

        table.cell(
             hud, 2, 9,
             tradeActive ?
             "TP1 " + hudTargetText :
             hudFireGate,
             bgcolor = bg,
             text_color = tradeActive ? valueColor : hudFireGateColor,
             text_size = hudTextSize)

//=============================================================================
// 30 — ALERTS
//=============================================================================
alertcondition(longFireEvent, "LASER Long FIRE", "LASER qualified LONG on {{ticker}} {{interval}}.")
alertcondition(shortFireEvent, "LASER Short FIRE", "LASER qualified SHORT on {{ticker}} {{interval}}.")
alertcondition(rsiBullDiv, "LASER Bullish RSI Divergence", "{{ticker}} {{interval}} bullish RSI divergence confirmed.")
alertcondition(rsiBearDiv, "LASER Bearish RSI Divergence", "{{ticker}} {{interval}} bearish RSI divergence confirmed.")
alertcondition(squeezeFired, "LASER Squeeze Fired", "{{ticker}} {{interval}} squeeze released.")
alertcondition(sellingAbsorbed, "LASER Selling Absorbed", "{{ticker}} {{interval}} possible high-volume selling absorption.")
alertcondition(buyingAbsorbed, "LASER Buying Absorbed", "{{ticker}} {{interval}} possible high-volume buying absorption.")
alertcondition(failedAuctionAboveVAH, "LASER Failed Auction Above VAH", "{{ticker}} {{interval}} rejected an excursion above VAH.")
alertcondition(failedAuctionBelowVAL, "LASER Failed Auction Below VAL", "{{ticker}} {{interval}} rejected an excursion below VAL.")
