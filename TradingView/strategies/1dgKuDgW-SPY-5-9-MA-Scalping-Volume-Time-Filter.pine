//@version=5
strategy("SPY 5/9 MA Scalping + Volume + Time Filter", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// === Inputs ===
fastLen = input.int(5, title="Fast MA (5)")
slowLen = input.int(9, title="Slow MA (9)")

tp_dollars = input.float(0.40, title="Take Profit ($ move)")
sl_dollars = input.float(0.50, title="Stop Loss ($ move)")

// === Moving Averages ===
fastMA = ta.sma(close, fastLen)
slowMA = ta.sma(close, slowLen)

// === Volume Condition ===
volCondition = volume > volume[1]

// === Time Filter (EST session) ===
startTime = timestamp("America/New_York", year, month, dayofmonth, 9, 32)
endTime   = timestamp("America/New_York", year, month, dayofmonth, 11, 12)

timeCondition = (time >= startTime and time <= endTime)

// === Entry Conditions ===
longCondition = ta.crossover(fastMA, slowMA) and volCondition and timeCondition
shortCondition = ta.crossunder(fastMA, slowMA) and volCondition and timeCondition

// === Entries ===
if (longCondition)
    strategy.entry("Long", strategy.long)

if (shortCondition)
    strategy.entry("Short", strategy.short)

// === Position Management (always active) ===
if (strategy.position_size > 0)
    entryPrice = strategy.position_avg_price
    tp_price = entryPrice + tp_dollars
    sl_price = entryPrice - sl_dollars

    strategy.exit("Exit Long", from_entry="Long", limit=tp_price, stop=sl_price)

if (strategy.position_size < 0)
    entryPrice = strategy.position_avg_price
    tp_price = entryPrice - tp_dollars
    sl_price = entryPrice + sl_dollars

    strategy.exit("Exit Short", from_entry="Short", limit=tp_price, stop=sl_price)

// === Plot ===
plot(fastMA, color=color.green, title="5 MA")
plot(slowMA, color=color.red, title="9 MA")
