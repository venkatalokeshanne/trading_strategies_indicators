//@version=6
indicator("15min ORB + PMH/PML/PDH/PDL", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ─── Inputs ───────────────────────────────────────────────
orbSession   = input.session("0930-0945", "ORB Session (exchange time)")
pmSession    = input.session("0400-0930", "Premarket Session")
rthSession   = input.session("0930-1600", "Regular Session (for PDH/PDL)")

showORB      = input.bool(true, "Show ORB Box")
orbBoxColor  = input.color(color.new(#7E57C2, 80), "ORB Box Fill Color")
orbBorder    = input.color(#7E57C2, "ORB Border Color")

showPM       = input.bool(true, "Show PMH/PML")
showPD       = input.bool(true, "Show PDH/PDL")

lineColor    = input.color(color.white, "Line Color")
lineWidth    = input.int(1, "Line Width", minval=1, maxval=4)
labelSize    = input.string(size.small, "Label Size", options=[size.tiny, size.small, size.normal, size.large])
daysBack     = input.int(5, "Only draw last N days (0 = all)", minval=0)

isIntraday   = timeframe.isintraday
tfOk         = timeframe.isintraday and timeframe.in_seconds() < 30 * 60

// ─── Session detection ────────────────────────────────────
inORB   = not na(time("15", orbSession))
inPM    = not na(time("1", pmSession))
inRTH   = not na(time("1", rthSession))
newDay  = ta.change(time("D")) != 0

rthStart = inRTH and not inRTH[1]   // first bar of regular session
rthEnd   = not inRTH and inRTH[1]   // first bar AFTER regular session ends

// only draw on recent days so history doesn't get flooded with old lines
withinLimit = daysBack == 0 ? true : (time >= timenow - daysBack * 26 * 60 * 60 * 1000)

// ─── ORB box (appears fully formed at 9:45, frozen at close) ──
var float orbHigh    = na
var float orbLow     = na
var int   orbStartBar = na
var box   orbBox     = na

if newDay
    orbHigh := na
    orbLow  := na
    orbStartBar := na
    orbBox  := na

if inORB and withinLimit and isIntraday and tfOk
    orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
    orbLow  := na(orbLow)  ? low  : math.min(orbLow, low)
    if na(orbStartBar)
        orbStartBar := bar_index

// draw the box ONCE, right when the ORB window closes -- extend.right renders it
// instantly full-width, no bar-by-bar growth
if showORB and inRTH and not inORB and na(orbBox) and not na(orbHigh) and withinLimit and isIntraday and tfOk
    orbBox := box.new(orbStartBar, orbHigh, bar_index + 1, orbLow, border_color=orbBorder, bgcolor=orbBoxColor, extend=extend.right)

// freeze it exactly at market close so it doesn't bleed into the overnight gap
if showORB and rthEnd and not na(orbBox)
    box.set_extend(orbBox, extend.none)
    box.set_right(orbBox, bar_index - 1)

// ─── Premarket High/Low ─────────────────────────────────────
var float pmHigh   = na
var float pmLow    = na
var line  pmhLine  = na
var line  pmlLine  = na
var label pmhLabel = na
var label pmlLabel = na

if newDay
    pmHigh  := na
    pmLow   := na
    pmhLine := na
    pmlLine := na
    pmhLabel := na
    pmlLabel := na

if inPM and withinLimit and isIntraday and tfOk
    pmHigh := na(pmHigh) ? high : math.max(pmHigh, high)
    pmLow  := na(pmLow)  ? low  : math.min(pmLow, low)

// draw ONCE at market open, extend.right instantly fills to market close
if showPM and rthStart and not na(pmHigh) and withinLimit and isIntraday and tfOk
    pmhLine := line.new(bar_index, pmHigh, bar_index + 1, pmHigh, color=lineColor, width=lineWidth, extend=extend.right)
    pmlLine := line.new(bar_index, pmLow, bar_index + 1, pmLow, color=lineColor, width=lineWidth, extend=extend.right)
    pmhLabel := label.new(bar_index, pmHigh, "PMH", style=label.style_none, textcolor=color.white, size=labelSize, xloc=xloc.bar_index)
    pmlLabel := label.new(bar_index, pmLow, "PML", style=label.style_none, textcolor=color.white, size=labelSize, xloc=xloc.bar_index)

if showPM and rthEnd and not na(pmhLine)
    line.set_extend(pmhLine, extend.none)
    line.set_extend(pmlLine, extend.none)
    line.set_x2(pmhLine, bar_index - 1)
    line.set_x2(pmlLine, bar_index - 1)
    label.set_x(pmhLabel, bar_index - 1)
    label.set_x(pmlLabel, bar_index - 1)

// ─── Prior Day High/Low ─────────────────────────────────────
var float pdHigh   = na
var float pdLow    = na
var float curHigh  = na
var float curLow   = na
var line  pdhLine  = na
var line  pdlLine  = na
var label pdhLabel = na
var label pdlLabel = na

if newDay
    pdHigh  := curHigh
    pdLow   := curLow
    curHigh := na
    curLow  := na
    pdhLine := na
    pdlLine := na
    pdhLabel := na
    pdlLabel := na

if inRTH
    curHigh := na(curHigh) ? high : math.max(curHigh, high)
    curLow  := na(curLow)  ? low  : math.min(curLow, low)

// draw ONCE at market open, extend.right instantly fills to market close
if showPD and rthStart and not na(pdHigh) and withinLimit and isIntraday and tfOk
    pdhLine := line.new(bar_index, pdHigh, bar_index + 1, pdHigh, color=lineColor, width=lineWidth, extend=extend.right)
    pdlLine := line.new(bar_index, pdLow, bar_index + 1, pdLow, color=lineColor, width=lineWidth, extend=extend.right)
    pdhLabel := label.new(bar_index, pdHigh, "PDH", style=label.style_none, textcolor=color.white, size=labelSize, xloc=xloc.bar_index)
    pdlLabel := label.new(bar_index, pdLow, "PDL", style=label.style_none, textcolor=color.white, size=labelSize, xloc=xloc.bar_index)

if showPD and rthEnd and not na(pdhLine)
    line.set_extend(pdhLine, extend.none)
    line.set_extend(pdlLine, extend.none)
    line.set_x2(pdhLine, bar_index - 1)
    line.set_x2(pdlLine, bar_index - 1)
    label.set_x(pdhLabel, bar_index - 1)
    label.set_x(pdlLabel, bar_index - 1)
