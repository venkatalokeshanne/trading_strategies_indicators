//@version=6
// ══════════════════════════════════════════════════════════════════════
//  3-CANDLE IMPULSE ➜ DOJI ➜ IMPULSE  |  STRICT VISUAL MATCH + RETEST
//
//  BEAR: RED impulse (long body, tiny wicks)
//        ➜ DOJI (small body, wicks both sides, clearly smaller candle)
//        ➜ RED impulse (long body, similar size, closes below doji low)
//        ➜ price pulls back UP to DOJI LOW = SHORT entry
//  BULL: exact mirror, green candles, retest of DOJI HIGH.
// ══════════════════════════════════════════════════════════════════════
indicator("3-Candle Impulse + Doji Retest [Strict]", "Doji Retest", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ─────────────────────── IMPULSE CANDLE SHAPE ───────────────────────
gI = "Impulse candles (1st & 3rd)"
atrLen     = input.int(14,     "ATR length",                                group = gI)
impMult    = input.float(1.0,  "Body ≥ ATR ×",                 step = 0.1,  group = gI)
impBodyPct = input.float(0.60, "Body ≥ % of candle range",     step = 0.05, minval = 0.3, maxval = 1.0, group = gI)
impMaxWick = input.float(0.45, "Each wick ≤ % of body",        step = 0.05, group = gI)
imp2Rel    = input.float(0.50, "3rd body ≥ % of 1st body",     step = 0.05, group = gI)
sameColor  = input.bool(true,  "Both impulses must be same colour",         group = gI)

// ───────────────────────── DOJI CANDLE SHAPE ─────────────────────────
gD = "Doji candle (middle)"
dojiBodyRng = input.float(0.35, "Doji body ≤ % of its own range", step = 0.05, group = gD)
dojiPct     = input.float(0.35, "Doji body ≤ % of 1st impulse body", step = 0.05, group = gD)
dojiRngPct  = input.float(0.65, "Doji range ≤ % of 1st impulse range", step = 0.05, group = gD)
needWicks   = input.bool(true,  "Doji must have wicks on BOTH sides", group = gD)
allowFlat   = input.bool(false, "Allow flat doji (open = close)",     group = gD)
dojiInside  = input.bool(true,  "Doji must stay inside 1st impulse range", group = gD)

// ─────────────────────────── RETEST / ENTRY ───────────────────────────
gE = "Retest / Entry"
needBreak  = input.bool(true,  "3rd impulse must close beyond doji level",  group = gE)
useBody    = input.bool(false, "Use doji BODY edge instead of wick",        group = gE)
maxWait    = input.int(15,     "Max bars to wait for retest",               group = gE)
tolAtr     = input.float(0.10, "Touch tolerance (× ATR)",      step = 0.05, group = gE)
needReject = input.bool(false, "Require rejection close on retest bar",     group = gE)
oneShot    = input.bool(true,  "One entry per setup",                       group = gE)

gT = "Trend Filter"
useHTF = input.bool(false,     "Use HTF EMA filter", group = gT)
htfTf  = input.timeframe("60", "HTF",                group = gT)
emaLen = input.int(50,         "HTF EMA length",     group = gT)

gR = "Risk"
showRisk = input.bool(true,  "Draw SL / TP1 / TP2",           group = gR)
slSource = input.string("1st impulse candle", "Stop loss at", options = ["1st impulse candle", "Doji", "Pattern extreme"], group = gR)
slAtrM   = input.float(0.1,  "SL buffer beyond level (× ATR)", step = 0.1, group = gR)
rr1      = input.float(1.0,  "TP1 (R multiple)",  step = 0.5, group = gR)
rr2      = input.float(2.0,  "TP2 (R multiple)",  step = 0.5, group = gR)
showTag  = input.bool(true,  "Label entry / SL / TP prices",   group = gR)

gV = "Visuals"
showLvl  = input.bool(true, "Draw retest level while armed", group = gV)
showBox  = input.bool(true, "Box the matched 3 candles",     group = gV)
boxPad   = input.float(0.15, "Box padding (× ATR)", step = 0.05, group = gV)
boxFill  = input.int(90, "Box fill transparency", minval = 60, maxval = 100, group = gV)
boxEdge  = input.int(20, "Box border transparency", minval = 0, maxval = 90, group = gV)
boxWidth = input.int(2, "Box border width", minval = 1, maxval = 4, group = gV)
cBear    = input.color(#f23645, "Bear", inline = "c", group = gV)
cBull    = input.color(#089981, "Bull", inline = "c", group = gV)

// ═══════════════════════════ CANDLE ANATOMY ═══════════════════════════
atr = ta.atr(atrLen)
tol = tolAtr * atr
tick = syminfo.mintick

// candle 1  (bar_index - 2)
a1o = open[2],  a1c = close[2],  a1h = high[2],  a1l = low[2]
a1body = math.abs(a1c - a1o)
a1rng  = math.max(a1h - a1l, tick)
a1up   = a1h - math.max(a1o, a1c)
a1dn   = math.min(a1o, a1c) - a1l
a1red  = a1c < a1o
a1grn  = a1c > a1o

// candle 2  (bar_index - 1)  — the doji
a2o = open[1],  a2c = close[1],  a2h = high[1],  a2l = low[1]
a2body = math.abs(a2c - a2o)
a2rng  = math.max(a2h - a2l, tick)
a2red  = a2c < a2o
a2grn  = a2c > a2o

// candle 3  (current bar)
a3body = math.abs(close - open)
a3rng  = math.max(high - low, tick)
a3up   = high - math.max(open, close)
a3dn   = math.min(open, close) - low
a3red  = close < open
a3grn  = close > open

// ─── shape gates ───
imp1Shape = a1body >= impMult * atr[2] and a1body >= impBodyPct * a1rng and a1up <= impMaxWick * a1body and a1dn <= impMaxWick * a1body
imp3Shape = a3body >= impMult * atr   and a3body >= impBodyPct * a3rng and a3up <= impMaxWick * a3body and a3dn <= impMaxWick * a3body and a3body >= imp2Rel * a1body

dojiShape = a2body <= dojiBodyRng * a2rng and a2body <= dojiPct * a1body and a2rng <= dojiRngPct * a1rng
dojiWick  = not needWicks or (a2h > math.max(a2o, a2c) and a2l < math.min(a2o, a2c))
dojiIn    = not dojiInside or (a2h <= a1h and a2l >= a1l)

// doji colour MUST match the impulse candles
dojiColBear = a2red or (allowFlat and a2c == a2o)
dojiColBull = a2grn or (allowFlat and a2c == a2o)

// retest levels off the doji
lvlDn = useBody ? math.min(a2o, a2c) : a2l    // short entry level
lvlUp = useBody ? math.max(a2o, a2c) : a2h    // long  entry level

// ─── trend filter ───
htfEma = request.security(syminfo.tickerid, htfTf, ta.ema(close, emaLen), lookahead = barmerge.lookahead_off)
bearOK = not useHTF or close < htfEma
bullOK = not useHTF or close > htfEma

// ═══════════════════════ PATTERN CONFIRMATION ═══════════════════════
bearPat = a1red and imp1Shape and dojiShape and dojiWick and dojiIn and dojiColBear and (not sameColor or a3red) and a3red and imp3Shape and (not needBreak or close < lvlDn) and bearOK

bullPat = a1grn and imp1Shape and dojiShape and dojiWick and dojiIn and dojiColBull and (not sameColor or a3grn) and a3grn and imp3Shape and (not needBreak or close > lvlUp) and bullOK

// ══════════════════ ARMED STATE: waiting for retest ══════════════════
var bool  bArmed = false
var float bLvl   = na   // doji wick low  = ENTRY
var float bImpX  = na   // 1st impulse high
var float bDojX  = na   // doji high
var float bPatX  = na   // pattern high
var int   bWait  = 0

var bool  uArmed = false
var float uLvl   = na   // doji wick high = ENTRY
var float uImpX  = na   // 1st impulse low
var float uDojX  = na   // doji low
var float uPatX  = na   // pattern low
var int   uWait  = 0

bool shortSig = false
bool longSig  = false

if bearPat
    bArmed := true, bLvl := lvlDn, bWait := 0, uArmed := false
    bImpX := a1h, bDojX := a2h, bPatX := math.max(a1h, a2h, high)
else if bArmed
    bWait += 1
    if close > bImpX
        bArmed := false                       // ran past the 1st impulse — setup dead
    else if high >= bLvl - tol
        if not needReject or close < bLvl
            shortSig := true
            if oneShot
                bArmed := false
    else if bWait > maxWait
        bArmed := false

if bullPat
    uArmed := true, uLvl := lvlUp, uWait := 0, bArmed := false
    uImpX := a1l, uDojX := a2l, uPatX := math.min(a1l, a2l, low)
else if uArmed
    uWait += 1
    if close < uImpX
        uArmed := false
    else if low <= uLvl + tol
        if not needReject or close > uLvl
            longSig := true
            if oneShot
                uArmed := false
    else if uWait > maxWait
        uArmed := false

// ─────────────────────────── DRAWING ───────────────────────────
if showBox and bearPat
    float pad = boxPad * atr
    box.new(bar_index - 2, math.max(a1h, a2h, high) + pad, bar_index, math.min(a1l, a2l, low) - pad, border_color = color.new(cBear, boxEdge), border_width = boxWidth, border_style = line.style_solid, bgcolor = color.new(cBear, boxFill))
if showBox and bullPat
    float pad = boxPad * atr
    box.new(bar_index - 2, math.max(a1h, a2h, high) + pad, bar_index, math.min(a1l, a2l, low) - pad, border_color = color.new(cBull, boxEdge), border_width = boxWidth, border_style = line.style_solid, bgcolor = color.new(cBull, boxFill))

plotshape(bearPat, "Bear pattern", shape.circle, location.abovebar, color.new(cBear, 20), size = size.tiny)
plotshape(bullPat, "Bull pattern", shape.circle, location.belowbar, color.new(cBull, 20), size = size.tiny)

plot(showLvl and bArmed ? bLvl : na, "Short retest level", cBear, 2, plot.style_linebr)
plot(showLvl and uArmed ? uLvl : na, "Long retest level",  cBull, 2, plot.style_linebr)

if showRisk and shortSig
    float e = bLvl                                            // ENTRY = doji wick low
    float sRaw = slSource == "Doji" ? bDojX : slSource == "Pattern extreme" ? bPatX : bImpX
    float s = sRaw + slAtrM * atr                             // SL above 1st impulse candle
    float r = math.max(s - e, tick)
    line.new(bar_index, s,           bar_index + 18, s,           color = color.red,   style = line.style_dashed)
    line.new(bar_index, e,           bar_index + 18, e,           color = color.gray,  style = line.style_solid)
    line.new(bar_index, e - rr1 * r, bar_index + 18, e - rr1 * r, color = color.lime,  style = line.style_dashed)
    line.new(bar_index, e - rr2 * r, bar_index + 18, e - rr2 * r, color = color.green, style = line.style_dashed)
    if showTag
        label.new(bar_index + 18, s,           "SL " + str.tostring(s, format.mintick),           style = label.style_label_left, color = color.new(color.red, 80),   textcolor = color.red,   size = size.tiny)
        label.new(bar_index + 18, e,           "ENTRY " + str.tostring(e, format.mintick),        style = label.style_label_left, color = color.new(color.gray, 80),  textcolor = color.gray,  size = size.tiny)
        label.new(bar_index + 18, e - rr1 * r, "TP1 " + str.tostring(e - rr1 * r, format.mintick), style = label.style_label_left, color = color.new(color.lime, 80),  textcolor = color.lime,  size = size.tiny)
        label.new(bar_index + 18, e - rr2 * r, "TP2 " + str.tostring(e - rr2 * r, format.mintick), style = label.style_label_left, color = color.new(color.green, 80), textcolor = color.green, size = size.tiny)

if showRisk and longSig
    float e = uLvl                                            // ENTRY = doji wick high
    float sRaw = slSource == "Doji" ? uDojX : slSource == "Pattern extreme" ? uPatX : uImpX
    float s = sRaw - slAtrM * atr                             // SL below 1st impulse candle
    float r = math.max(e - s, tick)
    line.new(bar_index, s,           bar_index + 18, s,           color = color.red,   style = line.style_dashed)
    line.new(bar_index, e,           bar_index + 18, e,           color = color.gray,  style = line.style_solid)
    line.new(bar_index, e + rr1 * r, bar_index + 18, e + rr1 * r, color = color.lime,  style = line.style_dashed)
    line.new(bar_index, e + rr2 * r, bar_index + 18, e + rr2 * r, color = color.green, style = line.style_dashed)
    if showTag
        label.new(bar_index + 18, s,           "SL " + str.tostring(s, format.mintick),           style = label.style_label_left, color = color.new(color.red, 80),   textcolor = color.red,   size = size.tiny)
        label.new(bar_index + 18, e,           "ENTRY " + str.tostring(e, format.mintick),        style = label.style_label_left, color = color.new(color.gray, 80),  textcolor = color.gray,  size = size.tiny)
        label.new(bar_index + 18, e + rr1 * r, "TP1 " + str.tostring(e + rr1 * r, format.mintick), style = label.style_label_left, color = color.new(color.lime, 80),  textcolor = color.lime,  size = size.tiny)
        label.new(bar_index + 18, e + rr2 * r, "TP2 " + str.tostring(e + rr2 * r, format.mintick), style = label.style_label_left, color = color.new(color.green, 80), textcolor = color.green, size = size.tiny)

plotshape(shortSig, "SHORT", shape.triangledown, location.abovebar, cBear, size = size.small, text = "SELL", textcolor = cBear)
plotshape(longSig,  "LONG",  shape.triangleup,   location.belowbar, cBull, size = size.small, text = "BUY",  textcolor = cBull)

bgcolor(bArmed ? color.new(cBear, 93) : uArmed ? color.new(cBull, 93) : na, title = "Armed")

// ═══════════════════ TRADE TRACKER + STATS TABLE ═══════════════════
gS = "Stats table"
showTable = input.bool(true, "Show trade stats table", group = gS)
tblRows   = input.int(15, "Trades to display (10-20)", minval = 5, maxval = 25, group = gS)
exitModel = input.string("Split TP1/TP2 + BE", "Exit model", options = ["TP1 only", "TP2 only", "Split TP1/TP2 + BE"], group = gS)
tblPos    = input.string("Top right", "Table position", options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = gS)
tblSize   = input.string("Small", "Table text size", options = ["Tiny", "Small", "Normal"], group = gS)
tblMono   = input.bool(true, "Monospace numbers", group = gS)

var array<int>   tDir = array.new_int()
var array<float> tEnt = array.new_float()
var array<float> tStp = array.new_float()
var array<float> tT1  = array.new_float()
var array<float> tT2  = array.new_float()
var array<int>   tSt  = array.new_int()      // 0 = open, 1 = TP1 hit, 2 = closed
var array<int>   tWin = array.new_int()      // 0 = undecided, 1 = WIN (TP1 reached), -1 = LOSS (SL first)
var array<float> tRes = array.new_float()    // realised R
var array<int>   tBar = array.new_int()
var array<int>   tEnd = array.new_int()

// ── log new trades ──
if shortSig
    float e = bLvl
    float sRaw = slSource == "Doji" ? bDojX : slSource == "Pattern extreme" ? bPatX : bImpX
    float s = sRaw + slAtrM * atr
    float r = math.max(s - e, tick)
    array.push(tDir, -1), array.push(tEnt, e), array.push(tStp, s)
    array.push(tT1, e - rr1 * r), array.push(tT2, e - rr2 * r)
    array.push(tSt, 0), array.push(tWin, 0), array.push(tRes, 0.0), array.push(tBar, bar_index), array.push(tEnd, bar_index)

if longSig
    float e = uLvl
    float sRaw = slSource == "Doji" ? uDojX : slSource == "Pattern extreme" ? uPatX : uImpX
    float s = sRaw - slAtrM * atr
    float r = math.max(e - s, tick)
    array.push(tDir, 1), array.push(tEnt, e), array.push(tStp, s)
    array.push(tT1, e + rr1 * r), array.push(tT2, e + rr2 * r)
    array.push(tSt, 0), array.push(tWin, 0), array.push(tRes, 0.0), array.push(tBar, bar_index), array.push(tEnd, bar_index)

// keep memory bounded
if array.size(tSt) > 520
    array.shift(tDir), array.shift(tEnt), array.shift(tStp), array.shift(tT1), array.shift(tT2)
    array.shift(tSt), array.shift(tWin), array.shift(tRes), array.shift(tBar), array.shift(tEnd)

// ── resolve open trades (from the bar AFTER entry) ──
if array.size(tSt) > 0
    for i = 0 to array.size(tSt) - 1
        int st = array.get(tSt, i)
        if st < 2 and bar_index > array.get(tBar, i)
            int   d  = array.get(tDir, i)
            float s  = array.get(tStp, i)
            float p1 = array.get(tT1, i)
            float p2 = array.get(tT2, i)
            bool slHit = d == -1 ? high >= s  : low  <= s
            bool t1Hit = d == -1 ? low  <= p1 : high >= p1
            bool t2Hit = d == -1 ? low  <= p2 : high >= p2

            if st == 0 and slHit
                array.set(tSt, i, 2), array.set(tWin, i, -1), array.set(tRes, i, -1.0), array.set(tEnd, i, bar_index)
            else if st == 1 and slHit
                float runner = exitModel == "Split TP1/TP2 + BE" ? 0.0 : -1.0
                array.set(tSt, i, 2), array.set(tRes, i, 0.5 * rr1 + 0.5 * runner), array.set(tEnd, i, bar_index)
            else if exitModel == "TP1 only"
                if t1Hit
                    array.set(tSt, i, 2), array.set(tWin, i, 1), array.set(tRes, i, rr1), array.set(tEnd, i, bar_index)
            else if exitModel == "TP2 only"
                if t1Hit
                    array.set(tWin, i, 1)
                if t2Hit
                    array.set(tSt, i, 2), array.set(tWin, i, 1), array.set(tRes, i, rr2), array.set(tEnd, i, bar_index)
            else
                if st == 0 and t1Hit
                    array.set(tSt, i, 1), array.set(tWin, i, 1)     // 1R banked = WIN, locked in
                    st := 1
                if st == 1 and t2Hit
                    array.set(tSt, i, 2), array.set(tRes, i, 0.5 * rr1 + 0.5 * rr2), array.set(tEnd, i, bar_index)

// ── render table ──
tPos = tblPos == "Bottom right" ? position.bottom_right : tblPos == "Top left" ? position.top_left : tblPos == "Bottom left" ? position.bottom_left : position.top_right
tSz  = tblSize == "Tiny" ? size.tiny : tblSize == "Normal" ? size.normal : size.small
tFnt = tblMono ? font.family_monospace : font.family_default

cHdrBg  = #262b3a
cRowA   = color.new(#8593a8, 94)
cRowB   = color.new(#8593a8, 88)
cSumBg  = #1f2430
cTxt    = #b8c1d1
cTxtDim = #7d879c

var table stats = table.new(tPos, 6, 30, border_width = 1, frame_width = 1, frame_color = color.new(#8593a8, 55), border_color = color.new(#8593a8, 80))

if showTable and barstate.islast
    table.clear(stats, 0, 0, 5, 29)
    table.cell(stats, 0, 0, "#",      bgcolor = cHdrBg, text_color = color.white, text_size = tSz, text_font_family = tFnt)
    table.cell(stats, 1, 0, "SIDE",   bgcolor = cHdrBg, text_color = color.white, text_size = tSz, text_font_family = tFnt)
    table.cell(stats, 2, 0, "ENTRY",  bgcolor = cHdrBg, text_color = color.white, text_size = tSz, text_font_family = tFnt)
    table.cell(stats, 3, 0, "STOP",   bgcolor = cHdrBg, text_color = color.white, text_size = tSz, text_font_family = tFnt)
    table.cell(stats, 4, 0, "RESULT", bgcolor = cHdrBg, text_color = color.white, text_size = tSz, text_font_family = tFnt)
    table.cell(stats, 5, 0, "R",      bgcolor = cHdrBg, text_color = color.white, text_size = tSz, text_font_family = tFnt)

    int n     = array.size(tSt)
    int shown = math.min(n, tblRows)
    int row   = 1

    if n > 0
        int wins = 0
        int losses = 0
        int opens = 0
        float totR = 0.0

        for k = 0 to shown - 1
            int i = n - 1 - k                       // newest first
            int   st = array.get(tSt, i)
            int   w  = array.get(tWin, i)
            float rr = array.get(tRes, i)
            string res  = w == 1 and st < 2 ? "WIN · runner" : w == 1 ? "WIN" : w == -1 ? "LOSS" : "OPEN"
            color  rcol = w == 1 ? cBull : w == -1 ? cBear : color.new(#ffa726, 0)
            color  rbg  = k % 2 == 0 ? cRowA : cRowB

            table.cell(stats, 0, row, str.tostring(k + 1), bgcolor = rbg, text_color = cTxtDim, text_size = tSz, text_font_family = tFnt)
            table.cell(stats, 1, row, array.get(tDir, i) == -1 ? "SHORT" : "LONG", bgcolor = rbg, text_color = array.get(tDir, i) == -1 ? cBear : cBull, text_size = tSz, text_font_family = tFnt)
            table.cell(stats, 2, row, str.tostring(array.get(tEnt, i), format.mintick), bgcolor = rbg, text_color = cTxt, text_size = tSz, text_font_family = tFnt)
            table.cell(stats, 3, row, str.tostring(array.get(tStp, i), format.mintick), bgcolor = rbg, text_color = cTxtDim, text_size = tSz, text_font_family = tFnt)
            table.cell(stats, 4, row, res, bgcolor = rbg, text_color = rcol, text_size = tSz, text_font_family = tFnt)
            table.cell(stats, 5, row, st < 2 ? "–" : str.tostring(rr, "#.##") + "R", bgcolor = rbg, text_color = rcol, text_size = tSz, text_font_family = tFnt)
            row += 1

            // tally over the displayed window only
            if w == 1
                wins += 1
            else if w == -1
                losses += 1
            else
                opens += 1
            if st == 2
                totR += rr

        int   decided = wins + losses
        float winPct  = decided > 0 ? 100.0 * wins / decided : 0.0
        color sumCol  = totR > 0 ? cBull : totR < 0 ? cBear : cTxtDim

        table.cell(stats, 0, row, "LAST " + str.tostring(shown), bgcolor = cSumBg, text_color = color.white, text_size = tSz, text_font_family = tFnt)
        table.cell(stats, 1, row, str.tostring(wins) + "W", bgcolor = cSumBg, text_color = cBull, text_size = tSz, text_font_family = tFnt)
        table.cell(stats, 2, row, str.tostring(losses) + "L", bgcolor = cSumBg, text_color = cBear, text_size = tSz, text_font_family = tFnt)
        table.cell(stats, 3, row, opens > 0 ? str.tostring(opens) + " open" : "—", bgcolor = cSumBg, text_color = cTxtDim, text_size = tSz, text_font_family = tFnt)
        table.cell(stats, 4, row, str.tostring(winPct, "#.#") + "% win", bgcolor = cSumBg, text_color = cTxt, text_size = tSz, text_font_family = tFnt)
        table.cell(stats, 5, row, str.tostring(totR, "#.##") + "R", bgcolor = cSumBg, text_color = sumCol, text_size = tSz, text_font_family = tFnt)

// ═══════════════════════ BACKTEST PANEL ═══════════════════════
gB = "Backtest panel"
showBT = input.bool(true, "Show backtest panel", group = gB)
btN    = input.int(100, "Sample size (last N trades)", minval = 10, maxval = 500, group = gB)
btPos  = input.string("Bottom right", "Panel position", options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = gB)

bPos = btPos == "Bottom right" ? position.bottom_right : btPos == "Top left" ? position.top_left : btPos == "Bottom left" ? position.bottom_left : position.top_right
var table bt = table.new(bPos, 2, 14, border_width = 1, frame_width = 1, frame_color = color.new(#8593a8, 55), border_color = color.new(#8593a8, 82))

btRow(r, k, v, vc) =>
    table.cell(bt, 0, r, k, bgcolor = r % 2 == 0 ? cRowA : cRowB, text_color = cTxtDim, text_size = tSz, text_font_family = tFnt, text_halign = text.align_left)
    table.cell(bt, 1, r, v, bgcolor = r % 2 == 0 ? cRowA : cRowB, text_color = vc,      text_size = tSz, text_font_family = tFnt, text_halign = text.align_right)

if showBT and barstate.islast
    table.clear(bt, 0, 0, 1, 13)
    int n = array.size(tSt)
    int start = math.max(0, n - btN)

    int   cW = 0
    int   cL = 0
    int   openN = 0
    float sumR = 0.0
    float gWin = 0.0
    float gLoss = 0.0
    int   lW = 0
    int   lL = 0
    int   sW = 0
    int   sL = 0
    int   streakW = 0
    int   streakL = 0
    int   maxW = 0
    int   maxL = 0
    float eq = 0.0
    float peak = 0.0
    float maxDD = 0.0

    if n > 0
        for i = start to n - 1
            int   st = array.get(tSt, i)
            int   w  = array.get(tWin, i)
            int   d  = array.get(tDir, i)
            float rr = array.get(tRes, i)

            if w == 0
                openN += 1
            else
                if w == 1
                    cW += 1
                    streakW += 1
                    streakL := 0
                    maxW := math.max(maxW, streakW)
                    if d == 1
                        lW += 1
                    else
                        sW += 1
                else
                    cL += 1
                    streakL += 1
                    streakW := 0
                    maxL := math.max(maxL, streakL)
                    if d == 1
                        lL += 1
                    else
                        sL += 1

            if st == 2
                sumR += rr
                if rr > 0
                    gWin += rr
                else
                    gLoss += math.abs(rr)
                eq   += rr
                peak := math.max(peak, eq)
                maxDD := math.max(maxDD, peak - eq)

    int   decided = cW + cL
    float wr  = decided > 0 ? 100.0 * cW / decided : 0.0
    float avg = decided > 0 ? sumR / decided : 0.0
    float pf  = gLoss > 0 ? gWin / gLoss : gWin > 0 ? 999.0 : 0.0
    color rCol = sumR > 0 ? cBull : sumR < 0 ? cBear : cTxtDim

    table.cell(bt, 0, 0, "BACKTEST", bgcolor = cHdrBg, text_color = color.white, text_size = tSz, text_font_family = tFnt, text_halign = text.align_left)
    table.cell(bt, 1, 0, "last " + str.tostring(decided + openN), bgcolor = cHdrBg, text_color = color.white, text_size = tSz, text_font_family = tFnt, text_halign = text.align_right)

    btRow(1,  "Closed trades", str.tostring(decided), cTxt)
    btRow(2,  "Wins",          str.tostring(cW), cBull)
    btRow(3,  "Losses",        str.tostring(cL), cBear)
    btRow(4,  "Win rate",      str.tostring(wr, "#.#") + "%", wr >= 50 ? cBull : cBear)
    btRow(5,  "Total R",       str.tostring(sumR, "#.##") + "R", rCol)
    btRow(6,  "Avg R / trade", str.tostring(avg, "#.###") + "R", avg > 0 ? cBull : cBear)
    btRow(7,  "Profit factor", pf >= 999 ? "∞" : str.tostring(pf, "#.##"), pf >= 1 ? cBull : cBear)
    btRow(8,  "Max drawdown",  "-" + str.tostring(maxDD, "#.##") + "R", cBear)
    btRow(9,  "Max win streak",  str.tostring(maxW), cTxt)
    btRow(10, "Max loss streak", str.tostring(maxL), cTxt)
    btRow(11, "Longs  W/L",    str.tostring(lW) + " / " + str.tostring(lL), cTxt)
    btRow(12, "Shorts W/L",    str.tostring(sW) + " / " + str.tostring(sL), cTxt)
    btRow(13, "Still open",    str.tostring(openN), cTxtDim)

// ─────────────────────────── ALERTS ───────────────────────────
alertcondition(bearPat,  "Bear pattern formed", "3-candle bear pattern on {{ticker}} {{interval}} — watch doji low")
alertcondition(bullPat,  "Bull pattern formed", "3-candle bull pattern on {{ticker}} {{interval}} — watch doji high")
alertcondition(shortSig, "SHORT entry",         "Retest SHORT entry on {{ticker}} {{interval}}")
alertcondition(longSig,  "LONG entry",          "Retest LONG entry on {{ticker}} {{interval}}")
alertcondition(shortSig or longSig, "Any entry", "Doji retest entry on {{ticker}} {{interval}}")
