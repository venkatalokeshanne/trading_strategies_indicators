//@version=6
strategy("BB Strategy + SL + Loss Control", overlay=true, pyramiding=0)

// === 参数 ===
source = close
length = input.int(20)
mult = input.float(2.0)

// 止损（价格差，不是点数）
sl_value = input.float(8.0, title="Stop Loss ($)")

// === 布林带 ===
basis = ta.sma(source, length)
dev = mult * ta.stdev(source, length)
upper = basis + dev
lower = basis - dev

// === 信号 ===
longSignal  = ta.crossover(source, lower)
shortSignal = ta.crossunder(source, upper)

// === 状态变量 ===
var int longLossCount = 0
var int shortLossCount = 0

var bool longBlocked = false
var bool shortBlocked = false

// === 记录开仓价格 ===
var float entryPrice = na
var int lastDirection = 0   // 1=多，-1=空

// === 判断是否刚平仓 ===
closedTrade = strategy.closedtrades > 0 and strategy.closedtrades != strategy.closedtrades[1]

if (closedTrade)
    profit = strategy.closedtrades.profit(strategy.closedtrades - 1)

    // 多单结果
    if (lastDirection == 1)
        if (profit < 0)
            longLossCount += 1
        else
            longLossCount := 0
            shortBlocked := false   // 盈利解除对方限制

        if (longLossCount >= 2)
            longBlocked := true

    // 空单结果
    if (lastDirection == -1)
        if (profit < 0)
            shortLossCount += 1
        else
            shortLossCount := 0
            longBlocked := false

        if (shortLossCount >= 2)
            shortBlocked := true

// === 开仓逻辑 ===

// 做多
if (longSignal and not longBlocked)
    strategy.entry("Long", strategy.long)
    entryPrice := close
    lastDirection := 1

// 做空
if (shortSignal and not shortBlocked)
    strategy.entry("Short", strategy.short)
    entryPrice := close
    lastDirection := -1

// === 止损 ===

// 多单止损
if (strategy.position_size > 0)
    strategy.exit("Long SL", from_entry="Long", stop=entryPrice - sl_value)

// 空单止损
if (strategy.position_size < 0)
    strategy.exit("Short SL", from_entry="Short", stop=entryPrice + sl_value)