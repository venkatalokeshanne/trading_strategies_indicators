//@version=6
indicator("NQ Market Bias Engine", shorttitle="NQ Bias", overlay=true)

//────────────────────────────────────────────
// SETTINGS
//────────────────────────────────────────────
ema9Len   = input.int(9, "EMA 9")
ema20Len  = input.int(20, "EMA 20")
ema30Len  = input.int(30, "EMA 30")
ema50Len  = input.int(50, "EMA 50")
ema200Len = input.int(200, "EMA 200")

volumeLength = input.int(20, "Volume MA Length")
highVolumeMultiplier = input.float(1.25, "High Volume Multiplier")

showEMAs = input.bool(false, "Show EMAs")
showSignals = input.bool(true, "Show Signals")

//────────────────────────────────────────────
// CURRENT TIMEFRAME EMAs
//────────────────────────────────────────────
ema9   = ta.ema(close, ema9Len)
ema20  = ta.ema(close, ema20Len)
ema30  = ta.ema(close, ema30Len)
ema50  = ta.ema(close, ema50Len)
ema200 = ta.ema(close, ema200Len)

//────────────────────────────────────────────
// VOLUME
//────────────────────────────────────────────
volumeMA = ta.sma(volume, volumeLength)

volumeRatio = volumeMA > 0 ? volume / volumeMA : 1.0

highVolume = volumeRatio >= highVolumeMultiplier
lowVolume  = volumeRatio < 0.85

bullVolume = highVolume and close > open
bearVolume = highVolume and close < open

//────────────────────────────────────────────
// VWAP
//────────────────────────────────────────────
vwapValue = ta.vwap(hlc3)

//────────────────────────────────────────────
// ADX / DIRECTION
//────────────────────────────────────────────
[diPlus, diMinus, adx] = ta.dmi(14, 14)

//────────────────────────────────────────────
// TREND SCORE FUNCTION
//────────────────────────────────────────────
getTrendScore() =>
    e20 = ta.ema(close, ema20Len)
    e30 = ta.ema(close, ema30Len)
    e50 = ta.ema(close, ema50Len)
    e200 = ta.ema(close, ema200Len)

    int score = 0

    score += close > e20 ? 1 : -1
    score += close > e30 ? 1 : -1
    score += close > e50 ? 1 : -1
    score += close > e200 ? 1 : -1

    score += e20 > e30 ? 1 : -1
    score += e30 > e50 ? 1 : -1
    score += e50 > e200 ? 1 : -1

    score

//────────────────────────────────────────────
// MULTI-TIMEFRAME TREND
//────────────────────────────────────────────
score1H = request.security(syminfo.tickerid, "60", getTrendScore())
score15 = request.security(syminfo.tickerid, "15", getTrendScore())
score10 = request.security(syminfo.tickerid, "10", getTrendScore())
score5  = request.security(syminfo.tickerid, "5", getTrendScore())

// Convert -7/+7 into 0-100
score1H100 = (score1H + 7.0) / 14.0 * 100.0
score15_100 = (score15 + 7.0) / 14.0 * 100.0
score10_100 = (score10 + 7.0) / 14.0 * 100.0
score5_100 = (score5 + 7.0) / 14.0 * 100.0

//────────────────────────────────────────────
// EMA STRUCTURE
//────────────────────────────────────────────
emaBull =
     ema9 > ema20 and
     ema20 > ema30 and
     ema30 > ema50 and
     ema50 > ema200

emaBear =
     ema9 < ema20 and
     ema20 < ema30 and
     ema30 < ema50 and
     ema50 < ema200

emaComponent =
     emaBull ? 100.0 :
     emaBear ? 0.0 :
     close > ema50 ? 65.0 :
     close < ema50 ? 35.0 :
     50.0

//────────────────────────────────────────────
// VWAP COMPONENT
//────────────────────────────────────────────
vwapBull = close > vwapValue
vwapBear = close < vwapValue

vwapComponent =
     vwapBull ? 65.0 :
     vwapBear ? 35.0 :
     50.0

//────────────────────────────────────────────
// MOMENTUM
//────────────────────────────────────────────
momentumComponent =
     adx >= 20 and diPlus > diMinus ? 100.0 :
     adx >= 20 and diMinus > diPlus ? 0.0 :
     50.0

//────────────────────────────────────────────
// VOLUME COMPONENT
//────────────────────────────────────────────
volumeComponent =
     bullVolume ? 100.0 :
     bearVolume ? 0.0 :
     50.0

//────────────────────────────────────────────
// MULTI-TIMEFRAME WEIGHT
//────────────────────────────────────────────
mtfComponent =
     score1H100 * 0.30 +
     score15_100 * 0.30 +
     score10_100 * 0.20 +
     score5_100 * 0.20

//────────────────────────────────────────────
// FINAL BIAS SCORE
//────────────────────────────────────────────
biasScore =
     mtfComponent * 0.55 +
     emaComponent * 0.20 +
     vwapComponent * 0.10 +
     momentumComponent * 0.10 +
     volumeComponent * 0.05

//────────────────────────────────────────────
// CHOP DETECTOR
//────────────────────────────────────────────
atrValue = ta.atr(14)

emaSpread = math.abs(ema20 - ema50)

compressed =
     atrValue > 0 and
     emaSpread / atrValue < 0.35

weakTrend = adx < 18

timeframesMixed =
     (score1H > 0 and score15 < 0) or
     (score1H < 0 and score15 > 0)

isChop =
     (compressed and weakTrend) or
     (timeframesMixed and weakTrend)

//────────────────────────────────────────────
// FINAL MARKET STATE
//────────────────────────────────────────────
bullish = biasScore >= 65 and not isChop
bearish = biasScore <= 35 and not isChop

marketState =
     isChop ? "CHOP / CONSOLIDATING" :
     bullish ? "BULLISH" :
     bearish ? "BEARISH" :
     "NEUTRAL"

//────────────────────────────────────────────
// TEXT FUNCTION
//────────────────────────────────────────────
trendText(score) =>
     score >= 5 ? "BULLISH" :
     score <= -5 ? "BEARISH" :
     "MIXED"

//────────────────────────────────────────────
// DASHBOARD
//────────────────────────────────────────────
var table dashboard = table.new(position.top_right, 3, 10)

if barstate.islast

    table.cell(dashboard, 0, 0, "NQ MARKET BIAS")
    table.cell(dashboard, 1, 0, str.tostring(math.round(biasScore)))
    table.cell(dashboard, 2, 0, marketState)

    table.cell(dashboard, 0, 1, "1 HOUR")
    table.cell(dashboard, 1, 1, trendText(score1H))
    table.cell(dashboard, 2, 1, str.tostring(math.round(score1H100)))

    table.cell(dashboard, 0, 2, "15 MIN")
    table.cell(dashboard, 1, 2, trendText(score15))
    table.cell(dashboard, 2, 2, str.tostring(math.round(score15_100)))

    table.cell(dashboard, 0, 3, "10 MIN")
    table.cell(dashboard, 1, 3, trendText(score10))
    table.cell(dashboard, 2, 3, str.tostring(math.round(score10_100)))

    table.cell(dashboard, 0, 4, "5 MIN")
    table.cell(dashboard, 1, 4, trendText(score5))
    table.cell(dashboard, 2, 4, str.tostring(math.round(score5_100)))

    table.cell(dashboard, 0, 5, "VWAP")
    table.cell(dashboard, 1, 5, vwapBull ? "ABOVE" : "BELOW")
    table.cell(dashboard, 2, 5, vwapBull ? "BULL" : "BEAR")

    table.cell(dashboard, 0, 6, "VOLUME")
    table.cell(dashboard, 1, 6, highVolume ? "HIGH" : lowVolume ? "LOW" : "NORMAL")
    table.cell(dashboard, 2, 6, bullVolume ? "BULL" : bearVolume ? "BEAR" : "NEUTRAL")

    table.cell(dashboard, 0, 7, "ADX")
    table.cell(dashboard, 1, 7, str.tostring(math.round(adx)))
    table.cell(dashboard, 2, 7, adx >= 20 ? "TRENDING" : "WEAK")

    table.cell(dashboard, 0, 8, "EMA STRUCTURE")
    table.cell(dashboard, 1, 8, emaBull ? "BULLISH" : emaBear ? "BEARISH" : "MIXED")
    table.cell(dashboard, 2, 8, emaBull or emaBear ? "ALIGNED" : "MIXED")

    table.cell(dashboard, 0, 9, "ACTION")
    table.cell(dashboard, 1, 9,
         isChop ? "WAIT" :
         bullish ? "LOOK LONG" :
         bearish ? "LOOK SHORT" :
         "WAIT")

    table.cell(dashboard, 2, 9,
         isChop ? "CHOP" :
         bullish ? "CONFIRM" :
         bearish ? "CONFIRM" :
         "WAIT")

//────────────────────────────────────────────
// OPTIONAL EMA LINES
//────────────────────────────────────────────
plot(showEMAs ? ema9 : na, "EMA 9")
plot(showEMAs ? ema20 : na, "EMA 20")
plot(showEMAs ? ema30 : na, "EMA 30")
plot(showEMAs ? ema50 : na, "EMA 50")
plot(showEMAs ? ema200 : na, "EMA 200")

//────────────────────────────────────────────
// SIGNALS
//────────────────────────────────────────────
bullSignal = bullish and not bullish[1]
bearSignal = bearish and not bearish[1]
chopSignal = isChop and not isChop[1]

plotshape(
     showSignals and bullSignal,
     title="Bullish Signal",
     style=shape.triangleup,
     location=location.belowbar,
     size=size.small,
     text="BULL")

plotshape(
     showSignals and bearSignal,
     title="Bearish Signal",
     style=shape.triangledown,
     location=location.abovebar,
     size=size.small,
     text="BEAR")

plotshape(
     showSignals and chopSignal,
     title="Chop Signal",
     style=shape.diamond,
     location=location.abovebar,
     size=size.tiny,
     text="CHOP")

//────────────────────────────────────────────
// ALERTS
//────────────────────────────────────────────
alertcondition(
     bullSignal,
     title="NQ Bullish Bias",
     message="NQ Market Bias changed to BULLISH.")

alertcondition(
     bearSignal,
     title="NQ Bearish Bias",
     message="NQ Market Bias changed to BEARISH.")

alertcondition(
     chopSignal,
     title="NQ Consolidation",
     message="NQ Market Bias detected CHOP / CONSOLIDATION.")