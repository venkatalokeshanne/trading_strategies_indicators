//@version=6
indicator("NIFTY Session Regime Dashboard", overlay=true, max_labels_count=500, dynamic_requests=true)

//====================================================================
// INPUTS
//====================================================================

groupModel = "TREND MODEL"

bullThreshold = input.float(60.0, "Bullish Rating Threshold", minval=50.0, maxval=100.0, step=5.0, group=groupModel)

bearThreshold = input.float(60.0, "Bearish Rating Threshold", minval=50.0, maxval=100.0, step=5.0, group=groupModel)

strongThreshold = input.float(70.0, "Strong Trend Threshold", minval=60.0, maxval=90.0, step=5.0, group=groupModel)

mom15Full = input.float(0.50, "15m Change For Full Score (%)", minval=0.10, step=0.10, group=groupModel)

mom60Full = input.float(1.00, "1H Change For Full Score (%)", minval=0.10, step=0.10, group=groupModel)

persistenceLevel = input.float(20.0, "Persistence Score Level", minval=10.0, maxval=50.0, step=5.0, group=groupModel)


groupDisplay = "DASHBOARD"

dashboardPosition = input.string(
     "Top Right",
     "Dashboard Position",
     options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"],
     group=groupDisplay)

fontSizeInput = input.string(
     "Small",
     "Font Size",
     options=["Tiny", "Small", "Normal", "Large", "Huge"],
     group=groupDisplay)

normalTextColor = input.color(
     color.black,
     "Normal Text Color",
     group=groupDisplay)

normalBackgroundColor = input.color(
     color.rgb(235, 235, 235),
     "Normal Cell Background",
     group=groupDisplay)

headerTextColor = input.color(
     color.white,
     "Header Text Color",
     group=groupDisplay)

headerBackgroundColor = input.color(
     color.black,
     "Header Background",
     group=groupDisplay)

highlightTextColor = input.color(
     color.white,
     "Highlight Text Color",
     group=groupDisplay)

showBackground = input.bool(
     true,
     "Show Trend Background",
     group=groupDisplay)

showConstituents = input.bool(
     true,
     "Show Constituents",
     group=groupDisplay)


//====================================================================
// FUNCTIONS
//====================================================================

clampValue(value, minimum, maximum) =>
    math.max(minimum, math.min(maximum, value))


getPosition() =>
    if dashboardPosition == "Top Left"
        position.top_left
    else if dashboardPosition == "Top Right"
        position.top_right
    else if dashboardPosition == "Bottom Left"
        position.bottom_left
    else
        position.bottom_right


getFontSize() =>
    if fontSizeInput == "Tiny"
        size.tiny
    else if fontSizeInput == "Small"
        size.small
    else if fontSizeInput == "Normal"
        size.normal
    else if fontSizeInput == "Large"
        size.large
    else
        size.huge


//====================================================================
// DATA FUNCTIONS
//====================================================================

get15(symbol) =>
    request.security(symbol, "15", [close, ta.vwap(close), ta.rsi(close, 14), (close / close[1] - 1.0) * 100.0], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)


getDaily(symbol) =>
    request.security(symbol, "D", [high[1], low[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)


getHourly(symbol) =>
    request.security(symbol, "60", (close / close[1] - 1.0) * 100.0, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)


//====================================================================
// CONSTITUENT SCORE
//
// VWAP       = 20%
// RSI        = 20%
// PDH/PDL    = 20%
// 15m CHANGE = 20%
// 1H CHANGE  = 20%
//
// SCORE = -100 TO +100
//====================================================================

calcScore(price, vwapValue, rsiValue, pdHigh, pdLow, change15, change60) =>

    float vwapScore = 0.0

    if price > vwapValue
        vwapScore := 1.0
    else if price < vwapValue
        vwapScore := -1.0


    float rsiScore = clampValue(
         (rsiValue - 50.0) / 20.0,
         -1.0,
         1.0)


    float rangeScore = 0.0

    float previousRange = pdHigh - pdLow

    if previousRange > 0.0

        float rangeLocation = (price - pdLow) / previousRange

        if rangeLocation >= 1.0
            rangeScore := 1.0
        else if rangeLocation >= 0.75
            rangeScore := 0.50
        else if rangeLocation >= 0.50
            rangeScore := 0.25
        else if rangeLocation >= 0.25
            rangeScore := -0.25
        else if rangeLocation >= 0.0
            rangeScore := -0.50
        else
            rangeScore := -1.0


    float momentum15 = clampValue(
         change15 / mom15Full,
         -1.0,
         1.0)


    float momentum60 = clampValue(
         change60 / mom60Full,
         -1.0,
         1.0)


    float finalScore = (
         vwapScore +
         rsiScore +
         rangeScore +
         momentum15 +
         momentum60
         ) / 5.0


    finalScore * 100.0


//====================================================================
// NIFTY TOP 10 WEIGHTS
//====================================================================

float wHDFC = 10.27
float wICICI = 9.22
float wRELIANCE = 7.92
float wBHARTI = 5.37
float wLT = 4.13
float wSBI = 3.81
float wINFY = 3.55
float wAXIS = 3.16
float wBAJFIN = 2.74
float wMM = 2.72

float totalWeight = wHDFC + wICICI + wRELIANCE + wBHARTI + wLT + wSBI + wINFY + wAXIS + wBAJFIN + wMM


//====================================================================
// HDFC BANK
//====================================================================

[hPrice, hVWAP, hRSI, h15] = get15("NSE:HDFCBANK")
[hPDH, hPDL] = getDaily("NSE:HDFCBANK")
h60 = getHourly("NSE:HDFCBANK")
hScore = calcScore(hPrice, hVWAP, hRSI, hPDH, hPDL, h15, h60)


//====================================================================
// ICICI BANK
//====================================================================

[iPrice, iVWAP, iRSI, i15] = get15("NSE:ICICIBANK")
[iPDH, iPDL] = getDaily("NSE:ICICIBANK")
i60 = getHourly("NSE:ICICIBANK")
iScore = calcScore(iPrice, iVWAP, iRSI, iPDH, iPDL, i15, i60)


//====================================================================
// RELIANCE
//====================================================================

[rPrice, rVWAP, rRSI, r15] = get15("NSE:RELIANCE")
[rPDH, rPDL] = getDaily("NSE:RELIANCE")
r60 = getHourly("NSE:RELIANCE")
rScore = calcScore(rPrice, rVWAP, rRSI, rPDH, rPDL, r15, r60)


//====================================================================
// BHARTI AIRTEL
//====================================================================

[bPrice, bVWAP, bRSI, b15] = get15("NSE:BHARTIARTL")
[bPDH, bPDL] = getDaily("NSE:BHARTIARTL")
b60 = getHourly("NSE:BHARTIARTL")
bScore = calcScore(bPrice, bVWAP, bRSI, bPDH, bPDL, b15, b60)


//====================================================================
// L&T
//====================================================================

[lPrice, lVWAP, lRSI, l15] = get15("NSE:LT")
[lPDH, lPDL] = getDaily("NSE:LT")
l60 = getHourly("NSE:LT")
lScore = calcScore(lPrice, lVWAP, lRSI, lPDH, lPDL, l15, l60)


//====================================================================
// SBI
//====================================================================

[sPrice, sVWAP, sRSI, s15] = get15("NSE:SBIN")
[sPDH, sPDL] = getDaily("NSE:SBIN")
s60 = getHourly("NSE:SBIN")
sScore = calcScore(sPrice, sVWAP, sRSI, sPDH, sPDL, s15, s60)


//====================================================================
// INFOSYS
//====================================================================

[inPrice, inVWAP, inRSI, in15] = get15("NSE:INFY")
[inPDH, inPDL] = getDaily("NSE:INFY")
in60 = getHourly("NSE:INFY")
inScore = calcScore(inPrice, inVWAP, inRSI, inPDH, inPDL, in15, in60)


//====================================================================
// AXIS BANK
//====================================================================

[aPrice, aVWAP, aRSI, a15] = get15("NSE:AXISBANK")
[aPDH, aPDL] = getDaily("NSE:AXISBANK")
a60 = getHourly("NSE:AXISBANK")
aScore = calcScore(aPrice, aVWAP, aRSI, aPDH, aPDL, a15, a60)


//====================================================================
// BAJAJ FINANCE
//====================================================================

[bfPrice, bfVWAP, bfRSI, bf15] = get15("NSE:BAJFINANCE")
[bfPDH, bfPDL] = getDaily("NSE:BAJFINANCE")
bf60 = getHourly("NSE:BAJFINANCE")
bfScore = calcScore(bfPrice, bfVWAP, bfRSI, bfPDH, bfPDL, bf15, bf60)


//====================================================================
// M&M
//====================================================================

[mmPrice, mmVWAP, mmRSI, mm15] = get15("NSE:M&M")
[mmPDH, mmPDL] = getDaily("NSE:M&M")
mm60 = getHourly("NSE:M&M")
mmScore = calcScore(mmPrice, mmVWAP, mmRSI, mmPDH, mmPDL, mm15, mm60)


//====================================================================
// WEIGHTED NIFTY SCORE
//====================================================================

float weightedScore =
     hScore * wHDFC +
     iScore * wICICI +
     rScore * wRELIANCE +
     bScore * wBHARTI +
     lScore * wLT +
     sScore * wSBI +
     inScore * wINFY +
     aScore * wAXIS +
     bfScore * wBAJFIN +
     mmScore * wMM


float niftyScore =
     weightedScore / totalWeight


//====================================================================
// BULL / BEAR RATINGS
//====================================================================

float bullishRating =
     clampValue(
         (niftyScore + 100.0) / 2.0,
         0.0,
         100.0)


float bearishRating =
     clampValue(
         (100.0 - niftyScore) / 2.0,
         0.0,
         100.0)


//====================================================================
// EQUAL-WEIGHT BREADTH
//====================================================================

int bullCount =
     (hScore > 0.0 ? 1 : 0) +
     (iScore > 0.0 ? 1 : 0) +
     (rScore > 0.0 ? 1 : 0) +
     (bScore > 0.0 ? 1 : 0) +
     (lScore > 0.0 ? 1 : 0) +
     (sScore > 0.0 ? 1 : 0) +
     (inScore > 0.0 ? 1 : 0) +
     (aScore > 0.0 ? 1 : 0) +
     (bfScore > 0.0 ? 1 : 0) +
     (mmScore > 0.0 ? 1 : 0)


int bearCount = 10 - bullCount


//====================================================================
// WEIGHTED BREADTH
//====================================================================

float bullWeight =
     (hScore > 0.0 ? wHDFC : 0.0) +
     (iScore > 0.0 ? wICICI : 0.0) +
     (rScore > 0.0 ? wRELIANCE : 0.0) +
     (bScore > 0.0 ? wBHARTI : 0.0) +
     (lScore > 0.0 ? wLT : 0.0) +
     (sScore > 0.0 ? wSBI : 0.0) +
     (inScore > 0.0 ? wINFY : 0.0) +
     (aScore > 0.0 ? wAXIS : 0.0) +
     (bfScore > 0.0 ? wBAJFIN : 0.0) +
     (mmScore > 0.0 ? wMM : 0.0)


float bearWeight = totalWeight - bullWeight

float bullWeightedBreadth = bullWeight / totalWeight * 100.0

float bearWeightedBreadth = bearWeight / totalWeight * 100.0


//====================================================================
// VWAP BREADTH
//====================================================================

int vwapBullCount =
     (hPrice > hVWAP ? 1 : 0) +
     (iPrice > iVWAP ? 1 : 0) +
     (rPrice > rVWAP ? 1 : 0) +
     (bPrice > bVWAP ? 1 : 0) +
     (lPrice > lVWAP ? 1 : 0) +
     (sPrice > sVWAP ? 1 : 0) +
     (inPrice > inVWAP ? 1 : 0) +
     (aPrice > aVWAP ? 1 : 0) +
     (bfPrice > bfVWAP ? 1 : 0) +
     (mmPrice > mmVWAP ? 1 : 0)


int vwapBearCount = 10 - vwapBullCount


//====================================================================
// TREND STRENGTH
//====================================================================

float directionStrength = math.abs(niftyScore)

float breadthStrength = math.max(bullCount, bearCount) * 10.0

float trendStrength =
     directionStrength * 0.50 +
     breadthStrength * 0.50


//====================================================================
// ACCELERATION
//====================================================================

float previousScore = nz(niftyScore[1], niftyScore)

float scoreAcceleration = niftyScore - previousScore


//====================================================================
// PERSISTENCE
//====================================================================

var int bullPersistence = 0
var int bearPersistence = 0

if niftyScore >= persistenceLevel
    bullPersistence := bullPersistence + 1
else
    bullPersistence := 0

if niftyScore <= -persistenceLevel
    bearPersistence := bearPersistence + 1
else
    bearPersistence := 0


//====================================================================
// NIFTY PREVIOUS DAY HIGH / LOW
//====================================================================

niftyPDH =
     request.security(
         "NSE:NIFTY",
         "D",
         high[1],
         gaps=barmerge.gaps_off,
         lookahead=barmerge.lookahead_off)


niftyPDL =
     request.security(
         "NSE:NIFTY",
         "D",
         low[1],
         gaps=barmerge.gaps_off,
         lookahead=barmerge.lookahead_off)


float niftyPDMid = (niftyPDH + niftyPDL) / 2.0


//====================================================================
// PREVIOUS DAY RANGE POSITION
//====================================================================

string pdPosition = "MID RANGE"

if close > niftyPDH
    pdPosition := "ABOVE PDH"
else if close >= niftyPDMid
    pdPosition := "UPPER HALF"
else if close > niftyPDL
    pdPosition := "LOWER HALF"
else
    pdPosition := "BELOW PDL"


//====================================================================
// OPENING RANGE
//
// On a 15-minute chart this is the first 15-minute candle.
//====================================================================

bool newDay = ta.change(time("D")) != 0

var float openingHigh = na
var float openingLow = na

if newDay
    openingHigh := high
    openingLow := low

if na(openingHigh)
    openingHigh := high

if na(openingLow)
    openingLow := low


string openingRangeStatus = "INSIDE OR"

if close > openingHigh
    openingRangeStatus := "ABOVE OR"
else if close < openingLow
    openingRangeStatus := "BELOW OR"


//====================================================================
// AVERAGE MOMENTUM
//====================================================================

float avg15Momentum =
     (
         h15 +
         i15 +
         r15 +
         b15 +
         l15 +
         s15 +
         in15 +
         a15 +
         bf15 +
         mm15
     ) / 10.0


float avg60Momentum =
     (
         h60 +
         i60 +
         r60 +
         b60 +
         l60 +
         s60 +
         in60 +
         a60 +
         bf60 +
         mm60
     ) / 10.0


//====================================================================
// MOMENTUM REGIME
//====================================================================

string momentumRegime = "MIXED"

bool momentumBull =
     avg15Momentum > 0.0 and
     avg60Momentum > 0.0

bool momentumBear =
     avg15Momentum < 0.0 and
     avg60Momentum < 0.0

bool momentumShortBull =
     avg15Momentum > 0.0 and
     avg60Momentum <= 0.0

bool momentumShortBear =
     avg15Momentum < 0.0 and
     avg60Momentum >= 0.0


if momentumBull
    momentumRegime := "15m UP / 1H UP"
else if momentumBear
    momentumRegime := "15m DOWN / 1H DOWN"
else if momentumShortBull
    momentumRegime := "15m UP / 1H MIXED"
else if momentumShortBear
    momentumRegime := "15m DOWN / 1H MIXED"
else
    momentumRegime := "MIXED"


//====================================================================
// SESSION REGIME CONDITIONS
//====================================================================

bool strongBullCondition =
     bullishRating >= strongThreshold and
     bullCount >= 7 and
     bullWeightedBreadth >= 65.0 and
     vwapBullCount >= 7


bool bullCondition =
     bullishRating >= bullThreshold and
     bullCount >= 6 and
     bullWeightedBreadth >= 55.0


bool strongBearCondition =
     bearishRating >= strongThreshold and
     bearCount >= 7 and
     bearWeightedBreadth >= 65.0 and
     vwapBearCount >= 7


bool bearCondition =
     bearishRating >= bearThreshold and
     bearCount >= 6 and
     bearWeightedBreadth >= 55.0


//====================================================================
// FINAL TREND
//====================================================================

string trend = "ROTATIONAL"

if strongBullCondition
    trend := "STRONG BULL"
else if bullCondition
    trend := "BULLISH"
else if strongBearCondition
    trend := "STRONG BEAR"
else if bearCondition
    trend := "BEARISH"
else
    trend := "ROTATIONAL"


//====================================================================
// TREND COLOR
//====================================================================

color trendColor = color.gray

if trend == "STRONG BULL"
    trendColor := color.green
else if trend == "BULLISH"
    trendColor := color.lime
else if trend == "STRONG BEAR"
    trendColor := color.red
else if trend == "BEARISH"
    trendColor := color.orange
else
    trendColor := color.gray


//====================================================================
// ACCELERATION COLOR
//====================================================================

color accelerationColor = color.gray

if scoreAcceleration > 5.0
    accelerationColor := color.green
else if scoreAcceleration < -5.0
    accelerationColor := color.red


//====================================================================
// RATING COLORS
//====================================================================

color bullRatingColor = color.gray

if bullishRating >= 70.0
    bullRatingColor := color.green
else if bullishRating >= 55.0
    bullRatingColor := color.lime


color bearRatingColor = color.gray

if bearishRating >= 70.0
    bearRatingColor := color.red
else if bearishRating >= 55.0
    bearRatingColor := color.orange


//====================================================================
// TABLE
//====================================================================

var table dash =
     table.new(
         position.top_right,
         7,
         18,
         border_width=1)


table.set_position(
     dash,
     getPosition())


textSize = getFontSize()


//====================================================================
// DASHBOARD
//====================================================================

if barstate.islast

    //==============================================================
    // HEADER
    //==============================================================

    table.cell(dash, 0, 0, "NIFTY SESSION", text_color=headerTextColor, bgcolor=headerBackgroundColor, text_size=textSize)
    table.cell(dash, 1, 0, "VALUE", text_color=headerTextColor, bgcolor=headerBackgroundColor, text_size=textSize)
    table.cell(dash, 2, 0, "STATUS", text_color=headerTextColor, bgcolor=headerBackgroundColor, text_size=textSize)
    table.cell(dash, 3, 0, "BREADTH", text_color=headerTextColor, bgcolor=headerBackgroundColor, text_size=textSize)
    table.cell(dash, 4, 0, "WEIGHT", text_color=headerTextColor, bgcolor=headerBackgroundColor, text_size=textSize)
    table.cell(dash, 5, 0, "MOMENTUM", text_color=headerTextColor, bgcolor=headerBackgroundColor, text_size=textSize)
    table.cell(dash, 6, 0, "VWAP", text_color=headerTextColor, bgcolor=headerBackgroundColor, text_size=textSize)


    //==============================================================
    // BULL RATING
    //==============================================================

    string bullStatus = "WEAK"

    if bullishRating >= bullThreshold
        bullStatus := "PASS"


    table.cell(dash, 0, 1, "BULL RATING", text_color=highlightTextColor, bgcolor=color.green, text_size=textSize)

    table.cell(dash, 1, 1, str.tostring(bullishRating, "#.0"), text_color=highlightTextColor, bgcolor=bullRatingColor, text_size=textSize)

    table.cell(dash, 2, 1, bullStatus, text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 3, 1, str.tostring(bullCount) + "/10", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 4, 1, str.tostring(bullWeightedBreadth, "#.0") + "%", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 5, 1, str.tostring(avg15Momentum, "#.2") + "%", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 6, 1, str.tostring(vwapBullCount) + "/10", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)


    //==============================================================
    // BEAR RATING
    //==============================================================

    string bearStatus = "WEAK"

    if bearishRating >= bearThreshold
        bearStatus := "PASS"


    table.cell(dash, 0, 2, "BEAR RATING", text_color=highlightTextColor, bgcolor=color.red, text_size=textSize)

    table.cell(dash, 1, 2, str.tostring(bearishRating, "#.0"), text_color=highlightTextColor, bgcolor=bearRatingColor, text_size=textSize)

    table.cell(dash, 2, 2, bearStatus, text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 3, 2, str.tostring(bearCount) + "/10", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 4, 2, str.tostring(bearWeightedBreadth, "#.0") + "%", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 5, 2, str.tostring(avg60Momentum, "#.2") + "%", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 6, 2, str.tostring(vwapBearCount) + "/10", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)


    //==============================================================
    // SESSION REGIME
    //==============================================================

    table.cell(dash, 0, 3, "SESSION REGIME", text_color=headerTextColor, bgcolor=headerBackgroundColor, text_size=textSize)

    table.cell(dash, 1, 3, trend, text_color=highlightTextColor, bgcolor=trendColor, text_size=textSize)

    table.cell(dash, 2, 3, "SCORE", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 3, 3, str.tostring(niftyScore, "#.0"), text_color=highlightTextColor, bgcolor=trendColor, text_size=textSize)

    table.cell(dash, 4, 3, "STRENGTH", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 5, 3, str.tostring(trendStrength, "#.0"), text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 6, 3, "TOP 10", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)


    //==============================================================
    // ACCELERATION
    //==============================================================

    string accelerationStatus = "STABLE"

    if scoreAcceleration > 5.0
        accelerationStatus := "IMPROVING"
    else if scoreAcceleration < -5.0
        accelerationStatus := "WEAKENING"


    string persistenceText = "0 BARS"

    if bullPersistence > 0
        persistenceText := str.tostring(bullPersistence) + " BULL"
    else if bearPersistence > 0
        persistenceText := str.tostring(bearPersistence) + " BEAR"


    table.cell(dash, 0, 4, "ACCELERATION", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 1, 4, str.tostring(scoreAcceleration, "#.0"), text_color=highlightTextColor, bgcolor=accelerationColor, text_size=textSize)

    table.cell(dash, 2, 4, accelerationStatus, text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 3, 4, "Δ SCORE", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 4, 4, "PERSISTENCE", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 5, 4, persistenceText, text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 6, 4, "LEVEL " + str.tostring(persistenceLevel, "#"), text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)


    //==============================================================
    // MARKET STRUCTURE
    //==============================================================

    string shortMomentumStatus = "MIXED"

    if avg15Momentum > 0.0
        shortMomentumStatus := "BULL"
    else if avg15Momentum < 0.0
        shortMomentumStatus := "BEAR"


    table.cell(dash, 0, 5, "MARKET STRUCTURE", text_color=headerTextColor, bgcolor=headerBackgroundColor, text_size=textSize)

    table.cell(dash, 1, 5, pdPosition, text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 2, 5, "OPEN RANGE", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 3, 5, openingRangeStatus, text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 4, 5, "15m", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 5, 5, shortMomentumStatus, text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 6, 5, "1H", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)


    //==============================================================
    // MOMENTUM REGIME
    //==============================================================

    table.cell(dash, 0, 6, "MOMENTUM REGIME", text_color=headerTextColor, bgcolor=headerBackgroundColor, text_size=textSize)

    table.cell(dash, 1, 6, momentumRegime, text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 2, 6, "VWAP", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 3, 6, str.tostring(vwapBullCount) + " B / " + str.tostring(vwapBearCount) + " S", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 4, 6, "BREADTH", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 5, 6, str.tostring(bullCount) + " B / " + str.tostring(bearCount) + " S", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

    table.cell(dash, 6, 6, str.tostring(bullWeightedBreadth, "#.0") + "% B", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)


    //==============================================================
    // CONSTITUENT HEADER
    //==============================================================

    if showConstituents

        table.cell(dash, 0, 7, "CONSTITUENT", text_color=headerTextColor, bgcolor=headerBackgroundColor, text_size=textSize)

        table.cell(dash, 1, 7, "SCORE", text_color=headerTextColor, bgcolor=headerBackgroundColor, text_size=textSize)

        table.cell(dash, 2, 7, "WT", text_color=headerTextColor, bgcolor=headerBackgroundColor, text_size=textSize)

        table.cell(dash, 3, 7, "RSI", text_color=headerTextColor, bgcolor=headerBackgroundColor, text_size=textSize)

        table.cell(dash, 4, 7, "15m", text_color=headerTextColor, bgcolor=headerBackgroundColor, text_size=textSize)

        table.cell(dash, 5, 7, "1H", text_color=headerTextColor, bgcolor=headerBackgroundColor, text_size=textSize)

        table.cell(dash, 6, 7, "VWAP", text_color=headerTextColor, bgcolor=headerBackgroundColor, text_size=textSize)


        //============================================================
        // HDFC BANK
        //============================================================

        string hVWAPText = "BELOW"

        if hPrice > hVWAP
            hVWAPText := "ABOVE"


        table.cell(dash, 0, 8, "HDFC Bank", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

        table.cell(dash, 1, 8, str.tostring(hScore, "#.0"), text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

        table.cell(dash, 2, 8, "10.27%", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

        table.cell(dash, 3, 8, str.tostring(hRSI, "#.0"), text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

        table.cell(dash, 4, 8, str.tostring(h15, "#.2") + "%", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

        table.cell(dash, 5, 8, str.tostring(h60, "#.2") + "%", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

        table.cell(dash, 6, 8, hVWAPText, text_color=highlightTextColor, bgcolor=hPrice > hVWAP ? color.green : color.red, text_size=textSize)


        //============================================================
        // ICICI BANK
