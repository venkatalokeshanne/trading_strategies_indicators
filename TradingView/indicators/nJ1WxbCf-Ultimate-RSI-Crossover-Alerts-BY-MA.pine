//
// Modified version of "Ultimate RSI [LuxAlgo]" — migrated to Pine Script v6.
// Added: configurable median line, zone-filtered signal-line cross markers, and alerts.
// Distributed under the same CC BY-NC-SA 4.0 license as the original.

//@version=6
indicator("Ultimate RSI + Median Cross Alerts", "URSI - Median Cross")
//------------------------------------------------------------------------------
//Settings
//-----------------------------------------------------------------------------{
length   = input.int(14, minval = 2)
smoType1 = input.string('RMA', 'Method', options = ['EMA', 'SMA', 'RMA', 'TMA'])
src      = input.source(close, 'Source')

arsiCss = input.color(color.silver, 'Color', inline = 'rsicss')
autoCss = input.bool(true, 'Auto', inline = 'rsicss')

//Signal Line
smooth   = input.int(14, minval = 1, group = 'Signal Line')
smoType2 = input.string('EMA', 'Method', options = ['EMA', 'SMA', 'RMA', 'TMA'], group = 'Signal Line')

signalCss = input.color(#ff5d00, 'Color', group = 'Signal Line')

//Median Line / Alerts
midLevel   = input.float(50, 'Median Line Level', minval = 1, maxval = 99, group = 'Median Line & Alerts',
     tooltip = 'The horizontal line used as the median. 50 is the classic RSI midline.')
zoneFilter = input.string('Below median', 'Signal cross zone', options = ['Below median', 'Above median', 'Anywhere'],
     group = 'Median Line & Alerts',
     tooltip = 'Where an RSI/Signal-line cross must happen to count.\nBelow median = only crosses occurring under the 50 line (bearish zone).\nThe RSI value at the moment of the cross is what is tested.')
showMarks  = input.bool(true, 'Show signal-line cross markers', group = 'Median Line & Alerts')
onBarClose = input.bool(true, 'Alert only on bar close', group = 'Median Line & Alerts',
     tooltip = 'ON  = the alert fires only if the cross still holds when the bar closes (no false pops).\nOFF = fires the instant it crosses intrabar.')

//OB/OS Style
obValue   = input.float(80, 'Overbought', inline = 'ob', group = 'OB/OS Style')
obCss     = input.color(#089981, '', inline = 'ob', group = 'OB/OS Style')
obAreaCss = input.color(color.new(#089981, 80), '', inline = 'ob', group = 'OB/OS Style')

osValue   = input.float(20, 'Oversold    ', inline = 'os', group = 'OB/OS Style')
osCss     = input.color(#f23645, '', inline = 'os', group = 'OB/OS Style')
osAreaCss = input.color(color.new(#f23645, 80), '', inline = 'os', group = 'OB/OS Style')

//-----------------------------------------------------------------------------}
//Functions
//-----------------------------------------------------------------------------{
ma(x, len, maType) =>
    switch maType
        'EMA' => ta.ema(x, len)
        'SMA' => ta.sma(x, len)
        'RMA' => ta.rma(x, len)
        'TMA' => ta.sma(ta.sma(x, len), len)

//-----------------------------------------------------------------------------}
//Augmented RSI
//-----------------------------------------------------------------------------{
upper = ta.highest(src, length)
lower = ta.lowest(src, length)
r = upper - lower

d = src - src[1]
diff = upper > upper[1] ? r
  : lower < lower[1] ? -r
  : d

num = ma(diff, length, smoType1)
den = ma(math.abs(diff), length, smoType1)
arsi = num / den * 50 + 50

signal = ma(arsi, smooth, smoType2)

//-----------------------------------------------------------------------------}
//Cross detection
//-----------------------------------------------------------------------------{
//Median line crosses — kept for alerts only, no chart markers
crossDn = ta.crossunder(arsi, midLevel)
crossUp = ta.crossover(arsi, midLevel)

//Signal line crosses
sigCrossDn = ta.crossunder(arsi, signal)
sigCrossUp = ta.crossover(arsi, signal)

//Zone filter: where the signal-line cross is allowed to count
inZone = switch zoneFilter
    'Below median' => arsi < midLevel
    'Above median' => arsi > midLevel
    => true

sigCrossDnZone = sigCrossDn and inZone   // <-- RSI crosses signal line, below the 50 median
sigCrossUpZone = sigCrossUp and inZone

//-----------------------------------------------------------------------------}
//Plots
//-----------------------------------------------------------------------------{
plot_rsi = plot(arsi, 'Ultimate RSI'
  , arsi > obValue ? obCss
  : arsi < osValue ? osCss
  : autoCss ? chart.fg_color : arsiCss)

plot(signal, 'Signal Line', signalCss)

//Levels
plot_up  = plot(obValue, color = na, editable = false)
plot_avg = plot(midLevel, color = na, editable = false)
plot_dn  = plot(osValue, color = na, editable = false)

//OB-OS
fill(plot_rsi, plot_up, arsi > obValue ? obAreaCss : na)
fill(plot_dn, plot_rsi, arsi < osValue ? osAreaCss : na)

//Gradient
fill(plot_rsi, plot_avg, obValue, midLevel, obAreaCss, color.new(chart.bg_color, 100))
fill(plot_avg, plot_rsi, midLevel, osValue, color.new(chart.bg_color, 100), osAreaCss)

hline(obValue, 'Overbought')
hline(50, 'Midline')
hline(osValue, 'Oversold')

//Signal-line cross markers (zone filtered)
plotshape(showMarks and sigCrossDnZone ? arsi : na, 'Signal Cross Down (in zone)', shape.circle, location.absolute
  , color.new(#f23645, 0), size = size.tiny)

plotshape(showMarks and sigCrossUpZone ? arsi : na, 'Signal Cross Up (in zone)', shape.circle, location.absolute
  , color.new(#089981, 0), size = size.tiny)

//-----------------------------------------------------------------------------}
//Alerts
//-----------------------------------------------------------------------------{
freq = onBarClose ? alert.freq_once_per_bar_close : alert.freq_once_per_bar

//Signal line crossed inside the selected zone
if sigCrossDnZone
    alert('Ultimate RSI crossed BELOW its SIGNAL LINE under ' + str.tostring(midLevel) + ' on ' + syminfo.ticker
      + ' (' + timeframe.period + ')   RSI = ' + str.tostring(arsi, '#.##')
      + '   Signal = ' + str.tostring(signal, '#.##'), freq)

if sigCrossUpZone
    alert('Ultimate RSI crossed ABOVE its SIGNAL LINE under ' + str.tostring(midLevel) + ' on ' + syminfo.ticker
      + ' (' + timeframe.period + ')   RSI = ' + str.tostring(arsi, '#.##')
      + '   Signal = ' + str.tostring(signal, '#.##'), freq)

//Median line crossed
if crossDn
    alert('Ultimate RSI crossed BELOW ' + str.tostring(midLevel) + ' on ' + syminfo.ticker
      + ' (' + timeframe.period + ')   RSI = ' + str.tostring(arsi, '#.##'), freq)

if crossUp
    alert('Ultimate RSI crossed ABOVE ' + str.tostring(midLevel) + ' on ' + syminfo.ticker
      + ' (' + timeframe.period + ')   RSI = ' + str.tostring(arsi, '#.##'), freq)

//Named conditions for the alert dialog dropdown
alertcondition(sigCrossDnZone, 'RSI crosses BELOW signal line, under median',
     'Ultimate RSI crossed BELOW its signal line while under the median on {{ticker}} {{interval}}')

alertcondition(sigCrossUpZone, 'RSI crosses ABOVE signal line, under median',
     'Ultimate RSI crossed ABOVE its signal line while under the median on {{ticker}} {{interval}}')

alertcondition(crossDn, 'RSI crosses BELOW median line',
     'Ultimate RSI crossed BELOW the median line on {{ticker}} {{interval}}')

alertcondition(crossUp, 'RSI crosses ABOVE median line',
     'Ultimate RSI crossed ABOVE the median line on {{ticker}} {{interval}}')

//-----------------------------------------------------------------------------}
