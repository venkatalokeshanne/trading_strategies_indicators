//@version=6
strategy(title="3D EMA", shorttitle="Arco ·3D", overlay=true,default_qty_value = 1,
 default_qty_type = strategy.cash,initial_capital=200000,calc_on_every_tick = true)


capital = input.int(200000, " capital", step=1)


ema0 = ta.ema(close, 7)
emat = ta.ema(close, 24)
ema1 = ta.ema(close, 10)
ema2 = ta.ema(close, 20)
ema3 = ta.ema(close, 30)
ema4 = ta.ema(close, 40)
ema5 = ta.ema(close, 50)
ema6 = ta.ema(close, 60)
ema7 = ta.ema(close, 70)
ema8 = ta.ema(close, 80)
ema9 = ta.ema(close, 90)
ema21 = ta.ema(close, 15)
ema22 = ta.ema(close, 25)
ema23 = ta.ema(close, 35)
ema24 = ta.ema(close, 45)
ema25 = ta.ema(close, 55)
ema26 = ta.ema(close, 65)
ema27 = ta.ema(close, 75)
ema28 = ta.ema(close, 85)
ema29 = ta.ema(close, 95)

ema11 = ta.ema(open, 15)
ema12 = ta.ema(open, 25)
ema13 = ta.ema(open, 35)
ema14 = ta.ema(open, 46)
ema15 = ta.ema(open, 55)
ema16 = ta.ema(open, 65)
ema17 = ta.ema(open, 75)
ema18 = ta.ema(open, 85)
ema19 = ta.ema(open, 95)
ema211 = ta.ema(open, 10)
ema212 = ta.ema(open, 20)
ema213 = ta.ema(open, 30)
ema214 = ta.ema(open, 40)
ema215 = ta.ema(open, 50)
ema216 = ta.ema(open, 60)
ema217 = ta.ema(open, 70)
ema218 = ta.ema(open, 80)
ema219 = ta.ema(open, 90)



plot(ema1,  color=color.rgb(148, 231, 14),linestyle = plot.linestyle_dotted)
plot(ema2,  color=color.rgb(235, 231, 3),linestyle = plot.linestyle_dotted) 
plot(ema3,  color=color.rgb(231, 235, 3),linestyle = plot.linestyle_dotted) 
plot(ema4,  color=color.rgb(235, 181, 3),linestyle = plot.linestyle_dotted) 
plot(ema5,  color=color.rgb(236, 164, 8),linestyle = plot.linestyle_dotted)
plot(ema6,  color=color.rgb(236, 145, 8),linestyle = plot.linestyle_dotted)
plot(ema7,  color=color.rgb(241, 99, 4, 6),linestyle = plot.linestyle_dotted) 
plot(ema8,  color=color.rgb(241, 40, 4),linestyle = plot.linestyle_dotted) 
plot(ema9,  color=color.rgb(238, 17, 9),linestyle = plot.linestyle_dotted)  

plot(ema11,  color=color.rgb(148, 231, 14),linestyle = plot.linestyle_dotted)
plot(ema12,  color=color.rgb(235, 231, 3),linestyle = plot.linestyle_dotted) 
plot(ema13,  color=color.rgb(231, 235, 3),linestyle = plot.linestyle_dotted) 
plot(ema14,  color=color.rgb(235, 181, 3),linestyle = plot.linestyle_dotted) 
plot(ema15,  color=color.rgb(236, 164, 8),linestyle = plot.linestyle_dotted)
plot(ema16,  color=color.rgb(236, 145, 8),linestyle = plot.linestyle_dotted)
plot(ema17,  color=color.rgb(241, 99, 4, 6),linestyle = plot.linestyle_dotted) 
plot(ema18,  color=color.rgb(241, 40, 4),linestyle = plot.linestyle_dotted) 
plot(ema19,  color=color.rgb(238, 17, 9),linestyle = plot.linestyle_dotted) 
plot(ema21,  color=color.rgb(148, 231, 14),linestyle = plot.linestyle_dotted)
plot(ema22,  color=color.rgb(235, 231, 3),linestyle = plot.linestyle_dotted) 
