//@version=6
indicator("STT Full Scanner", shorttitle="STT Scan", overlay=true)

// ═══════════════════════════════════════════════════════════════
//  TABLE SETTINGS
// ═══════════════════════════════════════════════════════════════
tablePos  = input.string("Top Right", "Table Position", options=["Top Left","Top Right","Bottom Left","Bottom Right"])
showTable = input.bool(true, "Show Scanner Table")
tableFont = input.string("tiny", "Table Font Size", options=["tiny","small","normal","large","huge"])

getTableSize() =>
    switch tableFont
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        => size.huge
tblSize = getTableSize()

// ═══════════════════════════════════════════════════════════════
//  CURRENT TF MA ON/OFF
// ═══════════════════════════════════════════════════════════════
grpMA = "Current TF MA"
showSMA20  = input.bool(true, "SMA 20", group=grpMA)
showSMA30  = input.bool(true, "SMA 30", group=grpMA)
showSMA50  = input.bool(true, "SMA 50", group=grpMA)
showSMA60  = input.bool(true, "SMA 60", group=grpMA)
showSMA100 = input.bool(true, "SMA 100", group=grpMA)
showSMA200 = input.bool(true, "SMA 200", group=grpMA)
showSMA237 = input.bool(true, "SMA 237", group=grpMA)
showEMA20  = input.bool(true, "EMA 20", group=grpMA)
showEMA30  = input.bool(true, "EMA 30", group=grpMA)
showEMA50  = input.bool(true, "EMA 50", group=grpMA)
showEMA60  = input.bool(true, "EMA 60", group=grpMA)
showEMA100 = input.bool(true, "EMA 100", group=grpMA)
showEMA200 = input.bool(true, "EMA 200", group=grpMA)
showEMA237 = input.bool(true, "EMA 237", group=grpMA)

// ═══════════════════════════════════════════════════════════════
//  WEEKLY MA ON/OFF
// ═══════════════════════════════════════════════════════════════
grpW = "Weekly MA"
showWSMA30  = input.bool(true, "W SMA 30", group=grpW)
showWSMA40  = input.bool(true, "W SMA 40", group=grpW)
showWSMA200 = input.bool(true, "W SMA 200", group=grpW)
showWEMA30  = input.bool(true, "W EMA 30", group=grpW)
showWEMA40  = input.bool(true, "W EMA 40", group=grpW)
showWEMA200 = input.bool(true, "W EMA 200", group=grpW)

// ═══════════════════════════════════════════════════════════════
//  MONTHLY MA ON/OFF
// ═══════════════════════════════════════════════════════════════
grpM = "Monthly MA"
showMSMA21 = input.bool(true, "M SMA 21", group=grpM)
showMSMA55 = input.bool(true, "M SMA 55", group=grpM)
showMEMA21 = input.bool(true, "M EMA 21", group=grpM)
showMEMA55 = input.bool(true, "M EMA 55", group=grpM)

// ═══════════════════════════════════════════════════════════════
//  RSI + ADX ON/OFF
// ═══════════════════════════════════════════════════════════════
grpR = "RSI & ADX"
showRSI_D = input.bool(true, "RSI Daily", group=grpR)
showRSI_W = input.bool(true, "RSI Weekly", group=grpR)
showRSI_M = input.bool(true, "RSI Monthly", group=grpR)
showADX   = input.bool(true, "ADX Positive", group=grpR)
rsiLen    = input.int(14, "RSI Length", group=grpR)
adxLen    = input.int(14, "ADX Length", group=grpR)
adxLevel  = input.float(20, "ADX Min", group=grpR)

// ═══════════════════════════════════════════════════════════════
//  LEVELS + PIVOT ON/OFF
// ═══════════════════════════════════════════════════════════════
grpLvl = "Levels & Pivot"
showYearly  = input.bool(true, "Yearly", group=grpLvl)
showQuarter = input.bool(true, "Quarterly", group=grpLvl)
showMonthly = input.bool(true, "Monthly", group=grpLvl)
showWeekly  = input.bool(true, "Weekly", group=grpLvl)
showDaily   = input.bool(true, "Daily", group=grpLvl)
showPivot   = input.bool(true, "Pivot PP", group=grpLvl)
checkHigh   = input.bool(true, "Check High", group=grpLvl)
checkMid    = input.bool(true, "Check Mid", group=grpLvl)
checkClose  = input.bool(true, "Check Close", group=grpLvl)

// ═══════════════════════════════════════════════════════════════
//  CALCULATIONS
// ═══════════════════════════════════════════════════════════════
sma20  = ta.sma(close, 20)
sma30  = ta.sma(close, 30)
sma50  = ta.sma(close, 50)
sma60  = ta.sma(close, 60)
sma100 = ta.sma(close, 100)
sma200 = ta.sma(close, 200)
sma237 = ta.sma(close, 237)
ema20  = ta.ema(close, 20)
ema30  = ta.ema(close, 30)
ema50  = ta.ema(close, 50)
ema60  = ta.ema(close, 60)
ema100 = ta.ema(close, 100)
ema200 = ta.ema(close, 200)
ema237 = ta.ema(close, 237)

wSma30  = request.security(syminfo.tickerid, "W", ta.sma(close, 30))
wSma40  = request.security(syminfo.tickerid, "W", ta.sma(close, 40))
wSma200 = request.security(syminfo.tickerid, "W", ta.sma(close, 200))
wEma30  = request.security(syminfo.tickerid, "W", ta.ema(close, 30))
wEma40  = request.security(syminfo.tickerid, "W", ta.ema(close, 40))
wEma200 = request.security(syminfo.tickerid, "W", ta.ema(close, 200))

mSma21 = request.security(syminfo.tickerid, "M", ta.sma(close, 21))
mSma55 = request.security(syminfo.tickerid, "M", ta.sma(close, 55))
mEma21 = request.security(syminfo.tickerid, "M", ta.ema(close, 21))
mEma55 = request.security(syminfo.tickerid, "M", ta.ema(close, 55))

rsiD = ta.rsi(close, rsiLen)
rsiW = request.security(syminfo.tickerid, "W", ta.rsi(close, rsiLen))
rsiM = request.security(syminfo.tickerid, "M", ta.rsi(close, rsiLen))

[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
adxPos = adx > adxLevel and diPlus > diMinus

// Levels
getPrev(tf) =>
    [h, l, c] = request.security(syminfo.tickerid, tf, [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)
    mid = (h + l) / 2.0
    [h, mid, c]

[yH, yM, yC] = getPrev("12M")
[qH, qM, qC] = getPrev("3M")
[mH, mM, mC] = getPrev("M")
[wH, wM, wC] = getPrev("W")
[dH, dM, dC] = getPrev("D")

[ph, pl, pc] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)
pp = (ph + pl + pc) / 3.0

// Conditions
c_sma20  = close > sma20
c_sma30  = close > sma30
c_sma50  = close > sma50
c_sma60  = close > sma60
c_sma100 = close > sma100
c_sma200 = close > sma200
c_sma237 = close > sma237
c_ema20  = close > ema20
c_ema30  = close > ema30
c_ema50  = close > ema50
c_ema60  = close > ema60
c_ema100 = close > ema100
c_ema200 = close > ema200
c_ema237 = close > ema237
c_wSma30  = close > wSma30
c_wSma40  = close > wSma40
c_wSma200 = close > wSma200
c_wEma30  = close > wEma30
c_wEma40  = close > wEma40
c_wEma200 = close > wEma200
c_mSma21 = close > mSma21
c_mSma55 = close > mSma55
c_mEma21 = close > mEma21
c_mEma55 = close > mEma55
c_rsiD = rsiD > 50 and rsiD < 70
c_rsiW = rsiW > 50 and rsiW < 70
c_rsiM = rsiM > 50 and rsiM < 70

aboveYH = close > yH
aboveYM = close > yM
aboveYC = close > yC
aboveQH = close > qH
aboveQM = close > qM
aboveQC = close > qC
aboveMH = close > mH
aboveMM = close > mM
aboveMC = close > mC
aboveWH = close > wH
aboveWM = close > wM
aboveWC = close > wC
aboveDH = close > dH
aboveDM = close > dM
aboveDC = close > dC
abovePP = close > pp

green = #00E676
red   = #FF5252

// ═══════════════════════════════════════════════════════════════
//  TABLE
// ═══════════════════════════════════════════════════════════════
var table t = table.new(
     tablePos == "Top Left" ? position.top_left :
     tablePos == "Top Right" ? position.top_right :
     tablePos == "Bottom Left" ? position.bottom_left : position.bottom_right,
     4, 30, bgcolor=#1E1E1E, border_width=1)

if showTable and barstate.islast
    // Header
    table.cell(t, 0, 0, "MA", text_color=color.white, bgcolor=#2962FF, text_size=tblSize)
    table.cell(t, 1, 0, "✓", text_color=color.white, bgcolor=#2962FF, text_size=tblSize)
    table.cell(t, 2, 0, "MA", text_color=color.white, bgcolor=#2962FF, text_size=tblSize)
    table.cell(t, 3, 0, "✓", text_color=color.white, bgcolor=#2962FF, text_size=tblSize)

    r = 1

    // Current SMA / EMA
    if showSMA20
        table.cell(t, 0, r, "S20", text_color=color.white, text_size=tblSize)
        table.cell(t, 1, r, c_sma20 ? "✅" : "❌", text_color=c_sma20 ? green : red, text_size=tblSize)
    if showEMA20
        table.cell(t, 2, r, "E20", text_color=color.white, text_size=tblSize)
        table.cell(t, 3, r, c_ema20 ? "✅" : "❌", text_color=c_ema20 ? green : red, text_size=tblSize)
    r += 1

    if showSMA30
        table.cell(t, 0, r, "S30", text_color=color.white, text_size=tblSize)
        table.cell(t, 1, r, c_sma30 ? "✅" : "❌", text_color=c_sma30 ? green : red, text_size=tblSize)
    if showEMA30
        table.cell(t, 2, r, "E30", text_color=color.white, text_size=tblSize)
        table.cell(t, 3, r, c_ema30 ? "✅" : "❌", text_color=c_ema30 ? green : red, text_size=tblSize)
    r += 1

    if showSMA50
        table.cell(t, 0, r, "S50", text_color=color.white, text_size=tblSize)
        table.cell(t, 1, r, c_sma50 ? "✅" : "❌", text_color=c_sma50 ? green : red, text_size=tblSize)
    if showEMA50
        table.cell(t, 2, r, "E50", text_color=color.white, text_size=tblSize)
        table.cell(t, 3, r, c_ema50 ? "✅" : "❌", text_color=c_ema50 ? green : red, text_size=tblSize)
    r += 1

    if showSMA60
        table.cell(t, 0, r, "S60", text_color=color.white, text_size=tblSize)
        table.cell(t, 1, r, c_sma60 ? "✅" : "❌", text_color=c_sma60 ? green : red, text_size=tblSize)
    if showEMA60
        table.cell(t, 2, r, "E60", text_color=color.white, text_size=tblSize)
        table.cell(t, 3, r, c_ema60 ? "✅" : "❌", text_color=c_ema60 ? green : red, text_size=tblSize)
    r += 1

    if showSMA100
        table.cell(t, 0, r, "S100", text_color=color.white, text_size=tblSize)
        table.cell(t, 1, r, c_sma100 ? "✅" : "❌", text_color=c_sma100 ? green : red, text_size=tblSize)
    if showEMA100
        table.cell(t, 2, r, "E100", text_color=color.white, text_size=tblSize)
        table.cell(t, 3, r, c_ema100 ? "✅" : "❌", text_color=c_ema100 ? green : red, text_size=tblSize)
    r += 1

    if showSMA200
        table.cell(t, 0, r, "S200", text_color=color.white, text_size=tblSize)
        table.cell(t, 1, r, c_sma200 ? "✅" : "❌", text_color=c_sma200 ? green : red, text_size=tblSize)
    if showEMA200
        table.cell(t, 2, r, "E200", text_color=color.white, text_size=tblSize)
        table.cell(t, 3, r, c_ema200 ? "✅" : "❌", text_color=c_ema200 ? green : red, text_size=tblSize)
    r += 1

    if showSMA237
        table.cell(t, 0, r, "S237", text_color=color.white, text_size=tblSize)
        table.cell(t, 1, r, c_sma237 ? "✅" : "❌", text_color=c_sma237 ? green : red, text_size=tblSize)
    if showEMA237
        table.cell(t, 2, r, "E237", text_color=color.white, text_size=tblSize)
        table.cell(t, 3, r, c_ema237 ? "✅" : "❌", text_color=c_ema237 ? green : red, text_size=tblSize)
    r += 1

    // Weekly
    table.cell(t, 0, r, "W S30", text_color=color.aqua, text_size=tblSize)
    table.cell(t, 1, r, showWSMA30 ? (c_wSma30 ? "✅" : "❌") : "-", text_color=showWSMA30 ? (c_wSma30 ? green : red) : color.gray, text_size=tblSize)
    table.cell(t, 2, r, "W E30", text_color=color.aqua, text_size=tblSize)
    table.cell(t, 3, r, showWEMA30 ? (c_wEma30 ? "✅" : "❌") : "-", text_color=showWEMA30 ? (c_wEma30 ? green : red) : color.gray, text_size=tblSize)
    r += 1

    table.cell(t, 0, r, "W S40", text_color=color.aqua, text_size=tblSize)
    table.cell(t, 1, r, showWSMA40 ? (c_wSma40 ? "✅" : "❌") : "-", text_color=showWSMA40 ? (c_wSma40 ? green : red) : color.gray, text_size=tblSize)
    table.cell(t, 2, r, "W E40", text_color=color.aqua, text_size=tblSize)
    table.cell(t, 3, r, showWEMA40 ? (c_wEma40 ? "✅" : "❌") : "-", text_color=showWEMA40 ? (c_wEma40 ? green : red) : color.gray, text_size=tblSize)
    r += 1

    table.cell(t, 0, r, "W S200", text_color=color.aqua, text_size=tblSize)
    table.cell(t, 1, r, showWSMA200 ? (c_wSma200 ? "✅" : "❌") : "-", text_color=showWSMA200 ? (c_wSma200 ? green : red) : color.gray, text_size=tblSize)
    table.cell(t, 2, r, "W E200", text_color=color.aqua, text_size=tblSize)
    table.cell(t, 3, r, showWEMA200 ? (c_wEma200 ? "✅" : "❌") : "-", text_color=showWEMA200 ? (c_wEma200 ? green : red) : color.gray, text_size=tblSize)
    r += 1

    // Monthly
    table.cell(t, 0, r, "M S21", text_color=color.fuchsia, text_size=tblSize)
    table.cell(t, 1, r, showMSMA21 ? (c_mSma21 ? "✅" : "❌") : "-", text_color=showMSMA21 ? (c_mSma21 ? green : red) : color.gray, text_size=tblSize)
    table.cell(t, 2, r, "M E21", text_color=color.fuchsia, text_size=tblSize)
    table.cell(t, 3, r, showMEMA21 ? (c_mEma21 ? "✅" : "❌") : "-", text_color=showMEMA21 ? (c_mEma21 ? green : red) : color.gray, text_size=tblSize)
    r += 1

    table.cell(t, 0, r, "M S55", text_color=color.fuchsia, text_size=tblSize)
    table.cell(t, 1, r, showMSMA55 ? (c_mSma55 ? "✅" : "❌") : "-", text_color=showMSMA55 ? (c_mSma55 ? green : red) : color.gray, text_size=tblSize)
    table.cell(t, 2, r, "M E55", text_color=color.fuchsia, text_size=tblSize)
    table.cell(t, 3, r, showMEMA55 ? (c_mEma55 ? "✅" : "❌") : "-", text_color=showMEMA55 ? (c_mEma55 ? green : red) : color.gray, text_size=tblSize)
    r += 1

    // RSI + ADX
    table.cell(t, 0, r, "RSI D", text_color=color.lime, text_size=tblSize)
    table.cell(t, 1, r, showRSI_D ? (c_rsiD ? "✅" : "❌") : "-", text_color=showRSI_D ? (c_rsiD ? green : red) : color.gray, text_size=tblSize)
    table.cell(t, 2, r, "RSI W", text_color=color.lime, text_size=tblSize)
    table.cell(t, 3, r, showRSI_W ? (c_rsiW ? "✅" : "❌") : "-", text_color=showRSI_W ? (c_rsiW ? green : red) : color.gray, text_size=tblSize)
    r += 1

    table.cell(t, 0, r, "RSI M", text_color=color.lime, text_size=tblSize)
    table.cell(t, 1, r, showRSI_M ? (c_rsiM ? "✅" : "❌") : "-", text_color=showRSI_M ? (c_rsiM ? green : red) : color.gray, text_size=tblSize)
    table.cell(t, 2, r, "ADX+", text_color=color.lime, text_size=tblSize)
    table.cell(t, 3, r, showADX ? (adxPos ? "✅" : "❌") : "-", text_color=showADX ? (adxPos ? green : red) : color.gray, text_size=tblSize)
    r += 1

    // ── LEVELS ──
    if showYearly or showQuarter or showMonthly or showWeekly or showDaily or showPivot
        table.cell(t, 0, r, "──LEVELS──", text_color=color.yellow, text_size=tblSize)
        table.cell(t, 1, r, "", text_size=tblSize)
        table.cell(t, 2, r, "", text_size=tblSize)
        table.cell(t, 3, r, "", text_size=tblSize)
        r += 1

    if showYearly
        table.cell(t, 0, r, "Y High", text_color=color.white, text_size=tblSize)
        table.cell(t, 1, r, checkHigh ? (aboveYH ? "✅" : "❌") : "-", text_color=checkHigh ? (aboveYH ? green : red) : color.gray, text_size=tblSize)
        table.cell(t, 2, r, "Y Mid", text_color=color.white, text_size=tblSize)
        table.cell(t, 3, r, checkMid ? (aboveYM ? "✅" : "❌") : "-", text_color=checkMid ? (aboveYM ? green : red) : color.gray, text_size=tblSize)
        r += 1
        table.cell(t, 0, r, "Y Close", text_color=color.white, text_size=tblSize)
        table.cell(t, 1, r, checkClose ? (aboveYC ? "✅" : "❌") : "-", text_color=checkClose ? (aboveYC ? green : red) : color.gray, text_size=tblSize)
        table.cell(t, 2, r, "", text_size=tblSize)
        table.cell(t, 3, r, "", text_size=tblSize)
        r += 1

    if showQuarter
        table.cell(t, 0, r, "Q High", text_color=color.white, text_size=tblSize)
        table.cell(t, 1, r, checkHigh ? (aboveQH ? "✅" : "❌") : "-", text_color=checkHigh ? (aboveQH ? green : red) : color.gray, text_size=tblSize)
        table.cell(t, 2, r, "Q Mid", text_color=color.white, text_size=tblSize)
        table.cell(t, 3, r, checkMid ? (aboveQM ? "✅" : "❌") : "-", text_color=checkMid ? (aboveQM ? green : red) : color.gray, text_size=tblSize)
        r += 1
        table.cell(t, 0, r, "Q Close", text_color=color.white, text_size=tblSize)
        table.cell(t, 1, r, checkClose ? (aboveQC ? "✅" : "❌") : "-", text_color=checkClose ? (aboveQC ? green : red) : color.gray, text_size=tblSize)
        table.cell(t, 2, r, "", text_size=tblSize)
        table.cell(t, 3, r, "", text_size=tblSize)
        r += 1

    if showMonthly
        table.cell(t, 0, r, "M High", text_color=color.white, text_size=tblSize)
        table.cell(t, 1, r, checkHigh ? (aboveMH ? "✅" : "❌") : "-", text_color=checkHigh ? (aboveMH ? green : red) : color.gray, text_size=tblSize)
        table.cell(t, 2, r, "M Mid", text_color=color.white, text_size=tblSize)
        table.cell(t, 3, r, checkMid ? (aboveMM ? "✅" : "❌") : "-", text_color=checkMid ? (aboveMM ? green : red) : color.gray, text_size=tblSize)
        r += 1
        table.cell(t, 0, r, "M Close", text_color=color.white, text_size=tblSize)
        table.cell(t, 1, r, checkClose ? (aboveMC ? "✅" : "❌") : "-", text_color=checkClose ? (aboveMC ? green : red) : color.gray, text_size=tblSize)
        table.cell(t, 2, r, "", text_size=tblSize)
        table.cell(t, 3, r, "", text_size=tblSize)
        r += 1

    if showWeekly
        table.cell(t, 0, r, "W High", text_color=color.white, text_size=tblSize)
        table.cell(t, 1, r, checkHigh ? (aboveWH ? "✅" : "❌") : "-", text_color=checkHigh ? (aboveWH ? green : red) : color.gray, text_size=tblSize)
        table.cell(t, 2, r, "W Mid", text_color=color.white, text_size=tblSize)
        table.cell(t, 3, r, checkMid ? (aboveWM ? "✅" : "❌") : "-", text_color=checkMid ? (aboveWM ? green : red) : color.gray, text_size=tblSize)
        r += 1
        table.cell(t, 0, r, "W Close", text_color=color.white, text_size=tblSize)
        table.cell(t, 1, r, checkClose ? (aboveWC ? "✅" : "❌") : "-", text_color=checkClose ? (aboveWC ? green : red) : color.gray, text_size=tblSize)
        table.cell(t, 2, r, "", text_size=tblSize)
        table.cell(t, 3, r, "", text_size=tblSize)
        r += 1

    if showDaily
        table.cell(t, 0, r, "D High", text_color=color.white, text_size=tblSize)
        table.cell(t, 1, r, checkHigh ? (aboveDH ? "✅" : "❌") : "-", text_color=checkHigh ? (aboveDH ? green : red) : color.gray, text_size=tblSize)
        table.cell(t, 2, r, "D Mid", text_color=color.white, text_size=tblSize)
        table.cell(t, 3, r, checkMid ? (aboveDM ? "✅" : "❌") : "-", text_color=checkMid ? (aboveDM ? green : red) : color.gray, text_size=tblSize)
        r += 1
        table.cell(t, 0, r, "D Close", text_color=color.white, text_size=tblSize)
        table.cell(t, 1, r, checkClose ? (aboveDC ? "✅" : "❌") : "-", text_color=checkClose ? (aboveDC ? green : red) : color.gray, text_size=tblSize)
        table.cell(t, 2, r, "", text_size=tblSize)
        table.cell(t, 3, r, "", text_size=tblSize)
        r += 1

    if showPivot
        table.cell(t, 0, r, "Pivot PP", text_color=color.orange, text_size=tblSize)
        table.cell(t, 1, r, abovePP ? "✅" : "❌", text_color=abovePP ? green : red, text_size=tblSize)
        table.cell(t, 2, r, "", text_size=tblSize)
        table.cell(t, 3, r, "", text_size=tblSize)