//@version=6
indicator("Alpha+ Elway", shorttitle="Alpha+ Elway", overlay=true)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Settings
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

groupEma     = "EMA Settings"
source       = input.source(close, "Source", group=groupEma, display=display.data_window)
fastLength   = input.int(8, "Fast EMA", minval=1, group=groupEma, display=display.data_window)
slowLength   = input.int(21, "Slow EMA", minval=1, group=groupEma, display=display.data_window)

groupStyle    = "Ribbon Style"
bullColor     = input.color(color.rgb(32, 214, 202), "Bullish Color", group=groupStyle)
bearColor     = input.color(color.rgb(255, 105, 85), "Bearish Color", group=groupStyle)
slowColor     = input.color(color.rgb(244, 177, 92), "Slow EMA Color", group=groupStyle)
ribbonOpacity = input.int(82, "Ribbon Transparency", minval=0, maxval=100, group=groupStyle, display=display.data_window)
showGlow      = input.bool(true, "EMA Glow", group=groupStyle)
showBgTint    = input.bool(false, "Background Tint", group=groupStyle)
colorBars     = input.bool(false, "Color Candles", group=groupStyle)

groupSignals = "Signals"
showSignals  = input.bool(true, "Show Crossover Signals", group=groupSignals)
confirmClose = input.bool(true, "Confirm Signals at Bar Close", group=groupSignals)

groupDash     = "Dashboard"
showDashboard = input.bool(true, "Show Trend Dashboard", group=groupDash)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Calculations
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

fastEma = ta.ema(source, fastLength)
slowEma = ta.ema(source, slowLength)

bullish   = fastEma >= slowEma
trendColor = bullish ? bullColor : bearColor

// Internal ribbon layers create a soft depth effect.
ribbonDifference = fastEma - slowEma
ribbonInnerFast  = slowEma + ribbonDifference * 0.67
ribbonInnerSlow  = slowEma + ribbonDifference * 0.33

bullCross = ta.crossover(fastEma, slowEma)
bearCross = ta.crossunder(fastEma, slowEma)

signalAllowed = not confirmClose or barstate.isconfirmed
longSignal    = bullCross and signalAllowed
shortSignal   = bearCross and signalAllowed

spreadPercent = slowEma != 0 ? math.abs(fastEma - slowEma) / math.abs(slowEma) * 100 : 0.0

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// EMA Glow
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

plot(
     showGlow ? fastEma : na,
     title="Fast EMA Outer Glow",
     color=color.new(trendColor, 88),
     linewidth=4,
     display=display.all - display.price_scale - display.status_line
)

plot(
     showGlow ? slowEma : na,
     title="Slow EMA Outer Glow",
     color=color.new(slowColor, 90),
     linewidth=4,
     display=display.all - display.price_scale - display.status_line
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Main EMA Lines
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

fastPlot = plot(
     fastEma,
     title="Fast EMA",
     color=trendColor,
     linewidth=2,
     display=display.all - display.price_scale - display.status_line
)

slowPlot = plot(
     slowEma,
     title="Slow EMA",
     color=slowColor,
     linewidth=2,
     display=display.all - display.price_scale - display.status_line
)

// Invisible internal plots used for layered fills.
innerFastPlot = plot(
     ribbonInnerFast,
     title="Ribbon Inner Fast",
     color=color.new(trendColor, 100),
     display=display.all - display.price_scale - display.status_line
)

innerSlowPlot = plot(
     ribbonInnerSlow,
     title="Ribbon Inner Slow",
     color=color.new(trendColor, 100),
     display=display.all - display.price_scale - display.status_line
)

// Layered ribbon.
fill(
     fastPlot,
     innerFastPlot,
     color=color.new(trendColor, math.min(ribbonOpacity + 4, 100)),
     title="Ribbon Outer Fast"
)

fill(
     innerFastPlot,
     innerSlowPlot,
     color=color.new(trendColor, ribbonOpacity),
     title="Ribbon Center"
)

fill(
     innerSlowPlot,
     slowPlot,
     color=color.new(trendColor, math.min(ribbonOpacity + 4, 100)),
     title="Ribbon Outer Slow"
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Chart Styling
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bgcolor(
     showBgTint
         ? color.new(trendColor, 96)
         : na,
     title="Trend Background"
)

barcolor(
     colorBars
         ? color.new(trendColor, 25)
         : na,
     title="Trend Candle Color"
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Crossover Signals
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

plotshape(
     showSignals and longSignal,
     title="Bullish Crossover",
     style=shape.labelup,
     location=location.belowbar,
     color=bullColor,
     text="BUY",
     textcolor=color.white,
     size=size.tiny
)

plotshape(
     showSignals and shortSignal,
     title="Bearish Crossover",
     style=shape.labeldown,
     location=location.abovebar,
     color=bearColor,
     text="SELL",
     textcolor=color.white,
     size=size.tiny
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Trend Dashboard
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var table dashboard = table.new(
     position.top_right,
     2,
     3,
     border_width=1,
     border_color=color.new(color.white, 88),
     frame_color=color.new(color.black, 70),
     frame_width=1
)

if barstate.islast
    if showDashboard
        dashboardBg = color.new(color.rgb(18, 23, 31), 12)

        table.cell(
             dashboard, 0, 0, "EMA RIBBON",
             bgcolor=trendColor,
             text_color=color.white,
             text_size=size.small
        )

        table.cell(
             dashboard, 1, 0, bullish ? "BULLISH" : "BEARISH",
             bgcolor=trendColor,
             text_color=color.white,
             text_size=size.small
        )

        table.cell(
             dashboard, 0, 1, "Fast EMA",
             bgcolor=dashboardBg,
             text_color=color.new(color.white, 25)
        )

        table.cell(
             dashboard, 1, 1, str.tostring(fastEma, format.mintick),
             bgcolor=dashboardBg,
             text_color=trendColor
        )

        table.cell(
             dashboard, 0, 2, "Ribbon Spread",
             bgcolor=dashboardBg,
             text_color=color.new(color.white, 25)
        )

        table.cell(
             dashboard, 1, 2, str.tostring(spreadPercent, "#.##") + "%",
             bgcolor=dashboardBg,
             text_color=slowColor
        )
    else
        table.clear(dashboard, 0, 0, 1, 2)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Alerts
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

alertcondition(
     longSignal,
     title="8 EMA Crossed Above 21 EMA",
     message="Bullish 8/21 EMA crossover on {{ticker}} at {{close}}"
)

alertcondition(
     shortSignal,
     title="8 EMA Crossed Below 21 EMA",
     message="Bearish 8/21 EMA crossover on {{ticker}} at {{close}}"
)