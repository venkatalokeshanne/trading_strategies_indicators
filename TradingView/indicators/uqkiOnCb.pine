//@version=6
indicator("Price Action Intraday Lite", shorttitle="PA Lite", overlay=true, max_labels_count=500)

// PRICE ACTION SETTINGS
groupSignal = "1. Price Action"

mode = input.string(
     "Balanced",
     "Signal mode",
     options=["Conservative", "Balanced", "Aggressive"],
     group=groupSignal)

structureLen = input.int(
     5,
     "Structure length",
     minval=2,
     maxval=30,
     group=groupSignal)

cooldownBars = input.int(
     8,
     "Bars between signals",
     minval=0,
     maxval=100,
     group=groupSignal)

confirmClose = input.bool(
     true,
     "Confirm at candle close",
     group=groupSignal)

// DIRECTION FILTER
groupBias = "2. Direction filter"

useAutoBias = input.bool(
     true,
     "Automatic bias timeframe",
     group=groupBias)

manualBiasTf = input.timeframe(
     "60",
     "Manual bias timeframe",
     group=groupBias)

useBias = input.bool(
     true,
     "Use direction filter",
     group=groupBias)

emaFastLen = input.int(
     20,
     "Fast EMA",
     minval=2,
     group=groupBias)

emaSlowLen = input.int(
     50,
     "Slow EMA",
     minval=5,
     group=groupBias)

// M1-M5 uses H1.
// M15 uses H4.
// M30-H1 uses H4.
// H4 and higher use Daily.
autoBiasTf = timeframe.isminutes and timeframe.multiplier <= 5 ? "60" : timeframe.isminutes and timeframe.multiplier <= 15 ? "240" : timeframe.isminutes and timeframe.multiplier <= 60 ? "240" : "D"

biasTf = useAutoBias ? autoBiasTf : manualBiasTf

// SESSIONS
groupSession = "3. Sessions"

useSessions = input.bool(
     true,
     "Use Asia London and New York",
     group=groupSession)

sessionZone = input.string(
     "Europe/Rome",
     "Timezone",
     group=groupSession)

asiaSession = input.session(
     "0100-0800",
     "Asia",
     group=groupSession)

londonSession = input.session(
     "0800-1200",
     "London",
     group=groupSession)

newYorkSession = input.session(
     "1400-1800",
     "New York",
     group=groupSession)

// ENTRY AND TARGETS
groupRisk = "4. Entry and targets"

atrLen = input.int(
     14,
     "ATR length",
     minval=2,
     group=groupRisk)

slAtrBuffer = input.float(
     0.20,
     "Stop ATR buffer",
     minval=0.0,
     step=0.05,
     group=groupRisk)

tp1R = input.float(
     1.0,
     "TP1 R",
     minval=0.25,
     step=0.25,
     group=groupRisk)

tp2R = input.float(
     2.0,
     "TP2 R",
     minval=0.50,
     step=0.25,
     group=groupRisk)

tp3R = input.float(
     3.0,
     "TP3 R",
     minval=0.75,
     step=0.25,
     group=groupRisk)

// HIGHER TIMEFRAME DIRECTION
htfFast = request.security(
     syminfo.tickerid,
     biasTf,
     ta.ema(close, emaFastLen)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

htfSlow = request.security(
     syminfo.tickerid,
     biasTf,
     ta.ema(close, emaSlowLen)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

htfClose = request.security(
     syminfo.tickerid,
     biasTf,
     close[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

bullBias = htfFast > htfSlow and htfClose >= htfFast
bearBias = htfFast < htfSlow and htfClose <= htfFast

// SESSION CONTROL
inAsia = not na(
     time(
         timeframe.period,
         asiaSession,
         sessionZone))

inLondon = not na(
     time(
         timeframe.period,
         londonSession,
         sessionZone))

inNewYork = not na(
     time(
         timeframe.period,
         newYorkSession,
         sessionZone))

sessionOk = not useSessions or inAsia or inLondon or inNewYork or mode == "Aggressive"

// SESSION COLORS
bgcolor(
     useSessions and inAsia
     ? color.new(color.purple, 94)
     : na,
     title="Asia")

bgcolor(
     useSessions and inLondon
     ? color.new(color.blue, 94)
     : na,
     title="London")

bgcolor(
     useSessions and inNewYork
     ? color.new(color.green, 94)
     : na,
     title="New York")

// ATR AND CANDLE COMPONENTS
atr = ta.atr(atrLen)

body = math.abs(close - open)

upperWick = high - math.max(open, close)

lowerWick = math.min(open, close) - low

// ENGULFING PATTERNS
bullEngulfing = close > open and close[1] < open[1] and open <= close[1] and close >= open[1]

bearEngulfing = close < open and close[1] > open[1] and open >= close[1] and close <= open[1]

// PIN BAR PATTERNS
bullPinBar = close > open and lowerWick >= body * 2.0 and upperWick <= body

bearPinBar = close < open and upperWick >= body * 2.0 and lowerWick <= body

// MARKET STRUCTURE
previousHigh = ta.highest(
     high[1],
     structureLen)

previousLow = ta.lowest(
     low[1],
     structureLen)

// STRUCTURE BREAKOUT
bullBreakout = close > previousHigh and close > open

bearBreakout = close < previousLow and close < open

// LIQUIDITY REJECTION
bullRejection = low < previousLow and close > previousLow and close > open

bearRejection = high > previousHigh and close < previousHigh and close < open

// SIGNAL MODES
// Conservative requires Engulfing and Breakout.
// Balanced requires a candle pattern plus Breakout or Rejection.
// Aggressive accepts Engulfing, Pin Bar or Breakout.
bullPattern = mode == "Conservative" ? bullEngulfing and bullBreakout : mode == "Balanced" ? (bullEngulfing or bullPinBar) and (bullBreakout or bullRejection) : bullEngulfing or bullPinBar or bullBreakout

bearPattern = mode == "Conservative" ? bearEngulfing and bearBreakout : mode == "Balanced" ? (bearEngulfing or bearPinBar) and (bearBreakout or bearRejection) : bearEngulfing or bearPinBar or bearBreakout

// SIGNAL CONFIRMATION
barOk = not confirmClose or barstate.isconfirmed

var int lastSignalBar = na

cooldownOk = na(lastSignalBar) or bar_index - lastSignalBar > cooldownBars

buySignal = bullPattern and (not useBias or bullBias) and sessionOk and barOk and cooldownOk

sellSignal = bearPattern and (not useBias or bearBias) and sessionOk and barOk and cooldownOk

// ENTRY, STOP LOSS AND TARGETS
var float entryPrice = na
var float stopPrice = na

var float tp1Price = na
var float tp2Price = na
var float tp3Price = na

var int direction = 0

// BUY LEVELS
if buySignal
    entryPrice := close

    stopPrice := ta.lowest(
         low,
         structureLen + 1) - atr * slAtrBuffer

    buyRisk = math.max(
         entryPrice - stopPrice,
         syminfo.mintick)

    tp1Price := entryPrice + buyRisk * tp1R
    tp2Price := entryPrice + buyRisk * tp2R
    tp3Price := entryPrice + buyRisk * tp3R

    direction := 1
    lastSignalBar := bar_index

// SELL LEVELS
if sellSignal
    entryPrice := close

    stopPrice := ta.highest(
         high,
         structureLen + 1) + atr * slAtrBuffer

    sellRisk = math.max(
         stopPrice - entryPrice,
         syminfo.mintick)

    tp1Price := entryPrice - sellRisk * tp1R
    tp2Price := entryPrice - sellRisk * tp2R
    tp3Price := entryPrice - sellRisk * tp3R

    direction := -1
    lastSignalBar := bar_index

// BUY AND SELL LABELS
plotshape(
     buySignal,
     title="Price Action BUY",
     text="BUY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.lime,
     textcolor=color.black,
     size=size.small)

plotshape(
     sellSignal,
     title="Price Action SELL",
     text="SELL",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     textcolor=color.white,
     size=size.small)

// ALERTS
alertcondition(
     buySignal,
     "Price Action BUY",
     "Price Action BUY {{ticker}} {{interval}} at {{close}}")

alertcondition(
     sellSignal,
     "Price Action SELL",
     "Price Action SELL {{ticker}} {{interval}} at {{close}}")

// PRICE FORMAT
priceText(value) =>
    na(value) ? "-" : str.tostring(value, format.mintick)

// DIRECTION
directionText = bullBias ? "BULLISH" : bearBias ? "BEARISH" : "NEUTRAL"

// LAST PATTERN
patternText = buySignal ? (bullEngulfing ? "ENGULFING" : bullPinBar ? "PIN BAR" : "BREAKOUT") : sellSignal ? (bearEngulfing ? "ENGULFING" : bearPinBar ? "PIN BAR" : "BREAKOUT") : "WAIT"

// DASHBOARD
var table dashboard = table.new(
     position.top_right,
     2,
     13,
     border_width=1)

if barstate.islast
    table.cell(
         dashboard,
         0,
         0,
         "PRICE ACTION",
         bgcolor=color.black,
         text_color=color.white)

    table.cell(
         dashboard,
         1,
         0,
         "LITE",
         bgcolor=color.black,
         text_color=color.yellow)

    table.cell(dashboard, 0, 1, "Chart TF")
    table.cell(dashboard, 1, 1, timeframe.period)

    table.cell(dashboard, 0, 2, "Bias TF")
    table.cell(dashboard, 1, 2, biasTf)

    table.cell(dashboard, 0, 3, "Mode")
    table.cell(dashboard, 1, 3, mode)

    table.cell(dashboard, 0, 4, "Session")

    table.cell(
         dashboard,
         1,
         4,
         inAsia ? "ASIA" : inLondon ? "LONDON" : inNewYork ? "NEW YORK" : "OFF")

    table.cell(dashboard, 0, 5, "Direction")

    table.cell(
         dashboard,
         1,
         5,
         directionText,
         text_color=directionText == "BULLISH" ? color.lime : directionText == "BEARISH" ? color.red : color.orange)

    table.cell(dashboard, 0, 6, "Pattern")
    table.cell(dashboard, 1, 6, patternText)

    table.cell(dashboard, 0, 7, "Signal")

    table.cell(
         dashboard,
         1,
         7,
         direction == 1 ? "BUY" : direction == -1 ? "SELL" : "WAIT",
         text_color=direction == 1 ? color.lime : direction == -1 ? color.red : color.orange)

    table.cell(
         dashboard,
         0,
         8,
         "ENTRY",
         text_color=color.yellow)

    table.cell(
         dashboard,
         1,
         8,
         priceText(entryPrice),
         text_color=color.yellow)

    table.cell(
         dashboard,
         0,
         9,
         "STOP LOSS",
         text_color=color.red)

    table.cell(
         dashboard,
         1,
         9,
         priceText(stopPrice),
         text_color=color.red)

    table.cell(
         dashboard,
         0,
         10,
         "TP1",
         text_color=color.aqua)

    table.cell(
         dashboard,
         1,
         10,
         priceText(tp1Price),
         text_color=color.aqua)

    table.cell(
         dashboard,
         0,
         11,
         "TP2",
         text_color=color.lime)

    table.cell(
         dashboard,
         1,
         11,
         priceText(tp2Price),
         text_color=color.lime)

    table.cell(
         dashboard,
         0,
         12,
         "TP3",
         text_color=color.fuchsia)

    table.cell(
         dashboard,
         1,
         12,
         priceText(tp3Price),
         text_color=color.fuchsia)