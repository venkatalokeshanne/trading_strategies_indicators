//@version=5
strategy("ATR Exhaustion & Volume Spike Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.cash, currency=currency.USD)

// --- Inputs ---
// Pivot settings
pivot_len_l = input.int(5, "Pivot Left Shoulder", minval=1)
pivot_len_r = input.int(5, "Pivot Right Shoulder", minval=1)
level_diff_per = input.float(0.5, "Level Proximity (%)", step=0.1) / 100

// ATR settings
atr_length = input.int(14, "ATR Length")
atr_multiplier = input.float(2.0, "ATR Exhaustion Multiplier", step=0.1)

// Volume settings
vol_sma_len = input.int(20, "Volume SMA Length")
vol_multiplier = input.float(1.5, "Volume Spike Multiplier", step=0.1)

// Risk Management
risk_per_trade = input.float(0.5, "Risk per Trade (%)", step=0.1) / 100
rr_ratio = input.float(2.0, "Risk:Reward Ratio", step=0.1)

// --- Calculations ---
// 1. Pivot Levels
ph = ta.pivothigh(pivot_len_l, pivot_len_r)
pl = ta.pivotlow(pivot_len_l, pivot_len_r)

var float last_ph = na
var float last_pl = na

if not na(ph)
    last_ph := ph
if not na(pl)
    last_pl := pl

// 2. ATR Exhaustion
atr = ta.atr(atr_length)
// Distance from last pivots to current price
dist_from_high = last_ph - low
dist_from_low = close - last_pl

is_exhausted_long = dist_from_high > (atr * atr_multiplier)
is_exhausted_short = dist_from_low > (atr * atr_multiplier)

// 3. Volume Spike
vol_sma = ta.sma(volume, vol_sma_len)
is_vol_spike = volume > vol_sma * vol_multiplier

// 4. Level Proximity
near_pl = low <= last_pl * (1 + level_diff_per) and low >= last_pl * (1 - level_diff_per)
near_ph = high >= last_ph * (1 - level_diff_per) and high <= last_ph * (1 + level_diff_per)

// --- Entry Conditions ---
// Price Action Trigger
bullish_trigger = close > open or close > high[1]
bearish_trigger = close < open or close < low[1]

long_condition = near_pl and is_exhausted_long and is_vol_spike and bullish_trigger
short_condition = near_ph and is_exhausted_short and is_vol_spike and bearish_trigger

// --- Execution & Risk Management ---
if (long_condition and strategy.position_size == 0)
    float sl = last_pl < low ? last_pl : low // Stop Loss at Pivot Low or current Low
    float risk_points = close - sl
    if risk_points > 0
        float tp = close + (risk_points * rr_ratio)
        // Position Sizing: Risking 0.5% of Equity
        float amount_to_risk = strategy.equity * risk_per_trade
        float qty = amount_to_risk / risk_points
        strategy.entry("Long", strategy.long, qty=qty)
        strategy.exit("Exit Long", "Long", stop=sl, limit=tp)

if (short_condition and strategy.position_size == 0)
    float sl = last_ph > high ? last_ph : high // Stop Loss at Pivot High or current High
    float risk_points = sl - close
    if risk_points > 0
        float tp = close - (risk_points * rr_ratio)
        // Position Sizing: Risking 0.5% of Equity
        float amount_to_risk = strategy.equity * risk_per_trade
        float qty = amount_to_risk / risk_points
        strategy.entry("Short", strategy.short, qty=qty)
        strategy.exit("Exit Short", "Short", stop=sl, limit=tp)

// --- Visuals ---
plot(last_ph, "Resistance Level", color=color.red, style=plot.style_linebr)
plot(last_pl, "Support Level", color=color.green, style=plot.style_linebr)

plotshape(long_condition, "Long Signal", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(short_condition, "Short Signal", shape.triangledown, location.abovebar, color.red, size=size.small)
