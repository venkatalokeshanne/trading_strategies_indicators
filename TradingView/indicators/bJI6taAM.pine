    else if code == 11
        s := "ADAM & EVE DİP"
    else if code == 12
        s := "EVE & ADAM DİP"
    else if code == 13
        s := "EVE & EVE DİP"
    else if code == 20
        s := "ADAM & ADAM TEPE"
    else if code == 21
