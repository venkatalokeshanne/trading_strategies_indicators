//@version=6
indicator("MA9 vs ma26 Fill", overlay=true)

ma9 = ta.sma(close, 9)
ma26 = ta.sma(close, 26)

p1 = plot(ma9, color=color.blue, linewidth=2, title="MA9")
p2 = plot(ma26, color=color.black, linewidth=2, title="MA26")

fillColor = ma9 > ma26 ? color.new(color.green, 80) : color.new(color.red, 80)
fill(p1, p2, color=fillColor)// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
