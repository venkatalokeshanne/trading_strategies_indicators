//@version=5
strategy("Sensex 9:45 Break-Even @ 200pts", overlay=true, initial_capital=100000)

// --- Inputs ---
increment = input.int(500, "Round Number Increment", minval=100)
sl_points = input.int(100, "Initial Stop Loss Points")
be_trigger = input.int(200, "Move to BE Trigger Points") // Changed to 200
session_start_hour = input.int(9, "Start Hour")
session_start_min = input.int(45, "Start Minute")

// --- Variables ---
var float upper_level = na
var float lower_level = na
var float tp_upper = na
var float tp_lower = na
var float active_sl = na
var bool trail_activated = false

is_start_time = hour == session_start_hour and minute == session_start_min
can_trade = time(timeframe.period, "0945-1515") // Stop new trades after 3:15 PM

// --- Level Calculation at 9:45 ---
if is_start_time
    current_price = open
    lower_level := math.floor(current_price / increment) * increment
    upper_level := math.ceil(current_price / increment) * increment
    tp_upper := upper_level + increment
    tp_lower := lower_level - increment
    trail_activated := false 

// --- Strategy Conditions ---
// Crossunder: close drops from above to below the level (as per your request)
longCondition = ta.crossunder(close, upper_level) and can_trade and strategy.position_size == 0
shortCondition = ta.crossunder(close, lower_level) and can_trade and strategy.position_size == 0

// --- Entry ---
if (longCondition)
    strategy.entry("Long", strategy.long)
    active_sl := close - sl_points
    trail_activated := false

if (shortCondition)
    strategy.entry("Short", strategy.short)
    active_sl := close + sl_points
    trail_activated := false

// --- Break-Even Logic (Fixed at 200 points) ---
if strategy.position_size > 0 
    // Long: If high reaches Entry + 200, move SL to Entry
    if not trail_activated and high >= strategy.position_avg_price + be_trigger
        active_sl := strategy.position_avg_price 
        trail_activated := true

if strategy.position_size < 0 
    // Short: If low reaches Entry - 200, move SL to Entry
    if not trail_activated and low <= strategy.position_avg_price - be_trigger
        active_sl := strategy.position_avg_price 
        trail_activated := true

// --- Execution of Exits ---
if strategy.position_size != 0
    strategy.exit("Exit", qty_percent=100, limit=(strategy.position_size > 0 ? tp_upper : tp_lower), stop=active_sl)

// --- Auto-Exit at End of Day ---
if time(timeframe.period, "1525-1530")
    strategy.close_all("EOD Square-off")

// --- Plotting ---
plot(upper_level, "Entry High", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)
plot(lower_level, "Entry Low", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)
// Visual target lines
plot(tp_upper, "Target High", color=color.new(color.blue, 60), style=plot.style_linebr)
plot(tp_lower, "Target Low", color=color.new(color.orange, 60), style=plot.style_linebr)
// SL indicator
plot(strategy.position_size != 0 ? active_sl : na, "Stop Loss", color=color.red, style=plot.style_cross, linewidth=3)