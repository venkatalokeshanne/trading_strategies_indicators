//@version=6
strategy("PathOverDest (By Vahid.Jz) Second", overlay=true, process_orders_on_close=true, initial_capital=10000, currency=currency.USD, default_qty_type=strategy.cash, max_bars_back=500, pyramiding=100000, margin_long=0, margin_short=0)

// === تنظیمات عمومی ===
groupGeneral = "تنظیمات عمومی"
calculationBars = input.int(500, "بازه محاسباتی کندل (برای ریست استپ‌ها)", minval=1, maxval=5000, step=1, group=groupGeneral)

// === مدیریت سرمایه ===
groupRM = "مدیریت سرمایه"
pip_size = input.float(0.1, "اندازه پیپ", step=0.01, group=groupRM, inline="r1")
position_cash = input.float(10, "مبلغ پایه هر پوزیشن (اگر ریسک درصدی استفاده نشه)", group=groupRM, inline="r1")
risk_percent = input.float(1.0, "ریسک درصدی از سرمایه (برای اندازه پوزیشن دینامیک)", minval=0.1, maxval=10, group=groupRM)

num_positions = input.int(1, "تعداد پوزیشن‌ها", minval=1, group=groupRM, inline="r2")
use_multiple_tp = input.bool(true, "3 حد سود", group=groupRM, inline="r2")

tp1_pips = input.float(30.0, "TP1 (پیپ)", group=groupRM, inline="r3")
tp2_pips = input.float(60.0, "TP2 (پیپ)", group=groupRM, inline="r3")
tp3_pips = input.float(90.0, "TP3 (پیپ)", group=groupRM, inline="r3")

tp1_close_num = input.int(1, "بستن در TP1", minval=0, group=groupRM, inline="r4")
tp2_close_num = input.int(1, "بستن در TP2", minval=0, group=groupRM, inline="r4")
tp3_close_num = input.int(1, "بستن در TP3", minval=0, group=groupRM, inline="r4")

sl_type = input.string("ثابت", "نوع SL", options=["ثابت", "ریسک فری", "تریلینگ"], group=groupRM, inline="r5")
risk_free_pips = input.float(20.0, "ریسک فری (پیپ)", group=groupRM, inline="r5")
trail_pips = input.float(10.0, "تریلینگ (پیپ)", group=groupRM, inline="r5")

default_sl_pips = input.float(50.0, "SL پیش‌فرض (پیپ) اگر سفارشی فعال نباشد", group=groupRM)

atr_length = input.int(14, "طول ATR", minval=1, group=groupRM)

// === حد سود و حد ضرر سفارشی (اختیاری) ===
groupTPSL = "حد سود و حد ضرر سفارشی"
useLongTp = input.bool(false, "TP خرید", inline="longTp", group=groupTPSL)
longTpType = input.string("Price", "نوع", ["Price", "Currency", "%", "ATR"], inline="longTp", group=groupTPSL)
longTpValue = input.float(0, "مقدار", inline="longTp", group=groupTPSL)

useLongSl = input.bool(false, "SL خرید", inline="longSl", group=groupTPSL)
longSlType = input.string("Price", "نوع", ["Price", "Currency", "%", "ATR"], inline="longSl", group=groupTPSL)
longSlValue = input.float(0, "مقدار", inline="longSl", group=groupTPSL)

useShortTp = input.bool(false, "TP فروش", inline="shortTp", group=groupTPSL)
shortTpType = input.string("Price", "نوع", ["Price", "Currency", "%", "ATR"], inline="shortTp", group=groupTPSL)
shortTpValue = input.float(0, "مقدار", inline="shortTp", group=groupTPSL)

useShortSl = input.bool(false, "SL فروش", inline="shortSl", group=groupTPSL)
shortSlType = input.string("Price", "نوع", ["Price", "Currency", "%", "ATR"], inline="shortSl", group=groupTPSL)
shortSlValue = input.float(0, "مقدار", inline="shortSl", group=groupTPSL)

// === هشدارها ===
groupAlerts = "هشدارها"
longEntryAlert = input.string("خرید در {{close}} {{symbol}} {{tf}}", "هشدار ورود خرید", group=groupAlerts)
longExitAlert = input.string("خروج خرید در {{close}}", "هشدار خروج خرید", group=groupAlerts)
shortEntryAlert = input.string("فروش در {{close}} {{symbol}} {{tf}}", "هشدار ورود فروش", group=groupAlerts)
shortExitAlert = input.string("خروج فروش در {{close}}", "هشدار خروج فروش", group=groupAlerts)

// === تابع جایگزینی ===
replacePlaceholders(template, closePrice, symbol, timeframe) =>
    result = template
    result := str.replace_all(result, "{{close}}", str.tostring(closePrice))
    result := str.replace_all(result, "{{symbol}}", symbol)
    result := str.replace_all(result, "{{tf}}", timeframe)
    result

symbolStr = syminfo.ticker
timeframeStr = timeframe.period

// === استپ‌های ورود خرید (1 تا 6) ===
groupLongSteps = "استپ‌های ورود خرید"

longStep1Enable = input.bool(true, "فعال", inline="longStep1", group=groupLongSteps)
longStep1Source1 = input.source(close, "منبع 1", inline="longStep1", group=groupLongSteps)
longStep1Cond = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "تقاطع رو به بالا", "تقاطع رو به پایین", "نابرابر"], inline="longStep1", group=groupLongSteps)
longStep1Source2 = input.source(close, "منبع 2", inline="longStep1", group=groupLongSteps)
longStep1FloatEnable = input.bool(false, "عدد ثابت", inline="longStep1", group=groupLongSteps)
longStep1Float = longStep1FloatEnable ? input.float(0.0, "", inline="longStep1", group=groupLongSteps) : na
longStep1Logic = input.string("هیچ‌کدام", "منطق", options=["هیچ‌کدام", "OR", "ALL"], inline="longStep1", group=groupLongSteps)

longStep2Enable = input.bool(false, "فعال", inline="longStep2", group=groupLongSteps)
longStep2Source1 = input.source(close, "منبع 1", inline="longStep2", group=groupLongSteps)
longStep2Cond = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "تقاطع رو به بالا", "تقاطع رو به پایین", "نابرابر"], inline="longStep2", group=groupLongSteps)
longStep2Source2 = input.source(close, "منبع 2", inline="longStep2", group=groupLongSteps)
longStep2FloatEnable = input.bool(false, "عدد ثابت", inline="longStep2", group=groupLongSteps)
longStep2Float = longStep2FloatEnable ? input.float(0.0, "", inline="longStep2", group=groupLongSteps) : na
longStep2Logic = input.string("هیچ‌کدام", "منطق", options=["هیچ‌کدام", "OR", "ALL"], inline="longStep2", group=groupLongSteps)

longStep3Enable = input.bool(false, "فعال", inline="longStep3", group=groupLongSteps)
longStep3Source1 = input.source(close, "منبع 1", inline="longStep3", group=groupLongSteps)
longStep3Cond = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "تقاطع رو به بالا", "تقاطع رو به پایین", "نابرابر"], inline="longStep3", group=groupLongSteps)
longStep3Source2 = input.source(close, "منبع 2", inline="longStep3", group=groupLongSteps)
longStep3FloatEnable = input.bool(false, "عدد ثابت", inline="longStep3", group=groupLongSteps)
longStep3Float = longStep3FloatEnable ? input.float(0.0, "", inline="longStep3", group=groupLongSteps) : na
longStep3Logic = input.string("هیچ‌کدام", "منطق", options=["هیچ‌کدام", "OR", "ALL"], inline="longStep3", group=groupLongSteps)

// استپ 4
longStep4Enable = input.bool(false, "فعال", inline="longStep4", group=groupLongSteps)
longStep4Source1 = input.source(close, "منبع 1", inline="longStep4", group=groupLongSteps)
longStep4Cond = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "تقاطع رو به بالا", "تقاطع رو به پایین", "نابرابر"], inline="longStep4", group=groupLongSteps)
longStep4Source2 = input.source(close, "منبع 2", inline="longStep4", group=groupLongSteps)
longStep4FloatEnable = input.bool(false, "عدد ثابت", inline="longStep4", group=groupLongSteps)
longStep4Float = longStep4FloatEnable ? input.float(0.0, "", inline="longStep4", group=groupLongSteps) : na
longStep4Logic = input.string("هیچ‌کدام", "منطق", options=["هیچ‌کدام", "OR", "ALL"], inline="longStep4", group=groupLongSteps)

// استپ 5
longStep5Enable = input.bool(false, "فعال", inline="longStep5", group=groupLongSteps)
longStep5Source1 = input.source(close, "منبع 1", inline="longStep5", group=groupLongSteps)
longStep5Cond = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "تقاطع رو به بالا", "تقاطع رو به پایین", "نابرابر"], inline="longStep5", group=groupLongSteps)
longStep5Source2 = input.source(close, "منبع 2", inline="longStep5", group=groupLongSteps)
longStep5FloatEnable = input.bool(false, "عدد ثابت", inline="longStep5", group=groupLongSteps)
longStep5Float = longStep5FloatEnable ? input.float(0.0, "", inline="longStep5", group=groupLongSteps) : na
longStep5Logic = input.string("هیچ‌کدام", "منطق", options=["هیچ‌کدام", "OR", "ALL"], inline="longStep5", group=groupLongSteps)

// استپ 6
longStep6Enable = input.bool(false, "فعال", inline="longStep6", group=groupLongSteps)
longStep6Source1 = input.source(close, "منبع 1", inline="longStep6", group=groupLongSteps)
longStep6Cond = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "تقاطع رو به بالا", "تقاطع رو به پایین", "نابرابر"], inline="longStep6", group=groupLongSteps)
longStep6Source2 = input.source(close, "منبع 2", inline="longStep6", group=groupLongSteps)
longStep6FloatEnable = input.bool(false, "عدد ثابت", inline="longStep6", group=groupLongSteps)
longStep6Float = longStep6FloatEnable ? input.float(0.0, "", inline="longStep6", group=groupLongSteps) : na
longStep6Logic = input.string("هیچ‌کدام", "منطق", options=["هیچ‌کدام", "OR", "ALL"], inline="longStep6", group=groupLongSteps)

// === استپ‌های ورود فروش (1 تا 6) ===
groupShortSteps = "استپ‌های ورود فروش"

// استپ 1
shortStep1Enable = input.bool(true, "فعال", inline="shortStep1", group=groupShortSteps)
shortStep1Source1 = input.source(close, "منبع 1", inline="shortStep1", group=groupShortSteps)
shortStep1Cond = input.string("کوچک‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "تقاطع رو به بالا", "تقاطع رو به پایین", "نابرابر"], inline="shortStep1", group=groupShortSteps)
shortStep1Source2 = input.source(close, "منبع 2", inline="shortStep1", group=groupShortSteps)
shortStep1FloatEnable = input.bool(false, "عدد ثابت", inline="shortStep1", group=groupShortSteps)
shortStep1Float = shortStep1FloatEnable ? input.float(0.0, "", inline="shortStep1", group=groupShortSteps) : na
shortStep1Logic = input.string("هیچ‌کدام", "منطق", options=["هیچ‌کدام", "OR", "ALL"], inline="shortStep1", group=groupShortSteps)

// استپ 2
shortStep2Enable = input.bool(false, "فعال", inline="shortStep2", group=groupShortSteps)
shortStep2Source1 = input.source(close, "منبع 1", inline="shortStep2", group=groupShortSteps)
shortStep2Cond = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "تقاطع رو به بالا", "تقاطع رو به پایین", "نابرابر"], inline="shortStep2", group=groupShortSteps)
shortStep2Source2 = input.source(close, "منبع 2", inline="shortStep2", group=groupShortSteps)
shortStep2FloatEnable = input.bool(false, "عدد ثابت", inline="shortStep2", group=groupShortSteps)
shortStep2Float = shortStep2FloatEnable ? input.float(0.0, "", inline="shortStep2", group=groupShortSteps) : na
shortStep2Logic = input.string("هیچ‌کدام", "منطق", options=["هیچ‌کدام", "OR", "ALL"], inline="shortStep2", group=groupShortSteps)

// استپ 3
shortStep3Enable = input.bool(false, "فعال", inline="shortStep3", group=groupShortSteps)
shortStep3Source1 = input.source(close, "منبع 1", inline="shortStep3", group=groupShortSteps)
shortStep3Cond = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "تقاطع رو به بالا", "تقاطع رو به پایین", "نابرابر"], inline="shortStep3", group=groupShortSteps)
shortStep3Source2 = input.source(close, "منبع 2", inline="shortStep3", group=groupShortSteps)
shortStep3FloatEnable = input.bool(false, "عدد ثابت", inline="shortStep3", group=groupShortSteps)
shortStep3Float = shortStep3FloatEnable ? input.float(0.0, "", inline="shortStep3", group=groupShortSteps) : na
shortStep3Logic = input.string("هیچ‌کدام", "منطق", options=["هیچ‌کدام", "OR", "ALL"], inline="shortStep3", group=groupShortSteps)

// استپ 4
shortStep4Enable = input.bool(false, "فعال", inline="shortStep4", group=groupShortSteps)
shortStep4Source1 = input.source(close, "منبع 1", inline="shortStep4", group=groupShortSteps)
shortStep4Cond = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "تقاطع رو به بالا", "تقاطع رو به پایین", "نابرابر"], inline="shortStep4", group=groupShortSteps)
shortStep4Source2 = input.source(close, "منبع 2", inline="shortStep4", group=groupShortSteps)
shortStep4FloatEnable = input.bool(false, "عدد ثابت", inline="shortStep4", group=groupShortSteps)
shortStep4Float = shortStep4FloatEnable ? input.float(0.0, "", inline="shortStep4", group=groupShortSteps) : na
shortStep4Logic = input.string("هیچ‌کدام", "منطق", options=["هیچ‌کدام", "OR", "ALL"], inline="shortStep4", group=groupShortSteps)

// استپ 5
shortStep5Enable = input.bool(false, "فعال", inline="shortStep5", group=groupShortSteps)
shortStep5Source1 = input.source(close, "منبع 1", inline="shortStep5", group=groupShortSteps)
shortStep5Cond = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "تقاطع رو به بالا", "تقاطع رو به پایین", "نابرابر"], inline="shortStep5", group=groupShortSteps)
shortStep5Source2 = input.source(close, "منبع 2", inline="shortStep5", group=groupShortSteps)
shortStep5FloatEnable = input.bool(false, "عدد ثابت", inline="shortStep5", group=groupShortSteps)
shortStep5Float = shortStep5FloatEnable ? input.float(0.0, "", inline="shortStep5", group=groupShortSteps) : na
shortStep5Logic = input.string("هیچ‌کدام", "منطق", options=["هیچ‌کدام", "OR", "ALL"], inline="shortStep5", group=groupShortSteps)

// استپ 6
shortStep6Enable = input.bool(false, "فعال", inline="shortStep6", group=groupShortSteps)
shortStep6Source1 = input.source(close, "منبع 1", inline="shortStep6", group=groupShortSteps)
shortStep6Cond = input.string("بزرگ‌تر از", "شرط", options=["بزرگ‌تر از", "کوچک‌تر از", "مساوی", "بزرگ‌تر یا مساوی", "کوچک‌تر یا مساوی", "تقاطع رو به بالا", "تقاطع رو به پایین", "نابرابر"], inline="shortStep6", group=groupShortSteps)
shortStep6Source2 = input.source(close, "منبع 2", inline="shortStep6", group=groupShortSteps)
shortStep6FloatEnable = input.bool(false, "عدد ثابت", inline="shortStep6", group=groupShortSteps)
shortStep6Float = shortStep6FloatEnable ? input.float(0.0, "", inline="shortStep6", group=groupShortSteps) : na
shortStep6Logic = input.string("هیچ‌کدام", "منطق", options=["هیچ‌کدام", "OR", "ALL"], inline="shortStep6", group=groupShortSteps)

// === توابع کمکی ===
evaluateCondition(input1, cond, input2) =>
    switch cond
        "بزرگ‌تر از" => input1 > input2
        "کوچک‌تر از" => input1 < input2
        "مساوی" => input1 == input2
        "بزرگ‌تر یا مساوی" => input1 >= input2
        "کوچک‌تر یا مساوی" => input1 <= input2
        "نابرابر" => input1 != input2
        "تقاطع رو به بالا" => ta.crossover(input1, input2)
        "تقاطع رو به پایین" => ta.crossunder(input1, input2)
        => false

checkCondition(input1, cond, input2, enabled) =>
    enabled ? evaluateCondition(input1, cond, input2) : false

getInputValue(enableFloat, inputSource, inputFloat) =>
    enableFloat ? inputFloat : inputSource

// === متغیرهای لچ و تایمر ===
var bool longStep1Triggered = false
var bool longStep2Triggered = false
var bool longStep3Triggered = false
var bool longStep4Triggered = false
var bool longStep5Triggered = false
var bool longStep6Triggered = false

var bool shortStep1Triggered = false
var bool shortStep2Triggered = false
var bool shortStep3Triggered = false
var bool shortStep4Triggered = false
var bool shortStep5Triggered = false
var bool shortStep6Triggered = false

var int longLastUpdateBar = 0
var int shortLastUpdateBar = 0

// === ارزیابی استپ‌های خرید (لانگ) ===
bool longUpdated = false

longStep1Input2 = getInputValue(longStep1FloatEnable, longStep1Source2, longStep1Float)
longStep1Condition = checkCondition(longStep1Source1, longStep1Cond, longStep1Input2, longStep1Enable)
if longStep1Condition and not longStep1Triggered
    longStep1Triggered := true
    longUpdated := true

if longStep2Enable
    longStep2Input2 = getInputValue(longStep2FloatEnable, longStep2Source2, longStep2Float)
    longStep2Condition = checkCondition(longStep2Source1, longStep2Cond, longStep2Input2, true)
    bool shouldTrigger = longStep2Logic == "OR" ? (longStep1Triggered or longStep2Condition) : (longStep1Triggered and longStep2Condition)
    if shouldTrigger and not longStep2Triggered
        longStep2Triggered := true
        longUpdated := true

if longStep3Enable
    longStep3Input2 = getInputValue(longStep3FloatEnable, longStep3Source2, longStep3Float)
    longStep3Condition = checkCondition(longStep3Source1, longStep3Cond, longStep3Input2, true)
    prev = longStep2Enable ? longStep2Triggered : longStep1Triggered
    bool shouldTrigger = longStep3Logic == "OR" ? (prev or longStep3Condition) : (prev and longStep3Condition)
    if shouldTrigger and not longStep3Triggered
        longStep3Triggered := true
        longUpdated := true

if longStep4Enable
    longStep4Input2 = getInputValue(longStep4FloatEnable, longStep4Source2, longStep4Float)
    longStep4Condition = checkCondition(longStep4Source1, longStep4Cond, longStep4Input2, true)
    prev = longStep3Enable ? longStep3Triggered : (longStep2Enable ? longStep2Triggered : longStep1Triggered)
    bool shouldTrigger = longStep4Logic == "OR" ? (prev or longStep4Condition) : (prev and longStep4Condition)
    if shouldTrigger and not longStep4Triggered
        longStep4Triggered := true
        longUpdated := true

if longStep5Enable
    longStep5Input2 = getInputValue(longStep5FloatEnable, longStep5Source2, longStep5Float)
    longStep5Condition = checkCondition(longStep5Source1, longStep5Cond, longStep5Input2, true)
    prev = longStep4Enable ? longStep4Triggered : (longStep3Enable ? longStep3Triggered : (longStep2Enable ? longStep2Triggered : longStep1Triggered))
    bool shouldTrigger = longStep5Logic == "OR" ? (prev or longStep5Condition) : (prev and longStep5Condition)
    if shouldTrigger and not longStep5Triggered
        longStep5Triggered := true
        longUpdated := true

if longStep6Enable
    longStep6Input2 = getInputValue(longStep6FloatEnable, longStep6Source2, longStep6Float)
    longStep6Condition = checkCondition(longStep6Source1, longStep6Cond, longStep6Input2, true)
    prev = longStep5Enable ? longStep5Triggered : (longStep4Enable ? longStep4Triggered : (longStep3Enable ? longStep3Triggered : (longStep2Enable ? longStep2Triggered : longStep1Triggered)))
    bool shouldTrigger = longStep6Logic == "OR" ? (prev or longStep6Condition) : (prev and longStep6Condition)
    if shouldTrigger and not longStep6Triggered
        longStep6Triggered := true
        longUpdated := true

if longUpdated
    longLastUpdateBar := bar_index

// === ارزیابی استپ‌های فروش (شورت) ===
bool shortUpdated = false

shortStep1Input2 = getInputValue(shortStep1FloatEnable, shortStep1Source2, shortStep1Float)
shortStep1Condition = checkCondition(shortStep1Source1, shortStep1Cond, shortStep1Input2, shortStep1Enable)
if shortStep1Condition and not shortStep1Triggered
    shortStep1Triggered := true
    shortUpdated := true

if shortStep2Enable
    shortStep2Input2 = getInputValue(shortStep2FloatEnable, shortStep2Source2, shortStep2Float)
    shortStep2Condition = checkCondition(shortStep2Source1, shortStep2Cond, shortStep2Input2, true)
    bool shouldTrigger = shortStep2Logic == "OR" ? (shortStep1Triggered or shortStep2Condition) : (shortStep1Triggered and shortStep2Condition)
    if shouldTrigger and not shortStep2Triggered
        shortStep2Triggered := true
        shortUpdated := true

if shortStep3Enable
    shortStep3Input2 = getInputValue(shortStep3FloatEnable, shortStep3Source2, shortStep3Float)
    shortStep3Condition = checkCondition(shortStep3Source1, shortStep3Cond, shortStep3Input2, true)
    prev = shortStep2Enable ? shortStep2Triggered : shortStep1Triggered
    bool shouldTrigger = shortStep3Logic == "OR" ? (prev or shortStep3Condition) : (prev and shortStep3Condition)
    if shouldTrigger and not shortStep3Triggered
        shortStep3Triggered := true
        shortUpdated := true

if shortStep4Enable
    shortStep4Input2 = getInputValue(shortStep4FloatEnable, shortStep4Source2, shortStep4Float)
    shortStep4Condition = checkCondition(shortStep4Source1, shortStep4Cond, shortStep4Input2, true)
    prev = shortStep3Enable ? shortStep3Triggered : (shortStep2Enable ? shortStep2Triggered : shortStep1Triggered)
    bool shouldTrigger = shortStep4Logic == "OR" ? (prev or shortStep4Condition) : (prev and shortStep4Condition)
    if shouldTrigger and not shortStep4Triggered
        shortStep4Triggered := true
        shortUpdated := true

if shortStep5Enable
    shortStep5Input2 = getInputValue(shortStep5FloatEnable, shortStep5Source2, shortStep5Float)
    shortStep5Condition = checkCondition(shortStep5Source1, shortStep5Cond, shortStep5Input2, true)
    prev = shortStep4Enable ? shortStep4Triggered : (shortStep3Enable ? shortStep3Triggered : (shortStep2Enable ? shortStep2Triggered : shortStep1Triggered))
    bool shouldTrigger = shortStep5Logic == "OR" ? (prev or shortStep5Condition) : (prev and shortStep5Condition)
    if shouldTrigger and not shortStep5Triggered
        shortStep5Triggered := true
        shortUpdated := true

if shortStep6Enable
    shortStep6Input2 = getInputValue(shortStep6FloatEnable, shortStep6Source2, shortStep6Float)
    shortStep6Condition = checkCondition(shortStep6Source1, shortStep6Cond, shortStep6Input2, true)
    prev = shortStep5Enable ? shortStep5Triggered : (shortStep4Enable ? shortStep4Triggered : (shortStep3Enable ? shortStep3Triggered : (shortStep2Enable ? shortStep2Triggered : shortStep1Triggered)))
    bool shouldTrigger = shortStep6Logic == "OR" ? (prev or shortStep6Condition) : (prev and shortStep6Condition)
    if shouldTrigger and not shortStep6Triggered
        shortStep6Triggered := true
        shortUpdated := true

if shortUpdated
    shortLastUpdateBar := bar_index

// === ریست تایمر ===
if bar_index - longLastUpdateBar > calculationBars
    longStep1Triggered := false
    longStep2Triggered := false
    longStep3Triggered := false
    longStep4Triggered := false
    longStep5Triggered := false
    longStep6Triggered := false
    longLastUpdateBar := bar_index

if bar_index - shortLastUpdateBar > calculationBars
    shortStep1Triggered := false
    shortStep2Triggered := false
    shortStep3Triggered := false
    shortStep4Triggered := false
    shortStep5Triggered := false
    shortStep6Triggered := false
    shortLastUpdateBar := bar_index

// === تولید سیگنال ===
bool longSignal = false
bool shortSignal = false

longLastTriggered = longStep6Enable ? longStep6Triggered : (longStep5Enable ? longStep5Triggered : (longStep4Enable ? longStep4Triggered : (longStep3Enable ? longStep3Triggered : (longStep2Enable ? longStep2Triggered : longStep1Triggered))))
if longLastTriggered and longStep1Enable
    longSignal := true

shortLastTriggered = shortStep6Enable ? shortStep6Triggered : (shortStep5Enable ? shortStep5Triggered : (shortStep4Enable ? shortStep4Triggered : (shortStep3Enable ? shortStep3Triggered : (shortStep2Enable ? shortStep2Triggered : shortStep1Triggered))))
if shortLastTriggered and shortStep1Enable
    shortSignal := true

// === متغیرهای معامله ===
var float long_entry_price = na
var float short_entry_price = na
var float long_trailing_sl = na
var float short_trailing_sl = na
atrValue = ta.atr(atr_length)

// === محاسبه TP/SL سفارشی ===
calcTP(type, price, value, isLong) =>
    switch type
        "Currency" => isLong ? price + value : price - value
        "%" => isLong ? price * (1 + value / 100) : price * (1 - value / 100)
        "ATR" => isLong ? price + atrValue * value : price - atrValue * value
        "Price" => value
        => na

calcSL(type, price, value, isLong) =>
    switch type
        "Currency" => isLong ? price - value : price + value
        "%" => isLong ? price * (1 - value / 100) : price * (1 + value / 100)
        "ATR" => isLong ? price - atrValue * value : price + atrValue * value
        "Price" => value
        => na

// === محاسبه اندازه پوزیشن ===
calcQty(float entryPrice, float slLevel, int numPos) =>
    float qty = na
    if na(slLevel)
        qty := position_cash * numPos
    else
        float slDistance = math.abs(entryPrice - slLevel)
        float riskAmount = strategy.equity * (risk_percent / 100)
        qty := riskAmount / slDistance
        qty := qty * numPos
    qty

// === چک مجموع TPها ===
int totalTpClose = tp1_close_num + tp2_close_num + tp3_close_num
if use_multiple_tp and totalTpClose < num_positions
    tp3_close_num := tp3_close_num + (num_positions - totalTpClose)

// === متغیرهای پروجکشن (تعریف در ابتدا) ===
var float plot_entry = na
var float plot_sl = na
var float plot_tp = na

// === ورود به معامله ===
if longSignal
    longSlLevel = useLongSl ? calcSL(longSlType, close, longSlValue, true) : close - default_sl_pips * pip_size
    qtyLong = calcQty(close, longSlLevel, num_positions)
    strategy.entry("Long", strategy.long, qty=qtyLong)
    long_entry_price := close

    plot_entry := close
    plot_sl := longSlLevel
    plot_tp := use_multiple_tp ? close + tp3_pips * pip_size : (useLongTp ? calcTP(longTpType, close, longTpValue, true) : na)

    if use_multiple_tp
        if tp1_close_num > 0
            strategy.exit("LongTP1", "Long", qty_percent=(tp1_close_num/num_positions)*100, limit=close + tp1_pips * pip_size)
        if tp2_close_num > 0
            strategy.exit("LongTP2", "Long", qty_percent=(tp2_close_num/num_positions)*100, limit=close + tp2_pips * pip_size)
        if tp3_close_num > 0
            strategy.exit("LongTP3", "Long", qty_percent=(tp3_close_num/num_positions)*100, limit=close + tp3_pips * pip_size)
    else if useLongTp
        tpLevel = calcTP(longTpType, close, longTpValue, true)
        if not na(tpLevel)
            strategy.exit("LongTP", "Long", limit=tpLevel)

    if not na(longSlLevel)
        if sl_type == "ثابت"
            strategy.exit("LongSL", "Long", stop=longSlLevel)
        else
            long_trailing_sl := longSlLevel

    alert(replacePlaceholders(longEntryAlert, close, symbolStr, timeframeStr), alert.freq_once_per_bar)

    longStep1Triggered := false
    longStep2Triggered := false
    longStep3Triggered := false
    longStep4Triggered := false
    longStep5Triggered := false
    longStep6Triggered := false
    longLastUpdateBar := bar_index

if shortSignal
    shortSlLevel = useShortSl ? calcSL(shortSlType, close, shortSlValue, false) : close + default_sl_pips * pip_size
    qtyShort = calcQty(close, shortSlLevel, num_positions)
    strategy.entry("Short", strategy.short, qty=qtyShort)
    short_entry_price := close

    plot_entry := close
    plot_sl := shortSlLevel
    plot_tp := use_multiple_tp ? close - tp3_pips * pip_size : (useShortTp ? calcTP(shortTpType, close, shortTpValue, false) : na)

    if use_multiple_tp
        if tp1_close_num > 0
            strategy.exit("ShortTP1", "Short", qty_percent=(tp1_close_num/num_positions)*100, limit=close - tp1_pips * pip_size)
        if tp2_close_num > 0
            strategy.exit("ShortTP2", "Short", qty_percent=(tp2_close_num/num_positions)*100, limit=close - tp2_pips * pip_size)
        if tp3_close_num > 0
            strategy.exit("ShortTP3", "Short", qty_percent=(tp3_close_num/num_positions)*100, limit=close - tp3_pips * pip_size)
    else if useShortTp
        tpLevel = calcTP(shortTpType, close, shortTpValue, false)
        if not na(tpLevel)
            strategy.exit("ShortTP", "Short", limit=tpLevel)

    if not na(shortSlLevel)
        if sl_type == "ثابت"
            strategy.exit("ShortSL", "Short", stop=shortSlLevel)
        else
            short_trailing_sl := shortSlLevel

    alert(replacePlaceholders(shortEntryAlert, close, symbolStr, timeframeStr), alert.freq_once_per_bar)

    shortStep1Triggered := false
    shortStep2Triggered := false
    shortStep3Triggered := false
    shortStep4Triggered := false
    shortStep5Triggered := false
    shortStep6Triggered := false
    shortLastUpdateBar := bar_index

// === تریلینگ استاپ ===
if strategy.position_size > 0 and sl_type != "ثابت" and not na(long_trailing_sl)
    profit_pips = (close - long_entry_price) / pip_size
    if profit_pips >= risk_free_pips
        long_trailing_sl := math.max(long_trailing_sl, long_entry_price)
    if sl_type == "تریلینگ"
        long_trailing_sl := math.max(long_trailing_sl, close - trail_pips * pip_size)
    if close < long_trailing_sl
        strategy.close("Long", comment="Trailing SL")
        long_trailing_sl := na
        plot_sl := na
        alert(replacePlaceholders(longExitAlert, close, symbolStr, timeframeStr), alert.freq_once_per_bar)

if strategy.position_size < 0 and sl_type != "ثابت" and not na(short_trailing_sl)
    profit_pips = (short_entry_price - close) / pip_size
    if profit_pips >= risk_free_pips
        short_trailing_sl := math.min(short_trailing_sl, short_entry_price)
    if sl_type == "تریلینگ"
        short_trailing_sl := math.min(short_trailing_sl, close + trail_pips * pip_size)
    if close > short_trailing_sl
        strategy.close("Short", comment="Trailing SL")
        short_trailing_sl := na
        plot_sl := na
        alert(replacePlaceholders(shortExitAlert, close, symbolStr, timeframeStr), alert.freq_once_per_bar)

// === ریست متغیرها در صورت بسته شدن پوزیشن ===
if strategy.position_size == 0
    plot_entry := na
    plot_sl := na
    plot_tp := na
    long_trailing_sl := na
    short_trailing_sl := na
    long_entry_price := na
    short_entry_price := na

// === PLOT — نمایش در تب STYLE (در انتها)
plot(plot_entry, title="خط ورود",     color=color.blue,   linewidth=1, style=plot.style_circles,  display=display.all)
plot(plot_sl,     title="خط حد ضرر",   color=color.red,    linewidth=1, style=plot.style_circles,  display=display.all)
plot(plot_tp,     title="خط حد سود",   color=color.green,  linewidth=1, style=plot.style_circles,  display=display.all)

// === هشدارها ===
alertcondition(longSignal, "ورود خرید", "سیگنال خرید")
alertcondition(shortSignal, "ورود فروش", "سیگنال فروش")