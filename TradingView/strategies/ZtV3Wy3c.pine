//@version=5
strategy("Ichimoku: Chikou Touch Exit", overlay=true, initial_capital=1000)

// --- Inputs ---
ts_bars     = input.int(9, minval=1, title="Tenkan-Sen Bars")
ks_bars     = input.int(26, minval=1, title="Kijun-Sen Bars")
ssb_bars    = input.int(52, minval=1, title="Senkou-Span B Bars")
cs_offset   = input.int(26, minval=1, title="Chikou-Span Offset (Lookback)")
ss_offset   = input.int(26, minval=1, title="Senkou-Span Offset (Forward)")

// Opções de Entrada
long_entry  = input.bool(true, title="Permitir Compras (Long)")
short_entry = input.bool(true, title="Permitir Vendas (Short)")

// --- Cálculos Ichimoku ---
middle(len) => math.avg(ta.lowest(len), ta.highest(len))

tenkan  = middle(ts_bars)
kijun   = middle(ks_bars)
senkouA = math.avg(tenkan, kijun)
senkouB = middle(ssb_bars)

// --- Lógica de Preço vs Nuvem (Kumo) ---
// Olhamos para a nuvem que foi projetada para o momento atual
current_ss_a = senkouA[ss_offset-1]
current_ss_b = senkouB[ss_offset-1]
ss_high = math.max(current_ss_a, current_ss_b)
ss_low  = math.min(current_ss_a, current_ss_b)

// --- Condições de Entrada (Originais) ---
tk_cross_bull    = tenkan > kijun
tk_cross_bear    = tenkan < kijun
cs_above_price   = ta.mom(close, cs_offset-1) > 0
cs_below_price   = ta.mom(close, cs_offset-1) < 0
price_above_kumo = close > ss_high
price_below_kumo = close < ss_low

bullish_signal = tk_cross_bull and cs_above_price and price_above_kumo
bearish_signal = tk_cross_bear and cs_below_price and price_below_kumo

// --- NOVA LÓGICA DE SAÍDA: Chikou Span toca o Preço ---
// A Chikou tocar o preço significa que o Preço Atual cruzou o Preço de X períodos atrás.
// Usamos cs_offset-1 para alinhar exatamente com a plotagem visual do TradingView.
price_lookback = close[cs_offset-1]
chikou_exit_long  = ta.cross(close, price_lookback) // Toque ou cruzamento
chikou_exit_short = ta.cross(close, price_lookback)

// --- Execução da Estratégia ---

// Entradas
if (bullish_signal and long_entry)
    strategy.entry("Long", strategy.long)

if (bearish_signal and short_entry)
    strategy.entry("Short", strategy.short)

// Saídas baseadas no toque da Chikou Span
if (strategy.position_size > 0 and chikou_exit_long)
    strategy.close("Long", comment="Exit: Chikou Touch")

if (strategy.position_size < 0 and chikou_exit_short)
    strategy.close("Short", comment="Exit: Chikou Touch")

// --- Plotagem Visual ---
plot(tenkan, color=color.blue, title="Tenkan")
plot(kijun, color=color.red, title="Kijun")
sa = plot(senkouA, offset=ss_offset-1, color=color.new(color.green, 60), title="Senkou A")
sb = plot(senkouB, offset=ss_offset-1, color=color.new(color.red, 60), title="Senkou B")
fill(sa, sb, color=senkouA > senkouB ? color.new(color.green, 90) : color.new(color.red, 90))

// Plotando o preço de lookback para você ver onde a Chikou bateria
plot(price_lookback, color=color.new(color.gray, 50), style=plot.style_stepline, title="Preço de Referência Chikou")