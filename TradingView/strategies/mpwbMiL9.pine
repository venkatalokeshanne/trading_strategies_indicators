//@version=5
strategy("2x Universelle Linien [LionTrader]", overlay=true)
richtung = input.string('beide', options = ['beide','short', 'long'])

// ==========================================
// 1. SETTINGS: LINIE 1
// ==========================================
grp1 = "--- LINIE 1 ---"
line_type1 = input.string("EMA", title="Art der Linie 1", group=grp1,
  options=["SMA", "EMA", "WMA", "RMA", "SMMA", "VWMA", "HMA (Hull)", "ALMA", "LSMA (LinReg)", "DEMA", "TEMA", "KAMA", "ZLEMA", "TMA", "McGinley", "VWAP", "Nur Preis"])
src1 = input.source(close, title="Datenquelle 1", group=grp1)
len1 = input.int(21, title="Länge 1", minval=1, group=grp1)
alma_off1 = input.float(0.85, title="ALMA Offset 1", step=0.05, group=grp1)
alma_sig1 = input.float(6.0, title="ALMA Sigma 1", step=1.0, group=grp1)

// ==========================================
// 2. SETTINGS: LINIE 2
// ==========================================
grp2 = "--- LINIE 2 ---"
line_type2 = input.string("SMA", title="Art der Linie 2", group=grp2,
  options=["SMA", "EMA", "WMA", "RMA", "SMMA", "VWMA", "HMA (Hull)", "ALMA", "LSMA (LinReg)", "DEMA", "TEMA", "KAMA", "ZLEMA", "TMA", "McGinley", "VWAP", "Nur Preis"])
src2 = input.source(close, title="Datenquelle 2", group=grp2)
len2 = input.int(50, title="Länge 2", minval=1, group=grp2)
alma_off2 = input.float(0.85, title="ALMA Offset 2", step=0.05, group=grp2)
alma_sig2 = input.float(6.0, title="ALMA Sigma 2", step=1.0, group=grp2)


// ==========================================
// 3. SPEZIAL-BERECHNUNGEN (CUSTOM MATH)
// ==========================================
calc_dema(s, l) => 
    e1 = ta.ema(s, l)
    2 * e1 - ta.ema(e1, l)

calc_tema(s, l) => 
    e1 = ta.ema(s, l)
    e2 = ta.ema(e1, l)
    3 * (e1 - e2) + ta.ema(e2, l)

calc_kama(s, l) =>
    volatility = math.sum(math.abs(s - s[1]), l)
    change = math.abs(s - s[l])
    er = volatility != 0 ? change / volatility : 0
    sc = math.pow(er * (2.0 / 3.0 - 2.0 / 31.0) + 2.0 / 31.0, 2)
    var float k = na
    k := na(k[1]) ? s : k[1] + sc * (s - k[1])
    k

calc_zlema(s, l) =>
    lag = math.round((l - 1) / 2)
    ema_data = s + (s - s[lag])
    ta.ema(ema_data, l)

calc_tma(s, l) =>
    half_len = math.round((l + 1) / 2)
    ta.sma(ta.sma(s, half_len), half_len)

calc_mcginley(s, l) =>
    var float mg = na
    mg := na(mg[1]) ? ta.ema(s, l) : mg[1] + (s - mg[1]) / (l * math.pow(s / mg[1], 4))
    mg

// ==========================================
// 4. HAUPT-FUNKTION ZUR LINIEN-ERZEUGUNG
// ==========================================
// Diese Funktion liest deine Settings aus und baut die entsprechende Linie
get_line(l_type, s, l, a_offset, a_sigma) =>
    float val = switch l_type
        "SMA" => ta.sma(s, l)
        "EMA" => ta.ema(s, l)
        "WMA" => ta.wma(s, l)
        "RMA" => ta.rma(s, l)
        "SMMA" => ta.rma(s, l)
        "VWMA" => ta.vwma(s, l)
        "HMA (Hull)" => ta.hma(s, l)
        "ALMA" => ta.alma(s, l, a_offset, a_sigma)
        "LSMA (LinReg)" => ta.linreg(s, l, 0)
        "DEMA" => calc_dema(s, l)
        "TEMA" => calc_tema(s, l)
        "KAMA" => calc_kama(s, l)
        "ZLEMA" => calc_zlema(s, l)
        "TMA" => calc_tma(s, l)
        "McGinley" => calc_mcginley(s, l)
        "VWAP" => ta.vwap(s)
        "Nur Preis" => s
        => s
    val // Gibt den berechneten Wert zurück

// ==========================================
// 5. DEINE ZWEI VARIABLEN SIND HIER:
// ==========================================
myLine1 = get_line(line_type1, src1, len1, alma_off1, alma_sig1)
myLine2 = get_line(line_type2, src2, len2, alma_off2, alma_sig2)


// ==========================================
// 6. AUSGABE UND BEISPIEL-LOGIK
// ==========================================
// Die Linien auf den Chart zeichnen
plot(myLine1, title="Linie 1",color = myLine1 > myLine2 ? color.new(#2eba22, 0) : color.new(#d91c1c, 0),linewidth=2)
plot(myLine2, title="Linie 2",color = myLine1 > myLine2 ? color.new(#199410, 0) : color.new(#941010, 0),linewidth=2)

// BEISPIEL: Crossover erkennen und auf dem Chart markieren
// Kreuzt Linie 1 NACH OBEN über Linie 2?
cross_up = ta.crossover(myLine1, myLine2)

// Kreuzt Linie 1 NACH UNTEN unter Linie 2?
cross_down = ta.crossunder(myLine1, myLine2)

// Kleine Dreiecke auf den Chart malen, wenn sie sich kreuzen
plotshape(cross_up, title="Kreuzung Hoch", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(cross_down, title="Kreuzung Runter", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)
if richtung == 'beide' or richtung == 'long'
    strategy.entry('long',strategy.long, when= cross_up)
    strategy.close('long',when= cross_down)
if richtung == 'beide' or richtung == 'short'
    strategy.entry('short',strategy.short, when= cross_down)
    strategy.close('short', when= cross_up)