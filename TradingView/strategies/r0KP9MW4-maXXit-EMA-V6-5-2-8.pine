    table.cell(dashboard, 1, row, str.tostring(adaptive_sl*100, '#.#') + ' %' + ' / ' +  str.format("{0,number,#,##0.00}", trail_points), text_color = c_red, text_size = dash_text_size)
    table.cell(dashboard, 2, row, 'Vola Fkt/TRL Offset:', text_color = c_gray, text_size = dash_text_size)
    table.cell(dashboard, 3, row, str.format("{0,number,#0.0}", calc_adaption) + ' / ' + str.format("{0,number,##0.00}", trl_offset), text_color = c_red, text_size = dash_text_size)
    row := row + 1

    // Trading entry
    table.cell(dashboard, 0, row, 'Entry:', text_color = c_gray, text_size = dash_text_size)
    table.cell(dashboard, 1, row, strategy.position_size>0 ? str.tostring(l_entry, '#,###.##') : strategy.position_size<0 ? str.tostring(s_entry, '#,###.##') : 'no entry',  text_color=strategy.position_size<0 ? c_red : strategy.position_size>0 ? c_green : c_blue,text_size=dash_text_size)
    table.cell(dashboard, 2, row, 'Profit Points:', text_color = c_gray, text_size = dash_text_size)
    table.cell(dashboard, 3, row, strategy.position_size != 0 ? str.format("{0,number,#,##0.0}", profit_points) : 'no profit', text_color=profit_points<0 ? c_red : profit_points>0 ? c_green : c_blue,text_size=dash_text_size)
    row := row + 1

    //Aktueller Stop-Loss und Take-Profit-Level
    table.cell(dashboard, 0, row, 'FIX/TRL LX:', text_color = c_gray, text_size = dash_text_size)
    table.cell(dashboard, 1, row, strategy.position_size > 0 ? str.format("{0,number,#,###.00}", sl_stop)  + ' / ' + str.format("{0,number,#,###.00}", l_stop) : str.format("{0,number,#,###.00}", close - (close*adaptive_sl)), text_color = c_red, text_size = dash_text_size)
    table.cell(dashboard, 2, row, 'TP Long:', text_color = c_gray, text_size = dash_text_size)
    table.cell(dashboard, 3, row, strategy.position_size > 0 ? str.format("{0,number,#,###.00}", sl_limit) : str.format("{0,number,#,###.00}", close + (close*adaptive_tp)), text_color = c_green, text_size = dash_text_size)
    row := row + 1    

    table.cell(dashboard, 0, row, 'FIX/TRL SX:', text_color = c_gray, text_size = dash_text_size)
    table.cell(dashboard, 1, row, strategy.position_size < 0 ? str.format("{0,number,#,###.00}", ss_stop)  + ' / ' + str.format("{0,number,#,###.00}", s_stop) : str.format("{0,number,#,###.00}", close + (close*adaptive_sl)), text_color = c_green, text_size = dash_text_size)
    table.cell(dashboard, 2, row, 'TP Short:', text_color = c_gray, text_size = dash_text_size)
    table.cell(dashboard, 3, row, strategy.position_size < 0 ? str.format("{0,number,#,###.00}", ss_limit) : str.format("{0,number,#,###.00}", close - (close*adaptive_tp)), text_color = c_red, text_size = dash_text_size)
    row := row + 1       

    if strategy.position_size != 0 and dashboardSize != 'Small'
        table.merge_cells(dashboard, 0, row, 4, row)
        table.cell(dashboard, 0, row, '═════    P/L Calculation    ═════' , text_color = strategy.position_size < 0 ? c_red : strategy.position_size > 0 ? c_green : c_blue, bgcolor = bg_gray, text_size = dash_text_size)
        row := row + 1

        //Possible Loss/Profit
        table.cell(dashboard, 0, row, 'Dollar p.P.:', text_color = c_gray, text_size = dash_text_size)
        table.cell(dashboard, 1, row, str.format("{0,number,#,##0.0}", DOLLAR_PER_POINT),  text_color=strategy.position_size<0 ? c_red : strategy.position_size>0 ? c_green : c_blue,text_size=dash_text_size)
        table.cell(dashboard, 2, row, 'Current P/L:', text_color = c_gray, text_size = dash_text_size)
        table.cell(dashboard, 3, row, strategy.position_size != 0 ? str.format("{0,number,#,###}", curr_profit) +' '+ str.tostring(INSTR_CURR) : 'no profit', text_color=profit_points<0 ? c_red : profit_points>0 ? c_green : c_blue,text_size=dash_text_size)    
        row := row + 1    

        table.cell(dashboard, 0, row, 'Stop Loss:', text_color = c_gray, text_size = dash_text_size)
        table.cell(dashboard, 1, row, strategy.position_size < 0 ? str.format("{0,number,#,##0.0}", ss_loss) +' '+ str.tostring(INSTR_CURR) : strategy.position_size > 0 ? str.format("{0,number,#,##0.0}", sl_loss) +' '+ str.tostring(INSTR_CURR) : ' no loss', text_color = x_gain ? c_green : c_red, text_size = dash_text_size)
        table.cell(dashboard, 2, row, 'Take Profit:', text_color = c_gray, text_size = dash_text_size)
        table.cell(dashboard, 3, row, strategy.position_size < 0 ? str.format("{0,number,#,##0.0}", ss_profit) +' '+ str.tostring(INSTR_CURR) : strategy.position_size > 0 ? str.format("{0,number,#,##0.0}", sl_profit) +' '+ str.tostring(INSTR_CURR) : ' no profit', text_color = c_green, text_size = dash_text_size)
        row := row + 1    

    else
        // row 0: merged cell (Spalte 0-4)
        table.clear(dashboard, 0, row)
        table.clear(dashboard, 1, row)
        table.clear(dashboard, 2, row)
        table.clear(dashboard, 3, row)
        table.clear(dashboard, 4, row)
        // row 1: Dollar p.P. / Current P/L
        table.clear(dashboard, 0, row + 1)
        table.clear(dashboard, 1, row + 1)
        table.clear(dashboard, 2, row + 1)
        table.clear(dashboard, 3, row + 1)
        // row 2: Stop Loss / Take Profit
        table.clear(dashboard, 0, row + 2)
        table.clear(dashboard, 1, row + 2)
        table.clear(dashboard, 2, row + 2)
        table.clear(dashboard, 3, row + 2)
        table.clear(dashboard, 0, row + 3)
        table.clear(dashboard, 1, row + 3)
        table.clear(dashboard, 2, row + 3)
        table.clear(dashboard, 3, row + 3)

    table.merge_cells(dashboard, 0, row, 4, row)
    table.cell(dashboard, 0, row, '═══  $ p Point: '+str.format("{0,number,#,##0.00}", DOLLAR_PER_POINT)+'  Ticks p Point: '+str.tostring(TICKS_PER_POINT, '#')+'  ask '+ str.format("{0,number,#,##0.00}", limit_ask) + ' bid '+ str.format("{0,number,#,##0.00}", limit_bid) +'  ═══' , text_color = c_purple, bgcolor = bg_gray, text_size = dash_text_size)

// ========================================
// ANIMATED WATERMARK
// ========================================
var table watermarkMain = table.new(position.bottom_right, 3, 1, bgcolor = color.new(color.black, 100), border_width = 0)
var table watermarkGlow1 = table.new(position.bottom_right, 3, 1, bgcolor = color.new(color.black, 100), border_width = 0)
var table watermarkGlow2 = table.new(position.bottom_right, 3, 1, bgcolor = color.new(color.black, 100), border_width = 0)
																																															   
var int animFrame = 0
var float glowAlphaWatermark = 80

//if barstate.isrealtime //or barstate.islast and barstate.islastconfirmedhistory
if barstate.islast or barstate.isrealtime
    
    animFrame := (animFrame + 1) % 100
    glowAlphaWatermark := 50 + math.sin(animFrame * 0.1) * 20

    table.clear(watermarkMain, 0, 0)
    table.clear(watermarkGlow1, 0, 0)
    table.clear(watermarkGlow2, 0, 0)

    // Adjust watermark size based on dashboard size
    watermark_text_size = size.normal
    watermarkColorBase = weeklyPnL > 0 ? color.rgb(73, 192, 73) : weeklyPnL < 0 ? color.rgb(255, 100, 100) : neutralColor

    table.cell(watermarkGlow2, 0, 0, '⚡', text_color = color.new(watermarkColorBase, math.round(glowAlphaWatermark) + 20), text_size = watermark_text_size, text_halign = text.align_center)
    table.cell(watermarkGlow2, 1, 0, 'maXXit consulting', text_color = color.new(watermarkColorBase, math.round(glowAlphaWatermark) + 20), text_size = watermark_text_size, text_halign = text.align_center)
    table.cell(watermarkGlow2, 2, 0, '⚡', text_color = color.new(watermarkColorBase, math.round(glowAlphaWatermark) + 20), text_size = watermark_text_size, text_halign = text.align_center)

    table.cell(watermarkGlow1, 0, 0, '⚡', text_color = color.new(accent1, math.round(glowAlphaWatermark)), text_size = watermark_text_size, text_halign = text.align_center)
    table.cell(watermarkGlow1, 1, 0, 'maXXit consulting', text_color = color.new(accent1, math.round(glowAlphaWatermark)), text_size = watermark_text_size, text_halign = text.align_center)
    table.cell(watermarkGlow1, 2, 0, '⚡', text_color = color.new(accent1, math.round(glowAlphaWatermark)), text_size = watermark_text_size, text_halign = text.align_center)

    mainTextWatermark = 'maXXit consulting' + (weeklyPnL != 0 ? (weeklyPnL > 0 ? ' ▲ ' : ' ▼ ') + str.tostring(weeklyPnL, '$#,###.00') : '')
    table.cell(watermarkMain, 0, 0, animFrame % 20 < 10 ? '⚡' : '✦', text_color = watermarkColorBase, text_size = watermark_text_size, text_halign = text.align_center)
    table.cell(watermarkMain, 1, 0, mainTextWatermark, text_color = watermarkColorBase, text_size = watermark_text_size, text_halign = text.align_center)
    table.cell(watermarkMain, 2, 0, animFrame % 20 >= 10 ? '⚡' : '✦', text_color = watermarkColorBase, text_size = watermark_text_size, text_halign = text.align_center)
//
// EOF