     "Maximum FVG Zones",
     minval = 0,
     maxval = 200,
     group = groupDisplay
)

extensionMode = input.string(
     "Indefinite Until Penetrated",
     "Untouched-Zone Extension Mode",
     options = [
         "Indefinite Until Penetrated",
         "Fixed Extension"
     ],
     group = groupDisplay
)

fixedUntouchedBars = input.int(
     65,
     "Fixed Untouched Extension Bars",
     minval = 0,
     maxval = 500,
     tooltip = "Used only in Fixed Extension mode. Measured forward from candle 3.",
     group = groupDisplay
)

postPenetrationBars = input.int(
     10,
     "Bars After First Penetration",
     minval = 0,
     maxval = 500,
     tooltip = "0 stops the rectangle on the first penetration candle.",
     group = groupDisplay
)

bool useIndefiniteExtension =
     extensionMode == "Indefinite Until Penetrated"

