//@version=6
strategy("Swing Fibonacci Strategy", shorttitle="SwingFib", overlay=true,
     pyramiding=0,
     process_orders_on_close=false,
     calc_on_order_fills=true,
     calc_on_every_tick=true,
     max_lines_count=500,
     max_labels_count=500,
     max_boxes_count=500)

// ============================================================================
// 01 - TIME SETTINGS
// ============================================================================

groupTime = "01 - Time Settings"

useTimeFilter = input.bool(false, "Use Active Trading Hours", group=groupTime)

startHour = input.int(8, "Active Start Hour", minval=0, maxval=23, group=groupTime)
startMinute = input.int(0, "Active Start Minute", minval=0, maxval=59, group=groupTime)

endHour = input.int(16, "Active End Hour", minval=0, maxval=23, group=groupTime)
endMinute = input.int(0, "Active End Minute", minval=0, maxval=59, group=groupTime)

timeZone = input.string(
     "America/New_York",
     "Time Zone",
     options=[
         "America/New_York",
         "America/Chicago",
         "America/Denver",
         "America/Los_Angeles",
         "UTC"
     ],
     group=groupTime)

curMinutes = hour(time, timeZone) * 60 + minute(time, timeZone)
startMinutes = startHour * 60 + startMinute
endMinutes = endHour * 60 + endMinute

bool activeTime = true

if useTimeFilter
    if startMinutes <= endMinutes
        activeTime := curMinutes >= startMinutes and curMinutes <= endMinutes
    else
        activeTime := curMinutes >= startMinutes or curMinutes <= endMinutes


// ============================================================================
// 02 - NO TRADE WINDOW 1
// ============================================================================

groupNT1 = "02 - No Trade Window 1"

useNoTrade1 = input.bool(true, "Enable No Trade Window 1", group=groupNT1)

nt1StartHour = input.int(9, "Start Hour", minval=0, maxval=23, group=groupNT1)
nt1StartMinute = input.int(30, "Start Minute", minval=0, maxval=59, group=groupNT1)

nt1EndHour = input.int(10, "End Hour", minval=0, maxval=23, group=groupNT1)
nt1EndMinute = input.int(0, "End Minute", minval=0, maxval=59, group=groupNT1)

nt1Start = nt1StartHour * 60 + nt1StartMinute
nt1End = nt1EndHour * 60 + nt1EndMinute

bool inNoTrade1 = false

if useNoTrade1
    if nt1Start <= nt1End
        inNoTrade1 := curMinutes >= nt1Start and curMinutes <= nt1End
    else
        inNoTrade1 := curMinutes >= nt1Start or curMinutes <= nt1End


// ============================================================================
// 03 - NO TRADE WINDOW 2
// ============================================================================

groupNT2 = "03 - No Trade Window 2"

useNoTrade2 = input.bool(false, "Enable No Trade Window 2", group=groupNT2)

nt2StartHour = input.int(11, "Start Hour", minval=0, maxval=23, group=groupNT2)
nt2StartMinute = input.int(30, "Start Minute", minval=0, maxval=59, group=groupNT2)

nt2EndHour = input.int(12, "End Hour", minval=0, maxval=23, group=groupNT2)
nt2EndMinute = input.int(30, "End Minute", minval=0, maxval=59, group=groupNT2)

nt2Start = nt2StartHour * 60 + nt2StartMinute
nt2End = nt2EndHour * 60 + nt2EndMinute

bool inNoTrade2 = false

if useNoTrade2
    if nt2Start <= nt2End
        inNoTrade2 := curMinutes >= nt2Start and curMinutes <= nt2End
    else
        inNoTrade2 := curMinutes >= nt2Start or curMinutes <= nt2End


bool allowedTradeTime =
     activeTime and
     not inNoTrade1 and
     not inNoTrade2


// ============================================================================
// 04 - SWING DETECTION
// ============================================================================

groupSwing = "04 - Swing Detection"

leftBars = input.int(
     5,
     "Swing Strength - Left Bars",
     minval=1,
     group=groupSwing)

rightBars = input.int(
     5,
     "Swing Strength - Right Bars",
     minval=1,
     group=groupSwing)

minSwingSize = input.float(
     0.0,
     "Minimum Swing Size",
     minval=0,
     step=0.25,
     group=groupSwing)

minFibRange = input.float(
     30.0,
     "Minimum Fib Range",
     minval=0,
     step=0.25,
     group=groupSwing)

minBarsBetweenSwings = input.int(
     1,
     "Minimum Bars Between Swings",
     minval=1,
     group=groupSwing)

priceSource = input.string(
     "Wick",
     "Swing Price Source",
     options=["Wick", "Body"],
     group=groupSwing)


// ============================================================================
// 05 - FIB DIRECTION
// ============================================================================

groupDirection = "05 - Fib Direction"

fibDirection = input.string(
     "Follow Trend",
     "Fib Direction",
     options=[
         "Follow Trend",
         "Both Directions",
         "Bullish Only",
         "Bearish Only"
     ],
     group=groupDirection)

requireAlternatingSwings = input.bool(
     true,
     "Require Alternating Swings",
     group=groupDirection)


// ============================================================================
// 06 - FIB STRUCTURE
// ============================================================================

groupStructure = "06 - Fib Structure"

recalculateOnExtreme = input.bool(
     false,
     "Recalculate Fib On New Higher High / Lower Low",
     group=groupStructure)

barsToRight = input.int(
     20,
     "Bars To Extend Right",
     minval=1,
     maxval=500,
     group=groupStructure)


// ============================================================================
// 07 - FIB LEVELS
// ============================================================================

groupLevels = "07 - Fibonacci Levels"

show0 = input.bool(true, "0", group=groupLevels)
show025 = input.bool(true, "0.25", group=groupLevels)
show050 = input.bool(true, "0.5", group=groupLevels)
show0618 = input.bool(true, "0.618", group=groupLevels)
show0786 = input.bool(true, "0.786", group=groupLevels)
show0900 = input.bool(true, "0.9", group=groupLevels)
show1000 = input.bool(true, "1", group=groupLevels)


// ============================================================================
// 08 - FIB COLORS
// ============================================================================

groupColors = "08 - Fibonacci Colors"

color0 = input.color(color.black, "0 Color", group=groupColors)
color025 = input.color(color.black, "0.25 Color", group=groupColors)
color050 = input.color(color.black, "0.5 Color", group=groupColors)
color0618 = input.color(color.black, "0.618 Color", group=groupColors)
color0786 = input.color(color.black, "0.786 Color", group=groupColors)
color0900 = input.color(color.black, "0.9 Color", group=groupColors)
color1000 = input.color(color.black, "1 Color", group=groupColors)


// ============================================================================
// 09 - FIB APPEARANCE
// ============================================================================

groupAppearance = "09 - Fibonacci Appearance"

lineWidth = input.int(
     1,
     "Line Width",
     minval=1,
     maxval=4,
     group=groupAppearance)

lineStyleInput = input.string(
     "Solid",
     "Line Style",
     options=["Solid", "Dashed", "Dotted"],
     group=groupAppearance)

fibLineStyle =
     lineStyleInput == "Dashed" ? line.style_dashed :
     lineStyleInput == "Dotted" ? line.style_dotted :
     line.style_solid


// ============================================================================
// 10 - FIB LABELS
// ============================================================================

groupLabels = "10 - Fibonacci Labels"

showLabels = input.bool(
     true,
     "Show Labels",
     group=groupLabels)

labelSizeInput = input.string(
     "Small",
     "Label Size",
     options=["Tiny", "Small", "Normal", "Large", "Huge"],
     group=groupLabels)

labelStyleInput = input.string(
     "Label Right",
     "Label Style",
     options=[
         "Label Left",
         "Label Right",
         "Label Up",
         "Label Down",
         "None"
     ],
     group=groupLabels)

labelBackgroundColor = input.color(
     color.black,
     "Label Background",
     group=groupLabels)

labelTextColor = input.color(
     color.white,
     "Label Text",
     group=groupLabels)

labelSize =
     labelSizeInput == "Tiny" ? size.tiny :
     labelSizeInput == "Small" ? size.small :
     labelSizeInput == "Normal" ? size.normal :
     labelSizeInput == "Large" ? size.large :
     size.huge

labelStyle =
     labelStyleInput == "Label Left" ? label.style_label_left :
     labelStyleInput == "Label Right" ? label.style_label_right :
     labelStyleInput == "Label Up" ? label.style_label_up :
     labelStyleInput == "Label Down" ? label.style_label_down :
     label.style_none


// ============================================================================
// 11 - SIGNAL SETTINGS
// ============================================================================

groupSignals = "11 - Signal Settings"

enableSignals = input.bool(
     true,
     "Enable Buy / Sell Signals",
     group=groupSignals)

signalLevel = input.string(
     "0.618",
     "Signal Fibonacci Level",
     options=["0", "0.25", "0.5", "0.618", "0.786", "0.9", "1"],
     group=groupSignals)

buySignalColor = input.color(
     color.green,
     "Buy Signal Color",
     group=groupSignals)

sellSignalColor = input.color(
     color.red,
     "Sell Signal Color",
     group=groupSignals)

signalTextColor = input.color(
     color.white,
     "Signal Text Color",
     group=groupSignals)


// ============================================================================
// 12 - TP / SL FIB LEVELS
// ============================================================================

groupTPSLLevels = "12 - TP / SL Fibonacci Levels"

bullTPLevel = input.string(
     "0",
     "Bullish TP Level",
     options=["0", "0.25", "0.5", "0.618", "0.786", "0.9", "1"],
     group=groupTPSLLevels)

bullSLLevel = input.string(
     "1",
     "Bullish SL Level",
     options=["0", "0.25", "0.5", "0.618", "0.786", "0.9", "1"],
     group=groupTPSLLevels)

bearTPLevel = input.string(
     "0",
     "Bearish TP Level",
     options=["0", "0.25", "0.5", "0.618", "0.786", "0.9", "1"],
     group=groupTPSLLevels)

bearSLLevel = input.string(
     "1",
     "Bearish SL Level",
     options=["0", "0.25", "0.5", "0.618", "0.786", "0.9", "1"],
     group=groupTPSLLevels)


// ============================================================================
// 13 - MINIMUM DEPARTURE
// ============================================================================

groupDeparture = "13 - Minimum Departure Filter"

useDepartureFilter = input.bool(
     false,
     "Enable Minimum Departure Filter",
     group=groupDeparture)

departureValue = input.float(
     10.0,
     "Minimum Departure",
     minval=0,
     step=0.25,
     group=groupDeparture)

departureMode = input.string(
     "Points",
     "Departure Measurement",
     options=["Points", "Percent"],
     group=groupDeparture)


// ============================================================================
// 14 - CANDLE CONFIRMATION
// ============================================================================

groupCandle = "14 - Candle Confirmation"

useCandleConfirmation = input.bool(
     false,
     "Enable Candle Confirmation",
     group=groupCandle)

confirmationType = input.string(
     "Rejection Candle",
     "Confirmation Type",
     options=[
         "Touch Only",
         "Close Confirmation",
         "Rejection Candle",
         "Engulfing Candle"
     ],
     group=groupCandle)

minimumWickRatio = input.float(
     0.5,
     "Minimum Wick Ratio",
     minval=0,
     maxval=1,
     step=0.05,
     group=groupCandle)


// ============================================================================
// 15 - TREND FILTER
// ============================================================================

groupTrend = "15 - Trend Strength Filter"

useTrendFilter = input.bool(
     false,
     "Enable Trend Strength Filter",
     group=groupTrend)

trendMAType = input.string(
     "SMA",
     "Moving Average Type",
     options=["SMA", "EMA"],
     group=groupTrend)

trendLength = input.int(
     50,
     "Moving Average Length",
     minval=1,
     group=groupTrend)

trendSlopeBars = input.int(
     5,
     "Slope Lookback Bars",
     minval=1,
     group=groupTrend)

minimumSlope = input.float(
     0.0,
     "Minimum MA Slope",
     minval=0,
     step=0.01,
     group=groupTrend)

trendMA =
     trendMAType == "EMA"
     ? ta.ema(close, trendLength)
     : ta.sma(close, trendLength)

trendSlope =
     trendMA - trendMA[trendSlopeBars]


// ============================================================================
// 16 - CONSOLIDATION FILTER
// ============================================================================

groupConsolidation = "16 - Consolidation Filter"

useConsolidationFilter = input.bool(
     false,
     "Enable Consolidation Filter",
     group=groupConsolidation)

consolidationLength = input.int(
     20,
     "Consolidation Lookback",
     minval=2,
     group=groupConsolidation)

consolidationATRLength = input.int(
     14,
     "Consolidation ATR Length",
     minval=1,
     group=groupConsolidation)

maxConsolidationATR = input.float(
     3.0,
     "Maximum Range × ATR",
     minval=0.1,
     step=0.1,
     group=groupConsolidation)

consolidationATR = ta.atr(consolidationATRLength)

recentRange =
     ta.highest(high, consolidationLength) -
     ta.lowest(low, consolidationLength)

isConsolidating =
     recentRange <= consolidationATR * maxConsolidationATR


// ============================================================================
// 17 - TP / SL BOXES
// ============================================================================

groupTPSL = "17 - TP / SL Boxes"

showTPSL = input.bool(
     true,
     "Show TP / SL Boxes",
     group=groupTPSL)

tpColor = input.color(
     color.green,
     "TP Box Color",
     group=groupTPSL)

slColor = input.color(
     color.red,
     "SL Box Color",
     group=groupTPSL)

tpTransparency = input.int(
     85,
     "TP Box Transparency",
     minval=0,
     maxval=100,
     group=groupTPSL)

slTransparency = input.int(
     85,
     "SL Box Transparency",
     minval=0,
     maxval=100,
     group=groupTPSL)

showTPLabels = input.bool(
     true,
     "Show TP / SL Labels",
     group=groupTPSL)


// ============================================================================
// 18 - EARLY DRAWDOWN EXIT
// ============================================================================

groupEarlyDD = "18 - Early Drawdown Exit"

enableEarlyDrawdown = input.bool(
     false,
     "Enable Early Drawdown Exit",
     group=groupEarlyDD)

earlyDrawdownBars = input.int(
     3,
     "Bars To Check",
     minval=1,
     maxval=100,
     group=groupEarlyDD)

earlyDrawdownPercent = input.float(
     50.0,
     "Drawdown To Trigger (%)",
     minval=0,
     maxval=100,
     step=1,
     group=groupEarlyDD)


// ============================================================================
// LEVEL CONVERSION
// ============================================================================

float selectedSignalLevel = switch signalLevel
    "0" => 0.0
    "0.25" => 0.25
    "0.5" => 0.50
    "0.618" => 0.618
    "0.786" => 0.786
    "0.9" => 0.90
    => 1.0

float bullTPRatio = switch bullTPLevel
    "0" => 0.0
    "0.25" => 0.25
    "0.5" => 0.50
    "0.618" => 0.618
    "0.786" => 0.786
    "0.9" => 0.90
    => 1.0

float bullSLRatio = switch bullSLLevel
    "0" => 0.0
    "0.25" => 0.25
    "0.5" => 0.50
    "0.618" => 0.618
    "0.786" => 0.786
    "0.9" => 0.90
    => 1.0

float bearTPRatio = switch bearTPLevel
    "0" => 0.0
    "0.25" => 0.25
    "0.5" => 0.50
    "0.618" => 0.618
    "0.786" => 0.786
    "0.9" => 0.90
    => 1.0

float bearSLRatio = switch bearSLLevel
    "0" => 0.0
    "0.25" => 0.25
    "0.5" => 0.50
    "0.618" => 0.618
    "0.786" => 0.786
    "0.9" => 0.90
    => 1.0


// ============================================================================
// SWING PRICE SOURCE
// ============================================================================

float swingHighSource =
     priceSource == "Wick"
     ? high
     : math.max(open, close)

float swingLowSource =
     priceSource == "Wick"
     ? low
     : math.min(open, close)


// ============================================================================
// PIVOTS
// ============================================================================

float pivotHigh = ta.pivothigh(
     swingHighSource,
     leftBars,
     rightBars)

float pivotLow = ta.pivotlow(
     swingLowSource,
     leftBars,
     rightBars)


// ============================================================================
// SWING MEMORY
// ============================================================================

var float lastHigh = na
var int lastHighBar = na

var float lastLow = na
var int lastLowBar = na

var int lastSwingType = 0

// 1 = bullish low -> high
// -1 = bearish high -> low
var int currentFibDirection = 0

var float currentFibLow = na
var float currentFibHigh = na

var int currentFibLowBar = na
var int currentFibHighBar = na

var bool currentFibHasSignaled = false
var bool currentFibLocked = false

var int currentFibStartTime = na
var int currentFibEndTime = na


// ============================================================================
// OBJECT STORAGE
// ============================================================================

var line line0 = na
var line line025 = na
var line line050 = na
var line line0618 = na
var line line0786 = na
var line line0900 = na
var line line1000 = na

var label label0 = na
var label label025 = na
var label label050 = na
var label label0618 = na
var label label0786 = na
var label label0900 = na
var label label1000 = na


// ============================================================================
// TRADE STATE
// ============================================================================

var float activeTP = na
var float activeSL = na

var int tradeEntryBar = na
var float earlyDrawdownPrice = na

var box activeTPBox = na
var box activeSLBox = na


// ============================================================================
// DELETE FIB OBJECTS
// ============================================================================

deleteFibObjects() =>
    if not na(line0)
        line.delete(line0)

    if not na(line025)
        line.delete(line025)

    if not na(line050)
        line.delete(line050)

    if not na(line0618)
        line.delete(line0618)

    if not na(line0786)
        line.delete(line0786)

    if not na(line0900)
        line.delete(line0900)

    if not na(line1000)
        line.delete(line1000)

    if not na(label0)
        label.delete(label0)

    if not na(label025)
        label.delete(label025)

    if not na(label050)
        label.delete(label050)

    if not na(label0618)
        label.delete(label0618)

    if not na(label0786)
        label.delete(label0786)

    if not na(label0900)
        label.delete(label0900)

    if not na(label1000)
        label.delete(label1000)


// ============================================================================
// DIRECTION FILTER
// ============================================================================

directionAllowed(int direction) =>
    bool result = false

    if fibDirection == "Both Directions"
        result := true

    else if fibDirection == "Bullish Only"
        result := direction == 1

    else if fibDirection == "Bearish Only"
        result := direction == -1

    else
        // Follow Trend
        //
        // Bullish Fib requires:
        // current high > previous high AND
        // current low > previous low
        //
        // Bearish Fib requires:
        // current high < previous high AND
        // current low < previous low

        result := true

    result


// ============================================================================
// PROCESS NEW HIGH
// ============================================================================

if not na(pivotHigh)

    int newHighBar = bar_index - rightBars
    float newHigh = pivotHigh

    bool enoughBars =
         na(lastLowBar) or
         math.abs(newHighBar - lastLowBar) >= minBarsBetweenSwings

    bool enoughDistance =
         na(lastLow) or
         math.abs(newHigh - lastLow) >= minSwingSize

    bool alternatingOK =
         not requireAlternatingSwings or
         lastSwingType != 1

    if enoughBars and enoughDistance and alternatingOK

        // --------------------------------------------------------------------
        // A HIGH AFTER A LOW ALWAYS DEFINES LOW -> HIGH
        // THEREFORE THIS CAN ONLY BE BULLISH.
        // --------------------------------------------------------------------

        if not na(lastLow)

            float proposedRange =
                 math.abs(newHigh - lastLow)

            if proposedRange >= minFibRange

                bool trendOK = true

                if fibDirection == "Follow Trend"

                    // We only allow bullish if this high is higher than
                    // the previous high AND the low is higher than the
                    // previous low.

                    if not na(lastHigh) and not na(lastLow)

                        trendOK :=
                             newHigh > lastHigh

                if directionAllowed(1) and trendOK

                    if strategy.position_size == 0

                        deleteFibObjects()

                        currentFibDirection := 1

                        currentFibLow := lastLow
                        currentFibLowBar := lastLowBar

                        currentFibHigh := newHigh
                        currentFibHighBar := newHighBar

                        currentFibHasSignaled := false
                        currentFibLocked := false

                        currentFibStartTime :=
                             time -
                             timeframe.in_seconds() *
                             1000 *
                             (bar_index - newHighBar)

                        currentFibEndTime := na

        lastHigh := newHigh
        lastHighBar := newHighBar
        lastSwingType := 1


// ============================================================================
// PROCESS NEW LOW
// ============================================================================

if not na(pivotLow)

    int newLowBar = bar_index - rightBars
    float newLow = pivotLow

    bool enoughBars =
         na(lastHighBar) or
         math.abs(newLowBar - lastHighBar) >= minBarsBetweenSwings

    bool enoughDistance =
         na(lastHigh) or
         math.abs(newLow - lastHigh) >= minSwingSize

    bool alternatingOK =
         not requireAlternatingSwings or
         lastSwingType != -1

    if enoughBars and enoughDistance and alternatingOK

        // --------------------------------------------------------------------
        // A LOW AFTER A HIGH ALWAYS DEFINES HIGH -> LOW
        // THEREFORE THIS CAN ONLY BE BEARISH.
        // --------------------------------------------------------------------

        if not na(lastHigh)

            float proposedRange =
                 math.abs(lastHigh - newLow)

            if proposedRange >= minFibRange

                bool trendOK = true

                if fibDirection == "Follow Trend"

                    if not na(lastLow) and not na(lastHigh)

                        trendOK :=
                             newLow < lastLow

                if directionAllowed(-1) and trendOK

                    if strategy.position_size == 0

                        deleteFibObjects()

                        currentFibDirection := -1

                        currentFibLow := newLow
                        currentFibLowBar := newLowBar

                        currentFibHigh := lastHigh
                        currentFibHighBar := lastHighBar

                        currentFibHasSignaled := false
                        currentFibLocked := false

                        currentFibStartTime :=
                             time -
                             timeframe.in_seconds() *
                             1000 *
                             (bar_index - newLowBar)

                        currentFibEndTime := na

        lastLow := newLow
        lastLowBar := newLowBar
        lastSwingType := -1


// ============================================================================
// EXTREME RECALCULATION
// ============================================================================
//
// IMPORTANT:
// This NEVER changes currentFibDirection.
//
// Bullish stays bullish.
// Bearish stays bearish.
//
// Only the appropriate endpoint is moved.
//
// ============================================================================

if recalculateOnExtreme and not currentFibLocked and strategy.position_size == 0

    if currentFibDirection == 1

        // Bullish Fib = LOW -> HIGH.
        // New higher high changes the HIGH endpoint only.

        if high > currentFibHigh

            currentFibHigh := high
            currentFibHighBar := bar_index

            currentFibHasSignaled := false


    else if currentFibDirection == -1

        // Bearish Fib = HIGH -> LOW.
        // New lower low changes the LOW endpoint only.

        if low < currentFibLow

            currentFibLow := low
            currentFibLowBar := bar_index

            currentFibHasSignaled := false


// ============================================================================
// CURRENT FIB RANGE
// ============================================================================

float fibRange = na

if currentFibDirection != 0

    fibRange :=
         math.abs(
             currentFibHigh -
             currentFibLow)


// ============================================================================
// FIB PRICES
// ============================================================================
//
// BULLISH:
// 0   = HIGH
// 1   = LOW
//
// BEARISH:
// 0   = LOW
// 1   = HIGH
//
// This is intentionally directional.
// ============================================================================

float level0 = na
float level025 = na
float level050 = na
float level0618 = na
float level0786 = na
float level0900 = na
float level1000 = na

if currentFibDirection == 1

    // LOW -> HIGH

    level0 :=
         currentFibHigh

    level025 :=
         currentFibHigh -
         fibRange * 0.25

    level050 :=
         currentFibHigh -
         fibRange * 0.50

    level0618 :=
         currentFibHigh -
         fibRange * 0.618

    level0786 :=
         currentFibHigh -
         fibRange * 0.786

    level0900 :=
         currentFibHigh -
         fibRange * 0.90

    level1000 :=
         currentFibLow


else if currentFibDirection == -1

    // HIGH -> LOW

    level0 :=
         currentFibLow

    level025 :=
         currentFibLow +
         fibRange * 0.25

    level050 :=
         currentFibLow +
         fibRange * 0.50

    level0618 :=
         currentFibLow +
         fibRange * 0.618

    level0786 :=
         currentFibLow +
         fibRange * 0.786

    level0900 :=
         currentFibLow +
         fibRange * 0.90

    level1000 :=
         currentFibHigh


// ============================================================================
// SELECT SIGNAL PRICE
// ============================================================================

float signalPrice = na

if currentFibDirection != 0

    signalPrice :=
         selectedSignalLevel == 0.0 ? level0 :
         selectedSignalLevel == 0.25 ? level025 :
         selectedSignalLevel == 0.50 ? level050 :
         selectedSignalLevel == 0.618 ? level0618 :
         selectedSignalLevel == 0.786 ? level0786 :
         selectedSignalLevel == 0.90 ? level0900 :
         level1000


// ============================================================================
// SELECT TP / SL
// ============================================================================

float calculatedTP = na
float calculatedSL = na

if currentFibDirection == 1

    calculatedTP :=
         bullTPLevel == "0" ? level0 :
         bullTPLevel == "0.25" ? level025 :
         bullTPLevel == "0.5" ? level050 :
         bullTPLevel == "0.618" ? level0618 :
         bullTPLevel == "0.786" ? level0786 :
         bullTPLevel == "0.9" ? level0900 :
         level1000

    calculatedSL :=
         bullSLLevel == "0" ? level0 :
         bullSLLevel == "0.25" ? level025 :
         bullSLLevel == "0.5" ? level050 :
         bullSLLevel == "0.618" ? level0618 :
         bullSLLevel == "0.786" ? level0786 :
         bullSLLevel == "0.9" ? level0900 :
         level1000


else if currentFibDirection == -1

    calculatedTP :=
         bearTPLevel == "0" ? level0 :
         bearTPLevel == "0.25" ? level025 :
         bearTPLevel == "0.5" ? level050 :
         bearTPLevel == "0.618" ? level0618 :
         bearTPLevel == "0.786" ? level0786 :
         bearTPLevel == "0.9" ? level0900 :
         level1000

    calculatedSL :=
         bearSLLevel == "0" ? level0 :
         bearSLLevel == "0.25" ? level025 :
         bearSLLevel == "0.5" ? level050 :
         bearSLLevel == "0.618" ? level0618 :
         bearSLLevel == "0.786" ? level0786 :
         bearSLLevel == "0.9" ? level0900 :
         level1000


// ============================================================================
// TP / SL SANITY CHECK
// ============================================================================
//
// Prevents the strategy from accidentally placing:
// BUY  TP below entry / SL above entry
// SELL TP above entry / SL below entry
//
// If the selected levels don't make directional sense, no trade is taken.
// ============================================================================

bool validBullTPSL = false
bool validBearTPSL = false

if currentFibDirection == 1

    validBullTPSL :=
         calculatedTP > signalPrice and
         calculatedSL < signalPrice

else if currentFibDirection == -1

    validBearTPSL :=
         calculatedTP < signalPrice and
         calculatedSL > signalPrice


// ============================================================================
// DEPARTURE FILTER
// ============================================================================

bool departureOK = true

if useDepartureFilter and not na(signalPrice)

    if currentFibDirection == 1

        float requiredDeparture =
             departureMode == "Points"
             ? departureValue
             : signalPrice * departureValue / 100.0

        departureOK :=
             high - signalPrice >= requiredDeparture

    else if currentFibDirection == -1

        float requiredDeparture =
             departureMode == "Points"
             ? departureValue
             : signalPrice * departureValue / 100.0

        departureOK :=
             signalPrice - low >= requiredDeparture


// ============================================================================
// CANDLE CONFIRMATION
// ============================================================================

bool candleOK = true

if useCandleConfirmation

    if confirmationType == "Touch Only"

        candleOK := true

    else if confirmationType == "Close Confirmation"

        if currentFibDirection == 1

            candleOK :=
                 low <= signalPrice and
                 close > signalPrice

        else if currentFibDirection == -1

            candleOK :=
                 high >= signalPrice and
                 close < signalPrice

    else if confirmationType == "Rejection Candle"

        float candleRange = high - low

        float upperWick =
             high - math.max(open, close)

        float lowerWick =
             math.min(open, close) - low

        if candleRange > 0

            if currentFibDirection == 1

                candleOK :=
                     low <= signalPrice and
                     close > signalPrice and
                     lowerWick / candleRange >= minimumWickRatio

            else if currentFibDirection == -1

                candleOK :=
                     high >= signalPrice and
                     close < signalPrice and
                     upperWick / candleRange >= minimumWickRatio

    else if confirmationType == "Engulfing Candle"

        if currentFibDirection == 1

            candleOK :=
                 close[1] < open[1] and
                 close > open and
                 open <= close[1] and
                 close >= open[1]

        else if currentFibDirection == -1

            candleOK :=
                 close[1] > open[1] and
                 close < open and
                 open >= close[1] and
                 close <= open[1]


// ============================================================================
// TREND FILTER
// ============================================================================

bool trendFilterOK = true

if useTrendFilter

    if currentFibDirection == 1

        trendFilterOK :=
             close > trendMA and
             trendSlope >= minimumSlope

    else if currentFibDirection == -1

        trendFilterOK :=
             close < trendMA and
             trendSlope <= -minimumSlope


// ============================================================================
// CONSOLIDATION FILTER
// ============================================================================

bool consolidationOK = true

if useConsolidationFilter

    consolidationOK :=
         not isConsolidating


// ============================================================================
// SIGNAL CONDITIONS
// ============================================================================
//
// VERY IMPORTANT:
//
// Bullish Fib:
// Previous price MUST be above signal.
// Current candle must touch signal.
// Therefore it can only create BUY.
//
// Bearish Fib:
// Previous price MUST be below signal.
// Current candle must touch signal.
// Therefore it can only create SELL.
//
// ============================================================================

bool buySignal = false
bool sellSignal = false

bool commonSignalConditions =
     enableSignals and
     allowedTradeTime and
     strategy.position_size == 0 and
     not currentFibLocked and
     not currentFibHasSignaled and
     not na(signalPrice) and
     departureOK and
     candleOK and
     trendFilterOK and
     consolidationOK


// ============================================================================
// BULLISH SIGNAL
// ============================================================================

if commonSignalConditions and currentFibDirection == 1

    bool priceCameFromAbove =
         close[1] > signalPrice

    bool touchedLevel =
         low <= signalPrice and
         high >= signalPrice

    if priceCameFromAbove and touchedLevel and validBullTPSL

        buySignal := true

        currentFibHasSignaled := true


// ============================================================================
// BEARISH SIGNAL
// ============================================================================

if commonSignalConditions and currentFibDirection == -1

    bool priceCameFromBelow =
         close[1] < signalPrice

    bool touchedLevel =
         high >= signalPrice and
         low <= signalPrice

    if priceCameFromBelow and touchedLevel and validBearTPSL

        sellSignal := true

        currentFibHasSignaled := true


// ============================================================================
// ENTER BUY
// ============================================================================

if buySignal

    activeTP := calculatedTP
    activeSL := calculatedSL

    strategy.entry(
         "BUY",
         strategy.long)


// ============================================================================
// ENTER SELL
// ============================================================================

if sellSignal

    activeTP := calculatedTP
    activeSL := calculatedSL

    strategy.entry(
         "SELL",
         strategy.short)


// ============================================================================
// DETECT TRADE ENTRY
// ============================================================================

bool tradeEntered =
     strategy.position_size != 0 and
     strategy.position_size[1] == 0

if tradeEntered

    tradeEntryBar := bar_index

    if strategy.position_size > 0

        earlyDrawdownPrice :=
             strategy.position_avg_price -
             (
                 (strategy.position_avg_price - activeSL) *
                 earlyDrawdownPercent /
                 100.0
             )

    else

        earlyDrawdownPrice :=
             strategy.position_avg_price +
             (
                 (activeSL - strategy.position_avg_price) *
                 earlyDrawdownPercent /
                 100.0
             )


// ============================================================================
// EARLY DRAWDOWN
// ============================================================================

bool earlyDDActive =
     enableEarlyDrawdown and
     strategy.position_size != 0 and
     not na(tradeEntryBar) and
     not na(earlyDrawdownPrice) and
     bar_index - tradeEntryBar < earlyDrawdownBars


// ============================================================================
// LONG EXIT
// ============================================================================

if strategy.position_size > 0

    float longStop = activeSL

    if earlyDDActive

        longStop :=
             math.max(
                 activeSL,
                 earlyDrawdownPrice)

    strategy.exit(
         "BUY EXIT",
         from_entry="BUY",
         limit=activeTP,
         stop=longStop)


// ============================================================================
// SHORT EXIT
// ============================================================================

if strategy.position_size < 0

    float shortStop = activeSL

    if earlyDDActive

        shortStop :=
             math.min(
                 activeSL,
                 earlyDrawdownPrice)

    strategy.exit(
         "SELL EXIT",
         from_entry="SELL",
         limit=activeTP,
         stop=shortStop)


// ============================================================================
// CREATE TP / SL BOXES
// ============================================================================

if tradeEntered and showTPSL

    if strategy.position_size > 0

        activeTPBox := box.new(
             left=time,
             top=activeTP,
             right=time,
             bottom=strategy.position_avg_price,
             xloc=xloc.bar_time,
             bgcolor=color.new(tpColor, tpTransparency),
             border_color=tpColor)

        activeSLBox := box.new(
             left=time,
             top=strategy.position_avg_price,
             right=time,
             bottom=activeSL,
             xloc=xloc.bar_time,
             bgcolor=color.new(slColor, slTransparency),
             border_color=slColor)

    else if strategy.position_size < 0

        activeTPBox := box.new(
             left=time,
             top=strategy.position_avg_price,
             right=time,
             bottom=activeTP,
             xloc=xloc.bar_time,
             bgcolor=color.new(tpColor, tpTransparency),
             border_color=tpColor)

        activeSLBox := box.new(
             left=time,
             top=activeSL,
             right=time,
             bottom=strategy.position_avg_price,
             xloc=xloc.bar_time,
             bgcolor=color.new(slColor, slTransparency),
             border_color=slColor)


// ============================================================================
// EXTEND TP / SL BOXES
// ============================================================================

if strategy.position_size != 0

    if not na(activeTPBox)
        box.set_right(activeTPBox, time)

    if not na(activeSLBox)
        box.set_right(activeSLBox, time)


// ============================================================================
// TRADE EXIT
// ============================================================================

bool tradeExited =
     strategy.position_size == 0 and
     strategy.position_size[1] != 0

if tradeExited

    // Stop Fib exactly where the trade ended.
    currentFibLocked := true
    currentFibEndTime := time

    if not na(activeTPBox)

        box.set_right(
             activeTPBox,
             time)

    if not na(activeSLBox)

        box.set_right(
             activeSLBox,
             time)

    if showTPLabels

        if not na(activeTP)

            label.new(
                 time,
                 activeTP,
                 "TP",
                 xloc=xloc.bar_time,
                 style=label.style_label_left,
                 color=tpColor,
                 textcolor=color.white,
                 size=size.small)

        if not na(activeSL)

            label.new(
                 time,
                 activeSL,
                 "SL",
                 xloc=xloc.bar_time,
                 style=label.style_label_left,
                 color=slColor,
                 textcolor=color.white,
                 size=size.small)

    activeTPBox := na
    activeSLBox := na

    activeTP := na
    activeSL := na

    tradeEntryBar := na
    earlyDrawdownPrice := na


// ============================================================================
// FIB DRAWING
// ============================================================================

bool validFib =
     currentFibDirection != 0 and
     not na(currentFibLow) and
     not na(currentFibHigh) and
     not na(currentFibStartTime) and
     not na(fibRange) and
     fibRange >= minFibRange

if validFib

    int secondsPerBar =
         timeframe.in_seconds()

    int rightTime =
         currentFibLocked
         ? currentFibEndTime
         : time + secondsPerBar * 1000 * barsToRight

    // ------------------------------------------------------------------------
    // 0
    // ------------------------------------------------------------------------

    if show0

        if na(line0)

            line0 := line.new(
                 currentFibStartTime,
                 level0,
                 rightTime,
                 level0,
                 xloc=xloc.bar_time,
                 color=color0,
                 style=fibLineStyle,
                 width=lineWidth)

        else

            line.set_xy1(
                 line0,
                 currentFibStartTime,
                 level0)

            line.set_xy2(
                 line0,
                 rightTime,
                 level0)

        if showLabels and labelStyleInput != "None"

            if na(label0)

                label0 := label.new(
                     rightTime,
                     level0,
                     "0",
                     xloc=xloc.bar_time,
                     style=labelStyle,
                     color=labelBackgroundColor,
                     textcolor=labelTextColor,
                     size=labelSize)

            else

                label.set_xy(
                     label0,
                     rightTime,
                     level0)


    // ------------------------------------------------------------------------
    // 0.25
    // ------------------------------------------------------------------------

    if show025

        if na(line025)

            line025 := line.new(
                 currentFibStartTime,
                 level025,
                 rightTime,
                 level025,
                 xloc=xloc.bar_time,
                 color=color025,
                 style=fibLineStyle,
                 width=lineWidth)

        else

            line.set_xy1(
                 line025,
                 currentFibStartTime,
                 level025)

            line.set_xy2(
                 line025,
                 rightTime,
                 level025)

        if showLabels and labelStyleInput != "None"

            if na(label025)

                label025 := label.new(
                     rightTime,
                     level025,
                     "0.25",
                     xloc=xloc.bar_time,
                     style=labelStyle,
                     color=labelBackgroundColor,
                     textcolor=labelTextColor,
                     size=labelSize)

            else

                label.set_xy(
                     label025,
                     rightTime,
                     level025)


    // ------------------------------------------------------------------------
    // 0.5
    // ------------------------------------------------------------------------

    if show050

        if na(line050)

            line050 := line.new(
                 currentFibStartTime,
                 level050,
                 rightTime,
                 level050,
                 xloc=xloc.bar_time,
                 color=color050,
                 style=fibLineStyle,
                 width=lineWidth)

        else

            line.set_xy1(
                 line050,
                 currentFibStartTime,
                 level050)

            line.set_xy2(
                 line050,
                 rightTime,
                 level050)

        if showLabels and labelStyleInput != "None"

            if na(label050)

                label050 := label.new(
                     rightTime,
                     level050,
                     "0.5",
                     xloc=xloc.bar_time,
                     style=labelStyle,
                     color=labelBackgroundColor,
                     textcolor=labelTextColor,
                     size=labelSize)

            else

                label.set_xy(
                     label050,
                     rightTime,
                     level050)


    // ------------------------------------------------------------------------
    // 0.618
    // ------------------------------------------------------------------------

    if show0618

        if na(line0618)

            line0618 := line.new(
                 currentFibStartTime,
                 level0618,
                 rightTime,
                 level0618,
                 xloc=xloc.bar_time,
                 color=color0618,
                 style=fibLineStyle,
                 width=lineWidth)

        else

            line.set_xy1(
                 line0618,
                 currentFibStartTime,
                 level0618)

            line.set_xy2(
                 line0618,
                 rightTime,
                 level0618)

        if showLabels and labelStyleInput != "None"

            if na(label0618)

                label0618 := label.new(
                     rightTime,
                     level0618,
                     "0.618",
                     xloc=xloc.bar_time,
                     style=labelStyle,
                     color=labelBackgroundColor,
                     textcolor=labelTextColor,
                     size=labelSize)

            else

                label.set_xy(
                     label0618,
                     rightTime,
                     level0618)


    // ------------------------------------------------------------------------
    // 0.786
    // ------------------------------------------------------------------------

    if show0786

        if na(line0786)

            line0786 := line.new(
                 currentFibStartTime,
                 level0786,
                 rightTime,
                 level0786,
                 xloc=xloc.bar_time,
                 color=color0786,
                 style=fibLineStyle,
                 width=lineWidth)

        else

            line.set_xy1(
                 line0786,
                 currentFibStartTime,
                 level0786)

            line.set_xy2(
                 line0786,
                 rightTime,
                 level0786)

        if showLabels and labelStyleInput != "None"

            if na(label0786)

                label0786 := label.new(
                     rightTime,
                     level0786,
                     "0.786",
                     xloc=xloc.bar_time,
                     style=labelStyle,
                     color=labelBackgroundColor,
                     textcolor=labelTextColor,
                     size=labelSize)

            else

                label.set_xy(
                     label0786,
                     rightTime,
                     level0786)


    // ------------------------------------------------------------------------
    // 0.9
    // ------------------------------------------------------------------------

    if show0900

        if na(line0900)

            line0900 := line.new(
                 currentFibStartTime,
                 level0900,
                 rightTime,
                 level0900,
                 xloc=xloc.bar_time,
                 color=color0900,
                 style=fibLineStyle,
                 width=lineWidth)

        else

            line.set_xy1(
                 line0900,
                 currentFibStartTime,
                 level0900)

            line.set_xy2(
                 line0900,
                 rightTime,
                 level0900)

        if showLabels and labelStyleInput != "None"

            if na(label0900)

                label0900 := label.new(
                     rightTime,
                     level0900,
                     "0.9",
                     xloc=xloc.bar_time,
                     style=labelStyle,
                     color=labelBackgroundColor,
                     textcolor=labelTextColor,
                     size=labelSize)

            else

                label.set_xy(
                     label0900,
                     rightTime,
                     level0900)


    // ------------------------------------------------------------------------
    // 1
    // ------------------------------------------------------------------------

    if show1000

        if na(line1000)

            line1000 := line.new(
                 currentFibStartTime,
                 level1000,
                 rightTime,
                 level1000,
                 xloc=xloc.bar_time,
                 color=color1000,
                 style=fibLineStyle,
                 width=lineWidth)

        else

            line.set_xy1(
                 line1000,
                 currentFibStartTime,
                 level1000)

            line.set_xy2(
                 line1000,
                 rightTime,
                 level1000)

        if showLabels and labelStyleInput != "None"

            if na(label1000)

                label1000 := label.new(
                     rightTime,
                     level1000,
                     "1",
                     xloc=xloc.bar_time,
                     style=labelStyle,
                     color=labelBackgroundColor,
                     textcolor=labelTextColor,
                     size=labelSize)

            else

                label.set_xy(
                     label1000,
                     rightTime,
                     level1000)


// ============================================================================
// SIGNAL MARKERS
// ============================================================================

plotshape(
     buySignal,
     title="BUY",
     style=shape.labelup,
     location=location.belowbar,
     color=buySignalColor,
     text="BUY",
     textcolor=signalTextColor,
     size=size.small)

plotshape(
     sellSignal,
     title="SELL",
     style=shape.labeldown,
     location=location.abovebar,
     color=sellSignalColor,
     text="SELL",
     textcolor=signalTextColor,
     size=size.small)


// ============================================================================
// TREND MA
// ============================================================================

plot(
     useTrendFilter ? trendMA : na,
     title="Trend MA",
     color=color.blue,
     linewidth=1)


// ============================================================================
// ALERTS
// ============================================================================

alertcondition(
     buySignal,
     title="Bullish Fib Buy",
     message="Bullish Fibonacci Buy Signal")

alertcondition(
     sellSignal,
     title="Bearish Fib Sell",
     message="Bearish Fibonacci Sell Signal")