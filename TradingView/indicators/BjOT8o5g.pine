//@version=6
indicator("Erken Sinyal Kompozit (CDV + CRS)", overlay=false)

// -----------------------------
// 1. VERİLER
// -----------------------------
O = open
H = high
L = low
C = close
V = volume

xu_close = request.security("XU100", timeframe.period, close)

// -----------------------------
// 2. CDV HESAPLAMA
// -----------------------------
tw          = H - math.max(O, C)
bw          = math.min(O, C) - L
body        = math.abs(C - O)
totalRange  = tw + bw + body
condExtra   = C >= O ? (2 * body) : 0
rate        = totalRange > 0 ? 0.5 * (tw + bw + condExtra) / totalRange : 0.5
deltaUp     = V * rate
deltaDown   = V * (1 - rate)
anlikDelta  = C >= O ? deltaUp : -deltaDown

var float cdv = 0.0
cdv := cdv + anlikDelta

// -----------------------------
// 3. CRS
// -----------------------------
ratio = xu_close > 0 ? C / xu_close : 0

// -----------------------------
// 4. NORMALİZASYON
// -----------------------------
Period = 200

hh_cdv = ta.highest(cdv, Period)
ll_cdv = ta.lowest(cdv, Period)
hh_crs = ta.highest(ratio, Period)
ll_crs = ta.lowest(ratio, Period)

cdv_norm = hh_cdv != ll_cdv ? ((cdv - ll_cdv) / (hh_cdv - ll_cdv)) * 50 : 0.0
crs_norm = hh_crs != ll_crs ? ((ratio - ll_crs) / (hh_crs - ll_crs)) * 50 : 0.0

kompozit_val = bar_index < Period ? 0.0 : cdv_norm + crs_norm

// -----------------------------
// 5. SİNYALLER — ISINMA TAMPONU İLE
// -----------------------------
kompozit_ma = ta.ema(kompozit_val, 5)

warmup_buffer  = input.int(30, "Ek Isınma Periyodu (bar)", minval=0, group="Pine Screener")
yeterli_veri   = bar_index >= (Period + warmup_buffer)

dip_sinyal       = yeterli_veri and ta.crossover(kompozit_ma, ta.lowest(kompozit_ma[1], 20))
threshold_sinyal = yeterli_veri and ta.crossover(kompozit_ma, 30)
momentum_sinyal  = yeterli_veri and ta.crossover(kompozit_ma, ta.ema(kompozit_ma, 10))

esleseme_penceresi = input.int(3, "Birleşik Sinyal Eşleşme Penceresi (bar)", minval=1, maxval=20, group="Sinyal Ayarları")

barsSinceDip = ta.barssince(dip_sinyal)
barsSinceThr = ta.barssince(threshold_sinyal)

birlesik_sinyal = (threshold_sinyal and not na(barsSinceDip) and barsSinceDip <= esleseme_penceresi) or
                   (dip_sinyal and not na(barsSinceThr) and barsSinceThr <= esleseme_penceresi)

// -----------------------------
// 6. PINE SCREENER — SON X BARDA BİRLEŞİK SİNYAL
// -----------------------------
lookbackX = input.int(10, "Son X Bar (Birleşik Sinyal Tarama)", minval=1, maxval=500, group="Pine Screener")

son_X_barda_birlesik = ta.highest(birlesik_sinyal ? 1.0 : 0.0, lookbackX) == 1.0

plot(son_X_barda_birlesik ? 1 : 0, title="SCREENER: Birleşik Sinyal (Son X Bar)", display=display.data_window)

barsSinceBirlesik = ta.barssince(birlesik_sinyal)
plot(na(barsSinceBirlesik) ? -1 : barsSinceBirlesik, title="SCREENER: Birleşik Sinyal - Kaç Bar Önce", display=display.data_window)

// Sembolün yeterli geçmişe sahip olup olmadığını gösteren ek sütun — tarama sonuçlarını temizlemek için kullanılabilir
plot(yeterli_veri ? 1 : 0, title="SCREENER: Yeterli Geçmiş Veri Var", display=display.data_window)

// -----------------------------
// 7. ÇİZİMLER
// -----------------------------
plot(kompozit_ma, "Kompozit EMA", color=color.aqua, linewidth=2)
plot(50, "Orta Seviye", color=color.gray)
plot(30, "Dip Bölgesi", color=color.red)

plotshape(dip_sinyal ? 31 : na,
     title="Dipten Dönüş", style=shape.circle,
     location=location.absolute, color=color.green, size=size.tiny)

plotshape(threshold_sinyal ? 34 : na,
     title="30 Üstü", style=shape.triangleup,
     location=location.absolute, color=color.yellow, size=size.tiny)

plotshape(momentum_sinyal ? 37 : na,
     title="Momentum Artışı", style=shape.diamond,
     location=location.absolute, color=color.blue, size=size.tiny)

plotshape(birlesik_sinyal ? 41 : na,
     title="Birleşik Sinyal (Dip + 30 Üstü)", style=shape.labelup,
     location=location.absolute, color=color.orange, size=size.small,
     text="★", textcolor=color.white)

// -----------------------------
// 8. ALARMLAR
// -----------------------------
alertcondition(dip_sinyal,       title="Dipten Dönüş",              message="{{ticker}}: Dipten Dönüş sinyali oluştu")
alertcondition(threshold_sinyal, title="30 Üstü",                    message="{{ticker}}: Kompozit 30 seviyesini yukarı kırdı")
alertcondition(momentum_sinyal,  title="Momentum Artışı",            message="{{ticker}}: Momentum ivmelenme sinyali oluştu")
alertcondition(birlesik_sinyal,  title="Birleşik Sinyal (Dip+30 Üstü)", message="{{ticker}}: Dipten dönüş VE 30 üstü sinyali birlikte oluştu")