//@version=6
indicator("TWB DCA Tool - 5-Line", overlay=true)

// 1. Identification and Setup Name (Default text changed to "Gold")
setup_name  = input.string("Gold", title="🏷️ Custom Setup Label", tooltip="Type a unique name here so you can identify this specific bracket inside your Object Tree.")

// 2. Direction and Entry Level Inputs (Renamed to Buy In 1 and Buy In 5 for absolute clarity)
trade_dir   = input.string("Buy", title="Trade Direction", options=["Buy", "Sell"])
entry_one   = input.price(3290.0, title="Buy In 1 / Sell In 1 Price", tooltip="This is your very first entry level at the outer boundary of your zone.")
entry_five  = input.price(3280.0, title="Buy In 5 / Sell In 5 Price", tooltip="This is your final, deep entry level at the back boundary of your zone.")

// 3. Collapsible Manual Overrides Section (Leave at 0 for Auto-calculations)
sl_manual   = input.price(0.0, title="Manual SL Price", group="Manual Price Overrides (Optional)", tooltip="0 = Auto-calculate")
tp1_manual  = input.price(0.0, title="Manual TP 1 Price", group="Manual Price Overrides (Optional)", tooltip="0 = Auto-calculate")
tp2_manual  = input.price(0.0, title="Manual TP 2 Price", group="Manual Price Overrides (Optional)", tooltip="0 = Auto-calculate")
tp3_manual  = input.price(0.0, title="Manual TP 3 Price", group="Manual Price Overrides (Optional)", tooltip="0 = Auto-calculate")

// 4. Time Controls (Use these to shift and stretch the box left and right)
start_time  = input.time(timestamp("2026-08-10 00:00"), title="Box Start Time/Date", group="Time Settings")
end_time    = input.time(timestamp("2026-08-20 00:00"), title="Box End Time/Date", group="Time Settings")

// 5. Directional Math Logic
is_buy = (trade_dir == "Buy")

// Automatically determine structural highs and lows based on user entry orders
zone_top    = is_buy ? entry_one  : entry_five
zone_bottom = is_buy ? entry_five : entry_one
zone_range  = zone_top - zone_bottom

//    DIRECTIONAL VALUE CALCULATIONS
// The math handles the grid sequence smoothly whether Entry 1 is at the top (Buys) or bottom (Sells)
dca1 = entry_one
dca2 = is_buy ? entry_one - (zone_range * 0.25) : entry_one + (zone_range * 0.25)
dca3 = is_buy ? entry_one - (zone_range * 0.50) : entry_one + (zone_range * 0.50)
dca4 = is_buy ? entry_one - (zone_range * 0.75) : entry_one + (zone_range * 0.75)
dca5 = entry_five

// Auto Risk calculations: SL is exactly 3.0 points past your final, deep Entry 5
auto_sl  = is_buy ? (entry_five - 3.0) : (entry_five + 3.0)

// Auto Targets scale outward based on your very first Entry 1 position
auto_tp1 = is_buy ? (entry_one + 3.0)  : (entry_one - 3.0)
auto_tp2 = is_buy ? (entry_one + 6.0)  : (entry_one - 6.0)
auto_tp3 = is_buy ? (entry_one + 10.0) : (entry_one - 10.0)

// Apply manual overrides if they are filled in (> 0)
stop_loss = sl_manual  > 0 ? sl_manual  : auto_sl
tp1       = tp1_manual > 0 ? tp1_manual : auto_tp1
tp2       = tp2_manual > 0 ? tp2_manual : auto_tp2
tp3       = tp3_manual > 0 ? tp3_manual : auto_tp3

// Color Themes
box_color   = is_buy ? color.new(color.blue, 95) : color.new(color.orange, 95)
box_border  = is_buy ? color.blue : color.orange
sl_color    = color.red
tp_color    = color.green

// 6. Visual Rendering Block
if barstate.islast
    // Render the outer boundaries as a single background Box zone using manual times
    box_text = is_buy ? "Buy Zone" : "Sell Zone"
    box.new(left=start_time, top=zone_top, right=end_time, bottom=zone_bottom, xloc=xloc.bar_time, bgcolor=box_color, border_color=box_border, text=box_text, text_color=box_border, text_valign="center")
    
    // Render the 5 Internal Equal Buy-In Lines tied directly to the script math variables
    line.new(x1=start_time, y1=dca1, x2=end_time, y2=dca1, xloc=xloc.bar_time, color=box_border, style=line.style_solid, width=2)
    line.new(x1=start_time, y1=dca2, x2=end_time, y2=dca2, xloc=xloc.bar_time, color=box_border, style=line.style_dashed, width=1)
    line.new(x1=start_time, y1=dca3, x2=end_time, y2=dca3, xloc=xloc.bar_time, color=box_border, style=line.style_dashed, width=1)
    line.new(x1=start_time, y1=dca4, x2=end_time, y2=dca4, xloc=xloc.bar_time, color=box_border, style=line.style_dashed, width=1)
    line.new(x1=start_time, y1=dca5, x2=end_time, y2=dca5, xloc=xloc.bar_time, color=box_border, style=line.style_solid, width=2)
    
    // Render Risk/Reward Lines using manual times
    line.new(x1=start_time, y1=stop_loss, x2=end_time, y2=stop_loss, xloc=xloc.bar_time, color=sl_color,   style=line.style_solid, width=2)
    line.new(x1=start_time, y1=tp1,       x2=end_time, y2=tp1,       xloc=xloc.bar_time, color=tp_color,   style=line.style_solid, width=1)
    line.new(x1=start_time, y1=tp2,       x2=end_time, y2=tp2,       xloc=xloc.bar_time, color=tp_color,   style=line.style_solid, width=1)
    line.new(x1=start_time, y1=tp3,       x2=end_time, y2=tp3,       xloc=xloc.bar_time, color=tp_color,   style=line.style_solid, width=2)

    // Render Clean Text Labels outside the box area pointing directly to the mathematical levels
    label.new(x=end_time, y=dca1, xloc=xloc.bar_time, text=(is_buy ? "Buy In 1: " : "Sell In 1: ") + str.tostring(dca1, "#.##"), color=box_border, textcolor=color.white, style=label.style_label_left)
    label.new(x=end_time, y=dca2, xloc=xloc.bar_time, text=(is_buy ? "Buy In 2: " : "Sell In 2: ") + str.tostring(dca2, "#.##"), color=box_border, textcolor=color.white, style=label.style_label_left)
    label.new(x=end_time, y=dca3, xloc=xloc.bar_time, text=(is_buy ? "Buy In 3: " : "Sell In 3: ") + str.tostring(dca3, "#.##"), color=box_border, textcolor=color.white, style=label.style_label_left)
    label.new(x=end_time, y=dca4, xloc=xloc.bar_time, text=(is_buy ? "Buy In 4: " : "Sell In 4: ") + str.tostring(dca4, "#.##"), color=box_border, textcolor=color.white, style=label.style_label_left)
    label.new(x=end_time, y=dca5, xloc=xloc.bar_time, text=(is_buy ? "Buy In 5: " : "Sell In 5: ") + str.tostring(dca5, "#.##"), color=box_border, textcolor=color.white, style=label.style_label_left)
    
    label.new(x=end_time, y=stop_loss, xloc=xloc.bar_time, text="SL: " + str.tostring(stop_loss, "#.##"),         color=sl_color,   textcolor=color.white, style=label.style_label_left)
    label.new(x=end_time, y=tp1,       xloc=xloc.bar_time, text="TP 1: " + str.tostring(tp1, "#.##"),             color=tp_color,   textcolor=color.white, style=label.style_label_left)
    label.new(x=end_time, y=tp2,       xloc=xloc.bar_time, text="TP 2: " + str.tostring(tp2, "#.##"),             color=tp_color,   textcolor=color.white, style=label.style_label_left)
    label.new(x=end_time, y=tp3,       xloc=xloc.bar_time, text="TP 3: " + str.tostring(tp3, "#.##"),             color=tp_color,   textcolor=color.white, style=label.style_label_left)
