//@version=6
strategy("Hybrid VWAP+RSI Strategy [Trend + Mean Reversion]", 
     overlay=true, 
     default_qty_type=strategy.percent_of_equity, 
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.075)

// === INPUTS ===
// Core Strategy
rsiLength = input.int(14, "RSI Length", minval=5, maxval=30)
rsiOversold = input.int(32, "RSI Oversold (Long)", minval=20, maxval=40)
rsiOverbought = input.int(68, "RSI Overbought (Short)", minval=60, maxval=80)
vwapResetHours = input.int(9, "VWAP Reset Hour (Local Time)", minval=0, maxval=23)

// Trend Filter
useTrendFilter = input.bool(true, "Use Trend Filter (SPY 200MA)")
trendSymbol = input.string("SPY", "Trend Symbol")

// Risk Management
riskPercent = input.float(1.0, "Risk % per Trade", minval=0.1, maxval=10.0, step=0.1) / 100
atrLength = input.int(14, "ATR Length", minval=5, maxval=50)
maxRiskRatio = input.float(2.0, "Max Risk Multiplier in Trends", minval=1.0, maxval=5.0, step=0.1)

// === CALCULATIONS ===
// 1. VWAP (Anchored to Session Start)
var float cumulativePV = na
var float cumulativeVol = na
var bool newSession = hour == vwapResetHours and minute == 0

if barstate.isfirst or newSession
    cumulativePV := hl2 * volume
    cumulativeVol := volume
else
    cumulativePV += hl2 * volume
    cumulativeVol += volume

vwap = cumulativePV / cumulativeVol

// 2. Market Trend (SPY 200MA)
marketTrend = useTrendFilter ? 
     request.security(trendSymbol, "D", close > ta.sma(close, 200)) : true

// 3. Volatility Filter
atr = ta.atr(atrLength)
atrRatio = atr / close
highVolatility = atrRatio > 0.01  // Adjust based on asset

// 4. Entry Conditions
longCondition = marketTrend and (close < vwap) and (ta.rsi(close, rsiLength) < rsiOversold) and highVolatility
shortCondition = not marketTrend and (close > vwap) and (ta.rsi(close, rsiLength) > rsiOverbought) and highVolatility

// === POSITION SIZING ===
positionSize = (strategy.equity * riskPercent) / (atr * (marketTrend ? maxRiskRatio : 1))

// === EXECUTION ===
// Long Entries (Only in Uptrends)
if longCondition
    strategy.entry("Long", strategy.long, qty=positionSize)
    strategy.exit("Long Exit", "Long", 
         trail_points=atr * (marketTrend ? 2 : 1),  // Wider trail in trends
         trail_offset=atr * 0.5)

// Short Entries (Only in Downtrends)
if shortCondition
    strategy.entry("Short", strategy.short, qty=positionSize)
    strategy.exit("Short Exit", "Short",
         trail_points=atr * (marketTrend ? 2 : 1),
         trail_offset=atr * 0.5)

// === VISUALS ===
plot(vwap, "VWAP", color=color.purple, linewidth=2)
plotshape(longCondition, "Long", shape.triangleup, location.belowbar, color=color.green, size=size.small)
plotshape(shortCondition, "Short", shape.triangledown, location.abovebar, color=color.red, size=size.small)