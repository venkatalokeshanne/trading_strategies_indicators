//@version=5
strategy("MNQ Prop Firm Execution System (Final)", overlay=true, pyramiding=0)

// =====================
// STRUCTURE
// =====================
pivotLen = 3

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float swingHigh = na
var float swingLow = na

if not na(ph)
    swingHigh := ph
if not na(pl)
    swingLow := pl

// =====================
// LIQUIDITY SWEEPS (EDGE)
// =====================
sweepLow = not na(swingLow) and low < swingLow and close > swingLow
sweepHigh = not na(swingHigh) and high > swingHigh and close < swingHigh

// =====================
// TREND FILTER (LIGHT EDGE BIAS)
// =====================
ema = ta.ema(close, 200)
trendUp = close > ema
trendDown = close < ema

// =====================
// SESSION FILTER (YOUR EDGE WINDOW)
// =====================
session = not na(time(timeframe.period, "1300-1600"))

// =====================
// DAILY RISK ENGINE (REAL PROP STYLE)
// =====================
var float equityStart = strategy.equity
var int trades = 0

if ta.change(time("D"))
    equityStart := strategy.equity
    trades := 0

dailyPnL = strategy.equity - equityStart

maxDailyLoss = -300
maxTrades = 3

canTrade = trades < maxTrades and dailyPnL > maxDailyLoss

// =====================
// ENTRY LOGIC (UNCHANGED EDGE)
// =====================
longSignal = session and canTrade and sweepLow and trendUp
shortSignal = session and canTrade and sweepHigh and trendDown

// =====================
// RISK MODEL (PROP FIRM STYLE SIZING)
// =====================
baseQty = 1
sizeBoost = dailyPnL > 150 ? 2 : 1
qty = baseQty * sizeBoost

// =====================
// EXECUTION (PROFIT SPLIT SYSTEM)
// =====================
if longSignal
    sl = swingLow

    tp1 = close + (close - sl) * 1.0   // safe scalp
    tp2 = close + (close - sl) * 1.8   // runner

    strategy.entry("BUY", strategy.long, qty=qty)

    // lock profits early
    strategy.exit("BUY TP1", "BUY", limit=tp1, qty_percent=50)

    // runner with full target
    strategy.exit("BUY TP2", "BUY", limit=tp2, stop=sl)

    trades += 1

if shortSignal
    sl = swingHigh

    tp1 = close - (sl - close) * 1.0
    tp2 = close - (sl - close) * 1.8

    strategy.entry("SELL", strategy.short, qty=qty)

    strategy.exit("SELL TP1", "SELL", limit=tp1, qty_percent=50)
    strategy.exit("SELL TP2", "SELL", limit=tp2, stop=sl)

    trades += 1

// =====================
// VISUALS
// =====================
plot(swingHigh, color=color.red)
plot(swingLow, color=color.green)
plot(ema, color=color.orange)