//@version=6
indicator("RSI + CCI MultiTF Signal (ATR + Flat + Full Stoch Filter)", overlay=true)

// === Настройки индикаторов === //
rsiLength = input.int(14, title="RSI Length")
cciLength = input.int(20, title="CCI Length")
stochKLength = input.int(14, title="Stochastic %K Length")
stochDLength = input.int(3, title="Stochastic %D Smoothing")
atrLength = input.int(14, title="ATR Length")

// === Фильтры === //
useATRFilter = input.bool(true, title="Use ATR Filter?")
useFlatFilter = input.bool(true, title="Use Flat Market Filter?")

// === Источники и индикаторы на 15м === //
src = close
rsi15 = ta.rsi(src, rsiLength)
cci15 = ta.cci(src, cciLength)
atr = ta.atr(atrLength)
atrSMA = ta.sma(atr, atrLength)
range20 = ta.highest(high, 20) - ta.lowest(low, 20)

// Стохастик (15м)
k = ta.stoch(close, high, low, stochKLength)
d = ta.sma(k, stochDLength)

// === Индикаторы на 1ч === //
rsi1h = request.security(syminfo.tickerid, "60", ta.rsi(src, rsiLength))
cci1h = request.security(syminfo.tickerid, "60", ta.cci(src, cciLength))

// === Фильтрация === //
atrCond = not useATRFilter or (atr > atrSMA * 1.1)
flatCond = not useFlatFilter or (range20 > atr * 2)

// === Условия сигналов === //
// LONG
rsiLongCond = ta.crossover(rsi15, 30)
stochLongCond = k > 20
confirmLong = rsi1h < 40 and cci1h < 100
longSignal = rsiLongCond and stochLongCond and confirmLong and atrCond and flatCond

// SHORT
rsiShortCond = ta.crossunder(rsi15, 70)
stochShortCond = k < 80
confirmShort = rsi1h > 60 and cci1h > 100
shortSignal = rsiShortCond and stochShortCond and confirmShort and atrCond and flatCond

// === Отображение сигналов в виде треугольников === //
plotshape(longSignal, title="Long Signal", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small, text="BUY", textcolor=color.blue)
plotshape(shortSignal, title="Short Signal", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small, text="SELL", textcolor=color.blue)

// === Автоматические оповещения === //
if longSignal and ta.change(longSignal)
    alert("Покупка (LONG) по " + syminfo.ticker + "! Цена: " + str.tostring(close), alert.freq_once_per_bar_close)

if shortSignal and ta.change(shortSignal)
    alert("Продажа (SHORT) по " + syminfo.ticker + "! Цена: " + str.tostring(close), alert.freq_once_per_bar_close)
