//@version=6
indicator("GOLD 5分足｜FVG × BOS × 流動性", overlay=true, max_labels_count=500, max_boxes_count=100, max_lines_count=100)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 設定
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

groupTrend = "① トレンド"

emaFastLen = input.int(9, "EMA短期", group=groupTrend)
emaSlowLen = input.int(21, "EMA長期", group=groupTrend)
adxLen     = input.int(14, "ADX期間", group=groupTrend)
adxMin     = input.float(25.0, "トレンド判定ADX", step=0.5, group=groupTrend)

groupRSI = "② RSI"

rsiLen  = input.int(14, "RSI期間", group=groupRSI)
rsiBuy  = input.float(50.0, "BUY基準", step=0.5, group=groupRSI)
rsiSell = input.float(50.0, "SELL基準", step=0.5, group=groupRSI)

groupStructure = "③ 相場構造"

swingLen = input.int(5, "スイング判定", minval=2, group=groupStructure)

groupFVG = "④ FVG"

atrLen = input.int(14, "ATR期間", group=groupFVG)

fvgWeakATR   = input.float(0.30, "FVG通常判定", step=0.05, group=groupFVG)
fvgStrongATR = input.float(0.60, "FVG強判定", step=0.05, group=groupFVG)

showFVG = input.bool(true, "FVG表示", group=groupFVG)
maxFVG  = input.int(8, "最大表示数", minval=1, maxval=30, group=groupFVG)

groupHTF = "⑤ 上位足"

htf = input.timeframe("15", "上位足", group=groupHTF)

groupSignal = "⑥ エントリー"

minScore = input.int(7, "最低スコア", minval=5, maxval=10, group=groupSignal)

groupSLTP = "⑦ SL / TP"

showSLTP = input.bool(true, "SL・TPライン表示", group=groupSLTP)

atrSL = input.float(1.2, "SL ATR倍率", step=0.1, group=groupSLTP)

rr1 = input.float(1.0, "TP1", step=0.1, group=groupSLTP)
rr2 = input.float(2.0, "TP2", step=0.1, group=groupSLTP)
rr3 = input.float(3.0, "TP3", step=0.1, group=groupSLTP)

groupDisplay = "⑧ 表示"

showStructure = input.bool(true, "BOS / CHoCH表示", group=groupDisplay)
showLiquidity = input.bool(true, "流動性刈り表示", group=groupDisplay)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 基本計算
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

rsi = ta.rsi(close, rsiLen)

[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

atr = ta.atr(atrLen)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// EMA
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

emaUp   = emaFast > emaSlow
emaDown = emaFast < emaSlow

trendUp   = emaUp and adx >= adxMin
trendDown = emaDown and adx >= adxMin

isTrend = adx >= adxMin

plot(emaFast, "EMA9", color=color.blue, linewidth=2)
plot(emaSlow, "EMA21", color=color.green, linewidth=2)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 上位足
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

htfFast = request.security(
     syminfo.tickerid,
     htf,
     ta.ema(close, emaFastLen)
     )

htfSlow = request.security(
     syminfo.tickerid,
     htf,
     ta.ema(close, emaSlowLen)
     )

htfUp   = htfFast > htfSlow
htfDown = htfFast < htfSlow


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// スイング
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

pivotHigh = ta.pivothigh(high, swingLen, swingLen)
pivotLow  = ta.pivotlow(low, swingLen, swingLen)

var float lastSwingHigh = na
var float lastSwingLow  = na

if not na(pivotHigh)
    lastSwingHigh := pivotHigh

if not na(pivotLow)
    lastSwingLow := pivotLow


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BOS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bullBOS =
     not na(lastSwingHigh) and
     close > lastSwingHigh and
     close[1] <= lastSwingHigh

bearBOS =
     not na(lastSwingLow) and
     close < lastSwingLow and
     close[1] >= lastSwingLow


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CHoCH
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var int marketStructure = 0

bullCHoCH = false
bearCHoCH = false

if bullBOS
    bullCHoCH := marketStructure == -1
    marketStructure := 1

if bearBOS
    bearCHoCH := marketStructure == 1
    marketStructure := -1


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 流動性刈り
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bullLiquiditySweep =
     not na(lastSwingLow) and
     low < lastSwingLow and
     close > lastSwingLow

bearLiquiditySweep =
     not na(lastSwingHigh) and
     high > lastSwingHigh and
     close < lastSwingHigh


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FVG
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bullFVG = low > high[2]
bearFVG = high < low[2]

bullFVGTop    = low
bullFVGBottom = high[2]

bearFVGTop    = low[2]
bearFVGBottom = high

bullFVGWidth = bullFVGTop - bullFVGBottom
bearFVGWidth = bearFVGTop - bearFVGBottom

bullFVGStrength = bullFVGWidth / atr
bearFVGStrength = bearFVGWidth / atr


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 最新FVG
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var float latestBullTop      = na
var float latestBullBottom   = na
var float latestBullStrength = na

var float latestBearTop      = na
var float latestBearBottom   = na
var float latestBearStrength = na

var box[] fvgBoxes = array.new_box()


if bullFVG

    latestBullTop      := bullFVGTop
    latestBullBottom   := bullFVGBottom
    latestBullStrength := bullFVGStrength

    if showFVG

        bullBoxColor =
             bullFVGStrength >= fvgStrongATR ?
             color.new(color.green, 75) :
             bullFVGStrength >= fvgWeakATR ?
             color.new(color.green, 82) :
             color.new(color.gray, 88)

        b = box.new(
             left=bar_index - 2,
             top=bullFVGTop,
             right=bar_index + 20,
             bottom=bullFVGBottom,
             bgcolor=bullBoxColor,
             border_color=color.new(color.green, 70)
             )

        array.push(fvgBoxes, b)


if bearFVG

    latestBearTop      := bearFVGTop
    latestBearBottom   := bearFVGBottom
    latestBearStrength := bearFVGStrength

    if showFVG

        bearBoxColor =
             bearFVGStrength >= fvgStrongATR ?
             color.new(color.red, 75) :
             bearFVGStrength >= fvgWeakATR ?
             color.new(color.red, 82) :
             color.new(color.gray, 88)

        b = box.new(
             left=bar_index - 2,
             top=bearFVGTop,
             right=bar_index + 20,
             bottom=bearFVGBottom,
             bgcolor=bearBoxColor,
             border_color=color.new(color.red, 70)
             )

        array.push(fvgBoxes, b)


while array.size(fvgBoxes) > maxFVG

    oldBox = array.shift(fvgBoxes)

    box.delete(oldBox)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FVG判定
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bullFVGNormal =
     not na(latestBullStrength) and
     latestBullStrength >= fvgWeakATR

bearFVGNormal =
     not na(latestBearStrength) and
     latestBearStrength >= fvgWeakATR

bullFVGStrong =
     not na(latestBullStrength) and
     latestBullStrength >= fvgStrongATR

bearFVGStrong =
     not na(latestBearStrength) and
     latestBearStrength >= fvgStrongATR


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FVGタッチ
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bullFVGTouched =
     not na(latestBullTop) and
     high >= latestBullBottom and
     low <= latestBullTop

bearFVGTouched =
     not na(latestBearTop) and
     high >= latestBearBottom and
     low <= latestBearTop


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RSI
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

rsiBuyOK  = rsi >= rsiBuy
rsiSellOK = rsi <= rsiSell


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BUYスコア
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

buyScore = 0

buyScore += emaUp ? 1 : 0
buyScore += rsiBuyOK ? 1 : 0
buyScore += adx >= adxMin ? 1 : 0
buyScore += trendUp ? 1 : 0
buyScore += htfUp ? 1 : 0
buyScore += (bullBOS or bullCHoCH) ? 1 : 0
buyScore += bullLiquiditySweep ? 1 : 0
buyScore += bullFVGNormal ? 1 : 0
buyScore += bullFVGTouched ? 1 : 0
buyScore += close > open ? 1 : 0


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SELLスコア
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

sellScore = 0

sellScore += emaDown ? 1 : 0
sellScore += rsiSellOK ? 1 : 0
sellScore += adx >= adxMin ? 1 : 0
sellScore += trendDown ? 1 : 0
sellScore += htfDown ? 1 : 0
sellScore += (bearBOS or bearCHoCH) ? 1 : 0
sellScore += bearLiquiditySweep ? 1 : 0
sellScore += bearFVGNormal ? 1 : 0
sellScore += bearFVGTouched ? 1 : 0
sellScore += close < open ? 1 : 0


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// エントリー判定
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bullStructure = bullBOS or bullCHoCH
bearStructure = bearBOS or bearCHoCH

buyReady =
     buyScore >= minScore and
     bullStructure and
     bullFVGTouched

sellReady =
     sellScore >= minScore and
     bearStructure and
     bearFVGTouched


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// サイン重複防止
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var int lastSignal = 0

buySignal =
     buyReady and
     lastSignal != 1

sellSignal =
     sellReady and
     lastSignal != -1

if buySignal
    lastSignal := 1

if sellSignal
    lastSignal := -1


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BUY / SELL
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if buySignal

    label.new(
         bar_index,
         low,
         "BUY",
         style=label.style_label_up,
         color=color.green,
         textcolor=color.white,
         size=size.normal
         )


if sellSignal

    label.new(
         bar_index,
         high,
         "SELL",
         style=label.style_label_down,
         color=color.red,
         textcolor=color.white,
         size=size.normal
         )


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// EXIT
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

exitBuy =
     lastSignal == 1 and
     (bearCHoCH or bearBOS)

exitSell =
     lastSignal == -1 and
     (bullCHoCH or bullBOS)

if exitBuy or exitSell

    label.new(
         bar_index,
         close,
         "EXIT",
         style=label.style_label_left,
         color=color.orange,
         textcolor=color.white,
         size=size.small
         )

    lastSignal := 0


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SL / TP
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var line slLine  = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na

var float currentSL  = na
var float currentTP1 = na
var float currentTP2 = na
var float currentTP3 = na


if buySignal

    risk = atr * atrSL

    currentSL  := close - risk
    currentTP1 := close + risk * rr1
    currentTP2 := close + risk * rr2
    currentTP3 := close + risk * rr3

    if showSLTP

        line.delete(slLine)
        line.delete(tp1Line)
        line.delete(tp2Line)
        line.delete(tp3Line)

        slLine := line.new(
             bar_index,
             currentSL,
             bar_index + 30,
             currentSL,
             color=color.red,
             style=line.style_dashed
             )

        tp1Line := line.new(
             bar_index,
             currentTP1,
             bar_index + 30,
             currentTP1,
             color=color.green,
             style=line.style_dashed
             )

        tp2Line := line.new(
             bar_index,
             currentTP2,
             bar_index + 30,
             currentTP2,
             color=color.green,
             style=line.style_dashed
             )

        tp3Line := line.new(
             bar_index,
             currentTP3,
             bar_index + 30,
             currentTP3,
             color=color.green,
             style=line.style_dashed
             )


if sellSignal

    risk = atr * atrSL

    currentSL  := close + risk
    currentTP1 := close - risk * rr1
    currentTP2 := close - risk * rr2
    currentTP3 := close - risk * rr3

    if showSLTP

        line.delete(slLine)
        line.delete(tp1Line)
        line.delete(tp2Line)
        line.delete(tp3Line)

        slLine := line.new(
             bar_index,
             currentSL,
             bar_index + 30,
             currentSL,
             color=color.red,
             style=line.style_dashed
             )

        tp1Line := line.new(
             bar_index,
             currentTP1,
             bar_index + 30,
             currentTP1,
             color=color.green,
             style=line.style_dashed
             )

        tp2Line := line.new(
             bar_index,
             currentTP2,
             bar_index + 30,
             currentTP2,
             color=color.green,
             style=line.style_dashed
             )

        tp3Line := line.new(
             bar_index,
             currentTP3,
             bar_index + 30,
             currentTP3,
             color=color.green,
             style=line.style_dashed
             )


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BOS / CHoCH
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if showStructure and bullBOS

    label.new(
         bar_index,
         high,
         bullCHoCH ? "CHoCH↑" : "BOS↑",
         style=label.style_label_down,
         color=color.new(color.green, 20),
         textcolor=color.white,
         size=size.tiny
         )


if showStructure and bearBOS

    label.new(
         bar_index,
         low,
         bearCHoCH ? "CHoCH↓" : "BOS↓",
         style=label.style_label_up,
         color=color.new(color.red, 20),
         textcolor=color.white,
         size=size.tiny
         )


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 流動性刈り
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if showLiquidity and bullLiquiditySweep

    label.new(
         bar_index,
         low,
         "流動性刈り↑",
         style=label.style_label_up,
         color=color.new(color.green, 40),
         textcolor=color.white,
         size=size.tiny
         )


if showLiquidity and bearLiquiditySweep

    label.new(
         bar_index,
         high,
         "流動性刈り↓",
         style=label.style_label_down,
         color=color.new(color.red, 40),
         textcolor=color.white,
         size=size.tiny
         )


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 左上：超シンプル表示
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var table statusTable = table.new(
     position.top_left,
     2,
     6,
     bgcolor=color.new(color.black, 15),
     border_width=1
     )


// RSI表示
rsiText = str.tostring(rsi, "#.0")


// ADX表示
adxText = str.tostring(adx, "#.0")


// 相場
marketText =
     isTrend ? "トレンド" : "レンジ"


// 傾き
slopeText =
     emaUp ? "↑ 上" :
     emaDown ? "↓ 下" :
     "→ 横"


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 最終状態
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// 強い逆方向の場合はスルー
badBuy =
     sellScore >= minScore and
     not buyReady

badSell =
     buyScore >= minScore and
     not sellReady

isSkip =
     (badBuy or badSell) or
     not isTrend

isEntry =
     buySignal or sellSignal

statusText =
     isEntry ? "エントリー" :
     isSkip ? "スルー" :
     "エントリー待機"


statusColor =
     isEntry ? color.lime :
     isSkip ? color.red :
     color.yellow


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// テーブル
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if barstate.islast

    // タイトル
    table.cell(
         statusTable,
         0,
         0,
         "GOLD 5分足",
         text_color=color.white,
         bgcolor=color.new(color.blue, 20)
         )

    table.cell(
         statusTable,
         1,
         0,
         "",
         bgcolor=color.new(color.blue, 20)
         )


    // RSI
    table.cell(
         statusTable,
         0,
         1,
         "RSI",
         text_color=color.white
         )

    table.cell(
         statusTable,
         1,
         1,
         rsiText,
         text_color=color.white
         )


    // ADX
    table.cell(
         statusTable,
         0,
         2,
         "ADX",
         text_color=color.white
         )

    table.cell(
         statusTable,
         1,
         2,
         adxText,
         text_color=adx >= adxMin ? color.lime : color.gray
         )


    // 相場
    table.cell(
         statusTable,
         0,
         3,
         "相場",
         text_color=color.white
         )

    table.cell(
         statusTable,
         1,
         3,
         marketText,
         text_color=isTrend ? color.lime : color.orange
         )


    // 傾き
    table.cell(
         statusTable,
         0,
         4,
         "傾き",
         text_color=color.white
         )

    table.cell(
         statusTable,
         1,
         4,
         slopeText,
         text_color=emaUp ? color.lime : emaDown ? color.red : color.gray
         )


    // 最終判定
    table.cell(
         statusTable,
         0,
         5,
         "判定",
         text_color=color.white
         )

    table.cell(
         statusTable,
         1,
         5,
         statusText,
         text_color=statusColor,
         bgcolor=color.new(statusColor, 85)
         )


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// アラート
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

alertcondition(
     buySignal,
     title="GOLD BUY",
     message="GOLD 5分足 BUY"
     )

alertcondition(
     sellSignal,
     title="GOLD SELL",
     message="GOLD 5分足 SELL"
     )

alertcondition(
     exitBuy or exitSell,
     title="GOLD EXIT",
     message="GOLD 5分足 EXIT"
     )