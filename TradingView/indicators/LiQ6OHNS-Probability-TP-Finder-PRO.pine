//@version=6
indicator("Probability TP Finder PRO", overlay=true, max_boxes_count=50, max_labels_count=50)

//====================================================================
// SETTINGS
//====================================================================

// Trend
groupTrend = "1. Trend & Probability"

fastEmaLen = input.int(20, "Fast EMA", minval=1, group=groupTrend)
slowEmaLen = input.int(50, "Slow EMA", minval=1, group=groupTrend)
mainEmaLen = input.int(200, "Main EMA", minval=1, group=groupTrend)

rsiLen = input.int(14, "RSI Length", minval=2, group=groupTrend)
diLen = input.int(14, "DMI Length", minval=2, group=groupTrend)
adxSmooth = input.int(14, "ADX Smoothing", minval=2, group=groupTrend)

minDirectionProb = input.float(57.0, "Minimum Direction Probability", minval=50.0, maxval=90.0, step=1.0, group=groupTrend)

//====================================================================
// TARGET SETTINGS
//====================================================================

groupTP = "2. TP Finder"

nearLookback = input.int(20, "TP1 Liquidity Lookback", minval=5, group=groupTP)
midLookback = input.int(50, "TP2 Liquidity Lookback", minval=10, group=groupTP)
farLookback = input.int(100, "TP3 Liquidity Lookback", minval=20, group=groupTP)

atrLen = input.int(14, "ATR Length", minval=1, group=groupTP)

fallbackTP1 = input.float(0.8, "TP1 ATR Fallback", minval=0.1, step=0.1, group=groupTP)
fallbackTP2 = input.float(1.6, "TP2 ATR Fallback", minval=0.2, step=0.1, group=groupTP)
fallbackTP3 = input.float(2.5, "TP3 ATR Fallback", minval=0.3, step=0.1, group=groupTP)

distancePenalty = input.float(0.20, "Distance Probability Penalty", minval=0.01, maxval=1.0, step=0.01, group=groupTP)

//====================================================================
// VISUAL SETTINGS
//====================================================================

groupVisual = "3. Visual"

targetMode = input.string("Dominant only", "Target Display", options=["Dominant only", "Both sides"], group=groupVisual)
extendBars = input.int(30, "Extend Targets", minval=5, maxval=200, group=groupVisual)
zoneWidthATR = input.float(0.08, "Target Zone Width ATR", minval=0.01, maxval=0.5, step=0.01, group=groupVisual)

showEMA = input.bool(false, "Show EMAs", group=groupVisual)
showVWAP = input.bool(false, "Show VWAP", group=groupVisual)
showDashboard = input.bool(true, "Show Dashboard", group=groupVisual)

//====================================================================
// FUNCTION
//====================================================================

f_clamp(value, minimum, maximum) =>
    math.max(minimum, math.min(maximum, value))

//====================================================================
// INDICATORS
//====================================================================

emaFast = ta.ema(close, fastEmaLen)
emaSlow = ta.ema(close, slowEmaLen)
emaMain = ta.ema(close, mainEmaLen)

vwapValue = ta.vwap(hlc3)

rsiValue = ta.rsi(close, rsiLen)

[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)

[plusDI, minusDI, adxValue] = ta.dmi(diLen, adxSmooth)

atrValue = ta.atr(atrLen)

//====================================================================
// TREND SCORES
//====================================================================

emaScore = emaFast > emaSlow ? 20.0 : emaFast < emaSlow ? -20.0 : 0.0

mainTrendScore = close > emaMain ? 15.0 : close < emaMain ? -15.0 : 0.0

vwapScore = close > vwapValue ? 15.0 : close < vwapValue ? -15.0 : 0.0

rsiNormalized = f_clamp((rsiValue - 50.0) / 20.0, -1.0, 1.0)

rsiScore = rsiNormalized * 15.0

macdScore = macdHist > 0 ? 15.0 : macdHist < 0 ? -15.0 : 0.0

dmiScore = plusDI > minusDI ? 20.0 : minusDI > plusDI ? -20.0 : 0.0

//====================================================================
// ADX STRENGTH
//====================================================================

adxNormalized = f_clamp((adxValue - 15.0) / 25.0, 0.0, 1.0)

adxMultiplier = 0.55 + adxNormalized * 0.45

//====================================================================
// FINAL DIRECTION SCORE
//====================================================================

rawScore = emaScore + mainTrendScore + vwapScore + rsiScore + macdScore + dmiScore

marketScore = rawScore * adxMultiplier

upProbability = f_clamp(50.0 + marketScore * 0.45, 5.0, 95.0)

downProbability = 100.0 - upProbability

bullishBias = upProbability > downProbability

bearishBias = downProbability > upProbability

dominantProbability = math.max(upProbability, downProbability)

//====================================================================
// MARKET FILTER
//====================================================================

weakADX = adxValue < 16.0

weakBias = dominantProbability < minDirectionProb

neutralMarket = weakADX or weakBias

//====================================================================
// LIQUIDITY TARGETS
//====================================================================

// Previous candles only

nearHigh = ta.highest(high[1], nearLookback)
midHigh = ta.highest(high[1], midLookback)
farHigh = ta.highest(high[1], farLookback)

nearLow = ta.lowest(low[1], nearLookback)
midLow = ta.lowest(low[1], midLookback)
farLow = ta.lowest(low[1], farLookback)

//====================================================================
// LIQUIDITY DISTANCES
//====================================================================

nearHighDistance = (nearHigh - close) / atrValue
midHighDistance = (midHigh - close) / atrValue
farHighDistance = (farHigh - close) / atrValue

nearLowDistance = (close - nearLow) / atrValue
midLowDistance = (close - midLow) / atrValue
farLowDistance = (close - farLow) / atrValue

//====================================================================
// VALID LIQUIDITY TARGETS
//====================================================================

validNearHigh = nearHigh > close and nearHighDistance >= 0.20 and nearHighDistance <= 1.50
validMidHigh = midHigh > close and midHighDistance >= 0.80 and midHighDistance <= 2.80
validFarHigh = farHigh > close and farHighDistance >= 1.50 and farHighDistance <= 5.00

validNearLow = nearLow < close and nearLowDistance >= 0.20 and nearLowDistance <= 1.50
validMidLow = midLow < close and midLowDistance >= 0.80 and midLowDistance <= 2.80
validFarLow = farLow < close and farLowDistance >= 1.50 and farLowDistance <= 5.00

//====================================================================
// BULLISH TP LEVELS
//====================================================================

upTP1 = validNearHigh ? nearHigh : close + atrValue * fallbackTP1

upTP2 = validMidHigh ? midHigh : close + atrValue * fallbackTP2

upTP3 = validFarHigh ? farHigh : close + atrValue * fallbackTP3

//====================================================================
// BEARISH TP LEVELS
//====================================================================

downTP1 = validNearLow ? nearLow : close - atrValue * fallbackTP1

downTP2 = validMidLow ? midLow : close - atrValue * fallbackTP2

downTP3 = validFarLow ? farLow : close - atrValue * fallbackTP3

//====================================================================
// TARGET DISTANCE
//====================================================================

upTP1Distance = math.abs(upTP1 - close) / atrValue
upTP2Distance = math.abs(upTP2 - close) / atrValue
upTP3Distance = math.abs(upTP3 - close) / atrValue

downTP1Distance = math.abs(close - downTP1) / atrValue
downTP2Distance = math.abs(close - downTP2) / atrValue
downTP3Distance = math.abs(close - downTP3) / atrValue

//====================================================================
// BONUS SCORES
//====================================================================

adxBonus = adxValue >= 25.0 ? 3.0 : 0.0

nearHighBonus = validNearHigh ? 6.0 : 0.0
midHighBonus = validMidHigh ? 6.0 : 0.0
farHighBonus = validFarHigh ? 6.0 : 0.0

nearLowBonus = validNearLow ? 6.0 : 0.0
midLowBonus = validMidLow ? 6.0 : 0.0
farLowBonus = validFarLow ? 6.0 : 0.0

//====================================================================
// BULLISH TP PROBABILITY
//====================================================================

upTP1Probability = f_clamp(upProbability * math.exp(-upTP1Distance * distancePenalty) + nearHighBonus + adxBonus, 1.0, 95.0)

upTP2Probability = f_clamp(upProbability * math.exp(-upTP2Distance * distancePenalty) + midHighBonus + adxBonus, 1.0, 95.0)

upTP3Probability = f_clamp(upProbability * math.exp(-upTP3Distance * distancePenalty) + farHighBonus + adxBonus, 1.0, 95.0)

//====================================================================
// BEARISH TP PROBABILITY
//====================================================================

downTP1Probability = f_clamp(downProbability * math.exp(-downTP1Distance * distancePenalty) + nearLowBonus + adxBonus, 1.0, 95.0)

downTP2Probability = f_clamp(downProbability * math.exp(-downTP2Distance * distancePenalty) + midLowBonus + adxBonus, 1.0, 95.0)

downTP3Probability = f_clamp(downProbability * math.exp(-downTP3Distance * distancePenalty) + farLowBonus + adxBonus, 1.0, 95.0)

//====================================================================
// OPTIONAL EMA / VWAP
//====================================================================

plot(showEMA ? emaFast : na, "EMA Fast", color=color.new(color.green, 30))

plot(showEMA ? emaSlow : na, "EMA Slow", color=color.new(color.orange, 30))

plot(showEMA ? emaMain : na, "EMA 200", color=color.new(color.blue, 20))

plot(showVWAP ? vwapValue : na, "VWAP", color=color.new(color.purple, 10), linewidth=2)

//====================================================================
// BOX VARIABLES
//====================================================================

var box bullBox1 = na
var box bullBox2 = na
var box bullBox3 = na

var box bearBox1 = na
var box bearBox2 = na
var box bearBox3 = na

var label bullLabel1 = na
var label bullLabel2 = na
var label bullLabel3 = na

var label bearLabel1 = na
var label bearLabel2 = na
var label bearLabel3 = na

//====================================================================
// TARGET DISPLAY
//====================================================================

if barstate.islast

    box.delete(bullBox1)
    box.delete(bullBox2)
    box.delete(bullBox3)

    box.delete(bearBox1)
    box.delete(bearBox2)
    box.delete(bearBox3)

    label.delete(bullLabel1)
    label.delete(bullLabel2)
    label.delete(bullLabel3)

    label.delete(bearLabel1)
    label.delete(bearLabel2)
    label.delete(bearLabel3)

    zoneHalf = atrValue * zoneWidthATR

    showBullTargets = targetMode == "Both sides" or (bullishBias and not neutralMarket)

    showBearTargets = targetMode == "Both sides" or (bearishBias and not neutralMarket)

    //==============================================================
    // LONG TARGETS
    //==============================================================

    if showBullTargets

        bullBox1 := box.new(bar_index, upTP1 + zoneHalf, bar_index + extendBars, upTP1 - zoneHalf, xloc=xloc.bar_index, border_color=color.lime, bgcolor=color.new(color.lime, 85))

        bullBox2 := box.new(bar_index, upTP2 + zoneHalf, bar_index + extendBars, upTP2 - zoneHalf, xloc=xloc.bar_index, border_color=color.green, bgcolor=color.new(color.green, 88))

        bullBox3 := box.new(bar_index, upTP3 + zoneHalf, bar_index + extendBars, upTP3 - zoneHalf, xloc=xloc.bar_index, border_color=color.teal, bgcolor=color.new(color.teal, 90))

        bullLabel1 := label.new(bar_index + extendBars, upTP1, "TP1 ▲  " + str.tostring(upTP1Probability, "#.0") + "%", xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.white, color=color.green)

        bullLabel2 := label.new(bar_index + extendBars, upTP2, "TP2 ▲  " + str.tostring(upTP2Probability, "#.0") + "%", xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.white, color=color.new(color.green, 20))

        bullLabel3 := label.new(bar_index + extendBars, upTP3, "TP3 ▲  " + str.tostring(upTP3Probability, "#.0") + "%", xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.white, color=color.teal)

    //==============================================================
    // SHORT TARGETS
    //==============================================================

    if showBearTargets

        bearBox1 := box.new(bar_index, downTP1 + zoneHalf, bar_index + extendBars, downTP1 - zoneHalf, xloc=xloc.bar_index, border_color=color.red, bgcolor=color.new(color.red, 85))

        bearBox2 := box.new(bar_index, downTP2 + zoneHalf, bar_index + extendBars, downTP2 - zoneHalf, xloc=xloc.bar_index, border_color=color.red, bgcolor=color.new(color.red, 88))

        bearBox3 := box.new(bar_index, downTP3 + zoneHalf, bar_index + extendBars, downTP3 - zoneHalf, xloc=xloc.bar_index, border_color=color.maroon, bgcolor=color.new(color.maroon, 90))

        bearLabel1 := label.new(bar_index + extendBars, downTP1, "TP1 ▼  " + str.tostring(downTP1Probability, "#.0") + "%", xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.white, color=color.red)

        bearLabel2 := label.new(bar_index + extendBars, downTP2, "TP2 ▼  " + str.tostring(downTP2Probability, "#.0") + "%", xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.white, color=color.new(color.red, 20))

        bearLabel3 := label.new(bar_index + extendBars, downTP3, "TP3 ▼  " + str.tostring(downTP3Probability, "#.0") + "%", xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.white, color=color.maroon)

//====================================================================
// DASHBOARD
//====================================================================

var table dashboard = table.new(position.top_right, 2, 7, border_width=1)

if barstate.islast and showDashboard

    marketText = neutralMarket ? "WAIT / RANGE" : bullishBias ? "BULLISH" : "BEARISH"

    marketColor = neutralMarket ? color.gray : bullishBias ? color.green : color.red

    sourceBull = validNearHigh or validMidHigh or validFarHigh

    sourceBear = validNearLow or validMidLow or validFarLow

    tpSource = bullishBias ? (sourceBull ? "LIQUIDITY" : "ATR") : (sourceBear ? "LIQUIDITY" : "ATR")

    table.cell(dashboard, 0, 0, "TP FINDER", bgcolor=color.new(color.blue, 20), text_color=color.white)

    table.cell(dashboard, 1, 0, marketText, bgcolor=color.new(marketColor, 15), text_color=color.white)

    table.cell(dashboard, 0, 1, "LONG", text_color=color.white)

    table.cell(dashboard, 1, 1, str.tostring(upProbability, "#.0") + "%", text_color=color.lime)

    table.cell(dashboard, 0, 2, "SHORT", text_color=color.white)

    table.cell(dashboard, 1, 2, str.tostring(downProbability, "#.0") + "%", text_color=color.red)

    table.cell(dashboard, 0, 3, "ADX", text_color=color.white)

    table.cell(dashboard, 1, 3, str.tostring(adxValue, "#.0"), text_color=adxValue >= 25 ? color.lime : color.orange)

    table.cell(dashboard, 0, 4, "RSI", text_color=color.white)

    table.cell(dashboard, 1, 4, str.tostring(rsiValue, "#.0"), text_color=color.white)

    table.cell(dashboard, 0, 5, "TP SOURCE", text_color=color.white)

    table.cell(dashboard, 1, 5, tpSource, text_color=color.aqua)

    table.cell(dashboard, 0, 6, "EDGE", text_color=color.white)

    table.cell(dashboard, 1, 6, neutralMarket ? "NO EDGE" : str.tostring(dominantProbability, "#.0") + "%", text_color=neutralMarket ? color.orange : color.lime)

//====================================================================
// ALERTS
//====================================================================

bullAlert = not neutralMarket and bullishBias and upProbability >= minDirectionProb

bearAlert = not neutralMarket and bearishBias and downProbability >= minDirectionProb

alertcondition(bullAlert, "Bullish TP Finder", "Bullish TP target detected")

alertcondition(bearAlert, "Bearish TP Finder", "Bearish TP target detected")