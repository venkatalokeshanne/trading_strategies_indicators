            int originTime = array.get(fanOriginTimes, fanIndex)
            float endPrice = array.get(fanEndPrices, fanIndex)
            int endTime = array.get(fanEndTimes, fanIndex)
            int cutoffTime = array.get(fanCutoffTimes, fanIndex)
            int fanDisplayEndTime = na(cutoffTime) ? time : cutoffTime
            int age = visibleFanCount - 1 - fanIndex
