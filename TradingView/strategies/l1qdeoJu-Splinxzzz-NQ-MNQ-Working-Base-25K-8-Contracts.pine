//@version=6
strategy(
     "Splinxzzz NQ-MNQ Working Base 25K 8 Contracts",
     overlay=true,
     initial_capital=25000,
     default_qty_type=strategy.fixed,
     default_qty_value=8,
     pyramiding=0,
     process_orders_on_close=true,
     calc_on_order_fills=true,
     margin_long=1,
     margin_short=1
)
pivotLen = input.int(3, "Pivot Length", minval=2)
zonePad = input.float(1.5, "Zone Pad", step=0.25)
rr = input.float(1.8, "Risk Reward", step=0.1)
emaLen = input.int(20, "EMA Length", minval=1)
dispATR = input.float(0.2, "Displacement ATR", step=0.1)
chopATR = input.float(1.2, "Chop ATR", step=0.1)
sweepLookback = input.int(6, "Sweep Lookback", minval=2)
maxDailyLossUSD = input.float(900.0, "Daily Loss Limit", step=25.0)
// core
atr = ta.atr(14)
emaVal = ta.ema(close, emaLen)
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)
// zones
var float demandTop = na
var float demandBot = na
var float supplyTop = na
var float supplyBot = na
if not na(pl)
    demandTop := pl + zonePad
    demandBot := pl - zonePad
if not na(ph)
    supplyTop := ph + zonePad
    supplyBot := ph - zonePad
// daily control
isNewDay = ta.change(time("D")) != 0
var float dayStartProfit = na
if na(dayStartProfit)
    dayStartProfit := strategy.netprofit
if isNewDay
    dayStartProfit := strategy.netprofit
dailyPnL = strategy.netprofit - dayStartProfit
killSwitch = dailyPnL <= -maxDailyLossUSD
// sweeps
prevLow = ta.lowest(low, sweepLookback)[1]
prevHigh = ta.highest(high, sweepLookback)[1]
bullSweep = low < prevLow and close > prevLow
bearSweep = high > prevHigh and close < prevHigh
bullAttempt = low < low[1] and close > open
bearAttempt = high > high[1] and close < open
// filters
priceRange = ta.highest(high, 20) - ta.lowest(low, 20)
notChop = priceRange > atr * chopATR
bullDisp = close > open and (close - open) > atr * dispATR
bearDisp = close < open and (open - close) > atr * dispATR
bullBias = close > emaVal
bearBias = close < emaVal
// rejection
bullReject =
     not na(demandTop) and
     low <= demandTop and
     close > demandTop
bearReject =
     not na(supplyBot) and
     high >= supplyBot and
     close < supplyBot
// entry conditions
longCond =
     not killSwitch and
     bullReject and
     (bullSweep or bullAttempt) and
     bullDisp and
     bullBias and
     notChop
shortCond =
     not killSwitch and
     bearReject and
     (bearSweep or bearAttempt) and
     bearDisp and
     bearBias and
     notChop
// orders
if longCond and strategy.position_size <= 0
    stopLong = demandBot
    riskLong = close - stopLong
    if riskLong > syminfo.mintick
        tpLong = close + riskLong * rr
        strategy.entry("LONG", strategy.long, qty=8)
        strategy.exit("L EXIT", from_entry="LONG", stop=stopLong, limit=tpLong)
if shortCond and strategy.position_size >= 0
    stopShort = supplyTop
    riskShort = stopShort - close
    if riskShort > syminfo.mintick
        tpShort = close - riskShort * rr
        strategy.entry("SHORT", strategy.short, qty=8)
        strategy.exit("S EXIT", from_entry="SHORT", stop=stopShort, limit=tpShort)
// hard daily stop
if killSwitch and strategy.position_size > 0
    strategy.close("LONG")
if killSwitch and strategy.position_size < 0
    strategy.close("SHORT")
// visuals
plot(demandTop, title="Demand Top", color=color.green, linewidth=2)
plot(demandBot, title="Demand Bottom", color=color.green, linewidth=2)
plot(supplyTop, title="Supply Top", color=color.red, linewidth=2)
plot(supplyBot, title="Supply Bottom", color=color.red, linewidth=2)
plotshape(longCond, title="Long Signal", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small)
plotshape(shortCond, title="Short Signal", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small)
plotchar(killSwitch, title="Daily Loss Hit", char="X", location=location.top, color=color.red, size=size.tiny)