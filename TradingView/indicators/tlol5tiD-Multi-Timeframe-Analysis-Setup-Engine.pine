//@version=6
indicator("Multi Timeframe Analysis & Setup Engine", shorttitle="MTF Setup Engine v6", overlay=true)

// ==========================================
// 1. INPUT PARAMETERS & GROUPS
// ==========================================

// --- Group: Macro Higher Timeframe (4H / Daily) Settings ---
gp_htf1 = "1. Macro Higher Timeframe (Macro HTF)"
htf1Timeframe   = input.timeframe("240", "Macro HTF Timeframe", group=gp_htf1, tooltip="Primary HTF for ADX and Trend Direction analysis (e.g. 240 for 4H, D for Daily).")
useHtfAdxFilter = input.bool(false, "Require Macro HTF ADX > 25 Filter", group=gp_htf1, tooltip="If disabled (recommended for early trend entries), signals won't be blocked when ADX is still building below 25.")
adxLength       = input.int(14, "ADX / DMI Length", minval=1, group=gp_htf1)
adxSmoothing    = input.int(14, "ADX Smoothing", minval=1, group=gp_htf1)
adxThreshold    = input.int(25, "ADX Trend Strength Threshold", minval=1, group=gp_htf1)
useHtf1EmaFilter= input.bool(true, "Use Macro HTF EMA for Trend ID", group=gp_htf1, tooltip="Require Macro HTF Close > 200 EMA for Macro Bullish Trend Identification.")
htf1EmaLength   = input.int(200, "Macro HTF EMA Length", minval=1, group=gp_htf1)

// --- Group: Intermediate Timeframe (1H) Alignment Settings ---
gp_itf = "2. Intermediate Timeframe (1H Alignment)"
useItfFilter    = input.bool(true, "Require Intermediate HTF Alignment", group=gp_itf, tooltip="Require 1H trend alignment to prevent counter-trend entries into 1H pullbacks.")
itfTimeframe    = input.timeframe("60", "Intermediate Timeframe (ITF)", group=gp_itf)
itfEmaLength    = input.int(50, "ITF EMA Length", minval=1, group=gp_itf)

// --- Group: Execution & Signal Trigger Mode ---
gp_ltf = "3. Execution & Signal Trigger Engine"
signalMode      = input.string("Both (Impulse + Retest)", "Entry Signal Mode", options=["3-Bar Reversal Retest (SMC)", "SMC CHoCH + Triple EMA Sweep", "Golden Cross + 200 EMA Retest", "Early Impulse (20x50 Cross)", "Post-Cross Retest", "Both (Impulse + Retest)", "Stochastic Pullback Only"], group=gp_ltf, tooltip="3-Bar Reversal Retest: Requires CHoCH/BoS, price pullback to EMA support, and a 3-bar reversal pattern confirmation.")
retestMaxBars   = input.int(15, "Max Bars After 20x50 Cross for Retest", minval=1, group=gp_ltf)
swingLength     = input.int(5, "CHoCH Swing Length", minval=1, group=gp_ltf, tooltip="Lookback bars to detect Change of Character (CHoCH) swing high/low breaks.")

use3BarReversal = input.bool(true, "Require 3-Bar Reversal Pattern on Retests", group=gp_ltf, tooltip="Bar 1: Drop into EMA support, Bar 2: Sweeps lower low into EMA, Bar 3: Strong green candle breaking & closing above Bar 2 high.")
useLtfEmaFilter = input.bool(true, "Require Price > LTF 20 EMA for Longs", group=gp_ltf, tooltip="Ensures price is above fast EMA.")
ltfEmaLength    = input.int(20, "LTF Fast EMA Length", minval=1, group=gp_ltf)

// --- Stochastic Oscillator Settings ---
stochKLength    = input.int(14, "%K Length", minval=1, group=gp_ltf)
stochKSmooth    = input.int(3, "%K Smoothing", minval=1, group=gp_ltf)
stochDSmooth    = input.int(3, "%D Smoothing", minval=1, group=gp_ltf)
stochOversold   = input.float(20.0, "Oversold Threshold (Buy Zone)", minval=0.0, maxval=50.0, group=gp_ltf)
stochOverbought = input.float(80.0, "Overbought Threshold (Sell Zone)", minval=50.0, maxval=100.0, group=gp_ltf)

useRsiFilter    = input.bool(true, "Require LTF RSI Momentum Confirmation", group=gp_ltf)
rsiLength       = input.int(14, "RSI Length", minval=1, group=gp_ltf)
rsiMinBull      = input.float(45.0, "Min RSI for Long Setup", minval=0.0, maxval=100.0, group=gp_ltf)
rsiMaxBear      = input.float(55.0, "Max RSI for Short Setup", minval=0.0, maxval=100.0, group=gp_ltf)

useCandleFilter = input.bool(false, "Require Reversal Candle Breakout (Close > High[1])", group=gp_ltf, tooltip="Set to false to allow simple green candle (Close > Open) entries.")

// --- Group: Visual & Plot Settings ---
gp_vis = "Visuals & Chart Plotting"
showTable       = input.bool(true, "Show MTF Dashboard Table", group=gp_vis)
tablePosition   = input.string("Top Right", "Table Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=gp_vis)
showEma20       = input.bool(true, "Plot 20 EMA (Light Blue)", group=gp_vis)
showEma50       = input.bool(true, "Plot 50 EMA (Red)", group=gp_vis)
showEma200      = input.bool(true, "Plot 200 EMA (Green)", group=gp_vis)
showHtfEmaOnHtf = input.bool(true, "Plot Macro HTF 200 EMA (On HTF Charts Only)", group=gp_vis)
showPureEmaCross= input.bool(true, "Plot Pure 20x50 EMA Crossovers (Diamonds)", group=gp_vis)
showSignals     = input.bool(true, "Plot Buy/Sell Signals on Chart", group=gp_vis)
showBgColor     = input.bool(true, "Highlight Chart BG on Strong HTF Trend", group=gp_vis)

// --- Group: Colors ---
gp_col = "Color Theme"
colorEma20      = input.color(color.new(#00bcd4, 0), "20 EMA (Light Blue)", group=gp_col)
colorEma50      = input.color(color.new(#f23645, 0), "50 EMA (Red)", group=gp_col)
colorEma200     = input.color(color.new(#089981, 0), "200 EMA (Green)", group=gp_col)
colorBull       = input.color(color.new(#089981, 0), "Bullish Signal Color", group=gp_col)
colorBear       = input.color(color.new(#f23645, 0), "Bearish Signal Color", group=gp_col)
colorNeutral    = input.color(color.new(#787b86, 0), "Neutral Color", group=gp_col)

// ==========================================
// 2. HIGHER TIMEFRAME (HTF) DATA CALCULATIONS
// ==========================================

// Function to calculate Macro HTF indicators
f_htf1_calc() =>
    [plus_di, minus_di, adx] = ta.dmi(adxLength, adxSmoothing)
    ema_val = ta.ema(close, htf1EmaLength)
    [adx, plus_di, minus_di, ema_val, close]

// Fetch non-repainting Macro HTF data
[htf1_adx, htf1_plus_di, htf1_minus_di, htf1_ema, htf1_close] = request.security(
     syminfo.tickerid, 
     htf1Timeframe, 
     f_htf1_calc(), 
     gaps = barmerge.gaps_off, 
     lookahead = barmerge.lookahead_off
 )

// Function to calculate Intermediate HTF indicators
f_itf_calc() =>
    [plus_di, minus_di, adx] = ta.dmi(adxLength, adxSmoothing)
    ema_val = ta.ema(close, itfEmaLength)
    [plus_di, minus_di, ema_val, close]

// Fetch non-repainting Intermediate HTF data
[itf_plus_di, itf_minus_di, itf_ema, itf_close] = request.security(
     syminfo.tickerid, 
     itfTimeframe, 
     f_itf_calc(), 
     gaps = barmerge.gaps_off, 
     lookahead = barmerge.lookahead_off
 )

// Macro HTF Trend Evaluators (Used strictly for Macro Trend Identification)
isHtf1StrongTrend = not useHtfAdxFilter or (htf1_adx >= adxThreshold)
isHtf1Bullish     = isHtf1StrongTrend and (htf1_plus_di > htf1_minus_di) and (not useHtf1EmaFilter or htf1_close > htf1_ema)
isHtf1Bearish     = isHtf1StrongTrend and (htf1_minus_di > htf1_plus_di) and (not useHtf1EmaFilter or htf1_close < htf1_ema)

// Intermediate HTF Evaluators
isItfBullish     = not useItfFilter or ((itf_plus_di >= itf_minus_di) and (itf_close > itf_ema))
isItfBearish     = not useItfFilter or ((itf_minus_di >= itf_plus_di) and (itf_close < itf_ema))

// ==========================================
// 3. LTF 20/50/200 EMA & 3-BAR REVERSAL ENGINE
// ==========================================

// Current Chart Visual EMAs (20, 50, 200)
chartEma20  = ta.ema(close, 20)
chartEma50  = ta.ema(close, 50)
chartEma200 = ta.ema(close, 200)

// Triple EMA Stack (20 > 50 > 200)
isTripleEmaBull = (chartEma20 > chartEma50) and (chartEma50 > chartEma200)
isTripleEmaBear = (chartEma20 < chartEma50) and (chartEma50 < chartEma200)

// 20 x 50 EMA Crossovers
ema20_x_50_bull = ta.crossover(chartEma20, chartEma50)
ema20_x_50_bear = ta.crossunder(chartEma20, chartEma50)
isEma20Above50  = chartEma20 > chartEma50
isEma20Below50  = chartEma20 < chartEma50

barsSinceCrossUp = ta.barssince(ema20_x_50_bull)
barsSinceCrossDn = ta.barssince(ema20_x_50_bear)

// 200 EMA Baseline Filter
isAbove200Ema = close > chartEma200
isBelow200Ema = close < chartEma200

// --- SMC CHoCH (Change of Character) & Liquidity Sweep Engine ---
swingHigh = ta.highest(high[1], swingLength)
swingLow  = ta.lowest(low[1], swingLength)

chochBull = ta.crossover(close, swingHigh)
chochBear = ta.crossunder(close, swingLow)

var bool hasChochBull = false
var bool hasChochBear = false

if chochBull
    hasChochBull := true
    hasChochBear := false

if chochBear
    hasChochBear := true
    hasChochBull := false

// --- 3-Bar Reversal Pattern Engine (LTF Execution) ---
// Bullish 3-Bar Reversal:
// Bar 1 (close[2]): Drop into EMA support
// Bar 2 (close[1]): Sweeps lower low (low[1] < low[2]) into 20/50/200 EMA
// Bar 3 (close): Strong green candle breaking & closing above Bar 2 high (close > open and close > high[1])
isEmaTouchBull = (low[1] <= chartEma20 or low[1] <= chartEma50 or low[1] <= chartEma200)
isEmaTouchBear = (high[1] >= chartEma20 or high[1] >= chartEma50 or high[1] >= chartEma200)

is3BarReversalBull = (low[1] < low[2]) and (close > open) and (close > high[1]) and isEmaTouchBull
is3BarReversalBear = (high[1] > high[2]) and (close < open) and (close < low[1]) and isEmaTouchBear

// Rejection Wick / Liquidity Sweep Detection on EMA Support/Resistance
lowerWick   = math.min(open, close) - low
upperWick   = high - math.max(open, close)
candleRange = high - low

isSweepRejectionBull = (low <= chartEma20 or low <= chartEma50) and (lowerWick > candleRange * 0.3 or low < low[1]) and (close > open) and (close > chartEma20)
isSweepRejectionBear = (high >= chartEma20 or high >= chartEma50) and (upperWick > candleRange * 0.3 or high > high[1]) and (close < open) and (close < chartEma20)

// SMC Setup: Triple EMA Stack (20 > 50 > 200) + CHoCH + EMA Retest 3-Bar Reversal
choch3BarBull = isTripleEmaBull and hasChochBull and is3BarReversalBull
choch3BarBear = isTripleEmaBear and hasChochBear and is3BarReversalBear

chochSmcBull = isTripleEmaBull and hasChochBull and isSweepRejectionBull
chochSmcBear = isTripleEmaBear and hasChochBear and isSweepRejectionBear

// 1. Early Impulse Signal (Triggers on cross bar OR within 3 bars of cross)
earlyImpulseBull = (ema20_x_50_bull or (not na(barsSinceCrossUp) and barsSinceCrossUp <= 3)) and (close > open)
earlyImpulseBear = (ema20_x_50_bear or (not na(barsSinceCrossDn) and barsSinceCrossDn <= 3)) and (close < open)

// 2. Post-Cross Retest / Consolidation Signal (Price tests 20, 50 or 200 EMA support after recent cross)
retestBull = isEma20Above50 and (not na(barsSinceCrossUp) and barsSinceCrossUp <= retestMaxBars) and (low <= chartEma20 or low <= chartEma50 or low <= chartEma200) and (close > chartEma20) and (close > open)
retestBear = isEma20Below50 and (not na(barsSinceCrossDn) and barsSinceCrossDn <= retestMaxBars) and (high >= chartEma20 or high >= chartEma50 or high >= chartEma200) and (close < chartEma20) and (close < open)

// 3. Golden Cross + 200 EMA Retest Signal (20x50 Cross + Close > 200 EMA + Retest of 20/50/200 EMA)
goldenRetestBull = isEma20Above50 and isAbove200Ema and (low <= chartEma20 or low <= chartEma50 or low <= chartEma200) and (close > chartEma20) and (close > open)
deathRetestBear  = isEma20Below50 and isBelow200Ema and (high >= chartEma20 or high >= chartEma50 or high >= chartEma200) and (close < chartEma20) and (close < open)

// 4. Stochastic Crossover Trigger
stoch_raw = ta.stoch(close, high, low, stochKLength)
stoch_k   = ta.sma(stoch_raw, stochKSmooth)
stoch_d   = ta.sma(stoch_k, stochDSmooth)

isStochOversold   = stoch_k <= stochOversold
isStochOverbought = stoch_k >= stochOverbought

stochBullCross = ta.crossover(stoch_k, stoch_d) and (stoch_k <= stochOversold or stoch_k[1] <= stochOversold)
stochBearCross = ta.crossunder(stoch_k, stoch_d) and (stoch_k >= stochOverbought or stoch_k[1] >= stochOverbought)

// Filters
ltfEma = ta.ema(close, ltfEmaLength)
ltfRsi = ta.rsi(close, rsiLength)

isLtfEmaBull = not useLtfEmaFilter or (close > ltfEma)
isLtfEmaBear = not useLtfEmaFilter or (close < ltfEma)

isLtfRsiBull = not useRsiFilter or (ltfRsi >= rsiMinBull)
isLtfRsiBear = not useRsiFilter or (ltfRsi <= rsiMaxBear)

isBullCandle = not useCandleFilter or (use3BarReversal ? is3BarReversalBull : (close > open and close > high[1]))
isBearCandle = not useCandleFilter or (use3BarReversal ? is3BarReversalBear : (close < open and close < low[1]))

// Active Trigger Evaluation based on Selected Signal Mode
bool ltfTriggerBull = false
bool ltfTriggerBear = false

if signalMode == "3-Bar Reversal Retest (SMC)"
    ltfTriggerBull := choch3BarBull
    ltfTriggerBear := choch3BarBear
else if signalMode == "SMC CHoCH + Triple EMA Sweep"
    ltfTriggerBull := chochSmcBull
    ltfTriggerBear := chochSmcBear
else if signalMode == "Golden Cross + 200 EMA Retest"
    ltfTriggerBull := goldenRetestBull
    ltfTriggerBear := deathRetestBear
else if signalMode == "Early Impulse (20x50 Cross)"
    ltfTriggerBull := earlyImpulseBull
    ltfTriggerBear := earlyImpulseBear
else if signalMode == "Post-Cross Retest"
    ltfTriggerBull := retestBull
    ltfTriggerBear := retestBear
else if signalMode == "Both (Impulse + Retest)"
    ltfTriggerBull := choch3BarBull or chochSmcBull or goldenRetestBull or earlyImpulseBull or retestBull or stochBullCross
    ltfTriggerBear := choch3BarBear or chochSmcBear or deathRetestBear or earlyImpulseBear or retestBear or stochBearCross
else // "Stochastic Pullback Only"
    ltfTriggerBull := stochBullCross
    ltfTriggerBear := stochBearCross

// ==========================================
// 4. CONFLUENCE ENTRY SETUP LOGIC
// ==========================================

longSetup  = isHtf1Bullish and isItfBullish and ltfTriggerBull and isLtfEmaBull and isLtfRsiBull and isBullCandle
shortSetup = isHtf1Bearish and isItfBearish and ltfTriggerBear and isLtfEmaBear and isLtfRsiBear and isBearCandle

// ==========================================
// 5. CHART PLOTTING & VISUALS
// ==========================================

// Always-present Unconditional Plot Anchor (Ensures Pine Script Compiler CE10246 Output Requirement)
plot(close, title="Indicator Anchor", display=display.none)

// Visual Trend EMAs on Current Chart (20 = Light Blue, 50 = Red, 200 = Green)
plot(showEma20 ? chartEma20 : na, title="20 EMA (Light Blue)", color=colorEma20, linewidth=1)
plot(showEma50 ? chartEma50 : na, title="50 EMA (Red)", color=colorEma50, linewidth=2)
plot(showEma200 ? chartEma200 : na, title="200 EMA (Green)", color=colorEma200, linewidth=2)

// Plot Macro HTF 200 EMA Line ONLY when viewing the HTF chart itself (e.g. 4H or Daily)
bool isHtfChart = timeframe.period == htf1Timeframe or (timeframe.isintraday and timeframe.multiplier >= 240) or timeframe.isdaily or timeframe.isweekly
plot(showHtfEmaOnHtf and isHtfChart ? htf1_ema : na, title="Macro HTF 200 EMA (HTF Only)", color=color.new(#2962ff, 0), linewidth=2, style=plot.style_circles)

// Pure 20/50 EMA Crossover Visual Markers (Diamond shapes plotted on EVERY 20x50 cross)
plotshape(showPureEmaCross and ema20_x_50_bull, title="Pure 20x50 Golden Cross", style=shape.diamond, location=location.belowbar, color=color.new(#00bcd4, 0), size=size.small, text="20x50")
plotshape(showPureEmaCross and ema20_x_50_bear, title="Pure 20x50 Death Cross", style=shape.diamond, location=location.abovebar, color=color.new(#f23645, 0), size=size.small, text="20x50")

// Plot Setup Signals (Full Confluence EARLY BUY / EARLY SELL)
plotshape(showSignals and longSetup, title="Long Entry Signal", style=shape.triangleup, location=location.belowbar, color=colorBull, size=size.small, text="EARLY BUY")
plotshape(showSignals and shortSetup, title="Short Entry Signal", style=shape.triangledown, location=location.abovebar, color=colorBear, size=size.small, text="EARLY SELL")

// Background Tint for Strong Trend Alignment
bgcolor(showBgColor and isHtf1Bullish and isItfBullish ? color.new(colorBull, 90) : showBgColor and isHtf1Bearish and isItfBearish ? color.new(colorBear, 90) : na, title="Trend BG Highlight")

// ==========================================
// 6. 4-COLUMN DASHBOARD MATRIX TABLE (PINE V6)
// ==========================================

f_getTablePosition(string pos) =>
    switch pos
        "Top Right"    => position.top_right
        "Bottom Right" => position.bottom_right
        "Top Left"     => position.top_left
        "Bottom Left"  => position.bottom_left
        => position.top_right

var table mtfTable = table.new(f_getTablePosition(tablePosition), 4, 10, bgcolor=color.new(#1e222d, 10), border_width=1, border_color=color.new(#363a45, 0))

if showTable and barstate.islast
    // Header (Column 0: Timeframe | Column 1: Matrix Item | Column 2: Status / Value | Column 3: Setup)
    table.cell(mtfTable, 0, 0, "Timeframe", bgcolor=color.new(#2a2e39, 0), text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 0, "Matrix Item", bgcolor=color.new(#2a2e39, 0), text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 2, 0, "Status / Value", bgcolor=color.new(#2a2e39, 0), text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 0, "Setup", bgcolor=color.new(#2a2e39, 0), text_color=color.white, text_size=size.small)

    // Row 1: Macro HTF ADX (e.g. 4H)
    string adxText = not useHtfAdxFilter ? str.tostring(htf1_adx, "#.#") + " (Filter Off)" : str.tostring(htf1_adx, "#.#") + (isHtf1StrongTrend ? " (Strong)" : " (Weak)")
    table.cell(mtfTable, 0, 1, htf1Timeframe, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 1, "Macro ADX (" + str.tostring(adxThreshold) + "+)", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 2, 1, adxText, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 1, isHtf1StrongTrend ? "PASS" : "FAIL", bgcolor=isHtf1StrongTrend ? color.new(#ff9800, 20) : color.new(colorNeutral, 60), text_color=color.white, text_size=size.small)

    // Row 2: Macro HTF Bias (DMI & EMA) - Used for Trend ID only
    table.cell(mtfTable, 0, 2, htf1Timeframe, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 2, "Macro Bias (ID)", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 2, 2, htf1_plus_di > htf1_minus_di ? "+DI > -DI (Above EMA)" : "-DI > +DI (Below EMA)", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 2, isHtf1Bullish ? "BULLISH" : isHtf1Bearish ? "BEARISH" : "NEUTRAL", bgcolor=isHtf1Bullish ? color.new(colorBull, 30) : isHtf1Bearish ? color.new(colorBear, 30) : color.new(colorNeutral, 60), text_color=color.white, text_size=size.small)

    // Row 3: Intermediate HTF Alignment (e.g. 1H)
    table.cell(mtfTable, 0, 3, itfTimeframe, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 3, "Intermed Trend", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 2, 3, itf_close > itf_ema ? "Close > " + str.tostring(itfEmaLength) + " EMA" : "Close < " + str.tostring(itfEmaLength) + " EMA", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 3, isItfBullish ? "BULLISH" : isItfBearish ? "BEARISH" : "FAIL", bgcolor=isItfBullish ? color.new(colorBull, 40) : isItfBearish ? color.new(colorBear, 40) : color.new(colorNeutral, 60), text_color=color.white, text_size=size.small)

    // Row 4: Triple EMA Stack & 3-Bar Reversal Status
    string tripleText = choch3BarBull ? "3-Bar Reversal Bull Retest!" : choch3BarBear ? "3-Bar Reversal Bear Retest!" : isTripleEmaBull ? "20 > 50 > 200 (Triple Bull Stack)" : isTripleEmaBear ? "20 < 50 < 200 (Triple Bear Stack)" : "EMAs Mixed"
    color tripleBg = (choch3BarBull or isTripleEmaBull) ? color.new(colorBull, 30) : (choch3BarBear or isTripleEmaBear) ? color.new(colorBear, 30) : color.new(colorNeutral, 60)
    table.cell(mtfTable, 0, 4, timeframe.period, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 4, "Triple EMA & 3-Bar", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 2, 4, tripleText, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 4, choch3BarBull ? "3-BAR BUY" : choch3BarBear ? "3-BAR SELL" : isTripleEmaBull ? "BULL STACK" : isTripleEmaBear ? "BEAR STACK" : "MIXED", bgcolor=tripleBg, text_color=color.white, text_size=size.small)

    // Row 5: LTF Stochastic Oscillator
    table.cell(mtfTable, 0, 5, timeframe.period, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 5, "Stoch (%K / %D)", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 2, 5, "%K: " + str.tostring(stoch_k, "#.#") + " | %D: " + str.tostring(stoch_d, "#.#"), text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 5, stochBullCross ? "BULL CROSS" : stochBearCross ? "BEAR CROSS" : isStochOversold ? "OVERSOLD" : isStochOverbought ? "OVERBOUGHT" : "NEUTRAL", bgcolor=stochBullCross ? colorBull : stochBearCross ? colorBear : isStochOversold ? color.new(colorBull, 40) : isStochOverbought ? color.new(colorBear, 40) : color.new(colorNeutral, 70), text_color=color.white, text_size=size.small)

    // Row 6: LTF 20 EMA Filter
    table.cell(mtfTable, 0, 6, timeframe.period, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 6, "Fast EMA (" + str.tostring(ltfEmaLength) + ")", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 2, 6, close > ltfEma ? "Close > " + str.tostring(ltfEma, "#.##") : "Close < " + str.tostring(ltfEma, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 6, isLtfEmaBull ? "BULL PASS" : isLtfEmaBear ? "BEAR PASS" : "FAIL", bgcolor=isLtfEmaBull ? color.new(colorBull, 40) : isLtfEmaBear ? color.new(colorBear, 40) : color.new(colorNeutral, 60), text_color=color.white, text_size=size.small)

    // Row 7: LTF RSI Filter (Explicit Value & Status)
    table.cell(mtfTable, 0, 7, timeframe.period, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 7, "RSI (" + str.tostring(rsiLength) + ")", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 2, 7, "RSI: " + str.tostring(ltfRsi, "#.#"), text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 7, isLtfRsiBull ? "PASS (>=" + str.tostring(rsiMinBull, "#") + ")" : isLtfRsiBear ? "PASS (<=" + str.tostring(rsiMaxBear, "#") + ")" : "FAIL", bgcolor=isLtfRsiBull ? color.new(colorBull, 40) : isLtfRsiBear ? color.new(colorBear, 40) : color.new(colorNeutral, 60), text_color=color.white, text_size=size.small)

    // Row 8: Price Action Reversal Pattern
    string candleText = is3BarReversalBull ? "3-Bar Bull Reversal" : is3BarReversalBear ? "3-Bar Bear Reversal" : close > open ? "Green (C > O)" : "Red (C < O)"
    table.cell(mtfTable, 0, 8, timeframe.period, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 8, "Reversal Pattern", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 2, 8, candleText, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 8, isBullCandle ? "BULL PASS" : isBearCandle ? "BEAR PASS" : "WAITING", bgcolor=isBullCandle ? color.new(colorBull, 40) : isBearCandle ? color.new(colorBear, 40) : color.new(colorNeutral, 60), text_color=color.white, text_size=size.small)

    // Row 9: Final Confluence State
    string setupText = longSetup ? "🟢 EARLY LONG READY" : shortSetup ? "🔴 EARLY SHORT READY" : (isHtf1Bullish and isItfBullish) ? "WAITING FOR 3-BAR RETEST" : (isHtf1Bearish and isItfBearish) ? "WAITING FOR 3-BAR RETEST" : "NO TREND CONFLUENCE"
    color setupBgColor = longSetup ? colorBull : shortSetup ? colorBear : color.new(#2a2e39, 0)
    table.cell(mtfTable, 0, 9, "All TF", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 9, "Overall Confluence", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 2, 9, longSetup or shortSetup ? "3-Bar Entry Triggered!" : "Waiting for Setup", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 9, setupText, bgcolor=setupBgColor, text_color=color.white, text_size=size.small)

// ==========================================
// 7. ALERT ENGINE
// ==========================================

alertcondition(longSetup, title="MTF Early Long Setup Triggered", message="🟢 MTF EARLY LONG SETUP: 3-Bar Reversal Retest after CHoCH & Triple EMA Alignment on {{ticker}} at {{close}}")
alertcondition(shortSetup, title="MTF Early Short Setup Triggered", message="🔴 MTF EARLY SHORT SETUP: 3-Bar Reversal Retest after CHoCH & Triple EMA Alignment on {{ticker}} at {{close}}")

if longSetup
    alert('{"event": "EARLY_LONG_SETUP", "ticker": "' + syminfo.ticker + '", "price": ' + str.tostring(close) + ', "htf_adx": ' + str.tostring(htf1_adx) + ', "ema20": ' + str.tostring(chartEma20) + ', "ema50": ' + str.tostring(chartEma50) + ', "ema200": ' + str.tostring(chartEma200) + '}', alert.freq_once_per_bar_close)

if shortSetup
    alert('{"event": "EARLY_SHORT_SETUP", "ticker": "' + syminfo.ticker + '", "price": ' + str.tostring(close) + ', "htf_adx": ' + str.tostring(htf1_adx) + ', "stoch_k": ' + str.tostring(stoch_k) + ', "ema20": ' + str.tostring(chartEma20) + ', "ema50": ' + str.tostring(chartEma50) + ', "ema200": ' + str.tostring(chartEma200) + '}', alert.freq_once_per_bar_close)
