//@version=6
indicator(title="Anchored VWAP — Session Opens (Globex / EU / US)", shorttitle="AVWAP Sessions", overlay=true)

// ─────────────────────────────────────────────────────────────────────────────
// Anchored VWAP that RE-ANCHORS automatically every day at a chosen session time.
// Unlike a normal session VWAP (resets at the data-feed's daily boundary), each
// line here starts its cumulative Σ(price·vol)/Σ(vol) at an exact clock time you
// pick, expressed in the timezone below. Three independent lines in one script.
// Intended for intraday charts — on 1D and above the hour/minute anchor is
// meaningless, so the lines are hidden there.
// ─────────────────────────────────────────────────────────────────────────────

// ── General ──────────────────────────────────────────────────────────────────
GEN = "General"
tz     = input.string("GMT+8", "Timezone", group = GEN,
     tooltip = "Timezone for the anchor clock times below. GMT+8 = your local. Use e.g. 'America/New_York' or 'GMT-5' for other references.")
src    = input(hlc3, "Source", group = GEN)
hideDWM = input.bool(true, "Hide on 1D and above", group = GEN,
     tooltip = "Anchoring by clock time only makes sense intraday.")

// ── Band (single, shared by all three lines) ─────────────────────────────────
BAND = "Band (Standard Deviation)"
showBand = input.bool(true, "Show band", group = BAND)
bandMult = input.float(1.0, "Std-Dev Multiplier", minval = 0, step = 0.5, group = BAND,
     tooltip = "Band width = this many standard deviations from the anchored VWAP.")

// ── Session anchors ──────────────────────────────────────────────────────────
S_GLOBEX = "Globex anchor"
showGlobex = input.bool(true, "Show Globex VWAP", group = S_GLOBEX)
gH = input.int(6, "Hour",   minval = 0, maxval = 23, inline = "g", group = S_GLOBEX)
gM = input.int(0, "Minute", minval = 0, maxval = 59, inline = "g", group = S_GLOBEX)
gCol = input.color(color.yellow, "Color", group = S_GLOBEX)

S_EU = "EU Open anchor"
showEU = input.bool(true, "Show EU Open VWAP", group = S_EU)
eH = input.int(14, "Hour",   minval = 0, maxval = 23, inline = "e", group = S_EU)
eM = input.int(0,  "Minute", minval = 0, maxval = 59, inline = "e", group = S_EU)
eCol = input.color(color.white, "Color", group = S_EU)

S_US = "US Open anchor"
showUS = input.bool(true, "Show US Open VWAP", group = S_US)
uH = input.int(21, "Hour",   minval = 0, maxval = 23, inline = "u", group = S_US)
uM = input.int(30, "Minute", minval = 0, maxval = 59, inline = "u", group = S_US)
uCol = input.color(#E91E63, "Color", group = S_US)

// ── Anchor detection ─────────────────────────────────────────────────────────
// True on the first bar at/after the given h:m (in tz) each day. Compares this
// bar's timestamp to today's anchor timestamp and fires on the crossing.
f_anchor(h, m) =>
    at = timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), h, m, 0)
    na(time[1]) ? false : (time >= at and time[1] < at)

hide = hideDWM and timeframe.isdwm

anchorG = not hide and showGlobex and f_anchor(gH, gM)
anchorE = not hide and showEU     and f_anchor(eH, eM)
anchorU = not hide and showUS     and f_anchor(uH, uM)

// ── VWAP + std-dev bands (built-in handles the accumulation & reset) ─────────
[vwapG, upG, loG] = ta.vwap(src, anchorG, bandMult)
[vwapE, upE, loE] = ta.vwap(src, anchorE, bandMult)
[vwapU, upU, loU] = ta.vwap(src, anchorU, bandMult)

showG = showGlobex and not hide
showE = showEU     and not hide
showU = showUS     and not hide

bandG = showBand and showG
bandE = showBand and showE
bandU = showBand and showU

// ── Plots: Globex ────────────────────────────────────────────────────────────
plot(showG ? vwapG : na, "Globex VWAP", color = gCol, linewidth = 2)
gu = plot(bandG ? upG : na, "Globex Upper", color = color.new(gCol, 60), editable = showBand)
gl = plot(bandG ? loG : na, "Globex Lower", color = color.new(gCol, 60), editable = showBand)
fill(gu, gl, color = color.new(gCol, 92), editable = showBand)

// ── Plots: EU Open ───────────────────────────────────────────────────────────
plot(showE ? vwapE : na, "EU VWAP", color = eCol, linewidth = 2)
eu = plot(bandE ? upE : na, "EU Upper", color = color.new(eCol, 60), editable = showBand)
el = plot(bandE ? loE : na, "EU Lower", color = color.new(eCol, 60), editable = showBand)
fill(eu, el, color = color.new(eCol, 92), editable = showBand)

// ── Plots: US Open ───────────────────────────────────────────────────────────
plot(showU ? vwapU : na, "US VWAP", color = uCol, linewidth = 2)
uu = plot(bandU ? upU : na, "US Upper", color = color.new(uCol, 60), editable = showBand)
ul = plot(bandU ? loU : na, "US Lower", color = color.new(uCol, 60), editable = showBand)
fill(uu, ul, color = color.new(uCol, 92), editable = showBand)