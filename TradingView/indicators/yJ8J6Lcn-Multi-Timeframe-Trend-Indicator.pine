//@version=6
indicator("Custom Moving Averages", overlay=true)

// Define Moving Averages
ma20 = ta.sma(close, 20)
ma72 = ta.sma(close, 72)
ma200 = ta.sma(close, 200)
ma420 = ta.sma(close, 420)

// Plot Moving Averages
plot(ma20, color=color.blue, title="20-day MA", linewidth=2)
plot(ma72, color=color.green, title="72-day MA", linewidth=2)
plot(ma200, color=color.red, title="200-day MA", linewidth=2)
plot(ma420, color=color.orange, title="420-day MA", linewidth=2)
