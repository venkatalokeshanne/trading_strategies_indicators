//@version=6
// XCEL build 2026-08-12 - dashboard position + chart overlay; no high-volume bgcolor
indicator("Order Flow PRO - Delta and Imbalance", shorttitle="Best Order Flow Signal", overlay=false, max_bars_back=500)

// Order Flow PRO - Volume Delta and Imbalance
// Developed by the Xcelerate Trade team.
// Estimated delta / imbalance panel - not true bid/ask footprint on most TV symbols.

// ═══════════════════ INPUT SETTINGS ═══════════════════
var g1 = "Volume Delta"
showVolumeDelta = input.bool(true, "Show Volume Delta", group=g1)
showCumulativeDelta = input.bool(true, "Show Cumulative Delta", group=g1)
deltaMA = input.int(20, "Delta MA Period", minval=5, group=g1)

var g2 = "Imbalances"
showImbalances = input.bool(true, "Detect Imbalances", group=g2)
imbalanceThreshold = input.float(0.7, "Imbalance Threshold", minval=0.5, maxval=0.9, step=0.1, group=g2)

var g3 = "Display"
showDivergences = input.bool(true, "Show Price-Delta Divergence Signals", group=g3)
showDashboard = input.bool(true, "Show Dashboard", group=g3)
dashboardOnChart = input.bool(false, "Dashboard on Price Chart", tooltip="When on, the table sits on the main price chart (e.g. top-right). Histogram stays in the indicator pane.", group=g3)
tablePosition = input.string("Top Right", "Dashboard Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=g3)

f_dashboardPosition(string pos) =>
    switch pos
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        "Top Right" => position.top_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right" => position.middle_right
        "Bottom Left" => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right" => position.bottom_right
        => position.top_right

// ═══════════════════ VOLUME DELTA CALCULATION ═══════════════════
volumeDelta = close > open ? volume : (close < open ? -volume : 0)

var float cumulativeDelta = 0.0
cumulativeDelta := cumulativeDelta + volumeDelta

deltaMA_line = ta.sma(volumeDelta, deltaMA)
avgVolume = ta.sma(volume, 50)
isHighVolume = volume > avgVolume * 1.5

// ═══════════════════ NORMALIZATION ═══════════════════
lookback = 100
maxVolDelta = ta.highest(math.abs(volumeDelta), lookback)
maxCumDelta = ta.highest(math.abs(cumulativeDelta), lookback)
cumDeltaNormalized = maxCumDelta > 0 ? (cumulativeDelta / maxCumDelta) * maxVolDelta * 0.8 : 0.0
deltaMA_normalized = deltaMA_line

// ═══════════════════ IMBALANCES DETECTION ═══════════════════
bullImbalance = close > open and volume > 0 and (close - open) / (high - low + 0.0001) > imbalanceThreshold
bearImbalance = close < open and volume > 0 and (open - close) / (high - low + 0.0001) > imbalanceThreshold
bullImbalanceStreak = bullImbalance and bullImbalance[1] and bullImbalance[2]
bearImbalanceStreak = bearImbalance and bearImbalance[1] and bearImbalance[2]

// ═══════════════════ DIVERGENCE DETECTION ═══════════════════
priceHigh = ta.pivothigh(close, 5, 5)
priceLow = ta.pivotlow(close, 5, 5)
deltaLow = ta.pivotlow(volumeDelta, 5, 5)
deltaHigh = ta.pivothigh(volumeDelta, 5, 5)

var bool bearishDivergence = false
var bool bullishDivergence = false

if showDivergences and bar_index > 10
    bearishDivergence := not na(priceHigh) and not na(deltaLow) and close[5] > close[10]
    bullishDivergence := not na(priceLow) and not na(deltaHigh) and close[5] < close[10]

// site message (fixed - not in Settings; mid-script so it is not at file end)
showSitePromo = true
promoIntervalMin = 7
promoHighlightSec = 30
promoMsg = "For more indicators and strategies\nvisit trading.xcelerate.trade"
promoIntervalMs = promoIntervalMin * 60 * 1000
promoVisibleMs = promoHighlightSec * 1000
var table sitePromoTbl = na
varip int promoHiddenAnchorMs = -1
varip int promoVisibleAnchorMs = -1
if showSitePromo and barstate.islast
    if na(sitePromoTbl)
        sitePromoTbl := table.new(position.middle_center, 1, 1, border_width=0, frame_color=color.new(color.black, 100), bgcolor=color.new(color.black, 100))
    nowMs = na(timenow) ? time_close : timenow
    if promoHiddenAnchorMs < 0 and promoVisibleAnchorMs < 0
        promoHiddenAnchorMs := nowMs
    if promoVisibleAnchorMs >= 0
        if nowMs - promoVisibleAnchorMs >= promoVisibleMs
            promoHiddenAnchorMs := nowMs
            promoVisibleAnchorMs := -1
    else
        if promoHiddenAnchorMs >= 0 and nowMs - promoHiddenAnchorMs >= promoIntervalMs
            promoVisibleAnchorMs := nowMs
    showPromoNow = promoVisibleAnchorMs >= 0 and nowMs - promoVisibleAnchorMs < promoVisibleMs
    if showPromoNow
        table.cell(sitePromoTbl, 0, 0, promoMsg, text_color=color.white, text_size=size.large, bgcolor=color.new(color.black, 25), text_halign=text.align_center)
    else
        table.cell(sitePromoTbl, 0, 0, "", bgcolor=color.new(color.black, 100), text_color=color.new(color.white, 100), text_size=size.large)

// ═══════════════════ PLOTTING ═══════════════════
deltaColor = volumeDelta > 0 ? color.new(color.green, 20) : color.new(color.red, 20)
plot(showVolumeDelta ? volumeDelta : na, title="Volume Delta", color=deltaColor, style=plot.style_histogram, linewidth=3)

plot(showVolumeDelta ? deltaMA_normalized : na, title="Delta MA", color=color.new(color.yellow, 0), linewidth=2)

cumDeltaColor = cumDeltaNormalized > cumDeltaNormalized[1] ? color.new(color.lime, 0) : color.new(color.fuchsia, 0)
plot(showCumulativeDelta ? cumDeltaNormalized : na, title="Cumulative Delta (Normalized)", color=cumDeltaColor, linewidth=2)

hline(0, "Zero Line", color=color.new(color.gray, 50), linestyle=hline.style_dashed, linewidth=1)

plotshape(showImbalances and bullImbalanceStreak, title="Buy Imbalance", style=shape.triangleup, location=location.bottom, color=color.new(color.green, 0), size=size.small, text="BUY")
plotshape(showImbalances and bearImbalanceStreak, title="Sell Imbalance", style=shape.triangledown, location=location.top, color=color.new(color.red, 0), size=size.small, text="SELL")

plotshape(showDivergences and bearishDivergence, title="Bearish Divergence", style=shape.xcross, location=location.top, color=color.new(color.red, 0), size=size.normal, text="!")
plotshape(showDivergences and bullishDivergence, title="Bullish Divergence", style=shape.xcross, location=location.bottom, color=color.new(color.green, 0), size=size.normal, text="!")

// ═══════════════════ DASHBOARD ═══════════════════
var table infoTable = na
var string lastTablePosition = na
var bool lastDashboardOnChart = false

if barstate.islast
    if showDashboard
        tablePos = f_dashboardPosition(tablePosition)
        tableLayoutChanged = na(infoTable) or lastTablePosition != tablePosition or lastDashboardOnChart != dashboardOnChart
        if tableLayoutChanged and not na(infoTable)
            table.delete(infoTable)
            infoTable := na
        if na(infoTable)
            if dashboardOnChart
                infoTable := table.new(tablePos, 2, 7, border_color=color.gray, border_width=1, bgcolor=color.new(color.black, 85), force_overlay=true)
            else
                infoTable := table.new(tablePos, 2, 7, border_color=color.gray, border_width=1, bgcolor=color.new(color.black, 85))
            table.cell(infoTable, 0, 0, "ORDER FLOW PRO", bgcolor=color.new(color.blue, 70), text_color=color.white, text_size=size.normal)
            table.merge_cells(infoTable, 0, 0, 1, 0)
            lastTablePosition := tablePosition
            lastDashboardOnChart := dashboardOnChart

        deltaColorTable = volumeDelta > 0 ? color.green : color.red
        table.cell(infoTable, 0, 1, "Delta:", text_color=color.gray, text_size=size.small)
        table.cell(infoTable, 1, 1, str.tostring(math.round(volumeDelta)), text_color=deltaColorTable, text_size=size.small)

        cumColorTable = cumulativeDelta > 0 ? color.green : color.red
        table.cell(infoTable, 0, 2, "Cum. Delta:", text_color=color.gray, text_size=size.small)
        table.cell(infoTable, 1, 2, str.tostring(math.round(cumulativeDelta)), text_color=cumColorTable, text_size=size.small)

        volStatus = isHighVolume ? "HIGH" : "Normal"
        volColorTable = isHighVolume ? color.orange : color.gray
        table.cell(infoTable, 0, 3, "Volume:", text_color=color.gray, text_size=size.small)
        table.cell(infoTable, 1, 3, volStatus, text_color=volColorTable, text_size=size.small)

        pressure = volumeDelta > deltaMA_line * 1.5 ? "BUY" : volumeDelta < -deltaMA_line * 1.5 ? "SELL" : "NEUTRAL"
        pressureColorTable = pressure == "BUY" ? color.green : pressure == "SELL" ? color.red : color.gray
        table.cell(infoTable, 0, 4, "Pressure:", text_color=color.gray, text_size=size.small)
        table.cell(infoTable, 1, 4, pressure, text_color=pressureColorTable, text_size=size.small)

        imbalanceText = bullImbalanceStreak ? "LONG" : bearImbalanceStreak ? "SHORT" : "None"
        imbalanceColorTable = bullImbalanceStreak ? color.green : bearImbalanceStreak ? color.red : color.gray
        table.cell(infoTable, 0, 5, "Imbalance:", text_color=color.gray, text_size=size.small)
        table.cell(infoTable, 1, 5, imbalanceText, text_color=imbalanceColorTable, text_size=size.small)

        signal = bullImbalanceStreak or (volumeDelta > deltaMA_line * 2 and isHighVolume) ? "BULLISH" : bearImbalanceStreak or (volumeDelta < -deltaMA_line * 2 and isHighVolume) ? "BEARISH" : "NEUTRAL"
        signalColorTable = signal == "BULLISH" ? color.green : signal == "BEARISH" ? color.red : color.gray
        table.cell(infoTable, 0, 6, "Signal:", text_color=color.white, text_size=size.normal)
        table.cell(infoTable, 1, 6, signal, text_color=signalColorTable, text_size=size.normal)

    else if not na(infoTable)
        table.delete(infoTable)
        infoTable := na
        lastTablePosition := na
        lastDashboardOnChart := false

// ═══════════════════ ALERTS ═══════════════════
alertcondition(bullImbalanceStreak, "Buy Imbalance", "Strong buying pressure - 3+ consecutive buy imbalances")
alertcondition(bearImbalanceStreak, "Sell Imbalance", "Strong selling pressure - 3+ consecutive sell imbalances")
alertcondition(bearishDivergence, "Bearish Divergence", "Price higher high but Delta lower high - potential reversal")
alertcondition(bullishDivergence, "Bullish Divergence", "Price lower low but Delta higher low - potential reversal")
alertcondition(volumeDelta > deltaMA_line * 3, "Extreme Buying", "Very strong buying pressure detected")
alertcondition(volumeDelta < -deltaMA_line * 3, "Extreme Selling", "Very strong selling pressure detected")
