//@version=6
indicator("Universal MA Trend, Slope Angle and Sideways Filter", overlay = true)

// ─────────────────────────────────────────────────────────────────────────────
// Moving Average Settings
// ─────────────────────────────────────────────────────────────────────────────
groupMA = "Moving Average"

maType = input.string("EMA", "MA Type", options = ["EMA", "SMA"], group = groupMA)
maLength = input.int(50, "MA Length", minval = 1, group = groupMA)

useChartTimeframe = input.bool(true, "Use Current Chart Timeframe", group = groupMA)
customTimeframe = input.timeframe("W", "Alternative MA Timeframe", group = groupMA)

// ─────────────────────────────────────────────────────────────────────────────
// MA Slope Angle Settings
// ─────────────────────────────────────────────────────────────────────────────
groupSlope = "MA Slope Angle"

slopeLookback = input.int(
     5,
     "Slope Calculation Bars",
     minval = 1,
     group = groupSlope)

minimumSlopeAngle = input.float(
     5.0,
     "Minimum Trend Angle (Degrees)",
     minval = 0.0,
     maxval = 89.0,
     step = 0.5,
     group = groupSlope)

atrLength = input.int(
     14,
     "ATR Normalization Length",
     minval = 1,
     group = groupSlope)

useSlopeFilter = input.bool(
     true,
     "Use MA Slope Angle Filter",
     group = groupSlope)

// ─────────────────────────────────────────────────────────────────────────────
// Sideways Market Settings
// ─────────────────────────────────────────────────────────────────────────────
groupSideways = "Sideways Market"

lookbackBars = input.int(
     20,
     "Lookback Bars",
     minval = 2,
     group = groupSideways)

minimumTouches = input.int(
     15,
     "Minimum Touching Bars",
     minval = 1,
     group = groupSideways)

nearTolerancePct = input.float(
     0.0,
     "Distance from MA Tolerance (%)",
     minval = 0.0,
     step = 0.01,
     group = groupSideways)

// ─────────────────────────────────────────────────────────────────────────────
// Colors and Display
// ─────────────────────────────────────────────────────────────────────────────
groupColors = "Colors and Display"

upColor = input.color(color.lime, "Uptrend Color", group = groupColors)
downColor = input.color(color.red, "Downtrend Color", group = groupColors)
sidewaysColor = input.color(color.gray, "Sideways Color", group = groupColors)

showBackground = input.bool(true, "Color Chart Background", group = groupColors)
showLabels = input.bool(true, "Show Trend Change Labels", group = groupColors)

showAngle = input.bool(
     true,
     "Show Current Slope Angle",
     group = groupColors)

// ─────────────────────────────────────────────────────────────────────────────
// Calculation Functions
// ─────────────────────────────────────────────────────────────────────────────
f_ma(_type, _length) =>
    _type == "EMA" ? ta.ema(close, _length) : ta.sma(close, _length)

// Calculate the moving average and ATR on the chart timeframe
chartMA = f_ma(maType, maLength)
chartATR = ta.atr(atrLength)

// Calculate the moving average and ATR on the selected custom timeframe
customMA = request.security(
     syminfo.tickerid,
     customTimeframe,
     f_ma(maType, maLength),
     barmerge.gaps_off,
     barmerge.lookahead_off)

customATR = request.security(
     syminfo.tickerid,
     customTimeframe,
     ta.atr(atrLength),
     barmerge.gaps_off,
     barmerge.lookahead_off)

// Select the required values
selectedMA = useChartTimeframe ? chartMA : customMA
selectedATR = useChartTimeframe ? chartATR : customATR

// ─────────────────────────────────────────────────────────────────────────────
// MA Slope Angle
// ─────────────────────────────────────────────────────────────────────────────
// The MA movement is normalized using ATR.
// This makes the angle more consistent across assets with different prices.
maChange = selectedMA - selectedMA[slopeLookback]

normalizedSlope = (
     not na(selectedATR) and selectedATR > 0.0 ?
     maChange / (selectedATR * slopeLookback) :
     0.0)

slopeAngle = math.atan(normalizedSlope) * 180.0 / math.pi

maRising = slopeAngle >= minimumSlopeAngle
maFalling = slopeAngle <= -minimumSlopeAngle
maFlat = math.abs(slopeAngle) < minimumSlopeAngle

// ─────────────────────────────────────────────────────────────────────────────
// Detect Bars Touching or Near the Moving Average
// ─────────────────────────────────────────────────────────────────────────────
toleranceValue = math.abs(selectedMA) * nearTolerancePct / 100.0

touchesMA = (
     low <= selectedMA + toleranceValue and
     high >= selectedMA - toleranceValue)

touchAverage = ta.sma(touchesMA ? 1.0 : 0.0, lookbackBars)
touchCount = int(math.round(nz(touchAverage, 0.0) * lookbackBars))

enoughBars = (
     bar_index >= math.max(lookbackBars - 1, slopeLookback))

manyTouches = enoughBars and touchCount >= minimumTouches

// The market is sideways when:
// 1. Many bars touch the MA, or
// 2. The MA angle is below the selected minimum angle.
sidewaysTrend = (
     enoughBars and
     (manyTouches or (useSlopeFilter and maFlat)))

// ─────────────────────────────────────────────────────────────────────────────
// Determine Market Direction
// ─────────────────────────────────────────────────────────────────────────────
slopeAllowsUp = not useSlopeFilter or maRising
slopeAllowsDown = not useSlopeFilter or maFalling

upTrend = (
     not sidewaysTrend and
     close > selectedMA and
     slopeAllowsUp)

downTrend = (
     not sidewaysTrend and
     close < selectedMA and
     slopeAllowsDown)

// If the price and slope disagree, classify the condition as neutral/sideways.
neutralTrend = not upTrend and not downTrend

trendState = upTrend ? 1 : downTrend ? -1 : 0

trendColor = (
     upTrend ? upColor :
     downTrend ? downColor :
     sidewaysColor)

trendChanged = trendState != nz(trendState[1], 0)
sidewaysStarted = neutralTrend and not neutralTrend[1]

// ─────────────────────────────────────────────────────────────────────────────
// Chart Display
// ─────────────────────────────────────────────────────────────────────────────
plot(
     selectedMA,
     title = "Moving Average",
     color = trendColor,
     linewidth = 3)

bgcolor(
     showBackground ? color.new(trendColor, 88) : na,
     title = "Market Trend Color")

plotshape(
     showLabels and trendChanged and upTrend,
     title = "Uptrend Started",
     text = "UP",
     style = shape.labelup,
     location = location.belowbar,
     color = upColor,
     textcolor = color.white,
     size = size.tiny)

plotshape(
     showLabels and trendChanged and downTrend,
     title = "Downtrend Started",
     text = "DOWN",
     style = shape.labeldown,
     location = location.abovebar,
     color = downColor,
     textcolor = color.white,
     size = size.tiny)

plotshape(
     showLabels and sidewaysStarted,
     title = "Sideways Market Started",
     text = "SIDEWAYS",
     style = shape.labeldown,
     location = location.abovebar,
     color = sidewaysColor,
     textcolor = color.white,
     size = size.tiny)

// Display the current angle in the status line and Data Window
plot(
     showAngle ? slopeAngle : na,
     title = "MA Slope Angle",
     color = color.new(color.blue, 100),
     display = display.status_line + display.data_window)

// ─────────────────────────────────────────────────────────────────────────────
// Alerts
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(
     upTrend and not upTrend[1],
     title = "Uptrend Started",
     message = "The price is above the moving average and the MA angle confirms an uptrend.")

alertcondition(
     downTrend and not downTrend[1],
     title = "Downtrend Started",
     message = "The price is below the moving average and the MA angle confirms a downtrend.")

alertcondition(
     sidewaysStarted,
     title = "Sideways Market Started",
     message = "The market is sideways because of frequent MA touches or a weak MA slope angle.")