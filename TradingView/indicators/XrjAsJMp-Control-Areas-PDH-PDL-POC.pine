//@version=6
// ============================================================================
//  Control Areas - PDH/PDL/POC Ver. 1.01.1
//  Draws the High, Low and Point of Control of the last CLOSED daily candle.
//  The lines freeze at the daily close and never use the current day
//  (no repainting). POC: 100-row volume profile of the closed day, with
//  volume distributed proportionally to each bar's overlap with each row.
//  Best on timeframes <= 15m, since the profile is built from chart bars.
// ============================================================================
indicator("Control Areas - PDH/PDL/POC", "Control Areas", overlay = true,
     max_lines_count = 8, max_labels_count = 8)

ROWS    = input.int(100, "Profile rows", minval = 20, maxval = 200)
showLbl = input.bool(true, "Price labels")
lblMode = input.string("Full", "Label text",
     options = ["Full", "Abbreviated"])

GL = "Lines"
cH = input.color(color.red, "PDH", inline = "h", group = GL)
wH = input.int(2, "width", minval = 1, maxval = 6, inline = "h", group = GL)
sH = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "h", group = GL)
cL = input.color(color.green, "PDL", inline = "l", group = GL)
wL = input.int(2, "width", minval = 1, maxval = 6, inline = "l", group = GL)
sL = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "l", group = GL)
cP = input.color(color.white, "POC", inline = "p", group = GL)
wP = input.int(2, "width", minval = 1, maxval = 6, inline = "p", group = GL)
sP = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], inline = "p", group = GL)

styleOf(s) =>
    s == "Solid" ? line.style_solid :
     s == "Dashed" ? line.style_dashed : line.style_dotted

// ── current-day accumulation ───────────────────────────────────────────────
var array<float> hs = array.new<float>()
var array<float> ls = array.new<float>()
var array<float> vs = array.new<float>()

var float pdh = na
var float pdl = na
var float poc = na

var line lnH = na
var line lnL = na
var line lnP = na
var label lbH = na
var label lbL = na
var label lbP = na

newDay = timeframe.change("1D")

if newDay and hs.size() > 0
    // -- volume profile of the day that JUST closed -------------------------
    float lo = ls.min()
    float hi = hs.max()
    float step = (hi - lo) / ROWS
    if step > 0
        vol = array.new<float>(ROWS, 0.0)
        for i = 0 to hs.size() - 1
            bl = ls.get(i)
            bh = hs.get(i)
            bv = vs.get(i)
            r0 = math.max(int(math.floor((bl - lo) / step)), 0)
            r1 = math.min(int(math.floor((bh - lo) / step)), ROWS - 1)
            for r = r0 to r1
                lvl = lo + r * step
                prop = bh <= bl ? 1.0 :
                     (math.min(bh, lvl + step) - math.max(bl, lvl)) / (bh - bl)
                vol.set(r, vol.get(r) + bv * prop)
        pocRow = vol.indexof(vol.max())
        poc := lo + (pocRow + 0.5) * step
        pdh := hi
        pdl := lo
    hs.clear()
    ls.clear()
    vs.clear()
    // -- redraw lines -------------------------------------------------------
    if not na(pdh)
        if na(lnH)
            lnH := line.new(bar_index, pdh, bar_index + 1, pdh, extend = extend.right)
            lnL := line.new(bar_index, pdl, bar_index + 1, pdl, extend = extend.right)
            lnP := line.new(bar_index, poc, bar_index + 1, poc, extend = extend.right)
        else
            line.set_xy1(lnH, bar_index, pdh)
            line.set_xy2(lnH, bar_index + 1, pdh)
            line.set_xy1(lnL, bar_index, pdl)
            line.set_xy2(lnL, bar_index + 1, pdl)
            line.set_xy1(lnP, bar_index, poc)
            line.set_xy2(lnP, bar_index + 1, poc)
        line.set_color(lnH, cH)
        line.set_width(lnH, wH)
        line.set_style(lnH, styleOf(sH))
        line.set_color(lnL, cL)
        line.set_width(lnL, wL)
        line.set_style(lnL, styleOf(sL))
        line.set_color(lnP, cP)
        line.set_width(lnP, wP)
        line.set_style(lnP, styleOf(sP))

// accumulate the current bar (AFTER the computation, to keep days separate)
hs.push(high)
ls.push(low)
vs.push(volume)

// ── labels ─────────────────────────────────────────────────────────────────
if showLbl and not na(pdh) and barstate.islast
    if na(lbH)
        lbH := label.new(bar_index + 3, pdh, "", style = label.style_label_left, color = color.new(cH, 70), textcolor = color.white, size = size.small)
        lbL := label.new(bar_index + 3, pdl, "", style = label.style_label_left, color = color.new(cL, 70), textcolor = color.white, size = size.small)
        lbP := label.new(bar_index + 3, poc, "", style = label.style_label_left, color = color.new(cP, 70), textcolor = color.black, size = size.small)
    full = lblMode == "Full"
    label.set_xy(lbH, bar_index + 3, pdh)
    label.set_text(lbH, (full ? "Previous Day High " : "PDH ") + str.tostring(pdh, format.mintick))
    label.set_xy(lbL, bar_index + 3, pdl)
    label.set_text(lbL, (full ? "Previous Day Low " : "PDL ") + str.tostring(pdl, format.mintick))
    label.set_xy(lbP, bar_index + 3, poc)
    label.set_text(lbP, (full ? "Point of Control " : "POC ") + str.tostring(poc, format.mintick))
