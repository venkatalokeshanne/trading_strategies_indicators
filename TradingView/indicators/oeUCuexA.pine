//
//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// HARMONIC PATTERN TRAINER [verticetrading]
//
// WHAT IT DOES
//   A hands-on trainer to learn to spot harmonic patterns yourself. You place
//   five points (X-A-B-C-D) on a swing you think is a pattern, and the tool
//   measures every leg, checks the proportions, and tells you in plain words
//   whether it is a valid Gartley / Bat / Butterfly / Crab / Deep Crab / Cypher
//   — and, if not, what to fix. It teaches the eye instead of giving answers.
//
// HOW IT WORKS
//   The five points are drag-and-drop inputs. From them the tool computes the
//   classic leg proportions (AB of XA, BC of AB, CD of BC, and where D lands)
//   and compares them against the published textbook ranges of each pattern.
//   Nothing is auto-detected: the student provides the points, the tool only
//   does the arithmetic and the feedback. The "PRZ" it draws is the zone where
//   D *should* land for the chosen pattern — a place to watch, not a signal.
//
// DESIGN RULES
//   - Teach, don't decide. Every verdict is in natural language.
//   - Beginner shows the numbers; Advanced hides them until you reveal.
//   - No repainting: only the points you place are used.
//   - Bilingual UI (English / Español), default English.
//
// CREDITS (concepts)
//   Harmonic patterns are trading concepts developed by H.M. Gartley and later
//   formalized by Scott M. Carney. This is an original, independent
//   implementation written from public ratio definitions.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Harmonic Pattern Trainer [verticetrading]", shorttitle = "Harmonic Trainer", overlay = true, max_lines_count = 60, max_labels_count = 80, max_boxes_count = 30, max_polylines_count = 10)

// ══ Inputs ════════════════════════════════════════════════════════════════
grpG = "General"
lang    = input.string("English", "Language / Idioma", options = ["English", "Español"], group = grpG)
level   = input.string("Beginner", "Level / Nivel", options = ["Beginner", "Advanced"], group = grpG, tooltip = "Beginner shows every ratio. Advanced hides them until you reveal, so you estimate by eye first / Principiante muestra cada proporción. Avanzado las oculta hasta que reveles, para que estimes a ojo primero.")
reveal  = input.bool(false, "Reveal answer (Advanced) / Revelar respuesta (Avanzado)", group = grpG)
target  = input.string("Auto", "I'm looking for / Estoy buscando", options = ["Auto", "Gartley", "Bat", "Butterfly", "Crab", "Deep Crab", "Cypher"], group = grpG, tooltip = "Auto tells you which pattern it is (if any). Pick one to practice that pattern specifically / Auto te dice qué patrón es (si lo hay). Elige uno para practicar ese patrón en concreto.")
marginP = input.float(5.0, "Ratio margin (%) / Margen de proporción (%)", minval = 0.0, maxval = 15.0, step = 0.5, group = grpG, tooltip = "How forgiving the check is, since you place points by hand / Qué tan tolerante es la revisión, ya que colocas los puntos a mano.")
showChe = input.bool(true, "Show cheat-sheet / Mostrar chuleta", group = grpG)

grpP = "Your points — click to place X, A, B, C, D / Tus puntos"
xP = input.price(0.0, "X price", inline = "x", group = grpP, confirm = true)
xT = input.time(0, "X time", inline = "x", group = grpP, confirm = true)
aP = input.price(0.0, "A price", inline = "a", group = grpP, confirm = true)
aT = input.time(0, "A time", inline = "a", group = grpP, confirm = true)
bP = input.price(0.0, "B price", inline = "b", group = grpP, confirm = true)
bT = input.time(0, "B time", inline = "b", group = grpP, confirm = true)
cP = input.price(0.0, "C price", inline = "c", group = grpP, confirm = true)
cT = input.time(0, "C time", inline = "c", group = grpP, confirm = true)
dP = input.price(0.0, "D price", inline = "d", group = grpP, confirm = true)
dT = input.time(0, "D time", inline = "d", group = grpP, confirm = true)

grpS = "Style"
sizePts  = input.string("Normal", "Pattern points size / Tamaño de puntos", options = ["Small", "Normal", "Large", "Huge"], group = grpS)
sizeBox  = input.string("Normal", "Info box size / Tamaño de cajas de texto", options = ["Small", "Normal", "Large", "Huge"], group = grpS)
lineW    = input.int(2, "Line width / Grosor de línea", minval = 1, maxval = 6, group = grpS)
showFill = input.bool(true, "Fill pattern / Rellenar patrón", group = grpS)
fillMode = input.string("By verdict", "Fill color / Color del relleno", options = ["By verdict", "Bullish / Bearish", "Fixed"], group = grpS, tooltip = "By verdict: green if valid, red if not. Bullish/Bearish: green for a bottom at D, red for a top. Fixed: one custom color / Por veredicto: verde si es válido, rojo si no. Alcista/Bajista: verde si D es suelo, rojo si es techo. Fijo: un color propio.")
colPoint = input.color(#434651, "Point labels (X-A-B-C-D) / Etiquetas de puntos", group = grpS)
colFill  = input.color(color.new(#2962ff, 88), "Fixed fill color / Color de relleno fijo", group = grpS)
colOk    = input.color(#26a69a, "Valid / Válido", group = grpS)
colBad   = input.color(#ef5350, "Off / Fuera", group = grpS)
colLine  = input.color(#d1d4dc, "Pattern lines / Líneas", group = grpS)
colPrz   = input.color(color.new(#f2b455, 70), "PRZ zone / Zona PRZ", group = grpS)

f_t(string en, string es) =>
    lang == "English" ? en : es

f_mid(int t1, int t2) =>
    int(t1 + (t2 - t1) / 2)

detail = level == "Beginner" or reveal
m = marginP / 100.0

// Two independent size controls: the on-chart pattern, and the info boxes.
f_sz(string s, bool sub) =>
    switch s
        "Small"  => sub ? size.tiny   : size.small
        "Normal" => sub ? size.small  : size.normal
        "Large"  => sub ? size.normal : size.large
        => sub ? size.large : size.huge
szPt     = f_sz(sizePts, false)
szPtSub  = f_sz(sizePts, true)
szBox    = f_sz(sizeBox, false)
szBoxSub = f_sz(sizeBox, true)

// ══ Pattern rulebook (public textbook ratios) ═════════════════════════════
// Standard patterns share four checks: AB/XA, BC/AB, CD/BC, and D as a share
// of the XA leg (its "fingerprint"). Cypher is measured differently, below.
//                       Gartley  Bat     Butterfly Crab    Deep Crab
bLo  = array.from(0.550, 0.382, 0.750, 0.382, 0.850)   // AB / XA  low
bHi  = array.from(0.680, 0.500, 0.830, 0.618, 0.920)   // AB / XA  high
bcLo = array.from(0.382, 0.382, 0.382, 0.382, 0.382)   // BC / AB  low
bcHi = array.from(0.886, 0.886, 0.886, 0.886, 0.886)   // BC / AB  high
cdLo = array.from(1.130, 1.618, 1.618, 2.240, 2.000)   // CD / BC  low
cdHi = array.from(1.618, 2.618, 2.240, 3.618, 3.618)   // CD / BC  high
dLo  = array.from(0.750, 0.850, 1.220, 1.550, 1.550)   // D  / XA  low
dHi  = array.from(0.830, 0.920, 1.650, 1.680, 1.680)   // D  / XA  high

f_pname(int i) =>
    switch i
        0 => "Gartley"
        1 => f_t("Bat", "Bat (Murciélago)")
        2 => f_t("Butterfly", "Butterfly (Mariposa)")
        3 => f_t("Crab", "Crab (Cangrejo)")
        4 => f_t("Deep Crab", "Deep Crab (Cangrejo profundo)")
        => "Cypher"

f_in(float v, float lo, float hi) =>
    not na(v) and v >= lo * (1 - m) and v <= hi * (1 + m)

f_dev(float v, float lo, float hi) =>
    loE = lo * (1 - m)
    hiE = hi * (1 + m)
    na(v) ? 1e9 : v < loE ? (loE - v) / loE : v > hiE ? (v - hiE) / hiE : 0.0

// ══ Measured proportions from the placed points ═══════════════════════════
allPlaced = xT > 0 and aT > 0 and bT > 0 and cT > 0 and dT > 0

XA = math.abs(aP - xP)
AB = math.abs(bP - aP)
BC = math.abs(cP - bP)
CD = math.abs(dP - cP)
XC = math.abs(cP - xP)
AD = math.abs(dP - aP)

rB   = XA > 0 ? AB / XA : na    // AB retraces XA
rBC  = AB > 0 ? BC / AB : na    // BC retraces AB
rCD  = BC > 0 ? CD / BC : na    // CD extends BC
rD   = XA > 0 ? AD / XA : na    // where D lands vs XA
rCcy = XA > 0 ? XC / XA : na    // Cypher: C extends XA
rDcy = XC > 0 ? CD / XC : na    // Cypher: D retraces XC

// alternation check (points must go up / down / up / down)
s1 = math.sign(aP - xP)
s2 = math.sign(bP - aP)
s3 = math.sign(cP - bP)
s4 = math.sign(dP - cP)
zig = s1 != 0 and s1 == -s2 and s2 == -s3 and s3 == -s4

// ══ Evaluate every pattern ════════════════════════════════════════════════
f_getDev(int i) =>
    d = 0.0
    if i < 5
        d := f_dev(rB, array.get(bLo, i), array.get(bHi, i)) + f_dev(rBC, array.get(bcLo, i), array.get(bcHi, i)) + f_dev(rCD, array.get(cdLo, i), array.get(cdHi, i)) + f_dev(rD, array.get(dLo, i), array.get(dHi, i))
    else
        d := f_dev(rB, 0.382, 0.618) + f_dev(rCcy, 1.200, 1.450) + f_dev(rDcy, 0.750, 0.830)
    d

f_getValid(int i) =>
    v = false
    if i < 5
        v := f_in(rB, array.get(bLo, i), array.get(bHi, i)) and f_in(rBC, array.get(bcLo, i), array.get(bcHi, i)) and f_in(rCD, array.get(cdLo, i), array.get(cdHi, i)) and f_in(rD, array.get(dLo, i), array.get(dHi, i))
    else
        v := f_in(rB, 0.382, 0.618) and f_in(rCcy, 1.200, 1.450) and f_in(rDcy, 0.750, 0.830)
    v and zig

bestIdx = 0
bestDev = f_getDev(0)
anyValidIdx = -1
anyValidDev = 1e9
for i = 0 to 5
    di = f_getDev(i)
    if di < bestDev
        bestDev := di
        bestIdx := i
    if f_getValid(i) and di < anyValidDev
        anyValidDev := di
        anyValidIdx := i

targetIdx = switch target
    "Gartley"   => 0
    "Bat"       => 1
    "Butterfly" => 2
    "Crab"      => 3
    "Deep Crab" => 4
    "Cypher"    => 5
    => -1

// which pattern's legs we detail
evalIdx = target == "Auto" ? (anyValidIdx >= 0 ? anyValidIdx : bestIdx) : targetIdx
isValid = target == "Auto" ? anyValidIdx >= 0 : (targetIdx >= 0 and f_getValid(targetIdx))

// ideal D price (PRZ) for the evaluated pattern — linear on the leg it measures
f_idealD(int i, bool useHi) =>
    r = i < 5 ? (useHi ? array.get(dHi, i) : array.get(dLo, i)) : (useHi ? 0.830 : 0.750)
    i < 5 ? aP + (xP - aP) * r : cP + (xP - cP) * r    // Cypher measures on XC

// ══ Drawing state ══════════════════════════════════════════════════════════
var line[]     LN = array.new_line()
var label[]    LB = array.new_label()
var box[]      BX = array.new_box()
var polyline[] PL = array.new<polyline>()

var table fb  = table.new(position.bottom_right, 1, 9, bgcolor = color.new(#1e222d, 8), border_width = 1, border_color = color.new(color.gray, 70))
var table che = table.new(position.top_right, 2, 8, bgcolor = color.new(#1e222d, 8), border_width = 1, border_color = color.new(color.gray, 70))
var table wm  = table.new(position.bottom_left, 1, 1)

// leg helpers for the evaluated pattern
f_legVal(int i, int leg) =>
    if i < 5
        switch leg
            0 => rB
            1 => rBC
            2 => rCD
            => rD
    else
        switch leg
            0 => rB
            1 => rCcy
            => rDcy

f_legLo(int i, int leg) =>
    if i < 5
        switch leg
            0 => array.get(bLo, i)
            1 => array.get(bcLo, i)
            2 => array.get(cdLo, i)
            => array.get(dLo, i)
    else
        switch leg
            0 => 0.382
            1 => 1.200
            => 0.750

f_legHi(int i, int leg) =>
    if i < 5
        switch leg
            0 => array.get(bHi, i)
            1 => array.get(bcHi, i)
            2 => array.get(cdHi, i)
            => array.get(dHi, i)
    else
        switch leg
            0 => 0.618
            1 => 1.450
            => 0.830

f_legName(int i, int leg) =>
    if i < 5
        switch leg
            0 => "AB"
            1 => "BC"
            2 => "CD"
            => "D"
    else
        switch leg
            0 => "AB"
            1 => "XC"
            => "D"

// ══ Render (only on the last bar; inputs are static) ══════════════════════
if barstate.islast
    for x in LN
        line.delete(x)
    array.clear(LN)
    for x in LB
        label.delete(x)
    array.clear(LB)
    for x in BX
        box.delete(x)
    array.clear(BX)
    for x in PL
        polyline.delete(x)
    array.clear(PL)
    table.clear(fb, 0, 0, 0, 8)
    table.clear(che, 0, 0, 1, 7)
    table.clear(wm, 0, 0, 0, 0)

    table.cell(wm, 0, 0, "verticetrading", text_color = color.new(color.gray, 45), text_size = size.normal)

    if not allPlaced
        table.cell(fb, 0, 0, f_t("Place your 5 points on the chart:", "Coloca tus 5 puntos en el gráfico:"), text_color = color.white, text_size = szBox, text_halign = text.align_left)
        table.cell(fb, 0, 1, f_t("X → A → B → C → D (left to right).", "X → A → B → C → D (de izquierda a derecha)."), text_color = color.new(#d1d4dc, 0), text_size = szBoxSub, text_halign = text.align_left)
        table.cell(fb, 0, 2, f_t("Re-add the indicator to reset the points.", "Vuelve a añadir el indicador para reiniciar los puntos."), text_color = color.new(color.gray, 20), text_size = szBoxSub, text_halign = text.align_left)
    else
        // ── shaded fill: two triangles, XAB and BCD (drawn first) ──
        if showFill
            baseFill = fillMode == "Bullish / Bearish" ? (dP < cP ? colOk : colBad) : (isValid ? colOk : colBad)
            fillCol  = fillMode == "Fixed" ? colFill : color.new(baseFill, 82)
            triXAB = array.new<chart.point>()
            array.push(triXAB, chart.point.from_time(xT, xP))
            array.push(triXAB, chart.point.from_time(aT, aP))
            array.push(triXAB, chart.point.from_time(bT, bP))
            array.push(PL, polyline.new(triXAB, closed = true, xloc = xloc.bar_time, line_color = color.new(colLine, 100), fill_color = fillCol, line_width = 1))
            triBCD = array.new<chart.point>()
            array.push(triBCD, chart.point.from_time(bT, bP))
            array.push(triBCD, chart.point.from_time(cT, cP))
            array.push(triBCD, chart.point.from_time(dT, dP))
            array.push(PL, polyline.new(triBCD, closed = true, xloc = xloc.bar_time, line_color = color.new(colLine, 100), fill_color = fillCol, line_width = 1))

        // ── the XABCD skeleton (solid legs) ──
        array.push(LN, line.new(xT, xP, aT, aP, xloc = xloc.bar_time, color = colLine, width = lineW))
        array.push(LN, line.new(aT, aP, bT, bP, xloc = xloc.bar_time, color = colLine, width = lineW))
        array.push(LN, line.new(bT, bP, cT, cP, xloc = xloc.bar_time, color = colLine, width = lineW))
        array.push(LN, line.new(cT, cP, dT, dP, xloc = xloc.bar_time, color = colLine, width = lineW))
        // ── dotted ratio connectors (X-B, A-C, B-D, X-D), like the native tool ──
        array.push(LN, line.new(xT, xP, bT, bP, xloc = xloc.bar_time, color = color.new(colLine, 55), width = 1, style = line.style_dotted))
        array.push(LN, line.new(aT, aP, cT, cP, xloc = xloc.bar_time, color = color.new(colLine, 55), width = 1, style = line.style_dotted))
        array.push(LN, line.new(bT, bP, dT, dP, xloc = xloc.bar_time, color = color.new(colLine, 55), width = 1, style = line.style_dotted))
        array.push(LN, line.new(xT, xP, dT, dP, xloc = xloc.bar_time, color = color.new(colLine, 55), width = 1, style = line.style_dotted))

        // ── point labels ──
        array.push(LB, label.new(xT, xP, "X", xloc = xloc.bar_time, style = label.style_label_center, color = colPoint, textcolor = color.white, size = szPt))
        array.push(LB, label.new(aT, aP, "A", xloc = xloc.bar_time, style = label.style_label_center, color = colPoint, textcolor = color.white, size = szPt))
        array.push(LB, label.new(bT, bP, "B", xloc = xloc.bar_time, style = label.style_label_center, color = colPoint, textcolor = color.white, size = szPt))
        array.push(LB, label.new(cT, cP, "C", xloc = xloc.bar_time, style = label.style_label_center, color = colPoint, textcolor = color.white, size = szPt))
        array.push(LB, label.new(dT, dP, "D", xloc = xloc.bar_time, style = label.style_label_center, color = colPoint, textcolor = color.white, size = szPt))

        // ── ratio labels, placed on their retracement connector (like the native tool) ──
        // AB/XA on X-B · BC/AB on A-C · CD/BC on B-D · D of XA on X-D
        if detail
            okAB = f_in(rB, f_legLo(evalIdx, 0), f_legHi(evalIdx, 0))
            array.push(LB, label.new(f_mid(xT, bT), (xP + bP) / 2, str.tostring(rB, "0.000"), xloc = xloc.bar_time, style = label.style_label_center, color = color.new(okAB ? colOk : colBad, 10), textcolor = color.white, size = szPtSub))
            array.push(LB, label.new(f_mid(aT, cT), (aP + cP) / 2, str.tostring(rBC, "0.000"), xloc = xloc.bar_time, style = label.style_label_center, color = color.new(color.gray, 20), textcolor = color.white, size = szPtSub))
            array.push(LB, label.new(f_mid(bT, dT), (bP + dP) / 2, str.tostring(rCD, "0.000"), xloc = xloc.bar_time, style = label.style_label_center, color = color.new(color.gray, 20), textcolor = color.white, size = szPtSub))
            okD = f_in(rD, f_legLo(evalIdx, 3), f_legHi(evalIdx, 3))
            dTxt = evalIdx == 5 ? str.tostring(rDcy, "0.000") : str.tostring(rD, "0.000")
            array.push(LB, label.new(f_mid(xT, dT), (xP + dP) / 2, dTxt, xloc = xloc.bar_time, style = label.style_label_center, color = color.new((evalIdx == 5 ? f_in(rDcy, 0.750, 0.830) : okD) ? colOk : colBad, 10), textcolor = color.white, size = szPtSub))

        // ── PRZ zone: where D should land for the evaluated pattern ──
        pLo = f_idealD(evalIdx, false)
        pHi = f_idealD(evalIdx, true)
        array.push(BX, box.new(cT, math.max(pLo, pHi), dT + (dT - cT), math.min(pLo, pHi), xloc = xloc.bar_time, border_color = color.new(#f2b455, 20), bgcolor = colPrz, border_width = 1))
        array.push(LB, label.new(dT + (dT - cT), math.max(pLo, pHi), f_t("PRZ · watch, not a signal", "PRZ · a vigilar, no señal"), xloc = xloc.bar_time, style = label.style_label_down, color = color.new(#f2b455, 30), textcolor = color.white, size = szPtSub))

        // ── verdict ──
        string verdict = ""
        color  vcol = colOk
        if not zig
            verdict := f_t("Your points don't alternate. A harmonic must go up-down-up-down: X-A-B-C-D.", "Tus puntos no alternan. Un armónico va arriba-abajo-arriba-abajo: X-A-B-C-D.")
            vcol := colBad
        else if target == "Auto"
            if anyValidIdx >= 0
                verdict := str.format(f_t("It is a valid {0}. D landed in its zone.", "Es un {0} válido. La D cayó en su zona."), f_pname(anyValidIdx))
                vcol := colOk
            else
                verdict := str.format(f_t("Not a known pattern. Closest: {0} — adjust the marked leg.", "No es un patrón conocido. El más cercano: {0} — ajusta la pata marcada."), f_pname(bestIdx))
                vcol := colBad
        else
            if f_getValid(targetIdx)
                verdict := str.format(f_t("It is a valid {0}.", "Es un {0} válido."), f_pname(targetIdx))
                vcol := colOk
            else if anyValidIdx >= 0 and anyValidIdx != targetIdx
                verdict := str.format(f_t("You were after a {0}, but this is a {1}.", "Buscabas un {0}, pero esto es un {1}."), f_pname(targetIdx), f_pname(anyValidIdx))
                vcol := colBad
            else
                verdict := str.format(f_t("Close to a {0}: check the marked leg.", "Casi un {0}: revisa la pata marcada."), f_pname(targetIdx))
                vcol := colBad

        table.cell(fb, 0, 0, "➤ " + verdict, text_color = color.white, bgcolor = color.new(vcol, 55), text_size = szBox, text_halign = text.align_left)

        // ── leg-by-leg breakdown (Beginner / revealed) ──
        int row = 1
        if detail
            table.cell(fb, 0, row, str.format(f_t("Checking as: {0}", "Revisando como: {0}"), f_pname(evalIdx)), text_color = color.new(#d1d4dc, 0), text_size = szBoxSub, text_halign = text.align_left)
            row += 1
            legCount = evalIdx == 5 ? 3 : 4
            for leg = 0 to legCount - 1
                v = f_legVal(evalIdx, leg)
                lo = f_legLo(evalIdx, leg)
                hi = f_legHi(evalIdx, leg)
                ok = f_in(v, lo, hi)
                txt = str.format("{0} = {1}  {2}  ({3}–{4})", f_legName(evalIdx, leg), str.tostring(v, "0.000"), ok ? "✓" : "✗", str.tostring(lo, "0.000"), str.tostring(hi, "0.000"))
                table.cell(fb, 0, row, txt, text_color = ok ? colOk : colBad, text_size = szBoxSub, text_halign = text.align_left)
                row += 1
        else
            table.cell(fb, 0, row, f_t("Advanced: tick 'Reveal answer' to see the ratios.", "Avanzado: marca 'Revelar respuesta' para ver las proporciones."), text_color = color.new(color.gray, 10), text_size = szBoxSub, text_halign = text.align_left)
            row += 1

        table.cell(fb, 0, row, f_t("The PRZ is a zone to watch, not a buy/sell signal.", "La PRZ es una zona a vigilar, no una señal de compra/venta."), text_color = color.new(color.orange, 20), text_size = szBoxSub, text_halign = text.align_left)

    // ── cheat-sheet (the rulebook) ──
    if showChe
        table.cell(che, 0, 0, f_t("Pattern", "Patrón"), text_color = color.white, bgcolor = color.new(color.gray, 40), text_size = szBoxSub)
        table.cell(che, 1, 0, f_t("Fingerprint — where D lands", "Huella — dónde cae la D"), text_color = color.white, bgcolor = color.new(color.gray, 40), text_size = szBoxSub, text_halign = text.align_left)
        cheTxt = array.from(f_t("D at 0.786 of XA (contained)", "D al 0.786 de XA (contenido)"), f_t("D at 0.886 of XA (near X)", "D al 0.886 de XA (cerca de X)"), f_t("D at 1.272-1.618 of XA (beyond X)", "D al 1.272-1.618 de XA (más allá de X)"), f_t("D at 1.618 of XA (deepest)", "D al 1.618 de XA (el más profundo)"), f_t("D at 1.618, with a deep B (0.886)", "D al 1.618, con B honda (0.886)"), f_t("D at 0.786 of the X-C leg", "D al 0.786 del tramo X-C"))
        for i = 0 to 5
            table.cell(che, 0, i + 1, f_pname(i), text_color = color.new(#d1d4dc, 0), text_size = szBoxSub, text_halign = text.align_left)
            table.cell(che, 1, i + 1, array.get(cheTxt, i), text_color = color.new(#d1d4dc, 0), text_size = szBoxSub, text_halign = text.align_left)