//@version=6
strategy("Ema Crosses Strategy", overlay = true)

// EMA 1
ema1Length = input.int(9, "EMA1 Length", group = "EMA1 Settings")
ema1Source = input.source(close, "EMA1 Source", group = "EMA1 Settings")
ema1Color = input.color(color.green, "EMA1 Color", group = "EMA1 Settings")

ema1 = ta.ema(ema1Source, ema1Length)

plot(ema1, "EMA1", ema1Color)

// EMA 2
ema2Length = input.int(26, "EMA2 Length", group = "EMA2 Settings")
ema2Source = input.source(close, "EMA2 Source", group = "EMA2 Settings")
ema2Color = input.color(color.orange, "EMA2 Color", group = "EMA2 Settings")

ema2 = ta.ema(ema2Source, ema2Length)

plot(ema2, "EMA2", ema2Color)

// Trading conditions
buyCondition = ta.crossover(ema1, ema2)
sellCondition = ta.crossunder(ema1, ema2)

// Buy
if buyCondition and strategy.position_size <= 0
    strategy.close("SELL", comment = "SELL EXIT")
    strategy.entry("BUY", strategy.long)

// Sell
if sellCondition and strategy.position_size >= 0
    strategy.close("BUY", comment = "BUY EXIT")
    strategy.entry("SELL", strategy.short)

// Risk management
slPoints = input.float(20.0, "Stop Loss (Points)", group = "Risk Management")
tpPoints = input.float(40.0, "Take Profit (Points)", group = "Risk Management")

longSL = strategy.position_avg_price - slPoints
longTP = strategy.position_avg_price + tpPoints

shortSL = strategy.position_avg_price + slPoints
shortTP = strategy.position_avg_price - tpPoints

strategy.exit("BUY EXIT", from_entry = "BUY", stop = longSL, limit = longTP)
strategy.exit("SELL EXIT", from_entry = "SELL", stop = shortSL, limit = shortTP)