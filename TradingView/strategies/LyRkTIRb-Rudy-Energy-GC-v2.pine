//@version=6
// Rudy v2 - Golden Cross Momentum System
// Proprietary signal engine for energy sector equities
// Apply to: CCJ, UEC, XOM, CVX, OXY, DVN, FANG, VST, CEG, LEU
strategy("Rudy Energy GC v2", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=18, initial_capital=20000, commission_type=strategy.commission.percent, commission_value=0.1)

// --- Parameters ---
int p_fast = input.int(50, "Fast EMA Period")
int p_slow = input.int(200, "Slow SMA Period")
int p_trend = input.int(21, "Trend EMA Period")
int p_rsi = input.int(14, "RSI Period")
int p_rsi_cap = input.int(75, "RSI Cap")
int p_min = input.int(3, "Minimum Signal Strength")
float p_trail = input.float(8.0, "Trailing Stop Pct") / 100
float p_offset = input.float(1.0, "Trail Offset Pct") / 100

// --- Calculations ---
float fastMA = ta.ema(close, p_fast)
float slowMA = ta.sma(close, p_slow)
float trendMA = ta.ema(close, p_trend)
float rsiVal = ta.rsi(close, p_rsi)
float momPct = (close - slowMA) / slowMA * 100

// --- Signal Strength ---
var int strength = 0
strength := 0
strength += fastMA > slowMA ? 2 : 0
strength += rsiVal < 65 ? 1 : 0
strength += momPct > 5 ? 1 : 0
strength += close > trendMA ? 1 : 0

// --- Conditions ---
bool bullRegime = fastMA > slowMA
bool bearRegime = fastMA < slowMA
bool notExtended = rsiVal < p_rsi_cap
bool trendIntact = close > trendMA
bool goLong = bullRegime and notExtended and trendIntact and strength >= p_min
bool exitSignal = bearRegime

// --- Execution ---
if goLong and strategy.position_size == 0
    strategy.entry("GC_Long", strategy.long)

if strategy.position_size > 0
    float tPts = close * p_trail / syminfo.mintick
    float tOff = close * p_offset / syminfo.mintick
    strategy.exit("GC_Trail", "GC_Long", trail_points=tPts, trail_offset=tOff)

if exitSignal and strategy.position_size > 0
    strategy.close("GC_Long", comment="Regime Shift")

// --- Visuals ---
plot(fastMA, "Fast EMA", color.new(#2196F3, 0), 2)
plot(slowMA, "Slow SMA", color.new(#F44336, 0), 2)
plot(trendMA, "Trend EMA", color.new(#FF9800, 30))
bgcolor(goLong ? color.new(#4CAF50, 92) : na)
plotshape(goLong and strategy.position_size == 0, "Entry", shape.labelup, location.belowbar, color.new(#4CAF50, 0), size=size.tiny)
plotshape(exitSignal and strategy.position_size > 0, "Exit", shape.labeldown, location.abovebar, color.new(#F44336, 0), size=size.tiny)
