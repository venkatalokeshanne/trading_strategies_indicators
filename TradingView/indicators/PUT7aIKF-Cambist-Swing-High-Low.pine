//@version=6
indicator("Cambist Swing High / Low", overlay=true, max_lines_count=500, max_labels_count=500)

// ============================================================
// INPUTS
// ============================================================
pivotLen   = input.int(5, "Swing Lookback (bars each side)", minval=1,
     tooltip="A bar is a swing high/low if it is the highest/lowest point within this many bars on each side.")

showLabels = input.bool(true, "Show Swing High/Low Price Labels")

swingHighColor = input.color(#1E88FF, "Swing High Line Color")
swingLowColor  = input.color(#FF1744, "Swing Low Line Color")
lineWidth      = input.int(3, "Line Width", minval=1, maxval=4)

lineStyleInput = input.string("Dotted", "Line Style", options=["Dotted", "Dashed", "Solid"])
lineStyle = lineStyleInput == "Dotted" ? line.style_dotted : lineStyleInput == "Dashed" ? line.style_dashed : line.style_solid

// ============================================================
// PIVOT DETECTION
// ============================================================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,  pivotLen, pivotLen)

// ============================================================
// STATE: the currently "active" (still extending) swing high/low ray
// ============================================================
var line  activeHighLine  = na
var float activeHighPrice = na

var line  activeLowLine  = na
var float activeLowPrice = na

// ------------------------------------------------------------
// SWING HIGH: on a new pivot high, stop extending the old ray
// (leave it fixed where it is) and start a fresh one.
// ------------------------------------------------------------
if not na(ph)
    pivotBar = bar_index - pivotLen

    // freeze the previous line where it currently ends
    if not na(activeHighLine)
        line.set_extend(activeHighLine, extend.none)

    activeHighLine := line.new(pivotBar, ph, bar_index, ph,
         xloc.bar_index, extend=extend.right,
         color=swingHighColor, style=lineStyle, width=lineWidth)
    activeHighPrice := ph

    if showLabels
        label.new(pivotBar, ph, str.tostring(ph, format.mintick),
             xloc.bar_index, yloc.price, color=color.new(color.blue, 100),
             textcolor=swingHighColor, style=label.style_label_down, size=size.tiny)

// if price closes above the active swing high, that level is broken:
// freeze the ray and wait for the next pivot to define a new one
if not na(activeHighLine) and not na(activeHighPrice) and close > activeHighPrice
    line.set_extend(activeHighLine, extend.none)
    line.set_x2(activeHighLine, bar_index)
    activeHighLine  := na
    activeHighPrice := na

// ------------------------------------------------------------
// SWING LOW: same logic, mirrored
// ------------------------------------------------------------
if not na(pl)
    pivotBar = bar_index - pivotLen

    if not na(activeLowLine)
        line.set_extend(activeLowLine, extend.none)

    activeLowLine := line.new(pivotBar, pl, bar_index, pl,
         xloc.bar_index, extend=extend.right,
         color=swingLowColor, style=lineStyle, width=lineWidth)
    activeLowPrice := pl

    if showLabels
        label.new(pivotBar, pl, str.tostring(pl, format.mintick),
             xloc.bar_index, yloc.price, color=color.new(color.red, 100),
             textcolor=swingLowColor, style=label.style_label_up, size=size.tiny)

if not na(activeLowLine) and not na(activeLowPrice) and close < activeLowPrice
    line.set_extend(activeLowLine, extend.none)
    line.set_x2(activeLowLine, bar_index)
    activeLowLine  := na
    activeLowPrice := na

// ============================================================
// ALERTS
// ============================================================
alertcondition(not na(ph), title="New Swing High", message="A new swing high has formed.")
alertcondition(not na(pl), title="New Swing Low",  message="A new swing low has formed.")
