//@version=6
indicator("Smart Money Concept & Liquidity Matrix Pro", "SMC & Liquidity Pro", overlay = true, max_lines_count = 500, max_boxes_count = 100, max_labels_count = 500)

// ----------------------------------------------------------------------------------------------
// 1. INPUTS & CONFIGURATION PANEL
// ----------------------------------------------------------------------------------------------

get_line_style(string s) =>
    s == "Solid" ? line.style_solid : s == "Dashed" ? line.style_dashed : line.style_dotted

// A. Market Structure (BOS & CHoCH)
g_smc         = "===== MARKET STRUCTURE (BOS & CHoCH) ====="
show_smc      = input.bool(true, "Show BOS & CHoCH Shifts", group=g_smc)
smc_sens      = input.int(5, "Structure Pivot Sensitivity", minval=2, maxval=30, group=g_smc)
c_bos         = input.color(#0066ff, "BOS Color (Neon Blue)", group=g_smc)
c_choch       = input.color(#9900ff, "CHoCH Color (Purple)", group=g_smc)
smc_style_str = input.string("Dashed", "Line Style", options=["Solid", "Dashed", "Dotted"], group=g_smc)
smc_line_w    = input.int(2, "Line Thickness", minval=1, maxval=4, group=g_smc)

// B. Major Swing High/Low Triangle Markers
g_piv         = "===== MAJOR SWING TRIANGLE MARKERS ====="
show_pivots   = input.bool(true, "Show Major Swing Triangles", group=g_piv)
pivot_sens    = input.int(8, "Major Swing Sensitivity", minval=3, maxval=50, group=g_piv)
c_piv_high    = input.color(#ff1744, "Major High Triangle (Red)", group=g_piv)
c_piv_low     = input.color(#0066ff, "Major Low Triangle (Blue)", group=g_piv)

// C. High Probability Order Blocks & Breaker Zones
g_zones       = "===== HIGH PROBABILITY ORDER BLOCK ZONES ====="
show_zones    = input.bool(true, "Show Active Order Block / Breaker Zones", group=g_zones)
zone_sens     = input.int(10, "Zone Sensitivity Lookback", minval=3, maxval=50, group=g_zones)
c_ob_bull     = input.color(color.new(#0066ff, 82), "Bullish Zone Fill (Blue)", group=g_zones)
c_ob_bull_b   = input.color(#0066ff, "Bullish Zone Border", group=g_zones)
c_ob_bear     = input.color(color.new(#ff1744, 82), "Bearish Zone Fill (Red)", group=g_zones)
c_ob_bear_b   = input.color(#ff1744, "Bearish Zone Border", group=g_zones)

// D. Daily Liquidity Engine (PDH / PDL with Auto-Hide)
g_pd          = "===== DYNAMIC DAILY LIQUIDITY (PDH/PDL) ====="
show_pdh_pdl  = input.bool(true, "Show Dynamic PDH / PDL", group=g_pd)
c_pdh         = input.color(#ff1744, "PDH Line Color", group=g_pd)
c_pdl         = input.color(#0066ff, "PDL Line Color", group=g_pd)
pd_style_str  = input.string("Dashed", "PDH/PDL Line Style", options=["Solid", "Dashed", "Dotted"], group=g_pd)
pd_line_w     = input.int(2, "PDH/PDL Line Thickness", minval=1, maxval=4, group=g_pd)

// E. Dynamic Glowing Candles & Trend Wave
g_visual      = "===== GLOWING CANDLES & TREND WAVE ====="
paint_candles = input.bool(true, "Enable Dynamic Glowing Candles", group=g_visual)
show_wave     = input.bool(true, "Enable Glowing Trend Wave", group=g_visual)
wave_len      = input.int(21, "Wave Lookback Horizon", minval=5, maxval=100, group=g_visual)
c_bull_glow   = input.color(#0066ff, "Bullish Glow Color (Blue)", group=g_visual)
c_bear_glow   = input.color(#ff1744, "Bearish Glow Color (Red)", group=g_visual)
fill_opacity  = input.int(90, "Background Fill Opacity", minval=60, maxval=98, group=g_visual)

atr_val = ta.atr(14)

// ----------------------------------------------------------------------------------------------
// 2. DYNAMIC CANDLE GLOW & TREND WAVE ENGINE
// ----------------------------------------------------------------------------------------------
float trend_wave = ta.alma(close, wave_len, 0.85, 6)
bool is_uptrend = close >= trend_wave
color active_glow_col = is_uptrend ? c_bull_glow : c_bear_glow

plotcandle(open, high, low, close, "Glowing Candles", color = paint_candles ? active_glow_col : na, wickcolor = paint_candles ? active_glow_col : na, bordercolor = paint_candles ? active_glow_col : na, display = paint_candles ? display.all : display.none)

plot_w = plot(show_wave ? trend_wave : na, "Trend Wave Line", color=active_glow_col, linewidth=2)
plot_p = plot(show_wave ? close : na, "Price Anchor", color=color.new(#ffffff, 100))

fill(plot_w, plot_p, color=show_wave ? color.new(active_glow_col, fill_opacity) : na, title="Wave Soft Glow Fill")

// ----------------------------------------------------------------------------------------------
// 3. SWING-TO-BREAK STRUCTURE ENGINE (BOS & CHOCH)
// ----------------------------------------------------------------------------------------------
ph_smc = ta.pivothigh(high, smc_sens, smc_sens)
pl_smc = ta.pivotlow(low, smc_sens, smc_sens)

var float last_ph_val = na
var int last_ph_idx = na
var float last_pl_val = na
var int last_pl_idx = na
var int trend_dir = 0

if not na(ph_smc)
    last_ph_val := ph_smc
    last_ph_idx := bar_index - smc_sens

if not na(pl_smc)
    last_pl_val := pl_smc
    last_pl_idx := bar_index - smc_sens

// Bullish Breakout
if show_smc and not na(last_ph_val) and ta.crossover(close, last_ph_val)
    string lbl_text = trend_dir == -1 ? "CHoCH" : "BOS"
    color lbl_col = trend_dir == -1 ? c_choch : c_bos
    line.new(last_ph_idx, last_ph_val, bar_index, last_ph_val, color=lbl_col, style=get_line_style(smc_style_str), width=smc_line_w)
    int mid_x = int(math.round((last_ph_idx + bar_index) / 2))
    label.new(mid_x, last_ph_val, lbl_text, color=color.new(#ffffff, 100), textcolor=lbl_col, style=label.style_label_down, size=size.small)
    trend_dir := 1
    last_ph_val := na

// Bearish Breakout
if show_smc and not na(last_pl_val) and ta.crossunder(close, last_pl_val)
    string lbl_text = trend_dir == 1 ? "CHoCH" : "BOS"
    color lbl_col = trend_dir == 1 ? c_choch : c_bos
    line.new(last_pl_idx, last_pl_val, bar_index, last_pl_val, color=lbl_col, style=get_line_style(smc_style_str), width=smc_line_w)
    int mid_x = int(math.round((last_pl_idx + bar_index) / 2))
    label.new(mid_x, last_pl_val, lbl_text, color=color.new(#ffffff, 100), textcolor=lbl_col, style=label.style_label_up, size=size.small)
    trend_dir := -1
    last_pl_val := na

// ----------------------------------------------------------------------------------------------
// 4. MAJOR SWING HIGH / LOW TRIANGLE MARKERS (SAFE TEXT TRIANGLES)
// ----------------------------------------------------------------------------------------------
ph_piv = ta.pivothigh(high, pivot_sens, pivot_sens)
pl_piv = ta.pivotlow(low, pivot_sens, pivot_sens)

if show_pivots and not na(ph_piv)
    int piv_idx = bar_index - pivot_sens
    label.new(piv_idx, high[pivot_sens] + (atr_val * 0.25), "▼", color=color.new(#ffffff, 100), textcolor=c_piv_high, style=label.style_label_down, size=size.small)

if show_pivots and not na(pl_piv)
    int piv_idx = bar_index - pivot_sens
    label.new(piv_idx, low[pivot_sens] - (atr_val * 0.25), "▲", color=color.new(#ffffff, 100), textcolor=c_piv_low, style=label.style_label_up, size=size.small)

// ----------------------------------------------------------------------------------------------
// 5. HIGH PROBABILITY ORDER BLOCK ZONES (ACTIVE UNMITIGATED)
// ----------------------------------------------------------------------------------------------
var box[] active_ob_boxes = array.new<box>()

ph_z = ta.pivothigh(high, zone_sens, zone_sens)
pl_z = ta.pivotlow(low, zone_sens, zone_sens)

// Bearish Order Block
if show_zones and not na(ph_z)
    float z_top = high[zone_sens]
    float z_bot = math.max(open[zone_sens], close[zone_sens])
    box b = box.new(left=bar_index - zone_sens, top=z_top, right=bar_index + 10, bottom=z_bot, bgcolor=c_ob_bear, border_color=c_ob_bear_b, border_width=1)
    array.push(active_ob_boxes, b)

// Bullish Order Block
if show_zones and not na(pl_z)
    float z_top = math.min(open[zone_sens], close[zone_sens])
    float z_bot = low[zone_sens]
    box b = box.new(left=bar_index - zone_sens, top=z_top, right=bar_index + 10, bottom=z_bot, bgcolor=c_ob_bull, border_color=c_ob_bull_b, border_width=1)
    array.push(active_ob_boxes, b)

// Zone Invalidation Logic
if array.size(active_ob_boxes) > 0
    for i = array.size(active_ob_boxes) - 1 to 0
        box cur_b = array.get(active_ob_boxes, i)
        float b_top = box.get_top(cur_b)
        float b_bot = box.get_bottom(cur_b)
        if close > b_top or close < b_bot
            box.delete(cur_b)
            array.remove(active_ob_boxes, i)
        else
            box.set_right(cur_b, bar_index + 8)

// ----------------------------------------------------------------------------------------------
// 6. DYNAMIC PREVIOUS DAY HIGH / LOW (AUTO-HIDE ON BREAK)
// ----------------------------------------------------------------------------------------------
[pdh_val, pdl_val] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)

var line line_pdh = na
var line line_pdl = na
var label lbl_pdh = na
var label lbl_pdl = na

var bool pdh_broken = false
var bool pdl_broken = false

bool is_new_day = not na(ta.change(time("D")))

if is_new_day
    pdh_broken := false
    pdl_broken := false

if show_pdh_pdl and barstate.islast
    line.delete(line_pdh)
    line.delete(line_pdl)
    label.delete(lbl_pdh)
    label.delete(lbl_pdl)

    if high >= pdh_val
        pdh_broken := true

    if not pdh_broken
        line_pdh := line.new(bar_index - 30, pdh_val, bar_index + 8, pdh_val, color=c_pdh, style=get_line_style(pd_style_str), width=pd_line_w)
        lbl_pdh  := label.new(bar_index + 8, pdh_val, "PDH", color=color.new(#ffffff, 100), textcolor=c_pdh, style=label.style_label_left, size=size.small)

    if low <= pdl_val
        pdl_broken := true

    if not pdl_broken
        line_pdl := line.new(bar_index - 30, pdl_val, bar_index + 8, pdl_val, color=c_pdl, style=get_line_style(pd_style_str), width=pd_line_w)
        lbl_pdl  := label.new(bar_index + 8, pdl_val, "PDL", color=color.new(#ffffff, 100), textcolor=c_pdl, style=label.style_label_left, size=size.small)