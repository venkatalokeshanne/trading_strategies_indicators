//@version=6
strategy("Auto Fair Price + Next BOS Back", overlay=true, pyramiding=0, process_orders_on_close=true)

//==================================================
// Inputs
//==================================================
tz = input.string("America/New_York", "Timezone")
stopPts = input.float(25.0, "Stop Loss Points", step=0.25)

use0259 = input.bool(true, "Use 2:59am fair price")
use0829 = input.bool(true, "Use 8:29am fair price")
use0929 = input.bool(true, "Use 9:29am fair price")
use1359 = input.bool(true, "Use 1:59pm fair price")
use1659 = input.bool(true, "Use 4:59pm fair price")
use1959 = input.bool(true, "Use 7:59pm fair price")

showFairZone = input.bool(true, "Show Fair Price Zone")
showBosColor = input.bool(true, "Color BOS Candle")
showSignals  = input.bool(true, "Show Entry Markers")
extendBars   = input.int(240, "Extend Fair Zone Right", minval=10, maxval=5000)

//==================================================
// Time helpers
//==================================================
nyHour   = hour(time, tz)
nyMinute = minute(time, tz)

hit0259 = use0259 and nyHour == 2  and nyMinute == 59
hit0829 = use0829 and nyHour == 8  and nyMinute == 29
hit0929 = use0929 and nyHour == 9  and nyMinute == 29
hit1359 = use1359 and nyHour == 13 and nyMinute == 59
hit1659 = use1659 and nyHour == 16 and nyMinute == 59
hit1959 = use1959 and nyHour == 19 and nyMinute == 59

newAnchor = hit0259 or hit0829 or hit0929 or hit1359 or hit1659 or hit1959

//==================================================
// Fair price = exact anchor candle body
//==================================================
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)

var float fairTop = na
var float fairBot = na
var float fairMid = na
var int   fairBar = na
var string fairName = ""

// state
var bool driftedAbove = false
var bool driftedBelow = false
var bool waitingForShortBos = false
var bool waitingForLongBos  = false

// exit before next fair-price opening
if newAnchor and strategy.position_size != 0
    strategy.close_all(comment="Exit Before New Fair Price")

if hit0259
    fairTop := bodyTop
    fairBot := bodyBot
    fairMid := (fairTop + fairBot) / 2.0
    fairBar := bar_index
    fairName := "2:59"
    driftedAbove := false
    driftedBelow := false
    waitingForShortBos := false
    waitingForLongBos := false

if hit0829
    fairTop := bodyTop
    fairBot := bodyBot
    fairMid := (fairTop + fairBot) / 2.0
    fairBar := bar_index
    fairName := "8:29"
    driftedAbove := false
    driftedBelow := false
    waitingForShortBos := false
    waitingForLongBos := false

if hit0929
    fairTop := bodyTop
    fairBot := bodyBot
    fairMid := (fairTop + fairBot) / 2.0
    fairBar := bar_index
    fairName := "9:29"
    driftedAbove := false
    driftedBelow := false
    waitingForShortBos := false
    waitingForLongBos := false

if hit1359
    fairTop := bodyTop
    fairBot := bodyBot
    fairMid := (fairTop + fairBot) / 2.0
    fairBar := bar_index
    fairName := "1:59"
    driftedAbove := false
    driftedBelow := false
    waitingForShortBos := false
    waitingForLongBos := false

if hit1659
    fairTop := bodyTop
    fairBot := bodyBot
    fairMid := (fairTop + fairBot) / 2.0
    fairBar := bar_index
    fairName := "4:59"
    driftedAbove := false
    driftedBelow := false
    waitingForShortBos := false
    waitingForLongBos := false

if hit1959
    fairTop := bodyTop
    fairBot := bodyBot
    fairMid := (fairTop + fairBot) / 2.0
    fairBar := bar_index
    fairName := "7:59"
    driftedAbove := false
    driftedBelow := false
    waitingForShortBos := false
    waitingForLongBos := false

haveFair = not na(fairTop) and not na(fairBot)

//==================================================
// Detect drift away from fair price
//==================================================
if haveFair and bar_index > fairBar
    if high > fairTop
        driftedAbove := true
        waitingForShortBos := true
    if low < fairBot
        driftedBelow := true
        waitingForLongBos := true

//==================================================
// BOS logic: most recent 3-candle wick structure
//==================================================
isSwingHigh = high[1] > high[2] and high[1] > high
isSwingLow  = low[1] < low[2] and low[1] < low

var float recentHigh = na
var float recentLow  = na

bullBreak = not na(recentHigh) and ta.crossover(close, recentHigh)
bearBreak = not na(recentLow) and ta.crossunder(close, recentLow)

bullBosCandle = bullBreak and close > open
bearBosCandle = bearBreak and close < open

//==================================================
// Entry logic
// short only when fair price is below current price
// long only when fair price is above current price
//==================================================
priceAboveBox = haveFair and close > fairTop
priceBelowBox = haveFair and close < fairBot

shortSignal = (
    strategy.position_size == 0 and
    haveFair and
    bar_index > fairBar and
    waitingForShortBos and
    priceAboveBox and
    bearBosCandle
)

longSignal = (
    strategy.position_size == 0 and
    haveFair and
    bar_index > fairBar and
    waitingForLongBos and
    priceBelowBox and
    bullBosCandle
)

if shortSignal
    strategy.entry("Short", strategy.short)
    waitingForShortBos := false

if longSignal
    strategy.entry("Long", strategy.long)
    waitingForLongBos := false

//==================================================
// Exits
//==================================================
if strategy.position_size > 0 and haveFair
    strategy.exit(
         "Long Exit",
         from_entry="Long",
         stop=strategy.position_avg_price - stopPts,
         limit=fairTop
     )

if strategy.position_size < 0 and haveFair
    strategy.exit(
         "Short Exit",
         from_entry="Short",
         stop=strategy.position_avg_price + stopPts,
         limit=fairBot
     )

//==================================================
// Update structure AFTER checks
//==================================================
if isSwingHigh
    recentHigh := high[1]

if isSwingLow
    recentLow := low[1]

//==================================================
// Visuals
//==================================================
barcolor(showBosColor ? (bullBosCandle ? color.lime : bearBosCandle ? color.red : na) : na)

plotshape(showSignals and longSignal,  title="Long Entry",  style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.small, text="L")
plotshape(showSignals and shortSignal, title="Short Entry", style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.small, text="S")

plot(haveFair ? fairTop : na, "Fair Top", color=color.white, linewidth=2)
plot(haveFair ? fairBot : na, "Fair Bottom", color=color.white, linewidth=2)
plot(haveFair ? fairMid : na, "Fair Mid", color=color.new(color.white, 60), linewidth=1)

var box fairBox = na
if newAnchor and showFairZone
    if not na(fairBox)
        box.delete(fairBox)
    fairBox := box.new(
         left=bar_index,
         top=fairTop,
         right=bar_index + extendBars,
         bottom=fairBot,
         bgcolor=color.new(color.blue, 85),
         border_color=color.white
     )
     