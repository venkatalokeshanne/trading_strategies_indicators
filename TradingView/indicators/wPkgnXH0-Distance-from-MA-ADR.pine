//@version=6
indicator("Distance from MA + ADR%", overlay=true)

// ===== Calculation Inputs =====
maLen   = input.int(50, "MA Length", minval=1, group="Calculation")
maType  = input.string("SMA", "MA Type", options=["SMA", "EMA", "WMA", "VWMA"], group="Calculation", tooltip="VWMA returns na on symbols without volume data (most indices and forex).")
atrLen  = input.int(14, "ATR Length", minval=1, group="Calculation")
adrLen  = input.int(20, "ADR% Length", minval=1, group="Calculation")

extThresh = input.float(5.0, "Extended Threshold (ATR Multiple)", minval=0, step=0.25, group="Calculation", tooltip="The ATR multiple is highlighted once its absolute value reaches this level. Calibrated for the daily chart.")

// ===== ADR% Inputs =====
adrTf     = input.timeframe("D", "ADR% Timeframe", group="ADR%", tooltip="ADR% is a daily statistic. Keeping this on D keeps the reading correct on weekly and intraday charts.")
adrClosed = input.bool(true, "Use completed bars only", group="ADR%", tooltip="Excludes the still-forming bar, whose range is incomplete and biases the average downward.")

// ===== Display Toggles =====
showAtrMult = input.bool(true, "Show ATR Multiple From MA", group="Display")
showPctGain = input.bool(true, "Show % Gain From MA",       group="Display")
showAtrPct  = input.bool(true, "Show ATR %",                group="Display")
showAdrPct  = input.bool(true, "Show ADR%",                 group="Display")

tblPos   = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"], group="Display")
txtColor = input.color(color.new(color.orange, 0), "Label Color", group="Display")
valColor = input.color(color.new(color.red, 0), "Value Color", group="Display")
extColor = input.color(color.new(color.yellow, 0), "Extended Value Color", group="Display")
bgColor  = input.color(color.new(color.black, 20), "Background Color", group="Display")
txtSize  = input.string("Normal", "Text Size", options=["Tiny", "Small", "Normal", "Large"], group="Display")

// ===== Helpers =====
f_ma(src, len, t) =>
    t == "EMA"  ? ta.ema(src, len)  :
     t == "WMA"  ? ta.wma(src, len)  :
     t == "VWMA" ? ta.vwma(src, len) : ta.sma(src, len)

f_pos(p) =>
    p == "Top Right"     ? position.top_right    :
     p == "Top Left"      ? position.top_left     :
     p == "Bottom Right"  ? position.bottom_right :
     p == "Bottom Left"   ? position.bottom_left  :
     p == "Middle Right"  ? position.middle_right : position.middle_left

f_size(s) =>
    s == "Tiny"  ? size.tiny  :
     s == "Small" ? size.small :
     s == "Large" ? size.large : size.normal

f_fmt(v, suffix) =>
    na(v) ? "n/a" : str.tostring(v, "#.##") + suffix

// ===== Calculations =====
ma     = f_ma(close, maLen, maType)
atrVal = ta.atr(atrLen)

// Percentage distance from the MA
pctGainFromMA = na(ma) or ma == 0 ? na : (close - ma) / ma * 100

// ATR expressed as a percentage of price
atrPct = na(atrVal) or close == 0 ? na : atrVal / close * 100

// ATR multiple from MA: how many ATRs price sits above/below the MA.
// Computed in price units so there is no denominator mismatch.
atrMultFromMA = na(ma) or na(atrVal) or atrVal == 0 ? na : (close - ma) / atrVal

// ADR%: mean of (high / low) over adrLen bars, pinned to the chosen timeframe
adrRaw    = (ta.sma(high / low, adrLen) - 1) * 100
adrSeries = adrClosed ? adrRaw[1] : adrRaw
adrPct    = request.security(syminfo.tickerid, adrTf, adrSeries, lookahead = barmerge.lookahead_off)

// v6 uses three-valued boolean logic, so the na case is handled explicitly
isExtended = na(atrMultFromMA) ? false : math.abs(atrMultFromMA) >= extThresh

// ===== Table =====
var table t = table.new(f_pos(tblPos), 2, 4, bgcolor=bgColor, border_width=1, border_color=color.new(color.gray, 50))

if barstate.islast
    ts      = f_size(txtSize)
    multCol = isExtended ? extColor : valColor
    table.clear(t, 0, 0, 1, 3)
    row = 0

    if showAtrMult
        table.cell(t, 0, row, "ATR Multiple From MA", text_color=txtColor, text_size=ts, text_halign=text.align_right)
        table.cell(t, 1, row, f_fmt(atrMultFromMA, "x"), text_color=multCol, text_size=ts, text_halign=text.align_right)
        row += 1

    if showPctGain
        table.cell(t, 0, row, "% Gain From MA", text_color=txtColor, text_size=ts, text_halign=text.align_right)
        table.cell(t, 1, row, f_fmt(pctGainFromMA, "%"), text_color=valColor, text_size=ts, text_halign=text.align_right)
        row += 1

    if showAtrPct
        table.cell(t, 0, row, "ATR %", text_color=txtColor, text_size=ts, text_halign=text.align_right)
        table.cell(t, 1, row, f_fmt(atrPct, "%"), text_color=valColor, text_size=ts, text_halign=text.align_right)
        row += 1

    if showAdrPct
        table.cell(t, 0, row, "ADR%", text_color=txtColor, text_size=ts, text_halign=text.align_right)
        table.cell(t, 1, row, f_fmt(adrPct, "%"), text_color=valColor, text_size=ts, text_halign=text.align_right)
        row += 1