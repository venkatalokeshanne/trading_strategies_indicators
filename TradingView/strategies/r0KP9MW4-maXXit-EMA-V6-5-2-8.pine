// ========================================
// ADAPTIVE SYSTEM INPUTS
//
// comment off to check the best Configuration
// of trading parameters
// ========================================
// EMA Triger Inputs
group_ema = '🛡️ EMA Trigger signals'
FIX_PARAM = input.bool(true, '📌 Use predefined Parameter', group = group_ema, inline = "1")   
BASE_REENTRY = input.bool(false, '💹 Re Entry', group = group_ema, inline = "1")
BASE_SETBACK = input.bool(false, '⏬ Use SetBack', group = group_ema, inline = "1", tooltip = 'Waits for prices to set back to the outbreak level in fastEMA. Changes the EMA settings completely !')
fastLength = input.int(21, 'EMA TriggerLine (Standard 19)', options = [3, 5, 8, 13, 15, 17, 19, 21, 25, 29, 34, 42], group = group_ema, tooltip = 'Trigger Value crossing the EMA 55')
Trendline = input.int(178, 'EMA TrendLine (Standard 178)', options = [55, 77, 89, 120, 144, 178, 200, 233], group = group_ema, tooltip = 'Standard=155 - defines the value of the TrendLine if Trend is rising or falling')
BackLength = input.int(3, 'EMA LookBack (Standard 3, exceptional modification)', options = [1, 2, 3, 4], group = group_ema, tooltip = 'Standard=3 - sets the bars looking back for the TrendLine rising or falling. Sets the systems speed and number of trades')

group_trade = '🎯 Trade Settings'
LONG_ONLY = input.bool(false, '🟢↑ Execute only LONG Trades', group = group_trade, inline = "2", tooltip = 'take into account the market conditions to avoid too many failtrades')   
SHORT_ONLY = input.bool(false, '🔴↓ Execute only SHORT Trades', group = group_trade, inline = "2", tooltip = 'take into account the market conditions to avoid too many failtrades')   
SIGNAL_GEN = input.string('FUT','🗝️ Signal Generation (FUT => for mirror trading)', options = ['FUT','INSTRUMENT','None'], group = group_trade)
MIRROR_TRD = input.string('NO', '🔂 Mirror trade - trade STK/CFD instead of future', options = ['NO','YES'], group = group_trade)
INSTR_TRD = input.string('CFD', '🎸 Instrument You want to trade (if mirror trade)', options = ['CFD','STK'], group = group_trade, tooltip = 'choose other Instrument instead of futures - in case of mirror trade signals are triggered by the according future.')
ENABLE_SWITCH = input.string('YES', '⚡ Allow json direct switch from long to short', options = ['YES', 'NO'], group = group_trade, tooltip = 'triggers double instrument size for direct switch from long to short for json alerts. (if there is already a open position in the opposite direction set this to YES)')
MAX_SIZE = input.float(1,'🪜 Maximum futures (depends on account size)', minval = 1, maxval = 5, step = 1, group = group_trade, tooltip = 'if preconfigured, no change possible')
MAX_PYRAMID = input.int(1,'🪜 Maximum trades in one direction (Pyramiding)', minval = 1, maxval = 5, step = 1, group = group_trade, tooltip = 'if preconfigured, no change possible')

group_risk = '♨️ Risk, Stop and Take Profit'
AUTO_TRL = input.bool(false, 'Auto Trail ', group = group_risk, tooltip = 'triggers an automatic trailing stop', inline = "2")    
BASE_TRL_STOP = input.bool(false, 'Configure Stop ', group = group_risk, tooltip = 'if You want to apply a trailing stop - configured with BASE_RISK % (usually worse P/L but lower drawdown)', inline = "2")
BASE_TGT = input.bool(false, 'Configure TP ', group = group_risk, tooltip = 'AUTO_TRAIL: triggers a trailing stop applied by BASE_RIDK - CONFIGURE STOP: Manually apply a stop - risk configured with BASE_RISK % (usually worse P/L but lower drawdown) - apply a Take Profit exit', inline = "2")
BASE_RISK = input.float(1.0, '💀 Risk Per Trade % (Trailstop config)', minval = 0.1, maxval = 20.0, step = 0.2, group = group_risk, tooltip = 'Percentage of account risked per trade (before adaptive adjustments).')
BASE_TP = input.float(5.0, '💲 Take Profit per Trade % (Target Limit config)', minval = 1.0, maxval = 30.0, step = 0.5, group = group_risk, tooltip = 'Percentage Take Profit per trade (before adaptive adjustments). Only relevant for AI-Trading')

group_account = '🏛️ Account Settings'
