//@version=5
strategy("09:29 NY Limit Reversal", overlay=true, initial_capital=10000, max_bars_back=500)

// ==============================
// 1. 參數設定
// ==============================
offset    = input.float(20.0, title="掛單距離 (Offset)", step=1.0)
sl_points = input.float(10.0, title="止損點數 (SL)", step=1.0)
rr_ratio  = input.float(2.0,  title="盈虧比 (RR)", step=0.1)

// ==============================
// 2. 狀態追蹤
// ==============================
var float ref_close  = na
var float buy_limit  = na
var float sell_limit = na
var bool  has_ordered_today = false 

// 換日重置
if ta.change(time("D", "America/New_York")) != 0
    ref_close := na
    buy_limit := na
    sell_limit := na
    has_ordered_today := false
    strategy.cancel_all()

// ==============================
// 3. 核心邏輯：鎖定 09:29 收盤價
// ==============================
ny_time   = hour(time, "America/New_York") * 100 + minute(time, "America/New_York")
is_0929   = (ny_time == 929)
is_0935_up = (ny_time >= 935)

if is_0929
    ref_close := close
    // --- 邏輯修正處 ---
    buy_limit  := ref_close - offset // 低過收盤價才買 (Long)
    sell_limit := ref_close + offset // 高過收盤價才賣 (Short)

// ==============================
// 4. 35 分自動撤單
// ==============================
if is_0935_up and strategy.position_size == 0 and has_ordered_today == true
    strategy.cancel_all()
    has_ordered_today := true 

// ==============================
// 5. 掛單執行 (使用 Limit 限價單)
// ==============================
can_execute = not na(ref_close) and has_ordered_today == false and ny_time < 935 and strategy.position_size == 0

if can_execute
    has_ordered_today := true
    
    // 多單出場計算
    buy_tp = buy_limit + (sl_points * rr_ratio)
    buy_sl = buy_limit - sl_points
    
    // 空單出場計算
    sell_tp = sell_limit - (sl_points * rr_ratio)
    sell_sl = sell_limit + sl_points

    // 發送限價單 (Limit Order)
    strategy.entry("Long", strategy.long, limit=buy_limit, comment="L-Limit")
    strategy.exit("ExL", from_entry="Long", stop=buy_sl, limit=buy_tp, comment="L-Out")

    strategy.entry("Short", strategy.short, limit=sell_limit, comment="S-Limit")
    strategy.exit("ExS", from_entry="Short", stop=sell_sl, limit=sell_tp, comment="S-Out")

// OCO 保護
if strategy.position_size != 0
    strategy.cancel("Long")
    strategy.cancel("Short")

// ==============================
// 6. 視覺化
// ==============================
show_line = not has_ordered_today and not na(ref_close) and ny_time < 935
plot(show_line ? buy_limit : na, "多單限價位", color.new(color.green, 0), 2, plot.style_linebr)
plot(show_line ? sell_limit : na, "空單限價位", color.new(color.red, 0), 2, plot.style_linebr)
plotshape(is_0929, style=shape.xcross, location=location.belowbar, color=color.blue, size=size.small)