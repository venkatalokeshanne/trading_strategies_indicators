                            line.set_xy2(middleGlowRay, rayEndTime, rayEndPrice)
                            line.set_extend(middleGlowRay, infiniteProjection ? extend.right : extend.none)
                            line.set_color(middleGlowRay, middleGlowColor)
                            line.set_style(middleGlowRay, activeLineStyle)
                            line.set_width(middleGlowRay, lineWidthInput + 2)
                    else
                        if not na(outerGlowRay)
                            line.delete(outerGlowRay)
                            array.set(fanOuterGlowLines, lineIndex, na)
                        if not na(middleGlowRay)
                            line.delete(middleGlowRay)
                            array.set(fanMiddleGlowLines, lineIndex, na)

                    if na(ray)
                        ray := line.new(
                            x1 = originTime,
                            y1 = originPrice,
                            x2 = rayEndTime,
                            y2 = rayEndPrice,
                            xloc = xloc.bar_time,
                            extend = infiniteProjection ? extend.right : extend.none,
                            color = rayColor,
                            style = activeLineStyle,
                            width = lineWidthInput
                        )
                        array.set(fanLines, lineIndex, ray)
                    else
                        line.set_xy1(ray, originTime, originPrice)
                        line.set_xy2(ray, rayEndTime, rayEndPrice)
                        line.set_extend(ray, infiniteProjection ? extend.right : extend.none)
                        line.set_color(ray, rayColor)
                        line.set_style(ray, activeLineStyle)
                        line.set_width(ray, lineWidthInput)
                else if not na(ray)
                    line.delete(ray)
                    array.set(fanLines, lineIndex, na)
