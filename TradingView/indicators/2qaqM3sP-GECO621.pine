//@version=6
indicator("FUTURES / SPY LEVELS", overlay=true, max_lines_count=500, max_labels_count=500)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LEVELS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

groupLevels = "LEVELS"

showPDC = input.bool(true, "PDC", group=groupLevels)
showDO  = input.bool(true, "DO", group=groupLevels)
showWO  = input.bool(true, "WO", group=groupLevels)
showPDH = input.bool(true, "PDH", group=groupLevels)
showPDL = input.bool(true, "PDL", group=groupLevels)
showPMH = input.bool(true, "PMH", group=groupLevels)
showPML = input.bool(true, "PML", group=groupLevels)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SPY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

groupSPY = "SPY"

spyOnlyCurrentDay = input.bool(
     true,
     "SPY Only Current Day",
     group=groupSPY)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FUTURES HISTORY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

groupHistory = "HISTORY"

daysBack = input.int(
     5,
     "Futures Days Back",
     minval=1,
     maxval=50,
     group=groupHistory)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LINES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

groupProjection = "LINES"

linesLookBack = input.int(
     20,
     "Lines Look Back",
     minval=0,
     maxval=500,
     group=groupProjection)

linesForward = input.int(
     20,
     "Lines Forward",
     minval=0,
     maxval=500,
     group=groupProjection)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TEXT
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

groupLabels = "TEXT"

showLabels = input.bool(
     true,
     "Show Labels",
     group=groupLabels)

showPrice = input.bool(
     true,
     "Show Price",
     group=groupLabels)

textOffset = input.int(
     5,
     "Text Offset",
     minval=-100,
     maxval=100,
     group=groupLabels)

labelSizeInput = input.string(
     "Small",
     "Text Size",
     options=["Tiny", "Small", "Normal", "Large"],
     group=groupLabels)

labelSize =
     labelSizeInput == "Tiny" ? size.tiny :
     labelSizeInput == "Normal" ? size.normal :
     labelSizeInput == "Large" ? size.large :
     size.small

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// STYLE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

groupStyle = "STYLE"

lineWidth = input.int(
     2,
     "Line Width",
     minval=1,
     maxval=5,
     group=groupStyle)

lineStyleInput = input.string(
     "Solid",
     "Line Style",
     options=["Solid", "Dashed", "Dotted"],
     group=groupStyle)

lineStyle =
     lineStyleInput == "Dashed" ? line.style_dashed :
     lineStyleInput == "Dotted" ? line.style_dotted :
     line.style_solid

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// COLORS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

groupColors = "COLORS"

pdcColor = input.color(color.orange, "PDC", group=groupColors)
doColor  = input.color(color.blue, "DO", group=groupColors)
woColor  = input.color(color.purple, "WO", group=groupColors)
pdhColor = input.color(color.green, "PDH", group=groupColors)
pdlColor = input.color(color.red, "PDL", group=groupColors)
pmhColor = input.color(color.aqua, "PMH", group=groupColors)
pmlColor = input.color(color.fuchsia, "PML", group=groupColors)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// OPENING BELL
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

groupBell = "OPENING BELL"

showOpeningBell = input.bool(
     true,
     "Show Opening Bell",
     group=groupBell)

openingBellColor = input.color(
     color.yellow,
     "Color",
     group=groupBell)

openingBellWidth = input.int(
     2,
     "Width",
     minval=1,
     maxval=5,
     group=groupBell)

openingBellStyleInput = input.string(
     "Dashed",
     "Style",
     options=["Solid", "Dashed", "Dotted"],
     group=groupBell)

openingBellStyle =
     openingBellStyleInput == "Dashed" ? line.style_dashed :
     openingBellStyleInput == "Dotted" ? line.style_dotted :
     line.style_solid

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SPECIAL EMA
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

groupEMA = "SPECIAL EMA"

showEMA1 = input.bool(
     true,
     "Show EMA 1",
     group=groupEMA)

ema1Length = input.int(
     9,
     "EMA 1 Length",
     minval=1,
     group=groupEMA)

ema1TF = input.timeframe(
     "5",
     "EMA 1 Timeframe",
     group=groupEMA)

ema1Color = input.color(
     color.white,
     "EMA 1 Color",
     group=groupEMA)

ema1Width = input.int(
     2,
     "EMA 1 Width",
     minval=1,
     maxval=5,
     group=groupEMA)

showEMA2 = input.bool(
     true,
     "Show EMA 2",
     group=groupEMA)

ema2Length = input.int(
     21,
     "EMA 2 Length",
     minval=1,
     group=groupEMA)

ema2TF = input.timeframe(
     "15",
     "EMA 2 Timeframe",
     group=groupEMA)

ema2Color = input.color(
     color.yellow,
     "EMA 2 Color",
     group=groupEMA)

ema2Width = input.int(
     2,
     "EMA 2 Width",
     minval=1,
     maxval=5,
     group=groupEMA)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// EMA
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

ema1 = request.security(
     syminfo.tickerid,
     ema1TF,
     ta.ema(close, ema1Length),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

ema2 = request.security(
     syminfo.tickerid,
     ema2TF,
     ta.ema(close, ema2Length),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

plot(
     showEMA1 ? ema1 : na,
     title="EMA 1",
     color=ema1Color,
     linewidth=ema1Width)

plot(
     showEMA2 ? ema2 : na,
     title="EMA 2",
     color=ema2Color,
     linewidth=ema2Width)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SYMBOL TYPE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

isEquity =
     syminfo.type == "stock" or
     syminfo.type == "fund"

isFutures =
     syminfo.type == "futures"

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TIME DISTANCE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

barSeconds = timeframe.in_seconds()

barMs =
     na(barSeconds) ?
     60000 :
     barSeconds * 1000

lookBackMs = linesLookBack * barMs
forwardMs  = linesForward * barMs
textMs     = textOffset * barMs

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SPY REGULAR DATA
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

spyRegularTicker = ticker.new(
     syminfo.prefix,
     syminfo.ticker,
     session.regular)

// Yesterday RTH close
equityPDC = request.security(
     spyRegularTicker,
     "D",
     close[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

// Yesterday RTH high
equityPDH = request.security(
     spyRegularTicker,
     "D",
     high[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

// Yesterday RTH low
equityPDL = request.security(
     spyRegularTicker,
     "D",
     low[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

// Current RTH open
equityDO = request.security(
     spyRegularTicker,
     "D",
     open,
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

// Current weekly open
equityWO = request.security(
     spyRegularTicker,
     "W",
     open,
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FUTURES SETTINGS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

groupFutures = "FUTURES"

futuresTimezone = input.string(
     "America/Chicago",
     "Futures Timezone",
     options=[
         "America/Chicago",
         "America/New_York",
         "Europe/Ljubljana",
         "UTC"
     ],
     group=groupFutures)

futuresCloseHour = input.int(
     23,
     "Futures Close Hour",
     minval=0,
     maxval=23,
     group=groupFutures)

futuresOpenHour = input.int(
     0,
     "Futures Open Hour",
     minval=0,
     maxval=23,
     group=groupFutures)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FUTURES 23:00 / 00:00
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

fHour = hour(time, futuresTimezone)
fMinute = minute(time, futuresTimezone)

closeHour = hour(time_close, futuresTimezone)
closeMinute = minute(time_close, futuresTimezone)

futuresCloseBar =
     closeHour == futuresCloseHour and
     closeMinute == 0

futuresOpenBar =
     fHour == futuresOpenHour and
     fMinute == 0

var float futuresPDC = na
var float futuresDO = na
var float futuresPDH = na
var float futuresPDL = na

var float futuresDayHigh = na
var float futuresDayLow = na

var bool futuresReady = false

if futuresCloseBar

    futuresPDC := close

    futuresPDH := futuresDayHigh
    futuresPDL := futuresDayLow

if futuresOpenBar

    futuresDO := open

    futuresDayHigh := high
    futuresDayLow := low

    futuresReady := true

else if futuresReady

    futuresDayHigh :=
         math.max(
             nz(futuresDayHigh, high),
             high)

    futuresDayLow :=
         math.min(
             nz(futuresDayLow, low),
             low)

futuresWO = request.security(
     syminfo.tickerid,
     "W",
     open,
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FINAL VALUES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

levelPDC =
     isEquity ?
     equityPDC :
     futuresPDC

levelDO =
     isEquity ?
     equityDO :
     futuresDO

levelWO =
     isEquity ?
     equityWO :
     futuresWO

levelPDH =
     isEquity ?
     equityPDH :
     futuresPDH

levelPDL =
     isEquity ?
     equityPDL :
     futuresPDL

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PRE-MARKET
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

groupPM = "PRE-MARKET"

pmSession = input.session(
     "0400-0930",
     "Pre-Market Session",
     group=groupPM)

inPM = not na(
     time(
         timeframe.period,
         pmSession,
         "America/New_York"))

newPM =
     inPM and
     not inPM[1]

endPM =
     not inPM and
     inPM[1]

var float pmh = na
var float pml = na

// New premarket = reset PMH/PML
if newPM

    pmh := high
    pml := low

else if inPM

    pmh :=
         math.max(
             nz(pmh, high),
             high)

    pml :=
         math.min(
             nz(pml, low),
             low)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ARRAYS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var pdcLines = array.new_line()
var doLines  = array.new_line()
var woLines  = array.new_line()
var pdhLines = array.new_line()
var pdlLines = array.new_line()
var pmhLines = array.new_line()
var pmlLines = array.new_line()

var pdcLabels = array.new_label()
var doLabels  = array.new_label()
var woLabels  = array.new_label()
var pdhLabels = array.new_label()
var pdlLabels = array.new_label()
var pmhLabels = array.new_label()
var pmlLabels = array.new_label()

var bellLines = array.new_line()

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ACTUAL FIRST SPY REGULAR BAR
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

newEquityDay =
     isEquity and
     session.isfirstbar_regular

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DRAW LEVEL
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

drawLevel(
     float price,
     string levelName,
     color levelColor,
     array<line> lineArray,
     array<label> labelArray) =>

    if not na(price)

        startX = time - lookBackMs
        endX = time + forwardMs
        labelX = endX + textMs

        newLine = line.new(
             startX,
             price,
             endX,
             price,
             xloc=xloc.bar_time,
             color=levelColor,
             width=lineWidth,
             style=lineStyle)

        array.push(
             lineArray,
             newLine)

        if showLabels

            labelString =
                 showPrice ?
                 levelName + "  " +
                 str.tostring(
                     price,
                     format.mintick) :
                 levelName

            newLabel = label.new(
                 labelX,
                 price,
                 labelString,
                 xloc=xloc.bar_time,
                 style=label.style_label_left,
                 color=levelColor,
                 textcolor=color.white,
                 size=labelSize)

            array.push(
                 labelArray,
                 newLabel)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DELETE ARRAY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

deleteLines(array<line> arr) =>

    while array.size(arr) > 0

        oldLine = array.shift(arr)

        line.delete(oldLine)

deleteLabels(array<label> arr) =>

    while array.size(arr) > 0

        oldLabel = array.shift(arr)

        label.delete(oldLabel)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SPY — DELETE OLD DAY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// IMPORTANT:
// For SPY we delete the complete previous day
// BEFORE creating today's levels.
//
// PMH/PML are also deleted here because they
// belong to the previous premarket.
// Then today's PMH/PML are drawn below.

if isEquity and
   newEquityDay and
   spyOnlyCurrentDay

    deleteLines(pdcLines)
    deleteLines(doLines)
    deleteLines(woLines)
    deleteLines(pdhLines)
    deleteLines(pdlLines)
    deleteLines(pmhLines)
    deleteLines(pmlLines)

    deleteLabels(pdcLabels)
    deleteLabels(doLabels)
    deleteLabels(woLabels)
    deleteLabels(pdhLabels)
    deleteLabels(pdlLabels)
    deleteLabels(pmhLabels)
    deleteLabels(pmlLabels)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SPY DAILY LEVELS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if isEquity and newEquityDay

    if showPDC

        drawLevel(
             equityPDC,
             "PDC",
             pdcColor,
             pdcLines,
             pdcLabels)

    if showDO

        drawLevel(
             equityDO,
             "DO",
             doColor,
             doLines,
             doLabels)

    if showWO

        drawLevel(
             equityWO,
             "WO",
             woColor,
             woLines,
             woLabels)

    if showPDH

        drawLevel(
             equityPDH,
             "PDH",
             pdhColor,
             pdhLines,
             pdhLabels)

    if showPDL

        drawLevel(
             equityPDL,
             "PDL",
             pdlColor,
             pdlLines,
             pdlLabels)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SPY PMH / PML
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// At 09:30 the premarket has ended.
// We create today's PMH/PML.
//
// IMPORTANT:
// We do NOT delete them after creating them.

if isEquity and newEquityDay

    if showPMH and not na(pmh)

        drawLevel(
             pmh,
             "PMH",
             pmhColor,
             pmhLines,
             pmhLabels)

    if showPML and not na(pml)

        drawLevel(
             pml,
             "PML",
             pmlColor,
             pmlLines,
             pmlLabels)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FUTURES DAILY LEVELS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if isFutures and futuresOpenBar

    if showPDC

        drawLevel(
             futuresPDC,
             "PDC",
             pdcColor,
             pdcLines,
             pdcLabels)

    if showDO

        drawLevel(
             futuresDO,
             "DO",
             doColor,
             doLines,
             doLabels)

    if showWO

        drawLevel(
             futuresWO,
             "WO",
             woColor,
             woLines,
             woLabels)

    if showPDH

        drawLevel(
             futuresPDH,
             "PDH",
             pdhColor,
             pdhLines,
             pdhLabels)

    if showPDL

        drawLevel(
             futuresPDL,
             "PDL",
             pdlColor,
             pdlLines,
             pdlLabels)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FUTURES PMH / PML
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if isFutures and endPM

    if showPMH and not na(pmh)

        drawLevel(
             pmh,
             "PMH",
             pmhColor,
             pmhLines,
             pmhLabels)

    if showPML and not na(pml)

        drawLevel(
             pml,
             "PML",
             pmlColor,
             pmlLines,
             pmlLabels)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// EXTEND LAST LINES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

currentEnd = time + forwardMs
currentLabelX = currentEnd + textMs

if array.size(pdcLines) > 0

    line.set_x2(
         array.get(
             pdcLines,
             array.size(pdcLines) - 1),
         currentEnd)

if array.size(pdcLabels) > 0

    label.set_x(
         array.get(
             pdcLabels,
             array.size(pdcLabels) - 1),
         currentLabelX)

if array.size(doLines) > 0

    line.set_x2(
         array.get(
             doLines,
             array.size(doLines) - 1),
         currentEnd)

if array.size(doLabels) > 0

    label.set_x(
         array.get(
             doLabels,
             array.size(doLabels) - 1),
         currentLabelX)

if array.size(woLines) > 0

    line.set_x2(
         array.get(
             woLines,
             array.size(woLines) - 1),
         currentEnd)

if array.size(woLabels) > 0

    label.set_x(
         array.get(
             woLabels,
             array.size(woLabels) - 1),
         currentLabelX)

if array.size(pdhLines) > 0

    line.set_x2(
         array.get(
             pdhLines,
             array.size(pdhLines) - 1),
         currentEnd)

if array.size(pdhLabels) > 0

    label.set_x(
         array.get(
             pdhLabels,
             array.size(pdhLabels) - 1),
         currentLabelX)

if array.size(pdlLines) > 0

    line.set_x2(
         array.get(
             pdlLines,
             array.size(pdlLines) - 1),
         currentEnd)

if array.size(pdlLabels) > 0

    label.set_x(
         array.get(
             pdlLabels,
             array.size(pdlLabels) - 1),
         currentLabelX)

if array.size(pmhLines) > 0

    line.set_x2(
         array.get(
             pmhLines,
             array.size(pmhLines) - 1),
         currentEnd)

if array.size(pmhLabels) > 0

    label.set_x(
         array.get(
             pmhLabels,
             array.size(pmhLabels) - 1),
         currentLabelX)

if array.size(pmlLines) > 0

    line.set_x2(
         array.get(
             pmlLines,
             array.size(pmlLines) - 1),
         currentEnd)

if array.size(pmlLabels) > 0

    label.set_x(
         array.get(
             pmlLabels,
             array.size(pmlLabels) - 1),
         currentLabelX)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// OPENING BELL — NO TEXT
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

openingBell =
     isEquity and
     session.isfirstbar_regular

if openingBell and showOpeningBell

    bellLine = line.new(
         bar_index,
         low,
         bar_index,
         high,
         color=openingBellColor,
         width=openingBellWidth,
         style=openingBellStyle,
         extend=extend.both)

    array.push(
         bellLines,
         bellLine)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FUTURES HISTORY CLEANUP
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

trimLines(array<line> arr) =>

    while array.size(arr) > daysBack

        oldLine = array.shift(arr)

        line.delete(oldLine)

trimLabels(array<label> arr) =>

    while array.size(arr) > daysBack

        oldLabel = array.shift(arr)

        label.delete(oldLabel)

if isFutures

    trimLines(pdcLines)
    trimLines(doLines)
    trimLines(woLines)
    trimLines(pdhLines)
    trimLines(pdlLines)
    trimLines(pmhLines)
    trimLines(pmlLines)

    trimLabels(pdcLabels)
    trimLabels(doLabels)
    trimLabels(woLabels)
    trimLabels(pdhLabels)
    trimLabels(pdlLabels)
    trimLabels(pmhLabels)
    trimLabels(pmlLabels)
