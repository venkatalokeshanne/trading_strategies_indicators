//@version=6
//@version=5
strategy("ETH Long | MVRV Setup", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10, process_orders_on_close=true)

// ─── Trade Parameters ───
entryZoneLow  = input.float(1800.0, "Entry Zone - Lower Bound")
entryZoneHigh = input.float(1950.0, "Entry Zone - Upper Bound")
sl_level      = input.float(1680.0, "Stop Loss")
tp1_level     = input.float(2245.0, "TP1 — Realized Price")
tp2_level     = input.float(2650.0, "TP2 — Intermediate Target")
tp3_level     = input.float(3000.0, "TP3 — Final Target")

// ─── Technical Indicators ───
ema21  = ta.ema(close, 21)
ema55  = ta.ema(close, 55)
ema200 = ta.ema(close, 200)
rsi    = ta.rsi(close, 14)
volMA  = ta.sma(volume, 20)

// ─── Entry Conditions ───
longCondition = close >= entryZoneLow and close <= entryZoneHigh
             and ema21 > ema55
             and close > 1800.0
             and rsi > 45 and rsi < 70
             and volume > volMA
             and strategy.position_size == 0

// ─── Execution ───
if longCondition
    strategy.entry("ETH Long", strategy.long)
    strategy.exit("TP1", "ETH Long", qty_percent=40, limit=tp1_level, stop=sl_level)
    strategy.exit("TP2", "ETH Long", qty_percent=35, limit=tp2_level, stop=sl_level)
    strategy.exit("TP3", "ETH Long", qty_percent=25, limit=tp3_level, stop=sl_level)

// ─── Level Visualization ───
plot(ema21,  "EMA 21",  color=color.new(color.yellow, 0), linewidth=1)
plot(ema55,  "EMA 55",  color=color.new(color.orange, 0), linewidth=1)
plot(ema200, "EMA 200", color=color.new(color.red, 0),    linewidth=2)

hline(1580.0,    "Support $1,580",    color=color.new(color.gray, 40),   linestyle=hline.style_dashed)
hline(1800.0,    "MVRV 0.8 / $1,800", color=color.new(color.aqua, 20),   linestyle=hline.style_solid,  linewidth=2)
hline(2245.0,    "Realized $2,245",   color=color.new(color.purple, 20), linestyle=hline.style_dotted, linewidth=2)
hline(tp2_level, "TP2 $2,650",        color=color.new(color.lime, 40),   linestyle=hline.style_dashed)
hline(3000.0,    "Target $3,000",     color=color.new(color.green, 0),   linestyle=hline.style_solid,  linewidth=2)
hline(sl_level,  "SL $1,680",         color=color.new(color.red, 0),     linestyle=hline.style_solid,  linewidth=2)

// ─── Entry Zone Background ───
bgcolor(close >= entryZoneLow and close <= entryZoneHigh ? color.new(color.blue, 88) : na, title="Entry Zone")

// ─── Info Table ───
var table info = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 60), border_color=color.gray, border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "Parameter",     text_color=color.yellow, text_size=size.small)
    table.cell(info, 1, 0, "Level",         text_color=color.yellow, text_size=size.small)
    table.cell(info, 0, 1, "Entry (zone)",  text_color=color.white,  text_size=size.small)
    table.cell(info, 1, 1, "$1,800–$1,950", text_color=color.aqua,   text_size=size.small)
    table.cell(info, 0, 2, "Stop Loss",     text_color=color.white,  text_size=size.small)
    table.cell(info, 1, 2, "$1,680",        text_color=color.red,    text_size=size.small)
    table.cell(info, 0, 3, "TP1 (40%)",    text_color=color.white,  text_size=size.small)
    table.cell(info, 1, 3, "$2,245",        text_color=color.lime,   text_size=size.small)
    table.cell(info, 0, 4, "TP2 (35%)",    text_color=color.white,  text_size=size.small)
    table.cell(info, 1, 4, "$2,650",        text_color=color.lime,   text_size=size.small)
    table.cell(info, 0, 5, "TP3 (25%)",    text_color=color.white,  text_size=size.small)
    table.cell(info, 1, 5, "$3,000",        text_color=color.green,  text_size=size.small)
    table.cell(info, 0, 6, "R:R",           text_color=color.white,  text_size=size.small)
    table.cell(info, 1, 6, "≈ 1:4.5",       text_color=color.purple, text_size=size.small)