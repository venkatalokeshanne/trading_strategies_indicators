//@version=6
indicator("EMA 20 50 100 200 Intraday Lite", shorttitle="EMA 20-200 Lite", overlay=true, max_labels_count=500)

// EMA SIGNAL SETTINGS
groupSignal = "1. EMA Signals"

mode = input.string(
     "Balanced",
     "Signal mode",
     options=["Conservative", "Balanced", "Aggressive"],
     group=groupSignal)

cooldownBars = input.int(
     8,
     "Bars between signals",
     minval=0,
     maxval=100,
     group=groupSignal)

confirmClose = input.bool(
     true,
     "Confirm at candle close",
     group=groupSignal)

showEmas = input.bool(
     true,
     "Show EMA lines",
     group=groupSignal)

// DIRECTION FILTER
groupBias = "2. Direction filter"

useAutoBias = input.bool(
     true,
     "Automatic bias timeframe",
     group=groupBias)

manualBiasTf = input.timeframe(
     "60",
     "Manual bias timeframe",
     group=groupBias)

useBias = input.bool(
     true,
     "Use direction filter",
     group=groupBias)

// M1-M5 uses H1.
// M15 uses H4.
// M30-H1 uses H4.
// H4 and higher use Daily.
autoBiasTf = timeframe.isminutes and timeframe.multiplier <= 5 ? "60" : timeframe.isminutes and timeframe.multiplier <= 15 ? "240" : timeframe.isminutes and timeframe.multiplier <= 60 ? "240" : "D"

biasTf = useAutoBias ? autoBiasTf : manualBiasTf

// SESSIONS
groupSession = "3. Sessions"

useSessions = input.bool(
     true,
     "Use Asia London and New York",
     group=groupSession)

sessionZone = input.string(
     "Europe/Rome",
     "Timezone",
     group=groupSession)

asiaSession = input.session(
     "0100-0800",
     "Asia",
     group=groupSession)

londonSession = input.session(
     "0800-1200",
     "London",
     group=groupSession)

newYorkSession = input.session(
     "1400-1800",
     "New York",
     group=groupSession)

// ENTRY AND TARGETS
groupRisk = "4. Entry and targets"

atrLen = input.int(
     14,
     "ATR length",
     minval=2,
     group=groupRisk)

slAtrBuffer = input.float(
     0.20,
     "Stop ATR buffer",
     minval=0.0,
     step=0.05,
     group=groupRisk)

stopLookback = input.int(
     5,
     "Stop structure length",
     minval=2,
     maxval=30,
     group=groupRisk)

tp1R = input.float(
     1.0,
     "TP1 R",
     minval=0.25,
     step=0.25,
     group=groupRisk)

tp2R = input.float(
     2.0,
     "TP2 R",
     minval=0.50,
     step=0.25,
     group=groupRisk)

tp3R = input.float(
     3.0,
     "TP3 R",
     minval=0.75,
     step=0.25,
     group=groupRisk)

// EMA CALCULATION
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema100 = ta.ema(close, 100)
ema200 = ta.ema(close, 200)

// EMA LINES
plot(
     showEmas ? ema20 : na,
     "EMA 20",
     color=color.aqua,
     linewidth=2)

plot(
     showEmas ? ema50 : na,
     "EMA 50",
     color=color.orange,
     linewidth=2)

plot(
     showEmas ? ema100 : na,
     "EMA 100",
     color=color.fuchsia,
     linewidth=2)

plot(
     showEmas ? ema200 : na,
     "EMA 200",
     color=color.red,
     linewidth=2)

// HIGHER TIMEFRAME EMA
htfEma20 = request.security(
     syminfo.tickerid,
     biasTf,
     ta.ema(close, 20)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

htfEma50 = request.security(
     syminfo.tickerid,
     biasTf,
     ta.ema(close, 50)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

htfEma100 = request.security(
     syminfo.tickerid,
     biasTf,
     ta.ema(close, 100)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

htfEma200 = request.security(
     syminfo.tickerid,
     biasTf,
     ta.ema(close, 200)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

htfClose = request.security(
     syminfo.tickerid,
     biasTf,
     close[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

// HIGHER TIMEFRAME BIAS
bullBias = htfClose > htfEma200 and htfEma20 > htfEma50 and htfEma50 > htfEma100 and htfEma100 > htfEma200

bearBias = htfClose < htfEma200 and htfEma20 < htfEma50 and htfEma50 < htfEma100 and htfEma100 < htfEma200

// SESSION CONTROL
inAsia = not na(
     time(
         timeframe.period,
         asiaSession,
         sessionZone))

inLondon = not na(
     time(
         timeframe.period,
         londonSession,
         sessionZone))

inNewYork = not na(
     time(
         timeframe.period,
         newYorkSession,
         sessionZone))

sessionOk = not useSessions or inAsia or inLondon or inNewYork or mode == "Aggressive"

// SESSION COLORS
bgcolor(
     useSessions and inAsia
     ? color.new(color.purple, 94)
     : na,
     title="Asia")

bgcolor(
     useSessions and inLondon
     ? color.new(color.blue, 94)
     : na,
     title="London")

bgcolor(
     useSessions and inNewYork
     ? color.new(color.green, 94)
     : na,
     title="New York")

// EMA ALIGNMENT
bullAligned = ema20 > ema50 and ema50 > ema100 and ema100 > ema200

bearAligned = ema20 < ema50 and ema50 < ema100 and ema100 < ema200

// EMA CROSS
bullCross = ta.crossover(
     ema20,
     ema50)

bearCross = ta.crossunder(
     ema20,
     ema50)

// EMA 20 PULLBACK
bullPullback = bullAligned and low <= ema20 and close > ema20 and close > open

bearPullback = bearAligned and high >= ema20 and close < ema20 and close < open

// EMA 20 RECOVERY
bullRecovery = ema20 > ema50 and ta.crossover(close, ema20) and close > ema100

bearRecovery = ema20 < ema50 and ta.crossunder(close, ema20) and close < ema100

// SIGNAL MODES
// Conservative:
// Full alignment and EMA 20 pullback.
//
// Balanced:
// Full alignment plus pullback or recovery.
//
// Aggressive:
// Pullback, EMA cross or recovery.
bullPattern = mode == "Conservative" ? bullAligned and bullPullback : mode == "Balanced" ? bullAligned and (bullPullback or bullRecovery) : (bullAligned and bullPullback) or bullCross or bullRecovery

bearPattern = mode == "Conservative" ? bearAligned and bearPullback : mode == "Balanced" ? bearAligned and (bearPullback or bearRecovery) : (bearAligned and bearPullback) or bearCross or bearRecovery

// SIGNAL CONFIRMATION
barOk = not confirmClose or barstate.isconfirmed

var int lastSignalBar = na

cooldownOk = na(lastSignalBar) or bar_index - lastSignalBar > cooldownBars

buySignal = bullPattern and (not useBias or bullBias) and sessionOk and barOk and cooldownOk

sellSignal = bearPattern and (not useBias or bearBias) and sessionOk and barOk and cooldownOk

// ATR
atr = ta.atr(atrLen)

// ENTRY, STOP LOSS AND TARGETS
var float entryPrice = na
var float stopPrice = na

var float tp1Price = na
var float tp2Price = na
var float tp3Price = na

var int direction = 0
var string setupType = "WAIT"

// BUY LEVELS
if buySignal
    entryPrice := close

    stopPrice := ta.lowest(
         low,
         stopLookback + 1) - atr * slAtrBuffer

    buyRisk = math.max(
         entryPrice - stopPrice,
         syminfo.mintick)

    tp1Price := entryPrice + buyRisk * tp1R
    tp2Price := entryPrice + buyRisk * tp2R
    tp3Price := entryPrice + buyRisk * tp3R

    direction := 1

    setupType := bullCross ? "CROSS" : bullRecovery ? "RECOVERY" : "PULLBACK"

    lastSignalBar := bar_index

// SELL LEVELS
if sellSignal
    entryPrice := close

    stopPrice := ta.highest(
         high,
         stopLookback + 1) + atr * slAtrBuffer

    sellRisk = math.max(
         stopPrice - entryPrice,
         syminfo.mintick)

    tp1Price := entryPrice - sellRisk * tp1R
    tp2Price := entryPrice - sellRisk * tp2R
    tp3Price := entryPrice - sellRisk * tp3R

    direction := -1

    setupType := bearCross ? "CROSS" : bearRecovery ? "RECOVERY" : "PULLBACK"

    lastSignalBar := bar_index

// BUY AND SELL LABELS
plotshape(
     buySignal,
     title="EMA BUY",
     text="BUY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.lime,
     textcolor=color.black,
     size=size.small)

plotshape(
     sellSignal,
     title="EMA SELL",
     text="SELL",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     textcolor=color.white,
     size=size.small)

// ALERTS
alertcondition(
     buySignal,
     "EMA BUY",
     "EMA 20 50 100 200 BUY {{ticker}} {{interval}} at {{close}}")

alertcondition(
     sellSignal,
     "EMA SELL",
     "EMA 20 50 100 200 SELL {{ticker}} {{interval}} at {{close}}")

// PRICE FORMAT
priceText(value) =>
    na(value) ? "-" : str.tostring(value, format.mintick)

// DIRECTION AND ALIGNMENT
directionText = bullBias ? "BULLISH" : bearBias ? "BEARISH" : "NEUTRAL"

alignmentText = bullAligned ? "20>50>100>200" : bearAligned ? "20<50<100<200" : "MIXED"

// DASHBOARD
var table dashboard = table.new(
     position.top_right,
     2,
     14,
     border_width=1)

if barstate.islast
    table.cell(
         dashboard,
         0,
         0,
         "EMA 20-200",
         bgcolor=color.black,
         text_color=color.white)

    table.cell(
         dashboard,
         1,
         0,
         "LITE",
         bgcolor=color.black,
         text_color=color.yellow)

    table.cell(dashboard, 0, 1, "Chart TF")
    table.cell(dashboard, 1, 1, timeframe.period)

    table.cell(dashboard, 0, 2, "Bias TF")
    table.cell(dashboard, 1, 2, biasTf)

    table.cell(dashboard, 0, 3, "Mode")
    table.cell(dashboard, 1, 3, mode)

    table.cell(dashboard, 0, 4, "Session")

    table.cell(
         dashboard,
         1,
         4,
         inAsia ? "ASIA" : inLondon ? "LONDON" : inNewYork ? "NEW YORK" : "OFF")

    table.cell(dashboard, 0, 5, "Direction")

    table.cell(
         dashboard,
         1,
         5,
         directionText,
         text_color=directionText == "BULLISH" ? color.lime : directionText == "BEARISH" ? color.red : color.orange)

    table.cell(dashboard, 0, 6, "Alignment")
    table.cell(dashboard, 1, 6, alignmentText)

    table.cell(dashboard, 0, 7, "Setup")
    table.cell(dashboard, 1, 7, setupType)

    table.cell(dashboard, 0, 8, "Signal")

    table.cell(
         dashboard,
         1,
         8,
         direction == 1 ? "BUY" : direction == -1 ? "SELL" : "WAIT",
         text_color=direction == 1 ? color.lime : direction == -1 ? color.red : color.orange)

    table.cell(
         dashboard,
         0,
         9,
         "ENTRY",
         text_color=color.yellow)

    table.cell(
         dashboard,
         1,
         9,
         priceText(entryPrice),
         text_color=color.yellow)

    table.cell(
         dashboard,
         0,
         10,
         "STOP LOSS",
         text_color=color.red)

    table.cell(
         dashboard,
         1,
         10,
         priceText(stopPrice),
         text_color=color.red)

    table.cell(
         dashboard,
         0,
         11,
         "TP1",
         text_color=color.aqua)

    table.cell(
         dashboard,
         1,
         11,
         priceText(tp1Price),
         text_color=color.aqua)

    table.cell(
         dashboard,
         0,
         12,
         "TP2",
         text_color=color.lime)

    table.cell(
         dashboard,
         1,
         12,
         priceText(tp2Price),
         text_color=color.lime)

    table.cell(
         dashboard,
         0,
         13,
         "TP3",
         text_color=color.fuchsia)

    table.cell(
         dashboard,
         1,
         13,
         priceText(tp3Price),
         text_color=color.fuchsia)