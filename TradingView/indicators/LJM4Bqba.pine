//@version=6
////EMA, ADX, and VWAP table values ​​for scalping (1, 3, and 5-minute charts), plus DXY status info.
indicator("MTF EMA + ADX / DXY / Multi VWAP Dashboard", overlay = true)

// ============================================================================
// INPUTS
// ============================================================================

grpTable = "Tabelle"

tableSizeInput = input.string(
     "Tiny",
     "Tabellengrösse",
     options = ["Tiny", "Small"],
     group = grpTable)

tablePositionInput = input.string(
     "Links unten",
     "Tabellenposition",
     options = [
         "Links unten",
         "Rechts unten",
         "Links oben",
         "Rechts oben"
     ],
     group = grpTable)

grpEMA = "EMA"

emaFastLength = input.int(
     14,
     "EMA schnell",
     minval = 1,
     group = grpEMA)

emaSlowLength = input.int(
     50,
     "EMA langsam",
     minval = 1,
     group = grpEMA)

grpADX = "ADX"

adxDILength = input.int(
     14,
     "DI Länge",
     minval = 1,
     group = grpADX)

adxSmoothing = input.int(
     14,
     "ADX Glättung",
     minval = 1,
     group = grpADX)

adxLimit = input.float(
     25.0,
     "ADX Grenze",
     step = 0.5,
     group = grpADX)

grpDXY = "DXY"

dxySymbol = input.symbol(
     "TVC:DXY",
     "DXY Symbol",
     group = grpDXY)

grpVWAP = "Rolling VWAP"

vwapSource = input.source(
     hlc3,
     "VWAP Quelle",
     group = grpVWAP)


// ============================================================================
// TABLE SETTINGS
// ============================================================================

f_tableSize() =>
    tableSizeInput == "Small" ? size.small : size.tiny

f_tablePosition() =>
    switch tablePositionInput
        "Rechts unten" => position.bottom_right
        "Links oben"   => position.top_left
        "Rechts oben"  => position.top_right
        => position.bottom_left


// ============================================================================
// EMA FUNCTION
// ============================================================================

f_emaUp() =>
    ta.ema(close, emaFastLength) > ta.ema(close, emaSlowLength)


// ============================================================================
// ADX FUNCTION
// ============================================================================

f_adx() =>
    [plusDI, minusDI, adx] = ta.dmi(
         adxDILength,
         adxSmoothing)
    adx


// ============================================================================
// MULTI TIMEFRAME EMA
// ============================================================================

ema1m  = request.security(syminfo.tickerid, "1",   f_emaUp())
ema2m  = request.security(syminfo.tickerid, "2",   f_emaUp())
ema5m  = request.security(syminfo.tickerid, "5",   f_emaUp())
ema15m = request.security(syminfo.tickerid, "15",  f_emaUp())
ema1h  = request.security(syminfo.tickerid, "60",  f_emaUp())
ema4h  = request.security(syminfo.tickerid, "240", f_emaUp())
ema1D  = request.security(syminfo.tickerid, "D",   f_emaUp())


// ============================================================================
// MULTI TIMEFRAME ADX
// ============================================================================

adx1m  = request.security(syminfo.tickerid, "1",   f_adx())
adx2m  = request.security(syminfo.tickerid, "2",   f_adx())
adx3m  = request.security(syminfo.tickerid, "3",   f_adx())
adx5m  = request.security(syminfo.tickerid, "5",   f_adx())
adx15m = request.security(syminfo.tickerid, "15",  f_adx())
adx1h  = request.security(syminfo.tickerid, "60",  f_adx())
adx4h  = request.security(syminfo.tickerid, "240", f_adx())
adx1D  = request.security(syminfo.tickerid, "D",   f_adx())


// ============================================================================
// DXY - 15 MIN EMA 14 / EMA 50
// ============================================================================

dxyEMA14 = request.security(
     dxySymbol,
     "15",
     ta.ema(close, emaFastLength))

dxyEMA50 = request.security(
     dxySymbol,
     "15",
     ta.ema(close, emaSlowLength))

dxyStrong = dxyEMA14 > dxyEMA50


// ============================================================================
// ROLLING VWAP FUNCTION
// ============================================================================
//
// Berechnung auf 1-Minuten-Daten:
//
// 24h = 1440 Minuten
// 12h =  720 Minuten
//  4h =  240 Minuten
//  2h =  120 Minuten
// ============================================================================

f_rollingVWAP(int length) =>

    float pv = vwapSource * volume

    float avgPV = ta.sma(
         pv,
         length)

    float avgVolume = ta.sma(
         volume,
         length)

    avgVolume != 0 ?
         avgPV / avgVolume :
         na


// ============================================================================
// MULTI ROLLING VWAP
// ============================================================================

vwap24h = request.security(
     syminfo.tickerid,
     "1",
     f_rollingVWAP(1440))

vwap12h = request.security(
     syminfo.tickerid,
     "1",
     f_rollingVWAP(720))

vwap4h = request.security(
     syminfo.tickerid,
     "1",
     f_rollingVWAP(240))

vwap2h = request.security(
     syminfo.tickerid,
     "1",
     f_rollingVWAP(120))


// ============================================================================
// PRICE VS VWAP
// ============================================================================

above24h = close >= vwap24h
above12h = close >= vwap12h
above4h  = close >= vwap4h
above2h  = close >= vwap2h


// ============================================================================
// COLORS
// ============================================================================

colorGreen  = color.new(color.green, 0)
colorRed    = color.new(color.red, 0)
colorYellow = color.new(color.yellow, 0)

colorHeader = color.new(color.gray, 60)
colorEmpty  = color.new(color.gray, 85)

textWhite = color.white
textBlack = color.black


// ============================================================================
// TABLE
// ============================================================================
//
// 7 Spalten:
//
// 1m | 2m | 5m | 15m | 1H | 4H | 1D
//
// Zeile 0 = Timeframe
// Zeile 1 = EMA
// Zeile 2 = ADX
//
// Untere Reihe:
//
// leer | 24h VWAP | 12h VWAP | 4h VWAP | 2h VWAP | 3m ADX | DXY
// ============================================================================

var table dashboard = table.new(
     f_tablePosition(),
     7,
     4,
     border_width = 1)


// ============================================================================
// CELL FUNCTIONS
// ============================================================================

f_headerCell(int column, string tfName) =>

    table.cell(
         dashboard,
         column,
         0,
         tfName,
         bgcolor = colorHeader,
         text_color = textWhite,
         text_size = f_tableSize())


// ----------------------------------------------------------------------------
// EMA CELL
// ----------------------------------------------------------------------------

f_emaCell(int column, bool emaUp) =>

    string emaText =
         emaUp ?
         "EMA ↑" :
         "EMA ↓"

    color emaColor =
         emaUp ?
         colorGreen :
         colorRed

    table.cell(
         dashboard,
         column,
         1,
         emaText,
         bgcolor = emaColor,
         text_color = textWhite,
         text_size = f_tableSize())


// ----------------------------------------------------------------------------
// ADX CELL
// ----------------------------------------------------------------------------

f_adxCell(int column, float adxValue) =>

    bool strong = adxValue >= adxLimit

    string adxText =
         strong ?
         "ADX " + str.tostring(adxValue, "#.0") :
         "WEAK " + str.tostring(adxValue, "#.0")

    table.cell(
         dashboard,
         column,
         2,
         adxText,
         bgcolor =
              strong ?
              colorGreen :
              colorRed,
         text_color = textWhite,
         text_size = f_tableSize())


// ----------------------------------------------------------------------------
// VWAP CELL
// ----------------------------------------------------------------------------

f_vwapCell(
     int column,
     string tfName,
     bool aboveVWAP) =>

    string txt =
         aboveVWAP ?
         tfName + " ↓" :
         tfName + " ↑"

    color bg =
         aboveVWAP ?
         colorGreen :
         colorYellow

    color txtColor =
         aboveVWAP ?
         textWhite :
         textBlack

    table.cell(
         dashboard,
         column,
         3,
         txt,
         bgcolor = bg,
         text_color = txtColor,
         text_size = f_tableSize())


// ============================================================================
// DRAW TABLE
// ============================================================================

if barstate.islast

    // ========================================================================
    // TIMEFRAME HEADERS
    // ========================================================================

    f_headerCell(0, "1m")
    f_headerCell(1, "2m")
    f_headerCell(2, "5m")
    f_headerCell(3, "15m")
    f_headerCell(4, "1H")
    f_headerCell(5, "4H")
    f_headerCell(6, "1D")


    // ========================================================================
    // EMA ROW
    // ========================================================================

    f_emaCell(0, ema1m)
    f_emaCell(1, ema2m)
    f_emaCell(2, ema5m)
    f_emaCell(3, ema15m)
    f_emaCell(4, ema1h)
    f_emaCell(5, ema4h)
    f_emaCell(6, ema1D)


    // ========================================================================
    // ADX ROW
    // ========================================================================

    f_adxCell(0, adx1m)
    f_adxCell(1, adx2m)
    f_adxCell(2, adx5m)
    f_adxCell(3, adx15m)
    f_adxCell(4, adx1h)
    f_adxCell(5, adx4h)
    f_adxCell(6, adx1D)


    // ========================================================================
    // LOWER ROW
    // ========================================================================

    // First cell empty

    table.cell(
         dashboard,
         0,
         3,
         "",
         bgcolor = colorEmpty,
         text_size = f_tableSize())


    // ========================================================================
    // VWAPS
    // ========================================================================

    f_vwapCell(
         1,
         "VWAP 24h",
         above24h)

    f_vwapCell(
         2,
         "VWAP 12h",
         above12h)

    f_vwapCell(
         3,
         "WVAP 4h",
         above4h)

    f_vwapCell(
         4,
         "WVAP 2h",
         above2h)


    // ========================================================================
    // 3 MIN ADX
    // ========================================================================

    bool adx3Strong =
         adx3m >= adxLimit

    string adx3Text =
         adx3Strong ?
         "3m ADX " + str.tostring(adx3m, "#.0") :
         "3m WEAK " + str.tostring(adx3m, "#.0")

    table.cell(
         dashboard,
         5,
         3,
         adx3Text,
         bgcolor =
              adx3Strong ?
              colorGreen :
              colorRed,
         text_color = textWhite,
         text_size = f_tableSize())


    // ========================================================================
    // DXY
    //
    // DXY UP   = ROT
    // DXY DOWN = GRÜN
    // ========================================================================

    string dxyText =
         dxyStrong ?
         "DXY ↑" :
         "DXY ↓"

    table.cell(
         dashboard,
         6,
         3,
         dxyText,
         bgcolor =
              dxyStrong ?
              colorRed :
              colorGreen,
         text_color = textWhite,
         text_size = f_tableSize())