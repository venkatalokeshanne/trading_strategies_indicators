//@version=6
// ============================================================================
//  BUYERS / SELLERS TRAPPED  -  v2
//  Original concept & code: Ivan Labrie (Jan 2017)
// ----------------------------------------------------------------------------
//  Detects a bar where price spiked hard one way (beyond the prior bar's true
//  range), then reversed back through the midpoint and closed AGAINST the spike,
//  trapping the crowd that chased it. It usually resolves as continuation in the
//  opposite direction of the trap: strongest when it agrees with the trend,
//  noisiest in chop.
//
//    * SELLERS TRAPPED (ST, up arrow)   - hard down-spike, then reclaim + close
//      up. Shorts that sold the low are trapped. Bullish continuation.
//    * BUYERS TRAPPED  (BT, down arrow) - hard up-spike, then rejection + close
//      down. Longs that bought the high are trapped. Bearish continuation.
//
//  v2 adds, on top of the UNCHANGED 2017 detection:
//    1) TREND FILTER  - tags each signal aligned / counter / chop and lets you
//       show only the trend-aligned ones (the A+ setups) or fade the rest.
//    2) TRADE PLAN    - an ATR-buffered stop just beyond the spike extreme (the
//       trap's natural invalidation), plus optional entry-trigger and target
//       lines. The spike makes the stop wide by nature, so this reads best as a
//       trend-continuation / add-to-trend tool with a trailing or trend-flip
//       exit, not a fixed small target.
//    3) EXIT CUE      - marks where a trend-aligned trade's trend flips (close
//       back through the MA) or hits the ATR stop. Trend-flip tested as the
//       strongest exit, so it doubles as the "get out" marker.
//    4) ALERTS        - fire on any trap, on trend-aligned traps only, or on the
//       trend-flip exit.
//
//  Detection is the original logic verbatim: spike > true range of the bar
//  before the spike, reclaim through the midpoint, close against the spike.
//  Signals evaluate on the bar close (they can flicker on the forming bar until
//  it closes - normal for any close-based signal).
// ============================================================================

indicator("Buyers/Sellers Trapped", shorttitle = "BuySellTrap v2", overlay = true, max_lines_count = 500, max_labels_count = 500)

// --- Signal detection (unchanged from the 2017 original) --------------------
sellersTrapped = (close[2] - low[1]) > ta.tr[2] and high > (close[2] + low[1]) / 2 and close[1] < close[2] and close[1] < close
buyersTrapped  = (high[1] - close[2]) > ta.tr[2] and low  < (close[2] + high[1]) / 2 and close[1] > close[2] and close[1] > close

// --- Trend context ----------------------------------------------------------
grpTrend  = "Trend filter"
maType    = input.string("EMA", "Trend MA type", options = ["EMA", "SMA"], group = grpTrend)
trendLen  = input.int(50, "Trend MA length", minval = 1, group = grpTrend)
slopeLen  = input.int(3, "Slope lookback (bars)", minval = 1, group = grpTrend, tooltip = "Bars back used to read the MA's slope. Bigger = smoother trend, fewer 'aligned' tags.")
showMA    = input.bool(true, "Plot the trend MA", group = grpTrend)

ma      = maType == "EMA" ? ta.ema(close, trendLen) : ta.sma(close, trendLen)
trendUp = close > ma and ma > ma[slopeLen]
trendDn = close < ma and ma < ma[slopeLen]

// Sellers-trapped = bullish continuation -> aligned in an uptrend.
// Buyers-trapped  = bearish continuation -> aligned in a downtrend.
stAligned = sellersTrapped and trendUp
btAligned = buyersTrapped  and trendDn

// --- Display ----------------------------------------------------------------
grpShow  = "Display"
showMode = input.string("Trend-aligned only", "Show which signals", options = ["Trend-aligned only", "Aligned bright, rest faded", "All equal"], group = grpShow)
bullCol  = input.color(color.green, "Sellers-trapped (bullish)", group = grpShow)
bearCol  = input.color(color.red,   "Buyers-trapped (bearish)",  group = grpShow)
fadeT    = input.int(70, "Faded transparency", minval = 0, maxval = 100, group = grpShow)
showBg   = input.bool(false, "Shade the signal bar background", group = grpShow)

alignedOnly = showMode == "Trend-aligned only"
allEqual    = showMode == "All equal"

stShow = sellersTrapped and (not alignedOnly or stAligned)
btShow = buyersTrapped  and (not alignedOnly or btAligned)
stCol  = (allEqual or stAligned) ? color.new(bullCol, 0) : color.new(bullCol, fadeT)
btCol  = (allEqual or btAligned) ? color.new(bearCol, 0) : color.new(bearCol, fadeT)

plotshape(stShow, title = "Sellers Trapped", location = location.belowbar, color = stCol, style = shape.arrowup,   text = "ST", textcolor = stCol, size = size.small)
plotshape(btShow, title = "Buyers Trapped",  location = location.abovebar, color = btCol, style = shape.arrowdown, text = "BT", textcolor = btCol, size = size.small)

plot(showMA ? ma : na, "Trend MA", color = color.new(color.gray, 40), linewidth = 1)

bgcolor(showBg ? (stShow ? color.new(bullCol, 88) : btShow ? color.new(bearCol, 88) : na) : na, title = "Signal shading")

// --- Trade plan: ATR-buffered stop / entry / target -------------------------
grpPlan   = "Trade plan"
showStop  = input.bool(true, "Draw stop level", group = grpPlan)
atrLen    = input.int(14, "ATR length", minval = 1, group = grpPlan)
stopMult  = input.float(0.5, "Stop buffer beyond spike (ATR)", minval = 0.0, step = 0.1, group = grpPlan, tooltip = "Push the stop this many ATR past the spike extreme so it isn't sitting on the wick. Try 0.5 to 1.0.")
showEntry = input.bool(false, "Draw entry trigger (signal-bar extreme)", group = grpPlan)
showTgt   = input.bool(false, "Draw target", group = grpPlan)
tgtR      = input.float(2.0, "Target (R multiples of risk)", minval = 0.1, step = 0.5, group = grpPlan, tooltip = "Target as a multiple of entry-to-stop risk, shown so you can eyeball RR. The trap's edge is continuation, so a trailing / trend-flip exit usually beats a fixed target.")
planBars  = input.int(12, "Line length (bars)", minval = 1, group = grpPlan)
planLbl   = input.bool(false, "Label the levels", group = grpPlan)

atr = ta.atr(atrLen)

if stShow
    eSt = high                                         // enter on a break of the signal-bar high
    sSt = low[1] - stopMult * atr                      // spike low, buffered by ATR
    tSt = eSt + tgtR * (eSt - sSt)
    x2s = bar_index + planBars
    if showStop
        line.new(bar_index, sSt, x2s, sSt, xloc = xloc.bar_index, color = color.new(color.red, 0), style = line.style_dashed, width = 1)
        if planLbl
            label.new(x2s, sSt, "stop " + str.tostring(sSt, format.mintick), xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.red, 80), textcolor = color.red, size = size.tiny)
    if showEntry
        line.new(bar_index, eSt, x2s, eSt, xloc = xloc.bar_index, color = color.new(color.gray, 10), style = line.style_dotted, width = 1)
    if showTgt
        line.new(bar_index, tSt, x2s, tSt, xloc = xloc.bar_index, color = color.new(color.green, 0), style = line.style_dashed, width = 1)
        if planLbl
            label.new(x2s, tSt, str.tostring(tgtR, "0.0") + "R " + str.tostring(tSt, format.mintick), xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.green, 80), textcolor = color.green, size = size.tiny)

if btShow
    eBt = low                                          // enter on a break of the signal-bar low
    sBt = high[1] + stopMult * atr                     // spike high, buffered by ATR
    tBt = eBt - tgtR * (sBt - eBt)
    x2b = bar_index + planBars
    if showStop
        line.new(bar_index, sBt, x2b, sBt, xloc = xloc.bar_index, color = color.new(color.red, 0), style = line.style_dashed, width = 1)
        if planLbl
            label.new(x2b, sBt, "stop " + str.tostring(sBt, format.mintick), xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.red, 80), textcolor = color.red, size = size.tiny)
    if showEntry
        line.new(bar_index, eBt, x2b, eBt, xloc = xloc.bar_index, color = color.new(color.gray, 10), style = line.style_dotted, width = 1)
    if showTgt
        line.new(bar_index, tBt, x2b, tBt, xloc = xloc.bar_index, color = color.new(color.green, 0), style = line.style_dashed, width = 1)
        if planLbl
            label.new(x2b, tBt, str.tostring(tgtR, "0.0") + "R " + str.tostring(tBt, format.mintick), xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.green, 80), textcolor = color.green, size = size.tiny)

// --- Trend-flip exit cue (the backtest's best exit) -------------------------
grpExit  = "Exit cue"
showExit = input.bool(true, "Mark trend-flip / stop exit", group = grpExit, tooltip = "Tracks a hypothetical trend-aligned trade and marks where price closes back through the trend MA, or hits the ATR stop. Trend-flip was the strongest exit in testing.")

var bool  inLong   = false
var bool  inShort  = false
var float lStopLvl = na
var float sStopLvl = na

if stAligned and not inLong
    inLong   := true
    inShort  := false
    lStopLvl := low[1] - stopMult * atr
if btAligned and not inShort
    inShort  := true
    inLong   := false
    sStopLvl := high[1] + stopMult * atr

exitLong  = inLong  and (close < ma or low  < lStopLvl)
exitShort = inShort and (close > ma or high > sStopLvl)

if exitLong
    inLong := false
if exitShort
    inShort := false

plotshape(showExit and exitLong,  "Exit long",  location = location.abovebar, style = shape.xcross, color = color.new(color.gray, 0), textcolor = color.gray, text = "exit", size = size.tiny)
plotshape(showExit and exitShort, "Exit short", location = location.belowbar, style = shape.xcross, color = color.new(color.gray, 0), textcolor = color.gray, text = "exit", size = size.tiny)

// --- Alerts -----------------------------------------------------------------
alertcondition(sellersTrapped, title = "Sellers Trapped (any)", message = "Sellers Trapped on {{ticker}} {{interval}}")
alertcondition(buyersTrapped,  title = "Buyers Trapped (any)",  message = "Buyers Trapped on {{ticker}} {{interval}}")
alertcondition(stAligned,      title = "Sellers Trapped - trend-aligned (bullish)", message = "Trend-aligned Sellers Trapped (bullish) on {{ticker}} {{interval}}")
alertcondition(btAligned,      title = "Buyers Trapped - trend-aligned (bearish)",  message = "Trend-aligned Buyers Trapped (bearish) on {{ticker}} {{interval}}")
alertcondition(exitLong,       title = "Trend-flip exit (long)",  message = "Trap long exit (trend flip / stop) on {{ticker}} {{interval}}")
alertcondition(exitShort,      title = "Trend-flip exit (short)", message = "Trap short exit (trend flip / stop) on {{ticker}} {{interval}}")
