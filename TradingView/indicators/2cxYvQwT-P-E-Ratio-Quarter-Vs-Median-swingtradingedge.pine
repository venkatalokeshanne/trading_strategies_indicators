//@version=6
// ===================================================================
//  P/E Ratio Quarter Vs Median
//  Created by swingtradingedge.com
// ===================================================================
indicator("P/E Ratio Quarter Vs Median [swingtradingedge.com]", "P/E vs Median", overlay = false, max_lines_count = 500)

// === P/E Inputs ===
pe_src      = input.string("Auto", title = "P/E Source", options = ["Auto", "EPS TTM", "MarketCap / NetIncome"], group = "P/E Settings")
length      = input.int(250, title = "Lookback Period for Median", minval = 30, group = "P/E Settings")
show_median = input.bool(true, title = "Show Median Line", group = "P/E Settings")
show_stats  = input.bool(true, title = "Show Current P/E Panel", group = "P/E Settings")

// === Quarter-End Line Inputs ===
show_q     = input.bool(true, title = "Show Quarter-End Vertical Lines", group = "Quarter Lines")
q_color    = input.color(color.new(color.gray, 20), title = "Line Color", group = "Quarter Lines")
q_style_in = input.string("Dashed", title = "Line Style", options = ["Solid", "Dashed", "Dotted"], group = "Quarter Lines")
q_width    = input.int(1, title = "Line Width", minval = 1, maxval = 4, group = "Quarter Lines")

// === Shading Inputs ===
show_bg = input.bool(true, title = "Shade When P/E Below Median", group = "Shading")

// === Branding ===
show_credit = input.bool(true, title = "Show Credit Tag", group = "Branding")

// === Current P/E ===
eps_ttm = request.financial(syminfo.tickerid, "EARNINGS_PER_SHARE", "TTM", ignore_invalid_symbol = true)
pe      = not na(eps_ttm) and eps_ttm != 0 ? close / eps_ttm : na
pe_str  = na(pe) ? "" : str.tostring(pe, "#.0")

// === Fallback: Market Cap / Net Income ===
shares_out = request.financial(syminfo.tickerid, "TOTAL_SHARES_OUTSTANDING", "FQ", ignore_invalid_symbol = true)
net_income = request.financial(syminfo.tickerid, "NET_INCOME", "TTM", ignore_invalid_symbol = true)
market_cap = shares_out * close
pe_mcap    = not na(shares_out) and not na(net_income) and net_income != 0 ? market_cap / net_income : na

// === Selected P/E Series ===
pe_auto  = na(pe) ? pe_mcap : pe
pe_ratio = pe_src == "EPS TTM" ? pe : pe_src == "MarketCap / NetIncome" ? pe_mcap : pe_auto

// === Median ===
pe_median = ta.median(pe_ratio, length)
pe_color  = pe_ratio > pe_median ? color.red : color.green

// === Plotting ===
plot(pe_ratio, title = "Price-to-Earnings Ratio", color = pe_color, linewidth = 1, style = plot.style_stepline)
plot(show_median ? pe_median : na, title = "Median P/E", color = color.black, linewidth = 2)

// === Quarter-End Vertical Lines ===
// A new quarter starting on this bar means the previous bar was the quarter's last trading bar.
q_change       = ta.change(time("3M"))
is_new_quarter = not na(q_change) and q_change != 0
q_style        = q_style_in == "Solid" ? line.style_solid : q_style_in == "Dashed" ? line.style_dashed : line.style_dotted

if show_q and is_new_quarter and bar_index > 0
    line.new(bar_index - 1, 0.0, bar_index - 1, 1.0, xloc.bar_index, extend.both, q_color, q_style, q_width)

// === Conditional Shading ===
below_median = not na(pe_ratio) and not na(pe_median) and pe_ratio < pe_median
bgcolor(show_bg and below_median ? color.new(color.green, 80) : na, title = "Below Median")

// === Current P/E Panel ===
cur_str = na(pe_ratio) ? "n/a" : str.tostring(pe_ratio, "#.0")
med_str = na(pe_median) ? "n/a" : str.tostring(pe_median, "#.0")

var table stats_tbl = table.new(position.top_right, 2, 2, border_width = 1)
if barstate.islast and show_stats
    table.cell(stats_tbl, 0, 0, "P/E", text_color = color.gray, text_size = size.small)
    table.cell(stats_tbl, 1, 0, cur_str, text_color = pe_color, text_size = size.small)
    table.cell(stats_tbl, 0, 1, "Median", text_color = color.gray, text_size = size.small)
    table.cell(stats_tbl, 1, 1, med_str, text_color = color.black, text_size = size.small)

// === Credit Tag ===
var table credit_tbl = table.new(position.bottom_right, 1, 1)
if barstate.islast and show_credit
    table.cell(credit_tbl, 0, 0, "Created by swingtradingedge.com", text_color = color.new(color.gray, 25), text_size = size.small)