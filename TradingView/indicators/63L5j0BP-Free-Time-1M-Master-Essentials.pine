matchTf3 = input.timeframe("1", "TF3", group=gL3, inline="mt3")
matchShort_tf3 = input.int(195, "Short MA", group=gL3, inline="mt3")
matchLong_tf3 = input.int(390, "Long MA", group=gL3, inline="mt3")
