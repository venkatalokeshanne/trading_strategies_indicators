//@version=6
indicator("Market Cap in Crores", shorttitle="Mcap (cr)", overlay=true, precision=0)

// 1. Fetch total shares outstanding (from the most recent Fiscal Quarter)
tso = request.financial(syminfo.tickerid, "TOTAL_SHARES_OUTSTANDING", "FQ")

// 2. Calculate raw market cap
marketCap = tso * close

// 3. Convert to Crores (1 Crore = 10,000,000)
mcCrores = marketCap / 10000000

// 4. Plot directly to the status line only (this prevents any lines from drawing on the chart)
plot(mcCrores, title="", display=display.status_line)