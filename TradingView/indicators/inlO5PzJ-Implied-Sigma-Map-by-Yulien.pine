            f_dashboard_row(dashboard, dashboardRow, "Premarket Low", f_number(premarketLow, "0.00"), premarketLevelColor, dashboardSize)
bool rawCrossAbove050 = ta.crossover(close, upper050)
bool rawCrossBelow050 = ta.crossunder(close, lower050)
bool rawCrossAbove100 = ta.crossover(close, upper100)
bool rawCrossBelow100 = ta.crossunder(close, lower100)
bool rawCrossAbove150 = ta.crossover(close, upper150)
bool rawCrossBelow150 = ta.crossunder(close, lower150)
bool rawCrossAbove200 = ta.crossover(close, upper200)
bool rawCrossBelow200 = ta.crossunder(close, lower200)
bool rawReentryBelow100 = ta.crossunder(close, upper100)
bool rawReentryAbove100 = ta.crossover(close, lower100)
bool intradayResetBar = timeframe.isintraday and newDailySession
bool anchorTransitionBar = confirmedAutomaticSessionCloseBar or firstPremarketBar or firstRegularSessionBar
bool alertSessionEligible = mapMode == MAP_CURRENT or preparedMapSessionHasStarted
bool alertConfirmationEligible = alertConfirmationMode == ALERT_CONFIRM_INTRABAR or barstate.isconfirmed
bool alertEventAllowed = displayAtmMap and atmMapValid and alertSessionEligible and alertConfirmationEligible and not intradayResetBar and not anchorTransitionBar
alertcondition(enableCrossAbove050 and alertEventAllowed and rawCrossAbove050, "Price Crossed Above +0.50σ", "Price crossed above +0.50σ")
alertcondition(enableCrossBelow050 and alertEventAllowed and rawCrossBelow050, "Price Crossed Below -0.50σ", "Price crossed below -0.50σ")
alertcondition(enableCrossAbove100 and alertEventAllowed and rawCrossAbove100, "Price Crossed Above +1σ", "Price crossed above +1σ")
alertcondition(enableCrossBelow100 and alertEventAllowed and rawCrossBelow100, "Price Crossed Below -1σ", "Price crossed below -1σ")
alertcondition(enableCrossAbove150 and alertEventAllowed and rawCrossAbove150, "Price Crossed Above +1.50σ", "Price crossed above +1.50σ")
alertcondition(enableCrossBelow150 and alertEventAllowed and rawCrossBelow150, "Price Crossed Below -1.50σ", "Price crossed below -1.50σ")
alertcondition(enableCrossAbove200 and alertEventAllowed and rawCrossAbove200, "Price Crossed Above +2σ", "Price crossed above +2σ")
alertcondition(enableCrossBelow200 and alertEventAllowed and rawCrossBelow200, "Price Crossed Below -2σ", "Price crossed below -2σ")
alertcondition(enableReentryBelow100 and alertEventAllowed and rawReentryBelow100, "Price Re-entered Below +1σ", "Price re-entered below +1σ")
alertcondition(enableReentryAbove100 and alertEventAllowed and rawReentryAbove100, "Price Re-entered Above -1σ", "Price re-entered above -1σ")
