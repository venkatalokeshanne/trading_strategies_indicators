//@version=5
strategy("Pro Structure Momentum Bot A+", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// EMAs
ema9 = ta.ema(close, 9)
ema21 = ta.ema(close, 21)

plot(ema9, color=color.yellow)
plot(ema21, color=color.red)

// Trend
bullTrend = ema9 > ema21
bearTrend = ema9 < ema21

// Structure
lookback = 10
swingHigh = ta.highest(high, lookback)
swingLow = ta.lowest(low, lookback)

// Break detection
breakUp = close > swingHigh[1]
breakDown = close < swingLow[1]

// Store breakout level
var float longLevel = na
var float shortLevel = na

if (breakUp)
    longLevel := swingHigh[1]

if (breakDown)
    shortLevel := swingLow[1]

// Pullback conditions
pullbackLong = not na(longLevel) and low <= longLevel and close > longLevel
pullbackShort = not na(shortLevel) and high >= shortLevel and close < shortLevel

// Confirmation candles
bullConfirm = close > open and close > close[1]
bearConfirm = close < open and close < close[1]

// Final signals
buySignal = bullTrend and pullbackLong and bullConfirm
sellSignal = bearTrend and pullbackShort and bearConfirm

// Entries
if (buySignal)
    strategy.entry("BUY", strategy.long)
    longLevel := na  // reset after entry

if (sellSignal)
    strategy.entry("SELL", strategy.short)
    shortLevel := na // reset after entry

// Dynamic Stop Loss (structure-based)
longSL = ta.lowest(low, 3)
shortSL = ta.highest(high, 3)

// Risk/Reward (2R target)
longRisk = close - longSL
shortRisk = shortSL - close

longTP = close + (longRisk * 2)
shortTP = close - (shortRisk * 2)

// Exits
strategy.exit("TP/SL BUY", from_entry="BUY", stop=longSL, limit=longTP)
strategy.exit("TP/SL SELL", from_entry="SELL", stop=shortSL, limit=shortTP)