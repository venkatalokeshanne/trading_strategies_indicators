//@version=6
strategy('maXXit EMA[V6 5.3 PD]', overlay = true, initial_capital = 10000, 
                                default_qty_type = strategy.fixed, default_qty_value = 1, 
                                commission_type = strategy.commission.cash_per_contract, 
                                commission_value = 1.0, 
                                pyramiding=999,
                                slippage = 4, 
