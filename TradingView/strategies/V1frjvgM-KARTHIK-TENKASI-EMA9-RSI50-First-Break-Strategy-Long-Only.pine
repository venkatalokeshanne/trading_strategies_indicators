//@version=6
strategy("EMA9 + RSI50 First Break Strategy (Long Only)", overlay=true,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100)

// ===== INPUTS =====
emaLen = input.int(9, "EMA Length")
rsiLen = input.int(14, "RSI Length")

// ===== CALCULATIONS =====
ema9 = ta.ema(close, emaLen)
rsi  = ta.rsi(close, rsiLen)

// ===== CONDITIONS =====
// Core condition
cond = close > ema9 and rsi > 50

// FIRST candle where condition becomes true
firstSignal = cond and not cond[1]

// Exit condition
exitCondition = close < ema9

// ===== EXECUTION =====
if firstSignal
    strategy.entry("Long", strategy.long)

if exitCondition
    strategy.close("Long")

// ===== VISUALS =====
plot(ema9, color=color.orange, linewidth=2, title="EMA 9")

// Highlight ONLY the first qualifying candle
barcolor(firstSignal ? color.yellow : na)

// Entry / Exit markers
plotshape(firstSignal, title="BUY", location=location.belowbar,
     color=color.green, style=shape.labelup, text="BUY")

plotshape(exitCondition, title="EXIT", location=location.abovebar,
     color=color.red, style=shape.labeldown, text="EXIT")