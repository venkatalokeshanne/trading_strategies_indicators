//@version=5
strategy("Night Breakout 21:30 WIB v12", overlay=true, initial_capital=10000)

// --- Parameter Input ---
target_risk_usd = input.float(100.0, title="Target Risiko Terdekat (USD)")
lot_step = input.float(0.01, title="Step Lot Broker (Contoh: 0.01)", step=0.01)

max_sl_pips = input.int(500, title="Maksimal SL (Pips)")
pip_value = input.float(0.1, title="Nilai 1 Pip (XAUUSD = 0.1)")
lookback_sr = input.int(20, title="Jumlah Candle Cek Support/Resistance")

// PENGALI LOT (Agar P&L TradingView sama dengan P&L MT4)
// Jika di MT4 1 lot = 100 Ounce, biarkan angka ini 100.
tv_multiplier = input.float(100.0, title="Pengali Unit Broker (Forex = 100)")

// --- Indikator ---
ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)

// --- Waktu Eksekusi ---
is_entry_time = hour(time, "Asia/Jakarta") == 21 and minute(time, "Asia/Jakarta") == 15

// --- Aturan 1 & 2: Filter Tren dan Posisi Candle ---
uptrend_valid = (ema50 > ema200) and (close > ema50)
bullish_candles = (close > open) and (close[1] > open[1])
no_touch_ema200_buy = (low > ema200) and (low[1] > ema200[1])
long_cond = is_entry_time and uptrend_valid and bullish_candles and no_touch_ema200_buy

downtrend_valid = (ema50 < ema200) and (close < ema50)
bearish_candles = (close < open) and (close[1] < open[1])
no_touch_ema200_sell = (high < ema200) and (high[1] < ema200[1])
short_cond = is_entry_time and downtrend_valid and bearish_candles and no_touch_ema200_sell

// --- Aturan 3: Perhitungan SL dan TP (RR 1:1) ---
recent_low = ta.lowest(low, lookback_sr)
recent_high = ta.highest(high, lookback_sr)

max_sl_dist = max_sl_pips * pip_value

var float sl_price = na
var float tp_price = na

// Eksekusi Buy
if long_cond and strategy.position_size == 0
    jarak_sl = close - recent_low
    sl_price := jarak_sl > max_sl_dist ? close - max_sl_dist : recent_low
    tp_price := close + (close - sl_price) // RR 1:1
    
    sl_distance_point = close - sl_price
    sl_distance_pips = sl_distance_point / pip_value
    loss_per_01_lot = sl_distance_pips * 0.1
    
    if loss_per_01_lot > 0
        multiplier = target_risk_usd / loss_per_01_lot
        pos_qty = math.ceil(multiplier - 0.00001) * lot_step 
        
        // Eksekusi dikali 100 agar P&L TradingView cocok dengan USD MT4
        strategy.entry("Buy", strategy.long, qty=pos_qty * tv_multiplier)
        strategy.exit("Exit Buy", "Buy", stop=sl_price, limit=tp_price)

// Eksekusi Sell
if short_cond and strategy.position_size == 0
    jarak_sl = recent_high - close
    sl_price := jarak_sl > max_sl_dist ? close + max_sl_dist : recent_high
    tp_price := close - (sl_price - close) // RR 1:1
    
    sl_distance_point = sl_price - close
    sl_distance_pips = sl_distance_point / pip_value
    loss_per_01_lot = sl_distance_pips * 0.1
    
    if loss_per_01_lot > 0
        multiplier = target_risk_usd / loss_per_01_lot
        pos_qty = math.ceil(multiplier - 0.00001) * lot_step 
        
        // Eksekusi dikali 100 agar P&L TradingView cocok dengan USD MT4
        strategy.entry("Sell", strategy.short, qty=pos_qty * tv_multiplier)
        strategy.exit("Exit Sell", "Sell", stop=sl_price, limit=tp_price)

// --- Aturan 4: Batas Waktu 5 Hari ---
if strategy.position_size != 0
    trade_open_time = strategy.opentrades.entry_time(0)
    waktu_berjalan = time - trade_open_time
    if waktu_berjalan >= 432000000
        strategy.close_all(comment="Batal (Lewat 5 Hari)")

// --- Visualisasi Chart ---
plot(ema50, color=color.blue, title="EMA 50", linewidth=2)
plot(ema200, color=color.red, title="EMA 200", linewidth=2)