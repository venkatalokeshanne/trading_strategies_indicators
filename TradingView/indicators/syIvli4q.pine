//@version=6
// =============================================================================
// MHIDa Crest 6-Flag Library — a support for evaluating what you
// observe, not a signal nor advice, not a winning tool on its own.
// You always decide.
// =============================================================================
//
// WHAT IT DOES (and nothing more):
//   Computes 6 observable flags (A..F) that describe a possible "crest"
//   (an exhausted top after a run). It shows which flags are on, how many are
//   on, and applies the honest rule:
//
//        crest = D  OR  (at least 4 flags out of 6 on)
//
//   It is a READING LIBRARY: it lets you see the state of the 6 flags on the
//   chart, nothing more. It does not tell you to buy, sell or short.
//
// HONESTY ABOUT THE ERROR RATE (this is the point):
//   Crest-style detectors are wrong a meaningful share of the time. A "crest"
//   can be FAKE: the price keeps going up (a squeeze) and a top that looked
//   exhausted simply continues. This is NOT a footnote: it is exactly why this
//   tool is a SUPPORT for evaluation and NOT a signal. The panel states it
//   openly so you don't fool yourself.
//   This tool does not invent any precision number: it only gives you the 6 raw
//   flags. Whether those flags mean anything on your instrument is something you
//   must judge on your own data and your own timeframe.
//
// CONTEXT:
//   The 6 flags are a neutral reading aid on any instrument/timeframe: they read
//   "possible top after a run". They are not tuned to any one market, and they
//   are not a complete strategy. You decide.
//
// CAVEAT:
//   - The 6 flags are wrong a meaningful share of the time (fakes / squeezes).
//   - The inputs/defaults below are a STARTING POINT, not "the" right config.
//   - No promises, no financial advice. You always decide.
// =============================================================================

indicator("MHIDa Crest 6-Flag Library", shorttitle="Crest6Flag", overlay=true)

// -----------------------------------------------------------------------------
// INPUT — flag thresholds (defaults = a starting point, tune them yourself)
// -----------------------------------------------------------------------------
grpA = "Flags A..F — thresholds (starting point, tune them)"
rsiLen      = input.int(14,    "RSI period",                        minval=2, group=grpA)
emaStretch  = input.int(20,    "EMA for the 'stretch' (extension)", minval=2, group=grpA)
// A: RSI overheated recently
thrRsiHot   = input.float(70.0, "A) recent max RSI above",          minval=1, group=grpA)
// B: RSI turns down and is below this threshold
thrRsiB     = input.float(65.0, "B) RSI below (and falling)",       minval=1, group=grpA)
// D: price too far above the EMA (stretch)
thrStretch  = input.float(0.08, "D) stretch above EMA (e.g. 0.08=8%)", minval=0.0, step=0.01, group=grpA)
// E: strong bearish candle
thrDropE    = input.float(-0.02, "E) close/close[1] drop below",    step=0.01, group=grpA)

grpV = "Reading"
showFlags   = input.bool(true,  "Show flag panel",  group=grpV)
showCrest   = input.bool(true,  "Mark crests on chart", group=grpV)

// -----------------------------------------------------------------------------
// BASE INDICATORS (causal)
// -----------------------------------------------------------------------------
r    = ta.rsi(close, rsiLen)
e20  = ta.ema(close, emaStretch)

// -----------------------------------------------------------------------------
// THE 6 FLAGS A..F
// -----------------------------------------------------------------------------
// A = max(RSI[i-10..i-2]) > 70   -> RSI overheated recently
maxRsiA = ta.highest(r, 10)            // max RSI in the last ~10 bars
A = maxRsiA > thrRsiHot

// B = RSI[i] < RSI[i-1]  and  RSI[i] < 65   -> RSI turns down and is "fresh"
B = (r < r[1]) and (r < thrRsiB)

// C = close[i] < min(low[i-6..i-1])   -> breaks below recent lows
minLowC = ta.lowest(low[1], 6)         // min of the lows of the previous 6 bars
C = close < minLowC

// D = max(close[i-5..i-1]) / EMA20[i] - 1 > 0.08  -> too extended above the EMA
maxClose5 = ta.highest(close[1], 5)    // max of the closes of the previous 5 bars
stretch   = na(e20) or e20 == 0 ? na : (maxClose5 / e20 - 1.0)
D = not na(stretch) and stretch > thrStretch

// E = close[i] < open[i]  and  (close[i]/close[i-1] - 1) < -0.02  -> strong down candle
E = (close < open) and ((close / close[1] - 1.0) < thrDropE)

// F = close[i-1] > max(close[i-8..i-2])  and  RSI[i-1] < max(RSI[i-8..i-2])
//     -> new price high but weaker RSI (bearish divergence)
maxClose8 = ta.highest(close[2], 7)    // max of the closes from i-8 to i-2 (7 bars)
maxRsi8   = ta.highest(r[2], 7)        // max RSI from i-8 to i-2
F = (close[1] > maxClose8) and (r[1] < maxRsi8)

// -----------------------------------------------------------------------------
// HONEST RULE: crest = D  OR  (at least 4 flags out of 6)
// -----------------------------------------------------------------------------
nFlags = (A ? 1 : 0) + (B ? 1 : 0) + (C ? 1 : 0) + (D ? 1 : 0) + (E ? 1 : 0) + (F ? 1 : 0)
isCrest = D or (nFlags >= 4)

// -----------------------------------------------------------------------------
// DRAWING — crest marker (read-only, no orders)
// -----------------------------------------------------------------------------
plotshape(showCrest and isCrest and chart.is_standard, title="Crest (D or >=4/6)", style=shape.triangledown,
     location=location.abovebar, color=color.new(color.orange, 0), size=size.tiny,
     text="crest")

// -----------------------------------------------------------------------------
// FLAG PANEL — shows A..F, the count, and the honest reminder
// -----------------------------------------------------------------------------
var table pan = table.new(position.top_right, 2, 11, border_width=1)

f_cell(_row, _label, _on) =>
    table.cell(pan, 0, _row, _label, text_color=color.white,
         bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(pan, 1, _row, _on ? "ON" : "off",
         text_color=_on ? color.white : color.new(color.gray, 30),
         bgcolor=_on ? color.new(color.teal, 20) : color.new(color.gray, 80),
         text_size=size.small)

if showFlags and barstate.islast
    table.cell(pan, 0, 0, "MHIDa Crest 6-Flag", text_color=color.white,
         bgcolor=color.new(color.blue, 30), text_size=size.small)
    table.cell(pan, 1, 0, "support", text_color=color.white,
         bgcolor=color.new(color.blue, 30), text_size=size.small)
    f_cell(1, "A) RSI overheated",     A)
    f_cell(2, "B) RSI turns down",     B)
    f_cell(3, "C) breaks lows",        C)
    f_cell(4, "D) too extended",       D)
    f_cell(5, "E) strong down candle", E)
    f_cell(6, "F) RSI divergence",     F)
    table.cell(pan, 0, 7, "flags on", text_color=color.white,
         bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(pan, 1, 7, str.tostring(nFlags) + "/6",
         text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(pan, 0, 8, "CREST (D or >=4/6)", text_color=color.white,
         bgcolor=color.new(color.gray, 40), text_size=size.small)
    table.cell(pan, 1, 8, isCrest ? "YES" : "no",
         text_color=color.white,
         bgcolor=isCrest ? color.new(color.orange, 10) : color.new(color.gray, 70),
         text_size=size.small)
    // HONESTY: crests can be fake
    table.cell(pan, 0, 9, "crests can be", text_color=color.white,
         bgcolor=color.new(color.maroon, 20), text_size=size.tiny)
    table.cell(pan, 1, 9, "FAKE (squeeze)", text_color=color.white,
         bgcolor=color.new(color.maroon, 20), text_size=size.tiny)
    table.cell(pan, 0, 10, "not a signal", text_color=color.new(color.gray, 10),
         bgcolor=color.new(color.gray, 85), text_size=size.tiny)
    table.cell(pan, 1, 10, "you decide", text_color=color.new(color.gray, 10),
         bgcolor=color.new(color.gray, 85), text_size=size.tiny)

// -----------------------------------------------------------------------------
// HONEST REMINDER (always at the tail of the source):
//   Crests can be fake (squeezes): the price keeps going up.
//   The 6 flags are a SUPPORT for reading the chart, NOT a signal,
//   NOT advice, NOT a winning tool on their own. You always decide.
// =============================================================================
