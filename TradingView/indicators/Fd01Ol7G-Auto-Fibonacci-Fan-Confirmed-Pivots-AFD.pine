        array.set(fanCutoffTimes, array.size(fanCutoffTimes) - 1, selectedEventInvalidatedAtTime)
    queueHasCurrent := false
    lastInvalidationEventTime := selectedEventInvalidatedAtTime

if barstate.isconfirmed
    confirmedChartBarCount += 1
    bool resetInteractions = qualificationEventChanged or invalidationEventChanged or not sourceSelectionValid or not queueHasCurrent or array.size(fanOriginPrices) == 0
    if resetInteractions
        for levelIndex = 0 to LEVEL_COUNT - 1
            array.set(levelStableSides, levelIndex, SIDE_TESTING)
            array.set(levelBreakSides, levelIndex, SIDE_TESTING)
            array.set(levelInteractionEvents, levelIndex, EVENT_NONE)
            array.set(levelInteractionBars, levelIndex, na)
    else
