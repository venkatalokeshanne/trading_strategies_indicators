f_replayFeature(int feature, int side) =>
    float value = switch feature
        0 => side * rthReturnR
        1 => side * orPositionR
        2 => side * vwapDistanceR
        3 => side * fiveBodyR
        4 => side * vwapSlopeR
        5 => side * mom2R
        6 => side * mom3R
        7 => side * mom5R
        8 => side * mom10R
        9 => side * mom15R
        10 => side * eff5
        11 => side * eff10
        12 => side * eff20
        13 => side * bodySigned
        14 => minuteFromOpen
        15 => atr
        16 => barRangeAtr
        17 => volumeRatio20
        18 => orRangeAtr
        19 => rthRangeAtr
        20 => rthPosition
        21 => side == 1 ? closePosition : 1.0 - closePosition
        22 => side == 1 ? (close - orHigh) / math.max(stopPoints, tickSize) : (orLow - close) / math.max(stopPoints, tickSize)
        23 => side == 1 ? (bullShiftNow ? 1.0 : 0.0) : (bearShiftNow ? 1.0 : 0.0)
        24 => side == 1 ? (bullFlowNow ? 1.0 : 0.0) : (bearFlowNow ? 1.0 : 0.0)
        25 => side == 1 ? (bullFvgNow ? 1.0 : 0.0) : (bearFvgNow ? 1.0 : 0.0)
        26 => side == 1 ? (recentDataLowRaid ? 1.0 : 0.0) : (recentDataHighRaid ? 1.0 : 0.0)
        27 => side == 1 ? (recentDataHighRaid ? 1.0 : 0.0) : (recentDataLowRaid ? 1.0 : 0.0)
        => 0.0
    value

f_replayProbability(int side) =>
    int node = 0
    int feature = array.get(replayTreeFeature, node)
    int guard = 0
    while feature >= 0 and guard <= 16
        value = f_replayFeature(feature, side)
        threshold = array.get(replayTreeThreshold, node)
        node := value <= threshold ? array.get(replayTreeLeft, node) : array.get(replayTreeRight, node)
        feature := array.get(replayTreeFeature, node)
        guard += 1
    array.get(replayTreeProbability, node)


// DAILY ONLINE SELECTION

dataReady = chartReady and orReady and not na(mapHigh) and not na(mapLow) and not na(rthVwap) and not na(atr) and not na(volumeMedian20)
longProbability = dataReady ? f_replayProbability(1) : na
shortProbability = dataReady ? f_replayProbability(-1) : na
bestIsLong = nz(longProbability, 0.0) >= nz(shortProbability, 0.0)
bestProbability = bestIsLong ? longProbability : shortProbability
qualifiedNow = not na(bestProbability) and bestProbability >= probabilityThreshold

bool buySignal = false
bool sellSignal = false
string chosenModel = ""
string chosenGrade = ""
string chosenSource = ""
var bool signalTakenToday = false
var int eligibleSessions = 0
var int sessionsWithSignal = 0
var int qualifiedSignals = 0
var int deadlineSignals = 0
var string lastDirection = "NONE"
var string lastModel = "NONE"
var float lastProbability = na

if newRth
    signalTakenToday := false
    eligibleSessions += 1

canSignal = inEntry and barEligible and dataReady and not signalTakenToday
if canSignal and (qualifiedNow or deadlineBar)
    buySignal := bestIsLong
    sellSignal := not bestIsLong
    chosenGrade := qualifiedNow ? "A+" : "B+"
    chosenModel := qualifiedNow ? "REPLAY-CALIBRATED ICT SEQUENCE" : "REQUIRED DAILY COVERAGE"
    chosenSource := qualifiedNow ? "TREE LEAF " + str.tostring(bestProbability * 100.0, "#.0") + "%" : "10:45 STRONGER SIDE " + str.tostring(bestProbability * 100.0, "#.0") + "%"


// DAILY LOCK, LEVELS, VISUALS, AND ALERTS

var line latestEntryLine = na
var line latestStopLine = na
var line latestTargetLine = na
var float latestEntry = na
var float latestStop = na
var float latestTarget = na

if buySignal or sellSignal
    signalTakenToday := true
    sessionsWithSignal += 1
    qualifiedSignals += qualifiedNow ? 1 : 0
    deadlineSignals += qualifiedNow ? 0 : 1
    lastDirection := buySignal ? "BUY" : "SELL"
    lastModel := chosenModel
    lastProbability := bestProbability
    latestEntry := f_round(close)
    latestStop := buySignal ? f_round(latestEntry - stopPoints) : f_round(latestEntry + stopPoints)
    latestTarget := buySignal ? f_round(latestEntry + targetPoints) : f_round(latestEntry - targetPoints)

    if onlyLatestLines
        f_deleteLine(latestEntryLine)
        f_deleteLine(latestStopLine)
        f_deleteLine(latestTargetLine)

    latestEntryLine := line.new(bar_index, latestEntry, bar_index + lineBars, latestEntry, color = color.rgb(10, 10, 10), width = 2)
    latestStopLine := line.new(bar_index, latestStop, bar_index + lineBars, latestStop, color = color.rgb(220, 25, 40), width = 2)
    latestTargetLine := line.new(bar_index, latestTarget, bar_index + lineBars, latestTarget, color = color.rgb(0, 155, 75), width = 2)

    directionText = buySignal ? "BUY" : "SELL"
    detailText = showSignalDetails ? "\n" + chosenGrade + "  " + chosenModel + "\n" + chosenSource + "\nCONFIRMED CLOSE -> FIXED 1.5R" : ""
    priceText = "\nEntry " + f_price(latestEntry) + "\nSL " + f_price(latestStop) + "\nTP " + f_price(latestTarget)
    labelPrice = buySignal ? low - atr * labelOffsetATR : high + atr * labelOffsetATR
    label.new(bar_index, labelPrice, directionText + detailText + priceText,
         style = buySignal ? label.style_label_up : label.style_label_down,
         color = buySignal ? color.rgb(0, 160, 80) : color.rgb(220, 35, 45),
         textcolor = color.white, size = size.normal)

    alert("AquaBlu 7.0 " + directionText + " | " + chosenGrade + " " + chosenModel + " | " + chosenSource + " | Entry " + f_price(latestEntry) + " | SL " + f_price(latestStop) + " | TP " + f_price(latestTarget) + " | " + str.tostring(mnqQty) + " MNQ", alert.freq_once_per_bar_close)

alertcondition(buySignal, "AquaBlu 7.0 BUY", "AquaBlu 7.0 BUY on {{ticker}}")
alertcondition(sellSignal, "AquaBlu 7.0 SELL", "AquaBlu 7.0 SELL on {{ticker}}")


// CONSERVATIVE OUTCOME TRACKER

var bool trackerOpen = false
var bool trackerLong = false
var float trackerStop = na
var float trackerTarget = na
var int trackerEntryBar = na
var int trackerEntryTime = na
var bool trackerQualified = false
var int wins = 0
var int losses = 0
var int unresolved = 0
var int quickWins = 0
var int qualifiedWins = 0
var int qualifiedLosses = 0
var int deadlineWins = 0
var int deadlineLosses = 0
var string lastOutcome = "NONE"

if (newRth or (not inRth and inRth[1])) and trackerOpen
    unresolved += 1
    lastOutcome := "UNRESOLVED"
    trackerOpen := false

if trackOutcomes and trackerOpen and bar_index > trackerEntryBar
    stopHit = trackerLong ? low <= trackerStop : high >= trackerStop
    targetHit = trackerLong ? high >= trackerTarget : low <= trackerTarget
    if stopHit
        losses += 1
        qualifiedLosses += trackerQualified ? 1 : 0
        deadlineLosses += trackerQualified ? 0 : 1
        lastOutcome := targetHit ? "LOSS (BOTH TOUCHED)" : "LOSS"
        trackerOpen := false
    else if targetHit
        wins += 1
        qualifiedWins += trackerQualified ? 1 : 0
        deadlineWins += trackerQualified ? 0 : 1
        elapsedMinutes = int((time - trackerEntryTime) / 60000)
        if elapsedMinutes <= quickWinnerMinutes
            quickWins += 1
            lastOutcome := "QUICK WIN " + str.tostring(elapsedMinutes) + "m"
        else
            lastOutcome := "WIN " + str.tostring(elapsedMinutes) + "m"
        trackerOpen := false

if trackOutcomes and (buySignal or sellSignal)
    trackerOpen := true
    trackerLong := buySignal
    trackerStop := latestStop
    trackerTarget := latestTarget
    trackerEntryBar := bar_index
    trackerEntryTime := time
    trackerQualified := qualifiedNow


// DASHBOARD

var table dash = table.new(position.top_right, 2, 16, bgcolor = color.rgb(10, 10, 10), border_width = 1)

if barstate.islast and showDashboard
    resolved = wins + losses
    winRate = resolved > 0 ? 100.0 * wins / resolved : na
    chartText = not isOneMinute ? "USE 1-MINUTE" : enforceNQChart and not isNQ ? "USE NQ1!" : enforceStandardChart and not isStandardChart ? "USE STANDARD CANDLES" : na(mapHigh) ? "ENABLE EXTENDED HOURS" : "NQ 1-MIN READY"
    stateText = signalTakenToday ? "DAILY LOCKED 1/1" : inEntry ? qualifiedNow ? "QUALIFIED NOW" : "SCANNING BOTH SIDES" : "WAITING FOR WINDOW"
    probabilityText = na(longProbability) ? "--" : str.tostring(longProbability * 100.0, "#.0") + "% / " + str.tostring(shortProbability * 100.0, "#.0") + "%"

    table.cell(dash, 0, 0, "AQUABLU", text_color = color.white, bgcolor = color.rgb(0, 75, 135))
    table.cell(dash, 1, 0, "7.0 REPLAY CALIBRATED", text_color = color.white, bgcolor = color.rgb(0, 75, 135))
    table.cell(dash, 0, 1, "Chart", text_color = color.white)
    table.cell(dash, 1, 1, chartText, text_color = dataReady ? color.lime : color.red)
    table.cell(dash, 0, 2, "State", text_color = color.white)
    table.cell(dash, 1, 2, stateText, text_color = signalTakenToday ? color.lime : color.yellow)
    table.cell(dash, 0, 3, "Replay probability L / S", text_color = color.white)
    table.cell(dash, 1, 3, probabilityText, text_color = nz(longProbability) >= nz(shortProbability) ? color.lime : color.red)
    table.cell(dash, 0, 4, "Last signal", text_color = color.white)
    table.cell(dash, 1, 4, lastDirection + " / " + lastModel, text_color = lastDirection == "BUY" ? color.lime : lastDirection == "SELL" ? color.red : color.silver)
    table.cell(dash, 0, 5, "Last probability", text_color = color.white)
    table.cell(dash, 1, 5, na(lastProbability) ? "--" : str.tostring(lastProbability * 100.0, "#.0") + "%", text_color = color.aqua)
    table.cell(dash, 0, 6, "Coverage", text_color = color.white)
    table.cell(dash, 1, 6, str.tostring(sessionsWithSignal) + "/" + str.tostring(eligibleSessions) + " sessions", text_color = sessionsWithSignal == eligibleSessions ? color.lime : color.orange)
    table.cell(dash, 0, 7, "Wins / losses / unresolved", text_color = color.white)
    table.cell(dash, 1, 7, str.tostring(wins) + " / " + str.tostring(losses) + " / " + str.tostring(unresolved), text_color = losses == 0 ? color.lime : color.orange)
    table.cell(dash, 0, 8, "Resolved win rate", text_color = color.white)
    table.cell(dash, 1, 8, na(winRate) ? "--" : str.tostring(winRate, "#.#") + "%", text_color = losses == 0 ? color.lime : color.white)
    table.cell(dash, 0, 9, "Quick winners", text_color = color.white)
    table.cell(dash, 1, 9, str.tostring(quickWins), text_color = color.white)
    table.cell(dash, 0, 10, "Qualified / deadline", text_color = color.white)
    table.cell(dash, 1, 10, str.tostring(qualifiedSignals) + " / " + str.tostring(deadlineSignals), text_color = color.white)
    table.cell(dash, 0, 11, "Qualified W / L", text_color = color.white)
    table.cell(dash, 1, 11, str.tostring(qualifiedWins) + " / " + str.tostring(qualifiedLosses), text_color = qualifiedLosses == 0 ? color.lime : color.orange)
    table.cell(dash, 0, 12, "Deadline W / L", text_color = color.white)
    table.cell(dash, 1, 12, str.tostring(deadlineWins) + " / " + str.tostring(deadlineLosses), text_color = deadlineLosses == 0 ? color.lime : color.orange)
    table.cell(dash, 0, 13, "Last outcome", text_color = color.white)
    table.cell(dash, 1, 13, lastOutcome, text_color = str.contains(lastOutcome, "WIN") ? color.lime : str.contains(lastOutcome, "LOSS") ? color.red : color.silver)
    table.cell(dash, 0, 14, "Risk geometry", text_color = color.white)
    table.cell(dash, 1, 14, f_price(stopPoints) + " / " + f_price(targetPoints) + " pts", text_color = color.white)
    table.cell(dash, 0, 15, "Calibration", text_color = color.white)
    table.cell(dash, 1, 15, "IN-SAMPLE CME REPLAY", text_color = color.aqua)


// OPTIONAL DIAGNOSTICS AND EXPORT FIELDS

plot(not cleanCanvas and inRth ? orHigh : na, "Opening Range High", color = color.new(color.red, 20), style = plot.style_linebr)
plot(not cleanCanvas and inRth ? orLow : na, "Opening Range Low", color = color.new(color.green, 20), style = plot.style_linebr)
plot(not cleanCanvas and inRth ? rthVwap : na, "RTH VWAP", color = color.new(color.blue, 25), style = plot.style_linebr)
plot(not cleanCanvas and inRth ? mapHigh : na, "Pre-open High", color = color.new(color.orange, 35), style = plot.style_linebr)
plot(not cleanCanvas and inRth ? mapLow : na, "Pre-open Low", color = color.new(color.orange, 35), style = plot.style_linebr)

plot(buySignal ? 1.0 : sellSignal ? -1.0 : na, "AquaBlu Signal Direction", display = display.data_window)
plot(buySignal or sellSignal ? latestEntry : na, "AquaBlu Entry", display = display.data_window)
plot(buySignal or sellSignal ? latestStop : na, "AquaBlu Stop", display = display.data_window)
plot(buySignal or sellSignal ? latestTarget : na, "AquaBlu Target", display = display.data_window)
plot(longProbability, "AquaBlu Long Probability", display = display.data_window)
plot(shortProbability, "AquaBlu Short Probability", display = display.data_window)
