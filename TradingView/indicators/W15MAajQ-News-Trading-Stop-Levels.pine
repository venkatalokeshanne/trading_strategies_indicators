//@version=6
indicator("News Event Price Bands", shorttitle="News Bands", overlay=true, max_lines_count=2, max_labels_count=3)

// Presets
string coreCpiPreset = "Core CPI (High Probability)"
string nfpPreset     = "NFP (Medium Probability)"

string selectedPreset = input.string(
     coreCpiPreset,
     "Event preset",
     options=[coreCpiPreset, nfpPreset],
     group="Event")

// Appearance
color upperColor = input.color(color.rgb(76, 175, 80), "Upper line", inline="colors", group="Appearance")
color lowerColor = input.color(color.rgb(244, 67, 54), "Lower line", inline="colors", group="Appearance")
int lineWidth     = input.int(1, "Line width", minval=1, maxval=4, group="Appearance")
int labelOffset   = input.int(3, "Label offset (bars)", minval=0, maxval=100, group="Appearance")

// The selected number is the distance from current price on EACH side.
float spreadPoints = selectedPreset == coreCpiPreset ? 40.0 : 30.0
float upperPrice   = close + spreadPoints
float lowerPrice   = close - spreadPoints
string pointText   = str.tostring(spreadPoints, "#") + " pts"

var line upperLine = na
var line lowerLine = na
var label eventLabel = na
var label upperLabel = na
var label lowerLabel = na

if barstate.islast
    // Create the objects once, then move them as the live price changes.
    if na(upperLine)
        upperLine := line.new(bar_index, upperPrice, bar_index + 1, upperPrice,
             xloc=xloc.bar_index, extend=extend.right, color=upperColor,
             style=line.style_dashed, width=lineWidth)
        lowerLine := line.new(bar_index, lowerPrice, bar_index + 1, lowerPrice,
             xloc=xloc.bar_index, extend=extend.right, color=lowerColor,
             style=line.style_dashed, width=lineWidth)

        eventLabel := label.new(bar_index + labelOffset, close,
             selectedPreset + ": " + pointText,
             xloc=xloc.bar_index, style=label.style_label_left,
             color=upperColor, textcolor=color.white, size=size.small)
        upperLabel := label.new(bar_index + labelOffset, upperPrice,
             "Buy stops here",
             xloc=xloc.bar_index, style=label.style_none,
             textcolor=upperColor, size=size.small)
        lowerLabel := label.new(bar_index + labelOffset, lowerPrice,
             "Sell stops here",
             xloc=xloc.bar_index, style=label.style_none,
             textcolor=lowerColor, size=size.small)

    // Track the current price on every real-time update.
    line.set_xy1(upperLine, bar_index, upperPrice)
    line.set_xy2(upperLine, bar_index + 1, upperPrice)
    line.set_color(upperLine, upperColor)
    line.set_width(upperLine, lineWidth)

    line.set_xy1(lowerLine, bar_index, lowerPrice)
    line.set_xy2(lowerLine, bar_index + 1, lowerPrice)
    line.set_color(lowerLine, lowerColor)
    line.set_width(lowerLine, lineWidth)

    label.set_xy(eventLabel, bar_index + labelOffset, close)
    label.set_text(eventLabel, selectedPreset + ": " + pointText)
    label.set_color(eventLabel, upperColor)

    label.set_xy(upperLabel, bar_index + labelOffset, upperPrice)
    label.set_text(upperLabel, "Buy stops here")
    label.set_textcolor(upperLabel, upperColor)

    label.set_xy(lowerLabel, bar_index + labelOffset, lowerPrice)
    label.set_text(lowerLabel, "Sell stops here")
    label.set_textcolor(lowerLabel, lowerColor)
