supportWInitial = f_process_box_reaction(16, visibleWeeklySR, sWTime, sWTop, sWBottom, true, supportWReactionRaw)
resistanceWInitial = f_process_box_reaction(17, visibleWeeklySR, rWTime, rWTop, rWBottom, false, resistanceWReactionRaw)



// ───── Session Volume Profile engine
// Uses lower-timeframe intrabars. On 1M/5M/15M execution charts the profile uses 1M samples;
// 30M/1H charts use 5M samples; higher charts use 15M samples. Each intrabar's volume is
// assigned to its HLC3 row. This is a stable volume-by-price approximation
// designed for VAH / POC / VAL context inside Pine, not a clone of TradingView's
// proprietary tick-level Volume Profile implementation.

float vpChartSeconds = timeframe.in_seconds()
string vpLowerTimeframe = vpChartSeconds < 60 ? timeframe.period :
     vpChartSeconds <= timeframe.in_seconds("15") ? "1" :
     vpChartSeconds <= timeframe.in_seconds("60") ? "5" : "15"

array<float> vpPriceData = request.security_lower_tf(syminfo.tickerid, vpLowerTimeframe, hlc3)
array<float> vpVolumeData = request.security_lower_tf(syminfo.tickerid, vpLowerTimeframe, volume)
array<int> vpTimeData = request.security_lower_tf(syminfo.tickerid, vpLowerTimeframe, time)
array<bool> vpOvernightData = request.security_lower_tf(syminfo.tickerid, vpLowerTimeframe,
     not na(time(timeframe.period, overnightSession, sessionTimeZone)))
array<bool> vpNYData = request.security_lower_tf(syminfo.tickerid, vpLowerTimeframe,
     not na(time(timeframe.period, newYorkSession, sessionTimeZone)))

var array<float> overnightProfilePrices = array.new_float()
var array<float> overnightProfileVolumes = array.new_float()
var array<float> nyProfilePrices = array.new_float()
var array<float> nyProfileVolumes = array.new_float()
var array<float> overnightProfileBins = array.new_float()
var array<float> nyProfileBins = array.new_float()

var bool previousVPOvernightFlag = false
var bool previousVPNYFlag = false
var int overnightProfileStartTime = na
var int nyProfileStartTime = na

int vpIntrabarCount = array.size(vpPriceData)
if showSessionVolumeProfile and vpIntrabarCount > 0
    for i = 0 to vpIntrabarCount - 1
        float samplePrice = array.get(vpPriceData, i)
        float sampleVolume = nz(array.get(vpVolumeData, i))
        int sampleTime = array.get(vpTimeData, i)
        bool sampleInOvernight = array.get(vpOvernightData, i)
        bool sampleInNY = array.get(vpNYData, i)

        if sampleInOvernight and not previousVPOvernightFlag
            array.clear(overnightProfilePrices)
            array.clear(overnightProfileVolumes)
            overnightProfileStartTime := sampleTime

        if sampleInOvernight and not na(samplePrice) and sampleVolume >= 0
            array.push(overnightProfilePrices, samplePrice)
            array.push(overnightProfileVolumes, sampleVolume)

        if sampleInNY and not previousVPNYFlag
            array.clear(nyProfilePrices)
            array.clear(nyProfileVolumes)
            nyProfileStartTime := sampleTime

        if sampleInNY and not na(samplePrice) and sampleVolume >= 0
            array.push(nyProfilePrices, samplePrice)
            array.push(nyProfileVolumes, sampleVolume)

        previousVPOvernightFlag := sampleInOvernight
        previousVPNYFlag := sampleInNY

f_build_volume_profile(array<float> prices, array<float> volumes, array<float> bins, int rows, float valueAreaPercent) =>
    array.clear(bins)
    for row = 0 to rows - 1
        array.push(bins, 0.0)

    int sampleCount = array.size(prices)
    float profileLow = na
    float profileHigh = na
    float rowSize = na
    float poc = na
    float vah = na
    float val = na
    float maxRowVolume = na
    float totalVolume = 0.0

    if sampleCount > 0
        profileLow := array.get(prices, 0)
        profileHigh := profileLow

        for i = 0 to sampleCount - 1
            float p = array.get(prices, i)
            profileLow := math.min(profileLow, p)
            profileHigh := math.max(profileHigh, p)

        if profileHigh <= profileLow
            float halfSpan = syminfo.mintick * rows * 0.5
            profileLow -= halfSpan
            profileHigh += halfSpan

        rowSize := math.max((profileHigh - profileLow) / rows, syminfo.mintick)

        for i = 0 to sampleCount - 1
            float p = array.get(prices, i)
            float v = nz(array.get(volumes, i))
            int rowIndex = int(math.floor((p - profileLow) / rowSize))
            rowIndex := math.max(0, math.min(rows - 1, rowIndex))
            array.set(bins, rowIndex, array.get(bins, rowIndex) + v)
            totalVolume += v

        int pocIndex = 0
        maxRowVolume := array.get(bins, 0)
        for row = 1 to rows - 1
            float rowVolume = array.get(bins, row)
            if rowVolume > maxRowVolume
                maxRowVolume := rowVolume
                pocIndex := row

        int lowValueIndex = pocIndex
        int highValueIndex = pocIndex
        float accumulatedVolume = array.get(bins, pocIndex)
        float targetVolume = totalVolume * valueAreaPercent / 100.0

        while accumulatedVolume < targetVolume and (lowValueIndex > 0 or highValueIndex < rows - 1)
            float belowVolume = lowValueIndex > 0 ? array.get(bins, lowValueIndex - 1) : -1.0
            float aboveVolume = highValueIndex < rows - 1 ? array.get(bins, highValueIndex + 1) : -1.0

            if aboveVolume >= belowVolume and highValueIndex < rows - 1
                highValueIndex += 1
                accumulatedVolume += math.max(aboveVolume, 0.0)
            else if lowValueIndex > 0
                lowValueIndex -= 1
                accumulatedVolume += math.max(belowVolume, 0.0)
            else if highValueIndex < rows - 1
                highValueIndex += 1
                accumulatedVolume += math.max(aboveVolume, 0.0)

        poc := profileLow + (pocIndex + 0.5) * rowSize
        val := profileLow + lowValueIndex * rowSize
        vah := profileLow + (highValueIndex + 1.0) * rowSize

    [poc, vah, val, profileLow, profileHigh, rowSize, maxRowVolume, totalVolume]

[overnightPOC, overnightVAH, overnightVAL, overnightVPLow, overnightVPHigh, overnightVPRowSize, overnightVPMaxVolume, overnightVPTotalVolume] =
     f_build_volume_profile(overnightProfilePrices, overnightProfileVolumes, overnightProfileBins, profileRows, profileValueAreaPercent)

[nyPOC, nyVAH, nyVAL, nyVPLow, nyVPHigh, nyVPRowSize, nyVPMaxVolume, nyVPTotalVolume] =
     f_build_volume_profile(nyProfilePrices, nyProfileVolumes, nyProfileBins, profileRows, profileValueAreaPercent)

f_manage_profile_line(line existingLine, bool enabled, int startTime, float levelPrice, color lineColor, string lineStyle, int lineWidth) =>
    line outputLine = existingLine
    bool valid = enabled and not na(startTime) and not na(levelPrice)

    if valid
        if na(outputLine)
            outputLine := line.new(startTime, levelPrice, time, levelPrice,
                 xloc=xloc.bar_time, extend=extend.right, color=lineColor, style=lineStyle, width=lineWidth)
        else
            line.set_xy1(outputLine, startTime, levelPrice)
            line.set_xy2(outputLine, time, levelPrice)
            line.set_extend(outputLine, extend.right)
            line.set_color(outputLine, lineColor)
            line.set_style(outputLine, lineStyle)
            line.set_width(outputLine, lineWidth)
    else if not na(outputLine)
        line.delete(outputLine)
        outputLine := na
    outputLine

var line overnightVAHLine = na
var line overnightPOCLine = na
var line overnightVALLine = na
var line nyVAHLine = na
var line nyPOCLine = na
var line nyVALLine = na

bool overnightVPEnabled = showSessionVolumeProfile and showOvernightVP and array.size(overnightProfilePrices) > 0
bool nyVPEnabled = showSessionVolumeProfile and showNewYorkVP and array.size(nyProfilePrices) > 0

overnightVAHLine := f_manage_profile_line(overnightVAHLine, overnightVPEnabled, overnightProfileStartTime, overnightVAH,
     color.new(color.black, 20), line.style_dashed, 1)
overnightPOCLine := f_manage_profile_line(overnightPOCLine, overnightVPEnabled, overnightProfileStartTime, overnightPOC,
     color.new(color.black, 0), line.style_solid, 2)
overnightVALLine := f_manage_profile_line(overnightVALLine, overnightVPEnabled, overnightProfileStartTime, overnightVAL,
     color.new(color.black, 20), line.style_dashed, 1)

nyVAHLine := f_manage_profile_line(nyVAHLine, nyVPEnabled, nyProfileStartTime, nyVAH,
     color.new(color.black, 20), line.style_dashed, 1)
nyPOCLine := f_manage_profile_line(nyPOCLine, nyVPEnabled, nyProfileStartTime, nyPOC,
     color.new(color.black, 0), line.style_solid, 2)
nyVALLine := f_manage_profile_line(nyVALLine, nyVPEnabled, nyProfileStartTime, nyVAL,
     color.new(color.black, 20), line.style_dashed, 1)

var label overnightVAHLabel = na
var label overnightPOCLabel = na
var label overnightVALLabel = na
var label nyVAHLabel = na
var label nyPOCLabel = na
var label nyVALLabel = na

f_manage_profile_label(label existingLabel, bool enabled, float levelPrice, string labelText, color textColor) =>
    label outputLabel = existingLabel
    bool valid = enabled and not na(levelPrice)
    if valid and barstate.islast
        if na(outputLabel)
            outputLabel := label.new(bar_index + 1, levelPrice, labelText,
                 xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none,
                 textcolor=textColor, size=size.tiny)
        else
            label.set_x(outputLabel, bar_index + 1)
            label.set_y(outputLabel, levelPrice)
            label.set_text(outputLabel, labelText)
            label.set_textcolor(outputLabel, textColor)
    else if not valid and not na(outputLabel)
        label.delete(outputLabel)
        outputLabel := na
    outputLabel

overnightVAHLabel := f_manage_profile_label(overnightVAHLabel, overnightVPEnabled, overnightVAH, "ON VAH", color.black)
overnightPOCLabel := f_manage_profile_label(overnightPOCLabel, overnightVPEnabled, overnightPOC, "ON POC", color.black)
overnightVALLabel := f_manage_profile_label(overnightVALLabel, overnightVPEnabled, overnightVAL, "ON VAL", color.black)
nyVAHLabel := f_manage_profile_label(nyVAHLabel, nyVPEnabled, nyVAH, "NY VAH", color.black)
nyPOCLabel := f_manage_profile_label(nyPOCLabel, nyVPEnabled, nyPOC, "NY POC", color.black)
nyVALLabel := f_manage_profile_label(nyVALLabel, nyVPEnabled, nyVAL, "NY VAL", color.black)

var array<box> overnightHistogramBoxes = array.new<box>()
var array<box> nyHistogramBoxes = array.new<box>()

f_clear_histogram(array<box> boxes) =>
    int count = array.size(boxes)
    if count > 0
        for i = 0 to count - 1
            box.delete(array.get(boxes, i))
    array.clear(boxes)

f_draw_histogram(array<box> boxes, bool enabled, array<float> bins, int rows,
     float profileLow, float rowSize, float poc, float vah, float val, float maxRowVolume,
     int startOffset, int maxWidth, color baseColor) =>
    if barstate.islast
        if not enabled or na(profileLow) or na(rowSize) or na(maxRowVolume) or maxRowVolume <= 0 or array.size(bins) != rows
            f_clear_histogram(boxes)
        else
            while array.size(boxes) < rows
                array.push(boxes, box.new(bar_index, high, bar_index + 1, low,
                     xloc=xloc.bar_index, bgcolor=color.new(baseColor, 90), border_color=color.new(baseColor, 100)))
            while array.size(boxes) > rows
                int lastIndex = array.size(boxes) - 1
                box.delete(array.get(boxes, lastIndex))
                array.pop(boxes)

            for row = 0 to rows - 1
                float rowVolume = array.get(bins, row)
                float rowBottom = profileLow + row * rowSize
                float rowTop = rowBottom + rowSize
                float rowCenter = (rowBottom + rowTop) * 0.5
                int widthBars = math.max(1, int(math.round(rowVolume / maxRowVolume * maxWidth)))
                int leftIndex = bar_index + startOffset
                int rightIndex = leftIndex + widthBars
                bool insideValue = rowCenter >= val and rowCenter <= vah
                bool pocRow = math.abs(rowCenter - poc) <= rowSize * 0.51
                color fillColor = pocRow ? color.new(baseColor, 35) :
                     insideValue ? color.new(baseColor, 65) : color.new(baseColor, 86)

                box rowBox = array.get(boxes, row)
                box.set_left(rowBox, leftIndex)
                box.set_right(rowBox, rightIndex)
                box.set_top(rowBox, rowTop)
                box.set_bottom(rowBox, rowBottom)
                box.set_bgcolor(rowBox, fillColor)
                box.set_border_color(rowBox, color.new(baseColor, 100))

f_draw_histogram(overnightHistogramBoxes,
     showSessionVolumeProfile and showProfileHistogram and showOvernightVP,
     overnightProfileBins, profileRows, overnightVPLow, overnightVPRowSize,
     overnightPOC, overnightVAH, overnightVAL, overnightVPMaxVolume,
     profileHistogramOffset, profileHistogramWidth, color.gray)

f_draw_histogram(nyHistogramBoxes,
     showSessionVolumeProfile and showProfileHistogram and showNewYorkVP,
     nyProfileBins, profileRows, nyVPLow, nyVPRowSize,
     nyPOC, nyVAH, nyVAL, nyVPMaxVolume,
     profileHistogramOffset + profileHistogramWidth + 3, profileHistogramWidth, color.blue)

// ───── Profile confluence helper
f_level_touched(float level, float tolerance) =>
    not na(level) and high >= level - tolerance and low <= level + tolerance

float profileTolerance = atr * profileLevelToleranceATR

f_profile_confluence_text() =>
    string result = ""
    float bestDistance = na

    if showSessionVolumeProfile and profileUseForEntryConfluence
        if overnightVPEnabled
            if f_level_touched(overnightVAH, profileTolerance)
                float d = math.abs(close - overnightVAH)
                if na(bestDistance) or d < bestDistance
                    bestDistance := d
                    result := "ON VAH"
            if f_level_touched(overnightPOC, profileTolerance)
                float d = math.abs(close - overnightPOC)
                if na(bestDistance) or d < bestDistance
                    bestDistance := d
                    result := "ON POC"
            if f_level_touched(overnightVAL, profileTolerance)
                float d = math.abs(close - overnightVAL)
                if na(bestDistance) or d < bestDistance
                    bestDistance := d
                    result := "ON VAL"

        if nyVPEnabled
            if f_level_touched(nyVAH, profileTolerance)
                float d = math.abs(close - nyVAH)
                if na(bestDistance) or d < bestDistance
                    bestDistance := d
                    result := "NY VAH"
            if f_level_touched(nyPOC, profileTolerance)
                float d = math.abs(close - nyPOC)
                if na(bestDistance) or d < bestDistance
                    bestDistance := d
                    result := "NY POC"
            if f_level_touched(nyVAL, profileTolerance)
                float d = math.abs(close - nyVAL)
                if na(bestDistance) or d < bestDistance
                    bestDistance := d
                    result := "NY VAL"
    result



// ───── Market structure + S/R + Auction Location entry engine
f_valid_touch(float zoneTop, float zoneBottom) =>
    not na(zoneTop) and not na(zoneBottom) and high >= zoneBottom and low <= zoneTop

f_min_valid(float a, float b) =>
    na(a) ? b : na(b) ? a : math.min(a, b)

f_max_valid(float a, float b) =>
    na(a) ? b : na(b) ? a : math.max(a, b)

f_append_tag(string baseText, bool condition, string tagText) =>
    condition ? (str.length(baseText) > 0 ? baseText + " • " + tagText : tagText) : baseText

// Horizontal established levels are deliberately two-way. The same prior high can reject as resistance
// from below or later hold as support after acceptance above. Price action decides the role.
f_bull_at_level(float levelPrice, float tolerance) =>
    bool valid = not na(levelPrice)
    bool touched = valid and f_level_touched(levelPrice, tolerance)
    bool sweepReclaim = valid and low < levelPrice and close > levelPrice and bullReactionCandle
    bool bullishHold = touched and close > levelPrice and close[1] > levelPrice and close > open
    bool bullishReclaim = valid and close > levelPrice and close[1] <= levelPrice + tolerance and bullReactionCandle
    bool bullishReject = touched and close > levelPrice and bullRejectCandle
    bool bullishImpulse = touched and close > levelPrice and (bullDisplacement or bullMicroShift or bullVolumeReaction)
    sweepReclaim or bullishHold or bullishReclaim or bullishReject or bullishImpulse

f_bear_at_level(float levelPrice, float tolerance) =>
    bool valid = not na(levelPrice)
    bool touched = valid and f_level_touched(levelPrice, tolerance)
    bool sweepReclaim = valid and high > levelPrice and close < levelPrice and bearReactionCandle
    bool bearishHold = touched and close < levelPrice and close[1] < levelPrice and close < open
    bool bearishReclaim = valid and close < levelPrice and close[1] >= levelPrice - tolerance and bearReactionCandle
    bool bearishReject = touched and close < levelPrice and bearRejectCandle
    bool bearishImpulse = touched and close < levelPrice and (bearDisplacement or bearMicroShift or bearVolumeReaction)
    sweepReclaim or bearishHold or bearishReclaim or bearishReject or bearishImpulse

float chartSeconds = timeframe.in_seconds()
string executionTFLabel = f_pretty_timeframe(timeframe.period)


// ───── Chart-TF S/R-Backed Swing Areas
// No separate liquidity-pivot lookback exists in v8.6.
// A SWING L/H is born from the SAME confirmed pivot event and SAME source candle
// that creates the chart-timeframe Support/Resistance box.
// Therefore:
//   chart Support appears  -> SWING L appears on the same bar
//   chart Resistance appears -> SWING H appears on the same bar
//   chart S/R invalidates/replaces -> its matching swing visual disappears/replaces
// This keeps the swing layer subordinate to S/R instead of running a second structure engine.
bool newChartSupportNow = showChartSR and not na(chartSupTime) and (na(chartSupTime[1]) or chartSupTime != chartSupTime[1])
bool newChartResistanceNow = showChartSR and not na(chartResTime) and (na(chartResTime[1]) or chartResTime != chartResTime[1])

var box srSwingLowBox = na
var box srSwingHighBox = na
var float activeSwingLowTop = na
var float activeSwingLowBottom = na
var int activeSwingLowTime = na
var bool activeSwingLowSwept = false
var float activeSwingHighTop = na
var float activeSwingHighBottom = na
var int activeSwingHighTime = na
var bool activeSwingHighSwept = false

color swingHighFill = color.new(color.red, swingActiveTransparency)
color swingHighBorder = color.new(color.red, 45)
color swingLowFill = color.new(color.teal, swingActiveTransparency)
color swingLowBorder = color.new(color.teal, 45)

// New support/resistance confirmation replaces the prior same-side swing because
// the chart-TF S/R engine itself now considers the newer pivot the active zone.
if newChartSupportNow
    if not na(srSwingLowBox)
        box.delete(srSwingLowBox)
    float pivotBodyLow = math.min(open[srPivotStrength], close[srPivotStrength])
    activeSwingLowBottom := chartSupBottom
    activeSwingLowTop := swingAreaStyle == "Wick Zone" ? math.min(chartSupTop, pivotBodyLow) : chartSupTop
    activeSwingLowTime := chartSupTime
    activeSwingLowSwept := false
    srSwingLowBox := showSwingAreas ? box.new(left=bar_index - srPivotStrength, top=activeSwingLowTop,
         right=bar_index + swingAreaExtendBars, bottom=activeSwingLowBottom, xloc=xloc.bar_index, extend=extend.none,
         bgcolor=swingLowFill, border_color=swingLowBorder, border_width=1,
         text=showSwingAreaLabels ? "SWING L" : "", text_color=color.new(color.teal, 5), text_size=size.tiny,
         text_halign=text.align_right, text_valign=text.align_center) : na

if newChartResistanceNow
    if not na(srSwingHighBox)
        box.delete(srSwingHighBox)
    float pivotBodyHigh = math.max(open[srPivotStrength], close[srPivotStrength])
    activeSwingHighTop := chartResTop
    activeSwingHighBottom := swingAreaStyle == "Wick Zone" ? math.max(chartResBottom, pivotBodyHigh) : chartResBottom
    activeSwingHighTime := chartResTime
    activeSwingHighSwept := false
    srSwingHighBox := showSwingAreas ? box.new(left=bar_index - srPivotStrength, top=activeSwingHighTop,
         right=bar_index + swingAreaExtendBars, bottom=activeSwingHighBottom, xloc=xloc.bar_index, extend=extend.none,
         bgcolor=swingHighFill, border_color=swingHighBorder, border_width=1,
         text=showSwingAreaLabels ? "SWING H" : "", text_color=color.new(color.red, 5), text_size=size.tiny,
         text_halign=text.align_right, text_valign=text.align_center) : na

bool swingHighSweepNow = false
bool swingLowSweepNow = false
bool swingHighBreakNow = false
bool swingLowBreakNow = false

// Same invalidation rule as the S/R engine: close through the outer edge kills the structure.
// A wick through followed by a close back inside is a sweep and does NOT kill the S/R swing.
if not na(activeSwingLowBottom)
    bool lowBroke = close < activeSwingLowBottom
    bool lowSwept = low < activeSwingLowBottom and close >= activeSwingLowBottom
    bool supportStillSame = not na(chartSupTime) and chartSupTime == activeSwingLowTime
    if lowBroke or (not supportStillSame and not newChartSupportNow)
        swingLowBreakNow := lowBroke
        if lowBroke and showSwingStateLabels
            label.new(bar_index, low, "BREAK L", yloc=yloc.belowbar, style=label.style_none,
                 textcolor=color.new(color.teal, 15), size=size.tiny)
        if not na(srSwingLowBox)
            box.delete(srSwingLowBox)
        srSwingLowBox := na
        activeSwingLowTop := na
        activeSwingLowBottom := na
        activeSwingLowTime := na
        activeSwingLowSwept := false
    else
        if not na(srSwingLowBox)
            box.set_right(srSwingLowBox, bar_index + swingAreaExtendBars)
        if lowSwept and not activeSwingLowSwept
            activeSwingLowSwept := true
            swingLowSweepNow := true
            if showSwingStateLabels
                label.new(bar_index, low, "SWEEP L", yloc=yloc.belowbar, style=label.style_none,
                     textcolor=color.new(color.teal, 15), size=size.tiny)

if not na(activeSwingHighTop)
    bool highBroke = close > activeSwingHighTop
    bool highSwept = high > activeSwingHighTop and close <= activeSwingHighTop
    bool resistanceStillSame = not na(chartResTime) and chartResTime == activeSwingHighTime
    if highBroke or (not resistanceStillSame and not newChartResistanceNow)
        swingHighBreakNow := highBroke
        if highBroke and showSwingStateLabels
            label.new(bar_index, high, "BREAK H", yloc=yloc.abovebar, style=label.style_none,
                 textcolor=color.new(color.red, 15), size=size.tiny)
        if not na(srSwingHighBox)
            box.delete(srSwingHighBox)
        srSwingHighBox := na
        activeSwingHighTop := na
        activeSwingHighBottom := na
        activeSwingHighTime := na
        activeSwingHighSwept := false
    else
        if not na(srSwingHighBox)
            box.set_right(srSwingHighBox, bar_index + swingAreaExtendBars)
        if highSwept and not activeSwingHighSwept
            activeSwingHighSwept := true
            swingHighSweepNow := true
            if showSwingStateLabels
                label.new(bar_index, high, "SWEEP H", yloc=yloc.abovebar, style=label.style_none,
                     textcolor=color.new(color.red, 15), size=size.tiny)

bool currentLatestHighSweep = not na(activeSwingHighTop) and high > activeSwingHighTop and close <= activeSwingHighTop
bool currentLatestLowSweep = not na(activeSwingLowBottom) and low < activeSwingLowBottom and close >= activeSwingLowBottom

// S/R-backed swings can still show live defense states, but they do not create context by themselves.
bool activeSwingLowBullReaction = reactionBarConfirmed and not na(activeSwingLowTop) and not na(activeSwingLowBottom) and
     f_bull_at_zone(activeSwingLowTop, activeSwingLowBottom)
bool activeSwingHighBearReaction = reactionBarConfirmed and not na(activeSwingHighTop) and not na(activeSwingHighBottom) and
     f_bear_at_zone(activeSwingHighTop, activeSwingHighBottom)

alertcondition(swingHighSweepNow, "EZ$ S/R Swing High Swept", "EZ$: price swept the active chart-TF resistance-backed Swing H and closed back below its outer edge.")
alertcondition(swingLowSweepNow, "EZ$ S/R Swing Low Swept", "EZ$: price swept the active chart-TF support-backed Swing L and closed back above its outer edge.")
alertcondition(swingHighBreakNow, "EZ$ S/R Swing High Broken", "EZ$: price closed through the active chart-TF resistance-backed Swing H; the resistance/swing structure is invalidated.")
alertcondition(swingLowBreakNow, "EZ$ S/R Swing Low Broken", "EZ$: price closed through the active chart-TF support-backed Swing L; the support/swing structure is invalidated.")

bool ctx5 = not na(chartSeconds) and timeframe.in_seconds("5") > chartSeconds
bool ctx15 = not na(chartSeconds) and timeframe.in_seconds("15") > chartSeconds
bool ctx1h = not na(chartSeconds) and timeframe.in_seconds("60") > chartSeconds
bool ctx2h = not na(chartSeconds) and timeframe.in_seconds("120") > chartSeconds
bool ctx4h = not na(chartSeconds) and timeframe.in_seconds("240") > chartSeconds
bool ctx8h = not na(chartSeconds) and timeframe.in_seconds("480") > chartSeconds
bool ctxD = not na(chartSeconds) and timeframe.in_seconds("1D") > chartSeconds
bool ctxW = not na(chartSeconds) and timeframe.in_seconds("1W") > chartSeconds

// ───── A. Active + faded higher-timeframe S/R boxes
// Current-chart S/R remains execution authority. Every fixed timeframe strictly ABOVE the chart may add context.
bool activeSup5 = ctx5 and show5mSR and f_valid_touch(s5Top, s5Bottom)
bool activeRes5 = ctx5 and show5mSR and f_valid_touch(r5Top, r5Bottom)
bool activeSup15 = ctx15 and show15mSR and f_valid_touch(s15Top, s15Bottom)
bool activeRes15 = ctx15 and show15mSR and f_valid_touch(r15Top, r15Bottom)
bool activeSup1h = ctx1h and show1hSR and f_valid_touch(s1hTop, s1hBottom)
bool activeRes1h = ctx1h and show1hSR and f_valid_touch(r1hTop, r1hBottom)
bool activeSup2h = ctx2h and show2hSR and f_valid_touch(s2hTop, s2hBottom)
bool activeRes2h = ctx2h and show2hSR and f_valid_touch(r2hTop, r2hBottom)
bool activeSup4h = ctx4h and show4hSR and f_valid_touch(s4hTop, s4hBottom)
bool activeRes4h = ctx4h and show4hSR and f_valid_touch(r4hTop, r4hBottom)
bool activeSup8h = ctx8h and show8hSR and f_valid_touch(s8hTop, s8hBottom)
bool activeRes8h = ctx8h and show8hSR and f_valid_touch(r8hTop, r8hBottom)
bool activeSupD = ctxD and showDailySR and f_valid_touch(sDTop, sDBottom)
bool activeResD = ctxD and showDailySR and f_valid_touch(rDTop, rDBottom)
bool activeSupW = ctxW and showWeeklySR and f_valid_touch(sWTop, sWBottom)
bool activeResW = ctxW and showWeeklySR and f_valid_touch(rWTop, rWBottom)

bool memorySup15 = includePreviousHTFMemoryForSetups and ctx15 and showPreviousHTFMemory and showPreviousHTFSupport and f_valid_touch(ps15Top, ps15Bottom)
bool memoryRes15 = includePreviousHTFMemoryForSetups and ctx15 and showPreviousHTFMemory and showPreviousHTFResistance and f_valid_touch(pr15Top, pr15Bottom)
bool memorySup1h = includePreviousHTFMemoryForSetups and ctx1h and showPreviousHTFMemory and showPreviousHTFSupport and f_valid_touch(ps1hTop, ps1hBottom)
bool memoryRes1h = includePreviousHTFMemoryForSetups and ctx1h and showPreviousHTFMemory and showPreviousHTFResistance and f_valid_touch(pr1hTop, pr1hBottom)
bool memorySup2h = includePreviousHTFMemoryForSetups and ctx2h and showPreviousHTFMemory and showPreviousHTFSupport and f_valid_touch(ps2hTop, ps2hBottom)
bool memoryRes2h = includePreviousHTFMemoryForSetups and ctx2h and showPreviousHTFMemory and showPreviousHTFResistance and f_valid_touch(pr2hTop, pr2hBottom)
bool memorySup4h = includePreviousHTFMemoryForSetups and ctx4h and showPreviousHTFMemory and showPreviousHTFSupport and f_valid_touch(ps4hTop, ps4hBottom)
bool memoryRes4h = includePreviousHTFMemoryForSetups and ctx4h and showPreviousHTFMemory and showPreviousHTFResistance and f_valid_touch(pr4hTop, pr4hBottom)
bool memorySup8h = includePreviousHTFMemoryForSetups and ctx8h and showPreviousHTFMemory and showPreviousHTFSupport and f_valid_touch(ps8hTop, ps8hBottom)
bool memoryRes8h = includePreviousHTFMemoryForSetups and ctx8h and showPreviousHTFMemory and showPreviousHTFResistance and f_valid_touch(pr8hTop, pr8hBottom)
bool memorySupD = includePreviousHTFMemoryForSetups and ctxD and showPreviousHTFMemory and showPreviousHTFSupport and f_valid_touch(psDTop, psDBottom)
bool memoryResD = includePreviousHTFMemoryForSetups and ctxD and showPreviousHTFMemory and showPreviousHTFResistance and f_valid_touch(prDTop, prDBottom)
bool memorySupW = includePreviousHTFMemoryForSetups and ctxW and showPreviousHTFMemory and showPreviousHTFSupport and f_valid_touch(psWTop, psWBottom)
bool memoryResW = includePreviousHTFMemoryForSetups and ctxW and showPreviousHTFMemory and showPreviousHTFResistance and f_valid_touch(prWTop, prWBottom)

int activeSupportCount = (activeSup5 ? 1 : 0) + (activeSup15 ? 1 : 0) + (activeSup1h ? 1 : 0) + (activeSup2h ? 1 : 0) +
     (activeSup4h ? 1 : 0) + (activeSup8h ? 1 : 0) + (activeSupD ? 1 : 0) + (activeSupW ? 1 : 0)
int activeResistanceCount = (activeRes5 ? 1 : 0) + (activeRes15 ? 1 : 0) + (activeRes1h ? 1 : 0) + (activeRes2h ? 1 : 0) +
     (activeRes4h ? 1 : 0) + (activeRes8h ? 1 : 0) + (activeResD ? 1 : 0) + (activeResW ? 1 : 0)
int memorySupportCount = (memorySup15 ? 1 : 0) + (memorySup1h ? 1 : 0) + (memorySup2h ? 1 : 0) +
     (memorySup4h ? 1 : 0) + (memorySup8h ? 1 : 0) + (memorySupD ? 1 : 0) + (memorySupW ? 1 : 0)
int memoryResistanceCount = (memoryRes15 ? 1 : 0) + (memoryRes1h ? 1 : 0) + (memoryRes2h ? 1 : 0) +
     (memoryRes4h ? 1 : 0) + (memoryRes8h ? 1 : 0) + (memoryResD ? 1 : 0) + (memoryResW ? 1 : 0)

int supportContextCount = activeSupportCount + memorySupportCount
int resistanceContextCount = activeResistanceCount + memoryResistanceCount

string activeSupportTF = activeSup5 ? "5M" : activeSup15 ? "15M" : activeSup1h ? "1H" : activeSup2h ? "2H" :
     activeSup4h ? "4H" : activeSup8h ? "8H" : activeSupD ? "D" : activeSupW ? "W" : ""
string activeResistanceTF = activeRes5 ? "5M" : activeRes15 ? "15M" : activeRes1h ? "1H" : activeRes2h ? "2H" :
     activeRes4h ? "4H" : activeRes8h ? "8H" : activeResD ? "D" : activeResW ? "W" : ""
string memorySupportTF = memorySup15 ? "15M" : memorySup1h ? "1H" : memorySup2h ? "2H" : memorySup4h ? "4H" :
     memorySup8h ? "8H" : memorySupD ? "D" : memorySupW ? "W" : ""
string memoryResistanceTF = memoryRes15 ? "15M" : memoryRes1h ? "1H" : memoryRes2h ? "2H" : memoryRes4h ? "4H" :
     memoryRes8h ? "8H" : memoryResD ? "D" : memoryResW ? "W" : ""

string supportLocationText = activeSupportCount > 0 ?
     activeSupportTF + (supportContextCount > 1 ? "+" : "") :
     memorySupportCount > 0 ? "PREV " + memorySupportTF + (memorySupportCount > 1 ? "+" : "") : ""
string resistanceLocationText = activeResistanceCount > 0 ?
     activeResistanceTF + (resistanceContextCount > 1 ? "+" : "") :
     memoryResistanceCount > 0 ? "PREV " + memoryResistanceTF + (memoryResistanceCount > 1 ? "+" : "") : ""

float supportInvalidation = na
if activeSup5
    supportInvalidation := f_min_valid(supportInvalidation, s5Bottom)
if activeSup15
    supportInvalidation := f_min_valid(supportInvalidation, s15Bottom)
if activeSup1h
    supportInvalidation := f_min_valid(supportInvalidation, s1hBottom)
if activeSup2h
    supportInvalidation := f_min_valid(supportInvalidation, s2hBottom)
if activeSup4h
    supportInvalidation := f_min_valid(supportInvalidation, s4hBottom)
if activeSup8h
    supportInvalidation := f_min_valid(supportInvalidation, s8hBottom)
if activeSupD
    supportInvalidation := f_min_valid(supportInvalidation, sDBottom)
if activeSupW
    supportInvalidation := f_min_valid(supportInvalidation, sWBottom)
if memorySup15
    supportInvalidation := f_min_valid(supportInvalidation, ps15Bottom)
if memorySup1h
    supportInvalidation := f_min_valid(supportInvalidation, ps1hBottom)
if memorySup2h
    supportInvalidation := f_min_valid(supportInvalidation, ps2hBottom)
if memorySup4h
    supportInvalidation := f_min_valid(supportInvalidation, ps4hBottom)
if memorySup8h
    supportInvalidation := f_min_valid(supportInvalidation, ps8hBottom)
if memorySupD
    supportInvalidation := f_min_valid(supportInvalidation, psDBottom)
if memorySupW
    supportInvalidation := f_min_valid(supportInvalidation, psWBottom)

float resistanceInvalidation = na
if activeRes5
    resistanceInvalidation := f_max_valid(resistanceInvalidation, r5Top)
if activeRes15
    resistanceInvalidation := f_max_valid(resistanceInvalidation, r15Top)
if activeRes1h
    resistanceInvalidation := f_max_valid(resistanceInvalidation, r1hTop)
if activeRes2h
    resistanceInvalidation := f_max_valid(resistanceInvalidation, r2hTop)
if activeRes4h
    resistanceInvalidation := f_max_valid(resistanceInvalidation, r4hTop)
if activeRes8h
    resistanceInvalidation := f_max_valid(resistanceInvalidation, r8hTop)
if activeResD
    resistanceInvalidation := f_max_valid(resistanceInvalidation, rDTop)
if activeResW
    resistanceInvalidation := f_max_valid(resistanceInvalidation, rWTop)
if memoryRes15
    resistanceInvalidation := f_max_valid(resistanceInvalidation, pr15Top)
if memoryRes1h
    resistanceInvalidation := f_max_valid(resistanceInvalidation, pr1hTop)
if memoryRes2h
    resistanceInvalidation := f_max_valid(resistanceInvalidation, pr2hTop)
if memoryRes4h
    resistanceInvalidation := f_max_valid(resistanceInvalidation, pr4hTop)
if memoryRes8h
    resistanceInvalidation := f_max_valid(resistanceInvalidation, pr8hTop)
if memoryResD
    resistanceInvalidation := f_max_valid(resistanceInvalidation, prDTop)
if memoryResW
    resistanceInvalidation := f_max_valid(resistanceInvalidation, prWTop)

bool activeHTFBullReaction = (ctx5 and support5mReactionRaw) or (ctx15 and support15mReactionRaw) or (ctx1h and support1hReactionRaw) or
     (ctx2h and support2hReactionRaw) or (ctx4h and support4hReactionRaw) or
     (ctx8h and support8hReactionRaw) or (ctxD and supportDReactionRaw) or (ctxW and supportWReactionRaw)
bool activeHTFBearReaction = (ctx5 and resistance5mReactionRaw) or (ctx15 and resistance15mReactionRaw) or (ctx1h and resistance1hReactionRaw) or
     (ctx2h and resistance2hReactionRaw) or (ctx4h and resistance4hReactionRaw) or
     (ctx8h and resistance8hReactionRaw) or (ctxD and resistanceDReactionRaw) or (ctxW and resistanceWReactionRaw)

bool memoryHTFBullReaction = includePreviousHTFMemoryForSetups and (
     (memorySup15 and f_bull_at_zone(ps15Top, ps15Bottom)) or
     (memorySup1h and f_bull_at_zone(ps1hTop, ps1hBottom)) or
     (memorySup2h and f_bull_at_zone(ps2hTop, ps2hBottom)) or
     (memorySup4h and f_bull_at_zone(ps4hTop, ps4hBottom)) or
     (memorySup8h and f_bull_at_zone(ps8hTop, ps8hBottom)) or
     (memorySupD and f_bull_at_zone(psDTop, psDBottom)) or
     (memorySupW and f_bull_at_zone(psWTop, psWBottom)))

bool memoryHTFBearReaction = includePreviousHTFMemoryForSetups and (
     (memoryRes15 and f_bear_at_zone(pr15Top, pr15Bottom)) or
     (memoryRes1h and f_bear_at_zone(pr1hTop, pr1hBottom)) or
     (memoryRes2h and f_bear_at_zone(pr2hTop, pr2hBottom)) or
     (memoryRes4h and f_bear_at_zone(pr4hTop, pr4hBottom)) or
     (memoryRes8h and f_bear_at_zone(pr8hTop, pr8hBottom)) or
     (memoryResD and f_bear_at_zone(prDTop, prDBottom)) or
     (memoryResW and f_bear_at_zone(prWTop, prWBottom)))

bool htfBullReaction = activeHTFBullReaction or memoryHTFBullReaction
bool htfBearReaction = activeHTFBearReaction or memoryHTFBearReaction

// ───── B. Established key/session levels as two-way market structure
float majorLevelTolerance = atr * majorLevelToleranceATR

bool bullPDH = useMajorKeyLevelsForLocation and showPreviousDay and f_bull_at_level(pdHigh, majorLevelTolerance)
bool bearPDH = useMajorKeyLevelsForLocation and showPreviousDay and f_bear_at_level(pdHigh, majorLevelTolerance)
bool bullPDL = useMajorKeyLevelsForLocation and showPreviousDay and f_bull_at_level(pdLow, majorLevelTolerance)
bool bearPDL = useMajorKeyLevelsForLocation and showPreviousDay and f_bear_at_level(pdLow, majorLevelTolerance)
bool bullPWH = useMajorKeyLevelsForLocation and showPreviousWeek and f_bull_at_level(pwHigh, majorLevelTolerance)
bool bearPWH = useMajorKeyLevelsForLocation and showPreviousWeek and f_bear_at_level(pwHigh, majorLevelTolerance)
bool bullPWL = useMajorKeyLevelsForLocation and showPreviousWeek and f_bull_at_level(pwLow, majorLevelTolerance)
bool bearPWL = useMajorKeyLevelsForLocation and showPreviousWeek and f_bear_at_level(pwLow, majorLevelTolerance)
bool bullPMH = useMajorKeyLevelsForLocation and showPreviousMonth and f_bull_at_level(pmHigh, majorLevelTolerance)
bool bearPMH = useMajorKeyLevelsForLocation and showPreviousMonth and f_bear_at_level(pmHigh, majorLevelTolerance)
bool bullPML = useMajorKeyLevelsForLocation and showPreviousMonth and f_bull_at_level(pmLow, majorLevelTolerance)
bool bearPML = useMajorKeyLevelsForLocation and showPreviousMonth and f_bear_at_level(pmLow, majorLevelTolerance)
bool bullP4HH = useMajorKeyLevelsForLocation and showPrevious4HLevels and f_bull_at_level(previous4HHigh, majorLevelTolerance)
bool bearP4HH = useMajorKeyLevelsForLocation and showPrevious4HLevels and f_bear_at_level(previous4HHigh, majorLevelTolerance)
bool bullP4HL = useMajorKeyLevelsForLocation and showPrevious4HLevels and f_bull_at_level(previous4HLow, majorLevelTolerance)
bool bearP4HL = useMajorKeyLevelsForLocation and showPrevious4HLevels and f_bear_at_level(previous4HLow, majorLevelTolerance)
bool bullAsiaH = useMajorKeyLevelsForLocation and asiaHighEnabled and f_bull_at_level(asiaHigh, majorLevelTolerance)
bool bearAsiaH = useMajorKeyLevelsForLocation and asiaHighEnabled and f_bear_at_level(asiaHigh, majorLevelTolerance)
bool bullAsiaL = useMajorKeyLevelsForLocation and asiaLowEnabled and f_bull_at_level(asiaLow, majorLevelTolerance)
bool bearAsiaL = useMajorKeyLevelsForLocation and asiaLowEnabled and f_bear_at_level(asiaLow, majorLevelTolerance)
bool bullLondonH = useMajorKeyLevelsForLocation and londonHighEnabled and f_bull_at_level(londonHigh, majorLevelTolerance)
bool bearLondonH = useMajorKeyLevelsForLocation and londonHighEnabled and f_bear_at_level(londonHigh, majorLevelTolerance)
bool bullLondonL = useMajorKeyLevelsForLocation and londonLowEnabled and f_bull_at_level(londonLow, majorLevelTolerance)
bool bearLondonL = useMajorKeyLevelsForLocation and londonLowEnabled and f_bear_at_level(londonLow, majorLevelTolerance)
bool bullNYH = useMajorKeyLevelsForLocation and newYorkHighEnabled and f_bull_at_level(newYorkHigh, majorLevelTolerance)
bool bearNYH = useMajorKeyLevelsForLocation and newYorkHighEnabled and f_bear_at_level(newYorkHigh, majorLevelTolerance)
bool bullNYL = useMajorKeyLevelsForLocation and newYorkLowEnabled and f_bull_at_level(newYorkLow, majorLevelTolerance)
bool bearNYL = useMajorKeyLevelsForLocation and newYorkLowEnabled and f_bear_at_level(newYorkLow, majorLevelTolerance)
bool bullONH = useMajorKeyLevelsForLocation and overnightHighEnabled and f_bull_at_level(overnightHigh, majorLevelTolerance)
bool bearONH = useMajorKeyLevelsForLocation and overnightHighEnabled and f_bear_at_level(overnightHigh, majorLevelTolerance)
bool bullONL = useMajorKeyLevelsForLocation and overnightLowEnabled and f_bull_at_level(overnightLow, majorLevelTolerance)
bool bearONL = useMajorKeyLevelsForLocation and overnightLowEnabled and f_bear_at_level(overnightLow, majorLevelTolerance)

bool majorLevelBullReaction = bullPDH or bullPDL or bullPWH or bullPWL or bullPMH or bullPML or
     bullP4HH or bullP4HL or bullAsiaH or bullAsiaL or bullLondonH or bullLondonL or bullNYH or bullNYL or bullONH or bullONL
bool majorLevelBearReaction = bearPDH or bearPDL or bearPWH or bearPWL or bearPMH or bearPML or
     bearP4HH or bearP4HL or bearAsiaH or bearAsiaL or bearLondonH or bearLondonL or bearNYH or bearNYL or bearONH or bearONL

string majorBullLocationText = ""
majorBullLocationText := f_append_tag(majorBullLocationText, bullPWH, "PWH")
majorBullLocationText := f_append_tag(majorBullLocationText, bullPWL, "PWL")
majorBullLocationText := f_append_tag(majorBullLocationText, bullPDH, "PDH")
majorBullLocationText := f_append_tag(majorBullLocationText, bullPDL, "PDL")
majorBullLocationText := f_append_tag(majorBullLocationText, bullPMH, "PMH")
majorBullLocationText := f_append_tag(majorBullLocationText, bullPML, "PML")
majorBullLocationText := f_append_tag(majorBullLocationText, bullP4HH, "P4H H")
majorBullLocationText := f_append_tag(majorBullLocationText, bullP4HL, "P4H L")
majorBullLocationText := f_append_tag(majorBullLocationText, bullONH, "ON H")
majorBullLocationText := f_append_tag(majorBullLocationText, bullONL, "ON L")
majorBullLocationText := f_append_tag(majorBullLocationText, bullLondonH, "LONDON H")
majorBullLocationText := f_append_tag(majorBullLocationText, bullLondonL, "LONDON L")
majorBullLocationText := f_append_tag(majorBullLocationText, bullAsiaH, "ASIA H")
majorBullLocationText := f_append_tag(majorBullLocationText, bullAsiaL, "ASIA L")
majorBullLocationText := f_append_tag(majorBullLocationText, bullNYH, "NY H")
majorBullLocationText := f_append_tag(majorBullLocationText, bullNYL, "NY L")

string majorBearLocationText = ""
majorBearLocationText := f_append_tag(majorBearLocationText, bearPWH, "PWH")
majorBearLocationText := f_append_tag(majorBearLocationText, bearPWL, "PWL")
majorBearLocationText := f_append_tag(majorBearLocationText, bearPDH, "PDH")
majorBearLocationText := f_append_tag(majorBearLocationText, bearPDL, "PDL")
majorBearLocationText := f_append_tag(majorBearLocationText, bearPMH, "PMH")
majorBearLocationText := f_append_tag(majorBearLocationText, bearPML, "PML")
majorBearLocationText := f_append_tag(majorBearLocationText, bearP4HH, "P4H H")
majorBearLocationText := f_append_tag(majorBearLocationText, bearP4HL, "P4H L")
majorBearLocationText := f_append_tag(majorBearLocationText, bearONH, "ON H")
majorBearLocationText := f_append_tag(majorBearLocationText, bearONL, "ON L")
majorBearLocationText := f_append_tag(majorBearLocationText, bearLondonH, "LONDON H")
majorBearLocationText := f_append_tag(majorBearLocationText, bearLondonL, "LONDON L")
majorBearLocationText := f_append_tag(majorBearLocationText, bearAsiaH, "ASIA H")
majorBearLocationText := f_append_tag(majorBearLocationText, bearAsiaL, "ASIA L")
majorBearLocationText := f_append_tag(majorBearLocationText, bearNYH, "NY H")
majorBearLocationText := f_append_tag(majorBearLocationText, bearNYL, "NY L")

float majorBullInvalidation = na
float majorBearInvalidation = na
if bullPDH
    majorBullInvalidation := f_min_valid(majorBullInvalidation, pdHigh - majorLevelTolerance)
if bullPDL
    majorBullInvalidation := f_min_valid(majorBullInvalidation, pdLow - majorLevelTolerance)
if bullPWH
    majorBullInvalidation := f_min_valid(majorBullInvalidation, pwHigh - majorLevelTolerance)
if bullPWL
    majorBullInvalidation := f_min_valid(majorBullInvalidation, pwLow - majorLevelTolerance)
if bullPMH
    majorBullInvalidation := f_min_valid(majorBullInvalidation, pmHigh - majorLevelTolerance)
if bullPML
    majorBullInvalidation := f_min_valid(majorBullInvalidation, pmLow - majorLevelTolerance)
if bullP4HH
    majorBullInvalidation := f_min_valid(majorBullInvalidation, previous4HHigh - majorLevelTolerance)
if bullP4HL
    majorBullInvalidation := f_min_valid(majorBullInvalidation, previous4HLow - majorLevelTolerance)
if bullAsiaH
    majorBullInvalidation := f_min_valid(majorBullInvalidation, asiaHigh - majorLevelTolerance)
if bullAsiaL
    majorBullInvalidation := f_min_valid(majorBullInvalidation, asiaLow - majorLevelTolerance)
if bullLondonH
    majorBullInvalidation := f_min_valid(majorBullInvalidation, londonHigh - majorLevelTolerance)
if bullLondonL
    majorBullInvalidation := f_min_valid(majorBullInvalidation, londonLow - majorLevelTolerance)
if bullNYH
    majorBullInvalidation := f_min_valid(majorBullInvalidation, newYorkHigh - majorLevelTolerance)
if bullNYL
    majorBullInvalidation := f_min_valid(majorBullInvalidation, newYorkLow - majorLevelTolerance)
if bullONH
    majorBullInvalidation := f_min_valid(majorBullInvalidation, overnightHigh - majorLevelTolerance)
if bullONL
    majorBullInvalidation := f_min_valid(majorBullInvalidation, overnightLow - majorLevelTolerance)

if bearPDH
    majorBearInvalidation := f_max_valid(majorBearInvalidation, pdHigh + majorLevelTolerance)
if bearPDL
    majorBearInvalidation := f_max_valid(majorBearInvalidation, pdLow + majorLevelTolerance)
if bearPWH
    majorBearInvalidation := f_max_valid(majorBearInvalidation, pwHigh + majorLevelTolerance)
if bearPWL
    majorBearInvalidation := f_max_valid(majorBearInvalidation, pwLow + majorLevelTolerance)
if bearPMH
    majorBearInvalidation := f_max_valid(majorBearInvalidation, pmHigh + majorLevelTolerance)
if bearPML
    majorBearInvalidation := f_max_valid(majorBearInvalidation, pmLow + majorLevelTolerance)
if bearP4HH
    majorBearInvalidation := f_max_valid(majorBearInvalidation, previous4HHigh + majorLevelTolerance)
if bearP4HL
    majorBearInvalidation := f_max_valid(majorBearInvalidation, previous4HLow + majorLevelTolerance)
if bearAsiaH
    majorBearInvalidation := f_max_valid(majorBearInvalidation, asiaHigh + majorLevelTolerance)
if bearAsiaL
    majorBearInvalidation := f_max_valid(majorBearInvalidation, asiaLow + majorLevelTolerance)
if bearLondonH
    majorBearInvalidation := f_max_valid(majorBearInvalidation, londonHigh + majorLevelTolerance)
if bearLondonL
    majorBearInvalidation := f_max_valid(majorBearInvalidation, londonLow + majorLevelTolerance)
if bearNYH
    majorBearInvalidation := f_max_valid(majorBearInvalidation, newYorkHigh + majorLevelTolerance)
if bearNYL
    majorBearInvalidation := f_max_valid(majorBearInvalidation, newYorkLow + majorLevelTolerance)
if bearONH
    majorBearInvalidation := f_max_valid(majorBearInvalidation, overnightHigh + majorLevelTolerance)
if bearONL
    majorBearInvalidation := f_max_valid(majorBearInvalidation, overnightLow + majorLevelTolerance)

// ───── C. Volume Profile edges as auction location. POC remains context only.
float nyProfileAgeMinutes = not na(nyProfileStartTime) ? math.max(0.0, (time - nyProfileStartTime) / 60000.0) : 0.0
bool nyProfileMatureForLocation = nyVPEnabled and nyProfileAgeMinutes >= nyProfileLocationMinMinutes

bool bullONVAH = profileEdgesCanDefineLocation and overnightVPEnabled and f_bull_at_level(overnightVAH, profileTolerance)
bool bearONVAH = profileEdgesCanDefineLocation and overnightVPEnabled and f_bear_at_level(overnightVAH, profileTolerance)
bool bullONVAL = profileEdgesCanDefineLocation and overnightVPEnabled and f_bull_at_level(overnightVAL, profileTolerance)
bool bearONVAL = profileEdgesCanDefineLocation and overnightVPEnabled and f_bear_at_level(overnightVAL, profileTolerance)
bool bullNYVAH = profileEdgesCanDefineLocation and nyProfileMatureForLocation and f_bull_at_level(nyVAH, profileTolerance)
bool bearNYVAH = profileEdgesCanDefineLocation and nyProfileMatureForLocation and f_bear_at_level(nyVAH, profileTolerance)
bool bullNYVAL = profileEdgesCanDefineLocation and nyProfileMatureForLocation and f_bull_at_level(nyVAL, profileTolerance)
bool bearNYVAL = profileEdgesCanDefineLocation and nyProfileMatureForLocation and f_bear_at_level(nyVAL, profileTolerance)

bool profileEdgeBullReaction = bullONVAH or bullONVAL or bullNYVAH or bullNYVAL
bool profileEdgeBearReaction = bearONVAH or bearONVAL or bearNYVAH or bearNYVAL

string profileBullLocationText = ""
profileBullLocationText := f_append_tag(profileBullLocationText, bullONVAH, "ON VAH")
profileBullLocationText := f_append_tag(profileBullLocationText, bullONVAL, "ON VAL")
profileBullLocationText := f_append_tag(profileBullLocationText, bullNYVAH, "NY VAH")
profileBullLocationText := f_append_tag(profileBullLocationText, bullNYVAL, "NY VAL")

string profileBearLocationText = ""
profileBearLocationText := f_append_tag(profileBearLocationText, bearONVAH, "ON VAH")
profileBearLocationText := f_append_tag(profileBearLocationText, bearONVAL, "ON VAL")
profileBearLocationText := f_append_tag(profileBearLocationText, bearNYVAH, "NY VAH")
profileBearLocationText := f_append_tag(profileBearLocationText, bearNYVAL, "NY VAL")

float profileBullInvalidation = na
float profileBearInvalidation = na
if bullONVAH
    profileBullInvalidation := f_min_valid(profileBullInvalidation, overnightVAH - profileTolerance)
if bullONVAL
    profileBullInvalidation := f_min_valid(profileBullInvalidation, overnightVAL - profileTolerance)
if bullNYVAH
    profileBullInvalidation := f_min_valid(profileBullInvalidation, nyVAH - profileTolerance)
if bullNYVAL
    profileBullInvalidation := f_min_valid(profileBullInvalidation, nyVAL - profileTolerance)
if bearONVAH
    profileBearInvalidation := f_max_valid(profileBearInvalidation, overnightVAH + profileTolerance)
if bearONVAL
    profileBearInvalidation := f_max_valid(profileBearInvalidation, overnightVAL + profileTolerance)
if bearNYVAH
    profileBearInvalidation := f_max_valid(profileBearInvalidation, nyVAH + profileTolerance)
if bearNYVAL
    profileBearInvalidation := f_max_valid(profileBearInvalidation, nyVAL + profileTolerance)

// ───── D. Final meaningful-location reaction
bool meaningfulBullReaction = htfBullReaction or majorLevelBullReaction or profileEdgeBullReaction
bool meaningfulBearReaction = htfBearReaction or majorLevelBearReaction or profileEdgeBearReaction

bool bullishLocationReaction = requireMeaningfulLocation ? meaningfulBullReaction :
     meaningfulBullReaction or chartSupportReactionRaw
bool bearishLocationReaction = requireMeaningfulLocation ? meaningfulBearReaction :
     meaningfulBearReaction or chartResistanceReactionRaw

string bullLocationText = ""
bullLocationText := f_append_tag(bullLocationText, htfBullReaction, str.length(supportLocationText) > 0 ? supportLocationText : "HTF S/R")
bullLocationText := f_append_tag(bullLocationText, majorLevelBullReaction, str.length(majorBullLocationText) > 0 ? majorBullLocationText : "KEY LEVEL")
bullLocationText := f_append_tag(bullLocationText, profileEdgeBullReaction, str.length(profileBullLocationText) > 0 ? profileBullLocationText : "VP EDGE")
if not requireMeaningfulLocation and chartSupportReactionRaw and str.length(bullLocationText) == 0
    bullLocationText := executionTFLabel + " SUPPORT"

string bearLocationText = ""
bearLocationText := f_append_tag(bearLocationText, htfBearReaction, str.length(resistanceLocationText) > 0 ? resistanceLocationText : "HTF S/R")
bearLocationText := f_append_tag(bearLocationText, majorLevelBearReaction, str.length(majorBearLocationText) > 0 ? majorBearLocationText : "KEY LEVEL")
bearLocationText := f_append_tag(bearLocationText, profileEdgeBearReaction, str.length(profileBearLocationText) > 0 ? profileBearLocationText : "VP EDGE")
if not requireMeaningfulLocation and chartResistanceReactionRaw and str.length(bearLocationText) == 0
    bearLocationText := executionTFLabel + " RESISTANCE"

float bullLocationInvalidation = f_min_valid(supportInvalidation, majorBullInvalidation)
bullLocationInvalidation := f_min_valid(bullLocationInvalidation, profileBullInvalidation)
float bearLocationInvalidation = f_max_valid(resistanceInvalidation, majorBearInvalidation)
bearLocationInvalidation := f_max_valid(bearLocationInvalidation, profileBearInvalidation)

// ───── E. Confirmed chart-timeframe market structure
// EZ$ now prefers the active opposing Liquidity Swing Area as the structure level.
// If no active swing area is available, the prior pivot logic remains as a fallback.
float structurePivotHigh = ta.pivothigh(high, structurePivotStrength, structurePivotStrength)
float structurePivotLow = ta.pivotlow(low, structurePivotStrength, structurePivotStrength)
var float lastStructureHigh = na
var float lastStructureLow = na

if not na(structurePivotHigh)
    lastStructureHigh := structurePivotHigh
if not na(structurePivotLow)
    lastStructureLow := structurePivotLow

var int pendingDirection = 0
var int pendingReactionBar = na
var float pendingBreakLevel = na
var float pendingInvalidation = na
var string pendingLocation = ""
var string pendingProfile = ""
var bool pendingBreakUsesSwing = false
var string pendingLiquidityContext = ""
var bool pendingPrecisionEntryTaken = false

var int confirmedStructureDirection = 0
var int confirmedShiftBar = na
var float confirmedInvalidation = na
var string confirmedLocation = ""
var string confirmedProfile = ""
var string confirmedLiquidityContext = ""
var bool confirmedPrecisionEntryTaken = false
var int lastLongEntryBar = na
var int lastShortEntryBar = na

// Active chart-TF S/R trade thesis. The stored outer edge is the invalidation line.
// If a forming swing later becomes the official chart-TF S/R box, its confirmed
// box edges replace the provisional geometry without changing the trade direction.
var int activeOriginDirection = 0
var float activeOriginTop = na
var float activeOriginBottom = na
var int activeOriginTime = na
var bool activeOriginValidated = false

// Entry-label lifecycle registry. Each displayed signal remembers the chart-TF S/R
// structure that justified it so the label can retire with that structure.
var array<label> lifecycleSignalLabels = array.new<label>()
var array<int> lifecycleSignalDirections = array.new_int()
var array<float> lifecycleSignalInvalidations = array.new_float()
var array<int> lifecycleSignalSourceTimes = array.new_int()
var array<int> lifecycleSignalSourceBars = array.new_int()
var array<bool> lifecycleSignalValidated = array.new_bool()

// Confirmed chart-TF structural bias: whichever CURRENT-chart Support/Resistance origin is newer.
// This automatically becomes 1M bias on a 1M chart, 5M bias on 5M, etc.
int confirmedChartTFBias = not na(chartSupTime) and (na(chartResTime) or chartSupTime > chartResTime) ? 1 :
     not na(chartResTime) and (na(chartSupTime) or chartResTime > chartSupTime) ? -1 : 0
bool confirmedChartBiasLongOK = not useChartTFBiasForSignals or confirmedChartTFBias == 1
bool confirmedChartBiasShortOK = not useChartTFBiasForSignals or confirmedChartTFBias == -1

bool priceActionConfirmed = not confirmOnClose or barstate.isconfirmed
// Chart-TF S/R execution can be live intrabar without weakening the close-confirmed
// invalidation / MSS logic. Intrabar signals are provisional and may disappear before close.
bool chartSREntryTimingOK = chartSREntryTiming == "Live + Close" or priceActionConfirmed
string currentProfileConfluence = f_profile_confluence_text()

bool twoSidedLocationReaction = bullishLocationReaction and bearishLocationReaction
if showEntryEngine and priceActionConfirmed and not twoSidedLocationReaction
    if bullishLocationReaction
        bool newBullContext = pendingDirection != 1
        pendingDirection := 1
        pendingReactionBar := bar_index
        if newBullContext
            pendingPrecisionEntryTaken := false
        bool swingBreakAvailable = useSwingAreasForMS and not na(activeSwingHighTop)
        pendingBreakLevel := swingBreakAvailable ? activeSwingHighTop :
             not na(lastStructureHigh) ? lastStructureHigh : ta.highest(high[1], math.max(structurePivotStrength + 1, microLength))
        pendingBreakUsesSwing := swingBreakAvailable
        pendingInvalidation := bullLocationInvalidation
        pendingLocation := str.length(bullLocationText) > 0 ? bullLocationText : executionTFLabel
        pendingProfile := str.length(currentProfileConfluence) > 0 and not str.contains(pendingLocation, currentProfileConfluence) ? currentProfileConfluence : ""
        pendingLiquidityContext := currentLatestLowSweep or swingLowSweepNow ? "SWEEP L" : ""
    else if bearishLocationReaction
        bool newBearContext = pendingDirection != -1
        pendingDirection := -1
        pendingReactionBar := bar_index
        if newBearContext
            pendingPrecisionEntryTaken := false
        bool swingBreakAvailable = useSwingAreasForMS and not na(activeSwingLowBottom)
        pendingBreakLevel := swingBreakAvailable ? activeSwingLowBottom :
             not na(lastStructureLow) ? lastStructureLow : ta.lowest(low[1], math.max(structurePivotStrength + 1, microLength))
        pendingBreakUsesSwing := swingBreakAvailable
        pendingInvalidation := bearLocationInvalidation
        pendingLocation := str.length(bearLocationText) > 0 ? bearLocationText : executionTFLabel
        pendingProfile := str.length(currentProfileConfluence) > 0 and not str.contains(pendingLocation, currentProfileConfluence) ? currentProfileConfluence : ""
        pendingLiquidityContext := currentLatestHighSweep or swingHighSweepNow ? "SWEEP H" : ""

bool pendingExpired = pendingDirection != 0 and not na(pendingReactionBar) and bar_index - pendingReactionBar > structureConfirmWindow
bool pendingBullFailed = pendingDirection == 1 and not na(pendingInvalidation) and close < pendingInvalidation
bool pendingBearFailed = pendingDirection == -1 and not na(pendingInvalidation) and close > pendingInvalidation

if pendingExpired or pendingBullFailed or pendingBearFailed
    pendingDirection := 0
    pendingReactionBar := na
    pendingBreakLevel := na
    pendingInvalidation := na
    pendingLocation := ""
    pendingProfile := ""
    pendingBreakUsesSwing := false
    pendingLiquidityContext := ""
    pendingPrecisionEntryTaken := false

// ───── Primary chart-TF S/R-backed swing entry
// This is the confirmed-S/R fallback path. The signal fires on the SAME bar the
// chart-TF S/R box and its matching SWING L/H become confirmed. HTF/VP context is
// optional by default and acts as confluence rather than a hard gate. No additional swing confirmation exists.
bool srSwingLongCooldownOK = na(lastLongEntryBar) or bar_index - lastLongEntryBar >= entryCooldownBars
bool srSwingShortCooldownOK = na(lastShortEntryBar) or bar_index - lastShortEntryBar >= entryCooldownBars

bool chartSRBullContextOK = not requireContextForChartSREntry or pendingDirection == 1 or bullishLocationReaction
bool chartSRBearContextOK = not requireContextForChartSREntry or pendingDirection == -1 or bearishLocationReaction
// Distinct chart-TF S/R structures may signal even while an older same-direction thesis is still valid.
// With the default opposite-entry permission, a new resistance can also supersede an active LONG, and vice versa.
bool chartSRLongDirectionOK = allowOppositeChartSREntry or activeOriginDirection != -1
bool chartSRShortDirectionOK = allowOppositeChartSREntry or activeOriginDirection != 1

bool exactLiveLongAlreadyExists = activeOriginDirection == 1 and not na(activeOriginTime) and not na(chartSupTime) and activeOriginTime == chartSupTime
bool exactLiveShortAlreadyExists = activeOriginDirection == -1 and not na(activeOriginTime) and not na(chartResTime) and activeOriginTime == chartResTime

bool longSRSwingEntrySignal = showEntryLabels and signalOnSRSwingConfirm and chartSRLongDirectionOK and
     confirmedChartBiasLongOK and chartSRBullContextOK and newChartSupportNow and not exactLiveLongAlreadyExists and
     not na(chartSupTop) and not na(chartSupBottom) and close > chartSupTop and srSwingLongCooldownOK
bool shortSRSwingEntrySignal = showEntryLabels and signalOnSRSwingConfirm and chartSRShortDirectionOK and
     confirmedChartBiasShortOK and chartSRBearContextOK and newChartResistanceNow and not exactLiveShortAlreadyExists and
     not na(chartResTop) and not na(chartResBottom) and close < chartResBottom and srSwingShortCooldownOK

if longSRSwingEntrySignal
    pendingDirection := 1
    pendingReactionBar := bar_index
    pendingBreakUsesSwing := useSwingAreasForMS and not na(activeSwingHighTop)
    pendingBreakLevel := pendingBreakUsesSwing ? activeSwingHighTop : not na(lastStructureHigh) ? lastStructureHigh : ta.highest(high[1], math.max(structurePivotStrength + 1, microLength))
    pendingInvalidation := chartSupBottom
    pendingLocation := executionTFLabel + " SUPPORT"
    pendingProfile := currentProfileConfluence
    pendingLiquidityContext := currentLatestLowSweep or swingLowSweepNow ? "SWEEP L" : ""
    pendingPrecisionEntryTaken := true
    activeOriginDirection := 1
    activeOriginTop := chartSupTop
    activeOriginBottom := chartSupBottom
    activeOriginTime := chartSupTime
    activeOriginValidated := true
    string srSwingText = "BUY • " + executionTFLabel + " SWING L"
    if showHigherTFContextOnSignal and str.length(supportLocationText) > 0
        srSwingText += " • " + supportLocationText
    label srLongLabel = label.new(bar_index, low, srSwingText, yloc=yloc.belowbar,
         style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.small)
    array.push(lifecycleSignalLabels, srLongLabel)
    array.push(lifecycleSignalDirections, 1)
    array.push(lifecycleSignalInvalidations, chartSupBottom)
    array.push(lifecycleSignalSourceTimes, chartSupTime)
    array.push(lifecycleSignalSourceBars, bar_index)
    array.push(lifecycleSignalValidated, true)
    lastLongEntryBar := bar_index

if shortSRSwingEntrySignal
    pendingDirection := -1
    pendingReactionBar := bar_index
    pendingBreakUsesSwing := useSwingAreasForMS and not na(activeSwingLowBottom)
    pendingBreakLevel := pendingBreakUsesSwing ? activeSwingLowBottom : not na(lastStructureLow) ? lastStructureLow : ta.lowest(low[1], math.max(structurePivotStrength + 1, microLength))
    pendingInvalidation := chartResTop
    pendingLocation := executionTFLabel + " RESISTANCE"
    pendingProfile := currentProfileConfluence
    pendingLiquidityContext := currentLatestHighSweep or swingHighSweepNow ? "SWEEP H" : ""
    pendingPrecisionEntryTaken := true
    activeOriginDirection := -1
    activeOriginTop := chartResTop
    activeOriginBottom := chartResBottom
    activeOriginTime := chartResTime
    activeOriginValidated := true
    string srSwingText = "SELL • " + executionTFLabel + " SWING H"
    if showHigherTFContextOnSignal and str.length(resistanceLocationText) > 0
        srSwingText += " • " + resistanceLocationText
    label srShortLabel = label.new(bar_index, high, srSwingText, yloc=yloc.abovebar,
         style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.small)
    array.push(lifecycleSignalLabels, srShortLabel)
    array.push(lifecycleSignalDirections, -1)
    array.push(lifecycleSignalInvalidations, chartResTop)
    array.push(lifecycleSignalSourceTimes, chartResTime)
    array.push(lifecycleSignalSourceBars, bar_index)
    array.push(lifecycleSignalValidated, true)
    lastShortEntryBar := bar_index

// ───── Dynamic FORMING chart-TF S/R swing
// This is the live precursor to the SAME chart-TF pivot process that later draws
// the official Support/Resistance box. It is deliberately NOT a second pivot engine.
// We track the most recent local extreme inside the configured S/R pivot window and
// give it the same wick/body + ATR geometry the confirmed S/R engine would use.
//
// Lifecycle:
//   meaningful context arms direction -> live extreme becomes FORMING SWING L/H
//   -> rejection/reclaim away from that geometry may print the first entry
//   -> exact origin later confirms -> forming visual is replaced by confirmed S/R swing
//   -> close through outer edge -> thesis invalid / EXIT
//
// Nothing is backpainted. The forming box is created only when that information exists live.
float srOriginATR = ta.atr(srATRLength)
bool freshOriginLowEvent = low <= ta.lowest(low, srPivotStrength + 1)
bool freshOriginHighEvent = high >= ta.highest(high, srPivotStrength + 1)

float recentOriginLow = ta.valuewhen(freshOriginLowEvent, low, 0)
float recentOriginLowBody = ta.valuewhen(freshOriginLowEvent, math.min(open, close), 0)
float recentOriginLowATR = ta.valuewhen(freshOriginLowEvent, srOriginATR, 0)
int recentOriginLowTime = int(ta.valuewhen(freshOriginLowEvent, time, 0))
int recentOriginLowBar = int(ta.valuewhen(freshOriginLowEvent, bar_index, 0))
int barsSinceOriginLow = ta.barssince(freshOriginLowEvent)

float recentOriginHigh = ta.valuewhen(freshOriginHighEvent, high, 0)
float recentOriginHighBody = ta.valuewhen(freshOriginHighEvent, math.max(open, close), 0)
float recentOriginHighATR = ta.valuewhen(freshOriginHighEvent, srOriginATR, 0)
int recentOriginHighTime = int(ta.valuewhen(freshOriginHighEvent, time, 0))
int recentOriginHighBar = int(ta.valuewhen(freshOriginHighEvent, bar_index, 0))
int barsSinceOriginHigh = ta.barssince(freshOriginHighEvent)

float recentOriginSupportBottom = recentOriginLow
float recentOriginSupportTop = not na(recentOriginLow) and not na(recentOriginLowBody) and not na(recentOriginLowATR) ?
     math.max(recentOriginLowBody, recentOriginLow + recentOriginLowATR * srMinimumPaddingATR) : na
float recentOriginResistanceTop = recentOriginHigh
float recentOriginResistanceBottom = not na(recentOriginHigh) and not na(recentOriginHighBody) and not na(recentOriginHighATR) ?
     math.min(recentOriginHighBody, recentOriginHigh - recentOriginHighATR * srMinimumPaddingATR) : na

var int formingSwingDirection = 0
var float formingSwingTop = na
var float formingSwingBottom = na
var int formingSwingTime = na
var int formingSwingBar = na
var bool formingSwingSignalTaken = false
var box formingSwingBox = na

color formingLowFill = color.new(color.teal, formingSwingTransparency)
color formingHighFill = color.new(color.red, formingSwingTransparency)
color formingLowBorder = color.new(color.teal, 62)
color formingHighBorder = color.new(color.red, 62)

// Seed or update the candidate from the most recent live chart-TF local extreme.
// Optional HTF/VP context can filter it, but by default the chart-TF S/R process is the execution authority.
// A newer extreme simply moves the live candidate before confirmation; no historical signal is moved.
bool eligibleRecentLow = chartSRBullContextOK and not na(barsSinceOriginLow) and barsSinceOriginLow <= srPivotStrength and
     not na(recentOriginSupportTop) and not na(recentOriginSupportBottom) and not na(recentOriginLowTime) and not na(recentOriginLowBar)
bool eligibleRecentHigh = chartSRBearContextOK and not na(barsSinceOriginHigh) and barsSinceOriginHigh <= srPivotStrength and
     not na(recentOriginResistanceTop) and not na(recentOriginResistanceBottom) and not na(recentOriginHighTime) and not na(recentOriginHighBar)

bool newFormingLowOrigin = eligibleRecentLow and (formingSwingDirection != 1 or formingSwingTime != recentOriginLowTime)
bool newFormingHighOrigin = eligibleRecentHigh and (formingSwingDirection != -1 or formingSwingTime != recentOriginHighTime)
bool formingSwingEngineEnabled = showFormingSRSwing or signalOnFormingSRSwing

bool twoSidedNewOrigin = newFormingLowOrigin and newFormingHighOrigin

if formingSwingEngineEnabled and newFormingLowOrigin and not twoSidedNewOrigin and chartSRLongDirectionOK and not formingSwingSignalTaken
    formingSwingDirection := 1
    formingSwingBottom := recentOriginSupportBottom
    formingSwingTop := recentOriginSupportTop
    formingSwingTime := recentOriginLowTime
    formingSwingBar := recentOriginLowBar

if formingSwingEngineEnabled and newFormingHighOrigin and not twoSidedNewOrigin and chartSRShortDirectionOK and not formingSwingSignalTaken
    formingSwingDirection := -1
    formingSwingTop := recentOriginResistanceTop
    formingSwingBottom := recentOriginResistanceBottom
    formingSwingTime := recentOriginHighTime
    formingSwingBar := recentOriginHighBar

if not na(formingSwingBox)
    box.set_right(formingSwingBox, bar_index + swingAreaExtendBars)

// If context disappears before an entry and before the candidate confirms, retire it.
bool formingContextLost = requireContextForChartSREntry and ((formingSwingDirection == 1 and pendingDirection != 1) or
     (formingSwingDirection == -1 and pendingDirection != -1))
bool formingTooOld = formingSwingDirection != 0 and not formingSwingSignalTaken and not na(formingSwingBar) and
     bar_index - formingSwingBar > srPivotStrength + 1
if (formingContextLost or formingTooOld) and not formingSwingSignalTaken
    if not na(formingSwingBox)
        box.delete(formingSwingBox)
    formingSwingBox := na
    formingSwingDirection := 0
    formingSwingTop := na
    formingSwingBottom := na
    formingSwingTime := na
    formingSwingBar := na
    formingSwingSignalTaken := false

// First-entry permission from the forming structure. The candidate does not need a future
// pivot confirmation, but it DOES need live directional price action away from its S/R geometry.
// HTF/VP context is optional by default. This is the fast 1M/5M behavior requested for replay/live use.
bool originLongCooldownOK = na(lastLongEntryBar) or bar_index - lastLongEntryBar >= entryCooldownBars
bool originShortCooldownOK = na(lastShortEntryBar) or bar_index - lastShortEntryBar >= entryCooldownBars

// Forming chart structure temporarily owns chart bias before the normal pivot confirms.
// This lets the bias flip with the same live Support/Resistance process that creates the signal.
int liveChartTFBias = formingSwingDirection != 0 ? formingSwingDirection : confirmedChartTFBias
bool liveChartBiasLongOK = not useChartTFBiasForSignals or liveChartTFBias == 1
bool liveChartBiasShortOK = not useChartTFBiasForSignals or liveChartTFBias == -1

bool instantLongSwingFresh = formingSwingDirection == 1 and not na(formingSwingBar) and bar_index - formingSwingBar <= instantSwingMaxBars
bool instantShortSwingFresh = formingSwingDirection == -1 and not na(formingSwingBar) and bar_index - formingSwingBar <= instantSwingMaxBars

bool longSROriginEntrySignal = showEntryLabels and allowSROriginEntry and chartSRLongDirectionOK and liveChartBiasLongOK and
     chartSRBullContextOK and instantLongSwingFresh and not formingSwingSignalTaken and
     chartSREntryTimingOK and bullReactionCandle and not na(formingSwingTop) and
     close > formingSwingTop and originLongCooldownOK

bool shortSROriginEntrySignal = showEntryLabels and allowSROriginEntry and chartSRShortDirectionOK and liveChartBiasShortOK and
     chartSRBearContextOK and instantShortSwingFresh and not formingSwingSignalTaken and
     chartSREntryTimingOK and bearReactionCandle and not na(formingSwingBottom) and
     close < formingSwingBottom and originShortCooldownOK

if longSROriginEntrySignal
    if not na(formingSwingBox)
        box.delete(formingSwingBox)
    float liveSwingVisualTop = swingAreaStyle == "Wick Zone" ? math.min(formingSwingTop, recentOriginLowBody) : formingSwingTop
    formingSwingBox := showFormingSRSwing ? box.new(left=formingSwingBar, top=liveSwingVisualTop, right=bar_index + swingAreaExtendBars,
         bottom=formingSwingBottom, xloc=xloc.bar_index, extend=extend.none,
         bgcolor=formingLowFill, border_color=formingLowBorder, border_width=1, border_style=line.style_dashed,
         text=showSwingAreaLabels ? "SWING L" : "", text_color=color.new(color.teal, 10), text_size=size.tiny,
         text_halign=text.align_right, text_valign=text.align_center) : na
    pendingDirection := 1
    pendingReactionBar := bar_index
    pendingBreakUsesSwing := useSwingAreasForMS and not na(activeSwingHighTop)
    pendingBreakLevel := pendingBreakUsesSwing ? activeSwingHighTop : not na(lastStructureHigh) ? lastStructureHigh : ta.highest(high[1], math.max(structurePivotStrength + 1, microLength))
    pendingInvalidation := formingSwingBottom
    pendingLocation := executionTFLabel + " SUPPORT"
    pendingProfile := currentProfileConfluence
    pendingLiquidityContext := currentLatestLowSweep or swingLowSweepNow ? "SWEEP L" : ""
    pendingPrecisionEntryTaken := true
    formingSwingSignalTaken := true
    activeOriginDirection := 1
    activeOriginTop := formingSwingTop
    activeOriginBottom := formingSwingBottom
    activeOriginTime := formingSwingTime
    activeOriginValidated := false

    string originText = (barstate.isconfirmed ? "BUY" : "LIVE BUY") + " • " + executionTFLabel + " SWING L"
    if showHigherTFContextOnSignal and str.length(supportLocationText) > 0
        originText += " • " + supportLocationText
    label formingLongLabel = label.new(bar_index, low, originText, yloc=yloc.belowbar,
         style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.small)
    array.push(lifecycleSignalLabels, formingLongLabel)
    array.push(lifecycleSignalDirections, 1)
    array.push(lifecycleSignalInvalidations, formingSwingBottom)
    array.push(lifecycleSignalSourceTimes, formingSwingTime)
    array.push(lifecycleSignalSourceBars, formingSwingBar)
    array.push(lifecycleSignalValidated, false)
    lastLongEntryBar := bar_index

if shortSROriginEntrySignal
    if not na(formingSwingBox)
        box.delete(formingSwingBox)
    float liveSwingVisualBottom = swingAreaStyle == "Wick Zone" ? math.max(formingSwingBottom, recentOriginHighBody) : formingSwingBottom
    formingSwingBox := showFormingSRSwing ? box.new(left=formingSwingBar, top=formingSwingTop, right=bar_index + swingAreaExtendBars,
         bottom=liveSwingVisualBottom, xloc=xloc.bar_index, extend=extend.none,
         bgcolor=formingHighFill, border_color=formingHighBorder, border_width=1, border_style=line.style_dashed,
         text=showSwingAreaLabels ? "SWING H" : "", text_color=color.new(color.red, 10), text_size=size.tiny,
         text_halign=text.align_right, text_valign=text.align_center) : na
    pendingDirection := -1
    pendingReactionBar := bar_index
    pendingBreakUsesSwing := useSwingAreasForMS and not na(activeSwingLowBottom)
    pendingBreakLevel := pendingBreakUsesSwing ? activeSwingLowBottom : not na(lastStructureLow) ? lastStructureLow : ta.lowest(low[1], math.max(structurePivotStrength + 1, microLength))
    pendingInvalidation := formingSwingTop
    pendingLocation := executionTFLabel + " RESISTANCE"
    pendingProfile := currentProfileConfluence
    pendingLiquidityContext := currentLatestHighSweep or swingHighSweepNow ? "SWEEP H" : ""
    pendingPrecisionEntryTaken := true
    formingSwingSignalTaken := true
    activeOriginDirection := -1
    activeOriginTop := formingSwingTop
    activeOriginBottom := formingSwingBottom
    activeOriginTime := formingSwingTime
    activeOriginValidated := false

    string originText = (barstate.isconfirmed ? "SELL" : "LIVE SELL") + " • " + executionTFLabel + " SWING H"
    if showHigherTFContextOnSignal and str.length(resistanceLocationText) > 0
        originText += " • " + resistanceLocationText
    label formingShortLabel = label.new(bar_index, high, originText, yloc=yloc.abovebar,
         style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.small)
    array.push(lifecycleSignalLabels, formingShortLabel)
    array.push(lifecycleSignalDirections, -1)
    array.push(lifecycleSignalInvalidations, formingSwingTop)
    array.push(lifecycleSignalSourceTimes, formingSwingTime)
    array.push(lifecycleSignalSourceBars, formingSwingBar)
    array.push(lifecycleSignalValidated, false)
    lastShortEntryBar := bar_index

// Exact candidate -> confirmed chart-TF S/R handoff. The normal confirmed swing visual
// replaces the dashed FORMING visual because both represent the same source-timeframe structure.
bool formingLowConfirmedNow = formingSwingDirection == 1 and not na(chartSupTime) and chartSupTime == formingSwingTime
bool formingHighConfirmedNow = formingSwingDirection == -1 and not na(chartResTime) and chartResTime == formingSwingTime

if formingLowConfirmedNow
    if activeOriginDirection == 1 and not activeOriginValidated and activeOriginTime == formingSwingTime
        activeOriginTop := chartSupTop
        activeOriginBottom := chartSupBottom
        activeOriginValidated := true
    if not na(formingSwingBox)
        box.delete(formingSwingBox)
    formingSwingBox := na
    formingSwingDirection := 0
    formingSwingTop := na
    formingSwingBottom := na
    formingSwingTime := na
    formingSwingBar := na
    formingSwingSignalTaken := false

if formingHighConfirmedNow
    if activeOriginDirection == -1 and not activeOriginValidated and activeOriginTime == formingSwingTime
        activeOriginTop := chartResTop
        activeOriginBottom := chartResBottom
        activeOriginValidated := true
    if not na(formingSwingBox)
        box.delete(formingSwingBox)
    formingSwingBox := na
    formingSwingDirection := 0
    formingSwingTop := na
    formingSwingBottom := na
    formingSwingTime := na
    formingSwingBar := na
    formingSwingSignalTaken := false

// A live Swing signal is provisional until the exact chart-TF S/R pivot validates it.
// If that never happens in the normal pivot window, retire the provisional swing/thesis.
bool formingSignalValidationExpired = formingSwingSignalTaken and not activeOriginValidated and not na(formingSwingBar) and
     bar_index - formingSwingBar > srPivotStrength + 2
if formingSignalValidationExpired
    if not na(formingSwingBox)
        box.delete(formingSwingBox)
    if activeOriginTime == formingSwingTime
        activeOriginDirection := 0
        activeOriginTop := na
        activeOriginBottom := na
        activeOriginTime := na
        activeOriginValidated := false
    formingSwingBox := na
    formingSwingDirection := 0
    formingSwingTop := na
    formingSwingBottom := na
    formingSwingTime := na
    formingSwingBar := na
    formingSwingSignalTaken := false

// Backstop validation in case the forming visual was disabled but the early signal was enabled.
if activeOriginDirection == 1 and not activeOriginValidated and not na(chartSupTime) and chartSupTime == activeOriginTime
    activeOriginTop := chartSupTop
    activeOriginBottom := chartSupBottom
    activeOriginValidated := true

if activeOriginDirection == -1 and not activeOriginValidated and not na(chartResTime) and chartResTime == activeOriginTime
    activeOriginTop := chartResTop
    activeOriginBottom := chartResBottom
    activeOriginValidated := true

// Exit / invalidation mirrors Structural S/R exactly:
// support fails on a confirmed close below its outer low; resistance fails above its outer high.
bool longOriginInvalidated = priceActionConfirmed and activeOriginDirection == 1 and
     not na(activeOriginBottom) and close < activeOriginBottom
bool shortOriginInvalidated = priceActionConfirmed and activeOriginDirection == -1 and
     not na(activeOriginTop) and close > activeOriginTop

if longOriginInvalidated
    if showOriginInvalidationLabels
        label.new(bar_index, low, "EXIT • SUPPORT INVALIDATED", yloc=yloc.belowbar,
             style=label.style_label_up, color=color.new(color.gray, 10), textcolor=color.white, size=size.small)
    if not na(formingSwingBox)
        box.delete(formingSwingBox)
    formingSwingBox := na
    formingSwingDirection := 0
    formingSwingTop := na
    formingSwingBottom := na
    formingSwingTime := na
    formingSwingBar := na
    formingSwingSignalTaken := false
    activeOriginDirection := 0
    activeOriginTop := na
    activeOriginBottom := na
    activeOriginTime := na
    activeOriginValidated := false
    pendingDirection := 0
    pendingReactionBar := na
    pendingBreakLevel := na
    pendingInvalidation := na
    pendingLocation := ""
    pendingProfile := ""
    pendingBreakUsesSwing := false
    pendingLiquidityContext := ""
    pendingPrecisionEntryTaken := false
    confirmedStructureDirection := 0
    confirmedShiftBar := na
    confirmedInvalidation := na
    confirmedLocation := ""
    confirmedProfile := ""
    confirmedLiquidityContext := ""
    confirmedPrecisionEntryTaken := false

if shortOriginInvalidated
    if showOriginInvalidationLabels
        label.new(bar_index, high, "EXIT • RESISTANCE INVALIDATED", yloc=yloc.abovebar,
             style=label.style_label_down, color=color.new(color.gray, 10), textcolor=color.white, size=size.small)
    if not na(formingSwingBox)
        box.delete(formingSwingBox)
    formingSwingBox := na
    formingSwingDirection := 0
    formingSwingTop := na
    formingSwingBottom := na
    formingSwingTime := na
    formingSwingBar := na
    formingSwingSignalTaken := false
    activeOriginDirection := 0
    activeOriginTop := na
    activeOriginBottom := na
    activeOriginTime := na
    activeOriginValidated := false
    pendingDirection := 0
    pendingReactionBar := na
    pendingBreakLevel := na
    pendingInvalidation := na
    pendingLocation := ""
    pendingProfile := ""
    pendingBreakUsesSwing := false
    pendingLiquidityContext := ""
    pendingPrecisionEntryTaken := false
    confirmedStructureDirection := 0
    confirmedShiftBar := na
    confirmedInvalidation := na
    confirmedLocation := ""
    confirmedProfile := ""
    confirmedLiquidityContext := ""
    confirmedPrecisionEntryTaken := false

// ───── Legacy separate swing-defense entry retired
// Execution now uses forming/confirmed chart-TF S/R swings above; no separate liquidity-pivot signal path remains.
bool longSwingPrecisionEntrySignal = false
bool shortSwingPrecisionEntrySignal = false

bool bullishStructureShift = showEntryEngine and priceActionConfirmed and pendingDirection == 1 and
     not na(pendingBreakLevel) and close > pendingBreakLevel and
     (not requireExpansionOnShift or bullDisplacement or bullMicroShift)
bool bearishStructureShift = showEntryEngine and priceActionConfirmed and pendingDirection == -1 and
     not na(pendingBreakLevel) and close < pendingBreakLevel and
     (not requireExpansionOnShift or bearDisplacement or bearMicroShift)

if bullishStructureShift
    confirmedStructureDirection := 1
    confirmedShiftBar := bar_index
    confirmedInvalidation := pendingInvalidation
    confirmedLocation := pendingLocation
    confirmedProfile := str.length(currentProfileConfluence) > 0 and not str.contains(confirmedLocation, currentProfileConfluence) ? currentProfileConfluence : pendingProfile
    confirmedLiquidityContext := (str.length(pendingLiquidityContext) > 0 ? pendingLiquidityContext + " • " : "") + (pendingBreakUsesSwing ? "BREAK H" : "BOS")
    confirmedPrecisionEntryTaken := pendingPrecisionEntryTaken

    if showReadyLabels and not signalOnStructureShift
        string readyText = "LONG READY • BULL MSS"
        if str.length(confirmedLiquidityContext) > 0
            readyText += " • " + confirmedLiquidityContext
        readyText += " • " + confirmedLocation
        if str.length(confirmedProfile) > 0
            readyText += " • " + confirmedProfile
        label.new(bar_index, low, readyText, yloc=yloc.belowbar,
             style=label.style_label_up, color=color.new(color.green, 20),
             textcolor=color.white, size=size.small)

    pendingDirection := 0
    pendingReactionBar := na
    pendingBreakLevel := na
    pendingInvalidation := na
    pendingLocation := ""
    pendingProfile := ""
    pendingBreakUsesSwing := false
    pendingLiquidityContext := ""
    pendingPrecisionEntryTaken := false

if bearishStructureShift
    confirmedStructureDirection := -1
    confirmedShiftBar := bar_index
    confirmedInvalidation := pendingInvalidation
    confirmedLocation := pendingLocation
    confirmedProfile := str.length(currentProfileConfluence) > 0 and not str.contains(confirmedLocation, currentProfileConfluence) ? currentProfileConfluence : pendingProfile
    confirmedLiquidityContext := (str.length(pendingLiquidityContext) > 0 ? pendingLiquidityContext + " • " : "") + (pendingBreakUsesSwing ? "BREAK L" : "BOS")
    confirmedPrecisionEntryTaken := pendingPrecisionEntryTaken

    if showReadyLabels and not signalOnStructureShift
        string readyText = "SHORT READY • BEAR MSS"
        if str.length(confirmedLiquidityContext) > 0
            readyText += " • " + confirmedLiquidityContext
        readyText += " • " + confirmedLocation
        if str.length(confirmedProfile) > 0
            readyText += " • " + confirmedProfile
        label.new(bar_index, high, readyText, yloc=yloc.abovebar,
             style=label.style_label_down, color=color.new(color.red, 20),
             textcolor=color.white, size=size.small)

    pendingDirection := 0
    pendingReactionBar := na
    pendingBreakLevel := na
    pendingInvalidation := na
    pendingLocation := ""
    pendingProfile := ""
    pendingBreakUsesSwing := false
    pendingLiquidityContext := ""
    pendingPrecisionEntryTaken := false

bool retestExpired = confirmedStructureDirection != 0 and not na(confirmedShiftBar) and bar_index - confirmedShiftBar > retestWindow
bool confirmedBullFailed = confirmedStructureDirection == 1 and not na(confirmedInvalidation) and close < confirmedInvalidation
bool confirmedBearFailed = confirmedStructureDirection == -1 and not na(confirmedInvalidation) and close > confirmedInvalidation
if retestExpired or confirmedBullFailed or confirmedBearFailed
    confirmedStructureDirection := 0
    confirmedShiftBar := na
    confirmedInvalidation := na
    confirmedLocation := ""
    confirmedProfile := ""
    confirmedLiquidityContext := ""
    confirmedPrecisionEntryTaken := false

// First chart-timeframe S/R defense after the shift is a SECOND-CHANCE entry.
bool longRetest = showEntryEngine and showRetestSecondChance and confirmedStructureDirection == 1 and not na(confirmedShiftBar) and
     bar_index > confirmedShiftBar and chartSupportReactionRaw
bool shortRetest = showEntryEngine and showRetestSecondChance and confirmedStructureDirection == -1 and not na(confirmedShiftBar) and
     bar_index > confirmedShiftBar and chartResistanceReactionRaw

bool longCooldownOK = na(lastLongEntryBar) or bar_index - lastLongEntryBar >= entryCooldownBars
bool shortCooldownOK = na(lastShortEntryBar) or bar_index - lastShortEntryBar >= entryCooldownBars

// v8.9: MSS and retests are context only. BUY/SELL must always have a Swing L/H.
bool longShiftEntrySignal = false
bool shortShiftEntrySignal = false
bool longRetestEntrySignal = false
bool shortRetestEntrySignal = false
bool longConfirmedEntrySignal = false
bool shortConfirmedEntrySignal = false
bool longEntrySignal = longSRSwingEntrySignal or longSROriginEntrySignal
bool shortEntrySignal = shortSRSwingEntrySignal or shortSROriginEntrySignal

if longConfirmedEntrySignal
    string profileText = str.length(currentProfileConfluence) > 0 and not str.contains(confirmedLocation, currentProfileConfluence) ? currentProfileConfluence : confirmedProfile
    string entryText = longShiftEntrySignal ? "LONG • BULL MSS" : "LONG • " + executionTFLabel + " SUPPORT RETEST"
    if longShiftEntrySignal and str.length(confirmedLiquidityContext) > 0
        entryText += " • " + confirmedLiquidityContext
    if str.length(confirmedLocation) > 0
        entryText += " • " + confirmedLocation
    if str.length(profileText) > 0
        entryText += " • " + profileText
    label confirmedLongLabel = label.new(bar_index, low, entryText, yloc=yloc.belowbar,
         style=label.style_label_up, color=color.new(color.green, 0),
         textcolor=color.white, size=size.small)
    int confirmedLongSourceTime = not na(chartSupTime) ? chartSupTime : na
    float confirmedLongEdge = not na(chartSupBottom) ? chartSupBottom : confirmedInvalidation
    array.push(lifecycleSignalLabels, confirmedLongLabel)
    array.push(lifecycleSignalDirections, 1)
    array.push(lifecycleSignalInvalidations, confirmedLongEdge)
    array.push(lifecycleSignalSourceTimes, confirmedLongSourceTime)
    array.push(lifecycleSignalSourceBars, bar_index)
    array.push(lifecycleSignalValidated, not na(confirmedLongSourceTime))
    lastLongEntryBar := bar_index

    if longRetestEntrySignal
        confirmedStructureDirection := 0
        confirmedShiftBar := na
        confirmedInvalidation := na
        confirmedLocation := ""
        confirmedProfile := ""
        confirmedLiquidityContext := ""
        confirmedPrecisionEntryTaken := false

if shortConfirmedEntrySignal
    string profileText = str.length(currentProfileConfluence) > 0 and not str.contains(confirmedLocation, currentProfileConfluence) ? currentProfileConfluence : confirmedProfile
    string entryText = shortShiftEntrySignal ? "SHORT • BEAR MSS" : "SHORT • " + executionTFLabel + " RESISTANCE RETEST"
    if shortShiftEntrySignal and str.length(confirmedLiquidityContext) > 0
        entryText += " • " + confirmedLiquidityContext
    if str.length(confirmedLocation) > 0
        entryText += " • " + confirmedLocation
    if str.length(profileText) > 0
        entryText += " • " + profileText
    label confirmedShortLabel = label.new(bar_index, high, entryText, yloc=yloc.abovebar,
         style=label.style_label_down, color=color.new(color.red, 0),
         textcolor=color.white, size=size.small)
    int confirmedShortSourceTime = not na(chartResTime) ? chartResTime : na
    float confirmedShortEdge = not na(chartResTop) ? chartResTop : confirmedInvalidation
    array.push(lifecycleSignalLabels, confirmedShortLabel)
    array.push(lifecycleSignalDirections, -1)
    array.push(lifecycleSignalInvalidations, confirmedShortEdge)
    array.push(lifecycleSignalSourceTimes, confirmedShortSourceTime)
    array.push(lifecycleSignalSourceBars, bar_index)
    array.push(lifecycleSignalValidated, not na(confirmedShortSourceTime))
    lastShortEntryBar := bar_index

    if shortRetestEntrySignal
        confirmedStructureDirection := 0
        confirmedShiftBar := na
        confirmedInvalidation := na
        confirmedLocation := ""
        confirmedProfile := ""
        confirmedLiquidityContext := ""
        confirmedPrecisionEntryTaken := false

// ───── Signal lifecycle cleanup
// Signals visually live only as long as the SAME chart-TF S/R thesis lives.
// Historical alerts are not undoable, but labels can retire with structure as requested.
if removeInvalidatedSignalLabels and barstate.isconfirmed and array.size(lifecycleSignalLabels) > 0
    int lifecycleIndex = array.size(lifecycleSignalLabels) - 1
    while lifecycleIndex >= 0
        label lifecycleLabel = array.get(lifecycleSignalLabels, lifecycleIndex)
        int lifecycleDirection = array.get(lifecycleSignalDirections, lifecycleIndex)
        float lifecycleEdge = array.get(lifecycleSignalInvalidations, lifecycleIndex)
        int lifecycleSourceTime = array.get(lifecycleSignalSourceTimes, lifecycleIndex)
        int lifecycleSourceBar = array.get(lifecycleSignalSourceBars, lifecycleIndex)
        bool lifecycleValidated = array.get(lifecycleSignalValidated, lifecycleIndex)

        // A forming entry earns confirmed status only if the exact origin becomes the official chart-TF S/R pivot.
        if not lifecycleValidated and not na(lifecycleSourceTime)
            bool exactSupportConfirmed = lifecycleDirection == 1 and not na(chartSupTime) and chartSupTime == lifecycleSourceTime
            bool exactResistanceConfirmed = lifecycleDirection == -1 and not na(chartResTime) and chartResTime == lifecycleSourceTime
            if exactSupportConfirmed
                lifecycleValidated := true
                lifecycleEdge := chartSupBottom
                array.set(lifecycleSignalValidated, lifecycleIndex, true)
                array.set(lifecycleSignalInvalidations, lifecycleIndex, lifecycleEdge)
            else if exactResistanceConfirmed
                lifecycleValidated := true
                lifecycleEdge := chartResTop
                array.set(lifecycleSignalValidated, lifecycleIndex, true)
                array.set(lifecycleSignalInvalidations, lifecycleIndex, lifecycleEdge)

        bool priceInvalidated = lifecycleDirection == 1 ? (not na(lifecycleEdge) and close < lifecycleEdge) :
             lifecycleDirection == -1 ? (not na(lifecycleEdge) and close > lifecycleEdge) : false
        bool confirmedSourceGone = lifecycleValidated and not na(lifecycleSourceTime) and
             ((lifecycleDirection == 1 and (na(chartSupTime) or chartSupTime != lifecycleSourceTime)) or
              (lifecycleDirection == -1 and (na(chartResTime) or chartResTime != lifecycleSourceTime)))
        bool formingNeverValidated = not lifecycleValidated and not na(lifecycleSourceBar) and
             bar_index - lifecycleSourceBar > srPivotStrength + 2

        if priceInvalidated or confirmedSourceGone or formingNeverValidated
            if not na(lifecycleLabel)
                label.delete(lifecycleLabel)
            array.remove(lifecycleSignalLabels, lifecycleIndex)
            array.remove(lifecycleSignalDirections, lifecycleIndex)
            array.remove(lifecycleSignalInvalidations, lifecycleIndex)
            array.remove(lifecycleSignalSourceTimes, lifecycleIndex)
            array.remove(lifecycleSignalSourceBars, lifecycleIndex)
            array.remove(lifecycleSignalValidated, lifecycleIndex)

        lifecycleIndex -= 1

alertcondition(longEntrySignal, "EZ$ BUY Swing Entry", "EZ$ BUY: chart-TF Support/Swing L reaction. No Swing L = no BUY.")
alertcondition(shortEntrySignal, "EZ$ SELL Swing Entry", "EZ$ SELL: chart-TF Resistance/Swing H reaction. No Swing H = no SELL.")
alertcondition(longSRSwingEntrySignal, "EZ$ BUY Confirmed Swing", "EZ$ BUY: newly confirmed chart-TF Support + matching Swing L.")
alertcondition(shortSRSwingEntrySignal, "EZ$ SELL Confirmed Swing", "EZ$ SELL: newly confirmed chart-TF Resistance + matching Swing H.")
alertcondition(longSROriginEntrySignal, "EZ$ LIVE BUY Swing", "EZ$ LIVE BUY: live chart-TF Swing L + bullish S/R rejection/reclaim.")
alertcondition(shortSROriginEntrySignal, "EZ$ LIVE SELL Swing", "EZ$ LIVE SELL: live chart-TF Swing H + bearish S/R rejection/reclaim.")
alertcondition(longOriginInvalidated, "EZ$ LONG Support Invalidated", "EZ$ EXIT: the chart-TF support tied to the active LONG thesis closed below its outer edge.")
alertcondition(shortOriginInvalidated, "EZ$ SHORT Resistance Invalidated", "EZ$ EXIT: the chart-TF resistance tied to the active SHORT thesis closed above its outer edge.")
// MSS/retest remain visual context only in v8.9; no separate BUY/SELL alerts.

// ───── Market-structure visual markers
plotshape(showEntryEngine and showMSSMarkers and bullishStructureShift, title="Bullish Structure Shift",
     style=shape.circle, location=location.belowbar, size=size.tiny, color=color.new(color.green, 40), text="MSS")
plotshape(showEntryEngine and showMSSMarkers and bearishStructureShift, title="Bearish Structure Shift",
     style=shape.circle, location=location.abovebar, size=size.tiny, color=color.new(color.red, 40), text="MSS")



// ───── Session-level freshness updates
bool crossedAsiaHigh = ta.cross(close, asiaHigh)
bool crossedAsiaLow = ta.cross(close, asiaLow)
bool crossedLondonHigh = ta.cross(close, londonHigh)
bool crossedLondonLow = ta.cross(close, londonLow)
bool crossedNewYorkHigh = ta.cross(close, newYorkHigh)
bool crossedNewYorkLow = ta.cross(close, newYorkLow)
bool crossedOvernightHigh = ta.cross(close, overnightHigh)
bool crossedOvernightLow = ta.cross(close, overnightLow)

if not na(asiaHigh) and crossedAsiaHigh
    asiaHighCrosses += 1
if not na(asiaLow) and crossedAsiaLow
    asiaLowCrosses += 1
if not na(londonHigh) and crossedLondonHigh
    londonHighCrosses += 1
if not na(londonLow) and crossedLondonLow
    londonLowCrosses += 1
if not na(newYorkHigh) and crossedNewYorkHigh
    newYorkHighCrosses += 1
if not na(newYorkLow) and crossedNewYorkLow
    newYorkLowCrosses += 1
if not na(overnightHigh) and crossedOvernightHigh
    overnightHighCrosses += 1
if not na(overnightLow) and crossedOvernightLow
    overnightLowCrosses += 1

// ───── Compact S/R + Profile + Price Action dashboard
f_profile_state_text(bool enabled, float vah, float poc, float val) =>
    string result = "NO DATA"
    if enabled and not na(vah) and not na(poc) and not na(val)
        if math.abs(close - poc) <= profileTolerance
            result := "AT POC"
        else if close > vah
            result := "ABOVE VALUE"
        else if close < val
            result := "BELOW VALUE"
        else
            result := "IN VALUE"
    result

f_profile_state_color(string stateText) =>
    stateText == "ABOVE VALUE" ? color.new(color.green, 25) :
     stateText == "BELOW VALUE" ? color.new(color.red, 25) :
     stateText == "AT POC" ? color.new(color.yellow, 40) :
     stateText == "IN VALUE" ? color.new(color.blue, 55) : color.new(color.gray, 60)

bool majorLevelTouch = useMajorKeyLevelsForLocation and (
     (showPreviousDay and (f_level_touched(pdHigh, majorLevelTolerance) or f_level_touched(pdLow, majorLevelTolerance))) or
     (showPreviousWeek and (f_level_touched(pwHigh, majorLevelTolerance) or f_level_touched(pwLow, majorLevelTolerance))) or
     (showPreviousMonth and (f_level_touched(pmHigh, majorLevelTolerance) or f_level_touched(pmLow, majorLevelTolerance))) or
     (showPrevious4HLevels and (f_level_touched(previous4HHigh, majorLevelTolerance) or f_level_touched(previous4HLow, majorLevelTolerance))) or
     (asiaHighEnabled and f_level_touched(asiaHigh, majorLevelTolerance)) or (asiaLowEnabled and f_level_touched(asiaLow, majorLevelTolerance)) or
     (londonHighEnabled and f_level_touched(londonHigh, majorLevelTolerance)) or (londonLowEnabled and f_level_touched(londonLow, majorLevelTolerance)) or
     (newYorkHighEnabled and f_level_touched(newYorkHigh, majorLevelTolerance)) or (newYorkLowEnabled and f_level_touched(newYorkLow, majorLevelTolerance)) or
     (overnightHighEnabled and f_level_touched(overnightHigh, majorLevelTolerance)) or (overnightLowEnabled and f_level_touched(overnightLow, majorLevelTolerance)))

bool profileEdgeTouch = profileEdgesCanDefineLocation and (
     (overnightVPEnabled and (f_level_touched(overnightVAH, profileTolerance) or f_level_touched(overnightVAL, profileTolerance))) or
     (nyProfileMatureForLocation and (f_level_touched(nyVAH, profileTolerance) or f_level_touched(nyVAL, profileTolerance))))

string locationStatus = bullishLocationReaction and bearishLocationReaction ? "2-SIDED LOCATION" :
     bullishLocationReaction ? (str.length(bullLocationText) > 0 ? bullLocationText : "STRUCTURE") + " • BULL" :
     bearishLocationReaction ? (str.length(bearLocationText) > 0 ? bearLocationText : "STRUCTURE") + " • BEAR" :
     supportContextCount > 0 and resistanceContextCount > 0 ? "2-SIDED HTF" :
     supportContextCount > 0 ? supportLocationText + " SUPPORT" :
     resistanceContextCount > 0 ? resistanceLocationText + " RESIST" :
     majorLevelTouch ? "AT KEY / SESSION LEVEL" :
     profileEdgeTouch ? "AT VP EDGE" :
     chartSupportReactionRaw ? executionTFLabel + " SUPPORT" :
     chartResistanceReactionRaw ? executionTFLabel + " RESIST" : "BETWEEN LEVELS"

color locationStatusColor = bullishLocationReaction and not bearishLocationReaction ? color.new(color.green, 25) :
     bearishLocationReaction and not bullishLocationReaction ? color.new(color.red, 25) :
     supportContextCount > 0 and resistanceContextCount == 0 ? color.new(color.green, 35) :
     resistanceContextCount > 0 and supportContextCount == 0 ? color.new(color.red, 35) :
     profileEdgeTouch ? color.new(color.blue, 50) : color.new(color.gray, 50)

string priceActionStatus = bullishLocationReaction and not bearishLocationReaction ? "BULL DEFENSE" :
     bearishLocationReaction and not bullishLocationReaction ? "BEAR DEFENSE" :
     chartSupportReactionRaw and not chartResistanceReactionRaw ? "CHART SUPPORT" :
     chartResistanceReactionRaw and not chartSupportReactionRaw ? "CHART RESIST" :
     bullReactionCandle and not bearReactionCandle ? "BULL REACTION" :
     bearReactionCandle and not bullReactionCandle ? "BEAR REACTION" : "WAIT"

color priceActionStatusColor = str.contains(priceActionStatus, "BULL") or str.contains(priceActionStatus, "SUPPORT") ?
     color.new(color.green, 25) :
     str.contains(priceActionStatus, "BEAR") or str.contains(priceActionStatus, "RESIST") ?
     color.new(color.red, 25) : color.new(color.gray, 50)

string swingStatus = swingHighBreakNow ? "BREAK H" :
     swingLowBreakNow ? "BREAK L" :
     newChartSupportNow ? "NEW L • SUPPORT" :
     newChartResistanceNow ? "NEW H • RESIST" :
     formingSwingDirection == 1 ? "FORMING L" :
     formingSwingDirection == -1 ? "FORMING H" :
     swingHighSweepNow ? "SWEEP H" :
     swingLowSweepNow ? "SWEEP L" :
     activeSwingLowBullReaction ? "DEFEND L" :
     activeSwingHighBearReaction ? "DEFEND H" :
     not na(activeSwingHighTop) and not na(activeSwingLowBottom) ? "H + L ACTIVE" :
     not na(activeSwingHighTop) ? "H ACTIVE" :
     not na(activeSwingLowBottom) ? "L ACTIVE" : "WAIT"

color swingStatusColor = str.contains(swingStatus, "BREAK H") or str.contains(swingStatus, "SWEEP L") or str.contains(swingStatus, "DEFEND L") or str.contains(swingStatus, "NEW L") or str.contains(swingStatus, "FORMING L") ? color.new(color.green, 30) :
     str.contains(swingStatus, "BREAK L") or str.contains(swingStatus, "SWEEP H") or str.contains(swingStatus, "DEFEND H") or str.contains(swingStatus, "NEW H") or str.contains(swingStatus, "FORMING H") ? color.new(color.red, 30) : color.new(color.gray, 50)

string structureStatus = bullishStructureShift ? "BULL MSS" :
     bearishStructureShift ? "BEAR MSS" :
     confirmedStructureDirection == 1 ? "BULL • RETEST 2ND" :
     confirmedStructureDirection == -1 ? "BEAR • RETEST 2ND" :
     pendingDirection == 1 and pendingPrecisionEntryTaken ? (pendingBreakUsesSwing ? "LONG EARLY • WAIT H" : "LONG EARLY • WAIT BOS") :
     pendingDirection == -1 and pendingPrecisionEntryTaken ? (pendingBreakUsesSwing ? "SHORT EARLY • WAIT L" : "SHORT EARLY • WAIT BOS") :
     pendingDirection == 1 ? (pendingBreakUsesSwing ? "WAIT BREAK H" : "WAIT BOS") :
     pendingDirection == -1 ? (pendingBreakUsesSwing ? "WAIT BREAK L" : "WAIT BOS") : "WAIT"

color structureStatusColor = str.contains(structureStatus, "BULL") ? color.new(color.green, 20) :
     str.contains(structureStatus, "BEAR") ? color.new(color.red, 20) : color.new(color.gray, 50)

string entryStatus = longOriginInvalidated ? "EXIT • SUPPORT FAIL" :
     shortOriginInvalidated ? "EXIT • RESIST FAIL" :
     longSRSwingEntrySignal ? "BUY • SWING L" :
     shortSRSwingEntrySignal ? "SELL • SWING H" :
     longSROriginEntrySignal ? "BUY • LIVE SWING L" :
     shortSROriginEntrySignal ? "SELL • LIVE SWING H" :
     activeOriginDirection == 1 ? (activeOriginValidated ? "LONG • SUPPORT VALID" : "LONG • FORMING ACTIVE") :
     activeOriginDirection == -1 ? (activeOriginValidated ? "SHORT • RESIST VALID" : "SHORT • FORMING ACTIVE") :
     pendingDirection == 1 and pendingPrecisionEntryTaken ? "LONG ACTIVE • WAIT MSS" :
     pendingDirection == -1 and pendingPrecisionEntryTaken ? "SHORT ACTIVE • WAIT MSS" :
     confirmedStructureDirection == 1 ? (signalOnStructureShift ? "BULL • RETEST 2ND" : "LONG READY") :
     confirmedStructureDirection == -1 ? (signalOnStructureShift ? "BEAR • RETEST 2ND" : "SHORT READY") : "WAIT"

color entryStatusColor = str.contains(entryStatus, "BUY") or str.contains(entryStatus, "LONG") or str.contains(entryStatus, "BULL") ? color.new(color.green, 10) :
     str.contains(entryStatus, "SELL") or str.contains(entryStatus, "SHORT") or str.contains(entryStatus, "BEAR") ? color.new(color.red, 10) : color.new(color.gray, 50)

string overnightProfileState = f_profile_state_text(overnightVPEnabled, overnightVAH, overnightPOC, overnightVAL)
string nyProfileState = f_profile_state_text(nyVPEnabled, nyVAH, nyPOC, nyVAL)
string chartBiasStatus = liveChartTFBias == 1 ? executionTFLabel + " BULL" : liveChartTFBias == -1 ? executionTFLabel + " BEAR" : executionTFLabel + " NEUTRAL"
color chartBiasStatusColor = liveChartTFBias == 1 ? color.new(color.green, 25) : liveChartTFBias == -1 ? color.new(color.red, 25) : color.new(color.gray, 50)

var table structureTable = table.new(position.bottom_left, 2, 9,
     bgcolor=color.new(color.black, 72), border_width=1, border_color=color.new(color.gray, 70))

if barstate.islast
    table.clear(structureTable, 0, 0, 1, 8)

    if showStructureDashboard
        table.cell(structureTable, 0, 0, "SESSION", text_color=color.white,
             bgcolor=color.new(color.black, 35), text_size=size.small)
        table.cell(structureTable, 1, 0, activeSessionName, text_color=color.white,
             bgcolor=color.new(color.gray, 50), text_size=size.small)

        table.cell(structureTable, 0, 1, "LOCATION", text_color=color.white,
             bgcolor=color.new(color.black, 35), text_size=size.small)
        table.cell(structureTable, 1, 1, locationStatus, text_color=color.white,
             bgcolor=locationStatusColor, text_size=size.small)

        table.cell(structureTable, 0, 2, "ON VP", text_color=color.white,
             bgcolor=color.new(color.black, 35), text_size=size.small)
        table.cell(structureTable, 1, 2, overnightProfileState, text_color=color.white,
             bgcolor=f_profile_state_color(overnightProfileState), text_size=size.small)

        table.cell(structureTable, 0, 3, "NY VP", text_color=color.white,
             bgcolor=color.new(color.black, 35), text_size=size.small)
        table.cell(structureTable, 1, 3, nyProfileState, text_color=color.white,
             bgcolor=f_profile_state_color(nyProfileState), text_size=size.small)

        table.cell(structureTable, 0, 4, "CHART BIAS", text_color=color.white,
             bgcolor=color.new(color.black, 35), text_size=size.small)
        table.cell(structureTable, 1, 4, chartBiasStatus, text_color=color.white,
             bgcolor=chartBiasStatusColor, text_size=size.small)

        table.cell(structureTable, 0, 5, "PRICE ACTION", text_color=color.white,
             bgcolor=color.new(color.black, 35), text_size=size.small)
        table.cell(structureTable, 1, 5, priceActionStatus, text_color=color.white,
             bgcolor=priceActionStatusColor, text_size=size.small)

        table.cell(structureTable, 0, 6, "SWINGS", text_color=color.white,
             bgcolor=color.new(color.black, 35), text_size=size.small)
        table.cell(structureTable, 1, 6, swingStatus, text_color=color.white,
             bgcolor=swingStatusColor, text_size=size.small)

        table.cell(structureTable, 0, 7, "STRUCTURE", text_color=color.white,
             bgcolor=color.new(color.black, 35), text_size=size.small)
        table.cell(structureTable, 1, 7, structureStatus, text_color=color.white,
             bgcolor=structureStatusColor, text_size=size.small)

        table.cell(structureTable, 0, 8, "ENTRY", text_color=color.white,
             bgcolor=color.new(color.black, 35), text_size=size.small)
        table.cell(structureTable, 1, 8, entryStatus, text_color=color.white,
             bgcolor=entryStatusColor, text_size=size.small)
