//@version=6
indicator("Moving Averages", shorttitle="MA's", overlay=true)

// --- Inputs ---
len_ema1 = input.int(8, "EMA")
len_ema2 = input.int(21, "EMA")
len_sma1 = input.int(50, "SMA")
len_sma2 = input.int(100, "SMA")
len_sma3 = input.int(150, "SMA")
len_sma4 = input.int(200, "SMA")

// --- Calculations ---
ema1 = ta.ema(close, len_ema1)
ema2 = ta.ema(close, len_ema2)

sma1 = ta.sma(close, len_sma1)
sma2 = ta.sma(close, len_sma2)
sma3 = ta.sma(close, len_sma3)
sma4 = ta.sma(close, len_sma4)

// --- Plotting ---
plot(ema1, color=color.gray, linewidth=1, title="EMA 8")
plot(ema2, color=color.blue, linewidth=1, title="EMA 21")

plot(sma1, color=color.white, linewidth=1, title="SMA 50")
plot(sma2, color=color.red, linewidth=1, title="SMA 100")
plot(sma3, color=color.aqua, linewidth=1, title="SMA 150")
plot(sma4, color=color.purple, linewidth=1, title="SMA 200")