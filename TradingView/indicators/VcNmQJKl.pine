//@version=6
indicator("ATK/DEF MTF Regime Combo Day — Structure", overlay=true, precision=0, max_labels_count=500, max_lines_count=500, max_boxes_count=200)

// ============================================================================
// 1. INPUT PARAMETERS
// ============================================================================
length_ma20 = input.int(20, "MA20 Period", minval=1)
length_ma50 = input.int(50, "MA50 Period", minval=1)
length_rsi = input.int(14, "RSI Period", minval=1)
length_atr = input.int(14, "ATR Period", minval=1)
length_bb = input.int(20, "Bollinger Period", minval=1)
mult_bb = input.float(2.0, "Bollinger StdDev", minval=0.5, step=0.1)
length_vol_ma = input.int(12, "Volume MA Period", minval=1)
lookback_high_low = input.int(10, "Breakout Lookback", minval=3)
length_dmi = input.int(14, "DMI Length", minval=1)

// ===== Swing High/Low Parameters =====
leftBars = input.int(5, "Left Bars", minval=1, group="=== Swing Points ===")
rightBars = input.int(5, "Right Bars", minval=1, group="=== Swing Points ===")
showLabels = input.bool(true, "Show Pivot Labels", group="=== Swing Points ===")

// ===== FIFO Management =====
max_objects = input.int(50, "Max Objects (FIFO)", minval=10, maxval=200, group="=== FIFO Management ===")

// ============================================================================
// 2. FIFO QUEUE MANAGEMENT (Independent per Object Type)
// ============================================================================
// Label Queue
var int[] label_bars = array.new_int()
var label[] label_objects = array.new_label()

// Line Queue
var int[] line_bars = array.new_int()
var line[] line_objects = array.new_line()

// Box Queue (Reserved)
var int[] box_bars = array.new_int()
var box[] box_objects = array.new_box()

// ===== Label FIFO =====
fifo_add_label(label_obj, bar_idx) =>
    array.push(label_objects, label_obj)
    array.push(label_bars, bar_idx)
    while array.size(label_objects) > max_objects
        old = array.shift(label_objects)
        array.shift(label_bars)
        label.delete(old)

// ===== Line FIFO =====
fifo_add_line(line_obj, bar_idx) =>
    array.push(line_objects, line_obj)
    array.push(line_bars, bar_idx)
    while array.size(line_objects) > max_objects
        old = array.shift(line_objects)
        array.shift(line_bars)
        line.delete(old)

// ===== Box FIFO (Reserved) =====
fifo_add_box(box_obj, bar_idx) =>
    array.push(box_objects, box_obj)
    array.push(box_bars, bar_idx)
    while array.size(box_objects) > max_objects
        old = array.shift(box_objects)
        array.shift(box_bars)
        box.delete(old)

// ===== Unified Cleanup: Remove objects older than max_objects bars =====
fifo_cleanup() =>
    // Clean Labels
    label_idx = array.size(label_bars) - 1
    while label_idx >= 0
        if array.get(label_bars, label_idx) < bar_index - max_objects
            lbl = array.remove(label_objects, label_idx)
            array.remove(label_bars, label_idx)
            label.delete(lbl)
        label_idx := label_idx - 1
    
    // Clean Lines
    line_idx = array.size(line_bars) - 1
    while line_idx >= 0
        if array.get(line_bars, line_idx) < bar_index - max_objects
            ln = array.remove(line_objects, line_idx)
            array.remove(line_bars, line_idx)
            line.delete(ln)
        line_idx := line_idx - 1
    
    // Clean Boxes
    box_idx = array.size(box_bars) - 1
    while box_idx >= 0
        if array.get(box_bars, box_idx) < bar_index - max_objects
            bx = array.remove(box_objects, box_idx)
            array.remove(box_bars, box_idx)
            box.delete(bx)
        box_idx := box_idx - 1

// ============================================================================
// 3. BASE INDICATORS
// ============================================================================
ma20 = ta.sma(close, length_ma20)
ma50 = ta.sma(close, length_ma50)
rsi_val = ta.rsi(close, length_rsi)
atr_val = ta.atr(length_atr)
atr_ma = ta.sma(atr_val, length_vol_ma)

basis = ta.sma(close, length_bb)
dev = mult_bb * ta.stdev(close, length_bb)
bb_upper = basis + dev
bb_lower = basis - dev
bb_width = (bb_upper - bb_lower) / basis
bb_width_ma = ta.sma(bb_width, length_vol_ma)

vol_ma = ta.sma(volume, length_vol_ma)

[di_plus, di_minus, adx_val] = ta.dmi(length_dmi, length_dmi)

ma20_slope = ta.change(ma20, 1)
prev_rsi = rsi_val[1]
prev_close = close[1]
prev_bb_width = bb_width[1]
prev_bb_width_ma = bb_width_ma[1]

// ============================================================================
// 4. HELPER: Percentile
// ============================================================================
get_percentile(src, length, pct) =>
    float[] values = array.new_float()
    for i = 0 to length - 1
        array.push(values, src[i])
    array.sort(values)
    int idx = math.floor(pct * (length - 1) / 100)
    float result = array.get(values, idx)
    array.clear(values)
    result

// ============================================================================
// 5. CMF Manual Calculation
// ============================================================================
ad = (high == low) ? 0 : ((2 * close - high - low) / (high - low)) * volume
sum_ad = math.sum(ad, 21)
sum_vol = math.sum(volume, 21)
cmf_val = sum_vol == 0 ? 0 : sum_ad / sum_vol

// ============================================================================
// 6. COMBO 1: Direction + Momentum + Accumulation + Flow
// ============================================================================
// 6.1 Direction
f_direction() =>
    if close > ma20 and ma20 > ma50 and ma20_slope > 0 and close > high - (high - low) * 0.1
        90
    else if close > ma20 and ma20 > ma50
        75
    else if close > ma20 and ma20 < ma50
        55
    else if close < ma20 and ma20 > ma50
        40
    else if close < ma20 and ma20 < ma50 and ma20_slope < 0 and close < low + (high - low) * 0.1
        15
    else if close < ma20 and ma20 < ma50
        25
    else
        50

// 6.2 Momentum
f_momentum() =>
    float pct_change = (close - prev_close) / prev_close * 100
    if rsi_val >= 65 and rsi_val > prev_rsi and close > prev_close * 1.01
        90
    else if rsi_val >= 55 and rsi_val < 65 and rsi_val > prev_rsi
        75
    else if rsi_val >= 45 and rsi_val <= 55 and math.abs(pct_change) < 0.5
        55
    else if rsi_val >= 35 and rsi_val < 45 and rsi_val < prev_rsi
        35
    else if rsi_val >= 20 and rsi_val < 35 and rsi_val < prev_rsi and close < prev_close * 0.99
        20
    else if rsi_val < 20 or rsi_val > 80
        5
    else
        50

// 6.3 Accumulation
f_accumulation() =>
    float pct_change = math.abs(close - prev_close) / prev_close * 100
    float bb_percentile = get_percentile(bb_width, 20, 90)
    bool coiling_3d = pct_change < 0.5 and pct_change[1] < 0.5 and pct_change[2] < 0.5
    bool coiling_2d = pct_change < 0.5 and pct_change[1] < 0.5
    
    if coiling_3d and bb_width < bb_percentile * 0.2
        90
    else if coiling_2d and bb_width < bb_percentile * 0.4
        75
    else if pct_change <= 1 and bb_width >= bb_percentile * 0.4 and bb_width <= bb_percentile * 0.7
        55
    else if pct_change > 1.5 and bb_width > bb_percentile * 0.8
        35
    else if pct_change > 3 and bb_width > bb_percentile * 0.9
        15
    else if pct_change > 5
        5
    else
        50

// 6.4 Flow (New)
f_flow() =>
    float mfi_val = ta.mfi(close, 14)
    if cmf_val > 0.10 and mfi_val > 60
        90
    else if cmf_val > 0.05 and mfi_val >= 50
        75
    else if cmf_val >= -0.03 and cmf_val <= 0.05 and mfi_val >= 40 and mfi_val < 50
        55
    else if cmf_val >= -0.10 and cmf_val < -0.03
        35
    else if cmf_val < -0.10 and mfi_val < 30
        20
    else if cmf_val < -0.20 and mfi_val < 20
        5
    else
        50

// ============================================================================
// 7. COMBO 2: Density + Breakdown + Vortex + Resistance
// ============================================================================
// 7.1 Density
f_density() =>
    float avg_range = ta.sma(high - low, length_vol_ma)
    float range_ratio = (high - low) / avg_range
    float vol_ratio = volume / vol_ma
    if range_ratio < 0.3 and vol_ratio < 0.6
        90
    else if range_ratio < 0.5 and vol_ratio < 0.8
        75
    else if range_ratio >= 0.5 and range_ratio <= 0.8
        55
    else if range_ratio > 0.8 and range_ratio <= 1.5
        40
    else if range_ratio > 1.5 and range_ratio <= 2.0
        20
    else if range_ratio > 2.0 and vol_ratio > 2.0
        5
    else
        50

// 7.2 Breakdown
f_breakdown() =>
    float high_10 = ta.highest(high, lookback_high_low)
    float low_10 = ta.lowest(low, lookback_high_low)
    bool true_breakout = close > high_10 * 1.005 and volume > vol_ma * 1.5
    bool test_breakout = high > high_10 and not (close > high_10 * 1.005)
    bool near_edge = (high_10 - close) / high_10 < 0.005 or (close - low_10) / close < 0.005
    bool fake_breakout = high > high_10 and close <= high_10 and volume > vol_ma * 1.3
    bool down_break = close < low_10 * 0.995 and volume > vol_ma * 1.5
    
    if true_breakout
        90
    else if test_breakout
        75
    else if near_edge
        55
    else if fake_breakout
        30
    else if down_break
        10
    else
        25

// 7.3 Vortex
f_vortex() =>
    float body = math.abs(close - open)
    float shadow_upper = high - math.max(close, open)
    float shadow_lower = math.min(close, open) - low
    float body_ratio = body / (high - low)
    float atr_ratio = (high - low) / atr_val
    bool long_wicks = shadow_upper > body * 0.5 and shadow_lower > body * 0.5
    bool consecutive_wicks = long_wicks and long_wicks[1] and long_wicks[2]
    float range_percentile = get_percentile(high - low, 20, 90)
    
    if consecutive_wicks and (high - low) > range_percentile * 0.8
        90
    else if long_wicks or (body_ratio < 0.5 and atr_ratio > 1.2)
        75
    else if body_ratio >= 0.5 and body_ratio <= 0.7
        55
    else if body_ratio > 0.7 and body_ratio <= 0.85
        35
    else if body_ratio > 0.85 and atr_ratio < 0.8
        15
    else if (high - low) / atr_val < 0.2
        5
    else
        50

// 7.4 Resistance (New)
f_resistance() =>
    float high_10 = ta.highest(high, lookback_high_low)
    float low_10 = ta.lowest(low, lookback_high_low)
    float dist_to_res = (high_10 - close) / close * 100
    float dist_to_sup = (close - low_10) / close * 100
    float min_dist = math.min(dist_to_res, dist_to_sup)
    
    bool testing_res = close > high_10 * 0.98 and close < high_10 * 1.005
    bool testing_sup = close < low_10 * 1.02 and close > low_10 * 0.995
    bool multiple_tests = testing_res and testing_res[1] and testing_res[2]
    bool multiple_tests_sup = testing_sup and testing_sup[1] and testing_sup[2]
    
    if multiple_tests or multiple_tests_sup
        90
    else if testing_res or testing_sup
        75
    else if min_dist < 1
        55
    else if min_dist < 3
        35
    else if min_dist < 5
        20
    else
        10

// ============================================================================
// 8. COMBO 3: Radar + Frequency + Chaos + Trap
// ============================================================================
// 8.1 Radar
f_radar() =>
    bool bull_engulf = close > open and close[1] < open[1] and close > open[1] and open < close[1]
    bool bear_engulf = close < open and close[1] > open[1] and close < open[1] and open > close[1]
    bool hammer = close > open and (high - low) > (close - open) * 2 and (close - low) / (high - low) > 0.6
    bool shooting_star = close < open and (high - low) > (open - close) * 2 and (high - close) / (high - low) > 0.6
    bool doji = math.abs(close - open) / (high - low) < 0.1 and (high - low) > 0
    bool three_white = close > open and close[1] > open[1] and close[2] > open[2] and close > close[1] and close[1] > close[2]
    bool three_black = close < open and close[1] < open[1] and close[2] < open[2] and close < close[1] and close[1] < close[2]
    
    if bull_engulf or bear_engulf
        90
    else if hammer or shooting_star
        75
    else if three_white or three_black
        70
    else if doji
        40
    else
        25

// 8.2 Frequency
f_frequency() =>
    float tick_range = high - low
    float avg_tick_range = ta.sma(high - low, length_vol_ma)
    float range_ratio = tick_range / avg_tick_range
    float vol_ratio = volume / vol_ma
    float range_percentile = get_percentile(high - low, 20, 90)
    
    if range_ratio > range_percentile * 0.9 and vol_ratio > 1.5
        90
    else if range_ratio > range_percentile * 0.7 and vol_ratio > 1.2
        75
    else if range_ratio >= range_percentile * 0.4 and range_ratio <= range_percentile * 0.6
        55
    else if range_ratio < range_percentile * 0.3
        30
    else if range_ratio < range_percentile * 0.1
        15
    else if range_ratio < range_percentile * 0.05
        5
    else
        50

// 8.3 Chaos
f_chaos() =>
    float dir_changes = 0
    for i = 1 to 5
        if (close[i] > close[i+1] and close[i-1] < close[i]) or (close[i] < close[i+1] and close[i-1] > close[i])
            dir_changes := dir_changes + 1
    float chaos_score = dir_changes / 5 * 100
    
    if adx_val < 15 and chaos_score > 60
        90
    else if adx_val < 18 and chaos_score > 50
        75
    else if adx_val >= 18 and adx_val < 22
        55
    else if adx_val >= 22 and adx_val < 28
        35
    else if adx_val >= 30 and adx_val < 40
        15
    else if adx_val >= 40
        5
    else
        50

// 8.4 Trap
f_trap() =>
    float high_10 = ta.highest(high, lookback_high_low)
    float low_10 = ta.lowest(low, lookback_high_low)
    bool fake_breakout_high = high > high_10 and close <= high_10 and volume > vol_ma * 1.3
    bool fake_breakout_low = low < low_10 and close >= low_10 and volume > vol_ma * 1.3
    bool double_fake = (fake_breakout_high or fake_breakout_low) and (fake_breakout_high[1] or fake_breakout_low[1])
    bool weak_breakout = (close > high_10 or close < low_10) and volume < vol_ma * 1.2
    bool confirmed = (close > high_10 or close < low_10) and volume > vol_ma * 1.8
    
    if double_fake
        90
    else if fake_breakout_high or fake_breakout_low
        75
    else if weak_breakout
        55
    else if confirmed
        15
    else if confirmed and volume > vol_ma * 2.5
        5
    else
        40

// ============================================================================
// 9. CALCULATE COMBO SCORES
// ============================================================================
c1_dir = f_direction()
c1_mom = f_momentum()
c1_acc = f_accumulation()
c1_flow = f_flow()
c1_score = (c1_dir + c1_mom + c1_acc + c1_flow) / 4

c2_density = f_density()
c2_breakdown = f_breakdown()
c2_vortex = f_vortex()
c2_resistance = f_resistance()
c2_score = (c2_density + c2_breakdown + c2_vortex + c2_resistance) / 4

c3_radar = f_radar()
c3_freq = f_frequency()
c3_chaos = f_chaos()
c3_trap = f_trap()
c3_score = (c3_radar + c3_freq + c3_chaos + c3_trap) / 4

total_score = (c1_score + c2_score + c3_score) / 3

// ============================================================================
// 10. STATE LABELS
// ============================================================================
get_c1_label(score) =>
    if score >= 80
        "Strong Bull"
    else if score >= 60
        "Weak Bull"
    else if score >= 40
        "Neutral"
    else if score >= 20
        "Weak Bear"
    else
        "Strong Bear"

get_c2_label(score) =>
    if score >= 80
        "High Breakout"
    else if score >= 60
        "Breakout Test"
    else if score >= 40
        "Normal"
    else if score >= 20
        "Weak Structure"
    else
        "Broken Down"

get_c3_label(score) =>
    if score >= 80
        "High Signal"
    else if score >= 60
        "Active Zone"
    else if score >= 40
        "Normal"
    else if score >= 20
        "Quiet"
    else
        "Dead Zone"

get_grade(score) =>
    if score >= 80
        "A"
    else if score >= 60
        "B"
    else if score >= 40
        "C"
    else if score >= 20
        "D"
    else
        "E"

get_grade_color(score) =>
    if score >= 80
        color.green
    else if score >= 60
        color.lime
    else if score >= 40
        color.yellow
    else if score >= 20
        color.orange
    else
        color.red

// ============================================================================
// 11. TABLE (Bottom Right)
// ============================================================================
if barstate.islast
    sz = size.small
    var table tbl = table.new(position.bottom_right, columns=8, rows=6,
                              bgcolor=color.rgb(0,0,0, 92), border_color=color.gray, border_width=1)
    
    table.cell(tbl, 0, 0, " ATK/DEF MTF Regime Combo - structure", text_color=color.yellow, bgcolor=color.rgb(40,20,0), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 1, 0, "", text_color=color.yellow, bgcolor=color.rgb(40,20,0), text_size=sz)
    table.cell(tbl, 2, 0, "", text_color=color.yellow, bgcolor=color.rgb(40,20,0), text_size=sz)
    table.cell(tbl, 3, 0, "", text_color=color.yellow, bgcolor=color.rgb(40,20,0), text_size=sz)
    table.cell(tbl, 4, 0, "", text_color=color.yellow, bgcolor=color.rgb(40,20,0), text_size=sz)
    table.cell(tbl, 5, 0, "", text_color=color.yellow, bgcolor=color.rgb(40,20,0), text_size=sz)
    table.cell(tbl, 6, 0, "", text_color=color.yellow, bgcolor=color.rgb(40,20,0), text_size=sz)
    table.cell(tbl, 7, 0, "", text_color=color.yellow, bgcolor=color.rgb(40,20,0), text_size=sz)
    
    table.cell(tbl, 0, 1, "Module", text_color=color.white, bgcolor=color.rgb(30,30,30), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 1, 1, "Factor 1", text_color=color.white, bgcolor=color.rgb(30,30,30), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 2, 1, "Factor 2", text_color=color.white, bgcolor=color.rgb(30,30,30), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 3, 1, "Factor 3", text_color=color.white, bgcolor=color.rgb(30,30,30), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 4, 1, "Factor 4", text_color=color.white, bgcolor=color.rgb(30,30,30), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 5, 1, "SCORE", text_color=color.white, bgcolor=color.rgb(30,30,30), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 6, 1, "State", text_color=color.white, bgcolor=color.rgb(30,30,30), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 7, 1, "Grade", text_color=color.white, bgcolor=color.rgb(30,30,30), text_size=sz, text_halign=text.align_center)
    
    c1_bg = color.from_gradient(c1_score, 0, 100, color.red, color.green)
    table.cell(tbl, 0, 2, "C1", text_color=color.orange, bgcolor=color.rgb(20,20,30), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 1, 2, "Dir "+str.tostring(c1_dir, "#")+"%", text_color=color.white, bgcolor=color.from_gradient(c1_dir, 0, 100, color.red, color.green), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 2, 2, "Mom "+str.tostring(c1_mom, "#")+"%", text_color=color.white, bgcolor=color.from_gradient(c1_mom, 0, 100, color.red, color.green), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 3, 2, "Acc "+str.tostring(c1_acc, "#")+"%", text_color=color.white, bgcolor=color.from_gradient(c1_acc, 0, 100, color.red, color.green), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 4, 2, "Flow "+str.tostring(c1_flow, "#")+"%", text_color=color.white, bgcolor=color.from_gradient(c1_flow, 0, 100, color.red, color.green), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 5, 2, str.tostring(c1_score, "#")+"%", text_color=color.white, bgcolor=c1_bg, text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 6, 2, get_c1_label(c1_score), text_color=color.white, bgcolor=c1_bg, text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 7, 2, get_grade(c1_score), text_color=get_grade_color(c1_score), bgcolor=color.rgb(20,20,30), text_size=sz, text_halign=text.align_center)
    
    c2_bg = color.from_gradient(c2_score, 0, 100, color.red, color.green)
    table.cell(tbl, 0, 3, "C2", text_color=color.aqua, bgcolor=color.rgb(20,20,30), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 1, 3, "Dens "+str.tostring(c2_density, "#")+"%", text_color=color.white, bgcolor=color.from_gradient(c2_density, 0, 100, color.red, color.green), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 2, 3, "Brk "+str.tostring(c2_breakdown, "#")+"%", text_color=color.white, bgcolor=color.from_gradient(c2_breakdown, 0, 100, color.red, color.green), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 3, 3, "Vtx "+str.tostring(c2_vortex, "#")+"%", text_color=color.white, bgcolor=color.from_gradient(c2_vortex, 0, 100, color.red, color.green), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 4, 3, "Res "+str.tostring(c2_resistance, "#")+"%", text_color=color.white, bgcolor=color.from_gradient(c2_resistance, 0, 100, color.red, color.green), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 5, 3, str.tostring(c2_score, "#")+"%", text_color=color.white, bgcolor=c2_bg, text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 6, 3, get_c2_label(c2_score), text_color=color.white, bgcolor=c2_bg, text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 7, 3, get_grade(c2_score), text_color=get_grade_color(c2_score), bgcolor=color.rgb(20,20,30), text_size=sz, text_halign=text.align_center)
    
    c3_bg = color.from_gradient(c3_score, 0, 100, color.red, color.green)
    table.cell(tbl, 0, 4, "C3", text_color=color.yellow, bgcolor=color.rgb(20,20,30), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 1, 4, "Rad "+str.tostring(c3_radar, "#")+"%", text_color=color.white, bgcolor=color.from_gradient(c3_radar, 0, 100, color.red, color.green), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 2, 4, "Freq "+str.tostring(c3_freq, "#")+"%", text_color=color.white, bgcolor=color.from_gradient(c3_freq, 0, 100, color.red, color.green), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 3, 4, "Chaos "+str.tostring(c3_chaos, "#")+"%", text_color=color.white, bgcolor=color.from_gradient(c3_chaos, 0, 100, color.red, color.green), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 4, 4, "Trap "+str.tostring(c3_trap, "#")+"%", text_color=color.white, bgcolor=color.from_gradient(c3_trap, 0, 100, color.red, color.green), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 5, 4, str.tostring(c3_score, "#")+"%", text_color=color.white, bgcolor=c3_bg, text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 6, 4, get_c3_label(c3_score), text_color=color.white, bgcolor=c3_bg, text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 7, 4, get_grade(c3_score), text_color=get_grade_color(c3_score), bgcolor=color.rgb(20,20,30), text_size=sz, text_halign=text.align_center)
    
    total_bg = color.from_gradient(total_score, 0, 100, color.red, color.green)
    table.cell(tbl, 0, 5, "Total", text_color=color.yellow, bgcolor=color.rgb(30,30,30), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 1, 5, "C1:"+str.tostring(c1_score,"#")+"%", text_color=color.white, bgcolor=color.rgb(20,20,30), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 2, 5, "C2:"+str.tostring(c2_score,"#")+"%", text_color=color.white, bgcolor=color.rgb(20,20,30), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 3, 5, "C3:"+str.tostring(c3_score,"#")+"%", text_color=color.white, bgcolor=color.rgb(20,20,30), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 4, 5, "Total", text_color=color.yellow, bgcolor=color.rgb(20,20,30), text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 5, 5, str.tostring(total_score,"#")+"%", text_color=color.white, bgcolor=total_bg, text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 6, 5, get_grade(total_score), text_color=get_grade_color(total_score), bgcolor=total_bg, text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 7, 5, "", text_color=color.gray, bgcolor=color.rgb(20,20,30), text_size=sz)

// ============================================================================
// 12. PLOT MOVING AVERAGES
// ============================================================================
plot(ma20, "MA20", color=color.new(color.blue, 70), linewidth=1)
plot(ma50, "MA50", color=color.new(color.red, 70), linewidth=1)

// ============================================================================
// 13. PLOT SWING HIGH & LOW LABELS (FIFO Managed)
// ============================================================================
swingHigh = ta.pivothigh(leftBars, rightBars)
swingLow = ta.pivotlow(leftBars, rightBars)

if showLabels
    if not na(swingHigh)
        lbl = label.new(bar_index[rightBars], swingHigh,
                  text="🔴 RESISTANCE\n" + str.tostring(swingHigh, "#.##"),
                  color=color.rgb(200,0,0, 85), textcolor=color.white,
                  style=label.style_label_down, size=size.small)
        fifo_add_label(lbl, bar_index)
    
    if not na(swingLow)
        lbl = label.new(bar_index[rightBars], swingLow,
                  text="🟢 SUPPORT\n" + str.tostring(swingLow, "#.##"),
                  color=color.rgb(0,150,0, 85), textcolor=color.white,
                  style=label.style_label_up, size=size.small)
        fifo_add_label(lbl, bar_index)

// ============================================================================
// 14. SWING CONNECTION LINES (FIFO Managed)
// ============================================================================
var float last_swing_high_price = na
var int last_swing_high_bar = na

if not na(swingHigh)
    if not na(last_swing_high_price)
        ln = line.new(last_swing_high_bar, last_swing_high_price, 
                      bar_index[rightBars], swingHigh,
                      color=color.new(color.red, 60), width=1, style=line.style_dashed)
        fifo_add_line(ln, bar_index)
    last_swing_high_price := swingHigh
    last_swing_high_bar := bar_index[rightBars]

var float last_swing_low_price = na
var int last_swing_low_bar = na

if not na(swingLow)
    if not na(last_swing_low_price)
        ln = line.new(last_swing_low_bar, last_swing_low_price,
                      bar_index[rightBars], swingLow,
                      color=color.new(color.green, 60), width=1, style=line.style_dashed)
        fifo_add_line(ln, bar_index)
    last_swing_low_price := swingLow
    last_swing_low_bar := bar_index[rightBars]

// ============================================================================
// 15. FIFO CLEANUP
// ============================================================================
fifo_cleanup()