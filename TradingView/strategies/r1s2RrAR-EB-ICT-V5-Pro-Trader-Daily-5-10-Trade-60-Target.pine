//@version=5
strategy("EB ICT V5 Pro Trader - Daily 5-10 Trade 60% Target", overlay=true, initial_capital=50000, default_qty_type=strategy.percent_of_equity, default_qty_value=0.5, pyramiding=0)

// Inputs
minScore      = input.int(55, "Minimum Score", minval=0, maxval=100)
rr            = input.float(1.0, "Risk Reward", step=0.1)
swingLen      = input.int(2, "Swing Strength", minval=1)
cooldownBars  = input.int(3, "Cooldown Bars")

maxTradesDay  = input.int(10, "Max Trades Per Day")
minTradesGoal = input.int(5, "Daily Trade Goal")

htf           = input.timeframe("60", "HTF Bias TF")
emaFastLen    = input.int(34, "EMA Fast")
emaSlowLen    = input.int(100, "EMA Slow")

useSession    = input.bool(true, "Use Session Filter")
london        = input.session("0700-1200", "London")
ny            = input.session("1230-1700", "New York")

useATR        = input.bool(true, "Use ATR Filter")
atrLen        = input.int(14, "ATR Length")
atrMult       = input.float(0.35, "ATR Minimum Multiplier", step=0.05)

pdBuyLevel    = input.float(55.0, "Buy Discount Below")
pdSellLevel   = input.float(45.0, "Sell Premium Above")

// Session
sessionOK = useSession ? (not na(time(timeframe.period, london)) or not na(time(timeframe.period, ny))) : true

// Daily trade counter
newDay = ta.change(time("D"))

var int tradesToday = 0
if newDay
    tradesToday := 0

dailyTradeOK = tradesToday < maxTradesDay

// Bias
htfClose = request.security(syminfo.tickerid, htf, close)
htfEMA   = request.security(syminfo.tickerid, htf, ta.ema(close, 50))

bullBias = htfClose > htfEMA
bearBias = htfClose < htfEMA

// Trend
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

trendBuy  = emaFast > emaSlow
trendSell = emaFast < emaSlow

// ATR
atr = ta.atr(atrLen)
atrAvg = ta.sma(atr, 50)
atrOK = not useATR or atr >= atrAvg * atrMult

// Swings
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastHigh = na
var float lastLow  = na

if not na(ph)
    lastHigh := ph

if not na(pl)
    lastLow := pl

// ICT signals
buySweep  = not na(lastLow) and low < lastLow and close > lastLow
sellSweep = not na(lastHigh) and high > lastHigh and close < lastHigh

body = math.abs(close - open)
avgBody = ta.sma(math.abs(close - open), 20)

bullDisp = close > open and body > avgBody * 1.05
bearDisp = close < open and body > avgBody * 1.05

bullMSS = not na(lastHigh) and close > lastHigh
bearMSS = not na(lastLow) and close < lastLow

bullFVG = low > high[2]
bearFVG = high < low[2]

// Premium / Discount
rangeHigh = ta.highest(high, 50)
rangeLow  = ta.lowest(low, 50)
rangePos  = (close - rangeLow) / math.max(rangeHigh - rangeLow, syminfo.mintick) * 100

buyPD  = rangePos < pdBuyLevel
sellPD = rangePos > pdSellLevel

// FVG memory
var float bullFVGTop = na
var float bullFVGBot = na
var float bearFVGTop = na
var float bearFVGBot = na

if bullFVG
    bullFVGTop := low
    bullFVGBot := high[2]

if bearFVG
    bearFVGTop := low[2]
    bearFVGBot := high

buyRetest  = not na(bullFVGTop) and low <= bullFVGTop and close > bullFVGBot
sellRetest = not na(bearFVGBot) and high >= bearFVGBot and close < bearFVGTop

// Rejection
bullReject = close > open and close > close[1]
bearReject = close < open and close < close[1]

// Scores
buyScore = 0
sellScore = 0

buyScore += bullBias ? 15 : 0
sellScore += bearBias ? 15 : 0

buyScore += buySweep ? 20 : 0
sellScore += sellSweep ? 20 : 0

buyScore += bullDisp ? 15 : 0
sellScore += bearDisp ? 15 : 0

buyScore += bullMSS ? 15 : 0
sellScore += bearMSS ? 15 : 0

buyScore += buyRetest ? 20 : bullFVG ? 10 : 0
sellScore += sellRetest ? 20 : bearFVG ? 10 : 0

buyScore += buyPD ? 10 : 0
sellScore += sellPD ? 10 : 0

buyScore += sessionOK ? 5 : 0
sellScore += sessionOK ? 5 : 0

// Engine 1: Reversal after sweep
buyReversal =
     bullBias and
     buyPD and
     buySweep and
     bullReject

sellReversal =
     bearBias and
     sellPD and
     sellSweep and
     bearReject

// Engine 2: Continuation after FVG retest
buyContinuation =
     bullBias and
     trendBuy and
     buyPD and
     buyRetest and
     bullReject

sellContinuation =
     bearBias and
     trendSell and
     sellPD and
     sellRetest and
     bearReject

// Engine 3: Momentum continuation for more daily trades
buyMomentum =
     bullBias and
     trendBuy and
     buyPD and
     bullDisp and
     close > emaFast

sellMomentum =
     bearBias and
     trendSell and
     sellPD and
     bearDisp and
     close < emaFast

buyEngine  = buyReversal or buyContinuation or buyMomentum
sellEngine = sellReversal or sellContinuation or sellMomentum

// Cooldown
var int lastTradeBar = na
cooldownOK = na(lastTradeBar) or bar_index - lastTradeBar > cooldownBars

// SL / TP
buySL = ta.lowest(low, 5)
sellSL = ta.highest(high, 5)

buyRisk = close - buySL
sellRisk = sellSL - close

buyTP = close + buyRisk * rr
sellTP = close - sellRisk * rr

buyAllowed =
     buyScore >= minScore and
     buyEngine and
     sessionOK and
     atrOK and
     cooldownOK and
     dailyTradeOK and
     strategy.position_size == 0

sellAllowed =
     sellScore >= minScore and
     sellEngine and
     sessionOK and
     atrOK and
     cooldownOK and
     dailyTradeOK and
     strategy.position_size == 0

if buyAllowed and buyRisk > syminfo.mintick
    strategy.entry("BUY", strategy.long)
    strategy.exit("BUY EXIT", "BUY", stop=buySL, limit=buyTP)
    lastTradeBar := bar_index
    tradesToday += 1

if sellAllowed and sellRisk > syminfo.mintick
    strategy.entry("SELL", strategy.short)
    strategy.exit("SELL EXIT", "SELL", stop=sellSL, limit=sellTP)
    lastTradeBar := bar_index
    tradesToday += 1

// Visuals
plotshape(buyAllowed, "BUY", shape.labelup, location.belowbar, color.green, text="BUY")
plotshape(sellAllowed, "SELL", shape.labeldown, location.abovebar, color.red, text="SELL")

plotshape(buySweep, "Buy Sweep", shape.triangleup, location.belowbar, color.blue, size=size.tiny, text="BS")
plotshape(sellSweep, "Sell Sweep", shape.triangledown, location.abovebar, color.orange, size=size.tiny, text="SS")

plotshape(bullMSS, "Bull MSS", shape.circle, location.belowbar, color.aqua, size=size.tiny, text="MSS")
plotshape(bearMSS, "Bear MSS", shape.circle, location.abovebar, color.aqua, size=size.tiny, text="MSS")

plot(emaFast, "EMA Fast", color=color.blue)
plot(emaSlow, "EMA Slow", color=color.red)

// Dashboard
var table dash = table.new(position.top_right, 2, 10, border_width=1)

if barstate.islast
    table.cell(dash, 0, 0, "EB ICT V5")
    table.cell(dash, 1, 0, "Daily 5-10 Target")

    table.cell(dash, 0, 1, "Bias")
    table.cell(dash, 1, 1, bullBias ? "Bullish" : bearBias ? "Bearish" : "Neutral")

    table.cell(dash, 0, 2, "Buy Score")
    table.cell(dash, 1, 2, str.tostring(buyScore) + "%")

    table.cell(dash, 0, 3, "Sell Score")
    table.cell(dash, 1, 3, str.tostring(sellScore) + "%")

    table.cell(dash, 0, 4, "Buy Engine")
    table.cell(dash, 1, 4, buyReversal ? "Reversal" : buyContinuation ? "Continuation" : buyMomentum ? "Momentum" : "Blocked")

    table.cell(dash, 0, 5, "Sell Engine")
    table.cell(dash, 1, 5, sellReversal ? "Reversal" : sellContinuation ? "Continuation" : sellMomentum ? "Momentum" : "Blocked")

    table.cell(dash, 0, 6, "ATR")
    table.cell(dash, 1, 6, atrOK ? "OK" : "Weak")

    table.cell(dash, 0, 7, "Trades Today")
    table.cell(dash, 1, 7, str.tostring(tradesToday) + "/" + str.tostring(maxTradesDay))

    table.cell(dash, 0, 8, "Daily Goal")
    table.cell(dash, 1, 8, str.tostring(minTradesGoal) + "-10")

    table.cell(dash, 0, 9, "RR")
    table.cell(dash, 1, 9, str.tostring(rr))