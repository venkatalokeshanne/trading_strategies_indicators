//@version=6

// ============================================================================

//  VASA Market Structure + Sessions

//  An SMC-adjacent read of who's in control. Marks confirmed swing highs/lows,

//  labels Break of Structure (BOS) and Change of Character (CHoCH) when price

//  closes through the last confirmed swing, shades the Asia / London / New York

//  sessions, and plots prior-day and prior-week high/low.

//

//  NON-REPAINTING: swings are CONFIRMED pivots (need `Swing right bars` closed

//  candles before they count), BOS/CHoCH fire on a CLOSED break of a confirmed

//  swing, and prior H/L use the approved idiom

//  request.security(..., expr[1], lookahead = barmerge.lookahead_on) which

//  returns only the last CLOSED higher-timeframe bar. Nothing redraws.

//  Educational only — not financial advice. Trading involves substantial risk.

// ============================================================================

indicator("VASA Market Structure", "VASA Structure", overlay = true, max_lines_count = 100, max_labels_count = 200)

// ---------- Inputs ----------

grpM = "Structure"

lb      = input.int(8, "Swing left bars",  minval = 1, group = grpM)

rb      = input.int(8, "Swing right bars", minval = 1, group = grpM)

showBOS = input.bool(true, "Label BOS / CHoCH", group = grpM)

showSw  = input.bool(true, "Mark confirmed swings", group = grpM)

grpL = "Prior levels"

showPD = input.bool(true,  "Prior DAY high/low",  group = grpL)

showPW = input.bool(true,  "Prior WEEK high/low", group = grpL)

grpSe = "Sessions"

showSess = input.bool(true, "Shade sessions", group = grpSe)

tz  = input.string("America/New_York", "Session timezone", group = grpSe)

se1 = input.session("2000-0000", "Asia",     group = grpSe)

se2 = input.session("0300-1130", "London",   group = grpSe)

se3 = input.session("0930-1600", "New York", group = grpSe)

grpS = "Style"

colUp  = input.color(#15803d, "Bullish", group = grpS)

colDn  = input.color(#b91c1c, "Bearish", group = grpS)

colLvl = input.color(#64748b, "Prior levels", group = grpS)

// ---------- Confirmed swings ----------

ph = ta.pivothigh(high, lb, rb)

pl = ta.pivotlow(low, lb, rb)

var float lastSwingHigh = na

var float lastSwingLow  = na

var int   dir = 0   // 1 = bullish structure, -1 = bearish

if not na(ph)

    lastSwingHigh := ph

    if showSw

        label.new(bar_index - rb, ph, "", yloc = yloc.abovebar, style = label.style_xcross, color = color.new(colDn, 40), size = size.tiny)

if not na(pl)

    lastSwingLow := pl

    if showSw

        label.new(bar_index - rb, pl, "", yloc = yloc.belowbar, style = label.style_xcross, color = color.new(colUp, 40), size = size.tiny)

// ---------- BOS / CHoCH on confirmed close-through ----------

bosUp = not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh

bosDn = not na(lastSwingLow)  and close < lastSwingLow  and close[1] >= lastSwingLow

if bosUp

    txt = dir == -1 ? "CHoCH ▲" : "BOS ▲"

    dir := 1

    if showBOS

        label.new(bar_index, high, txt, style = label.style_label_down, color = colUp, textcolor = color.white, size = size.small)

if bosDn

    txt = dir == 1 ? "CHoCH ▼" : "BOS ▼"

    dir := -1

    if showBOS

        label.new(bar_index, low, txt, style = label.style_label_up, color = colDn, textcolor = color.white, size = size.small)

// ---------- Prior day / week high-low (non-repainting HTF idiom) ----------

[pdh, pdl] = request.security(syminfo.tickerid, "1D", [high[1], low[1]], lookahead = barmerge.lookahead_on)

[pwh, pwl] = request.security(syminfo.tickerid, "1W", [high[1], low[1]], lookahead = barmerge.lookahead_on)

plot(showPD ? pdh : na, "Prior day high",  color = colLvl, style = plot.style_stepline)

plot(showPD ? pdl : na, "Prior day low",   color = colLvl, style = plot.style_stepline)

plot(showPW ? pwh : na, "Prior week high", color = color.new(colLvl, 0), style = plot.style_stepline, linewidth = 2)

plot(showPW ? pwl : na, "Prior week low",  color = color.new(colLvl, 0), style = plot.style_stepline, linewidth = 2)

// ---------- Session shading ----------

inS1 = showSess and not na(time(timeframe.period, se1, tz))

inS2 = showSess and not na(time(timeframe.period, se2, tz))

inS3 = showSess and not na(time(timeframe.period, se3, tz))

bgcolor(inS1 ? color.new(#eab308, 92) : na, title = "Asia")

bgcolor(inS2 ? color.new(#3b82f6, 92) : na, title = "London")

bgcolor(inS3 ? color.new(#a855f7, 92) : na, title = "New York")

// ---------- Alerts (confirmed) ----------

alertcondition(bosUp, "Bullish BOS/CHoCH", "VASA Structure: bullish break of structure (confirmed close)")

alertcondition(bosDn, "Bearish BOS/CHoCH", "VASA Structure: bearish break of structure (confirmed close)")
