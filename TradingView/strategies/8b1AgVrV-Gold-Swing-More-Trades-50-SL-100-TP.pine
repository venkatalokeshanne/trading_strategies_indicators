//@version=5
strategy("Gold Swing More Trades 50 SL 100 TP", overlay=true, initial_capital=500, default_qty_type=strategy.fixed, default_qty_value=0.1, pyramiding=0, process_orders_on_close=true, max_labels_count=500)

// Inputs
emaFastLen       = input.int(20, "Fast EMA", minval=1)
emaSlowLen       = input.int(50, "Slow EMA", minval=1)
rsiLen           = input.int(14, "RSI Length", minval=1)

rsiLongMin       = input.int(54, "RSI Long Min", minval=1, maxval=100)
rsiShortMax      = input.int(46, "RSI Short Max", minval=1, maxval=100)

enableLongs      = input.bool(true, "Enable Longs")
enableShorts     = input.bool(true, "Enable Shorts")

useSessionFilter = input.bool(true, "Use Session Filter")
tradeSession     = input.session("0600-2000", "Trade Session")
sessionString    = tradeSession + ":23456"

cooldownBars     = input.int(2, "Cooldown Bars", minval=0, maxval=50)

slPips           = input.float(50.0, "SL Pips", minval=0.1, step=0.1)
tpPips           = input.float(100.0, "TP Pips", minval=0.1, step=0.1)
pipSize          = input.float(0.1, "Pip Size", minval=0.00001, step=0.00001)

showTradeTag     = input.bool(true, "Show Signal Tag")
tagAtrOffset     = input.float(0.45, "Tag ATR Offset", minval=0.05, step=0.05)
tagSize          = input.string("small", "Tag Size", options=["tiny", "small", "normal"])

// Core
emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
rsiVal   = ta.rsi(close, rsiLen)
vwapVal  = ta.vwap(hlc3)
atrVal   = ta.atr(14)

inSession = not na(time(timeframe.period, sessionString))
sessionOk = useSessionFilter ? inSession : true

emaFastRising  = emaFast > emaFast[2]
emaFastFalling = emaFast < emaFast[2]

bullTrend = close > vwapVal and emaFast > emaSlow and emaFastRising
bearTrend = close < vwapVal and emaFast < emaSlow and emaFastFalling

bullReclaim = low <= emaFast and close > emaFast and close > open
bearReclaim = high >= emaFast and close < emaFast and close < open

rsiLongOk  = rsiVal >= rsiLongMin
rsiShortOk = rsiVal <= rsiShortMax

var int lastTradeBar = na
cooldownOk = na(lastTradeBar) or (bar_index - lastTradeBar > cooldownBars)

longSignal  = enableLongs and sessionOk and cooldownOk and bullTrend and bullReclaim and rsiLongOk and strategy.position_size <= 0
shortSignal = enableShorts and sessionOk and cooldownOk and bearTrend and bearReclaim and rsiShortOk and strategy.position_size >= 0

labelSize =
     tagSize == "tiny" ? size.tiny :
     tagSize == "normal" ? size.normal :
     size.small

if longSignal
    entryPrice = close
    stopPrice  = entryPrice - (slPips * pipSize)
    takePrice  = entryPrice + (tpPips * pipSize)

    strategy.entry("L", strategy.long)
    strategy.exit("LX", from_entry="L", stop=stopPrice, limit=takePrice)
    lastTradeBar := bar_index

    if showTradeTag
        label.new(bar_index, low - atrVal * tagAtrOffset, "BUY", style=label.style_label_up, color=color.new(color.lime, 10), textcolor=color.black, size=labelSize)

if shortSignal
    entryPrice = close
    stopPrice  = entryPrice + (slPips * pipSize)
    takePrice  = entryPrice - (tpPips * pipSize)

    strategy.entry("S", strategy.short)
    strategy.exit("SX", from_entry="S", stop=stopPrice, limit=takePrice)
    lastTradeBar := bar_index

    if showTradeTag
        label.new(bar_index, high + atrVal * tagAtrOffset, "SELL", style=label.style_label_down, color=color.new(color.red, 10), textcolor=color.white, size=labelSize)

plot(vwapVal, "VWAP", color=color.yellow, linewidth=2)
plot(emaFast, "EMA 20", color=color.aqua, linewidth=2)
plot(emaSlow, "EMA 50", color=color.orange, linewidth=2)

plotshape(longSignal, title="Buy Shape", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small)
plotshape(shortSignal, title="Sell Shape", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

alertcondition(longSignal, title="Entry Up", message="Gold buy signal")
alertcondition(shortSignal, title="Entry Down", message="Gold sell signal")