// This source code is subject to the Mozilla Public License 2.0
//@version=5
strategy("Swordsmith Bulletproof Version 2", shorttitle="SB v2",
     overlay=true, pyramiding=0, default_qty_type=strategy.fixed,
     default_qty_value=1, initial_capital=50000,
     commission_type=strategy.commission.cash_per_contract,
     commission_value=0.5, slippage=1,
     max_boxes_count=200, max_lines_count=200, max_labels_count=200)

// ══════════════════════════════════════════════════════════════════
// SECTION 1: INPUTS
// ══════════════════════════════════════════════════════════════════

// ── Instrument ──
grpInstr = "Instrument Settings"
i_pointValue    = input.float(2.0,  "Point Value Override", group=grpInstr, tooltip="MNQ=2, MES=5, NQ=20, YM=5")
i_qty           = input.int(1,      "Contracts", minval=1, maxval=2, group=grpInstr)
i_tradeDir      = input.string("Both", "Trade Direction", options=["Long Only","Short Only","Both"], group=grpInstr)

// ── Opening Range ──
grpORB = "Opening Range"
i_orbStart      = input.session("0930-0945", "ORB Window (NY)", group=grpORB)
i_orbEnd        = input.int(9, "ORB End Hour (NY 24h)", group=grpORB)
i_orbEndMin     = input.int(30, "ORB End Minute", group=grpORB)
i_cutoffHour    = input.int(15, "Trade Cutoff Hour (NY)", group=grpORB)
i_cutoffMin     = input.int(0,  "Trade Cutoff Min", group=grpORB)
i_retestMode    = input.bool(false, "Require ORB Retest", group=grpORB)
i_retestTol     = input.float(0.25, "Retest Tolerance (% of ORB range)", group=grpORB)

// ── HTF Trend (Condition 1) ──
grpHTF = "C1: HTF Trend (15m)"
i_c1En          = input.bool(true,  "Enable", group=grpHTF)
i_htfTF         = input.timeframe("15", "HTF Timeframe", group=grpHTF)
i_htfFastLen    = input.int(9,  "Fast EMA Length", group=grpHTF)
i_htfSlowLen    = input.int(21, "Slow EMA Length", group=grpHTF)

// ── SMC BOS/CHoCH (Condition 2) ──
grpSMC = "C2: BOS / CHoCH"
i_c2En          = input.bool(true,  "Enable", group=grpSMC)
i_pivLen        = input.int(5,  "Pivot Length", group=grpSMC)
i_c2Score       = input.int(2,  "Score Weight", minval=1, maxval=3, group=grpSMC)

// ── Liquidity Sweep (Condition 3) ──
grpLiq = "C3: Liquidity Sweep"
i_c3En          = input.bool(true,  "Enable", group=grpLiq)
i_liqLen        = input.int(10, "Swing Lookback", group=grpLiq)

// ── Order Block (Condition 4) ──
grpOB = "C4: Order Block"
i_c4En          = input.bool(true,  "Enable", group=grpOB)
i_obMitPct      = input.float(50.0, "Mitigation % (0=touch, 100=full close thru)", group=grpOB)
i_showOB        = input.bool(true,  "Show OB Zones", group=grpOB)

// ── FVG (Condition 5) ──
grpFVG = "C5: Fair Value Gap"
i_c5En          = input.bool(true,  "Enable", group=grpFVG)
i_fvgMaxBars    = input.int(50, "FVG Max Age (bars)", group=grpFVG)
i_showFVG       = input.bool(true,  "Show FVG Zones", group=grpFVG)

// ── Volume Flow (Condition 6) ──
grpVol = "C6: Volume Flow"
i_c6En          = input.bool(true,  "Enable", group=grpVol)
i_volMALen      = input.int(20, "Volume MA Length", group=grpVol)
i_useOBV        = input.bool(false, "Use OBV Confirmation", group=grpVol)

// ── Smart Trail (Condition 7) ──
grpST = "C7: Smart Trail"
i_c7En          = input.bool(true,  "Enable", group=grpST)
i_atrLen        = input.int(14, "ATR Length", group=grpST)
i_atrMult       = input.float(2.0, "ATR Multiplier", group=grpST)
i_showTrail     = input.bool(true,  "Show Smart Trail", group=grpST)

// ── Momentum (Condition 8) ──
grpMom = "C8: Momentum"
i_c8En          = input.bool(true,  "Enable", group=grpMom)
i_rsiLen        = input.int(14, "RSI Length", group=grpMom)
i_rsiBullThr    = input.int(50, "RSI Bull Threshold", group=grpMom)
i_rsiBearThr    = input.int(50, "RSI Bear Threshold", group=grpMom)
i_useDiv        = input.bool(false, "Use Divergence Filter", group=grpMom)

// ── Session / Kill Zones (Condition 9) ──
grpSess = "C9: Session Filter"
i_c9En          = input.bool(true,  "Enable", group=grpSess)
i_nyEn          = input.bool(true,  "NY Session", group=grpSess)
i_ldnEn         = input.bool(false, "London Session", group=grpSess)
i_nyStart       = input.int(9,  "NY Start Hour", group=grpSess)
i_nyEnd         = input.int(16, "NY End Hour",   group=grpSess)
i_ldnStart      = input.int(3,  "London Start Hour", group=grpSess)
i_ldnEnd        = input.int(8,  "London End Hour",   group=grpSess)
i_monEn         = input.bool(true,  "Monday",    group=grpSess)
i_tueEn         = input.bool(true,  "Tuesday",   group=grpSess)
i_wedEn         = input.bool(true,  "Wednesday", group=grpSess)
i_thuEn         = input.bool(true,  "Thursday",  group=grpSess)
i_friEn         = input.bool(true,  "Friday",    group=grpSess)

// ── Confluence ──
grpConf = "Confluence"
i_minScore      = input.int(6, "Min Score Required", minval=1, maxval=14, group=grpConf)

// ── Exit / Stop ──
grpExit = "Exit Settings"
i_stopType      = input.string("ATR", "Stop Type", options=["ATR","ORB Mid","Opposite ORB","Fixed Points"], group=grpExit)
i_fixedStop     = input.float(20.0, "Fixed Stop (points)", group=grpExit)
i_atrStopMult   = input.float(1.5,  "ATR Stop Multiplier", group=grpExit)
i_tp1R          = input.float(1.0,  "TP1 R Multiple", group=grpExit)
i_tp2R          = input.float(2.0,  "TP2 R Multiple", group=grpExit)
i_tp1Pct        = input.float(50.0, "TP1 Exit %", group=grpExit)
i_bePct         = input.float(0.0,  "Breakeven Offset (ticks)", group=grpExit)
i_trailAfterTP1 = input.bool(true,  "Smart Trail after TP1", group=grpExit)

// ── Risk Controls ──
grpRisk = "Prop Firm Risk Controls"
i_dailyMaxLoss  = input.float(500.0,  "Daily Max Loss ($)", group=grpRisk)
i_weeklyMaxLoss = input.float(1000.0, "Weekly Max Loss ($)", group=grpRisk)
i_maxTradesDay  = input.int(5,   "Max Trades/Day", group=grpRisk)
i_maxConsecLoss = input.int(3,   "Max Consecutive Losses", group=grpRisk)
i_dailyPT       = input.float(0.0,   "Daily Profit Target (0=off)", group=grpRisk)
i_weeklyPT      = input.float(0.0,   "Weekly Profit Target (0=off)", group=grpRisk)

// ── Visuals ──
grpVis = "Visuals"
i_showORB       = input.bool(true,  "Show ORB Levels", group=grpVis)
i_showHTFEMA    = input.bool(true,  "Show HTF EMA (15m)", group=grpVis)
i_showDash      = input.bool(true,  "Show Dashboard", group=grpVis)

// ══════════════════════════════════════════════════════════════════
// SECTION 2: SESSIONS
// ══════════════════════════════════════════════════════════════════

tz = "America/New_York"
nyHour   = hour(time, tz)
nyMinute = minute(time, tz)
dow      = dayofweek(time, tz)

inNY     = (nyHour >= i_nyStart and nyHour < i_nyEnd)
inLdn    = (nyHour >= i_ldnStart and nyHour < i_ldnEnd)
inSession = (i_nyEn and inNY) or (i_ldnEn and inLdn)

dayOK = (dow == dayofweek.monday and i_monEn) or (dow == dayofweek.tuesday and i_tueEn) or (dow == dayofweek.wednesday and i_wedEn) or (dow == dayofweek.thursday and i_thuEn) or (dow == dayofweek.friday and i_friEn)

pastCutoff = (nyHour > i_cutoffHour) or (nyHour == i_cutoffHour and nyMinute >= i_cutoffMin)

// ══════════════════════════════════════════════════════════════════
// SECTION 3: ORB LOGIC
// ══════════════════════════════════════════════════════════════════

inORBWindow = not na(time(timeframe.period, i_orbStart, tz))

var float orbHigh = na
var float orbLow  = na
var bool  orbSet  = false

// Reset on new day
newDay = ta.change(time("D")) != 0
if newDay
    orbHigh := na
    orbLow  := na
    orbSet  := false

if inORBWindow
    orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
    orbLow  := na(orbLow)  ? low  : math.min(orbLow,  low)

// Lock ORB after window closes
orbWindowClosed = not inORBWindow and not na(orbHigh)
if orbWindowClosed and not orbSet
    orbSet := true

orbMid = (not na(orbHigh) and not na(orbLow)) ? (orbHigh + orbLow) / 2 : na

// Breakout detection
longBreakout  = orbSet and close > orbHigh
shortBreakout = orbSet and close < orbLow

// Retest logic
var bool retestLongReady  = false
var bool retestShortReady = false
var bool retestLongFired  = false
var bool retestShortFired = false

orbRange = not na(orbHigh) and not na(orbLow) ? orbHigh - orbLow : 0.0
retestTol = orbRange * (i_retestTol / 100.0)

if newDay
    retestLongReady  := false
    retestShortReady := false
    retestLongFired  := false
    retestShortFired := false

if longBreakout and not retestLongFired
    retestLongReady := true
if shortBreakout and not retestShortFired
    retestShortReady := true

retestLong  = retestLongReady  and low <= orbHigh + retestTol and close > orbHigh
retestShort = retestShortReady and high >= orbLow - retestTol and close < orbLow

longSignalRaw  = orbSet and (i_retestMode ? retestLong  : longBreakout)  and not pastCutoff
shortSignalRaw = orbSet and (i_retestMode ? retestShort : shortBreakout) and not pastCutoff

// ══════════════════════════════════════════════════════════════════
// SECTION 4: HTF TREND
// ══════════════════════════════════════════════════════════════════

htfClose = request.security(syminfo.tickerid, i_htfTF, close, lookahead=barmerge.lookahead_off)
htfFast  = request.security(syminfo.tickerid, i_htfTF, ta.ema(close, i_htfFastLen), lookahead=barmerge.lookahead_off)
htfSlow  = request.security(syminfo.tickerid, i_htfTF, ta.ema(close, i_htfSlowLen), lookahead=barmerge.lookahead_off)

htfBull = htfFast > htfSlow and close > htfFast
htfBear = htfFast < htfSlow and close < htfFast

c1Long  = not i_c1En or htfBull
c1Short = not i_c1En or htfBear
c1ScoreLong  = i_c1En ? (htfBull ? 1 : 0) : 0
c1ScoreShort = i_c1En ? (htfBear ? 1 : 0) : 0

// ══════════════════════════════════════════════════════════════════
// SECTION 5: SMC LOGIC (BOS / CHoCH / Sweep / OB / FVG)
// ══════════════════════════════════════════════════════════════════

// ── Swing Highs / Lows ──
swingHigh = ta.pivothigh(high, i_pivLen, i_pivLen)
swingLow  = ta.pivotlow(low,  i_pivLen, i_pivLen)

var float lastSwingHigh = na
var float lastSwingLow  = na
var float prevSwingHigh = na
var float prevSwingLow  = na

if not na(swingHigh)
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := swingHigh
if not na(swingLow)
    prevSwingLow := lastSwingLow
    lastSwingLow := swingLow

// ── BOS / CHoCH ──
var bool lastStructureBull = false
var bool lastStructureBear = false

bullBOS = not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
bearBOS = not na(lastSwingLow)  and close < lastSwingLow  and close[1] >= lastSwingLow

// CHoCH: structure change after opposite trend
var bool inBearTrend = false
var bool inBullTrend = false
bullCHoCH = inBearTrend and bullBOS
bearCHoCH = inBullTrend and bearBOS

if bullBOS
    inBullTrend := true
    inBearTrend := false
if bearBOS
    inBearTrend := true
    inBullTrend := false

c2Long  = i_c2En ? (bullBOS or bullCHoCH) : false
c2Short = i_c2En ? (bearBOS or bearCHoCH) : false
c2ScoreLong  = i_c2En ? (c2Long  ? i_c2Score : 0) : 0
c2ScoreShort = i_c2En ? (c2Short ? i_c2Score : 0) : 0

// ── Liquidity Sweep (Condition 3) ──
recentHigh = ta.highest(high, i_liqLen)[1]
recentLow  = ta.lowest(low,   i_liqLen)[1]

bullSweep = low < recentLow and close > recentLow
bearSweep = high > recentHigh and close < recentHigh

c3Long  = i_c3En ? bullSweep : false
c3Short = i_c3En ? bearSweep : false
c3ScoreLong  = i_c3En ? (bullSweep ? 1 : 0) : 0
c3ScoreShort = i_c3En ? (bearSweep ? 1 : 0) : 0

// ── Order Blocks (Condition 4) ──
// Bullish OB = last bearish candle before bullish BOS
// Bearish OB = last bullish candle before bearish BOS
var float bullOBHigh = na
var float bullOBLow  = na
var float bearOBHigh = na
var float bearOBLow  = na
var bool  bullOBActive = false
var bool  bearOBActive = false

if bullBOS
    // walk back to find last bearish candle
    for i = 1 to 5
        if close[i] < open[i]
            bullOBHigh   := high[i]
            bullOBLow    := low[i]
            bullOBActive := true
            break

if bearBOS
    for i = 1 to 5
        if close[i] > open[i]
            bearOBHigh   := high[i]
            bearOBLow    := low[i]
            bearOBActive := true
            break

// Mitigation check
mitPct = i_obMitPct / 100.0
if bullOBActive and not na(bullOBHigh)
    float mitLevel = bullOBLow + (bullOBHigh - bullOBLow) * mitPct
    if close < mitLevel
        bullOBActive := false

if bearOBActive and not na(bearOBHigh)
    float mitLevel = bearOBHigh - (bearOBHigh - bearOBLow) * mitPct
    if close > mitLevel
        bearOBActive := false

inBullOB = bullOBActive and not na(bullOBHigh) and low <= bullOBHigh and close >= bullOBLow
inBearOB = bearOBActive and not na(bearOBHigh) and high >= bearOBLow and close <= bearOBHigh

c4Long  = i_c4En ? inBullOB : false
c4Short = i_c4En ? inBearOB : false
c4ScoreLong  = i_c4En ? (inBullOB ? 1 : 0) : 0
c4ScoreShort = i_c4En ? (inBearOB ? 1 : 0) : 0

// ── FVG (Condition 5) ──
// Bullish FVG: low[0] > high[2]
// Bearish FVG: high[0] < low[2]
bullFVG = low > high[2]
bearFVG = high < low[2]

var float bullFVGTop  = na
var float bullFVGBot  = na
var int   bullFVGBar  = na
var float bearFVGTop  = na
var float bearFVGBot  = na
var int   bearFVGBar  = na

if bullFVG
    bullFVGTop := low
    bullFVGBot := high[2]
    bullFVGBar := bar_index

if bearFVG
    bearFVGTop := low[2]
    bearFVGBot := high
    bearFVGBar := bar_index

bullFVGAge  = not na(bullFVGBar) ? bar_index - bullFVGBar : 999
bearFVGAge  = not na(bearFVGBar) ? bar_index - bearFVGBar : 999

inBullFVG = not na(bullFVGTop) and bullFVGAge <= i_fvgMaxBars and close >= bullFVGBot and close <= bullFVGTop
inBearFVG = not na(bearFVGTop) and bearFVGAge <= i_fvgMaxBars and close >= bearFVGBot and close <= bearFVGTop

c5Long  = i_c5En ? inBullFVG : false
c5Short = i_c5En ? inBearFVG : false
c5ScoreLong  = i_c5En ? (inBullFVG ? 1 : 0) : 0
c5ScoreShort = i_c5En ? (inBearFVG ? 1 : 0) : 0

// ══════════════════════════════════════════════════════════════════
// SECTION 6: VOLUME FLOW
// ══════════════════════════════════════════════════════════════════

volMA = ta.sma(volume, i_volMALen)
volAbove = volume > volMA
bullCandle = close > open
bearCandle = close < open

// OBV
obv = ta.cum(math.sign(close - close[1]) * volume)
obvSlope = obv - obv[3]

c6Long  = i_c6En ? (volAbove and bullCandle and (not i_useOBV or obvSlope > 0)) : false
c6Short = i_c6En ? (volAbove and bearCandle and (not i_useOBV or obvSlope < 0)) : false
c6ScoreLong  = i_c6En ? (c6Long  ? 1 : 0) : 0
c6ScoreShort = i_c6En ? (c6Short ? 1 : 0) : 0

// ══════════════════════════════════════════════════════════════════
// SECTION 7: SMART TRAIL
// ══════════════════════════════════════════════════════════════════

atr = ta.atr(i_atrLen)

var float trail      = na
var int   trailDir   = 0  // 1=bull, -1=bear

trailStep = atr * i_atrMult

if na(trail)
    trail := close

trailUp   = close - trailStep
trailDown = close + trailStep

if close > trail
    trail    := math.max(trail, trailUp)
    trailDir := 1
else if close < trail
    trail    := math.min(trail, trailDown)
    trailDir := -1

trailBull = trailDir == 1
trailBear = trailDir == -1

c7Long  = i_c7En ? trailBull : false
c7Short = i_c7En ? trailBear : false
c7ScoreLong  = i_c7En ? (trailBull ? 1 : 0) : 0
c7ScoreShort = i_c7En ? (trailBear ? 1 : 0) : 0

// ══════════════════════════════════════════════════════════════════
// SECTION 8: MOMENTUM
// ══════════════════════════════════════════════════════════════════

rsi = ta.rsi(close, i_rsiLen)

rsiBull = rsi >= i_rsiBullThr
rsiBear = rsi <= i_rsiBearThr

// Simple divergence using pivots (non-repainting)
rsiPivHigh = ta.pivothigh(rsi,  i_pivLen, i_pivLen)
rsiPivLow  = ta.pivotlow(rsi,   i_pivLen, i_pivLen)
pricePivH  = ta.pivothigh(high, i_pivLen, i_pivLen)
pricePivL  = ta.pivotlow(low,   i_pivLen, i_pivLen)

var float lastRsiH = na
var float lastPrcH = na
var float lastRsiL = na
var float lastPrcL = na
var float prevRsiH = na
var float prevPrcH = na
var float prevRsiL = na
var float prevPrcL = na

if not na(rsiPivHigh)
    prevRsiH := lastRsiH
    prevPrcH := lastPrcH
    lastRsiH := rsiPivHigh
    lastPrcH := pricePivH

if not na(rsiPivLow)
    prevRsiL := lastRsiL
    prevPrcL := lastPrcL
    lastRsiL := rsiPivLow
    lastPrcL := pricePivL

// Bearish div: price higher high, RSI lower high
bearDiv = i_useDiv and not na(prevPrcH) and not na(lastPrcH) and lastPrcH > prevPrcH and lastRsiH < prevRsiH
// Bullish div: price lower low, RSI higher low
bullDiv = i_useDiv and not na(prevPrcL) and not na(lastPrcL) and lastPrcL < prevPrcL and lastRsiL > prevRsiL

c8Long  = i_c8En ? (rsiBull and not bearDiv) : false
c8Short = i_c8En ? (rsiBear and not bullDiv) : false
c8ScoreLong  = i_c8En ? (c8Long  ? 1 : 0) : 0
c8ScoreShort = i_c8En ? (c8Short ? 1 : 0) : 0

// ══════════════════════════════════════════════════════════════════
// SECTION 9: CONFLUENCE SCORE
// ══════════════════════════════════════════════════════════════════

c9Long  = i_c9En ? (inSession and dayOK) : false
c9Short = i_c9En ? (inSession and dayOK) : false
c9ScoreLong  = i_c9En ? (c9Long  ? 1 : 0) : 0
c9ScoreShort = i_c9En ? (c9Short ? 1 : 0) : 0

scoreLong  = c1ScoreLong  + c2ScoreLong  + c3ScoreLong  + c4ScoreLong  + c5ScoreLong  + c6ScoreLong  + c7ScoreLong  + c8ScoreLong  + c9ScoreLong
scoreShort = c1ScoreShort + c2ScoreShort + c3ScoreShort + c4ScoreShort + c5ScoreShort + c6ScoreShort + c7ScoreShort + c8ScoreShort + c9ScoreShort

// ══════════════════════════════════════════════════════════════════
// SECTION 10: RISK CONTROLS
// ══════════════════════════════════════════════════════════════════

// Day/week change detection
var int  lastDay  = na
var int  lastWeek = na
isNewTradingDay  = na(lastDay)  or dayofmonth != lastDay
isNewTradingWeek = na(lastWeek) or weekofyear != lastWeek

if isNewTradingDay
    lastDay := dayofmonth
if isNewTradingWeek
    lastWeek := weekofyear

// Baseline P/L snapshots reset each day/week
// Pine cannot track intraday realized P/L perfectly; we approximate using
// strategy.netprofit snapshots and position-level P/L.
var float dayStartPnL  = 0.0
var float weekStartPnL = 0.0
var int   dailyTrades  = 0
var int   consecLoss   = 0
var bool  riskLockout  = false

if isNewTradingDay
    dayStartPnL := strategy.netprofit
    dailyTrades := 0

if isNewTradingWeek
    weekStartPnL := strategy.netprofit

// Running daily/weekly P/L
dailyPnL  = strategy.netprofit - dayStartPnL
weeklyPnL = strategy.netprofit - weekStartPnL

// Open position unrealized
openPnL = strategy.openprofit

effectiveDailyPnL  = dailyPnL  + openPnL
effectiveWeeklyPnL = weeklyPnL + openPnL

// Lockout checks
dailyLoss    = effectiveDailyPnL  <= -math.abs(i_dailyMaxLoss)
weeklyLoss   = effectiveWeeklyPnL <= -math.abs(i_weeklyMaxLoss)
maxTrades    = dailyTrades >= i_maxTradesDay
maxConsec    = consecLoss  >= i_maxConsecLoss
dailyPTHit   = i_dailyPT  > 0 and effectiveDailyPnL  >= i_dailyPT
weeklyPTHit  = i_weeklyPT > 0 and effectiveWeeklyPnL >= i_weeklyPT

riskLockout := dailyLoss or weeklyLoss or maxTrades or maxConsec or dailyPTHit or weeklyPTHit

// Update counters on trade close
var int lastClosedTrades = 0
int numClosed = strategy.closedtrades
bool newClosed = numClosed > lastClosedTrades

if newClosed
    dailyTrades += 1
    float lastTradeProfit = strategy.closedtrades.profit(numClosed - 1)
    if lastTradeProfit < 0
        consecLoss += 1
    else
        consecLoss := 0
    lastClosedTrades := numClosed

// ══════════════════════════════════════════════════════════════════
// SECTION 11: ENTRIES
// ══════════════════════════════════════════════════════════════════

// Must declare function before use
stopDist(isLong) =>
    float sd = switch i_stopType
        "ATR"          => atr * i_atrStopMult
        "ORB Mid"      => isLong ? (close - orbMid) : (orbMid - close)
        "Opposite ORB" => isLong ? (close - orbLow) : (orbHigh - close)
        =>               i_fixedStop  // Fixed Points — user inputs in points directly
    math.max(nz(sd, atr * i_atrStopMult), syminfo.mintick)

canLong  = (i_tradeDir == "Long Only" or i_tradeDir == "Both") and scoreLong  >= i_minScore and longSignalRaw  and dayOK and inSession and c1Long  and not riskLockout and strategy.position_size == 0
canShort = (i_tradeDir == "Short Only" or i_tradeDir == "Both") and scoreShort >= i_minScore and shortSignalRaw and dayOK and inSession and c1Short and not riskLockout and strategy.position_size == 0

var float entryPrice = na
var float stopDst    = na
var float tp1Price   = na
var float tp2Price   = na
var float stopPrice  = na
var bool  tp1Hit     = false

// Entry orders
if canLong
    entryPrice := close
    stopDst    := stopDist(true)
    stopPrice  := entryPrice - stopDst
    tp1Price   := entryPrice + stopDst * i_tp1R
    tp2Price   := entryPrice + stopDst * i_tp2R
    tp1Hit     := false
    strategy.entry("Long", strategy.long, qty=i_qty)

if canShort
    entryPrice := close
    stopDst    := stopDist(false)
    stopPrice  := entryPrice + stopDst
    tp1Price   := entryPrice - stopDst * i_tp1R
    tp2Price   := entryPrice - stopDst * i_tp2R
    tp1Hit     := false
    strategy.entry("Short", strategy.short, qty=i_qty)

// ══════════════════════════════════════════════════════════════════
// SECTION 12: EXITS
// ══════════════════════════════════════════════════════════════════

tp1Qty = int(math.round(i_qty * (i_tp1Pct / 100.0)))
tp2Qty = math.max(i_qty - tp1Qty, 0)

isLong  = strategy.position_size > 0
isShort = strategy.position_size < 0

// Detect TP1 hit for breakeven logic
if isLong  and high >= tp1Price and not tp1Hit
    tp1Hit := true
if isShort and low  <= tp1Price and not tp1Hit
    tp1Hit := true
if strategy.position_size == 0
    tp1Hit := false

// Breakeven stop after TP1 — offset in ticks from entry
beOffset    = i_bePct * syminfo.mintick
beStopLong  = nz(entryPrice, close) + beOffset
beStopShort = nz(entryPrice, close) - beOffset

// Active stop — after TP1 use breakeven + optional smart trail
activeStopLong  = tp1Hit ? (i_trailAfterTP1 ? math.max(beStopLong,  nz(trail, beStopLong))  : beStopLong)  : nz(stopPrice, close - atr)
activeStopShort = tp1Hit ? (i_trailAfterTP1 ? math.min(beStopShort, nz(trail, beStopShort)) : beStopShort) : nz(stopPrice, close + atr)

if isLong
    strategy.exit("L-TP1", "Long",  qty=tp1Qty, limit=tp1Price, stop=activeStopLong,  comment="TP1")
    strategy.exit("L-TP2", "Long",  qty=tp2Qty, limit=tp2Price, stop=activeStopLong,  comment="TP2")

if isShort
    strategy.exit("S-TP1", "Short", qty=tp1Qty, limit=tp1Price, stop=activeStopShort, comment="TP1")
    strategy.exit("S-TP2", "Short", qty=tp2Qty, limit=tp2Price, stop=activeStopShort, comment="TP2")

// EOD close
if pastCutoff and strategy.position_size != 0
    strategy.close_all(comment="EOD")

// ══════════════════════════════════════════════════════════════════
// SECTION 13: PLOTS & DASHBOARD
// ══════════════════════════════════════════════════════════════════

// ── ORB Levels ──
plot(i_showORB and orbSet ? orbHigh : na, "ORB High", color=color.new(color.green, 0), linewidth=2, style=plot.style_line)
plot(i_showORB and orbSet ? orbLow  : na, "ORB Low",  color=color.new(color.red,   0), linewidth=2, style=plot.style_line)
plot(i_showORB and orbSet ? orbMid  : na, "ORB Mid",  color=color.new(color.gray,  30), linewidth=1, style=plot.style_line)

// ── HTF EMA ──
plot(i_showHTFEMA ? htfFast : na, "HTF Fast EMA", color=color.new(color.blue,  0), linewidth=1)
plot(i_showHTFEMA ? htfSlow : na, "HTF Slow EMA", color=color.new(color.orange,0), linewidth=1)

// ── Smart Trail ──
plot(i_showTrail ? trail : na, "Smart Trail",
     color = trailBull ? color.new(color.lime, 0) : color.new(color.red, 0),
     linewidth=2)

// ── Entry Signals ──
plotshape(canLong,  "Long Entry",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.green,0), size=size.small)
plotshape(canShort, "Short Entry", style=shape.triangledown, location=location.abovebar, color=color.new(color.red,  0), size=size.small)

// ── BOS / CHoCH markers ──
plotshape(bullBOS,  "Bull BOS",  style=shape.labelup,   location=location.belowbar, color=color.new(color.teal, 0),   size=size.tiny, text="BOS")
plotshape(bearBOS,  "Bear BOS",  style=shape.labeldown, location=location.abovebar, color=color.new(color.maroon, 0), size=size.tiny, text="BOS")
plotshape(bullCHoCH,"Bull CHoCH",style=shape.labelup,   location=location.belowbar, color=color.new(color.aqua, 0),   size=size.tiny, text="CHoCH")
plotshape(bearCHoCH,"Bear CHoCH",style=shape.labeldown, location=location.abovebar, color=color.new(color.fuchsia,0), size=size.tiny, text="CHoCH")

// ── Liquidity Sweep markers ──
plotshape(bullSweep, "Bull Sweep", style=shape.xcross, location=location.belowbar, color=color.new(color.yellow,0), size=size.tiny)
plotshape(bearSweep, "Bear Sweep", style=shape.xcross, location=location.abovebar, color=color.new(color.yellow,0), size=size.tiny)

// ── OB Boxes ──
var box bullOBBox = na
var box bearOBBox = na

if i_showOB and i_c4En
    if bullBOS and bullOBActive and not na(bullOBHigh)
        if not na(bullOBBox)
            box.delete(bullOBBox)
        bullOBBox := box.new(bar_index - i_pivLen, bullOBHigh, bar_index + 20, bullOBLow,
             border_color=color.new(color.green,0), bgcolor=color.new(color.green,85))
    if bearBOS and bearOBActive and not na(bearOBHigh)
        if not na(bearOBBox)
            box.delete(bearOBBox)
        bearOBBox := box.new(bar_index - i_pivLen, bearOBHigh, bar_index + 20, bearOBLow,
             border_color=color.new(color.red,0), bgcolor=color.new(color.red,85))

// ── FVG Boxes ──
var box bullFVGBox = na
var box bearFVGBox = na

if i_showFVG and i_c5En
    if bullFVG
        if not na(bullFVGBox)
            box.delete(bullFVGBox)
        bullFVGBox := box.new(bar_index - 2, bullFVGTop, bar_index + 20, bullFVGBot,
             border_color=color.new(color.teal,0), bgcolor=color.new(color.teal,88))
    if bearFVG
        if not na(bearFVGBox)
            box.delete(bearFVGBox)
        bearFVGBox := box.new(bar_index - 2, bearFVGTop, bar_index + 20, bearFVGBot,
             border_color=color.new(color.fuchsia,0), bgcolor=color.new(color.fuchsia,88))

// ── Dashboard ──
htfTrendStr   = htfBull ? "Bullish" : htfBear ? "Bearish" : "Neutral"
orbStatusStr  = inORBWindow ? "Building" : orbSet ? "Set" : "Waiting"
sessStr       = inSession ? "Active" : "Closed"
dayStr        = dayOK ? "Yes" : "No"
trailDirStr   = trailBull ? "Bullish" : "Bearish"
lockoutStr    = riskLockout ? "LOCKED" : "OK"
posStr        = isLong ? "Long" : isShort ? "Short" : "Flat"

if i_showDash and barstate.islast
    var table dash = table.new(position.top_right, 2, 14,
         bgcolor=color.new(color.black, 80),
         border_color=color.new(color.gray, 50), border_width=1,
         frame_color=color.new(color.gray,30), frame_width=1)

    // Header
    table.cell(dash, 0, 0, "SB v2 Dashboard", text_color=color.white, bgcolor=color.new(color.navy,20), text_size=size.small)
    table.cell(dash, 1, 0, "", bgcolor=color.new(color.navy,20))

    // Rows
    table.cell(dash, 0, 1,  "Long Score",   text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 1,  str.tostring(scoreLong) + " / " + str.tostring(i_minScore),
               text_color=scoreLong >= i_minScore ? color.lime : color.orange, text_size=size.small)

    table.cell(dash, 0, 2,  "Short Score",  text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 2,  str.tostring(scoreShort) + " / " + str.tostring(i_minScore),
               text_color=scoreShort >= i_minScore ? color.lime : color.orange, text_size=size.small)

    table.cell(dash, 0, 3,  "HTF Trend",    text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 3,  htfTrendStr,
               text_color=htfBull ? color.lime : htfBear ? color.red : color.gray, text_size=size.small)

    table.cell(dash, 0, 4,  "ORB Status",   text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 4,  orbStatusStr,   text_color=color.white,  text_size=size.small)

    table.cell(dash, 0, 5,  "Session",      text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 5,  sessStr,
               text_color=inSession ? color.lime : color.gray, text_size=size.small)

    table.cell(dash, 0, 6,  "Day OK",       text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 6,  dayStr,
               text_color=dayOK ? color.lime : color.gray, text_size=size.small)

    table.cell(dash, 0, 7,  "Smart Trail",  text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 7,  trailDirStr,
               text_color=trailBull ? color.lime : color.red, text_size=size.small)

    table.cell(dash, 0, 8,  "Daily P/L",    text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 8,  "$" + str.tostring(math.round(effectiveDailyPnL, 2)),
               text_color=effectiveDailyPnL >= 0 ? color.lime : color.red, text_size=size.small)

    table.cell(dash, 0, 9,  "Weekly P/L",   text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 9,  "$" + str.tostring(math.round(effectiveWeeklyPnL, 2)),
               text_color=effectiveWeeklyPnL >= 0 ? color.lime : color.red, text_size=size.small)

    table.cell(dash, 0, 10, "Risk",         text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 10, lockoutStr,
               text_color=riskLockout ? color.red : color.lime, text_size=size.small)

    table.cell(dash, 0, 11, "Position",     text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 11, posStr,
               text_color=isLong ? color.lime : isShort ? color.red : color.gray, text_size=size.small)

    table.cell(dash, 0, 12, "Trades Today", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 12, str.tostring(dailyTrades) + " / " + str.tostring(i_maxTradesDay),
               text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 13, "Consec Loss",  text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 13, str.tostring(consecLoss) + " / " + str.tostring(i_maxConsecLoss),
               text_color=consecLoss >= i_maxConsecLoss ? color.red : color.white, text_size=size.small)
