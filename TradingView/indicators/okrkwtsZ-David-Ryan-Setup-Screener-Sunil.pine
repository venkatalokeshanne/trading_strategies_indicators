//@version=6
indicator("David Ryan Setup Screener", overlay=true)

// ============ INPUTS ============
benchmarkSym   = input.symbol("NSE:NIFTYSMLCAP100", "RS Benchmark")
nearHighPct    = input.float(3.0, "Within % of 52W High", minval=0.1)
baseWeeks      = input.int(6, "Min Base Length (weeks)", minval=2)
baseTightPct   = input.float(15.0, "Max Base Range %", minval=1)
volSpikeMult   = input.float(1.5, "Volume Spike Multiple (vs 50d avg)", minval=1)
rsLookback     = input.int(252, "RS New-High Lookback (bars)")

// ============ #2 STRONG UPTREND (stacked MAs) ============
sma50  = ta.sma(close, 50)
sma150 = ta.sma(close, 150)
sma200 = ta.sma(close, 200)
uptrend = not na(sma200[20]) and close > sma50 and sma50 > sma150 and sma150 > sma200 and sma200 > sma200[20]

// ============ #3 BREAKING TO NEW HIGHS ============
high52w   = ta.highest(high, 252)
nearHigh  = not na(high52w) and close >= high52w * (1 - nearHighPct / 100)

// New 52-week high: today's high exceeds the highest high of the prior 252 bars (excluding today)
prev52wHigh = ta.highest(high[1], 252)
isNew52wHigh = not na(prev52wHigh) and high > prev52wHigh

// All-time high proxy: highest high over max available history (capped by chart's loaded bars)
athLookback = 5000
allTimeHigh   = ta.highest(high, athLookback)
prevAllTimeHigh = ta.highest(high[1], athLookback)
isNewATH = not na(prevAllTimeHigh) and high > prevAllTimeHigh

// ============ #5 PROPER BASE (6+ weeks tight consolidation) ============
baseBars   = baseWeeks * 5   // approx trading days per week
baseHigh   = ta.highest(high, baseBars)
baseLow    = ta.lowest(low, baseBars)
baseRange  = (baseHigh - baseLow) / baseLow * 100
properBase = not na(baseRange) and baseRange <= baseTightPct

// ============ #6 WEEKLY CHART CLEAN (HTF trend filter) ============
wSma10 = request.security(syminfo.tickerid, "W", ta.sma(close, 10))
weeklyClean = not na(wSma10) and close > wSma10

// ============ #7 RS LINE NEW HIGH / UPTREND ============
benchClose = request.security(benchmarkSym, timeframe.period, close)
rsLine     = close / benchClose
rsSma50    = ta.sma(rsLine, 50)
rsUptrend  = not na(rsSma50) and rsLine > rsSma50
rsHighest  = ta.highest(rsLine, rsLookback)
rsNewHigh  = not na(rsHighest) and rsLine >= rsHighest * 0.99

// ============ #8 UP DAY ON VOLUME ============
avgVol50   = ta.sma(volume, 50)
upDayVol   = not na(avgVol50) and close > close[1] and volume > avgVol50 * volSpikeMult

// ============ TOP GAINER + VOLUME (5%+ move, 2-4x avg volume) ============
gainPct        = input.float(5.0, "Min % Gain for Top Gainer", minval=0.1)
volMultLow     = input.float(2.0, "Min Volume Multiple", minval=1)
volMultHigh    = input.float(4.0, "Max Volume Multiple", minval=1)
pctChange      = (close - close[1]) / close[1] * 100
volRatio       = not na(avgVol50) and avgVol50 != 0 ? volume / avgVol50 : na
isTopGainerVol = not na(pctChange) and not na(volRatio) and pctChange >= gainPct and volRatio >= volMultLow and volRatio <= volMultHigh

// ============ #12 50D / 10W STOP REFERENCE ============
wSma10Plot = wSma10  // 10-week MA acts as the trailing stop reference
plot(sma50, "50D MA", color=color.orange, linewidth=1)
plot(wSma10Plot, "10W MA (Weekly)", color=color.red, linewidth=2)
plot(high52w, "52W High", color=color.gray, style=plot.style_circles)

// ============ COMPOSITE SCORE (of the 7 chartable criteria) ============
scorePart1 = (uptrend ? 1 : 0) + (nearHigh ? 1 : 0) + (properBase ? 1 : 0)
scorePart2 = (weeklyClean ? 1 : 0) + ((rsUptrend or rsNewHigh) ? 1 : 0) + (upDayVol ? 1 : 0)
score = scorePart1 + scorePart2

bgcolor(score >= 5 ? color.new(color.green, 85) : score >= 3 ? color.new(color.yellow, 88) : na)

// ============ PLOTSHAPE SIGNAL ============
plotshape(score >= 5 and nearHigh, title="Strong Setup", location=location.belowbar,
     style=shape.triangleup, size=size.small, color=color.green)

plotshape(isNew52wHigh, title="New 52W High", location=location.abovebar,
     style=shape.labelup, size=size.tiny, color=color.new(color.orange, 0), text="52WH", textcolor=color.white)

plotshape(isNewATH, title="New All-Time High", location=location.abovebar,
     style=shape.labelup, size=size.small, color=color.new(color.purple, 0), text="ATH", textcolor=color.white)

plotshape(isTopGainerVol, title="Top Gainer + Volume", location=location.belowbar,
     style=shape.labelup, size=size.small, color=color.new(color.blue, 0), text="G+V", textcolor=color.white)

// ============ TABLE: LIVE CRITERIA READOUT ============
var table t = table.new(position.top_right, 2, 8, border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "Criterion", bgcolor=color.gray, text_color=color.white)
    table.cell(t, 1, 0, "Status", bgcolor=color.gray, text_color=color.white)
    table.cell(t, 0, 1, "2. Uptrend")
    table.cell(t, 1, 1, uptrend ? "✓" : "✗", text_color = uptrend ? color.green : color.red)
    table.cell(t, 0, 2, "3. Near 52W High")
    table.cell(t, 1, 2, nearHigh ? "✓" : "✗", text_color = nearHigh ? color.green : color.red)
    table.cell(t, 0, 3, "5. Proper Base")
    table.cell(t, 1, 3, properBase ? "✓" : "✗", text_color = properBase ? color.green : color.red)
    table.cell(t, 0, 4, "6. Weekly Clean")
    table.cell(t, 1, 4, weeklyClean ? "✓" : "✗", text_color = weeklyClean ? color.green : color.red)
    table.cell(t, 0, 5, "7. RS Strength")
    table.cell(t, 1, 5, (rsUptrend or rsNewHigh) ? "✓" : "✗", text_color = (rsUptrend or rsNewHigh) ? color.green : color.red)
    table.cell(t, 0, 6, "8. Vol Spike")
    table.cell(t, 1, 6, upDayVol ? "✓" : "✗", text_color = upDayVol ? color.green : color.red)
    table.cell(t, 0, 7, "Score /6")
    table.cell(t, 1, 7, str.tostring(score), text_color=color.white, bgcolor=color.blue)

// ============ DEBUG VALUE TABLE ============
var table dbg = table.new(position.bottom_right, 2, 9, border_width=1)
if barstate.islast
    table.cell(dbg, 0, 0, "Debug Values", bgcolor=color.navy, text_color=color.white)
    table.cell(dbg, 1, 0, "", bgcolor=color.navy)
    table.cell(dbg, 0, 1, "nearHigh")
    table.cell(dbg, 1, 1, str.tostring(nearHigh))
    table.cell(dbg, 0, 2, "high52w")
    table.cell(dbg, 1, 2, str.tostring(high52w, format.mintick))
    table.cell(dbg, 0, 3, "baseHigh")
    table.cell(dbg, 1, 3, str.tostring(baseHigh, format.mintick))
    table.cell(dbg, 0, 4, "baseLow")
    table.cell(dbg, 1, 4, str.tostring(baseLow, format.mintick))
    table.cell(dbg, 0, 5, "Bars loaded")
    table.cell(dbg, 1, 5, str.tostring(bar_index + 1) + " (need 252)")
    table.cell(dbg, 0, 6, "New 52W High Today")
    table.cell(dbg, 1, 6, isNew52wHigh ? "YES" : "no", text_color = isNew52wHigh ? color.orange : color.gray)
    table.cell(dbg, 0, 7, "New ATH Today")
    table.cell(dbg, 1, 7, isNewATH ? "YES" : "no", text_color = isNewATH ? color.purple : color.gray)
    table.cell(dbg, 0, 8, "Top Gainer+Vol")
    table.cell(dbg, 1, 8, isTopGainerVol ? ("YES " + str.tostring(pctChange, "#.#") + "% " + str.tostring(volRatio, "#.#") + "x") : "no", text_color = isTopGainerVol ? color.blue : color.gray)

// ============ SCREENER OUTPUT COLUMNS ============
// Pine Screener only reads plot() outputs as columns — booleans/tables are invisible to it.
plot(score, "Score", display=display.data_window)
plot(nearHigh ? 1 : 0, "NearHigh", display=display.data_window)
plot(isNew52wHigh ? 1 : 0, "New52WHigh", display=display.data_window)
plot(isNewATH ? 1 : 0, "NewATH", display=display.data_window)
plot(isTopGainerVol ? 1 : 0, "TopGainerVol", display=display.data_window)
plot(uptrend ? 1 : 0, "Uptrend", display=display.data_window)
plot(properBase ? 1 : 0, "ProperBase", display=display.data_window)
plot(weeklyClean ? 1 : 0, "WeeklyClean", display=display.data_window)
plot((rsUptrend or rsNewHigh) ? 1 : 0, "RSStrength", display=display.data_window)
plot(upDayVol ? 1 : 0, "VolSpike", display=display.data_window)

// ============ ALERT ============
alertcondition(score >= 5 and nearHigh, title="David Ryan Setup Alert",
     message="Stock meets 5+/6 chartable criteria and is near 52W high")

alertcondition(isNew52wHigh, title="New 52-Week High",
     message="{{ticker}} just made a new 52-week high")

alertcondition(isNewATH, title="New All-Time High",
     message="{{ticker}} just made a new all-time high")

alertcondition(isTopGainerVol, title="Top Gainer + Volume Surge",
     message="{{ticker}} up 5%+ with 2-4x average volume")
