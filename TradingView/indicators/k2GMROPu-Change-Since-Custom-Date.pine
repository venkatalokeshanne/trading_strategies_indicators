//@version=6
indicator("Change Since Custom Date", overlay=false)

// Set your specific date here
target_year = input.int(2023, title="Year")
target_month = input.int(10, title="Month")
target_day = input.int(15, title="Day")

// Convert date to a time reference
target_time = timestamp(target_year, target_month, target_day, 0, 0)

// Store the price on that date
var float price_at_date = na
if time >= target_time and na(price_at_date)
    price_at_date := close

// Calculate the percentage change
pct_change = na(price_at_date) ? na : ((close - price_at_date) / price_at_date) * 100

// Plot the result so the screener can read it
plot(pct_change, title="% Gained")
