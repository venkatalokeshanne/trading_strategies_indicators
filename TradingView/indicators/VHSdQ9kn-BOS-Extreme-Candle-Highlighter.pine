//@version=6
indicator("BOS + Extreme Candle Highlighter", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ================= INPUTS =================
pivotLen     = input.int(5, "Pivot Lookback (Left/Right)", minval=1, tooltip="Bars on each side required to confirm a swing high/low")
bullColor    = input.color(color.blue, "Bullish BOS Highlight Color")
bearColor    = input.color(color.red,  "Bearish BOS Highlight Color")
showBosLine  = input.bool(true, "Show BOS Break Line")
bullLineColor = input.color(color.blue, "Bullish Break Line Color")
bearLineColor = input.color(color.red,  "Bearish Break Line Color")
lineWidth     = input.int(1, "Break Line Thickness", minval=1, maxval=10)
showLabel    = input.bool(true, "Show BOS Arrow")
bullArrowColor = input.color(color.blue, "Bullish BOS Arrow Color")
bearArrowColor = input.color(color.red,  "Bearish BOS Arrow Color")
extendRight  = input.bool(false, "Extend Highlight Box to the Right")

limitZones   = input.bool(false, "Limit Number of Zones Shown", group="Declutter")
zonesPerSide = input.int(3, "Zones to Keep (Bullish / Bearish)", minval=1, group="Declutter", tooltip="Keeps only the most recently formed X bullish (blue) zones and X bearish (red) zones. Older zones of each type are removed as new ones form.")

// ================= ZONE TRACKING (for declutter pruning) =================
type Zone
    box   zbox
    line  zline
    label zlabel

var array<Zone> bullZones = array.new<Zone>()
var array<Zone> bearZones = array.new<Zone>()

deleteZone(Zone z) =>
    if not na(z.zbox)
        box.delete(z.zbox)
    if not na(z.zline)
        line.delete(z.zline)
    if not na(z.zlabel)
        label.delete(z.zlabel)

// ================= PIVOT DETECTION =================
ph = ta.pivothigh(pivotLen, pivotLen)
pl = ta.pivotlow(pivotLen, pivotLen)

var float lastPH    = na
var int   lastPHBar = na
var bool  phBroken  = false

var float lastPL    = na
var int   lastPLBar = na
var bool  plBroken  = false

// Trackers for the most extreme candle of the developing leg
var float moveLow    = na   // lowest low since the last pivot low  -> candidate BOS-up origin
var int   moveLowBar = na
var float moveLowTop = na   // that candle's high (for the box)

var float moveHigh    = na  // highest high since the last pivot high -> candidate BOS-down origin
var int   moveHighBar = na
var float moveHighBot = na  // that candle's low (for the box)

// New pivot high confirmed -> reset the "down-leg extreme" tracker
if not na(ph)
    lastPH      := ph
    lastPHBar   := bar_index - pivotLen
    phBroken    := false
    moveHigh    := ph
    moveHighBar := bar_index - pivotLen
    moveHighBot := low[pivotLen]

// New pivot low confirmed -> reset the "up-leg extreme" tracker
if not na(pl)
    lastPL      := pl
    lastPLBar   := bar_index - pivotLen
    plBroken    := false
    moveLow     := pl
    moveLowBar  := bar_index - pivotLen
    moveLowTop  := high[pivotLen]

// Keep updating the extreme as the leg develops
if not na(moveLow) and low < moveLow
    moveLow    := low
    moveLowBar := bar_index
    moveLowTop := high

if not na(moveHigh) and high > moveHigh
    moveHigh    := high
    moveHighBar := bar_index
    moveHighBot := low

// ================= BOS DETECTION =================
bullBOS = not na(lastPH) and not phBroken and ta.crossover(close, lastPH)
bearBOS = not na(lastPL) and not plBroken and ta.crossunder(close, lastPL)

if bullBOS
    phBroken := true
    newBox = box.new(left=moveLowBar - 1, right=moveLowBar + 1, top=moveLowTop, bottom=moveLow, border_color=bullColor, border_width=2, bgcolor=color.new(bullColor, 80), extend=extendRight ? extend.right : extend.none)
    line newLine = na
    label newLabel = na
    if showBosLine
        newLine := line.new(x1=lastPHBar, y1=lastPH, x2=bar_index, y2=lastPH, color=bullLineColor, style=line.style_dashed, width=lineWidth)
    if showLabel
        newLabel := label.new(bar_index, lastPH, "", style=label.style_arrowup, color=color.new(bullArrowColor, 0), size=size.small)
    array.push(bullZones, Zone.new(newBox, newLine, newLabel))
    if limitZones and array.size(bullZones) > zonesPerSide
        deleteZone(array.shift(bullZones))

if bearBOS
    plBroken := true
    newBox = box.new(left=moveHighBar - 1, right=moveHighBar + 1, top=moveHigh, bottom=moveHighBot, border_color=bearColor, border_width=2, bgcolor=color.new(bearColor, 80), extend=extendRight ? extend.right : extend.none)
    line newLine = na
    label newLabel = na
    if showBosLine
        newLine := line.new(x1=lastPLBar, y1=lastPL, x2=bar_index, y2=lastPL, color=bearLineColor, style=line.style_dashed, width=lineWidth)
    if showLabel
        newLabel := label.new(bar_index, lastPL, "", style=label.style_arrowdown, color=color.new(bearArrowColor, 0), size=size.small)
    array.push(bearZones, Zone.new(newBox, newLine, newLabel))
    if limitZones and array.size(bearZones) > zonesPerSide
        deleteZone(array.shift(bearZones))

