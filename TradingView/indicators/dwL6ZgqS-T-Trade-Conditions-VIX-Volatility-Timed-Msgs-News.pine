color vix_bgColor = input.color(color.red, "BG", inline = "VIXWARN_ROW4", group = VIX_GROUP_MAIN)
color vix_textColor = input.color(color.white, "Text", inline = "VIXWARN_ROW4", group = VIX_GROUP_MAIN)

