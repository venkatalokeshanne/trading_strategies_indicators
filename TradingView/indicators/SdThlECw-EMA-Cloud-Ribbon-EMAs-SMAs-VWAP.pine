//@version=6
indicator("EMA Cloud Ribbon + SMAs + VWAP", shorttitle="EMA Cloud+", overlay=true)

// ══════════════════════ EMA CLOUD RIBBON ══════════════════════
grpEMA = "EMA Ribbon"

showEma1 = input.bool(true, "Show EMA 1", group=grpEMA, inline="e1")
len1     = input.int(9,     "Length",     minval=1, group=grpEMA, inline="e1")
col1     = input.color(#2962ff, "",       group=grpEMA, inline="e1")

showEma2 = input.bool(true, "Show EMA 2", group=grpEMA, inline="e2")
len2     = input.int(15,    "Length",     minval=1, group=grpEMA, inline="e2")
col2     = input.color(#26a69a, "",       group=grpEMA, inline="e2")

showEma3 = input.bool(true, "Show EMA 3", group=grpEMA, inline="e3")
len3     = input.int(30,    "Length",     minval=1, group=grpEMA, inline="e3")
col3     = input.color(#ff9800, "",       group=grpEMA, inline="e3")

showEma4 = input.bool(true, "Show EMA 4", group=grpEMA, inline="e4")
len4     = input.int(65,    "Length",     minval=1, group=grpEMA, inline="e4")
col4     = input.color(#787b86, "",       group=grpEMA, inline="e4")

showEma5 = input.bool(true, "Show EMA 5", group=grpEMA, inline="e5")
len5     = input.int(200,   "Length",     minval=1, group=grpEMA, inline="e5")
col5     = input.color(#ef5350, "",       group=grpEMA, inline="e5")

src = input.source(close, "Source", group=grpEMA)

grpCloud = "Cloud Fill"
showCloud = input.bool(true, "Show cloud fills", group=grpCloud)
bullColor = input.color(color.new(color.green, 0), "Bullish fill", group=grpCloud)
bearColor = input.color(color.new(color.red, 0),   "Bearish fill", group=grpCloud)
t1 = input.int(70, "Band 1 transparency (EMA1-EMA2)", minval=0, maxval=100, group=grpCloud)
t2 = input.int(75, "Band 2 transparency (EMA2-EMA3)", minval=0, maxval=100, group=grpCloud)

ema1 = ta.ema(src, len1)
ema2 = ta.ema(src, len2)
ema3 = ta.ema(src, len3)
ema4 = ta.ema(src, len4)
ema5 = ta.ema(src, len5)

p1 = plot(ema1, "EMA 1", color=showEma1 ? col1 : na, linewidth=1)
p2 = plot(ema2, "EMA 2", color=showEma2 ? col2 : na, linewidth=1)
p3 = plot(ema3, "EMA 3", color=showEma3 ? col3 : na, linewidth=1)
p4 = plot(ema4, "EMA 4", color=showEma4 ? col4 : na, linewidth=1)
p5 = plot(ema5, "EMA 5", color=showEma5 ? col5 : na, linewidth=2)

// Cloud ribbon covers EMA 1-3 only (default 9/15/30); EMA 4-5 (65/200) plot as plain lines
fill(p1, p2, color = showCloud ? (ema1 >= ema2 ? color.new(bullColor, t1) : color.new(bearColor, t1)) : na, title="Cloud 1-2")
fill(p2, p3, color = showCloud ? (ema2 >= ema3 ? color.new(bullColor, t2) : color.new(bearColor, t2)) : na, title="Cloud 2-3")

// ══════════════════════ VWAP ══════════════════════
grpVWAP = "VWAP"
showVwap = input.bool(true, "Show VWAP", group=grpVWAP, inline="vw")
vwapCol  = input.color(color.purple, "", group=grpVWAP, inline="vw")
vwapVal  = ta.vwap(hlc3)
plot(showVwap ? vwapVal : na, "VWAP", color=vwapCol, linewidth=2)

// ══════════════════════ MOVING AVERAGES (SMA) ══════════════════════
grpSMA = "Moving Averages (SMA)"
smaTf = input.timeframe("D", "SMA timeframe", group=grpSMA, tooltip="Default 'D' = daily SMAs regardless of chart timeframe.")

showSma1 = input.bool(true, "Show SMA 1", group=grpSMA, inline="s1")
smaLen1  = input.int(20,    "Length",     minval=1, group=grpSMA, inline="s1")
smaCol1  = input.color(#00bcd4, "",       group=grpSMA, inline="s1")

showSma2 = input.bool(true, "Show SMA 2", group=grpSMA, inline="s2")
smaLen2  = input.int(50,    "Length",     minval=1, group=grpSMA, inline="s2")
smaCol2  = input.color(#ffc107, "",       group=grpSMA, inline="s2")

showSma3 = input.bool(true, "Show SMA 3", group=grpSMA, inline="s3")
smaLen3  = input.int(100,   "Length",     minval=1, group=grpSMA, inline="s3")
smaCol3  = input.color(#4caf50, "",       group=grpSMA, inline="s3")

showSma4 = input.bool(true, "Show SMA 4", group=grpSMA, inline="s4")
smaLen4  = input.int(200,   "Length",     minval=1, group=grpSMA, inline="s4")
smaCol4  = input.color(#f44336, "",       group=grpSMA, inline="s4")

f_sma(len) =>
    request.security(syminfo.tickerid, smaTf, ta.sma(close, len), lookahead=barmerge.lookahead_off)

sma1 = f_sma(smaLen1)
sma2 = f_sma(smaLen2)
sma3 = f_sma(smaLen3)
sma4 = f_sma(smaLen4)

plot(showSma1 ? sma1 : na, "SMA 1", color=smaCol1, linewidth=1)
plot(showSma2 ? sma2 : na, "SMA 2", color=smaCol2, linewidth=1)
plot(showSma3 ? sma3 : na, "SMA 3", color=smaCol3, linewidth=1)
plot(showSma4 ? sma4 : na, "SMA 4", color=smaCol4, linewidth=2)

// ══════════════════════ ALERTS ══════════════════════
alertcondition(ta.crossover(ema1, ema5),  "Bullish: EMA1 crosses above EMA5", "Fast EMA crossed above slow EMA")
alertcondition(ta.crossunder(ema1, ema5), "Bearish: EMA1 crosses below EMA5", "Fast EMA crossed below slow EMA")
