//@version=6
indicator("Sikish ignesi 5.02 vol", overlay=true, max_labels_count=500)

// ---------------- Inputs: Enable/Disable Conditions ----------------
useCond1  = input.bool(true, title="Enable Condition 1: Bigger than previous candles' average size")
useCond2  = input.bool(true, title="Enable Condition 2: Close beyond percentage level")
useCond3  = input.bool(true, title="Enable Condition 3: Bigger than average candle size")
useCond4  = input.bool(true, title="Enable Condition 4: Wick bigger than body")
useCond5  = input.bool(true, title="Enable Condition 5: Cancel if previous candle's low/high exceeds current")
useCond6  = input.bool(true, title="Enable Condition 6: Cancel based on EMA position")
useCond7  = input.bool(true, title="Enable Condition 7: Retroactive cancel if new high/low within X candles")
useCond8  = input.bool(true, title="Enable Condition 8: Volume increase by percentage")
useCond9  = input.bool(true, title="Enable Condition 9: Wick bigger than body (2nd)")
useCond10 = input.bool(true, title="Enable Condition 10: Close beyond percentage level (2nd)")
useCond11 = input.bool(true, title="Enable Condition 11: Volume increase by percentage (2nd)")

// ---------------- Inputs: Slot-based grouping (6 slots) ----------------
// Type condition numbers separated by comma or dash, e.g. "1,3" or "1-3".
// Use "0" (or leave blank) to turn a slot off. Condition 7 cannot be used here.
// Any condition number NOT typed into any slot is automatically mandatory.
// Slots that share a condition number are linked into one group; a group is
// satisfied if ANY slot within it passes. Groups with nothing shared to
// anything else must pass entirely on their own.
slot1Str   = input.string("1,3", title="Slot 1: condition numbers (0 = off)", group="Condition Slots")
slot1Logic = input.string("Both Required (AND)", title="Slot 1 Logic", options=["Either Is Enough (OR)", "Both Required (AND)"], group="Condition Slots")

slot2Str   = input.string("0", title="Slot 2: condition numbers (0 = off)", group="Condition Slots")
slot2Logic = input.string("Either Is Enough (OR)", title="Slot 2 Logic", options=["Either Is Enough (OR)", "Both Required (AND)"], group="Condition Slots")

slot3Str   = input.string("0", title="Slot 3: condition numbers (0 = off)", group="Condition Slots")
slot3Logic = input.string("Either Is Enough (OR)", title="Slot 3 Logic", options=["Either Is Enough (OR)", "Both Required (AND)"], group="Condition Slots")

slot4Str   = input.string("0", title="Slot 4: condition numbers (0 = off)", group="Condition Slots")
slot4Logic = input.string("Either Is Enough (OR)", title="Slot 4 Logic", options=["Either Is Enough (OR)", "Both Required (AND)"], group="Condition Slots")

slot5Str   = input.string("0", title="Slot 5: condition numbers (0 = off)", group="Condition Slots")
slot5Logic = input.string("Either Is Enough (OR)", title="Slot 5 Logic", options=["Either Is Enough (OR)", "Both Required (AND)"], group="Condition Slots")

slot6Str   = input.string("0", title="Slot 6: condition numbers (0 = off)", group="Condition Slots")
slot6Logic = input.string("Either Is Enough (OR)", title="Slot 6 Logic", options=["Either Is Enough (OR)", "Both Required (AND)"], group="Condition Slots")

// ---------------- Inputs: Adjustable Values ----------------
prevLength       = input.int(3, title="Condition 1: Number of previous candles to average", minval=1)
lengthMultiplier = input.float(2.0, title="Condition 1: X times bigger than previous candles' average", minval=0.1, step=0.1)
closePercentage  = input.float(13.0, title="Condition 2: Close position % (100=at low, 0=at high, 50=midpoint)", minval=0.0, maxval=100.0, step=1.0)
avgLength        = input.int(30, title="Condition 3: Average candle size lookback (bars)", minval=1)
avgMultiplier    = input.float(1.5, title="Condition 3: X times bigger than average candle size", minval=0.1, step=0.1)
wickMultiplier   = input.float(1.3, title="Condition 4: Wick X times bigger than body", minval=0.1, step=0.1)
cond5Lookback    = input.int(1, title="Condition 5: Number of previous candles to check", minval=1)
cancelLookback   = input.int(4, title="Condition 7: Number of candles to check for new high/low", minval=1)
volIncreasePct   = input.float(14.0, title="Condition 8: Volume increase % (vs average volume)", minval=0.0, step=0.5)
volAvgLength     = input.int(6, title="Condition 8: Number of previous candles to average volume", minval=1)
wickMultiplier2  = input.float(1.3, title="Condition 9: Wick X times bigger than body (2nd)", minval=0.1, step=0.1)
closePercentage2 = input.float(50.0, title="Condition 10: Close position % (2nd)", minval=0.0, maxval=100.0, step=1.0)
volIncreasePct2  = input.float(14.0, title="Condition 11: Volume increase % (2nd, vs average volume)", minval=0.0, step=0.5)
volAvgLength2    = input.int(6, title="Condition 11: Number of previous candles to average volume (2nd)", minval=1)

// Condition 6: EMA inputs (5 EMAs, each individually toggleable and adjustable)
useEma1 = input.bool(true, title="Condition 6: Enable EMA 1")
ema1Len = input.int(10,  title="Condition 6: EMA 1 length", minval=1)
ema1Col = input.color(color.yellow, title="EMA 1 color")
useEma2 = input.bool(true, title="Condition 6: Enable EMA 2")
ema2Len = input.int(25,  title="Condition 6: EMA 2 length", minval=1)
ema2Col = input.color(color.purple, title="EMA 2 color")
useEma3 = input.bool(true, title="Condition 6: Enable EMA 3")
ema3Len = input.int(50,  title="Condition 6: EMA 3 length", minval=1)
ema3Col = input.color(color.gray, title="EMA 3 color")
useEma4 = input.bool(true, title="Condition 6: Enable EMA 4")
ema4Len = input.int(120, title="Condition 6: EMA 4 length", minval=1)
ema4Col = input.color(color.rgb(139, 0, 0), title="EMA 4 color")
useEma5 = input.bool(true, title="Condition 6: Enable EMA 5")
ema5Len = input.int(200, title="Condition 6: EMA 5 length", minval=1)
ema5Col = input.color(color.rgb(0, 255, 0), title="EMA 5 color")

// ---------------- Calculations ----------------
rangeCur  = high - low

avgPrevRange = ta.sma(high - low, prevLength)[1]
avgRange     = ta.sma(high - low, avgLength)[1]

pctFrac  = closePercentage  / 100.0
pctFrac2 = closePercentage2 / 100.0
thresholdUp    = high - pctFrac  * rangeCur
thresholdDown  = low  + pctFrac  * rangeCur
thresholdUp2   = high - pctFrac2 * rangeCur
thresholdDown2 = low  + pctFrac2 * rangeCur

bodyCur = math.abs(close - open)
wickCur = rangeCur - bodyCur

// EMA calculations
ema1 = ta.ema(close, ema1Len)
ema2 = ta.ema(close, ema2Len)
ema3 = ta.ema(close, ema3Len)
ema4 = ta.ema(close, ema4Len)
ema5 = ta.ema(close, ema5Len)

// ---------------- Raw (unfiltered) per-condition tests: 1,2,3,4,5,6,8,9,10,11 ----------------
raw1 = rangeCur > lengthMultiplier * avgPrevRange
raw3 = rangeCur > avgMultiplier * avgRange
raw4 = wickCur > wickMultiplier * bodyCur
raw9 = wickCur > wickMultiplier2 * bodyCur

raw2Up   = close <= thresholdUp
raw2Down = close >= thresholdDown
raw10Up   = close <= thresholdUp2
raw10Down = close >= thresholdDown2

prevMadeLowerLow   = ta.lowest(low, cond5Lookback)[1]   < low
prevMadeHigherHigh = ta.highest(high, cond5Lookback)[1] > high
raw5Up   = not prevMadeHigherHigh
raw5Down = not prevMadeLowerLow

aboveAnyEma = (useEma1 and close > ema1) or (useEma2 and close > ema2) or (useEma3 and close > ema3) or (useEma4 and close > ema4) or (useEma5 and close > ema5)
belowAnyEma = (useEma1 and close < ema1) or (useEma2 and close < ema2) or (useEma3 and close < ema3) or (useEma4 and close < ema4) or (useEma5 and close < ema5)
raw6Up   = not belowAnyEma
raw6Down = not aboveAnyEma

avgVolume  = ta.sma(volume, volAvgLength)[1]
avgVolume2 = ta.sma(volume, volAvgLength2)[1]
raw8  = volume > avgVolume  * (1 + volIncreasePct  / 100.0)
raw11 = volume > avgVolume2 * (1 + volIncreasePct2 / 100.0)

// Index mapping (0-based): 0=cond1, 1=cond2, 2=cond3, 3=cond4, 4=cond5, 5=cond6,
// 6=cond7(unused/dummy), 7=cond8, 8=cond9, 9=cond10, 10=cond11
rawUpArr    = array.from(raw1, raw2Up,   raw3, raw4, raw5Up,   raw6Up,   true, raw8, raw9, raw10Up,   raw11)
rawDownArr  = array.from(raw1, raw2Down, raw3, raw4, raw5Down, raw6Down, true, raw8, raw9, raw10Down, raw11)
enabledArr  = array.from(useCond1, useCond2, useCond3, useCond4, useCond5, useCond6, false, useCond8, useCond9, useCond10, useCond11)

// ---------------- Slot parsing / evaluation helpers ----------------
f_parseSlot(txt) =>
    cleaned = str.replace_all(txt, "-", ",")
    parts   = str.split(cleaned, ",")
    idxArr  = array.new<int>()
    for p in parts
        pt  = str.trim(p)
        num = str.tonumber(pt)
        if not na(num)
            n = int(num)
            if n >= 1 and n <= 11 and n != 7
                array.push(idxArr, n)
    idxArr

f_evalSlot(idxArr, logicMode, rawArr, enabledArr) =>
    isAnd     = logicMode == "Both Required (AND)"
    result    = isAnd
    usedCount = 0
    for n in idxArr
        if array.get(enabledArr, n - 1)
            usedCount += 1
            v = array.get(rawArr, n - 1)
            result := isAnd ? (result and v) : (result or v)
    usedCount > 0 ? result : true

idx1 = f_parseSlot(slot1Str)
idx2 = f_parseSlot(slot2Str)
idx3 = f_parseSlot(slot3Str)
idx4 = f_parseSlot(slot4Str)
idx5 = f_parseSlot(slot5Str)
idx6 = f_parseSlot(slot6Str)

active1 = array.size(idx1) > 0
active2 = array.size(idx2) > 0
active3 = array.size(idx3) > 0
active4 = array.size(idx4) > 0
active5 = array.size(idx5) > 0
active6 = array.size(idx6) > 0

slot1Up = f_evalSlot(idx1, slot1Logic, rawUpArr, enabledArr)
slot2Up = f_evalSlot(idx2, slot2Logic, rawUpArr, enabledArr)
slot3Up = f_evalSlot(idx3, slot3Logic, rawUpArr, enabledArr)
slot4Up = f_evalSlot(idx4, slot4Logic, rawUpArr, enabledArr)
slot5Up = f_evalSlot(idx5, slot5Logic, rawUpArr, enabledArr)
slot6Up = f_evalSlot(idx6, slot6Logic, rawUpArr, enabledArr)

slot1Down = f_evalSlot(idx1, slot1Logic, rawDownArr, enabledArr)
slot2Down = f_evalSlot(idx2, slot2Logic, rawDownArr, enabledArr)
slot3Down = f_evalSlot(idx3, slot3Logic, rawDownArr, enabledArr)
slot4Down = f_evalSlot(idx4, slot4Logic, rawDownArr, enabledArr)
slot5Down = f_evalSlot(idx5, slot5Logic, rawDownArr, enabledArr)
slot6Down = f_evalSlot(idx6, slot6Logic, rawDownArr, enabledArr)

// Any condition number that ISN'T placed in any slot stays mandatory (AND) —
// this is your "no matter what" mechanism. Just don't put a condition in a slot.
usedMask = array.new<bool>(11, false)
for n in idx1
    array.set(usedMask, n - 1, true)
for n in idx2
    array.set(usedMask, n - 1, true)
for n in idx3
    array.set(usedMask, n - 1, true)
for n in idx4
    array.set(usedMask, n - 1, true)
for n in idx5
    array.set(usedMask, n - 1, true)
for n in idx6
    array.set(usedMask, n - 1, true)

leftoverUp   = true
leftoverDown = true
for i = 0 to 10
    if not array.get(usedMask, i)
        if array.get(enabledArr, i)
            leftoverUp   := leftoverUp   and array.get(rawUpArr, i)
            leftoverDown := leftoverDown and array.get(rawDownArr, i)

// ---------------- Group slots that share condition numbers (union-find) ----------------
activeArr = array.from(active1, active2, active3, active4, active5, active6)

parentArr = array.new<int>(6)
for i = 0 to 5
    array.set(parentArr, i, i)

f_find(pArr, x) =>
    p = x
    while array.get(pArr, p) != p
        p := array.get(pArr, p)
    p

f_union(pArr, x, y) =>
    rx = f_find(pArr, x)
    ry = f_find(pArr, y)
    if rx != ry
        array.set(pArr, rx, ry)

f_arrayContains(arr, val) =>
    found = false
    for v in arr
        if v == val
            found := true
    found

f_shareAny(arrA, arrB) =>
    shared = false
    for v in arrA
        if f_arrayContains(arrB, v)
            shared := true
    shared

// Union any two active slots that share at least one condition number
if active1 and active2 and f_shareAny(idx1, idx2)
    f_union(parentArr, 0, 1)
if active1 and active3 and f_shareAny(idx1, idx3)
    f_union(parentArr, 0, 2)
if active1 and active4 and f_shareAny(idx1, idx4)
    f_union(parentArr, 0, 3)
if active1 and active5 and f_shareAny(idx1, idx5)
    f_union(parentArr, 0, 4)
if active1 and active6 and f_shareAny(idx1, idx6)
    f_union(parentArr, 0, 5)
if active2 and active3 and f_shareAny(idx2, idx3)
    f_union(parentArr, 1, 2)
if active2 and active4 and f_shareAny(idx2, idx4)
    f_union(parentArr, 1, 3)
if active2 and active5 and f_shareAny(idx2, idx5)
    f_union(parentArr, 1, 4)
if active2 and active6 and f_shareAny(idx2, idx6)
    f_union(parentArr, 1, 5)
if active3 and active4 and f_shareAny(idx3, idx4)
    f_union(parentArr, 2, 3)
if active3 and active5 and f_shareAny(idx3, idx5)
    f_union(parentArr, 2, 4)
if active3 and active6 and f_shareAny(idx3, idx6)
    f_union(parentArr, 2, 5)
if active4 and active5 and f_shareAny(idx4, idx5)
    f_union(parentArr, 3, 4)
if active4 and active6 and f_shareAny(idx4, idx6)
    f_union(parentArr, 3, 5)
if active5 and active6 and f_shareAny(idx5, idx6)
    f_union(parentArr, 4, 5)

rootArr = array.new<int>(6, -1)
for i = 0 to 5
    if array.get(activeArr, i)
        array.set(rootArr, i, f_find(parentArr, i))

passUpArr   = array.from(slot1Up,   slot2Up,   slot3Up,   slot4Up,   slot5Up,   slot6Up)
passDownArr = array.from(slot1Down, slot2Down, slot3Down, slot4Down, slot5Down, slot6Down)

// A group is satisfied if ANY slot within it passes; groups with no shared
// conditions to anything else must pass entirely on their own.
f_componentPass(rootArr, passArr, activeArr, i) =>
    r = array.get(rootArr, i)
    result = false
    for j = 0 to 5
        if array.get(activeArr, j) and array.get(rootArr, j) == r
            result := result or array.get(passArr, j)
    result

slotsCombinedUp   = true
slotsCombinedDown = true
for i = 0 to 5
    if array.get(activeArr, i)
        slotsCombinedUp   := slotsCombinedUp   and f_componentPass(rootArr, passUpArr,   activeArr, i)
        slotsCombinedDown := slotsCombinedDown and f_componentPass(rootArr, passDownArr, activeArr, i)

// ---------------- Final signal: leftover mandatory (un-slotted) + grouped slot logic ----------------
fakedUp   = leftoverUp   and slotsCombinedUp
fakedDown = leftoverDown and slotsCombinedDown

// ---------------- Plot EMAs on chart ----------------
plot(useEma1 ? ema1 : na, title="EMA 1", color=ema1Col)
plot(useEma2 ? ema2 : na, title="EMA 2", color=ema2Col)
plot(useEma3 ? ema3 : na, title="EMA 3", color=ema3Col)
plot(useEma4 ? ema4 : na, title="EMA 4", color=ema4Col)
plot(useEma5 ? ema5 : na, title="EMA 5", color=ema5Col)

// ---------------- Condition 7: Retroactive cancellation ----------------
var array<label> pendingUpLabels = array.new<label>()
var array<int>   pendingUpBars   = array.new<int>()
var array<float> pendingUpHighs  = array.new<float>()

var array<label> pendingDownLabels = array.new<label>()
var array<int>   pendingDownBars   = array.new<int>()
var array<float> pendingDownLows   = array.new<float>()

if useCond7 and array.size(pendingUpBars) > 0
    for i = array.size(pendingUpBars) - 1 to 0
        refBar  = array.get(pendingUpBars, i)
        refHigh = array.get(pendingUpHighs, i)
        if bar_index - refBar <= cancelLookback
            if high > refHigh
                label.delete(array.get(pendingUpLabels, i))
                array.remove(pendingUpLabels, i)
                array.remove(pendingUpBars, i)
                array.remove(pendingUpHighs, i)
        else
            array.remove(pendingUpLabels, i)
            array.remove(pendingUpBars, i)
            array.remove(pendingUpHighs, i)

if useCond7 and array.size(pendingDownBars) > 0
    for i = array.size(pendingDownBars) - 1 to 0
        refBar = array.get(pendingDownBars, i)
        refLow = array.get(pendingDownLows, i)
        if bar_index - refBar <= cancelLookback
            if low < refLow
                label.delete(array.get(pendingDownLabels, i))
                array.remove(pendingDownLabels, i)
                array.remove(pendingDownBars, i)
                array.remove(pendingDownLows, i)
        else
            array.remove(pendingDownLabels, i)
            array.remove(pendingDownBars, i)
            array.remove(pendingDownLows, i)

// ---------------- Plot signs on chart (as manageable labels) ----------------
if fakedUp
    lbl = label.new(bar_index, high, text="F.UP", style=label.style_label_down,
         color=color.new(color.red, 0), textcolor=color.white, size=size.small, yloc=yloc.abovebar)
    if useCond7
        array.push(pendingUpLabels, lbl)
        array.push(pendingUpBars, bar_index)
        array.push(pendingUpHighs, high)

if fakedDown
    lbl = label.new(bar_index, low, text="F.DOWN", style=label.style_label_up,
         color=color.new(color.green, 0), textcolor=color.white, size=size.small, yloc=yloc.belowbar)
    if useCond7
        array.push(pendingDownLabels, lbl)
        array.push(pendingDownBars, bar_index)
        array.push(pendingDownLows, low)

// ---------------- Alerts (for sound notifications) ----------------
alertcondition(fakedUp, title="Faked Up Alert", message="Faked Up signal on {{ticker}} at {{close}}")
alertcondition(fakedDown, title="Faked Down Alert", message="Faked Down signal on {{ticker}} at {{close}}")

if fakedUp
    alert("Faked Up signal on " + syminfo.ticker, alert.freq_once_per_bar_close)

if fakedDown
    alert("Faked Down signal on " + syminfo.ticker, alert.freq_once_per_bar_close)