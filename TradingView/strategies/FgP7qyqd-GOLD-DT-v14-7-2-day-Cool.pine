//@version=6
// ==================================================================================
// 🆔 PTA GOLD — DT ONLY v14.7 FIXED (Daily Cap + Cooldown)
// ==================================================================================
strategy("☬ PTA☬ GOLD DT v14.7 (2/day+Cool) ☬",
     overlay=true,
     initial_capital=1000,
     default_qty_type=strategy.cash,
     default_qty_value=100,
     currency=currency.USD,
     max_boxes_count=500,
     max_labels_count=500,
     pyramiding=1)

// ==================================================================================
// 🔔 ALERT OUTPUT MODE (IMPORTANT) — MASTER
// ==================================================================================
grp_mode = "🔌 Alerts Output Mode"
send_mode = input.string("DIRECT_TELEGRAM", "Send Mode", options=["DIRECT_TELEGRAM", "WEBHOOK_ROUTER"], group=grp_mode)
router_secret = input.string("PTA_SECRET_2026", "Router Secret", group=grp_mode)
router_exchange = input.string("EXNESS", "Router Exchange", options=["BINANCE","BYBIT","EXNESS"], group=grp_mode)
router_account  = input.string("MAIN", "Router Account Tag", group=grp_mode)

// ==================================================================================
// 🔔 TELEGRAM ALERTS — MASTER
// ==================================================================================
grp_alrt = "🔔 Pro Trader Alerts (Styled)"
infra_alrt_master = input.bool(true, "✅ MASTER ALERT ON/OFF", group=grp_alrt)

pta_script_tag = input.string("PTA_GOLD_DT_v14.7", "Script Name", group=grp_alrt)
pta_version    = input.string("14.7.DT", "Version", group=grp_alrt)

infra_alrt_ent  = input.bool(true, "Alert on New Entry", group=grp_alrt)
infra_alrt_be   = input.bool(true, "Alert on Break-Even", group=grp_alrt)
infra_alrt_sky  = input.bool(true, "Alert on Sky High", group=grp_alrt)
infra_alrt_tp1  = input.bool(true, "Alert on TP1 (Partial)", group=grp_alrt)
infra_alrt_tp2  = input.bool(true, "Alert on TP2 (Final)", group=grp_alrt)
infra_alrt_exit = input.bool(true, "Alert on Exit", group=grp_alrt)
infra_alrt_eod  = input.bool(true, "Alert on EOD", group=grp_alrt)

infra_t_id = input.string("@punjabitradingacademy", "Telegram chat_id", group=grp_alrt)

// ========================================================
// MODULE #1 — PARTIAL PROFIT BOOKING
// ========================================================
grp_partial = "🧩 Partial Profit Booking (PRO)"
infra_partial_enable   = input.bool(true, "Enable Partial Exits", group=grp_partial, tooltip="Position size controlled in MT5")
infra_partial_qty_pct  = input.int(50, "Partial Qty % at TP1", minval=1, maxval=99, group=grp_partial)
infra_partial_target_r = input.float(0.5, "TP1 Ratio", minval=0.1, maxval=0.9, step=0.05, group=grp_partial)

// ========================================================
// TELEGRAM BUILDERS
// ========================================================
tg_entry_msg(_trade_id, _isLong, _entry, _sl, _tp1, _tp2) =>
     "🏹 <b>" + pta_script_tag + " SIGNAL</b>: " + syminfo.ticker +
     "\\n--------------------------" +
     "\\n🔹 ACTION: " + (_isLong ? "BUY 🟢" : "SELL 🔴") +
     "\\n🔹 ENTRY: " + str.tostring(_entry, "#.##") +
     "\\n🔹 SL: " + str.tostring(_sl, "#.##") +
     "\\n🔹 TP1: " + str.tostring(_tp1, "#.##") +
     "\\n🔹 TP2: " + str.tostring(_tp2, "#.##") +
     "\\n\\n🔹 TRADE ID: " + _trade_id

tg_be_msg(_trade_id) =>
     "🛡️ <b>UPDATE</b>: " + pta_script_tag +
     "\\n✅ SL moved to BE" +
     "\\n🔹 TRADE ID: " + _trade_id

tg_sky_msg(_trade_id) =>
     "🌌 <b>SKY HIGH</b>: " + pta_script_tag +
     "\\n🚀 Extended profit zone" +
     "\\n🔹 TRADE ID: " + _trade_id

tg_trail_msg(_trade_id) =>
     "🔥 <b>TRAILING</b>: " + _trade_id

tg_tp1_msg(_trade_id, _tp1_price, _qty_pct) =>
     "🎯 <b>TP1 HIT</b>: " + pta_script_tag +
     "\\n✅ Partial Booked: " + str.tostring(_qty_pct) + "%" +
     "\\n💰 " + str.tostring(_tp1_price, "#.##") +
     "\\n🔹 TRADE ID: " + _trade_id

tg_tp2_msg(_trade_id, _tp2_price) =>
     "🏁 <b>TP2 HIT</b>: " + pta_script_tag +
     "\\n✅ Final Target" +
     "\\n💰 " + str.tostring(_tp2_price, "#.##") +
     "\\n🔹 TRADE ID: " + _trade_id

tg_exit_msg(_trade_id, _reason, _price) =>
     "❌ <b>EXIT</b>: " + pta_script_tag +
     "\\n" + _reason +
     "\\n💰 " + str.tostring(_price, "#.##") +
     "\\n🔹 TRADE ID: " + _trade_id

tg_eod_msg(_trade_id, _price) =>
     "🕘 <b>EOD EXIT</b>: " + pta_script_tag +
     "\\n✅ Session End" +
     "\\n💰 " + str.tostring(_price, "#.##") +
     "\\n🔹 TRADE ID: " + _trade_id

payload_direct_telegram(_text) =>
    '{"chat_id":"' + infra_t_id + '","text":"' + _text + '","parse_mode":"HTML","disable_web_page_preview":true}'

payload_router(_event, _event_id, _trade_id, _side, _action, _price, _qty_pct, _sl, _tp1, _tp2, _reduce_only, _tg_text) =>
    '{"secret":"' + router_secret + '",' +
     '"exchange":"' + router_exchange + '",' +
     '"account":"' + router_account + '",' +
     '"script_tag":"' + pta_script_tag + '",' +
     '"version":"' + pta_version + '",' +
     '"symbol":"' + syminfo.ticker + '",' +
     '"timeframe":"' + timeframe.period + '",' +
     '"ts_utc":"' + str.tostring(timenow) + '",' +
     '"event":"' + _event + '",' +
     '"event_id":"' + _event_id + '",' +
     '"trade_id":"' + _trade_id + '",' +
     '"side":"' + _side + '",' +
     '"action":"' + _action + '",' +
     '"price":"' + str.tostring(_price) + '",' +
     '"qty_pct":"' + str.tostring(_qty_pct) + '",' +
     '"sl":"' + str.tostring(_sl) + '",' +
     '"tp1":"' + str.tostring(_tp1) + '",' +
     '"tp2":"' + str.tostring(_tp2) + '",' +
     '"reduce_only":"' + (_reduce_only ? "true" : "false") + '",' +
     '"telegram":{"chat_id":"' + infra_t_id + '","text":"' + _tg_text + '","parse_mode":"HTML"}' +
     '}'

send_out(_enabled, _event, _event_id, _trade_id, _side, _action, _price, _qty_pct, _sl, _tp1, _tp2, _reduce_only, _tg_text) =>
    if infra_alrt_master and _enabled
        string body = send_mode == "DIRECT_TELEGRAM" ? payload_direct_telegram(_tg_text) :
             payload_router(_event, _event_id, _trade_id, _side, _action, _price, _qty_pct, _sl, _tp1, _tp2, _reduce_only, _tg_text)
        alert(body, alert.freq_once_per_bar)

tg_send_entry(_trade_id, _isLong, _entry, _sl, _tp1, _tp2) =>
    send_out(infra_alrt_ent, "ENTRY", _trade_id + "_ENTRY", _trade_id, _isLong ? "long":"short", _isLong ? "BUY":"SELL", _entry, 0, _sl, _tp1, _tp2, false, tg_entry_msg(_trade_id, _isLong, _entry, _sl, _tp1, _tp2))

tg_send_be(_trade_id, _price_be) =>
    send_out(infra_alrt_be, "BE", _trade_id + "_BE", _trade_id, "neutral", "UPDATE", _price_be, 0, _price_be, 0, 0, true, tg_be_msg(_trade_id))

tg_send_trail(_trade_id) =>
    send_out(infra_alrt_sky, "TRAIL", _trade_id + "_TRAIL", _trade_id, "neutral", "UPDATE", close, 0, 0, 0, 0, true, tg_trail_msg(_trade_id))

tg_send_sky(_trade_id) =>
    send_out(infra_alrt_sky, "SKY", _trade_id + "_SKY", _trade_id, "neutral", "UPDATE", close, 0, 0, 0, 0, true, tg_sky_msg(_trade_id))

tg_send_tp1(_trade_id, _tp1_price) =>
    send_out(infra_alrt_tp1, "TP1", _trade_id + "_TP1", _trade_id, "neutral", "EXIT", _tp1_price, infra_partial_qty_pct, 0, _tp1_price, 0, true, tg_tp1_msg(_trade_id, _tp1_price, infra_partial_qty_pct))

tg_send_tp2(_trade_id, _tp2_price) =>
    send_out(infra_alrt_tp2, "TP2", _trade_id + "_TP2", _trade_id, "neutral", "EXIT", _tp2_price, 100, 0, 0, _tp2_price, true, tg_tp2_msg(_trade_id, _tp2_price))

tg_send_sl(_trade_id, _price) =>
    send_out(infra_alrt_exit, "SL", _trade_id + "_SL", _trade_id, "neutral", "EXIT", _price, 100, 0, 0, 0, true, tg_exit_msg(_trade_id, "STOP_LOSS", _price))

tg_send_full_exit(_trade_id, _price, _reason) =>
    send_out(infra_alrt_exit, "EXIT", _trade_id + "_EXIT_" + _reason, _trade_id, "neutral", "EXIT", _price, 100, 0, 0, 0, true, tg_exit_msg(_trade_id, _reason, _price))

tg_send_eod(_trade_id, _price) =>
    send_out(infra_alrt_eod, "EOD", _trade_id + "_EOD", _trade_id, "neutral", "EXIT", _price, 100, 0, 0, 0, true, tg_eod_msg(_trade_id, _price))

// ========================================================
// 🧪 FORCE TEST
// ========================================================
grp_test = "🧪 Alert Test"
pta_force_test = input.bool(false, "🧪 FORCE Test Alerts", group=grp_test)
var bool force_fired_once = false

// ========================================================
// 🚫 WEEKEND CONTROL
// ========================================================
grp_weekend = "📅 Weekend Control"
skip_weekend = input.bool(true, "🚫 Skip Weekends", group=grp_weekend)

// ========================================================
// ⏱️ TIME & SESSION
// ========================================================
grp_time = "⏱️ Time & Session"
tradingSession   = input.session("1000-2200", "Trading Session", group=grp_time, tooltip="PDF: 10:00 AM - 10:00 PM")
session_gap_start = input.int(1400, "Session Gap Start", minval=0, maxval=2359, group=grp_time)
session_gap_end   = input.int(1500, "Session Gap End", minval=0, maxval=2359, group=grp_time)
infra_eod_close  = input.bool(true, "Auto Close at Session End", group=grp_time)

// ========================================================
// 📅 Backtest Range
// ========================================================
grp_date    = "📅 Backtest Date Range"
start_time  = input.time(timestamp("2024-01-01T00:00:00"), "Start Date", group=grp_date)
end_time    = input.time(timestamp("2026-12-31T23:59:59"), "End Date", group=grp_date)
in_date_range = time >= start_time and time <= end_time

// ========================================================
// 🧪 Backtest Lab
// ========================================================
grp_lab  = "🧪 Backtest Lab"
test_mode = input.bool(false, "Enable Test Mode", group=grp_lab)
test_rrr  = input.float(2.0, "Test RRR", group=grp_lab)

// ========================================================
// STRATEGY TOGGLES
// ========================================================
grp_toggles = "⚡ Strategy Toggles (DT ONLY)"
enable_dt    = input.bool(true, "Enable Short (DT) ✅", group=grp_toggles)
enable_db    = input.bool(false, "Enable Long (DB) - DISABLED", group=grp_toggles)
use_be       = input.bool(true, "Enable Break Even", group=grp_toggles)
be_pct       = input.float(35.0, "BE Trigger %", group=grp_toggles) / 100.0
use_trail    = input.bool(true, "Enable Trailing", group=grp_toggles)
trail_pct    = input.float(65.0, "Trail Start %", group=grp_toggles) / 100.0
use_hard_tp  = input.bool(false, "Hard Exit at Target", group=grp_toggles)

// ========================================================
// 🚨 DAILY CAP — NEW MODULE
// ========================================================
grp_daily = "🚨 Daily Cap (NEW)"
enable_daily_cap = input.bool(true, "✅ Enable Daily Cap", group=grp_daily, 
     tooltip="Limit trades per day for risk management")
max_trades_per_day = input.int(2, "Max Trades / Day", minval=1, maxval=10, group=grp_daily)

// ========================================================
// ⏳ COOLDOWN — NEW MODULE
// ========================================================
grp_cool = "⏳ Cooldown (NEW)"
m10_on = input.bool(true, "✅ Enable Cooldown", group=grp_cool,
     tooltip="Minimum bars between trades to prevent spam")
m10_bars = input.int(5, "Bars Between Trades", minval=1, maxval=50, group=grp_cool)

// ========================================================
// ✅ RISK MANAGEMENT
// ========================================================
grp_risk    = "🎯 Risk (WORKING SETTINGS)"
sl_input_pts = input.int(800, "Fixed SL (Points)", group=grp_risk)
tp_input_pts = input.int(1600, "Reference TP (Points)", group=grp_risk)
max_sl_pts   = input.int(2000, "Max Pattern Volatility", group=grp_risk)
sky_high_pct = input.float(11.0, "Sky High %", group=grp_risk)

risk_mode   = input.string("ATR", "SL/TP Mode", options=["POINTS", "ATR", "TICKS"], group=grp_risk)

atr_len     = input.int(14, "ATR Length", minval=1, group=grp_risk)
sl_atr_mult = input.float(3.0, "SL ATR Mult", minval=0.5, step=0.1, group=grp_risk)
tp_atr_mult = input.float(6.0, "TP ATR Mult", minval=1.0, step=0.1, group=grp_risk)

sl_ticks    = input.int(100, "SL Ticks", minval=1, group=grp_risk)
tp_ticks    = input.int(200, "TP Ticks", minval=1, group=grp_risk)

// ========================================================
// 🎯 PATTERN INTELLIGENCE
// ========================================================
grp_patt    = "🎯 Pattern"
leftBars    = input.int(3, "Pivot Left Bars", group=grp_patt)
rightBars   = input.int(3, "Pivot Right Bars", group=grp_patt)
match_threshold = input.float(0.003, "Match Tolerance %", step=0.001, group=grp_patt)
ema_threshold_pct = input.float(0.005, "Max EMA Distance %", step=0.001, group=grp_patt)
use_trend_filter = input.bool(true, "Trend Filter (200 EMA)", group=grp_patt)

// ========================================================
// 📋 ALL FILTERS
// ========================================================
grp_filters = "🔥 All Filters (WORKING)"

enable_candle_filter = input.bool(true, "🚫 Entry Candle Size", group=grp_filters)
max_entry_candle_pct = input.float(0.14, "Max Entry Candle %", step=0.01, group=grp_filters)

enable_neckline_filter = input.bool(true, "🚫 Neckline Distance", group=grp_filters)
max_neckline_dist_pattern = input.float(0.50, "Max Neckline Distance %", step=0.05, group=grp_filters)

enable_direction_filter = input.bool(true, "🔥 Candle Direction Filter", group=grp_filters)

enable_adx_filter = input.bool(true, "🔥 ADX Trend Filter", group=grp_filters)
adx_length = input.int(14, "ADX Length", group=grp_filters)
adx_threshold = input.float(20.0, "Min ADX", group=grp_filters)

enable_wick_filter = input.bool(true, "🚫 High Wick Filter", group=grp_filters)
max_wick_pct = input.float(0.15, "Max Wick %", step=0.05, group=grp_filters)

enable_loss_limiter = input.bool(true, "🛑 Loss Streak Limiter", group=grp_filters)
max_consecutive_losses = input.int(3, "Max Consecutive Losses", minval=1, maxval=5, group=grp_filters)

// ========================================================
// VISUALS
// ========================================================
grp_vis = "🎨 Visuals"
show_dash      = input.bool(true, "Show Dashboard", group=grp_vis)
showBiasMarker = input.bool(true, "Show Bias Background", group=grp_vis)
showTrapLabels = input.bool(true, "Show Labels", group=grp_vis)
show_rrr       = input.bool(true, "Show RRR Boxes", group=grp_vis)

col_ph0_bg = input.color(color.new(#00ff88, 85), "Phase 0 Fill", group=grp_vis)
col_ph1_bg = input.color(color.new(#2962ff, 80), "Phase 1 (BE) Fill", group=grp_vis)
col_ph2_bg = input.color(color.new(#aa00ff, 75), "Phase 2 (Trail) Fill", group=grp_vis)
col_ph3_bg = input.color(color.new(#ffd700, 70), "Phase 3 (Sky) Fill", group=grp_vis)
col_sl_viz = input.color(color.new(#ff5252, 80), "Risk Zone", group=grp_vis)
col_be_viz = input.color(color.new(color.gray, 80), "Risk-Free", group=grp_vis)

// ========================================================
// ENGINE STATE
// ========================================================
var int trail_stage = 0
var float active_sl = na
var float active_tp = na
var float sky_high_price = na
var float tp1_price = na
var float targetPrice = na

var box visTpBox = na
var box visSlBox = na

var string current_trade_id = na
var string pta_last_trade_id = na

var bool tp1_sent = false
var bool tp2_sent = false
var bool eod_sent = false

var int last_entry_bar = 0
var int d_trades = 0

var int count_SL  = 0
var float pts_SL  = 0.0
var int count_BE  = 0
var float pts_BE  = 0.0
var int count_TP1 = 0
var float pts_TP1 = 0.0
var int count_TP2 = 0
var float pts_TP2 = 0.0
var int count_SKY = 0
var float pts_SKY = 0.0
var int processed_closed = 0

var int filtered_candle_size = 0
var int filtered_neckline_dist = 0
var int filtered_candle_direction = 0
var int filtered_adx = 0
var int filtered_wick = 0
var int filtered_loss_streak = 0

var int consecutive_losses = 0

// ========================================================
// INDICATORS
// ========================================================
ema200 = ta.ema(close, 200)
ema200_15m = request.security(syminfo.tickerid, "15", ta.ema(close, 200), lookahead=barmerge.lookahead_off)
ema9 = ta.ema(close, 9)

[diPlus, diMinus, adx] = ta.dmi(adx_length, adx_length)

atrv = ta.atr(atr_len)
tick = syminfo.mintick

// ========================================================
// RISK HELPERS
// ========================================================
f_sl_price(_entry, _isLong) =>
    float slPrice = na
    if risk_mode == "POINTS"
        slPrice := _isLong ? (_entry - sl_input_pts * tick) : (_entry + sl_input_pts * tick)
    else if risk_mode == "ATR"
        float dist = atrv * sl_atr_mult
        slPrice := _isLong ? (_entry - dist) : (_entry + dist)
    else if risk_mode == "TICKS"
        float dist = tick * sl_ticks
        slPrice := _isLong ? (_entry - dist) : (_entry + dist)
    slPrice

f_tp_price(_entry, _isLong, _slPrice) =>
    float tpPrice = na
    float slDist = math.abs(_entry - _slPrice)

    if test_mode
        float dist = slDist * test_rrr
        tpPrice := _isLong ? (_entry + dist) : (_entry - dist)
    else
        if risk_mode == "POINTS"
            tpPrice := _isLong ? (_entry + tp_input_pts * tick) : (_entry - tp_input_pts * tick)
        else if risk_mode == "ATR"
            float dist = atrv * tp_atr_mult
            tpPrice := _isLong ? (_entry + dist) : (_entry - dist)
        else if risk_mode == "TICKS"
            float dist = tick * tp_ticks
            tpPrice := _isLong ? (_entry + dist) : (_entry - dist)
    tpPrice

// ========================================================
// FILTER HELPERS
// ========================================================
f_check_entry_candle_size(_entry_price) =>
    float candle_size = high - low
    float candle_pct = (candle_size / _entry_price) * 100
    bool pass = not enable_candle_filter or candle_pct <= max_entry_candle_pct
    pass

f_check_neckline_distance(_neckline, _entry) =>
    float distance = math.abs(_entry - _neckline)
    float distance_pct = (distance / _entry) * 100
    bool pass = not enable_neckline_filter or distance_pct <= max_neckline_dist_pattern
    pass

f_check_candle_direction(_isLong) =>
    if not enable_direction_filter
        true
    else
        bool pass = true
        if _isLong
            pass := close > open
        else
            pass := close < open
        pass

f_check_adx() =>
    bool pass = not enable_adx_filter or adx >= adx_threshold
    pass

f_check_wick(_entry_price, _isLong) =>
    if not enable_wick_filter
        true
    else
        float body_size = math.abs(close - open)
        float upper_wick = high - math.max(close, open)
        float lower_wick = math.min(close, open) - low
        float max_wick = math.max(upper_wick, lower_wick)
        float candle_range = high - low
        
        bool pass = candle_range == 0 ? false : (max_wick / candle_range) <= max_wick_pct
        pass

f_check_loss_streak() =>
    bool pass = not enable_loss_limiter or consecutive_losses < max_consecutive_losses
    pass

// ========================================================
// SESSION GATING
// ========================================================
inTradeSession = not na(time(timeframe.period, tradingSession + ":1234567", "Europe/Paris"))

current_hour_minute = hour * 100 + minute
inSessionGap = current_hour_minute >= session_gap_start and current_hour_minute < session_gap_end

isWeekend = dayofweek == dayofweek.saturday or dayofweek == dayofweek.sunday
weekend_ok = not skip_weekend or not isWeekend
isValidTime = inTradeSession and not inSessionGap and weekend_ok

// Daily cap and cooldown logic
bool new_day = ta.change(dayofweek) != 0
if new_day
    d_trades := 0

bool cooling = m10_on and (bar_index - last_entry_bar < m10_bars)
int cool_remaining = m10_on ? math.max(0, m10_bars - (bar_index - last_entry_bar)) : 0
bool daily_cap_hit = enable_daily_cap and d_trades >= max_trades_per_day

// ========================================================
// 🧪 FORCE TEST
// ========================================================
if not pta_force_test
    force_fired_once := false

if pta_force_test and barstate.isrealtime and not force_fired_once
    force_fired_once := true
    string tid_test = "TEST_" + str.tostring(timenow)
    float e = close
    float sl = close + 100
    float tp1t = close - 200
    float tp2t = close - 400
    send_out(true, "ENTRY", tid_test + "_ENTRY", tid_test, "short", "SELL", e, 0, sl, tp1t, tp2t, false, tg_entry_msg(tid_test, false, e, sl, tp1t, tp2t))
    send_out(true, "TP1", tid_test + "_TP1", tid_test, "neutral", "EXIT", tp1t, 50, 0, tp1t, 0, true, tg_tp1_msg(tid_test, tp1t, 50))

// ========================================================
// PATTERN LOGIC - DT ONLY (FIXED BUFFER LIMIT)
// ========================================================
ph = ta.pivothigh(high, leftBars, rightBars)
var float dt_p1 = na
var int dt_i1 = na
var bool setup_DT = false
var float neckline_DT = na

if enable_dt and not na(ph)
    if not na(dt_p1) and math.abs(ph - dt_p1) / dt_p1 <= match_threshold
        bool on_ema_5m = math.abs(ph - ema200) / ema200 < ema_threshold_pct
        bool on_ema_15m = math.abs(ph - ema200_15m) / ema200_15m < ema_threshold_pct
        
        if on_ema_5m or on_ema_15m
            setup_DT := true
            float lowest_val = low[rightBars]
            int safe_lookback = math.min(bar_index - dt_i1, 500)
            for i = rightBars to safe_lookback
                if i < bar_index
                    lowest_val := math.min(lowest_val, low[i])
            neckline_DT := lowest_val
    else
        dt_p1 := ph
        dt_i1 := bar_index - rightBars
        setup_DT := false

// ========================================================
// EXECUTION
// ========================================================
if strategy.position_size == 0 and in_date_range
    trail_stage := 0
    tp1_sent := false
    tp2_sent := false
    eod_sent := false

    // Short DT - with daily cap and cooldown
    if setup_DT and close < neckline_DT and isValidTime and not cooling and not daily_cap_hit
        bool trend_ok = not use_trend_filter or close < ema200
        
        if trend_ok
            float _entry = close
            
            float _sl_calc = f_sl_price(_entry, false)
            float _tp_calc = f_tp_price(_entry, false, _sl_calc)
            
            bool candle_ok = f_check_entry_candle_size(_entry)
            if not candle_ok
                filtered_candle_size += 1
            
            bool neckline_ok = f_check_neckline_distance(neckline_DT, _entry)
            if not neckline_ok
                filtered_neckline_dist += 1
            
            bool direction_ok = f_check_candle_direction(false)
            if not direction_ok
                filtered_candle_direction += 1
            
            bool adx_ok = f_check_adx()
            if not adx_ok
                filtered_adx += 1
            
            bool wick_ok = f_check_wick(_entry, false)
            if not wick_ok
                filtered_wick += 1
            
            bool streak_ok = f_check_loss_streak()
            if not streak_ok
                filtered_loss_streak += 1
            
            if candle_ok and neckline_ok and direction_ok and adx_ok and wick_ok and streak_ok
                float sl_pct = math.abs(_entry - _sl_calc) / _entry * 100
                
                if sl_pct <= 2.25
                    active_sl := _sl_calc
                    active_tp := _tp_calc
                    targetPrice := active_tp
                    sky_high_price := _entry * (1 - sky_high_pct/100)

                    float full_dist = math.abs(active_tp - _entry)
                    tp1_price := _entry - (full_dist * infra_partial_target_r)

                    current_trade_id := str.tostring(timenow) + "_14.7.DT"
                    pta_last_trade_id := current_trade_id

                    strategy.entry("Short DT", strategy.short)
                    tg_send_entry(current_trade_id, false, _entry, active_sl, tp1_price, active_tp)

                    last_entry_bar := bar_index
                    d_trades += 1

                    if show_rrr
                        visTpBox := box.new(bar_index, _entry, bar_index+10, active_tp, border_color=color.green, bgcolor=col_ph0_bg, text="TARGET")
                        visSlBox := box.new(bar_index, _entry, bar_index+10, active_sl, border_color=color.red, bgcolor=col_sl_viz, text="RISK")

                    setup_DT := false
                    dt_p1 := na

// ========================================================
// TRADE MANAGEMENT
// ========================================================
if strategy.position_size != 0
    if show_rrr
        box.set_right(visTpBox, bar_index+10)
        box.set_right(visSlBox, bar_index+10)

    float entry_p = strategy.position_avg_price
    bool isL = strategy.position_size > 0
    float cur_move = isL ? (high - entry_p) : (entry_p - low)
    float total_dist = math.abs(targetPrice - entry_p)

    if use_be and trail_stage < 1 and cur_move >= (total_dist * be_pct)
        trail_stage := 1
        active_sl := entry_p
        tg_send_be(current_trade_id, entry_p)
        if show_rrr
            box.set_bgcolor(visSlBox, col_be_viz)
            box.set_text(visSlBox, "RISK FREE")
            box.set_bgcolor(visTpBox, col_ph1_bg)
            box.set_text(visTpBox, "BE LOCKED")

    if use_trail and trail_stage < 2 and cur_move >= (total_dist * trail_pct)
        trail_stage := 2
        tg_send_trail(current_trade_id)
        if show_rrr
            box.set_bgcolor(visTpBox, col_ph2_bg)
            box.set_text(visTpBox, "TRAILING")

    float currentStop = active_sl
    if trail_stage >= 2
        currentStop := isL ? math.max(active_sl, ema9) : math.min(active_sl, ema9)
        active_sl := currentStop

        if trail_stage < 3 and cur_move >= (total_dist * 0.95)
            trail_stage := 3
            tg_send_sky(current_trade_id)
            if show_rrr
                box.set_bgcolor(visTpBox, col_ph3_bg)
                box.set_text(visTpBox, "SKY HIGH")

    if infra_partial_enable and not tp1_sent and not na(tp1_price)
        if (isL and high >= tp1_price) or (not isL and low <= tp1_price)
            tg_send_tp1(current_trade_id, tp1_price)
            tp1_sent := true

    if not tp2_sent and not na(targetPrice)
        if (isL and high >= targetPrice) or (not isL and low <= targetPrice)
            tg_send_tp2(current_trade_id, targetPrice)
            tp2_sent := true

    string fromEntry = "Short DT"

    if infra_partial_enable
        strategy.exit("TP1", from_entry=fromEntry, qty_percent=infra_partial_qty_pct, limit=tp1_price, stop=currentStop, comment_profit="TP1")
        strategy.exit("TP2", from_entry=fromEntry, qty_percent=100, limit=targetPrice, stop=currentStop, comment_profit="TP2")
    else
        strategy.cancel("TP1")
        strategy.exit("TP2", from_entry=fromEntry, qty_percent=100, limit=targetPrice, stop=currentStop, comment_profit="TP2")

    if (not isL and low <= sky_high_price)
        strategy.close(fromEntry, comment="Sky Cap")

    if infra_eod_close and not inTradeSession
        if not eod_sent
            tg_send_eod(current_trade_id, close)
            eod_sent := true
        strategy.close(fromEntry, comment="EOD")

// ========================================================
// TRADE STATS
// ========================================================
trade_closed = ta.change(strategy.closedtrades) != 0

if trade_closed
    for i = processed_closed to strategy.closedtrades - 1
        float p_pts  = strategy.closedtrades.profit(i) / math.abs(strategy.closedtrades.size(i))
        float exitP  = strategy.closedtrades.exit_price(i)
        float entryP = strategy.closedtrades.entry_price(i)
        string exit_com = strategy.closedtrades.exit_comment(i)

        string tid = na(pta_last_trade_id) ? current_trade_id : pta_last_trade_id
        bool is_be = math.abs(exitP - entryP) <= (entryP * 0.00015)

        if p_pts < 0 and not is_be
            consecutive_losses += 1
        else if p_pts > 0
            consecutive_losses := 0

        if is_be
            count_BE += 1
            pts_BE   += p_pts
            consecutive_losses := 0
        else if p_pts < 0
            count_SL += 1
            pts_SL   += p_pts
            tg_send_sl(tid, exitP)
        else
            if infra_partial_enable and exit_com == "TP1"
                count_TP1 += 1
                pts_TP1   += p_pts
            else if exit_com == "TP2"
                count_TP2 += 1
                pts_TP2   += p_pts
            else if exit_com == "Sky Cap"
                count_SKY += 1
                pts_SKY   += p_pts
            else
                count_TP2 += 1
                pts_TP2   += p_pts

        if strategy.position_size == 0
            tg_send_full_exit(tid, exitP, "EXIT_" + exit_com)

    processed_closed := strategy.closedtrades

    if strategy.position_size == 0
        current_trade_id := na
        pta_last_trade_id := na

// ========================================================
// DASHBOARD
// ========================================================
var table dash = table.new(position.top_right, 4, 18, bgcolor=#0b0e14, border_color=#363c4e, border_width=1)

if barstate.islast and show_dash
    color c_green = #00ff88
    color c_red   = #ff5252
    color c_gold  = #ffd700
    color c_blue  = #2962ff
    color c_white = color.white

    float total_profit = strategy.netprofit
    float win_rate = (strategy.wintrades / math.max(1, strategy.closedtrades)) * 100

    table.cell(dash, 0, 0, "DT v14.7 🔴", text_color=c_gold, text_size=size.small)
    table.cell(dash, 1, 0, "SHORT ONLY", text_color=c_red, text_size=size.small)
    table.cell(dash, 2, 0, cooling ? "⏳ COOL" + str.tostring(cool_remaining) : "✅ OK", text_color=cooling ? c_gold : c_green, text_size=size.small)
    table.cell(dash, 3, 0, daily_cap_hit ? "🚫 CAP" : str.tostring(d_trades) + "/2", text_color=daily_cap_hit ? c_red : c_green, text_size=size.small)

    table.cell(dash, 0, 1, "EXITS", text_halign=text.align_left, text_size=size.tiny)
    table.cell(dash, 1, 1, "COUNT", text_size=size.tiny)
    table.cell(dash, 2, 1, "Win%", text_size=size.tiny)
    table.cell(dash, 3, 1, "P&L", text_size=size.tiny)

    table.cell(dash, 0, 2, "🎯 TP1", text_halign=text.align_left, text_size=size.tiny)
    table.cell(dash, 1, 2, str.tostring(count_TP1), text_color=c_green, text_size=size.tiny)
    table.cell(dash, 2, 2, str.tostring(win_rate, "0.0") + "%", text_color=win_rate >= 50 ? c_green : c_red, text_size=size.tiny)
    table.cell(dash, 3, 2, str.tostring(total_profit, "#.#"), text_color=total_profit >= 0 ? c_green : c_red, text_size=size.tiny)

    table.cell(dash, 0, 3, "🏁 TP2", text_halign=text.align_left, text_size=size.tiny)
    table.cell(dash, 1, 3, str.tostring(count_TP2), text_color=c_green, text_size=size.tiny)
    table.cell(dash, 2, 3, "Trades", text_size=size.tiny)
    table.cell(dash, 3, 3, str.tostring(strategy.closedtrades), text_size=size.tiny)

    table.cell(dash, 0, 4, "🚀 Sky", text_halign=text.align_left, text_size=size.tiny)
    table.cell(dash, 1, 4, str.tostring(count_SKY), text_color=c_gold, text_size=size.tiny)
    table.cell(dash, 2, 4, "Today", text_size=size.tiny)
    table.cell(dash, 3, 4, str.tostring(d_trades) + "/2", text_color=d_trades >= 2 ? c_red : c_green, text_size=size.tiny)

    table.cell(dash, 0, 5, "🛡️ BE", text_halign=text.align_left, text_size=size.tiny)
    table.cell(dash, 1, 5, str.tostring(count_BE), text_color=c_blue, text_size=size.tiny)
    table.cell(dash, 2, 5, "Cooldown", text_size=size.tiny)
    table.cell(dash, 3, 5, cooling ? str.tostring(cool_remaining) + " bars" : "Ready", text_color=cooling ? c_gold : c_green, text_size=size.tiny)

    table.cell(dash, 0, 6, "🛑 SL", text_halign=text.align_left, text_size=size.tiny)
    table.cell(dash, 1, 6, str.tostring(count_SL), text_color=c_red, text_size=size.tiny)
    table.cell(dash, 2, 6, "", text_size=size.tiny)
    table.cell(dash, 3, 6, "", text_size=size.tiny)

    table.cell(dash, 0, 7, "🔥 FILTERS", text_halign=text.align_left, text_color=c_gold, text_size=size.tiny)
    table.cell(dash, 1, 7, "BLOCKED", text_color=c_gold, text_size=size.tiny)
    table.cell(dash, 2, 7, "", text_size=size.tiny)
    table.cell(dash, 3, 7, "", text_size=size.tiny)

    table.cell(dash, 0, 8, "Candle Size", text_halign=text.align_left, text_size=size.tiny)
    table.cell(dash, 1, 8, str.tostring(filtered_candle_size), text_color=c_red, text_size=size.tiny)
    table.cell(dash, 2, 8, "ADX", text_halign=text.align_left, text_size=size.tiny)
    table.cell(dash, 3, 8, str.tostring(filtered_adx), text_color=c_red, text_size=size.tiny)

    table.cell(dash, 0, 9, "Neckline", text_halign=text.align_left, text_size=size.tiny)
    table.cell(dash, 1, 9, str.tostring(filtered_neckline_dist), text_color=c_red, text_size=size.tiny)
    table.cell(dash, 2, 9, "Wick", text_halign=text.align_left, text_size=size.tiny)
    table.cell(dash, 3, 9, str.tostring(filtered_wick), text_color=c_red, text_size=size.tiny)

    table.cell(dash, 0, 10, "Direction", text_halign=text.align_left, text_size=size.tiny)
    table.cell(dash, 1, 10, str.tostring(filtered_candle_direction), text_color=c_red, text_size=size.tiny)
    table.cell(dash, 2, 10, "Streak", text_halign=text.align_left, text_size=size.tiny)
    table.cell(dash, 3, 10, str.tostring(filtered_loss_streak), text_color=c_red, text_size=size.tiny)

    table.cell(dash, 0, 11, "Now Loss", text_halign=text.align_left, text_size=size.tiny)
    table.cell(dash, 1, 11, str.tostring(consecutive_losses), text_color=consecutive_losses >= 2 ? c_red : c_white, text_size=size.tiny)
    table.cell(dash, 2, 11, "", text_size=size.tiny)
    table.cell(dash, 3, 11, "", text_size=size.tiny)

    table.cell(dash, 0, 12, "⚡ LIVE", text_halign=text.align_left, text_color=c_blue, text_size=size.tiny)
    table.cell(dash, 1, 12, "VALUE", text_color=c_blue, text_size=size.tiny)
    table.cell(dash, 2, 12, "", text_size=size.tiny)
    table.cell(dash, 3, 12, "", text_size=size.tiny)

    table.cell(dash, 0, 13, "ADX", text_halign=text.align_left, text_size=size.tiny)
    table.cell(dash, 1, 13, str.tostring(adx, "#.#"), text_color=adx >= adx_threshold ? c_green : c_red, text_size=size.tiny)
    table.cell(dash, 2, 13, "Candle", text_halign=text.align_left, text_size=size.tiny)
    table.cell(dash, 3, 13, close > open ? "🟢" : "🔴", text_size=size.tiny)

    table.cell(dash, 0, 14, "⚙️ FIXED", text_halign=text.align_left, text_color=c_blue, text_size=size.tiny)
    table.cell(dash, 1, 14, "", text_size=size.tiny)
    table.cell(dash, 2, 14, "", text_size=size.tiny)
    table.cell(dash, 3, 14, "", text_size=size.tiny)

    string settings_info = "ATR" + str.tostring(atr_len) + " SL:" + str.tostring(sl_atr_mult, "#.#") + " TP:" + str.tostring(tp_atr_mult, "#.#") + 
                          " BE:" + str.tostring(be_pct * 100, "#") + "% Tr:" + str.tostring(trail_pct * 100, "#") + "%"
    
    table.cell(dash, 0, 17, settings_info, text_halign=text.align_left, text_size=size.tiny)
    table.cell(dash, 1, 17, "CAP:2/day✅", text_halign=text.align_left, text_size=size.tiny, text_color=c_green)
    table.cell(dash, 2, 17, "COOL:5bar✅", text_halign=text.align_left, text_size=size.tiny, text_color=c_green)
    table.cell(dash, 3, 17, "BUFFER✅", text_halign=text.align_left, text_size=size.tiny, text_color=c_green)

plot(ema200, color=color.new(color.orange, 0), linewidth=2, title="200 EMA (5M)")
plot(ema200_15m, color=color.new(color.yellow, 0), linewidth=1, title="200 EMA (15M)")
plot(ema9, color=color.new(color.aqua, 0), linewidth=1, title="9 EMA Trail")

bgcolor(showBiasMarker and isValidTime ? color.new(color.green, 96) : na, title="Valid Session")
bgcolor(showBiasMarker and inSessionGap ? color.new(color.red, 90) : na, title="Session Gap")
bgcolor(showBiasMarker and cooling ? color.new(color.orange, 95) : na, title="Cooldown Active")
bgcolor(showBiasMarker and daily_cap_hit ? color.new(color.red, 94) : na, title="Daily Cap Hit")

// ==================================================================================
// END — PTA GOLD DT v14.7 FIXED (Short Only)
// ==================================================================================