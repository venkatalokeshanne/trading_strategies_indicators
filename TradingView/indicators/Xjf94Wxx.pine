//@version=6
indicator('Congress Smart Zones [Clone Final]', overlay = true, max_boxes_count = 100, max_labels_count = 100)

// =========================================================================
// ⚙️ PARAMÈTRES EXACTS
// =========================================================================
pivot_len = input.int(20, title = 'Période Pivot (20)')
macro_len = input.int(250, title = 'Expiration (Bougies max) (250)') // LE FILTRE TEMPOREL !
zone_thick = input.float(0.25, title = 'Épaisseur Zone (0.25)', step = 0.05)
max_sell = input.int(3, title = 'Max Sell Zones (3)')
max_buy = input.int(3, title = 'Max Buy Zones (3)')
line_w = input.int(1, title = 'Épaisseur Ligne (1)')

col_sell = color.new(#ff0000, 85)
col_sell_border = color.new(#ff0000, 0)
col_buy = color.new(#00ff00, 85)
col_buy_border = color.new(#00ff00, 0)

// =========================================================================
// 🧮 LOGIQUE
// =========================================================================
atr = ta.atr(14)
ph = ta.pivothigh(high, pivot_len, pivot_len)
pl = ta.pivotlow(low, pivot_len, pivot_len)

var array<box> sell_boxes = array.new_box()
var array<label> sell_labels = array.new_label()

var array<box> buy_boxes = array.new_box()
var array<label> buy_labels = array.new_label()

// =========================================================================
// 🔴 SELL ZONES
// =========================================================================
if not na(ph)
    top = high[pivot_len]
    bot = top - atr[pivot_len] * zone_thick

    b = box.new(left = bar_index[pivot_len], top = top, right = bar_index, bottom = bot, border_color = col_sell_border, border_width = line_w, bgcolor = col_sell, extend = extend.right)
    lbl = label.new(x = bar_index, y = (top + bot) / 2, text = 'SELL ZONE', color = color.red, textcolor = color.white, style = label.style_label_left, size = size.small)

    array.push(sell_boxes, b)
    array.push(sell_labels, lbl)

    if array.size(sell_boxes) > max_sell
        box.delete(array.get(sell_boxes, 0))
        label.delete(array.get(sell_labels, 0))
        array.remove(sell_boxes, 0)
        array.remove(sell_labels, 0)

// =========================================================================
// 🟢 BUY ZONES
// =========================================================================
if not na(pl)
    bot = low[pivot_len]
    top = bot + atr[pivot_len] * zone_thick

    b = box.new(left = bar_index[pivot_len], top = top, right = bar_index, bottom = bot, border_color = col_buy_border, border_width = line_w, bgcolor = col_buy, extend = extend.right)
    lbl = label.new(x = bar_index, y = (top + bot) / 2, text = 'BUY ZONE', color = color.green, textcolor = color.white, style = label.style_label_left, size = size.small)

    array.push(buy_boxes, b)
    array.push(buy_labels, lbl)

    if array.size(buy_boxes) > max_buy
        box.delete(array.get(buy_boxes, 0))
        label.delete(array.get(buy_labels, 0))
        array.remove(buy_boxes, 0)
        array.remove(buy_labels, 0)

// =========================================================================
// 🎯 DÉPLACEMENT DES ÉTIQUETTES
// =========================================================================
if barstate.islast
    if array.size(sell_labels) > 0
        for i = 0 to array.size(sell_labels) - 1 by 1
            label.set_x(array.get(sell_labels, i), bar_index - 2)

    if array.size(buy_labels) > 0
        for i = 0 to array.size(buy_labels) - 1 by 1
            label.set_x(array.get(buy_labels, i), bar_index - 2)

// =========================================================================
// 🧹 INVALIDATION : CASSURE DU PRIX OU EXPIRATION TEMPORELLE
// =========================================================================
if array.size(sell_boxes) > 0
    for i = array.size(sell_boxes) - 1 to 0 by 1
        b = array.get(sell_boxes, i)
        // Vérifie si le prix clôture au-dessus OU si la zone est plus vieille que 250 bougies
        if close > box.get_top(b) or bar_index - box.get_left(b) > macro_len
            box.delete(b)
            label.delete(array.get(sell_labels, i))
            array.remove(sell_boxes, i)
            array.remove(sell_labels, i)

if array.size(buy_boxes) > 0
    for i = array.size(buy_boxes) - 1 to 0 by 1
        b = array.get(buy_boxes, i)
        // Vérifie si le prix clôture en-dessous OU si la zone est plus vieille que 250 bougies
        if close < box.get_bottom(b) or bar_index - box.get_left(b) > macro_len
            box.delete(b)
            label.delete(array.get(buy_labels, i))
            array.remove(buy_boxes, i)
            array.remove(buy_labels, i)
