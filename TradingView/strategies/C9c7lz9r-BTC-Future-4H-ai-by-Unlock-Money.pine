//@version=5
// This script is for educational and informational purposes only.
// Trading futures involves substantial risk of loss.
// Past performance does not guarantee future results.
// Use at your own risk.

strategy("BTC Future 4H ai by Unlock Money",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     slippage=2)

// ─── INPUTS ───────────────────────────────────────────────
ema_fast    = input.int(21,    "EMA Fast")
ema_mid     = input.int(55,    "EMA Mid")
ema_slow    = input.int(200,   "EMA Slow")
rsi_len     = input.int(14,    "RSI Length")
st_factor   = input.float(3.0, "Supertrend Factor")
st_len      = input.int(10,    "Supertrend Length")
atr_len     = input.int(14,    "ATR Length")
atr_multi   = input.float(2.0, "ATR SL Multiplier", minval=1.5, maxval=4.0, step=0.1)
swing_len   = input.int(5,     "Swing Lookback (bars)", minval=3, maxval=10)
wick_buffer = input.float(0.3, "Wick Buffer %", minval=0.1, maxval=1.0, step=0.1)
tp1_rr      = input.float(1.5, "TP1 RR")
tp2_rr      = input.float(2.5, "TP2 RR")
use_vol     = input.bool(true,  "Volume Filter")
vol_len     = input.int(20,    "Volume MA Length")

// ─── INDICATORS ───────────────────────────────────────────
ema21  = ta.ema(close, ema_fast)
ema55  = ta.ema(close, ema_mid)
ema200 = ta.ema(close, ema_slow)
rsi    = ta.rsi(close, rsi_len)
atr    = ta.atr(atr_len)
[st_line, st_dir] = ta.supertrend(st_factor, st_len)
vol_ma = ta.sma(volume, vol_len)

// ─── SWING HIGH / LOW ─────────────────────────────────────
swing_low  = ta.lowest(low,   swing_len)
swing_high = ta.highest(high, swing_len)

// ─── CONDITIONS ───────────────────────────────────────────
trend_bull   = ema21 > ema55 and ema55 > ema200
trend_bear   = ema21 < ema55 and ema55 < ema200
rsi_long_ok  = rsi >= 45 and rsi <= 75
rsi_short_ok = rsi >= 25 and rsi <= 55
st_bull      = st_dir < 0
st_flip_bull = st_bull and not st_bull[1]
st_flip_bear = not st_bull and st_bull[1]
vol_ok       = not use_vol or (volume > vol_ma)

long_signal  = trend_bull and rsi_long_ok  and st_flip_bull and vol_ok
short_signal = trend_bear and rsi_short_ok and st_flip_bear and vol_ok

// ─── RISK MANAGEMENT ──────────────────────────────────────
long_entry  = close
short_entry = close

long_sl_atr    = long_entry   - atr * atr_multi
long_sl_swing  = swing_low    * (1 - wick_buffer / 100)
long_sl        = math.min(long_sl_atr, long_sl_swing)

short_sl_atr   = short_entry  + atr * atr_multi
short_sl_swing = swing_high   * (1 + wick_buffer / 100)
short_sl       = math.max(short_sl_atr, short_sl_swing)

long_risk  = long_entry  - long_sl
short_risk = short_sl    - short_entry

long_tp1  = long_entry  + long_risk  * tp1_rr
long_tp2  = long_entry  + long_risk  * tp2_rr
short_tp1 = short_entry - short_risk * tp1_rr
short_tp2 = short_entry - short_risk * tp2_rr

// ─── STRATEGY EXECUTION ───────────────────────────────────
if long_signal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    strategy.exit("Long TP1", "Long", qty_percent=50, limit=long_tp1, stop=long_sl)
    strategy.exit("Long TP2", "Long", qty_percent=50, limit=long_tp2, stop=long_sl)

if short_signal and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    strategy.exit("Short TP1", "Short", qty_percent=50, limit=short_tp1, stop=short_sl)
    strategy.exit("Short TP2", "Short", qty_percent=50, limit=short_tp2, stop=short_sl)

// ─── VISUALS ──────────────────────────────────────────────
plot(ema21,  "EMA 21",  color=color.new(color.green,  60), linewidth=1)
plot(ema55,  "EMA 55",  color=color.new(color.orange, 60), linewidth=1)
plot(ema200, "EMA 200", color=color.new(color.red,    40), linewidth=2)

bgcolor(long_signal  ? color.new(color.teal, 80) : na)
bgcolor(short_signal ? color.new(color.red,  85) : na)

plotshape(long_signal,
     title="LONG",
     style=shape.labelup,
     location=location.belowbar,
     color=color.new(color.teal, 0),
     textcolor=color.white,
     text="▲ LONG",
     size=size.large)

plotshape(short_signal,
     title="SHORT",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.new(color.red, 0),
     textcolor=color.white,
     text="▼ SHORT",
     size=size.large)

// ── Label แสดงราคา Entry / SL / TP ──
if long_signal
    label.new(bar_index, low - atr * 3,
         text="── LONG ──\n" +
              "ENTRY : " + str.tostring(math.round(long_entry,  0)) +
              "\nSL    : " + str.tostring(math.round(long_sl,   0)) +
              "\nTP1   : " + str.tostring(math.round(long_tp1,  0)) +
              "\nTP2   : " + str.tostring(math.round(long_tp2,  0)),
         color=color.new(color.teal, 5),
         textcolor=color.white,
         style=label.style_label_upper_right,
         size=size.normal)

if short_signal
    label.new(bar_index, high + atr * 3,
         text="── SHORT ──\n" +
              "ENTRY : " + str.tostring(math.round(short_entry, 0)) +
              "\nSL    : " + str.tostring(math.round(short_sl,  0)) +
              "\nTP1   : " + str.tostring(math.round(short_tp1, 0)) +
              "\nTP2   : " + str.tostring(math.round(short_tp2, 0)),
         color=color.new(color.red, 5),
         textcolor=color.white,
         style=label.style_label_lower_right,
         size=size.normal)

// ── เส้น Entry / SL / TP แนวนอน ──
var line entry_line = na
var line sl_line    = na
var line tp1_line   = na
var line tp2_line   = na

if long_signal
    entry_line := line.new(bar_index, long_entry, bar_index + 20, long_entry, color=color.teal,                 width=2, style=line.style_solid)
    sl_line    := line.new(bar_index, long_sl,    bar_index + 20, long_sl,    color=color.red,                  width=1, style=line.style_dashed)
    tp1_line   := line.new(bar_index, long_tp1,   bar_index + 20, long_tp1,   color=color.new(color.green, 20), width=1, style=line.style_dashed)
    tp2_line   := line.new(bar_index, long_tp2,   bar_index + 20, long_tp2,   color=color.new(color.green, 0),  width=2, style=line.style_dashed)

if short_signal
    entry_line := line.new(bar_index, short_entry, bar_index + 20, short_entry, color=color.red,                  width=2, style=line.style_solid)
    sl_line    := line.new(bar_index, short_sl,    bar_index + 20, short_sl,    color=color.red,                  width=1, style=line.style_dashed)
    tp1_line   := line.new(bar_index, short_tp1,   bar_index + 20, short_tp1,   color=color.new(color.green, 20), width=1, style=line.style_dashed)
    tp2_line   := line.new(bar_index, short_tp2,   bar_index + 20, short_tp2,   color=color.new(color.green, 0),  width=2, style=line.style_dashed)

// ─── ALERTS ───────────────────────────────────────────────
alertcondition(long_signal,  "LONG Signal",  "Triple Confluence LONG - BTC")
alertcondition(short_signal, "SHORT Signal", "Triple Confluence SHORT - BTC")