//@version=6
indicator(title="EMA 20/200/500/1500", overlay=true)

shortest = ta.ema(close, 20)
short    = ta.ema(close, 200)
longer   = ta.ema(close, 500)
longest  = ta.ema(close, 1500)

plot(shortest, color = color.blue)
plot(short,    color = color.red)
plot(longer,   color = color.yellow)
plot(longest,  color = color.orange)