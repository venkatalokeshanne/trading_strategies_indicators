// -------------------------------------------------------------
// Micro Rejection Scalping v6 - XAUUSD 15s
// -------------------------------------------------------------
// Short-only scalping strategy designed for XAUUSD on the 15-second
// timeframe. Enters shorts when the fast EMA (9) crosses under the
// slow EMA (21) during the New York session (7-11 AM ET).
//
// Stop Loss and Take Profit are sized dynamically using ATR(14),
// with a minimum 1:1 risk-reward enforced on every trade.
// A cooldown filter prevents back-to-back entries.
//
// Visual aids:
//   - Last 5 resistance levels shown as red dotted lines
//   - Last 5 support levels shown as lime dotted lines
//   - SL and TP projected 60 bars forward on each entry
//   - Session window highlighted in blue
// -------------------------------------------------------------
//@version=5
strategy(title="Micro Rejection Scalping v6 - XAUUSD 15s", overlay=true,
         default_qty_type=strategy.percent_of_equity, default_qty_value=10,
         commission_type=strategy.commission.percent, commission_value=0,
         max_lines_count=500, max_labels_count=500)

// =============================================================
// INPUTS
// =============================================================

// -- Trend --
ema_fast_len  = input.int(9,  "Fast EMA Length", group="Trend")
ema_slow_len  = input.int(21, "Slow EMA Length", group="Trend")

// -- Support & Resistance --
pivot_len     = input.int(5, "Pivot Lookback (each side)", minval=2, maxval=20, group="Support & Resistance")
sr_levels     = input.int(5, "Levels to Show (each side)", minval=1, maxval=10,  group="Support & Resistance")
res_col       = input.color(color.new(color.red,  70), "Resistance Color", group="Support & Resistance")
sup_col       = input.color(color.new(color.lime, 70), "Support Color",    group="Support & Resistance")

// -- Exit --
sl_atr_mult   = input.float(0.8, "Stop Loss (x ATR)",   minval=0.1, step=0.1, group="Exit")
profit_mult   = input.float(2.0, "Take Profit (x ATR)", minval=0.5, step=0.1, group="Exit")

// -- Filters --
cooldown_bars = input.int(12,    "Cooldown Between Trades (bars)", minval=1, maxval=50, group="Filters")
use_session   = input.bool(true, "Use Session Filter (New York ET)", group="Filters")
ses_start     = input.int(7,  "Session Start Hour (ET)", minval=0, maxval=23, group="Filters")
ses_end       = input.int(11, "Session End Hour (ET)",   minval=0, maxval=23, group="Filters")

// =============================================================
// CORE CALCULATIONS
// =============================================================
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
atr14    = ta.atr(14)
safe_atr = na(atr14) ? 1.0 : atr14

// =============================================================
// SESSION FILTER (New York ET - handles EST/EDT automatically)
// =============================================================
h_et       = hour(time, "America/New_York")
in_session = h_et >= ses_start and h_et < ses_end
session_ok = not use_session or in_session

// =============================================================
// COOLDOWN
// =============================================================
var int last_trade_bar = 0
cool_ok = (bar_index - last_trade_bar) >= cooldown_bars

// =============================================================
// SUPPORT & RESISTANCE - last N pivot highs (resistance)
//                      + last N pivot lows  (support)
// Drawn as dotted lines extending to the right.
// Old lines are deleted when a new pivot pushes count above N.
// =============================================================
var float[] res_prices = array.new_float(0)
var line[]  res_lines  = array.new_line(0)
var float[] sup_prices = array.new_float(0)
var line[]  sup_lines  = array.new_line(0)

ph = ta.pivothigh(high, pivot_len, pivot_len)
pl = ta.pivotlow(low,   pivot_len, pivot_len)

if not na(ph)
    ph_bar   = bar_index - pivot_len
    array.unshift(res_prices, ph)
    res_line = line.new(ph_bar, ph, bar_index, ph,
         color=res_col, width=1, style=line.style_dotted, extend=extend.right)
    array.unshift(res_lines, res_line)
    if array.size(res_prices) > sr_levels
        line.delete(array.pop(res_lines))
        array.pop(res_prices)

if not na(pl)
    pl_bar   = bar_index - pivot_len
    array.unshift(sup_prices, pl)
    sup_line = line.new(pl_bar, pl, bar_index, pl,
         color=sup_col, width=1, style=line.style_dotted, extend=extend.right)
    array.unshift(sup_lines, sup_line)
    if array.size(sup_prices) > sr_levels
        line.delete(array.pop(sup_lines))
        array.pop(sup_prices)

// =============================================================
// ENTRY SIGNALS (short-only EMA cross)
// =============================================================
sell_signal = ta.crossunder(ema_fast, ema_slow) and session_ok and cool_ok and strategy.position_size == 0

// =============================================================
// STOP LOSS & TAKE PROFIT (min 1:1 RR enforced)
// =============================================================
sell_sl      = high + safe_atr * sl_atr_mult
sell_sl_dist = math.max(sell_sl - close, safe_atr * 0.1)
sell_lmt     = close - math.max(safe_atr * profit_mult, sell_sl_dist)

// =============================================================
// TRADE EXECUTION (short only)
// =============================================================
if sell_signal
    last_trade_bar := bar_index
    strategy.entry("Short", strategy.short)
    strategy.exit("SX", from_entry="Short", stop=sell_sl, limit=sell_lmt)

// =============================================================
// SIGNAL MARKER + SL/TP LINES
// =============================================================
var line sl_line     = na
var line profit_line = na

if sell_signal
    line.delete(sl_line)
    line.delete(profit_line)
    sl_line     := line.new(bar_index, sell_sl,  bar_index + 60, sell_sl,
         color=color.red, width=3, style=line.style_solid)
    profit_line := line.new(bar_index, sell_lmt, bar_index + 60, sell_lmt,
         color=color.lime, width=3, style=line.style_solid)

// =============================================================
// VISUALS
// =============================================================
plot(ema_fast, "EMA Fast", color=color.new(color.orange, 20), linewidth=1)
plot(ema_slow, "EMA Slow", color=color.new(color.yellow, 20), linewidth=2)

plotshape(sell_signal, title="Short Entry", location=location.abovebar,
     style=shape.triangledown, color=color.red, size=size.normal, text="SHORT")

bgcolor(use_session and in_session ? color.new(color.blue, 93) : na, title="Session Window")
