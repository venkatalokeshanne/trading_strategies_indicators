//@version=6
strategy("VWAP Squeeze Reclaim (LONG ONLY)", overlay=true)

// === INPUTS ===
bbLength = input.int(20, "BB Length")
bbMult = input.float(2.0, "BB Multiplier")
rsiLength = input.int(14, "RSI Length")

// === VWAP ===
vwapValue = ta.vwap(close)

// === BB ===
basis = ta.sma(close, bbLength)
dev = bbMult * ta.stdev(close, bbLength)
upper = basis + dev
lower = basis - dev

bbWidth = (upper - lower) / basis
isSqueeze = bbWidth < 0.05
recentSqueeze = ta.barssince(isSqueeze) < 20

// === MACD ===
[macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
macdBull = macdLine > signalLine

// === RSI ===
rsi = ta.rsi(close, rsiLength)

// === DMI ===
[diplus, diminus, adx] = ta.dmi(14, 14)
dmiBull = diplus > diminus

// === SUPERTREND ===
[supertrend, direction] = ta.supertrend(1.5, 21)
supertrendBull = direction < 0

// === VWAP CONDITION ===
aboveVWAP = close > vwapValue
belowVWAP = close < vwapValue
vwapCrossUp = ta.crossover(close, vwapValue)
vwapCrossDown = ta.crossunder(close, vwapValue)

// === TIME FILTER ===
entryCutoffHour = 15
entryCutoffMinute = 0

noNewEntries = (hour > entryCutoffHour) or (hour == entryCutoffHour and minute >= entryCutoffMinute)

// === ENTRY CONDITION (ONLY BUY) ===
buySignal = 
     direction < 0 and
     aboveVWAP and
     macdBull and
     not noNewEntries and
     macdLine > 0 and
     rsi < 60 and
     dmiBull and
     supertrendBull //and
     //vwapCrossUp //and

// === EXIT CONDITION ===
sellSignal =
     vwapCrossDown or
     belowVWAP or
     macdLine < signalLine or
     direction > 0       //Supertrend turns red

//=== ENTRY ===
if (buySignal and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)

//=== EXIT LOGIC ===
if (sellSignal and strategy.position_size > 0)
    strategy.close("Long")

exitHour = 15
exitMinute = 20

isEOD = (hour == exitHour and minute >= exitMinute)

// // Close all positions before market close
// if (isEOD and strategy.position_size > 0)
//     strategy.close("Long")

// === PLOTS ===
plot(supertrend, title="Supertrend", color=supertrendBull ? color.green : color.red, linewidth=2)
plot(vwapValue, title="VWAP", color=color.blue)

// === SIGNAL MARKERS ===
plotshape(buySignal and strategy.position_size == 0, title="BUY", 
     location=location.belowbar, color=color.green, style=shape.labelup, text="BUY")

plotshape(sellSignal and strategy.position_size > 0, title="EXIT", 
     location=location.abovebar, color=color.red, style=shape.labeldown, text="EXIT")

// === ALERTS (FOR STRATEGY) ===
if (buySignal and strategy.position_size == 0)
    alert("BUY: " + syminfo.ticker + " @ " + str.tostring(close), alert.freq_once_per_bar_close)

if (sellSignal and strategy.position_size > 0)
    alert("EXIT: " + syminfo.ticker + " @ " + str.tostring(close), alert.freq_once_per_bar_close)