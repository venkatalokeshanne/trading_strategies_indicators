// CROSS — VISUEL GÉNÉRAL
//=============================================================================

// IMPORTANT : style/location sont des input.string DIRECTS.
// Ne pas les convertir avec une fonction avant plotshape(), sinon Pine
// transforme leur qualifier et refuse l'argument.

crossBullShape = input.string(
    shape.triangleup,
    "Shape haussière",
    options=[shape.triangleup, shape.labelup, shape.circle],
    group="CROSS - Visuel",
    display=display.none
)

crossBullLocation = input.string(
    location.bottom,
    "Position haussière",
    options=[location.bottom, location.top, location.belowbar, location.abovebar],
    group="CROSS - Visuel",
    display=display.none
)

crossBullOffset = input.float(
    1.0,
    "Décalage bougie haussier (%)",
    minval=0.0,
    step=0.1,
    group="CROSS - Visuel",
    display=display.none
)

crossBearShape = input.string(
    shape.triangledown,
    "Shape baissière",
    options=[shape.triangledown, shape.labeldown, shape.circle],
    group="CROSS - Visuel",
    display=display.none
)

crossBearLocation = input.string(
    location.bottom,
    "Position baissière",
    options=[location.bottom, location.top, location.belowbar, location.abovebar],
    group="CROSS - Visuel",
    display=display.none
)

crossBearOffset = input.float(
    1.0,
    "Décalage bougie baissier (%)",
    minval=0.0,
    step=0.1,
    group="CROSS - Visuel",
    display=display.none
)

crossMarkerSizeChoice = input.string(
    "Petite",
    "Taille Above/Below",
    options=["Minuscule", "Petite", "Normale", "Grande"],
    group="CROSS - Visuel",
    display=display.none
)

crossShowText = input.bool(
    true,
    "Afficher texte marqueurs",
    group="CROSS - Visuel",
    display=display.none
)

// Styles labels pour AboveBar / BelowBar.
crossBullLabelStyle = crossBullShape == shape.labelup ? label.style_label_up :
     crossBullShape == shape.circle ? label.style_circle :
     label.style_triangleup

crossBearLabelStyle = crossBearShape == shape.labeldown ? label.style_label_down :
     crossBearShape == shape.circle ? label.style_circle :
     label.style_triangledown

crossLabelSize = crossMarkerSizeChoice == "Minuscule" ? size.tiny :
     crossMarkerSizeChoice == "Petite" ? size.small :
     crossMarkerSizeChoice == "Normale" ? size.normal :
     size.large

//=============================================================================
// CROSS 1
//=============================================================================

cross1Enabled = input.bool(true, "Activer", group="Cross 1", display=display.none)
cross1Visual = input.bool(true, "Afficher visuel", group="Cross 1", display=display.none)

cross1A = input.string(
    "MA 1", "Moyenne A",
    options=["MA 1", "MA 2", "MA 3", "MA 4", "MA 5", "MA 6"],
    group="Cross 1",
    display=display.none
)

