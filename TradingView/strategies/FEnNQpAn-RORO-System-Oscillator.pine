// Last Updated 04/04/2026 Irish date format

//@version=6
strategy("RORO System Oscillator", shorttitle = "RORO-OSC", overlay=false)

//Inputs
Src = input.source(close, title = "Source", group = "Source")
AlmaLength = input.int(24, title = "AlmaLength", group = "Alma")
AlmaOffset = input.float(0.85, title = "Alma AlmaOffset", group = "Alma")
AlmaSigma = input.int(6, title = "Alma Sigma", group = "Alma")
VwmaLength = input.int(120, title = "VWMA Length", group = "VWMA")
RocLength = input.int(14, title = "ROC Length", group = "ROC")

// Assign Inputs
Alma = ta.alma(Src, AlmaLength, AlmaOffset, AlmaSigma)
VWMA = ta.vwma(Src, VwmaLength)
ScalingFactor = 20

// Trend
Trend_Raw = Alma - VWMA
Trend_Norm = Trend_Raw / VWMA
normalize(x) =>
    x / (1 + math.abs(x))
trend = normalize(Trend_Norm * ScalingFactor)

// Momentum
ROC = ta.roc(Src, RocLength)
Roc_Vol = ta.stdev(ROC, 50)
momentum = normalize(ROC / Roc_Vol)

// Combine
score = (trend * 0.6) + (momentum * 0.4)
osc = math.max(math.min(score * 100, 100), -100)
osc_smooth = ta.alma(osc, AlmaLength, AlmaOffset, AlmaSigma)

// Conditions
longCondition = osc_smooth > 30 and osc_smooth[1] <= 30
exitCondition = osc_smooth < -10
shortCondition = osc_smooth < -30 and osc_smooth[1] >= -30
exitShort = osc_smooth > 0
size = osc_smooth / 100

// Execution
if (longCondition)
    strategy.entry("Long", strategy.long)

if (exitCondition)
    strategy.close("Long")

plot(osc_smooth, title="Oscillator", 
     color=osc_smooth > 0 ? color.new(color.aqua, 0) : color.new(color.fuchsia, 0), 
     linewidth=2)

hline(30, "Risk On", color=color.green)
hline(0, "Neutral", color=color.gray)
hline(-30, "Risk Off", color=color.red)

// Scale Anchors
plot(100,  title="Scale Max", display=display.none, editable=false)
plot(-100, title="Scale Min", display=display.none, editable=false)

// Backtest Settings
startDate = input.time(timestamp("2017-01-01"), "Start Date", group="Backtest Settings")
endDate   = input.time(timestamp("2069-12-31"), "End Date",   group="Backtest Settings")

inRange = time >= startDate and time <= endDate

if time > endDate
    strategy.close_all()

// Use strategy.equity
equity = strategy.equity

// Only count bars where strategy is actually in a position
isActive = strategy.position_size != 0

// Per-bar return — only when active AND in range
ret = equity > 0 and equity[1] > 0 ? (equity - equity[1]) / equity[1] : na

var float sumRet     = 0.0
var float sumRetSq   = 0.0
var float sumDown    = 0.0
var float sumGains   = 0.0
var float sumLosses  = 0.0
var int   nBars      = 0
var int   nActiveBars = 0
var float peakEq     = strategy.initial_capital
var float maxDD_full = 0.0

if not na(ret) and inRange
    peakEq     := math.max(peakEq, equity)
    curDD       = (equity - peakEq) / peakEq
    maxDD_full := math.min(maxDD_full, curDD)

    if isActive
        sumRet    += ret
        sumRetSq  += ret * ret
        nBars     += 1
        if ret > 0
            sumGains  += ret
        else
            sumDown   += ret * ret
            sumLosses += math.abs(ret)

// Annualisation
barsPerYear = timeframe.isintraday  ? (252 * 390 / timeframe.multiplier) :
              timeframe.isdaily     ? 252 :
              timeframe.isweekly    ? 52  :
              timeframe.ismonthly   ? 12  : 252

// Metrics
avgRet      = nBars > 0 ? sumRet    / nBars : 0.0
variance    = nBars > 0 ? (sumRetSq / nBars) - (avgRet * avgRet) : 0.0
stdRet      = variance  > 0 ? math.sqrt(variance)       : 0.0
downsideStd = nBars     > 0 ? math.sqrt(sumDown / nBars) : 0.0

annRet  = avgRet      * barsPerYear
annStd  = stdRet      * math.sqrt(barsPerYear)
annDown = downsideStd * math.sqrt(barsPerYear)

sharpe  = annStd     != 0 ? annRet / annStd               : 0.0
sortino = annDown    != 0 ? annRet / annDown               : 0.0
omega   = sumLosses  != 0 ? sumGains / sumLosses           : 0.0
calmar  = maxDD_full != 0 ? annRet  / math.abs(maxDD_full) : 0.0

pnl = strategy.equity - strategy.initial_capital

// Equity Curve (hidden, kept for fill reference)
var float baseEquity = na
if inRange and na(baseEquity)
    baseEquity := equity

// Table
var table t = table.new(position.top_right, 2, 7,
     bgcolor      = color.new(color.black, 70),
     border_color = color.new(color.gray, 50),
     border_width = 1)

if barstate.islastconfirmedhistory
    table.cell(t, 0, 0, "Metric",     text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 0, "Value",      text_color=color.gray,  text_size=size.small)
    table.cell(t, 0, 1, "Sharpe",     text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(sharpe,  "#.##"), text_color=sharpe  > 1 ? color.aqua : color.fuchsia, text_size=size.small)
    table.cell(t, 0, 2, "Sortino",    text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(sortino, "#.##"), text_color=sortino > 1 ? color.aqua : color.fuchsia, text_size=size.small)
    table.cell(t, 0, 3, "Omega",      text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(omega,   "#.##"), text_color=omega   > 1 ? color.aqua : color.fuchsia, text_size=size.small)
    table.cell(t, 0, 4, "Calmar",     text_color=color.white, text_size=size.small)
    table.cell(t, 1, 4, str.tostring(calmar,  "#.##"), text_color=calmar  > 1 ? color.aqua : color.fuchsia, text_size=size.small)
    table.cell(t, 0, 5, "Max DD",     text_color=color.white, text_size=size.small)
    table.cell(t, 1, 5, str.tostring(maxDD_full * 100, "#.##") + "%", text_color=color.fuchsia, text_size=size.small)
    table.cell(t, 0, 6, "PnL",        text_color=color.white, text_size=size.small)
    table.cell(t, 1, 6, "$" + str.tostring(pnl, "#"), text_color=pnl > 0 ? color.aqua : color.fuchsia, text_size=size.small)