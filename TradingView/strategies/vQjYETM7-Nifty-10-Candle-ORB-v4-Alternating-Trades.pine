//@version=5
strategy("Nifty 10-Candle ORB v4 (Alternating Trades)", overlay=true, initial_capital=100000)

// --- 1. Inputs ---
tp_percent = input.float(1.0, title="Profit Target (%)", step=0.1)
sl_percent = input.float(0.5, title="Stop Loss (%)", step=0.1)
num_candles = input.int(10, title="Number of Opening Candles", minval=1)

// Time Inputs
exit_time_hour   = input.int(15, title="Exit Hour (24h)", minval=0, maxval=23)
exit_time_minute = input.int(0, title="Exit Minute", minval=0, maxval=59)
last_trade_hour  = input.int(15, title="Last Entry Hour (24h)", minval=0, maxval=23)

// --- 2. Global Variables ---
var float session_high = na
var float session_low = na
var int candle_idx = 0
// Variable to track the last trade type: 0 = None, 1 = Long, -1 = Short
var int last_trade_type = 0 

// --- 3. Session Reset Logic ---
is_new_day = ta.change(time("D")) != 0

if is_new_day
    session_high := na
    session_low := na
    candle_idx := 0
    last_trade_type := 0 // Reset memory for the new day

// --- 4. Range Calculation ---
if not na(time("D")) and candle_idx < num_candles
    candle_idx := candle_idx + 1
    session_high := na(session_high) ? high : math.max(session_high, high)
    session_low := na(session_low) ? low : math.min(session_low, low)

// --- 5. Plotting ---
plot(candle_idx >= num_candles ? session_high : na, color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2, title="ORB High")
plot(candle_idx >= num_candles ? session_low : na, color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2, title="ORB Low")

// --- 6. Time Logic ---
current_time = hour * 100 + minute
is_exit_time = current_time >= (exit_time_hour * 100 + exit_time_minute)
can_enter    = current_time < (last_trade_hour * 100)

// --- 7. Entry & Exit Logic ---
can_trade = candle_idx >= num_candles and strategy.position_size == 0 and can_enter and not is_exit_time

// Logic: Take Long if no previous trade today OR if the last trade was Short
long_condition = can_trade and ta.crossover(close, session_high) and (last_trade_type <= 0)
// Logic: Take Short if no previous trade today OR if the last trade was Long
short_condition = can_trade and ta.crossunder(close, session_low) and (last_trade_type >= 0)

if (long_condition)
    strategy.entry("Long", strategy.long)
    last_trade_type := 1

if (short_condition)
    strategy.entry("Short", strategy.short)
    last_trade_type := -1

// --- 8. Percentage-Based Exits ---
long_tp_price = strategy.position_avg_price * (1 + tp_percent / 100)
long_sl_price = strategy.position_avg_price * (1 - sl_percent / 100)

short_tp_price = strategy.position_avg_price * (1 - tp_percent / 100)
short_sl_price = strategy.position_avg_price * (1 + sl_percent / 100)

if strategy.position_size > 0
    strategy.exit("Exit Long", "Long", limit=long_tp_price, stop=long_sl_price)

if strategy.position_size < 0
    strategy.exit("Exit Short", "Short", limit=short_tp_price, stop=short_sl_price)

// --- 9. Forced EOD Square Off ---
if is_exit_time
    strategy.close_all(comment="EOD Square Off")