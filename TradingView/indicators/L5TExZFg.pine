indicator("PPP MA-MTF v1.5.3.8", overlay=true, max_labels_count=500, max_lines_count=50)

//=============================================================================
// FONCTIONS
//=============================================================================

f_ma(string maType, int length) =>
    maType == "EMA" ? ta.ema(close, length) : ta.sma(close, length)

f_maSlope(string maType, int length, int lookback) =>
    float _ma = f_ma(maType, length)
    (_ma - _ma[lookback]) / lookback

f_tfName(string tf) =>
    float sec = timeframe.in_seconds(tf)
    string result = tf

    if sec % 604800 == 0
        int n = int(sec / 604800)
        result := n == 1 ? "W" : str.tostring(n) + "W"
    else if sec % 86400 == 0
        int n = int(sec / 86400)
        result := n == 1 ? "D" : str.tostring(n) + "D"
    else if sec % 3600 == 0
        int n = int(sec / 3600)
        result := "H" + str.tostring(n)
    else if sec % 60 == 0
        int n = int(sec / 60)
        result := "M" + str.tostring(n)

    result

f_duration(int length, string tf) =>
    float totalSeconds = length * timeframe.in_seconds(tf)
    float days = totalSeconds / 86400.0
    string result = ""

    if days >= 1
        result := str.tostring(days, "#.#") + "j"
    else
        float hours = totalSeconds / 3600.0

        if hours >= 1
            result := str.tostring(hours, "#.#") + "h"
        else
            float minutes = totalSeconds / 60.0
            result := str.tostring(minutes, "#") + "min"

    result

f_autoName(string maType, int length, string tf) =>
    maType + " " + str.tostring(length) + " " + f_tfName(tf) + " | " + f_duration(length, tf)

f_shortName(string maType, int length, string tf) =>
    maType + " " + str.tostring(length) + " " + f_tfName(tf)

f_name(string customName, string maType, int length, string tf) =>
    customName == "" ? f_autoName(maType, length, tf) : customName

f_labelSize(string selected) =>
    switch selected
        "Minuscule" => size.tiny
        "Petite"    => size.small
        "Normale"   => size.normal
        "Grande"    => size.large
        => size.small

f_projectionSize(int width) =>
    width <= 1 ? size.tiny :
     width == 2 ? size.small :
     width == 3 ? size.normal :
     size.large

f_lineStyle(string selected) =>
    switch selected
        "Points" => line.style_dotted
        "Tirets" => line.style_dashed
        "Pleine" => line.style_solid
        => line.style_dotted

f_tablePosition(string selected) =>
    switch selected
        "Haut gauche"   => position.top_left
        "Haut centre"   => position.top_center
        "Haut droite"   => position.top_right
        "Milieu gauche" => position.middle_left
        "Milieu centre" => position.middle_center
        "Milieu droite" => position.middle_right
        "Bas gauche"    => position.bottom_left
        "Bas centre"    => position.bottom_center
        "Bas droite"    => position.bottom_right
        => position.top_right

f_status(float value, float tolerancePercent) =>
    float distance = math.abs(close - value) / value * 100

    distance <= tolerancePercent ? "SUR MA" :
     close > value ? "AU-DESSUS" :
     "EN DESSOUS"

f_statusColor(float value, float tolerancePercent) =>
    float distance = math.abs(close - value) / value * 100

    distance <= tolerancePercent ? color.new(color.orange, 20) :
     close > value ? color.new(color.green, 25) :
     color.new(color.red, 25)

//=============================================================================
// FONCTIONS CROSS
//=============================================================================

f_crossState(float fastMA, float slowMA) =>
    fastMA > slowMA ? "HAUSSIER" :
     fastMA < slowMA ? "BAISSIER" :
     "NEUTRE"

f_crossColor(float fastMA, float slowMA) =>
    fastMA > slowMA ? color.new(color.green, 25) :
     fastMA < slowMA ? color.new(color.red, 25) :
     color.new(color.orange, 20)

f_maIndex(string selected) =>
    switch selected
        "MA 1" => 1
        "MA 2" => 2
        "MA 3" => 3
        "MA 4" => 4
        "MA 5" => 5
        "MA 6" => 6
        => 1

f_isDaily(string tf) =>
    timeframe.in_seconds(tf) == 86400

f_isGoldenPair(
     string fastType,
     int fastLen,
     string fastTf,
     string slowType,
     int slowLen,
     string slowTf) =>

    fastType == "SMA" and
     slowType == "SMA" and
     fastLen == 50 and
     slowLen == 200 and
     f_isDaily(fastTf) and
     f_isDaily(slowTf)

f_specialCrossName(
     bool bullish,
     string fastType,
     int fastLen,
     string fastTf,
     string slowType,
     int slowLen,
     string slowTf) =>

    bool goldenPair = f_isGoldenPair(
         fastType,
         fastLen,
         fastTf,
         slowType,
         slowLen,
         slowTf
     )

    goldenPair ?
         (bullish ? "GOLDEN CROSS" : "DEATH CROSS") :
         (bullish ? "Cross haussier" : "Cross baissier")

//=============================================================================
// PROJECTION NORMALISÉE AU TEMPS
//=============================================================================

f_project(
     float maValue,
     float slopePerMaBar,
     float maTfSeconds,
     float chartTfSeconds,
     int chartBarsAhead) =>

    float futureSeconds = chartBarsAhead * chartTfSeconds
    float maBarsAhead = futureSeconds / maTfSeconds
    maValue + slopePerMaBar * maBarsAhead

