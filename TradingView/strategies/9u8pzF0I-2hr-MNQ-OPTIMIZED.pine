//@version=5
strategy(
     title="MNQ StochRSI Long & Short Strategy",
     shorttitle="MNQ StochRSI L/S",
     overlay=true,
     default_qty_type=strategy.fixed,
     default_qty_value=8,
     initial_capital=4500,
     currency=currency.USD,
     commission_type=strategy.commission.cash_per_contract,
     commission_value=0.62,
     calc_on_every_tick=true
     )

// ─── INPUTS ────────────────────────────────────────────────────────────────
rsiLen       = input.int(14,   "RSI Length",                    minval=1)
stochLen     = input.int(14,   "Stoch Length",                  minval=1)
smoothK      = input.int(3,    "K Smoothing",                   minval=1)
emaLen       = input.int(20,   "EMA Length",                    minval=1)

// Short inputs
shortArm     = input.float(95.0, "Short Trigger 1 (Arm)",       minval=50, maxval=100)
shortEntry   = input.float(75.0, "Short Trigger 2 (Entry)",     minval=50, maxval=100)
shortExit    = input.float(5.0,  "Short Exit (StochRSI)",       minval=0,  maxval=50)
shortTrail   = input.float(30.0, "Short Trailing Stop (points)")

// Long inputs
longArm      = input.float(5.0,   "Long Trigger 1 (Arm)",       minval=0,  maxval=50)
longEntry    = input.float(20.0,  "Long Trigger 2 (Entry)",     minval=0,  maxval=50)
longExit     = input.float(95.0,  "Long Exit (StochRSI)",       minval=50, maxval=100)
longTrail    = input.float(35.0,  "Long Trailing Stop (points)")

// ─── HARD DOLLAR STOP ─────────────────────────────────────────────────────
// MNQ = $2/point, 8 contracts = $16/point. $3000 / $16 = 187.5 points max loss.
dollarStop   = input.float(3000.0, "Hard Stop Loss ($)",        minval=1)
pointValue   = input.float(16.0,   "$ Per Point (contracts × $2)", minval=1)
hardStopPts  = dollarStop / pointValue  // 187.5 points at default settings

// ─── SESSION TIMES (Eastern) ───────────────────────────────────────────────
closeHour    = 16
closeMinute  = 58
openHour     = 18
openMinute   = 0

barHour      = hour(time, "America/New_York")
barMinute    = minute(time, "America/New_York")

barTimeMin   = barHour * 60 + barMinute
closeTimeMin = closeHour * 60 + closeMinute
openTimeMin  = openHour * 60 + openMinute

inDeadZone   = barTimeMin >= closeTimeMin and barTimeMin < openTimeMin
isCloseBar   = barHour == closeHour and barMinute == closeMinute

// ─── INDICATORS ────────────────────────────────────────────────────────────
rsiVal  = ta.rsi(close, rsiLen)
k_raw   = ta.stoch(rsiVal, rsiVal, rsiVal, stochLen)
K       = ta.sma(k_raw, smoothK)
ema20   = ta.ema(close, emaLen)

var bool shortEmaHit = false
var bool longEmaHit  = false

// ─── TRACK POSITION THAT WAS OPEN AT CLOSE ────────────────────────────────
var int  savedDirection = 0
var bool shortArmed     = false
var bool longArmed      = false

// Force close at 4:58 PM and save direction
if isCloseBar and strategy.position_size != 0
    savedDirection := strategy.position_size > 0 ? 1 : -1
    strategy.close_all(comment="Market Close 4:58 PM")

// Reopen at 6:00 PM if there was an open trade
if barHour == openHour and barMinute == openMinute
    if savedDirection == 1
        strategy.entry("Long", strategy.long, qty=8, comment="Reopen Long 6 PM")
    else if savedDirection == -1
        strategy.entry("Short", strategy.short, qty=8, comment="Reopen Short 6 PM")
    savedDirection := 0

// ─── SHORT TRIGGER LOGIC ───────────────────────────────────────────────────
if strategy.position_size == 0 and not inDeadZone
    if K >= shortArm
        shortArmed    := true
        shortEmaHit   := false
    if K <= shortExit
        shortArmed    := false
        shortEmaHit   := false

if shortArmed and strategy.position_size == 0 and not inDeadZone
    if high >= ema20
        shortEmaHit := true

shortCondition = shortArmed and shortEmaHit and strategy.position_size == 0 and K <= shortEntry and not inDeadZone

if shortCondition
    strategy.entry("Short", strategy.short, qty=8)
    shortArmed  := false
    shortEmaHit := false

// ─── LONG TRIGGER LOGIC ────────────────────────────────────────────────────
if strategy.position_size == 0 and not inDeadZone
    if K <= longArm
        longArmed   := true
        longEmaHit  := false
    if K >= longExit
        longArmed   := false
        longEmaHit  := false

if longArmed and strategy.position_size == 0 and not inDeadZone
    if low <= ema20
        longEmaHit := true

longCondition = longArmed and longEmaHit and strategy.position_size == 0 and K >= longEntry and not inDeadZone

if longCondition
    strategy.entry("Long", strategy.long, qty=8)
    longArmed  := false
    longEmaHit := false

// ─── EXITS ────────────────────────────────────────────────────────────────
strategy.exit("Short Trail Stop",
     from_entry   = "Short",
     stop         = strategy.position_avg_price + hardStopPts,
     trail_points = shortTrail,
     trail_offset = shortTrail)

strategy.exit("Long Trail Stop",
     from_entry   = "Long",
     stop         = strategy.position_avg_price - hardStopPts,
     trail_points = longTrail,
     trail_offset = longTrail)

if strategy.position_size < 0 and K <= shortExit
    strategy.close("Short", comment="StochRSI Exit")

if strategy.position_size > 0 and K >= longExit
    strategy.close("Long", comment="StochRSI Exit")

// ─── PLOTS ────────────────────────────────────────────────────────────────
plot(ema20, title="20 EMA", color=color.yellow, linewidth=2)

plotshape(shortCondition,
     title="Short Entry", style=shape.triangledown,
     location=location.abovebar, color=color.red, size=size.small, text="SHORT")

plotshape(longCondition,
     title="Long Entry", style=shape.triangleup,
     location=location.belowbar, color=color.blue, size=size.small, text="LONG")

plotshape(strategy.position_size < 0 and K <= shortExit,
     title="Short Exit", style=shape.triangleup,
     location=location.belowbar, color=color.green, size=size.small, text="S-EXIT")

plotshape(strategy.position_size > 0 and K >= longExit,
     title="Long Exit", style=shape.triangledown,
     location=location.abovebar, color=color.orange, size=size.small, text="L-EXIT")

bgcolor(inDeadZone ? color.new(color.gray, 90) : na, title="Dead Zone")

hardStopShort = strategy.position_size < 0 ? strategy.position_avg_price + hardStopPts : na
hardStopLong  = strategy.position_size > 0 ? strategy.position_avg_price - hardStopPts : na

plot(hardStopShort, title="Hard Stop (Short)", color=color.red,    style=plot.style_linebr, linewidth=2)
plot(hardStopLong,  title="Hard Stop (Long)",  color=color.red,    style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? strategy.position_avg_price : na,
     title="Entry Price", color=color.orange, style=plot.style_linebr, linewidth=1)