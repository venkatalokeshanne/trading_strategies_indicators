//@version=5
strategy("ES ORB Strategy (2 Contracts, Same TP/SL, HTF Filter)", overlay=true, pyramiding=0, default_qty_type=strategy.fixed, default_qty_value=2)

// Session times
startTime = timestamp("America/New_York", year, month, dayofmonth, 9, 30)
endTime   = timestamp("America/New_York", year, month, dayofmonth, 9, 45)

// Detect new day
newDay = ta.change(time("D")) != 0

// Opening range variables
var float orHigh = na
var float orLow  = na

// Daily trade state
var int tradesToday = 0
var bool longTakenToday = false
var bool shortTakenToday = false

if newDay
    orHigh := na
    orLow := na
    tradesToday := 0
    longTakenToday := false
    shortTakenToday := false

// Track opening range
inORB = time >= startTime and time <= endTime

if inORB
    orHigh := na(orHigh) ? high : math.max(orHigh, high)
    orLow  := na(orLow) ? low : math.min(orLow, low)

// VWAP
vwapValue = ta.vwap(close)

// Higher-timeframe trend filter
htfTf = input.timeframe("15", "Higher Timeframe")
htfEmaLength = input.int(20, "HTF EMA Length", minval=1)
htfClose = request.security(syminfo.tickerid, htfTf, close)
htfEMA   = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfEmaLength))

htfLongFilter  = htfClose > htfEMA
htfShortFilter = htfClose < htfEMA

// Only trade after OR window is complete
afterORB = time > endTime

// Risk settings in POINTS
stopPoints   = input.float(32.0, "Stop Loss (Points)", step=0.25)
targetPoints = input.float(64.0, "Target (Points)", step=0.25)

// Breakout triggers: only fire on the crossing bar
longBreakout  = afterORB and not na(orHigh) and ta.crossover(close, orHigh)
shortBreakout = afterORB and not na(orLow)  and ta.crossunder(close, orLow)

// Filters
longCondition  = longBreakout and close > vwapValue and htfLongFilter
shortCondition = shortBreakout and close < vwapValue and htfShortFilter

// Max 2 trades total per day
canTrade = tradesToday < 2

// Entries
if longCondition and strategy.position_size == 0 and canTrade and not longTakenToday
    strategy.entry("Long", strategy.long, qty=2)
    tradesToday += 1
    longTakenToday := true

if shortCondition and strategy.position_size == 0 and canTrade and not shortTakenToday
    strategy.entry("Short", strategy.short, qty=2)
    tradesToday += 1
    shortTakenToday := true

// Exits using actual price levels
if strategy.position_size > 0
    longEntryPrice = strategy.position_avg_price
    longStopPrice  = longEntryPrice - stopPoints
    longTargetPrice = longEntryPrice + targetPoints
    strategy.exit("Long Exit", from_entry="Long", stop=longStopPrice, limit=longTargetPrice)

if strategy.position_size < 0
    shortEntryPrice = strategy.position_avg_price
    shortStopPrice  = shortEntryPrice + stopPoints
    shortTargetPrice = shortEntryPrice - targetPoints
    strategy.exit("Short Exit", from_entry="Short", stop=shortStopPrice, limit=shortTargetPrice)

// Plot OR levels and VWAP
plot(orHigh, color=color.green, title="OR High")
plot(orLow, color=color.red, title="OR Low")
plot(vwapValue, color=color.blue, title="VWAP")
plot(htfEMA, color=color.orange, title="HTF EMA")