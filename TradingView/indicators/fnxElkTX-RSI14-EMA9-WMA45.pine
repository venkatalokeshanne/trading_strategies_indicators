//@version=6
indicator("RSI14 - EMA9 - WMA45", shorttitle="RSI14 - EMA9 - WMA45", overlay=false)

// ================= CỐ ĐỊNH CHU KỲ (không phải input) =================
RSI_LEN  = 14
EMA_LEN  = 9
WMA_LEN  = 45

// ================= TAB: INPUTS =================
rsiSource = input.source(close, title="Source", group="RSI Settings")

showOverBuyBg  = input.bool(true, title="Over Buy", group="RSI Settings", inline="ob")
overBuy        = input.int(80, title="", group="RSI Settings", inline="ob")
overBuyColor   = input.color(color.new(color.red, 80), title="", group="RSI Settings", inline="ob")

showOverSellBg = input.bool(true, title="Over Sell", group="RSI Settings", inline="os")
overSell       = input.int(20, title="", group="RSI Settings", inline="os")
overSellColor  = input.color(color.new(color.green, 80), title="", group="RSI Settings", inline="os")

sma1Length = input.int(10, title="Length1", group="SMA Settings")
sma2Length = input.int(20, title="Length2", group="SMA Settings")

showMTF   = input.bool(false, title="RSI Multi-timeframe", group="Multi-Timeframe RSI Table Settings")

tablePosStr  = input.string("top_right", title="Location", options=["top_right","top_left","top_center","bottom_right","bottom_left","bottom_center"], group="Table Settings")
tableSizeStr = input.string("small", title="Size", options=["tiny","small","normal","large","huge"], group="Table Settings")

// ================= TAB: STYLE =================
showRSI  = input.bool(true, title="RSI 14", group="Style", inline="l1")
rsiColor = input.color(color.new(#B44FD1, 0), title="", group="Style", inline="l1")

showEMA  = input.bool(true, title="EMA 9", group="Style", inline="l2")
emaColor = input.color(color.new(color.green, 0), title="", group="Style", inline="l2")

showWMA  = input.bool(true, title="WMA 45", group="Style", inline="l3")
wmaColor = input.color(color.new(color.blue, 0), title="", group="Style", inline="l3")

showSMA1  = input.bool(true, title="Biểu đồ", group="Style", inline="sma1")
sma1Color = input.color(color.red, title="", group="Style", inline="sma1")

showSMA2  = input.bool(true, title="Biểu đồ", group="Style", inline="sma2")
sma2Color = input.color(color.teal, title="", group="Style", inline="sma2")

// -- 5 vùng nền CỐ ĐỊNH theo trục 0-100 --
showOverboughtFill = input.bool(true, title="RSI Overbought Region Fill (80-100)", group="Region Fills", inline="f1")
overboughtFillColor = input.color(color.new(color.green, 85), title="", group="Region Fills", inline="f1")

showBullishFill = input.bool(true, title="RSI Bullish Region Fill (60-80)", group="Region Fills", inline="f2")
bullishFillColor = input.color(color.new(#B44FD1, 90), title="", group="Region Fills", inline="f2")

showNeutralFill = input.bool(true, title="RSI Neutral Region Fill (40-60)", group="Region Fills", inline="f3")
neutralFillColor = input.color(color.new(#B44FD1, 95), title="", group="Region Fills", inline="f3")

showBearishFill = input.bool(true, title="RSI Bearish Region Fill (20-40)", group="Region Fills", inline="f4")
bearishFillColor = input.color(color.new(#B44FD1, 90), title="", group="Region Fills", inline="f4")

showOversoldFill = input.bool(true, title="RSI Oversold Region Fill (0-20)", group="Region Fills", inline="f5")
oversoldFillColor = input.color(color.new(color.orange, 85), title="", group="Region Fills", inline="f5")

// -- Band 70 / 30 cấu hình được --
showBullish  = input.bool(true, title="RSI Bullish Band", group="Bands", inline="bull")
bullishLevel = input.int(70, title="", group="Bands", inline="bull")
bullishColor = input.color(color.new(#000000, 30), title="", group="Bands", inline="bull")

showBearish  = input.bool(true, title="RSI Bearish Band", group="Bands", inline="bear")
bearishLevel = input.int(30, title="", group="Bands", inline="bear")
bearishColor = input.color(color.new(#000000, 30), title="", group="Bands", inline="bear")

showTables = input.bool(true, title="Tables", group="Graphic Objects")

// ================= TÍNH TOÁN =================
rsiValue = ta.rsi(rsiSource, RSI_LEN)
emaLine  = ta.ema(rsiValue, EMA_LEN)
wmaLine  = ta.wma(rsiValue, WMA_LEN)
sma1     = ta.sma(close, sma1Length)
sma2     = ta.sma(close, sma2Length)

// ================= VẼ SMA ĐÈ LÊN CHART GIÁ =================
plot(showSMA1 ? sma1 : na, title="SMA 1", color=sma1Color, linewidth=2, force_overlay=true)
plot(showSMA2 ? sma2 : na, title="SMA 2", color=sma2Color, linewidth=2, force_overlay=true)

// ================= 5 VÙNG NỀN DÙNG BOX (kéo dài vô hạn sang phải) =================
var box overboughtBox = na
var box bullishBox    = na
var box neutralBox    = na
var box bearishBox    = na
var box oversoldBox   = na

if barstate.isfirst
    overboughtBox := box.new(bar_index, 100, bar_index, 80, border_color=na, bgcolor=na, extend=extend.right)
    bullishBox    := box.new(bar_index, 80,  bar_index, 60, border_color=na, bgcolor=na, extend=extend.right)
    neutralBox    := box.new(bar_index, 60,  bar_index, 40, border_color=na, bgcolor=na, extend=extend.right)
    bearishBox    := box.new(bar_index, 40,  bar_index, 20, border_color=na, bgcolor=na, extend=extend.right)
    oversoldBox   := box.new(bar_index, 20,  bar_index, 0,  border_color=na, bgcolor=na, extend=extend.right)

box.set_bgcolor(overboughtBox, showOverboughtFill ? overboughtFillColor : na)
box.set_bgcolor(bullishBox,    showBullishFill    ? bullishFillColor    : na)
box.set_bgcolor(neutralBox,    showNeutralFill    ? neutralFillColor    : na)
box.set_bgcolor(bearishBox,    showBearishFill    ? bearishFillColor    : na)
box.set_bgcolor(oversoldBox,   showOversoldFill   ? oversoldFillColor   : na)

// ================= BAND 70/30 (nét đứt, không hiện ở status line) =================
hline(bullishLevel, title="RSI Bullish Band", color=showBullish ? bullishColor : na, linestyle=hline.style_dashed, linewidth=1)
hline(bearishLevel, title="RSI Bearish Band", color=showBearish ? bearishColor : na, linestyle=hline.style_dashed, linewidth=1)

// ================= VẼ 3 ĐƯỜNG (chỉ 3 đường này hiện giá trị ở status line) =================
plot(showRSI ? rsiValue : na, title="RSI 14", color=rsiColor, linewidth=2)
plot(showEMA ? emaLine  : na, title="EMA 9",  color=emaColor, linewidth=1)
plot(showWMA ? wmaLine  : na, title="WMA 45", color=wmaColor, linewidth=1)

// ================= HIGHLIGHT KHI VƯỢT OVER BUY / OVER SELL =================
bgcolor(showOverBuyBg  and rsiValue >= overBuy  ? overBuyColor  : na, title="Over Buy Highlight")
bgcolor(showOverSellBg and rsiValue <= overSell ? overSellColor : na, title="Over Sell Highlight")

// ================= BẢNG MULTI-TIMEFRAME =================
getRSI(tf) => request.security(syminfo.tickerid, tf, ta.rsi(rsiSource, RSI_LEN), lookahead=barmerge.lookahead_off)
tfList = array.from("60", "240", "D", "W")

statusColor(v) => v >= overBuy ? color.new(color.red, 20) : v <= overSell ? color.new(color.green, 20) : color.new(color.gray, 40)

getPos(p) =>
    switch p
        "top_right"      => position.top_right
        "top_left"       => position.top_left
        "top_center"     => position.top_center
        "bottom_right"   => position.bottom_right
        "bottom_left"    => position.bottom_left
        "bottom_center"  => position.bottom_center
        => position.top_right

getSize(s) =>
    switch s
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        "huge"   => size.huge
        => size.small

if showMTF and showTables and barstate.islast
    var table mtfTable = table.new(getPos(tablePosStr), 2, array.size(tfList) + 1, border_width=1)
    table.cell(mtfTable, 0, 0, "TF",  bgcolor=color.new(color.gray, 60), text_color=color.white, text_size=getSize(tableSizeStr))
    table.cell(mtfTable, 1, 0, "RSI", bgcolor=color.new(color.gray, 60), text_color=color.white, text_size=getSize(tableSizeStr))
    for i = 0 to array.size(tfList) - 1
        tf = array.get(tfList, i)
        v  = getRSI(tf)
        table.cell(mtfTable, 0, i + 1, tf, text_color=color.white, text_size=getSize(tableSizeStr))
        table.cell(mtfTable, 1, i + 1, str.tostring(v, "#.##"), bgcolor=statusColor(v), text_color=color.white, text_size=getSize(tableSizeStr))