//@version=6
// ============================================================================
//  GOLD SESSION MAP & SWEEP SIGNALS  —  XAU/USD
//  ---------------------------------------------------------------------------
//  Draws the Asian / London / New York sessions, marks the Asian range, and
//  flags the "sweep and reclaim" reversal that fires when London or New York
//  runs the Asian range and price then closes back inside it.
//
//  Session windows are defined in UTC by default so they do NOT drift when
//  London and New York change their clocks. The dashboard converts to whatever
//  local timezone you choose, for display only.
//
//  This is an INDICATOR, not a strategy. It plots signals and keeps a running
//  tally of how those signals resolved; it places no orders. The tally is a
//  rough sanity check on a chart, not a backtest — see the notes at the bottom.
//  Nothing here is financial advice.
// ============================================================================

indicator("Gold Session Map & Sweep Signals", "Gold Sessions", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ----------------------------------------------------------------------------
// INPUTS
// ----------------------------------------------------------------------------
gSess = "Sessions  ·  defined in UTC — leave the timezone alone unless you know why"
sessTz   = input.string("UTC", "Session timezone", group = gSess,
     options = ["UTC", "Europe/London", "America/New_York", "Africa/Nairobi", "Asia/Tokyo", "Australia/Sydney"])
asiaSess = input.session("0000-0800:1234567", "Asian window",       group = gSess)
lonSess  = input.session("0800-1300:1234567", "London window",      group = gSess)
ovlSess  = input.session("1300-1700:1234567", "London–NY overlap",  group = gSess)
nypmSess = input.session("1700-2200:1234567", "New York afternoon", group = gSess)
showBg   = input.bool(true, "Shade sessions on the chart", group = gSess)
showBox  = input.bool(true, "Draw the Asian range box",    group = gSess)

gDisp = "Display"
dispTz    = input.string("Africa/Nairobi", "Dashboard clock", group = gDisp,
     options = ["UTC", "Africa/Nairobi", "Europe/London", "America/New_York", "Asia/Tokyo", "Australia/Sydney", "Asia/Dubai", "Asia/Kolkata"])
showPanel = input.bool(true, "Show dashboard", group = gDisp)
panelPos  = input.string("Top right", "Dashboard position", group = gDisp,
     options = ["Top right", "Top left", "Bottom right", "Bottom left"])

gSig = "Signal logic"
tradeWindow = input.string("London + Overlap", "Take signals during", group = gSig,
     options = ["London + Overlap", "Overlap only", "London only", "London + Overlap + NY afternoon"])
dirFilter = input.string("Both", "Direction", group = gSig, options = ["Both", "Long only", "Short only"])
minSweep  = input.float(0.05, "Minimum sweep depth (fraction of Asian range)", minval = 0.0, step = 0.01, group = gSig,
     tooltip = "Price must poke beyond the Asian high/low by at least this fraction of the range before a reclaim counts. Filters out one-tick brushes.")
useEma     = input.bool(false, "Require trend agreement (EMA filter)", group = gSig)
emaLen     = input.int(50, "EMA length", minval = 2, group = gSig)
oncePerDay = input.bool(true, "One signal per direction per day", group = gSig)

gRisk = "Risk & exits"
adrLen     = input.int(20, "ADR lookback (days)", minval = 2, group = gRisk)
maxAdrUsed = input.float(90, "Block new signals above this % of ADR used", minval = 10, maxval = 300, group = gRisk,
     tooltip = "Gold that has already travelled its average daily range has little fuel left. 90% is a sensible ceiling; past 130% is exhaustion.")
slBufAtr = input.float(0.25, "Stop buffer (x ATR14)", minval = 0.0, step = 0.05, group = gRisk)
rr       = input.float(2.0, "Target (R multiple)", minval = 0.25, step = 0.25, group = gRisk)
flatSess = input.session("2100-2200:1234567", "Flatten-by window", group = gRisk,
     tooltip = "Any open signal is marked closed when this window is reached, keeping trades out of the illiquid overnight.")

gNews = "News blackout"
useNews  = input.bool(true, "Block signals around US data", group = gNews)
newsHour = input.int(12, "Blackout centre — hour (session tz)", minval = 0, maxval = 23, group = gNews)
newsMinute = input.int(30, "Blackout centre — minute", minval = 0, maxval = 59, group = gNews)
newsPad  = input.int(15, "Minutes either side", minval = 0, maxval = 120, group = gNews)

// ----------------------------------------------------------------------------
// PALETTE — validated for colour-vision deficiency against both chart themes
// ----------------------------------------------------------------------------
cAsia   = #2a78d6
cLondon = #eb6834
cNY     = #1baf7a
cLong   = #1baf7a
cShort  = #e34948
cWarn   = #eda100
cInk    = #c3c2b7

// ----------------------------------------------------------------------------
// SESSION STATE
// ----------------------------------------------------------------------------
inAsia = not na(time(timeframe.period, asiaSess, sessTz))
inLon  = not na(time(timeframe.period, lonSess,  sessTz))
inOvl  = not na(time(timeframe.period, ovlSess,  sessTz))
inNYpm = not na(time(timeframe.period, nypmSess, sessTz))
inFlat = not na(time(timeframe.period, flatSess, sessTz))

sessionName = inAsia ? "Asian" : inLon ? "London" : inOvl ? "London–NY overlap" : inNYpm ? "New York PM" : "Off-session"

tradeOk = switch tradeWindow
    "Overlap only"                    => inOvl
    "London only"                     => inLon
    "London + Overlap + NY afternoon" => inLon or inOvl or inNYpm
    => inLon or inOvl

// bgcolor must live at global scope, so the toggle rides inside the condition
bgcolor(showBg and inAsia ? color.new(cAsia,   93) : na, title = "Asian session")
bgcolor(showBg and inLon  ? color.new(cLondon, 93) : na, title = "London session")
bgcolor(showBg and inOvl  ? color.new(cNY,     86) : na, title = "London-NY overlap")
bgcolor(showBg and inNYpm ? color.new(cNY,     94) : na, title = "New York afternoon")

// ----------------------------------------------------------------------------
// ASIAN RANGE
// ----------------------------------------------------------------------------
var float asiaHi  = na
var float asiaLo  = na
var bool  asiaSet = false
var box   asiaBox = na

newAsia = inAsia and not inAsia[1]

if newAsia
    asiaHi  := high
    asiaLo  := low
    asiaSet := false
    if showBox
        asiaBox := box.new(bar_index, high, bar_index, low,
             border_color = color.new(cAsia, 30), border_width = 1,
             bgcolor = color.new(cAsia, 92))
else if inAsia
    asiaHi := math.max(nz(asiaHi, high), high)
    asiaLo := math.min(nz(asiaLo, low),  low)

// freeze the range the moment Asia closes
if not inAsia and inAsia[1]
    asiaSet := true

asiaRange = not na(asiaHi) and not na(asiaLo) ? asiaHi - asiaLo : na

if showBox and not na(asiaBox) and (inAsia or inLon or inOvl or inNYpm)
    box.set_top(asiaBox, asiaHi)
    box.set_bottom(asiaBox, asiaLo)
    box.set_right(asiaBox, bar_index)

// ----------------------------------------------------------------------------
// ADR — built from this chart's own bars, so nothing repaints
// ----------------------------------------------------------------------------
var float dayHi = na
var float dayLo = na
var array<float> dayRanges = array.new<float>()

newDay = timeframe.change("D")

if newDay
    if not na(dayHi) and not na(dayLo)
        array.push(dayRanges, dayHi - dayLo)
        if array.size(dayRanges) > adrLen
            array.shift(dayRanges)
    dayHi := high
    dayLo := low
else
    dayHi := math.max(nz(dayHi, high), high)
    dayLo := math.min(nz(dayLo, low),  low)

adr     = array.size(dayRanges) > 0 ? array.avg(dayRanges) : na
adrUsed = not na(adr) and adr > 0 ? (dayHi - dayLo) / adr * 100.0 : na
adrOk   = na(adrUsed) or adrUsed <= maxAdrUsed

// ----------------------------------------------------------------------------
// FILTERS
// ----------------------------------------------------------------------------
atr = ta.atr(14)
ema = ta.ema(close, emaLen)

curMin  = hour(time, sessTz) * 60 + minute(time, sessTz)
newsMid = newsHour * 60 + newsMinute
inNewsBlackout = useNews and math.abs(curMin - newsMid) <= newsPad

longTrendOk  = not useEma or close > ema
shortTrendOk = not useEma or close < ema
dirLongOk    = dirFilter == "Both" or dirFilter == "Long only"
dirShortOk   = dirFilter == "Both" or dirFilter == "Short only"

// ----------------------------------------------------------------------------
// TRADE STATE  —  exits are resolved before new signals are considered
// ----------------------------------------------------------------------------
var int   tradeDir = 0
var float entryPx  = na
var float slPx     = na
var float tpPx     = na
var int   wins     = 0
var int   losses   = 0
var int   scratch  = 0

bool  exitWin  = false
bool  exitLoss = false
bool  exitFlat = false
float exitPx   = na

if tradeDir != 0
    if tradeDir == 1
        // stop is checked first: if one bar spans both levels, assume the worse fill
        if low <= slPx
            exitLoss := true
            exitPx   := slPx
        else if high >= tpPx
            exitWin := true
            exitPx  := tpPx
    else
        if high >= slPx
            exitLoss := true
            exitPx   := slPx
        else if low <= tpPx
            exitWin := true
            exitPx  := tpPx
    if not exitWin and not exitLoss and inFlat
        exitFlat := true
        exitPx   := close

if exitLoss
    losses   += 1
    tradeDir := 0
else if exitWin
    wins     += 1
    tradeDir := 0
else if exitFlat
    scratch  += 1
    tradeDir := 0

// ----------------------------------------------------------------------------
// SWEEP & RECLAIM
// ----------------------------------------------------------------------------
var bool tookLong  = false
var bool tookShort = false
if newDay
    tookLong  := false
    tookShort := false

sweepPad = not na(asiaRange) ? asiaRange * minSweep : 0.0

rangeReady = asiaSet and not na(asiaHi) and not na(asiaLo) and asiaRange > 0
gatesOpen  = tradeOk and adrOk and not inNewsBlackout and tradeDir == 0
baseOk     = rangeReady and gatesOpen

// long: price dipped meaningfully under the Asian low, then closed back above it
sweptLow  = low  <= asiaLo - sweepPad
reclaimUp = close > asiaLo

// short: price poked above the Asian high, then closed back below it
sweptHigh   = high >= asiaHi + sweepPad
reclaimDown = close < asiaHi

longSig  = baseOk and dirLongOk  and sweptLow    and reclaimUp   and longTrendOk  and (not oncePerDay or not tookLong)
shortSig = baseOk and dirShortOk and sweptHigh   and reclaimDown and shortTrendOk and (not oncePerDay or not tookShort)

if longSig
    tradeDir  := 1
    entryPx   := close
    slPx      := math.min(low, nz(low[1], low)) - atr * slBufAtr
    tpPx      := entryPx + (entryPx - slPx) * rr
    tookLong  := true
else if shortSig
    tradeDir  := -1
    entryPx   := close
    slPx      := math.max(high, nz(high[1], high)) + atr * slBufAtr
    tpPx      := entryPx - (slPx - entryPx) * rr
    tookShort := true

// ----------------------------------------------------------------------------
// PLOTS
// ----------------------------------------------------------------------------
plotshape(longSig,  "Long sweep",  shape.labelup,   location.belowbar,
     color.new(cLong,  0), text = "LONG",  textcolor = color.white, size = size.tiny)
plotshape(shortSig, "Short sweep", shape.labeldown, location.abovebar,
     color.new(cShort, 0), text = "SHORT", textcolor = color.white, size = size.tiny)

plotshape(exitWin  ? exitPx : na, "Target hit", shape.xcross, location.absolute, color.new(cLong,  0), size = size.tiny)
plotshape(exitLoss ? exitPx : na, "Stop hit",   shape.xcross, location.absolute, color.new(cShort, 0), size = size.tiny)
plotshape(exitFlat ? exitPx : na, "Timed out",  shape.xcross, location.absolute, color.new(color.gray, 0), size = size.tiny)

live = tradeDir != 0
plot(live ? entryPx : na, "Entry",  color.new(cInk,   20), 1, plot.style_linebr)
plot(live ? slPx    : na, "Stop",   color.new(cShort, 10), 1, plot.style_linebr)
plot(live ? tpPx    : na, "Target", color.new(cLong,  10), 1, plot.style_linebr)
plot(useEma ? ema : na,   "EMA",    color.new(color.gray, 40), 1)

// ----------------------------------------------------------------------------
// DASHBOARD
// ----------------------------------------------------------------------------
panelPosition = switch panelPos
    "Top left"     => position.top_left
    "Bottom right" => position.bottom_right
    "Bottom left"  => position.bottom_left
    => position.top_right

var table panel = table.new(panelPosition, 2, 9, border_width = 1, frame_width = 1,
     frame_color = color.new(color.gray, 60), border_color = color.new(color.gray, 70))

f_row(int r, string k, string v, color vc) =>
    table.cell(panel, 0, r, k, text_size = size.small, text_color = color.new(cInk, 15),
         text_halign = text.align_left,  bgcolor = color.new(color.black, 75))
    table.cell(panel, 1, r, v, text_size = size.small, text_color = vc,
         text_halign = text.align_right, bgcolor = color.new(color.black, 75))

if showPanel and barstate.islast
    total   = wins + losses
    winRate = total > 0 ? wins / total * 100.0 : na
    sessCol = inOvl ? cNY : inLon ? cLondon : inAsia ? cAsia : color.new(cInk, 40)
    adrCol  = na(adrUsed) ? cInk : adrUsed > 130 ? cShort : adrUsed > maxAdrUsed ? cWarn : cLong
    gateTxt = not tradeOk ? "no — wrong session" : inNewsBlackout ? "no — news window" : not adrOk ? "no — ADR spent" : tradeDir != 0 ? "no — position open" : "yes"
    gateCol = gateTxt == "yes" ? cLong : color.new(cInk, 30)
    posTxt  = tradeDir == 1 ? "LONG open" : tradeDir == -1 ? "SHORT open" : "flat"
    posCol  = tradeDir == 1 ? cLong : tradeDir == -1 ? cShort : color.new(cInk, 30)
    ratePart = total > 0 ? "  ·  " + str.tostring(winRate, "#.#") + "%" : ""
    countTxt = str.tostring(wins) + "W / " + str.tostring(losses) + "L / " + str.tostring(scratch) + " flat"
    recTxt   = total > 0 or scratch > 0 ? countTxt + ratePart : "no signals yet"

    table.cell(panel, 0, 0, "GOLD SESSION MAP", text_size = size.small, text_color = color.white,
         text_halign = text.align_left, bgcolor = color.new(color.black, 55))
    table.cell(panel, 1, 0, str.format_time(time_close, "HH:mm", dispTz) + "  " + dispTz,
         text_size = size.tiny, text_color = color.new(cInk, 20),
         text_halign = text.align_right, bgcolor = color.new(color.black, 55))

    f_row(1, "Session",         sessionName, sessCol)
    f_row(2, "Signals allowed", gateTxt, gateCol)
    f_row(3, "Asian high",      na(asiaHi) ? "—" : str.tostring(asiaHi, format.mintick), color.new(cInk, 15))
    f_row(4, "Asian low",       na(asiaLo) ? "—" : str.tostring(asiaLo, format.mintick), color.new(cInk, 15))
    f_row(5, "ADR(" + str.tostring(adrLen) + ")", na(adr) ? "—" : str.tostring(adr, format.mintick), color.new(cInk, 15))
    f_row(6, "ADR used",        na(adrUsed) ? "—" : str.tostring(adrUsed, "#.#") + "%", adrCol)
    f_row(7, "Position",        posTxt, posCol)
    f_row(8, "Signal record",   recTxt, color.new(cInk, 15))

// ----------------------------------------------------------------------------
// ALERTS
// ----------------------------------------------------------------------------
alertcondition(longSig,  "Gold — long sweep reclaim",  "XAUUSD: Asian low swept and reclaimed. Long setup.")
alertcondition(shortSig, "Gold — short sweep reclaim", "XAUUSD: Asian high swept and reclaimed. Short setup.")
alertcondition(exitWin,  "Gold — target reached",      "XAUUSD: signal target reached.")
alertcondition(exitLoss, "Gold — stop reached",        "XAUUSD: signal stop reached.")

if longSig
    alert("XAUUSD LONG   entry " + str.tostring(entryPx, format.mintick)
         + "   stop " + str.tostring(slPx, format.mintick)
         + "   target " + str.tostring(tpPx, format.mintick), alert.freq_once_per_bar_close)
if shortSig
    alert("XAUUSD SHORT   entry " + str.tostring(entryPx, format.mintick)
         + "   stop " + str.tostring(slPx, format.mintick)
         + "   target " + str.tostring(tpPx, format.mintick), alert.freq_once_per_bar_close)