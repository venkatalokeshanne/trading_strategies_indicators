//@version=6
indicator("Professional Trading Sessions V2 - Part 1",
     overlay = true,
     max_boxes_count = 500,
     max_labels_count = 500,
     max_lines_count = 500)

//====================================================
// INPUTS
//====================================================

groupSessions = "Session Settings"

showAsia = input.bool(true, "Show Asia Session", group = groupSessions)
showLondon = input.bool(true, "Show London Session", group = groupSessions)
showNY = input.bool(true, "Show New York Session", group = groupSessions)
showKillZones = input.bool(true, "Show Kill Zones", group = groupSessions)

asiaSession = input.session("0000-0800", "Asia Session", group = groupSessions)
londonSession = input.session("0900-1700", "London Session", group = groupSessions)
nySession = input.session("1400-2200", "New York Session", group = groupSessions)

londonKZ = input.session("0600-1000", "London Kill Zone", group = groupSessions)
nyKZ = input.session("1200-1600", "New York Kill Zone", group = groupSessions)

// Amsterdam timezone
timezone = "Europe/Amsterdam"

//====================================================
// COLORS
//====================================================

groupColors = "Colors"

asiaColor = input.color(color.new(color.blue, 80), "Asia Box", group = groupColors)
londonColor = input.color(color.new(color.gray, 80), "London Box", group = groupColors)
nyColor = input.color(color.new(color.gray, 80), "New York Box", group = groupColors)

killColor = input.color(color.new(color.green, 75), "Kill Zone", group = groupColors)

//====================================================
// SESSION DETECTION
//====================================================

inAsia = not na(time(timeframe.period, asiaSession, timezone))
inLondon = not na(time(timeframe.period, londonSession, timezone))
inNY = not na(time(timeframe.period, nySession, timezone))

inLondonKZ = not na(time(timeframe.period, londonKZ, timezone))
inNYKZ = not na(time(timeframe.period, nyKZ, timezone))

//====================================================
// BOX VARIABLES
//====================================================

var box asiaBox = na
var box londonBox = na
var box nyBox = na
var box londonKillBox = na
var box nyKillBox = na

//====================================================
// ASIA SESSION
//====================================================

if showAsia

    if inAsia and not inAsia[1]

        asiaBox := box.new(
             left = bar_index,
             right = bar_index,
             top = high,
             bottom = low,
             bgcolor = asiaColor,
             border_color = color.blue)

    if inAsia

        box.set_right(asiaBox, bar_index)

        box.set_top(asiaBox,
             math.max(box.get_top(asiaBox), high))

        box.set_bottom(asiaBox,
             math.min(box.get_bottom(asiaBox), low))

//====================================================
// LONDON SESSION
//====================================================

if showLondon

    if inLondon and not inLondon[1]

        londonBox := box.new(
             left = bar_index,
             right = bar_index,
             top = high,
             bottom = low,
             bgcolor = londonColor,
             border_color = color.gray)

    if inLondon

        box.set_right(londonBox, bar_index)

        box.set_top(londonBox,
             math.max(box.get_top(londonBox), high))

        box.set_bottom(londonBox,
             math.min(box.get_bottom(londonBox), low))

//====================================================
// NEW YORK SESSION
//====================================================

if showNY

    if inNY and not inNY[1]

        nyBox := box.new(
             left = bar_index,
             right = bar_index,
             top = high,
             bottom = low,
             bgcolor = nyColor,
             border_color = color.gray)

    if inNY

        box.set_right(nyBox, bar_index)

        box.set_top(nyBox,
             math.max(box.get_top(nyBox), high))

        box.set_bottom(nyBox,
             math.min(box.get_bottom(nyBox), low))

//====================================================
// LONDON KILL ZONE
//====================================================

if showKillZones

    if inLondonKZ and not inLondonKZ[1]

        londonKillBox := box.new(
             left = bar_index,
             right = bar_index,
             top = high,
             bottom = low,
             bgcolor = killColor,
             border_color = color.green)

    if inLondonKZ

        box.set_right(londonKillBox, bar_index)

        box.set_top(londonKillBox,
             math.max(box.get_top(londonKillBox), high))

        box.set_bottom(londonKillBox,
             math.min(box.get_bottom(londonKillBox), low))

//====================================================
// NEW YORK KILL ZONE
//====================================================

if showKillZones

    if inNYKZ and not inNYKZ[1]

        nyKillBox := box.new(
             left = bar_index,
             right = bar_index,
             top = high,
             bottom = low,
             bgcolor = killColor,
             border_color = color.green)

    if inNYKZ

        box.set_right(nyKillBox, bar_index)

        box.set_top(nyKillBox,
             math.max(box.get_top(nyKillBox), high))

        box.set_bottom(nyKillBox,
             math.min(box.get_bottom(nyKillBox), low))

//====================================================
// LABELS
//====================================================

if inAsia and not inAsia[1]
    label.new(
         bar_index,
         high,
         "Asia",
         style = label.style_label_down,
         color = color.blue,
         textcolor = color.white)

if inLondon and not inLondon[1]
    label.new(
         bar_index,
         high,
         "London",
         style = label.style_label_down,
         color = color.gray,
         textcolor = color.white)

if inNY and not inNY[1]
    label.new(
         bar_index,
         high,
         "New York",
         style = label.style_label_down,
         color = color.gray,
         textcolor = color.white)