//@version=6
strategy("DodgeBear - US Indexes", overlay = true, default_qty_type = strategy.percent_of_equity, default_qty_value=100, currency = currency.USD, initial_capital=100000, margin_long = 0, margin_short = 0)

// 
// This is a long only strategy.  
// This is a position trading strategy targeting multi-month time period trades.
//
// Original intention was just for QQQ position trading, but found good results on all US indexes
// Individual stocks, sector ETFs, crypto, commodities results hit or miss from initial analysis, 
// but not researched or the intention.  
//
//
// SPX and QQQ are the root indexes used to trigger buy and sells.  Since QQQ's inception date is 1999, results only go back to 1999.  
// The IXIC (nasdaq composite) could be used in QQQ's place to look at other time periods prior to 1999.  But 1999-2026 results are better with
// QQQ versus IXIC so that is what this strategy uses.
//
// Improvements from version 1 of this strategy.  
//
// 1. Bear Market Whipsaw Reduction
//   20-bar duration check + Lockout variable - Prevents the system from repeatedly getting stopped out during choppy, downward-trending bear markets ("chasing rallies" during death crosses).
// 2. Momentum Quality Check[/b]	
//   spxOpen >= spxClose[4] - Ensures entries only happen when intermediate 4-day structural momentum is positive or holding, filtering out weak rallies.
// 3. Uses pine script 6
//

// --- INPUTS ---
longLossPerc = input.float(title="Long Stop Loss (%)", minval=0.0, step=0.1, defval=3.5) / 100

// Date Range Filter
startDate  = input.int(title="Start Date", defval=10, minval=1, maxval=24)
startMonth = input.int(title="Start Month", defval=3, minval=1, maxval=12)
startYear  = input.int(title="Start Year", defval=1999, minval=1999, maxval=2500)
inDateRange = (time >= timestamp(syminfo.timezone, startYear, startMonth, startDate, 0, 0))

// --- SECURITY DATA REQUESTS ---
// Native resolution calculation matches v5 calculation history directly
spxOpen    = request.security("SPX", 'D', open)
spxClose   = request.security("SPX", 'D', close)
spxLow     = request.security("SPX", 'D', low)
spxShortMA = request.security("SPX", 'D', ta.sma(close, 7))
spxLongMA  = request.security("SPX", 'D', ta.sma(close, 107))
spx21ema   = request.security("SPX", 'D', ta.ema(close, 21))

qqqClose   = request.security("QQQ", 'D', close)
qqqLow     = request.security("QQQ", 'D', low)
qqq14ema   = request.security("QQQ", 'D', ta.ema(close, 14))
qqq21ema   = request.security("QQQ", 'D', ta.ema(close, 21))
qqq50sma   = request.security("QQQ", 'D', ta.sma(close, 50))
qqq200sma  = request.security("QQQ", 'D', ta.sma(close, 200))

// Force ADX calculation across all historical bars
f_adx() =>
    [p, m, a] = ta.dmi(13, 13)
    a

spxAdxValue = request.security("SPX", "D", f_adx())

// Current ticker moving averages
shortMA = ta.sma(close, 7)
longMA  = ta.sma(close, 107)
_14ema  = ta.ema(close, 14)
_21ema  = ta.ema(close, 21)
_50sma  = ta.sma(close, 50)
_200sma = ta.sma(close, 200)

// Static Initial Stop Loss Calculation
var float qqqPriceAtEntry = na
var bool entryBelow200 = false
var int entryBarIndex = na
var bool isLockedOut = false

// Update trade entry trackers
if (strategy.position_size > 0 and strategy.position_size[1] <= 0)
    qqqPriceAtEntry := qqqClose
    entryBelow200   := qqq50sma < qqq200sma
    entryBarIndex   := bar_index
    if not entryBelow200
        isLockedOut := false

// Calculate the stop level based on QQQ's price at entry
longStopPrice = nz(qqqPriceAtEntry) * (1 - longLossPerc)

// --- ENTRY LOGIC BREAKDOWN ---
spxLowAbove21Ema4daysInARow = (spxLow > spx21ema and spxLow[1] > spx21ema[1] and spxLow[2] > spx21ema[2] and spxLow[3] > spx21ema[3]) 
qqqLowAboveKeyEmas          = (qqqLow > qqq14ema and qqqLow > qqq21ema) 
qqqNotShowingWeakness       = (not (qqqClose < qqqClose[1] and qqqClose < qqqClose[2] and qqqClose < qqqClose[3]))
isTrending                  = (spxAdxValue > 16)
tradeFilterAllowed          = (not isLockedOut or (qqq50sma > qqq200sma))

// Current SPX Open cannot be less than SPX Close 4 days ago
spxOpenNotBelow4dClose      = spxOpen >= spxClose[4]

longCondition = spxLowAbove21Ema4daysInARow and qqqLowAboveKeyEmas and qqqNotShowingWeakness and isTrending and tradeFilterAllowed and spxOpenNotBelow4dClose

// --- EXIT LOGIC BREAKDOWN ---
spxBearishCross = spxShortMA < spxLongMA[1]
spxPriceWeak    = spxClose < spxShortMA
qqqPriceWeak    = qqqClose < qqq21ema
trendEstablishedLooseStop = spxBearishCross and spxPriceWeak and qqqPriceWeak

stopLevelHit        = qqqLow < longStopPrice
belowFiftySMA       = qqqLow < qqq50sma
initialBuyTightStop = (not na(qqqPriceAtEntry)) and stopLevelHit and belowFiftySMA

exitCondition = trendEstablishedLooseStop or initialBuyTightStop

// --- STRATEGY EXECUTION ---
bool isBuySignal  = longCondition and inDateRange
bool isExitSignal = exitCondition and inDateRange and strategy.position_size > 0

if isBuySignal
    strategy.entry("Buy", strategy.long)

if isExitSignal
    strategy.close("Buy")

// Check trade duration on exit & update lockout state
if (strategy.position_size == 0 and strategy.position_size[1] > 0)
    int tradeDuration = bar_index - entryBarIndex
    if entryBelow200 and (tradeDuration <= 20)
        isLockedOut := true
    qqqPriceAtEntry := na

// --- PLOTTING & BACKGROUND ---
color color21ema   = color.green
color colorShortMA = color.new(color.purple, 30)
color colorLongMA  = color.new(color.blue, 35)
color buyBackground = color.new(#90EE90, 50)

plot(_14ema, color=color.new(color.black, 0), title="14 EMA", force_overlay = true)
plot(_21ema, color=color21ema, title="21 EMA", force_overlay = true)
plot(_50sma, color=color.new(color.red, 0), title="50 SMA", force_overlay = true)
plot(_200sma, color=color.new(color.gray, 0), title="200 SMA", force_overlay = true)
plot(shortMA, color=colorShortMA, title="7 SMA", force_overlay = true)
plot(longMA, color=colorLongMA, title="107 SMA", force_overlay = true)

bgcolor(strategy.position_size > 0 ? buyBackground : na)