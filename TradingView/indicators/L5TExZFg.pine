        if forecast6
            p61 := label.new(bar_index + forecastSpacing, f_project(ma6, slope6, tfSeconds6, chartTfSeconds, forecastSpacing), "●", style=label.style_none, textcolor=col6, size=f_projectionSize(width6))
            p62 := label.new(bar_index + forecastSpacing * 2, f_project(ma6, slope6, tfSeconds6, chartTfSeconds, forecastSpacing * 2), "●", style=label.style_none, textcolor=col6, size=f_projectionSize(width6))
            p63 := label.new(bar_index + forecastSpacing * 3, f_project(ma6, slope6, tfSeconds6, chartTfSeconds, forecastSpacing * 3), "●", style=label.style_none, textcolor=col6, size=f_projectionSize(width6))

