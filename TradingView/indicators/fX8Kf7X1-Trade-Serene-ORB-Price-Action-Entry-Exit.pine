//@version=6
indicator("Trade Serene | ORB + Price Action Entry & Exit", overlay=true, max_labels_count=500)

// =====================================================
// TRADE SERENE
// ORB + PRICE ACTION ENTRY & EXIT
// =====================================================

// -------------------------
// USER SETTINGS
// -------------------------

showORB         = input.bool(true, "Show ORB High / Low")
showVWAP        = input.bool(true, "Show VWAP")
showEntries     = input.bool(true, "Show Entry Signals")
showAdds        = input.bool(true, "Show Add-to-Winner Signals")
showExits       = input.bool(true, "Show Exit Signals")
showStop        = input.bool(true, "Show Structural Stop")
showTargets     = input.bool(true, "Show 1R / 2R / 3R Targets")
showStructure   = input.bool(false, "Show Structure Breaks")

// ORB
orbSession      = input.session("0930-0935", "ORB Session")
tradeSession    = input.session("0935-1200", "Trade Signal Session")
timezone        = input.string("America/New_York", "Time Zone")

// Filters
useVWAP         = input.bool(true, "Require VWAP Confirmation")
useVolume       = input.bool(true, "Require Volume Confirmation")
volumeLength    = input.int(20, "Volume Average Length", minval=1)
volumeMultiple  = input.float(1.2, "Volume Multiplier", minval=0.5, step=0.1)

// Price action
lookback        = input.int(3, "Market Structure Lookback", minval=2)
bodyMin         = input.float(0.60, "Strong Candle Body %", minval=0.40, maxval=0.95, step=0.05)
closeStrength   = input.float(0.70, "Strong Close %", minval=0.50, maxval=0.95, step=0.05)

// Trade management
addAfterR       = input.float(1.0, "Add Winner After R", minval=0.5, step=0.25)

target1R        = input.float(1.0, "Target 1 R", step=0.25)
target2R        = input.float(2.0, "Target 2 R", step=0.25)
target3R        = input.float(3.0, "Target 3 R", step=0.25)

// =====================================================
// SESSION DETECTION
// =====================================================

inORB = not na(time(timeframe.period, orbSession, timezone))
inTradeSession = not na(time(timeframe.period, tradeSession, timezone))

newDay = ta.change(time("D")) != 0

// =====================================================
// BUILD OPENING RANGE
// =====================================================

var float orbHigh = na
var float orbLow = na
var bool orbComplete = false

if newDay
    orbHigh := na
    orbLow := na
    orbComplete := false

if inORB
    orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
    orbLow := na(orbLow) ? low : math.min(orbLow, low)

if not inORB and not na(orbHigh) and not na(orbLow)
    orbComplete := true

// =====================================================
// PLOT ORB
// =====================================================

plot(
     showORB and (orbComplete or inORB) ? orbHigh : na,
     title="ORB High",
     color=color.green,
     linewidth=2,
     style=plot.style_linebr)

plot(
     showORB and (orbComplete or inORB) ? orbLow : na,
     title="ORB Low",
     color=color.red,
     linewidth=2,
     style=plot.style_linebr)

// =====================================================
// VWAP
// =====================================================

vwapValue = ta.vwap(hlc3)

plot(
     showVWAP ? vwapValue : na,
     title="VWAP",
     color=color.blue,
     linewidth=2)

// =====================================================
// VOLUME CONFIRMATION
// =====================================================

averageVolume = ta.sma(volume, volumeLength)

strongVolume =
     volume > averageVolume * volumeMultiple

volumeOK =
     not useVolume or strongVolume

// =====================================================
// CANDLE STRENGTH
// =====================================================

barRange = high - low
bodySize = math.abs(close - open)

bodyPct =
     barRange > 0 ? bodySize / barRange : 0

bullCloseLocation =
     barRange > 0 ? (close - low) / barRange : 0

bearCloseLocation =
     barRange > 0 ? (high - close) / barRange : 0

strongBull =
     close > open and
     bodyPct >= bodyMin and
     bullCloseLocation >= closeStrength

strongBear =
     close < open and
     bodyPct >= bodyMin and
     bearCloseLocation >= closeStrength

// =====================================================
// MARKET STRUCTURE
// =====================================================

priorHigh = ta.highest(high[1], lookback)
priorLow = ta.lowest(low[1], lookback)

bullStructureBreak =
     close > priorHigh

bearStructureBreak =
     close < priorLow

higherHigh =
     high > high[1]

higherLow =
     low > low[1]

lowerLow =
     low < low[1]

lowerHigh =
     high < high[1]

// =====================================================
// VWAP CONFIRMATION
// =====================================================

bullVWAP =
     not useVWAP or close > vwapValue

bearVWAP =
     not useVWAP or close < vwapValue

// =====================================================
// ORB CONFIRMATION
// =====================================================

aboveORB =
     orbComplete and
     close > orbHigh

belowORB =
     orbComplete and
     close < orbLow

// =====================================================
// LONG ENTRY
// =====================================================
//
// Requirements:
//
// 1. ORB complete
// 2. Price closes above ORB high
// 3. Strong bullish candle
// 4. Breaks short-term structure
// 5. Price above VWAP
// 6. Volume confirmation
//
// =====================================================

longSetup =
     inTradeSession and
     aboveORB and
     strongBull and
     bullStructureBreak and
     higherHigh and
     bullVWAP and
     volumeOK

// =====================================================
// SHORT ENTRY
// =====================================================

shortSetup =
     inTradeSession and
     belowORB and
     strongBear and
     bearStructureBreak and
     lowerLow and
     bearVWAP and
     volumeOK

// =====================================================
// TRADE STATE
// =====================================================

var int direction = 0

var float entryPrice = na
var float stopPrice = na
var float initialRisk = na

var float target1 = na
var float target2 = na
var float target3 = na

var bool addUsed = false

// =====================================================
// NEW LONG ENTRY
// =====================================================

newLong =
     longSetup and
     direction == 0

if newLong
    direction := 1

    entryPrice := close

    // Structural stop:
    // Uses recent structure OR breakout candle low.
    stopPrice := math.min(low, priorLow)

    initialRisk := entryPrice - stopPrice

    target1 := entryPrice + initialRisk * target1R
    target2 := entryPrice + initialRisk * target2R
    target3 := entryPrice + initialRisk * target3R

    addUsed := false

// =====================================================
// NEW SHORT ENTRY
// =====================================================

newShort =
     shortSetup and
     direction == 0

if newShort
    direction := -1

    entryPrice := close

    stopPrice := math.max(high, priorHigh)

    initialRisk := stopPrice - entryPrice

    target1 := entryPrice - initialRisk * target1R
    target2 := entryPrice - initialRisk * target2R
    target3 := entryPrice - initialRisk * target3R

    addUsed := false

// =====================================================
// CURRENT R PROFIT
// =====================================================

float currentR = na

if direction == 1 and initialRisk > 0
    currentR := (close - entryPrice) / initialRisk

if direction == -1 and initialRisk > 0
    currentR := (entryPrice - close) / initialRisk

// =====================================================
// ADD TO WINNER
// =====================================================
//
// Does NOT add to losers.
//
// Requires:
//
// Trade already profitable by specified R
// Strong continuation candle
// Trend still producing HH/HL or LL/LH
//
// =====================================================

longAdd =
     direction == 1 and
     not addUsed and
     currentR >= addAfterR and
     strongBull and
     higherHigh and
     higherLow and
     close > orbHigh and
     close > vwapValue

shortAdd =
     direction == -1 and
     not addUsed and
     currentR >= addAfterR and
     strongBear and
     lowerLow and
     lowerHigh and
     close < orbLow and
     close < vwapValue

if longAdd or shortAdd
    addUsed := true

// =====================================================
// MOMENTUM FAILURE
// =====================================================

longMomentumFailure =
     direction == 1 and
     strongBear and
     close < low[1]

shortMomentumFailure =
     direction == -1 and
     strongBull and
     close > high[1]

// =====================================================
// ORB FAILURE
// =====================================================
//
// If breakout completely fails back into ORB
//
// =====================================================

longORBFailure =
     direction == 1 and
     close < orbHigh

shortORBFailure =
     direction == -1 and
     close > orbLow

// =====================================================
// STOP LOSS HIT
// =====================================================

longStopHit =
     direction == 1 and
     low <= stopPrice

shortStopHit =
     direction == -1 and
     high >= stopPrice

// =====================================================
// EXIT RULES
// =====================================================

longExit =
     longStopHit or
     longMomentumFailure or
     longORBFailure

shortExit =
     shortStopHit or
     shortMomentumFailure or
     shortORBFailure

exitLongSignal = longExit
exitShortSignal = shortExit

// =====================================================
// PLOT ENTRY BEFORE RESET
// =====================================================

plotshape(
     showEntries and newLong,
     title="CALL Entry",
     text="CALL\nENTRY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.green,
     textcolor=color.white,
     size=size.small)

plotshape(
     showEntries and newShort,
     title="PUT Entry",
     text="PUT\nENTRY",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     textcolor=color.white,
     size=size.small)

// =====================================================
// ADD SIGNAL
// =====================================================

plotshape(
     showAdds and longAdd,
     title="Add Long Winner",
     text="ADD\nWINNER",
     style=shape.labelup,
     location=location.belowbar,
     color=color.teal,
     textcolor=color.white,
     size=size.tiny)

plotshape(
     showAdds and shortAdd,
     title="Add Short Winner",
     text="ADD\nWINNER",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.orange,
     textcolor=color.white,
     size=size.tiny)

// =====================================================
// EXIT SIGNAL
// =====================================================

plotshape(
     showExits and exitLongSignal,
     title="Exit Long",
     text="EXIT\nCALL",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.yellow,
     textcolor=color.black,
     size=size.small)

plotshape(
     showExits and exitShortSignal,
     title="Exit Short",
     text="EXIT\nPUT",
     style=shape.labelup,
     location=location.belowbar,
     color=color.yellow,
     textcolor=color.black,
     size=size.small)

// =====================================================
// ENTRY LINE
// =====================================================

plot(
     direction != 0 ? entryPrice : na,
     title="Entry Price",
     color=color.yellow,
     linewidth=2,
     style=plot.style_linebr)

// =====================================================
// STOP LINE
// =====================================================

plot(
     showStop and direction != 0 ? stopPrice : na,
     title="Structural Stop",
     color=color.red,
     linewidth=2,
     style=plot.style_linebr)

// =====================================================
// PROFIT TARGETS
// =====================================================

plot(
     showTargets and direction != 0 ? target1 : na,
     title="1R Target",
     color=color.new(color.green, 50),
     linewidth=1,
     style=plot.style_linebr)

plot(
     showTargets and direction != 0 ? target2 : na,
     title="2R Target",
     color=color.new(color.green, 25),
     linewidth=2,
     style=plot.style_linebr)

plot(
     showTargets and direction != 0 ? target3 : na,
     title="3R Target",
     color=color.green,
     linewidth=2,
     style=plot.style_linebr)

// =====================================================
// MARKET STRUCTURE MARKERS
// =====================================================

plotshape(
     showStructure and bullStructureBreak,
     title="Bull Structure Break",
     style=shape.circle,
     location=location.belowbar,
     color=color.new(color.green, 60),
     size=size.tiny)

plotshape(
     showStructure and bearStructureBreak,
     title="Bear Structure Break",
     style=shape.circle,
     location=location.abovebar,
     color=color.new(color.red, 60),
     size=size.tiny)

// =====================================================
// OPENING RANGE BACKGROUND
// =====================================================

bgcolor(
     inORB ? color.new(color.gray, 90) : na,
     title="Opening Range")

// =====================================================
// ALERT CONDITIONS
// =====================================================

alertcondition(
     newLong,
     title="Trade Serene CALL Entry",
     message="Trade Serene: CALL setup confirmed above ORB.")

alertcondition(
     newShort,
     title="Trade Serene PUT Entry",
     message="Trade Serene: PUT setup confirmed below ORB.")

alertcondition(
     longAdd,
     title="Trade Serene Add Long",
     message="Trade Serene: Long winner continuation detected.")

alertcondition(
     shortAdd,
     title="Trade Serene Add Short",
     message="Trade Serene: Short winner continuation detected.")

alertcondition(
     exitLongSignal,
     title="Trade Serene Exit CALL",
     message="Trade Serene: Exit CALL - price action invalidated.")

alertcondition(
     exitShortSignal,
     title="Trade Serene Exit PUT",
     message="Trade Serene: Exit PUT - price action invalidated.")

// =====================================================
// RESET TRADE AFTER EXIT
// =====================================================

if longExit or shortExit
    direction := 0
    entryPrice := na
    stopPrice := na
    initialRisk := na
    target1 := na
    target2 := na
    target3 := na
    addUsed := false