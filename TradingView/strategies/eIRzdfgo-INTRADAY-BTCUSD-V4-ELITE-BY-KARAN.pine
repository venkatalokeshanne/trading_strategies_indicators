//@version=5
strategy("BTC V4 Multi-Engine FINAL FIXED", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// ===== INPUTS =====
rr = input.float(2.0, "Risk Reward")
sl_buffer = input.float(0.2, "SL Buffer (%)")

// ===== EMA =====
ema20 = ta.ema(close,20)
ema50 = ta.ema(close,50)
ema200 = ta.ema(close,200)

plot(ema20, color=color.blue)
plot(ema50, color=color.green)
plot(ema200, color=color.orange)

// ===== HTF FUNCTION =====
f_trend(tf) =>
    e20 = request.security(syminfo.tickerid, tf, ta.ema(close,20))
    e50 = request.security(syminfo.tickerid, tf, ta.ema(close,50))
    e200 = request.security(syminfo.tickerid, tf, ta.ema(close,200))
    e20 > e50 and e50 > e200 ? 1 : e20 < e50 and e50 < e200 ? -1 : 0

// ===== HTF VALUES =====
t30 = f_trend("30")
t1h = f_trend("60")
t4h = f_trend("240")
t1d = f_trend("D")

// ===== HTF VOTES =====
bullVotes = (t30 == 1 ? 1 : 0) + (t1h == 1 ? 1 : 0) + (t4h == 1 ? 1 : 0) + (t1d == 1 ? 1 : 0)
bearVotes = (t30 == -1 ? 1 : 0) + (t1h == -1 ? 1 : 0) + (t4h == -1 ? 1 : 0) + (t1d == -1 ? 1 : 0)

bullHTF = bullVotes >= 3
bearHTF = bearVotes >= 3

// ===== TREND =====
bullTrend = ema20 > ema50 and ema50 > ema200
bearTrend = ema20 < ema50 and ema50 < ema200

// ===== VOLATILITY =====
atr = ta.atr(14)
volOK = atr > ta.sma(atr,14)

// ===== MOMENTUM =====
candleRange = high - low
strongBull = close > high[1] and candleRange > atr
strongBear = close < low[1] and candleRange > atr

// ===== PULLBACK =====
pullLong = close[1] < open[1] and close[1] > ema20
pullShort = close[1] > open[1] and close[1] < ema20

// ===== ANTI-LATE =====
lateLong = close > ema20 * 1.01
lateShort = close < ema20 * 0.99

// ===== FINAL CONDITIONS =====
pullbackBuy = bullTrend and bullHTF and volOK and pullLong and not lateLong
breakoutBuy = bullTrend and bullHTF and strongBull and not lateLong

pullbackSell = bearTrend and bearHTF and volOK and pullShort and not lateShort
breakdownSell = bearTrend and bearHTF and strongBear and not lateShort

// ===== SL / TP =====
longSL = low * (1 - sl_buffer/100)
shortSL = high * (1 + sl_buffer/100)

longTP = close + (close - longSL) * rr
shortTP = close - (shortSL - close) * rr

// ===== EXECUTION =====
if (pullbackBuy or breakoutBuy) and strategy.position_size == 0
    strategy.entry("BUY", strategy.long)
    strategy.exit("BUY EXIT", "BUY", stop=longSL, limit=longTP)

if (pullbackSell or breakdownSell) and strategy.position_size == 0
    strategy.entry("SELL", strategy.short)
    strategy.exit("SELL EXIT", "SELL", stop=shortSL, limit=shortTP)

// ===== LABELS =====
var int tradeID = 0

if pullbackBuy
    tradeID += 1
    label.new(bar_index, low, "Pullback Buy " + str.tostring(tradeID), color=color.green)

if breakoutBuy
    tradeID += 1
    label.new(bar_index, low, "Breakout Buy " + str.tostring(tradeID), color=color.lime)

if pullbackSell
    tradeID += 1
    label.new(bar_index, high, "Pullback Sell " + str.tostring(tradeID), color=color.red)

if breakdownSell
    tradeID += 1
    label.new(bar_index, high, "Breakdown Sell " + str.tostring(tradeID), color=color.maroon)