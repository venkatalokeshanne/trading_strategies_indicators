//@version=6
indicator(
     title     = "Strong Bar Highlighter",
     shorttitle= "Strong Bar ATR-Based",
     overlay   = true
 )

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════

grp_atr = "ATR Filter"
atr_len         = input.int  (20,   "ATR Lookback (bars)",        minval=1,   maxval=200, group=grp_atr)
atr_mult        = input.float(1.2,  "Min Bar Size (× ATR)",       minval=0.1, maxval=5.0, step=0.1, group=grp_atr,
     tooltip="Bar range (high - low) must be at least this multiple of the ATR to qualify as strong.")

grp_close = "Close Position Filter"
bull_close_pct  = input.float(0.60, "Bullish Close Threshold (fraction of range)",
     minval=0.5, maxval=1.0, step=0.05, group=grp_close,
     tooltip="For a bullish strong bar, close must be at or above this fraction of the bar's total range. E.g. 0.60 = top 40%.")
bear_close_pct  = input.float(0.40, "Bearish Close Threshold (fraction of range)",
     minval=0.0, maxval=0.5, step=0.05, group=grp_close,
     tooltip="For a bearish strong bar, close must be at or below this fraction of the bar's total range. E.g. 0.40 = bottom 40%.")

grp_body = "Body Size Filter"
body_pct        = input.float(0.50, "Min Body Size (fraction of range)",
     minval=0.0, maxval=1.0, step=0.05, group=grp_body,
     tooltip="The body (|close - open|) must be at least this fraction of the bar's total range (high - low).")

grp_colors = "Colors"
bull_color      = input.color(color.new(color.blue,  60), "Bullish Strong Bar",  group=grp_colors)
bear_color      = input.color(color.new(color.red,   60), "Bearish Strong Bar",  group=grp_colors)

// ═══════════════════════════════════════════════════════════════
// CALCULATIONS
// ═══════════════════════════════════════════════════════════════

atr_val  = ta.atr(atr_len)
bar_range = high - low

// Avoid division by zero on doji bars
close_pos = bar_range > 0 ? (close - low) / bar_range : 0.5
body_size = bar_range > 0 ? math.abs(close - open) / bar_range : 0.0

// Core conditions
is_big      = bar_range >= atr_val * atr_mult
is_bull_bar = close >= open
is_bear_bar = close < open
has_body    = body_size >= body_pct

// Bullish strong bar
is_strong_bull = is_big and is_bull_bar and has_body and close_pos >= bull_close_pct

// Bearish strong bar
is_strong_bear = is_big and is_bear_bar and has_body and close_pos <= bear_close_pct

// ═══════════════════════════════════════════════════════════════
// VISUALS
// ═══════════════════════════════════════════════════════════════

barcolor(is_strong_bull ? bull_color : is_strong_bear ? bear_color : na)
