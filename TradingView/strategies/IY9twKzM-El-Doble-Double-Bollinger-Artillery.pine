//@version=6
// El Doble - double Bollinger Band mean-reversion strategy (slow band touch,
// fast band reversal confirmation, EMA/ADX trend filter).
// Concept credit: the double Bollinger Band approach popularised by Straight Kim.
// All code is original, written with Pine built-ins only.
// Canonical republication (version suffix dropped). Educational tool. Not financial advice.

strategy("El Doble Double Bollinger [Artillery]", shorttitle="El Doble", overlay=true, margin_long=5, margin_short=5,
     initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.62,
     slippage=1, process_orders_on_close=false, calc_on_every_tick=false,
     max_bars_back=500, currency=currency.USD)

bbLen       = input.int(20, "BB Length", minval=5, group="Bollinger Bands")
bbMult      = input.float(2.0, "BB Multiplier", step=0.1, group="Bollinger Bands")
fastBBLen   = input.int(4, "Fast BB Length", minval=2, group="Bollinger Bands")
fastBBMult  = input.float(2.0, "Fast BB Mult", step=0.1, group="Bollinger Bands")

emaLen      = input.int(55, "EMA Length", minval=10, group="Trend Filter")
adxLen      = input.int(14, "ADX Length", minval=5, group="Trend Filter")
adxThresh   = input.float(18.0, "ADX Min", step=1.0, group="Trend Filter")

slPts       = input.float(15.0, "Stop Loss Points", step=1.0, group="Exits")
tpPts       = input.float(25.0, "Take Profit Points", step=1.0, group="Exits")
timeStop    = input.int(20, "Time Stop Bars", minval=5, group="Exits")

maxTrades   = input.int(3, "Max Trades/Day", minval=1, group="Trade Mgmt")
cdBars      = input.int(1, "Cooldown Bars", minval=1, group="Trade Mgmt")
touchAge    = input.int(10, "Max Touch Age", minval=3, group="Trade Mgmt")

sessStart   = input.int(2, "Start Hour ET", minval=0, maxval=23, group="Session")
sessEnd     = input.int(9, "End Hour ET", minval=0, maxval=23, group="Session")

bbBasis = ta.sma(close, bbLen)
bbDev   = bbMult * ta.stdev(close, bbLen)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
fastBasis = ta.sma(close, fastBBLen)
fastDev   = fastBBMult * ta.stdev(close, fastBBLen)
fastUpper = fastBasis + fastDev
fastLower = fastBasis - fastDev
ema55 = ta.ema(close, emaLen)
emaSlope = ema55 - ema55[5]
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
etHour = hour(time, "America/New_York")
inSession = etHour >= sessStart and etHour < sessEnd

bullTouch = low <= bbLower
bearTouch = high >= bbUpper
bsSinceBull = ta.barssince(bullTouch)
bsSinceBear = ta.barssince(bearTouch)
bullSetup = bsSinceBull >= cdBars and bsSinceBull <= touchAge
bearSetup = bsSinceBear >= cdBars and bsSinceBear <= touchAge
bullRev = close > open and close > fastBasis
bearRev = close < open and close < fastBasis
bullTrend = close > ema55 or emaSlope > 0
bearTrend = close < ema55 or emaSlope < 0
adxOK = adxVal > adxThresh

var int tradesToday = 0
if ta.change(time("D")) != 0
    tradesToday := 0

noPos = strategy.position_size == 0
canTrade = tradesToday < maxTrades and inSession and noPos
longSig = canTrade and bullSetup and bullRev and bullTrend and adxOK
shortSig = canTrade and bearSetup and bearRev and bearTrend and adxOK

var int entryBar = na
if longSig
    entryBar := bar_index
    tradesToday += 1
    strategy.entry("Long", strategy.long)
    strategy.exit("LX", "Long", stop=close - slPts, limit=close + tpPts)
if shortSig
    entryBar := bar_index
    tradesToday += 1
    strategy.entry("Short", strategy.short)
    strategy.exit("SX", "Short", stop=close + slPts, limit=close - tpPts)
if strategy.position_size != 0 and not na(entryBar)
    if bar_index - entryBar >= timeStop
        strategy.close_all("TS")

bullCol = color.new(#00E676, 0)
bearCol = color.new(#FF1744, 0)
neutCol = color.new(#78909C, 0)
p1 = plot(bbUpper, "BBU", color=color.new(neutCol, 60))
p2 = plot(bbLower, "BBL", color=color.new(neutCol, 60))
plot(bbBasis, "MID", color=color.new(neutCol, 80), style=plot.style_cross)
p3 = plot(fastUpper, "FU", color=color.new(bullCol, 75), style=plot.style_circles)
p4 = plot(fastLower, "FL", color=color.new(bearCol, 75), style=plot.style_circles)
fill(p1, p3, color=color.new(bullCol, 95))
fill(p2, p4, color=color.new(bearCol, 95))
plot(ema55, "EMA", color=emaSlope > 0 ? bullCol : bearCol, linewidth=2)
plotshape(longSig, "LONG", shape.triangleup, location.belowbar, bullCol, size=size.normal)
plotshape(shortSig, "SHORT", shape.triangledown, location.abovebar, bearCol, size=size.normal)