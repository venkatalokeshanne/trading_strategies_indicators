plot(ema219,  color=color.rgb(238, 17, 9),linestyle = plot.linestyle_dotted) 





// Configuración de las EMAs
//@version=6
//strategy("Estrategia Cruce EMA 7/21 - v6", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// Configuración de las EMAs usando métodos de v6


// Estética del gráfico
plot(ema1,  "EMA Corta (7)",  color=color.rgb(102, 212, 0), linewidth=1)
plot(ema29, "EMA Larga (21)", color=color.rgb(255, 0, 0), linewidth=1)

// Lógica de cruces
cruceAlcista = ta.crossover(ema0, emat)
cruceBajista = ta.crossunder(ema0, emat)

// Ejecución de órdenes
if cruceAlcista
    strategy.entry("Long", strategy.long, comment="Cruce Alcista")

if cruceBajista
    strategy.entry("Short", strategy.short, comment="Cruce Bajista")




// --- Lógica de Trailing Stop ---
trailPerc = input.float(7.6, "Trailing Stop (%)", step=0.1) / 100
// Calculamos el precio del stop dinámicamente
float trailOffset = strategy.position_avg_price * trailPerc
float trailPrice  = na

if strategy.position_size > 0 // Si estamos en compra
    strategy.exit("Exit Long", "Long", trail_points = close * trailPerc / syminfo.mintick, trail_offset = 0, comment_loss="TS Long")

if strategy.position_size < 0 // Si estamos en venta
    strategy.exit("Exit Short", "Short", trail_points = close * trailPerc / syminfo.mintick, trail_offset = 0, comment_loss="TS Short")
// Visualización de señales con etiquetas
plotshape(cruceAlcista, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, title="Señal Compra")
plotshape(cruceBajista, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, title="Señal Venta")

// Condiciones de cruce
//longCondition = ta.crossover(ema1, ema9)  // 7 cruza hacia arriba a 21
//shortCondition = ta.crossunder(ema1, ema9) // 7 cruza hacia abajo a 21
// --- Creación de la Tabla ---
var table panel = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 10), border_width=1, border_color=color.gray)

if barstate.islast
    // Datos de la estrategia
    float saldo     = strategy.equity
    float beneficio = strategy.netprofit
    float beneficio_trade = strategy.openprofit
    string posTexto = strategy.position_size > 0 ? "Largo" : strategy.position_size < 0 ? "Corto" : "Plano"
    color posColor  = strategy.position_size > 0 ? #03f70c : strategy.position_size < 0 ? color.red : color.gray
    color beneficio_trade_color  =strategy.openprofit > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray
    // Encabezados y Celdas
    table.cell(panel, 0, 0, "Cuenta",     text_color=color.white, bgcolor=color.gray)
    table.cell(panel, 1, 0, str.format("{0,number,#.##}", saldo), text_color=color.white)
    
    table.cell(panel, 0, 1, "P/G Neto",   text_color=color.white, bgcolor=color.gray)
    table.cell(panel, 1, 1, str.format("{0,number,#.##}", beneficio), text_color=beneficio >= 0 ? color.green : color.red)
    
    table.cell(panel, 0, 2, "Posición",   text_color=color.white, bgcolor=color.gray)
    table.cell(panel, 1, 2, posTexto,     text_color=posColor)

    table.cell(panel, 0, 3, "Contratos",  text_color=color.white, bgcolor=color.gray)
    table.cell(panel, 1, 3, str.tostring(strategy.position_size), text_color=color.white)

    table.cell(panel, 0, 4, " P / G ",  text_color=color.white)
    table.cell(panel, 1, 4, str.format("{0,number,#.##}",beneficio_trade), text_color= beneficio_trade_color)
    
    // Encabezados y Celdas
    
    table.cell(panel, 0, 5, "Saldo Actual", text_color=color.white, bgcolor=color.gray)
    table.cell(panel, 1, 5, str.format("{0,number,#.##} {1}", strategy.equity, strategy.account_currency), text_color=color.lime)

