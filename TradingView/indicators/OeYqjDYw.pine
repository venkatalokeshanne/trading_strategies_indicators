//@version=6
indicator("BB + Inside Bar + 3 EMA + Overbought/Oversold", shorttitle="BB+IB+3EMA+OO", overlay=true)

// =================== BOLLINGER BANDS ===================
length = input.int(20, minval=1, title="BB Length")
maType = input.string("SMA", title="Basis MA Type", options=["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"])
src = input.source(close, title="Source")
mult = input.float(2.0, minval=0.001, maxval=50, title="StdDev")

// BB Appearance
bbBasisColor = input.color(color.orange, title="BB Basis Normal Color")
bbUpperColor = input.color(color.blue, title="BB Upper Color")
bbLowerColor = input.color(color.blue, title="BB Lower Color")
bbFillColor = input.color(color.blue, title="BB Area Color")
bbFillTransparency = input.int(80, minval=0, maxval=100, title="BB Area Transparency")

// BB Basis Down
bbDownPercent = input.float(5.0, minval=0.1, step=0.1, title="BB Basis Down %")
bbDownColor = input.color(color.black, title="BB Basis Down Color")

ma(source, length, _type) =>
    switch _type
        "SMA" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        "SMMA (RMA)" => ta.rma(source, length)
        "WMA" => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)

basis = ma(src, length, maType)
dev = mult * ta.stdev(src, length)
upper = basis + dev
lower = basis - dev

// Persentase jarak Basis ke Lower
basisToLowerPercent = basis != 0 ? (basis - lower) / basis * 100 : 0

// Jika jarak Basis ke Lower >= 5% → Basis menjadi hitam
basisColor = basisToLowerPercent >= bbDownPercent ? bbDownColor : bbBasisColor

plot(basis, title="Basis", color=basisColor, linewidth=2)

p1 = plot(upper, title="Upper", color=bbUpperColor)
p2 = plot(lower, title="Lower", color=bbLowerColor)

fill(
     p1,
     p2,
     title="BB Area",
     color=color.new(bbFillColor, bbFillTransparency)
 )


// =================== INSIDE BAR ===================
IBRange = input.string("Body", title="Body or High Low Range", options=["Body", "HighLow"])
highLowBuffer = input.int(0, title="High-Low buffer zone")
barHighlight = input.bool(false, title="Highlight bars in boxes")
showOnlyLastBox = input.bool(false, title="Show only last Box")
showBreak = input.bool(true, title="Show boxes break")
bgTransparency = input.int(90, title="Box transparency")
bgColor = input.color(color.green, title="Background color")
insideBarsColor = input.color(color.orange, title="Inside bars body color")

var box myBox = na
var float boxH = na
var float boxL = na
var int barIndex = 1
var bool IBStatus = false

boxBodyHigh = math.max(open, close)
boxBodyLow = math.min(open, close)

isInsideBar(previousBar, rangeType) =>
    bool result = false

    if rangeType == "HighLow"
        hp = high[previousBar] + highLowBuffer * syminfo.mintick
        lp = low[previousBar] - highLowBuffer * syminfo.mintick
        result := close <= hp and close >= lp and open <= hp and open >= lp

    if rangeType == "Body"
        hp = boxBodyHigh[previousBar] + highLowBuffer * syminfo.mintick
        lp = boxBodyLow[previousBar] - highLowBuffer * syminfo.mintick
        result := close <= hp and close >= lp and open <= hp and open >= lp

    result

isIB = isInsideBar(barIndex, IBRange)
isBarHighlight = isIB and barHighlight

if isIB and not isIB[1] and barstate.isconfirmed
    boxH := IBRange == "Body" ? boxBodyHigh[1] : high[1]
    boxL := IBRange == "Body" ? boxBodyLow[1] : low[1]

    IBStatus := true

    if showOnlyLastBox and not na(myBox)
        box.delete(myBox)

    myBox := box.new(
         left=bar_index[1],
         top=boxH,
         right=bar_index,
         bottom=boxL,
         border_color=bgColor,
         bgcolor=color.new(bgColor, bgTransparency)
     )

    barIndex += 1

else if isIB and isIB[1] and barstate.isconfirmed
    if not na(myBox)
        box.set_right(myBox, bar_index)

    barIndex += 1

else if isIB[1] and not isIB and barstate.isconfirmed
    if not na(myBox)
        box.set_right(myBox, bar_index)

    barIndex := 1

else if not isIB[1] and not isIB
    IBStatus := false


// Inside Bar Break
plotshape(
     showBreak and IBStatus and ta.crossover(close, boxH),
     title="IB Break Up",
     color=color.green,
     location=location.belowbar,
     style=shape.triangleup,
     size=size.tiny
 )

plotshape(
     showBreak and IBStatus and ta.crossunder(close, boxL),
     title="IB Break Down",
     color=color.red,
     location=location.abovebar,
     style=shape.triangledown,
     size=size.tiny
 )


// =================== 3 EMA ===================
emaLength1 = input.int(50, title="EMA 1 Length")
emaColor1 = input.color(color.yellow, title="EMA 1 Color")

emaLength2 = input.int(100, title="EMA 2 Length")
emaColor2 = input.color(color.green, title="EMA 2 Color")

emaLength3 = input.int(200, title="EMA 3 Length")
emaColor3 = input.color(color.red, title="EMA 3 Color")

ema1 = ta.ema(close, emaLength1)
ema2 = ta.ema(close, emaLength2)
ema3 = ta.ema(close, emaLength3)

plot(ema1, title="EMA 1", color=emaColor1, linewidth=1)
plot(ema2, title="EMA 2", color=emaColor2, linewidth=1)
plot(ema3, title="EMA 3", color=emaColor3, linewidth=1)


// =================== OVERBOUGHT / OVERSOLD ===================
n = input.int(5, title="OO Length")
showOOColor = input.bool(true, title="OO Barcolor")

ys1 = (high + low + close * 2) / 4
rk3 = ta.ema(ys1, n)
rk4 = ta.stdev(ys1, n)

rk5 = rk4 != 0 ? (ys1 - rk3) * 100 / rk4 : 0

rk6 = ta.ema(rk5, n)
up = ta.ema(rk6, n)
down = ta.ema(up, n)

Oo = up < down ? up : down
Ll = up < down ? down : up
Cc = Ll

// OO Candle Color
ooColor = Oo[1] < Oo and Cc < Cc[1] ? color.yellow : up > down ? color.green : color.red

// Candle tetap mengikuti warna OO
barcolor(showOOColor ? ooColor : na)


// =================== BUY / SELL ===================
Buy = ta.crossover(up, down)
Sell = ta.crossunder(up, down)

plotshape(
     Buy,
     title="Buy",
     color=color.green,
     style=shape.triangleup,
     location=location.bottom,
     text="Buy",
     size=size.tiny
 )

plotshape(
     Sell,
     title="Sell",
     color=color.red,
     style=shape.triangledown,
     location=location.top,
     text="Sell",
     size=size.tiny
 )


