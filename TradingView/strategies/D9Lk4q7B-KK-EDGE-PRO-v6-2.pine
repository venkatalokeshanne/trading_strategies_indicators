//@version=6
strategy(
     "KK EDGE PRO v6.2",
     shorttitle="KKEDGE62",
     overlay=true,
     pyramiding=0,
     initial_capital=100000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     commission_type=strategy.commission.percent,
     commission_value=0.0,
     slippage=0,
     process_orders_on_close=true,
     calc_on_order_fills=true,
     calc_on_every_tick=false,
     max_labels_count=500)

//====================================================
// INPUTS
//====================================================

groupSignal = "01 • SIGNAL ENGINE"

minScore = input.int(
     70,
     "Minimum Signal Score",
     minval=50,
     maxval=100,
     group=groupSignal)

adxMin = input.float(
     18.0,
     "Minimum ADX",
     minval=5,
     maxval=50,
     step=0.5,
     group=groupSignal)

rsiBullLevel = input.float(
     52.0,
     "Bullish RSI",
     minval=45,
     maxval=60,
     step=0.5,
     group=groupSignal)

rsiBearLevel = input.float(
     48.0,
     "Bearish RSI",
     minval=40,
     maxval=55,
     step=0.5,
     group=groupSignal)

volumeFactor = input.float(
     1.10,
     "Volume / 20 SMA",
     minval=0.5,
     maxval=3.0,
     step=0.05,
     group=groupSignal)


groupTrend = "02 • TREND ENGINE"

emaFastLen = input.int(
     20,
     "Fast EMA",
     minval=5,
     maxval=100,
     group=groupTrend)

emaSlowLen = input.int(
     50,
     "Slow EMA",
     minval=10,
     maxval=200,
     group=groupTrend)

htfTF = input.timeframe(
     "60",
     "Higher Timeframe",
     group=groupTrend)


groupRisk = "03 • OPTION PREMIUM TRADE MANAGEMENT"

atrLen = input.int(
     14,
     "ATR Length",
     minval=5,
     maxval=50,
     group=groupRisk)

slATR = input.float(
     1.25,
     "SL = ATR ×",
     minval=0.50,
     maxval=5.0,
     step=0.05,
     group=groupRisk)

tp1RR = input.float(
     1.0,
     "Target 1 R",
     minval=0.5,
     maxval=5.0,
     step=0.25,
     group=groupRisk)

tp2RR = input.float(
     2.0,
     "Target 2 R",
     minval=1.0,
     maxval=10.0,
     step=0.25,
     group=groupRisk)

tp1Qty = input.float(
     50.0,
     "TP1 Quantity %",
     minval=10,
     maxval=90,
     step=5,
     group=groupRisk)


groupDisplay = "04 • DISPLAY"

showEMA = input.bool(
     true,
     "Show EMA 20 / 50",
     group=groupDisplay)

showVWAP = input.bool(
     true,
     "Show VWAP",
     group=groupDisplay)

showTradeLevels = input.bool(
     true,
     "Show Entry / SL / Targets",
     group=groupDisplay)

showSignals = input.bool(
     true,
     "Show BUY / SELL",
     group=groupDisplay)

showDashboard = input.bool(
     true,
     "Show Dashboard",
     group=groupDisplay)

showScoreLabels = input.bool(
     true,
     "Show Score Labels",
     group=groupDisplay)


//====================================================
// CORE INDICATORS
//====================================================

ema20 = ta.ema(close, emaFastLen)
ema50 = ta.ema(close, emaSlowLen)

vwapValue = ta.vwap(hlc3)

rsiValue = ta.rsi(close, 14)

[macdLine, macdSignal, macdHist] =
     ta.macd(close, 12, 26, 9)

[diPlus, diMinus, adxValue] =
     ta.dmi(14, 14)

atrValue = ta.atr(atrLen)

volumeMA = ta.sma(volume, 20)

volumeRatio =
     volumeMA > 0 ?
     volume / volumeMA :
     0.0


//====================================================
// STOCHASTIC RSI
//====================================================

rsiLowest = ta.lowest(rsiValue, 14)
rsiHighest = ta.highest(rsiValue, 14)

stochRSI =
     rsiHighest != rsiLowest ?
     100.0 * (rsiValue - rsiLowest) /
     (rsiHighest - rsiLowest) :
     50.0

stochK = ta.sma(stochRSI, 3)
stochD = ta.sma(stochK, 3)


//====================================================
// HIGHER TIMEFRAME
//====================================================

htfClose = request.security(
     syminfo.tickerid,
     htfTF,
     close,
     barmerge.gaps_off,
     barmerge.lookahead_off)

htfEMA20 = request.security(
     syminfo.tickerid,
     htfTF,
     ta.ema(close, emaFastLen),
     barmerge.gaps_off,
     barmerge.lookahead_off)

htfEMA50 = request.security(
     syminfo.tickerid,
     htfTF,
     ta.ema(close, emaSlowLen),
     barmerge.gaps_off,
     barmerge.lookahead_off)

htfBull =
     htfClose > htfEMA20 and
     htfEMA20 > htfEMA50

htfBear =
     htfClose < htfEMA20 and
     htfEMA20 < htfEMA50


//====================================================
// LOCAL CONDITIONS
//====================================================

localBull =
     close > ema20 and
     ema20 > ema50

localBear =
     close < ema20 and
     ema20 < ema50

vwapBull = close > vwapValue
vwapBear = close < vwapValue

macdBull =
     macdLine > macdSignal and
     macdHist > 0

macdBear =
     macdLine < macdSignal and
     macdHist < 0

rsiBull =
     rsiValue > rsiBullLevel

rsiBear =
     rsiValue < rsiBearLevel

stochBull =
     stochK > stochD and
     stochK > 40

stochBear =
     stochK < stochD and
     stochK < 60

volumeOK =
     volumeRatio >= volumeFactor

adxOK =
     adxValue >= adxMin


//====================================================
// SCORE ENGINE
//====================================================

float bullScore = 0.0
float bearScore = 0.0

bullScore += localBull ? 20 : 0
bullScore += htfBull ? 20 : 0
bullScore += vwapBull ? 10 : 0
bullScore += macdBull ? 15 : 0
bullScore += rsiBull ? 10 : 0
bullScore += stochBull ? 5 : 0
bullScore += volumeOK ? 10 : 0
bullScore += adxOK ? 10 : 0

bearScore += localBear ? 20 : 0
bearScore += htfBear ? 20 : 0
bearScore += vwapBear ? 10 : 0
bearScore += macdBear ? 15 : 0
bearScore += rsiBear ? 10 : 0
bearScore += stochBear ? 5 : 0
bearScore += volumeOK ? 10 : 0
bearScore += adxOK ? 10 : 0


//====================================================
// SIGNAL ENGINE
//====================================================

rawBuy =
     bullScore >= minScore and
     localBull and
     htfBull

rawSell =
     bearScore >= minScore and
     localBear and
     htfBear


// Only one trade at a time.
// barstate.isconfirmed prevents intrabar repainting.

buySignal =
     rawBuy and
     strategy.position_size == 0 and
     barstate.isconfirmed

sellSignal =
     rawSell and
     strategy.position_size == 0 and
     barstate.isconfirmed


//====================================================
// TRADE VARIABLES
//====================================================

// These variables belong ONLY to the CURRENT trade.

var float activeEntry = na
var float activeSL = na
var float activeTP1 = na
var float activeTP2 = na

var float activeRisk = na

var int activeDirection = 0

var string tradeStatus = "WAIT"
var string lastResult = "NONE"

var int lastClosedTradeCount = 0


//====================================================
// NEW BUY
//====================================================

if buySignal

    // IMPORTANT:
    // close = OPTION PREMIUM when chart is an option.
    float signalPremium = close

    float riskDistance =
         atrValue * slATR

    activeEntry := signalPremium
    activeRisk := riskDistance

    activeSL :=
         signalPremium - riskDistance

    activeTP1 :=
         signalPremium +
         riskDistance * tp1RR

    activeTP2 :=
         signalPremium +
         riskDistance * tp2RR

    activeDirection := 1
    tradeStatus := "ACTIVE"

    strategy.entry(
         "LONG",
         strategy.long)


//====================================================
// NEW SELL
//====================================================

if sellSignal

    // IMPORTANT:
    // close = OPTION PREMIUM when chart is an option.

    float signalPremium = close

    float riskDistance =
         atrValue * slATR

    activeEntry := signalPremium
    activeRisk := riskDistance

    activeSL :=
         signalPremium + riskDistance

    activeTP1 :=
         signalPremium -
         riskDistance * tp1RR

    activeTP2 :=
         signalPremium -
         riskDistance * tp2RR

    activeDirection := -1
    tradeStatus := "ACTIVE"

    strategy.entry(
         "SHORT",
         strategy.short)


//====================================================
// UPDATE ENTRY TO ACTUAL FILLED PREMIUM
//====================================================
//
// Because process_orders_on_close=true,
// the strategy is filled on the signal bar.
//
// strategy.position_avg_price is therefore the
// actual strategy fill price.
//
// This prevents old option-premium values from
// contaminating the dashboard.
//

if strategy.position_size != 0

    float actualEntry =
         strategy.position_avg_price

    activeEntry := actualEntry

    if activeDirection == 1

        activeSL :=
             actualEntry - activeRisk

        activeTP1 :=
             actualEntry +
             activeRisk * tp1RR

        activeTP2 :=
             actualEntry +
             activeRisk * tp2RR

    if activeDirection == -1

        activeSL :=
             actualEntry + activeRisk

        activeTP1 :=
             actualEntry -
             activeRisk * tp1RR

        activeTP2 :=
             actualEntry -
             activeRisk * tp2RR


//====================================================
// EXIT ORDERS
//====================================================

if strategy.position_size > 0 and
   activeDirection == 1 and
   not na(activeSL)

    strategy.exit(
         "L-SL-TP1",
         from_entry="LONG",
         stop=activeSL,
         limit=activeTP1,
         qty_percent=tp1Qty)

    strategy.exit(
         "L-SL-TP2",
         from_entry="LONG",
         stop=activeSL,
         limit=activeTP2,
         qty_percent=100 - tp1Qty)


if strategy.position_size < 0 and
   activeDirection == -1 and
   not na(activeSL)

    strategy.exit(
         "S-SL-TP1",
         from_entry="SHORT",
         stop=activeSL,
         limit=activeTP1,
         qty_percent=tp1Qty)

    strategy.exit(
         "S-SL-TP2",
         from_entry="SHORT",
         stop=activeSL,
         limit=activeTP2,
         qty_percent=100 - tp1Qty)


//====================================================
// POSITION CLOSE DETECTION
//====================================================

positionClosed =
     strategy.position_size == 0 and
     strategy.position_size[1] != 0


//====================================================
// CLOSED TRADE RESULT
//====================================================

if positionClosed and
   strategy.closedtrades > lastClosedTradeCount

    int closedIndex =
         strategy.closedtrades - 1

    string exitID =
         strategy.closedtrades.exit_id(
             closedIndex)

    float closedProfit =
         strategy.closedtrades.profit(
             closedIndex)

    if str.contains(exitID, "SL")

        lastResult := "SL HIT"
        tradeStatus := "SL HIT"

    else if str.contains(exitID, "TP1")

        lastResult := "TP1 HIT"
        tradeStatus := "TP1 HIT"

    else if str.contains(exitID, "TP2")

        lastResult := "TP2 HIT"
        tradeStatus := "TP2 HIT"

    else

        lastResult :=
             closedProfit >= 0 ?
             "PROFIT" :
             "LOSS"

        tradeStatus := lastResult

    lastClosedTradeCount :=
         strategy.closedtrades

    // IMPORTANT:
    // Clear active levels after trade closes.
    //
    // This is the main fix for the old
    // ₹547 / ₹570 / ₹525 stale-premium problem.

    activeEntry := na
    activeSL := na
    activeTP1 := na
    activeTP2 := na
    activeRisk := na

    activeDirection := 0


//====================================================
// TP1 PARTIAL DETECTION
//====================================================

partialExit =
     strategy.position_size != 0 and
     math.abs(strategy.position_size) <
     math.abs(strategy.position_size[1])

if partialExit

    tradeStatus := "TP1 HIT"


//====================================================
// CURRENT PREMIUM
//====================================================
//
// ALWAYS the actual chart instrument price.
// For an option chart this is the option premium.
//
// Example:
// If chart premium = ₹109.55,
// CURRENT PREMIUM will show ₹109.55.
//

currentPremium = close


//====================================================
// DISPLAY PLOTS
//====================================================

plot(
     showEMA ? ema20 : na,
     title="EMA 20",
     color=color.orange,
     linewidth=2)

plot(
     showEMA ? ema50 : na,
     title="EMA 50",
     color=color.blue,
     linewidth=2)

plot(
     showVWAP ? vwapValue : na,
     title="VWAP",
     color=color.yellow,
     linewidth=2)


//====================================================
// ACTIVE TRADE LEVELS
//====================================================

plot(
     showTradeLevels and
     strategy.position_size != 0 ?
     activeEntry : na,
     title="ENTRY",
     color=color.blue,
     linewidth=2,
     style=plot.style_linebr)

plot(
     showTradeLevels and
     strategy.position_size != 0 ?
     activeSL : na,
     title="STOP LOSS",
     color=color.red,
     linewidth=2,
     style=plot.style_linebr)

plot(
     showTradeLevels and
     strategy.position_size != 0 ?
     activeTP1 : na,
     title="TARGET 1",
     color=color.green,
     linewidth=2,
     style=plot.style_linebr)

plot(
     showTradeLevels and
     strategy.position_size != 0 ?
     activeTP2 : na,
     title="TARGET 2",
     color=color.lime,
     linewidth=2,
     style=plot.style_linebr)


//====================================================
// BUY / SELL SIGNALS
//====================================================
//
// NO blink filter.
// Historical signals remain visible.
// Realtime signals also remain visible.
//

plotshape(
     showSignals and buySignal,
     title="KK BUY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.green,
     textcolor=color.white,
     text="BUY",
     size=size.small)

plotshape(
     showSignals and sellSignal,
     title="KK SELL",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     textcolor=color.white,
     text="SELL",
     size=size.small)


//====================================================
// SCORE LABELS
//====================================================

if showScoreLabels and buySignal

    label.new(
         bar_index,
         low,
         "BUY\n" +
         str.tostring(bullScore, "#") +
         "/100",
         style=label.style_label_up,
         color=color.green,
         textcolor=color.white,
         size=size.small)

if showScoreLabels and sellSignal

    label.new(
         bar_index,
         high,
         "SELL\n" +
         str.tostring(bearScore, "#") +
         "/100",
         style=label.style_label_down,
         color=color.red,
         textcolor=color.white,
         size=size.small)


//====================================================
// DASHBOARD
//====================================================

var table dash =
     table.new(
         position.top_right,
         2,
         16,
         border_width=1)

if showDashboard and barstate.islast

    float currentScore =
         math.max(
             bullScore,
             bearScore)

    string dashboardSignal =
         strategy.position_size > 0 ?
         "BUY" :
         strategy.position_size < 0 ?
         "SELL" :
         rawBuy ?
         "BUY" :
         rawSell ?
         "SELL" :
         "WAIT"

    float signalScore =
         dashboardSignal == "BUY" ?
         bullScore :
         dashboardSignal == "SELL" ?
         bearScore :
         currentScore

    string confidence =
         signalScore >= 85 ?
         "VERY HIGH" :
         signalScore >= 75 ?
         "HIGH" :
         signalScore >= 65 ?
         "MEDIUM" :
         "LOW"

    string trendText =
         htfBull and localBull ?
         "BULLISH" :
         htfBear and localBear ?
         "BEARISH" :
         "MIXED"

    string momentumText =
         macdBull and rsiBull ?
         "BULLISH" :
         macdBear and rsiBear ?
         "BEARISH" :
         "MIXED"

    string volumeText =
         str.tostring(
             volumeRatio,
             "#.##") + "x"

    string statusText =
         strategy.position_size != 0 ?
         "ACTIVE" :
         tradeStatus

    string directionText =
         activeDirection == 1 ?
         "LONG" :
         activeDirection == -1 ?
         "SHORT" :
         "-"

    color signalBG =
         dashboardSignal == "BUY" ?
         color.green :
         dashboardSignal == "SELL" ?
         color.red :
         color.gray

    color statusBG =
         statusText == "ACTIVE" ?
         color.green :
         statusText == "SL HIT" ?
         color.red :
         statusText == "TP1 HIT" ?
         color.green :
         statusText == "TP2 HIT" ?
         color.lime :
         color.gray


    //================================================
    // HEADER
    //================================================

    table.cell(
         dash, 0, 0,
         "KK EDGE PRO v6.2",
         bgcolor=color.black,
         text_color=color.white)

    table.cell(
         dash, 1, 0,
         timeframe.period,
         bgcolor=color.black,
         text_color=color.white)


    //================================================
    // CURRENT PREMIUM
    //================================================

    table.cell(
         dash, 0, 1,
         "CURRENT PREMIUM",
         bgcolor=color.black,
         text_color=color.white)

    table.cell(
         dash, 1, 1,
         str.tostring(
             currentPremium,
             format.mintick),
         bgcolor=color.blue,
         text_color=color.white)


    //================================================
    // LIVE TIME
    //================================================

    table.cell(
         dash, 0, 2,
         "LIVE TIME",
         bgcolor=color.black,
         text_color=color.white)

    table.cell(
         dash, 1, 2,
         str.format(
             "{0,time,HH:mm:ss}",
             timenow),
         bgcolor=color.black,
         text_color=color.white)


    //================================================
    // SIGNAL
    //================================================

    table.cell(
         dash, 0, 3,
         "SIGNAL",
         bgcolor=color.black,
         text_color=color.white)

    table.cell(
         dash, 1, 3,
         dashboardSignal,
         bgcolor=signalBG,
         text_color=color.white)


    //================================================
    // CURRENT SCORE
    //================================================

    table.cell(
         dash, 0, 4,
         "CURRENT SCORE",
         bgcolor=color.black,
         text_color=color.white)

    table.cell(
         dash, 1, 4,
         str.tostring(
             currentScore,
             "#") + "/100",
         bgcolor=color.black,
         text_color=color.white)


    //================================================
    // BULL SCORE
    //================================================

    table.cell(
         dash, 0, 5,
         "BULL SCORE",
         bgcolor=color.black,
         text_color=color.white)

    table.cell(
         dash, 1, 5,
         str.tostring(
             bullScore,
             "#") + "/100",
         bgcolor=color.green,
         text_color=color.white)


    //================================================
    // BEAR SCORE
    //================================================

    table.cell(
         dash, 0, 6,
         "BEAR SCORE",
         bgcolor=color.black,
         text_color=color.white)

    table.cell(
         dash, 1, 6,
         str.tostring(
             bearScore,
             "#") + "/100",
         bgcolor=color.red,
         text_color=color.white)


    //================================================
    // CONFIDENCE
    //================================================

    table.cell(
         dash, 0, 7,
         "CONFIDENCE",
         bgcolor=color.black,
         text_color=color.white)

    table.cell(
         dash, 1, 7,
         confidence,
         bgcolor=
             confidence == "VERY HIGH" ?
             color.green :
             confidence == "HIGH" ?
             color.teal :
             confidence == "MEDIUM" ?
             color.orange :
             color.gray,
         text_color=color.white)


    //================================================
    // ENTRY
    //================================================

    table.cell(
         dash, 0, 8,
         "ENTRY",
         bgcolor=color.black,
         text_color=color.white)

    table.cell(
         dash, 1, 8,
         strategy.position_size != 0 and
         not na(activeEntry) ?
         str.tostring(
             activeEntry,
             format.mintick) :
         "-",
         bgcolor=color.blue,
         text_color=color.white)


    //================================================
    // STOP LOSS
    //================================================

    table.cell(
         dash, 0, 9,
         "STOP LOSS",
         bgcolor=color.black,
         text_color=color.white)

    table.cell(
         dash, 1, 9,
         strategy.position_size != 0 and
         not na(activeSL) ?
         str.tostring(
             activeSL,
             format.mintick) :
         "-",
         bgcolor=color.maroon,
         text_color=color.white)


    //================================================
    // TARGET 1
    //================================================

    table.cell(
         dash, 0, 10,
         "TARGET 1",
         bgcolor=color.black,
         text_color=color.white)

    table.cell(
         dash, 1, 10,
         strategy.position_size != 0 and
         not na(activeTP1) ?
         str.tostring(
             activeTP1,
             format.mintick) :
         "-",
         bgcolor=color.green,
         text_color=color.white)


    //================================================
    // TARGET 2
    //================================================

    table.cell(
         dash, 0, 11,
         "TARGET 2",
         bgcolor=color.black,
         text_color=color.white)

    table.cell(
         dash, 1, 11,
         strategy.position_size != 0 and
         not na(activeTP2) ?
         str.tostring(
             activeTP2,
             format.mintick) :
         "-",
         bgcolor=color.green,
         text_color=color.white)


    //================================================
    // STATUS
    //================================================

    table.cell(
         dash, 0, 12,
         "STATUS",
         bgcolor=color.black,
         text_color=color.white)

    table.cell(
         dash, 1, 12,
         statusText,
         bgcolor=statusBG,
         text_color=color.white)


    //================================================
    // DIRECTION
    //================================================

    table.cell(
         dash, 0, 13,
         "POSITION",
         bgcolor=color.black,
         text_color=color.white)

    table.cell(
         dash, 1, 13,
         directionText,
         bgcolor=color.black,
         text_color=color.white)


    //================================================
    // TREND
    //================================================

    table.cell(
         dash, 0, 14,
         "TREND",
         bgcolor=color.black,
         text_color=color.white)

    table.cell(
         dash, 1, 14,
         trendText,
         bgcolor=
             trendText == "BULLISH" ?
             color.green :
             trendText == "BEARISH" ?
             color.red :
             color.gray,
         text_color=color.white)


    //================================================
    // MOMENTUM / VOLUME
    //================================================

    table.cell(
         dash, 0, 15,
         "MOM / VOL",
         bgcolor=color.black,
         text_color=color.white)

    table.cell(
         dash, 1, 15,
         momentumText +
         " / " +
         volumeText,
         bgcolor=color.black,
         text_color=color.white)


//====================================================
// ALERTS
//====================================================

alertcondition(
     buySignal,
     title="KK EDGE PRO BUY",
     message="KK EDGE PRO BUY | {{ticker}} | TF={{interval}} | Premium={{close}}")

alertcondition(
     sellSignal,
     title="KK EDGE PRO SELL",
     message="KK EDGE PRO SELL | {{ticker}} | TF={{interval}} | Premium={{close}}")

alertcondition(
     positionClosed and
     lastResult == "SL HIT",
     title="KK EDGE PRO SL HIT",
     message="KK EDGE PRO SL HIT | {{ticker}} | TF={{interval}}")

alertcondition(
     partialExit,
     title="KK EDGE PRO TP1",
     message="KK EDGE PRO TP1 HIT | {{ticker}} | TF={{interval}}")

alertcondition(
     positionClosed and
     lastResult == "TP2 HIT",
     title="KK EDGE PRO TP2",
     message="KK EDGE PRO TP2 HIT | {{ticker}} | TF={{interval}}")