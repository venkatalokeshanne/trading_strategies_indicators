        //============================================================

        string bVWAPText = "BELOW"

        if bPrice > bVWAP
            bVWAPText := "ABOVE"


        table.cell(dash, 0, 11, "Bharti Airtel", text_color=normalTextColor, bgcolor=normalBackgroundColor, text_size=textSize)

