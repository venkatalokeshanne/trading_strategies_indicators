//@version=6
// ============================================================================
//  NYSE Opening Range with POC
//  Builds the New York opening range (09:30 ET) over the first 15 and/or 30
//  minutes, each with the volume-profile Point of Control of its range.
//  The range INCLUDES the candle stamped at the end time (09:45 / 10:00).
//  The levels are DYNAMIC while the range is forming and FREEZE once the
//  window completes; they then extend to the right until the session close
//  (16:00 ET) — no premarket, no overnight.
//  Keeps every session of the current week (Monday to Friday) with its own
//  price labels at the end of the lines; the drawings reset when a new week
//  starts. Times follow America/New_York (DST handled automatically).
//  Best on 1-5 minute charts, since the profiles are built from chart bars.
// ============================================================================
indicator("NYSE Opening Range with POC", "NY OR POC", overlay = true,
     max_lines_count = 64, max_labels_count = 64)

ROWS    = input.int(50, "Profile rows", minval = 10, maxval = 200)
showLbl = input.bool(true, "Price labels")

G15 = "Opening Range 15 min"
use15 = input.bool(false, "Show 15-minute range", group = G15)
c15  = input.color(color.aqua, "Range", inline = "a", group = G15)
w15  = input.int(2, "width", minval = 1, maxval = 6, inline = "a", group = G15)
s15  = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "a", group = G15)
p15  = input.color(color.white, "POC  ", inline = "b", group = G15)
wp15 = input.int(2, "width", minval = 1, maxval = 6, inline = "b", group = G15)
sp15 = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], inline = "b", group = G15)
t15  = input.color(color.white, "Text", inline = "c", group = G15)

G30 = "Opening Range 30 min"
use30 = input.bool(true, "Show 30-minute range", group = G30)
c30  = input.color(#2962ff, "Range", inline = "a", group = G30)
w30  = input.int(2, "width", minval = 1, maxval = 6, inline = "a", group = G30)
s30  = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "a", group = G30)
p30  = input.color(color.white, "POC  ", inline = "b", group = G30)
wp30 = input.int(2, "width", minval = 1, maxval = 6, inline = "b", group = G30)
sp30 = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], inline = "b", group = G30)
t30  = input.color(color.white, "Text", inline = "c", group = G30)

styleOf(s) =>
    s == "Solid" ? line.style_solid :
     s == "Dashed" ? line.style_dashed : line.style_dotted

// POC of the accumulated bars: volume distributed proportionally to each
// bar's overlap with each price row
f_poc(array<float> ah, array<float> al, array<float> av, int rows) =>
    float lo = al.min()
    float hi = ah.max()
    float step = (hi - lo) / rows
    float out = math.avg(hi, lo)
    if step > 0
        vol = array.new<float>(rows, 0.0)
        for i = 0 to ah.size() - 1
            bl = al.get(i)
            bh = ah.get(i)
            bv = av.get(i)
            r0 = math.max(int(math.floor((bl - lo) / step)), 0)
            r1 = math.min(int(math.floor((bh - lo) / step)), rows - 1)
            for r = r0 to r1
                lvl = lo + r * step
                prop = bh <= bl ? 1.0 :
                     (math.min(bh, lvl + step) - math.max(bl, lvl)) / (bh - bl)
                vol.set(r, vol.get(r) + bv * prop)
        out := lo + (vol.indexof(vol.max()) + 0.5) * step
    out

// ── session windows (New York time, Monday-Friday only) ────────────────────
// inclusive of the bar STAMPED at the end time (09:45 / 10:00), so the
// candle that opens exactly at the boundary is part of the range
nyTZ = "America/New_York"
nyMins = hour(time, nyTZ) * 60 + minute(time, nyTZ)
dw = dayofweek(time, nyTZ)
isWD = dw >= dayofweek.monday and dw <= dayofweek.friday
in15 = isWD and nyMins >= 570 and nyMins <= 585     // 09:30 .. 09:45 inclusive
in30 = isWD and nyMins >= 570 and nyMins <= 600     // 09:30 .. 10:00 inclusive
inSess = isWD and nyMins >= 570 and nyMins < 960    // regular session 09:30-16:00

// ── weekly housekeeping: clear last week's drawings on a new week ──────────
var array<line> wkLines = array.new<line>()
var array<label> wkLabels = array.new<label>()
var int curWk = na
if in30 and not in30[1]
    wk = year(time, nyTZ) * 100 + weekofyear(time, nyTZ)
    if na(curWk) or wk != curWk
        while wkLines.size() > 0
            line.delete(wkLines.pop())
        while wkLabels.size() > 0
            label.delete(wkLabels.pop())
        curWk := wk

// ── 15-minute range ────────────────────────────────────────────────────────
var array<float> h15a = array.new<float>()
var array<float> l15a = array.new<float>()
var array<float> v15a = array.new<float>()
var float h15 = na
var float l15 = na
var float poc15 = na
var line ln15h = na
var line ln15l = na
var line ln15p = na
var label lb15h = na
var label lb15l = na
var label lb15p = na

if use15
    if in15 and not in15[1]
        h15a.clear()
        l15a.clear()
        v15a.clear()
        ln15h := line.new(bar_index, high, bar_index, high)
        ln15l := line.new(bar_index, low, bar_index, low)
        ln15p := line.new(bar_index, high, bar_index, high)
        wkLines.push(ln15h)
        wkLines.push(ln15l)
        wkLines.push(ln15p)
        if showLbl
            lb15h := label.new(bar_index, high, "", style = label.style_label_left, color = color.new(c15, 70), size = size.small)
            lb15l := label.new(bar_index, low, "", style = label.style_label_left, color = color.new(c15, 70), size = size.small)
            lb15p := label.new(bar_index, high, "", style = label.style_label_left, color = color.new(p15, 70), size = size.small)
            wkLabels.push(lb15h)
            wkLabels.push(lb15l)
            wkLabels.push(lb15p)
    if in15
        h15a.push(high)
        l15a.push(low)
        v15a.push(volume)
        h15 := h15a.max()
        l15 := l15a.min()
        poc15 := f_poc(h15a, l15a, v15a, ROWS)
        startBar = bar_index - h15a.size() + 1
        line.set_xy1(ln15h, startBar, h15)
        line.set_xy2(ln15h, bar_index, h15)
        line.set_xy1(ln15l, startBar, l15)
        line.set_xy2(ln15l, bar_index, l15)
        line.set_xy1(ln15p, startBar, poc15)
        line.set_xy2(ln15p, bar_index, poc15)
        line.set_color(ln15h, c15)
        line.set_width(ln15h, w15)
        line.set_style(ln15h, styleOf(s15))
        line.set_color(ln15l, c15)
        line.set_width(ln15l, w15)
        line.set_style(ln15l, styleOf(s15))
        line.set_color(ln15p, p15)
        line.set_width(ln15p, wp15)
        line.set_style(ln15p, styleOf(sp15))
        if showLbl
            label.set_xy(lb15h, bar_index, h15)
            label.set_text(lb15h, "OR15 High " + str.tostring(h15, format.mintick))
            label.set_textcolor(lb15h, t15)
            label.set_xy(lb15l, bar_index, l15)
            label.set_text(lb15l, "OR15 Low " + str.tostring(l15, format.mintick))
            label.set_textcolor(lb15l, t15)
            label.set_xy(lb15p, bar_index, poc15)
            label.set_text(lb15p, "OR15 POC " + str.tostring(poc15, format.mintick))
            label.set_textcolor(lb15p, t15)
    else if not na(ln15h) and inSess
        line.set_x2(ln15h, bar_index)
        line.set_x2(ln15l, bar_index)
        line.set_x2(ln15p, bar_index)
        if showLbl and not na(lb15h)
            label.set_x(lb15h, bar_index)
            label.set_x(lb15l, bar_index)
            label.set_x(lb15p, bar_index)

// ── 30-minute range ────────────────────────────────────────────────────────
var array<float> h30a = array.new<float>()
var array<float> l30a = array.new<float>()
var array<float> v30a = array.new<float>()
var float h30 = na
var float l30 = na
var float poc30 = na
var line ln30h = na
var line ln30l = na
var line ln30p = na
var label lb30h = na
var label lb30l = na
var label lb30p = na

if use30
    if in30 and not in30[1]
        h30a.clear()
        l30a.clear()
        v30a.clear()
        ln30h := line.new(bar_index, high, bar_index, high)
        ln30l := line.new(bar_index, low, bar_index, low)
        ln30p := line.new(bar_index, high, bar_index, high)
        wkLines.push(ln30h)
        wkLines.push(ln30l)
        wkLines.push(ln30p)
        if showLbl
            lb30h := label.new(bar_index, high, "", style = label.style_label_left, color = color.new(c30, 70), size = size.small)
            lb30l := label.new(bar_index, low, "", style = label.style_label_left, color = color.new(c30, 70), size = size.small)
            lb30p := label.new(bar_index, high, "", style = label.style_label_left, color = color.new(p30, 70), size = size.small)
            wkLabels.push(lb30h)
            wkLabels.push(lb30l)
            wkLabels.push(lb30p)
    if in30
        h30a.push(high)
        l30a.push(low)
        v30a.push(volume)
        h30 := h30a.max()
        l30 := l30a.min()
        poc30 := f_poc(h30a, l30a, v30a, ROWS)
        startBar = bar_index - h30a.size() + 1
        line.set_xy1(ln30h, startBar, h30)
        line.set_xy2(ln30h, bar_index, h30)
        line.set_xy1(ln30l, startBar, l30)
        line.set_xy2(ln30l, bar_index, l30)
        line.set_xy1(ln30p, startBar, poc30)
        line.set_xy2(ln30p, bar_index, poc30)
        line.set_color(ln30h, c30)
        line.set_width(ln30h, w30)
        line.set_style(ln30h, styleOf(s30))
        line.set_color(ln30l, c30)
        line.set_width(ln30l, w30)
        line.set_style(ln30l, styleOf(s30))
        line.set_color(ln30p, p30)
        line.set_width(ln30p, wp30)
        line.set_style(ln30p, styleOf(sp30))
        if showLbl
            label.set_xy(lb30h, bar_index, h30)
            label.set_text(lb30h, "OR30 High " + str.tostring(h30, format.mintick))
            label.set_textcolor(lb30h, t30)
            label.set_xy(lb30l, bar_index, l30)
            label.set_text(lb30l, "OR30 Low " + str.tostring(l30, format.mintick))
            label.set_textcolor(lb30l, t30)
            label.set_xy(lb30p, bar_index, poc30)
            label.set_text(lb30p, "OR30 POC " + str.tostring(poc30, format.mintick))
            label.set_textcolor(lb30p, t30)
    else if not na(ln30h) and inSess
        line.set_x2(ln30h, bar_index)
        line.set_x2(ln30l, bar_index)
        line.set_x2(ln30p, bar_index)
        if showLbl and not na(lb30h)
            label.set_x(lb30h, bar_index)
            label.set_x(lb30l, bar_index)
            label.set_x(lb30p, bar_index)
