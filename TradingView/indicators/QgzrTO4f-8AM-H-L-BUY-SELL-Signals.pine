//@version=6
indicator("Custom Hour High & Low + Sweep Signals", shorttitle="Hour H/L Signals", overlay=true, max_lines_count=500, max_labels_count=500)

// ============================================================================
// TIMEZONE
// ============================================================================

string TZ = "America/New_York"

// ============================================================================
// RANGE SETTINGS
// ============================================================================

groupRange = "Range Settings"

startHour = input.int(8, "Start Hour", minval=0, maxval=23, group=groupRange)
startMinute = input.int(0, "Start Minute", minval=0, maxval=59, group=groupRange)

endHour = input.int(9, "End Hour", minval=0, maxval=23, group=groupRange)
endMinute = input.int(0, "End Minute", minval=0, maxval=59, group=groupRange)

// ============================================================================
// EXTENSION SETTINGS
// ============================================================================

groupExtension = "Line Extension"

extensionHour = input.int(12, "Extend Until Hour", minval=0, maxval=23, group=groupExtension)
extensionMinute = input.int(0, "Extend Until Minute", minval=0, maxval=59, group=groupExtension)

// ============================================================================
// LINE SETTINGS
// ============================================================================

groupStyle = "Line Settings"

highColor = input.color(
     color.rgb(0, 0, 0),
     "High Line Color",
     group=groupStyle)

lowColor = input.color(
     color.rgb(0, 0, 0),
     "Low Line Color",
     group=groupStyle)

lineWidth = input.int(
     1,
     "Line Thickness",
     minval=1,
     maxval=5,
     group=groupStyle)

lineStyleInput = input.string(
     "Solid",
     "Line Style",
     options=["Solid", "Dashed", "Dotted"],
     group=groupStyle)

lineStyle = switch lineStyleInput
    "Dashed" => line.style_dashed
    "Dotted" => line.style_dotted
    => line.style_solid

// ============================================================================
// SIGNAL SETTINGS
// ============================================================================

groupSignals = "Signal Settings"

showSignals = input.bool(
     true,
     "Show Buy/Sell Signals",
     group=groupSignals)

signalStartHour = input.int(
     9,
     "Signal Start Hour",
     minval=0,
     maxval=23,
     group=groupSignals)

signalStartMinute = input.int(
     30,
     "Signal Start Minute",
     minval=0,
     maxval=59,
     group=groupSignals)

signalEndHour = input.int(
     11,
     "Signal End Hour",
     minval=0,
     maxval=23,
     group=groupSignals)

signalEndMinute = input.int(
     0,
     "Signal End Minute",
     minval=0,
     maxval=59,
     group=groupSignals)

// Number of bars allowed for confirmation
confirmationBars = input.int(
     1,
     "Bar Confirmation",
     minval=1,
     maxval=20,
     group=groupSignals,
     tooltip="Number of bars after the level interaction allowed for confirmation.")

// How close price must get to the level to count as a tap
signalToleranceTicks = input.int(
     0,
     "Tap Tolerance (Ticks)",
     minval=0,
     maxval=100,
     group=groupSignals,
     tooltip="Allows price to come slightly away from the exact level and still count as a tap.")

// ============================================================================
// SIGNAL APPEARANCE
// ============================================================================

groupSignalStyle = "Signal Appearance"

buyColor = input.color(
     #006132,
     "Buy Signal Color",
     group=groupSignalStyle)

sellColor = input.color(
     #600000,
     "Sell Signal Color",
     group=groupSignalStyle)

signalSizeInput = input.string(
     "Small",
     "Signal Size",
     options=["Tiny", "Small", "Normal", "Large", "Huge"],
     group=groupSignalStyle)

// ============================================================================
// TIME CALCULATIONS
// ============================================================================

int currentHour = hour(time, TZ)
int currentMinute = minute(time, TZ)

int currentMinutes = currentHour * 60 + currentMinute

int startMinutes = startHour * 60 + startMinute
int endMinutes = endHour * 60 + endMinute

int extensionMinutes = extensionHour * 60 + extensionMinute

int signalStartMinutes = signalStartHour * 60 + signalStartMinute
int signalEndMinutes = signalEndHour * 60 + signalEndMinute

// ============================================================================
// DAY TRACKING
// ============================================================================

int currentDay = year(time, TZ) * 10000 +
     month(time, TZ) * 100 +
     dayofmonth(time, TZ)

bool newDay = ta.change(currentDay) != 0

// ============================================================================
// RANGE VARIABLES
// ============================================================================

var float rangeHigh = na
var float rangeLow = na

var int rangeStartBar = na
var int rangeEndBar = na

var line highLine = na
var line lowLine = na

// ============================================================================
// SIGNAL VARIABLES
// ============================================================================

var bool buySignalGiven = false
var bool sellSignalGiven = false

// Bullish setup
var bool bullishSetup = false
var int bullishSetupBar = na

// Bearish setup
var bool bearishSetup = false
var int bearishSetupBar = na

// ============================================================================
// RESET EACH DAY
// ============================================================================

if newDay

    rangeHigh := na
    rangeLow := na

    rangeStartBar := na
    rangeEndBar := na

    highLine := na
    lowLine := na

    buySignalGiven := false
    sellSignalGiven := false

    bullishSetup := false
    bearishSetup := false

    bullishSetupBar := na
    bearishSetupBar := na

// ============================================================================
// RANGE DETECTION
// ============================================================================

bool inRange = startMinutes < endMinutes ?
     currentMinutes >= startMinutes and currentMinutes < endMinutes :
     currentMinutes >= startMinutes or currentMinutes < endMinutes

// ============================================================================
// BUILD RANGE
// ============================================================================

if inRange

    if na(rangeHigh)

        rangeHigh := high
        rangeLow := low
        rangeStartBar := bar_index

    else

        rangeHigh := math.max(rangeHigh, high)
        rangeLow := math.min(rangeLow, low)

    rangeEndBar := bar_index

// ============================================================================
// RANGE JUST ENDED
// ============================================================================

bool rangeJustEnded = not inRange and inRange[1]

// ============================================================================
// CREATE RANGE LINES
// ============================================================================

if rangeJustEnded and not na(rangeHigh) and not na(rangeLow)

    highLine := line.new(
         x1=rangeStartBar,
         y1=rangeHigh,
         x2=bar_index,
         y2=rangeHigh,
         xloc=xloc.bar_index,
         extend=extend.none,
         color=highColor,
         style=lineStyle,
         width=lineWidth)

    lowLine := line.new(
         x1=rangeStartBar,
         y1=rangeLow,
         x2=bar_index,
         y2=rangeLow,
         xloc=xloc.bar_index,
         extend=extend.none,
         color=lowColor,
         style=lineStyle,
         width=lineWidth)

// ============================================================================
// EXTEND RANGE LINES
// ============================================================================

if not na(highLine) and not na(lowLine) and not inRange

    if currentMinutes <= extensionMinutes

        line.set_x2(highLine, bar_index)
        line.set_x2(lowLine, bar_index)

// ============================================================================
// LINE SETTINGS
// ============================================================================

if not na(highLine)

    line.set_color(highLine, highColor)
    line.set_width(highLine, lineWidth)
    line.set_style(highLine, lineStyle)

if not na(lowLine)

    line.set_color(lowLine, lowColor)
    line.set_width(lowLine, lineWidth)
    line.set_style(lowLine, lineStyle)

// ============================================================================
// SIGNAL WINDOW
// ============================================================================

bool signalWindow =
     currentMinutes >= signalStartMinutes and
     currentMinutes < signalEndMinutes

// ============================================================================
// LEVELS READY
// ============================================================================

bool levelsReady =
     not na(rangeHigh) and
     not na(rangeLow)

// ============================================================================
// TOLERANCE
// ============================================================================

float tolerance = signalToleranceTicks * syminfo.mintick

// ============================================================================
// LOW INTERACTION
// ============================================================================

// Price sweeps BELOW the low and closes back above it.
bool lowSweep =
     levelsReady and
     signalWindow and
     low < rangeLow and
     close > rangeLow

// Price simply taps the low.
bool lowTap =
     levelsReady and
     signalWindow and
     low <= rangeLow + tolerance and
     low >= rangeLow - tolerance

// ============================================================================
// HIGH INTERACTION
// ============================================================================

// Price sweeps ABOVE the high and closes back below it.
bool highSweep =
     levelsReady and
     signalWindow and
     high > rangeHigh and
     close < rangeHigh

// Price simply taps the high.
bool highTap =
     levelsReady and
     signalWindow and
     high >= rangeHigh - tolerance and
     high <= rangeHigh + tolerance

// ============================================================================
// BULLISH SETUP
// ============================================================================

// Any legitimate interaction with the LOW starts a bullish setup.

if not buySignalGiven and (lowSweep or lowTap)

    bullishSetup := true
    bullishSetupBar := bar_index

// ============================================================================
// BEARISH SETUP
// ============================================================================

// Any legitimate interaction with the HIGH starts a bearish setup.

if not sellSignalGiven and (highSweep or highTap)

    bearishSetup := true
    bearishSetupBar := bar_index

// ============================================================================
// SETUP EXPIRATION
// ============================================================================

// The setup is only valid for the selected number of bars.

if bullishSetup and not na(bullishSetupBar)

    if bar_index - bullishSetupBar > confirmationBars

        bullishSetup := false
        bullishSetupBar := na

if bearishSetup and not na(bearishSetupBar)

    if bar_index - bearishSetupBar > confirmationBars

        bearishSetup := false
        bearishSetupBar := na

// ============================================================================
// DISPLACEMENT
// ============================================================================

// Strong bullish displacement:
// Current candle is bullish and closes above previous candle's high.

bool bullishDisplacement =
     close > open and
     close > high[1]

// Strong bearish displacement:
// Current candle is bearish and closes below previous candle's low.

bool bearishDisplacement =
     close < open and
     close < low[1]

// ============================================================================
// CONFIRMATION
// ============================================================================

bool bullishConfirmation =
     bullishSetup and
     not na(bullishSetupBar) and
     bar_index - bullishSetupBar >= confirmationBars

bool bearishConfirmation =
     bearishSetup and
     not na(bearishSetupBar) and
     bar_index - bearishSetupBar >= confirmationBars

// ============================================================================
// FINAL SIGNALS
// ============================================================================

bool finalBuy =
     showSignals and
     signalWindow and
     bullishConfirmation and
     bullishDisplacement and
     not buySignalGiven

bool finalSell =
     showSignals and
     signalWindow and
     bearishConfirmation and
     bearishDisplacement and
     not sellSignalGiven

// ============================================================================
// LOCK BUY
// ============================================================================

if finalBuy

    buySignalGiven := true

    bullishSetup := false
    bullishSetupBar := na

// ============================================================================
// LOCK SELL
// ============================================================================

if finalSell

    sellSignalGiven := true

    bearishSetup := false
    bearishSetupBar := na

// ============================================================================
// BUY SIGNALS
// ============================================================================

plotshape(
     finalBuy and signalSizeInput == "Tiny",
     title="BUY Tiny",
     style=shape.labelup,
     location=location.belowbar,
     color=buyColor,
     text="BUY",
     textcolor=color.white,
     size=size.tiny)

plotshape(
     finalBuy and signalSizeInput == "Small",
     title="BUY Small",
     style=shape.labelup,
     location=location.belowbar,
     color=buyColor,
     text="BUY",
     textcolor=color.white,
     size=size.small)

plotshape(
     finalBuy and signalSizeInput == "Normal",
     title="BUY Normal",
     style=shape.labelup,
     location=location.belowbar,
     color=buyColor,
     text="BUY",
     textcolor=color.white,
     size=size.normal)

plotshape(
     finalBuy and signalSizeInput == "Large",
     title="BUY Large",
     style=shape.labelup,
     location=location.belowbar,
     color=buyColor,
     text="BUY",
     textcolor=color.white,
     size=size.large)

plotshape(
     finalBuy and signalSizeInput == "Huge",
     title="BUY Huge",
     style=shape.labelup,
     location=location.belowbar,
     color=buyColor,
     text="BUY",
     textcolor=color.white,
     size=size.huge)

// ============================================================================
// SELL SIGNALS
// ============================================================================

plotshape(
     finalSell and signalSizeInput == "Tiny",
     title="SELL Tiny",
     style=shape.labeldown,
     location=location.abovebar,
     color=sellColor,
     text="SELL",
     textcolor=color.white,
     size=size.tiny)

plotshape(
     finalSell and signalSizeInput == "Small",
     title="SELL Small",
     style=shape.labeldown,
     location=location.abovebar,
     color=sellColor,
     text="SELL",
     textcolor=color.white,
     size=size.small)

plotshape(
     finalSell and signalSizeInput == "Normal",
     title="SELL Normal",
     style=shape.labeldown,
     location=location.abovebar,
     color=sellColor,
     text="SELL",
     textcolor=color.white,
     size=size.normal)

plotshape(
     finalSell and signalSizeInput == "Large",
     title="SELL Large",
     style=shape.labeldown,
     location=location.abovebar,
     color=sellColor,
     text="SELL",
     textcolor=color.white,
     size=size.large)

plotshape(
     finalSell and signalSizeInput == "Huge",
     title="SELL Huge",
     style=shape.labeldown,
     location=location.abovebar,
     color=sellColor,
     text="SELL",
     textcolor=color.white,
     size=size.huge)

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(
     finalBuy,
     title="BUY Signal",
     message="BUY: Price interacted with the selected low and confirmed bullish displacement.")

alertcondition(
     finalSell,
     title="SELL Signal",
     message="SELL: Price interacted with the selected high and confirmed bearish displacement.")