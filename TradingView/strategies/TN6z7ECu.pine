//@version=6
strategy("Trinity Flow", 
         overlay=true, 
         default_qty_type=strategy.percent_of_equity, 
         default_qty_value=10,
         pyramiding=0,
         calc_on_every_tick=false,
         calc_on_order_fills=false)

// ==================== パラメータ設定 ====================
// EMA設定
ema8_period = input.int(8, "EMA 短期", minval=1)
ema14_period = input.int(14, "EMA 中期", minval=1)
ema50_period = input.int(50, "EMA 長期", minval=1)

// Stoch RSI設定
stoch_k_period = input.int(3, "Stoch RSI K期間", minval=1)
stoch_d_period = input.int(3, "Stoch RSI D期間", minval=1)
rsi_period = input.int(14, "RSI期間", minval=1)
rsi_smoothing = input.int(14, "RSIスムージング", minval=1)

// ATR設定
atr_period = input.int(14, "ATR期間", minval=1)

// 損切・利確倍率
sl_multiplier = input.float(3.0, "損切 ATR倍率", minval=0.1, step=0.1)
tp_multiplier = input.float(2.0, "利確 ATR倍率", minval=0.1, step=0.1)

// ==================== インジケータ計算 ====================
// EMA計算
ema8 = ta.ema(close, ema8_period)
ema14 = ta.ema(close, ema14_period)
ema50 = ta.ema(close, ema50_period)

// Stoch RSI計算
rsi_value = ta.rsi(close, rsi_period)
stoch_k = ta.stoch(rsi_value, rsi_value, rsi_value, rsi_smoothing)
stoch_k_smoothed = ta.sma(stoch_k, stoch_k_period)
stoch_d = ta.sma(stoch_k_smoothed, stoch_d_period)

// ATR計算
atr_value = ta.atr(atr_period)

// ==================== シグナル条件 ====================
// ロング条件：EMAが8, 14, 50の順番で上から並んでいる
long_ema_condition = ema8 > ema14 and ema14 > ema50

// ショート条件：EMAが50, 14, 8の順番で上から並んでいる
short_ema_condition = ema50 > ema14 and ema14 > ema8

// Stoch RSIクロス条件
stoch_golden_cross_signal = stoch_k_smoothed[1] > stoch_d[1] and stoch_k_smoothed[2] <= stoch_d[2]
stoch_death_cross_signal = stoch_k_smoothed[1] < stoch_d[1] and stoch_k_smoothed[2] >= stoch_d[2]

// エントリー条件
long_entry_condition = long_ema_condition and stoch_golden_cross_signal
short_entry_condition = short_ema_condition and stoch_death_cross_signal

// ATR記録
var float entry_atr = na
if stoch_golden_cross_signal or stoch_death_cross_signal
    entry_atr := atr_value[1]

// ==================== エントリーロジック ====================
// 現在のポジション状態
is_long = strategy.position_size > 0
is_short = strategy.position_size < 0
positionIsFlat = strategy.position_size == 0


// 通常エントリー：ポジションなしの時
if long_entry_condition and positionIsFlat
    stop_loss = close - (entry_atr * sl_multiplier)
    take_profit = close + (entry_atr * tp_multiplier)
    strategy.entry("Long", strategy.long)
    strategy.exit("LongExit", "Long", stop=stop_loss, limit=take_profit)

if short_entry_condition and positionIsFlat
    stop_loss = close + (entry_atr * sl_multiplier)
    take_profit = close - (entry_atr * tp_multiplier)
    strategy.entry("Short", strategy.short)
    strategy.exit("ShortExit", "Short", stop=stop_loss, limit=take_profit)

// ==================== ビジュアライゼーション ====================
// EMAの並び順で色を決定
ema_color = long_ema_condition ? color.new(#FFFFFF, 0) : short_ema_condition ? color.new(#EF5350, 0) : color.new(#757575, 0)

// EMA50を代表として表示（最も重要な長期トレンド）
plot(ema50, color=ema_color, linewidth=2, title="EMA Trend")

// ==================== 価格帯表示 ====================
var line tp_line = na
var line sl_line = na
var line entry_line = na
var box profit_box = na
var box loss_box = na

// ロングエントリー時の表示（通常エントリーまたはドテン）
if long_entry_condition and (positionIsFlat or is_short)
    stop_loss = close - (entry_atr * sl_multiplier)
    take_profit = close + (entry_atr * tp_multiplier)
    
    // 利益ゾーン（薄い白）
    profit_box := box.new(bar_index, take_profit, bar_index, close, 
                          border_color=color.new(#FFFFFF, 80), 
                          bgcolor=color.new(#FFFFFF, 95), 
                          border_width=1)
    
    // 損失ゾーン（薄い赤）
    loss_box := box.new(bar_index, close, bar_index, stop_loss, 
                        border_color=color.new(#EF5350, 80), 
                        bgcolor=color.new(#EF5350, 95), 
                        border_width=1)
    
    // エントリー価格ライン（白）
    entry_line := line.new(bar_index, close, bar_index, close, 
                           color=color.new(#FFFFFF, 30), width=1, style=line.style_solid)
    
    // TPライン（白）
    tp_line := line.new(bar_index, take_profit, bar_index, take_profit, 
                        color=color.new(#FFFFFF, 0), width=1, style=line.style_solid)
    
    // SLライン（赤）
    sl_line := line.new(bar_index, stop_loss, bar_index, stop_loss, 
                        color=color.new(#EF5350, 0), width=1, style=line.style_solid)

// ショートエントリー時の表示（通常エントリーまたはドテン）
if short_entry_condition and (positionIsFlat or is_long)
    stop_loss = close + (entry_atr * sl_multiplier)
    take_profit = close - (entry_atr * tp_multiplier)
    
    // 利益ゾーン（薄い白）
    profit_box := box.new(bar_index, close, bar_index, take_profit, 
                          border_color=color.new(#FFFFFF, 80), 
                          bgcolor=color.new(#FFFFFF, 95), 
                          border_width=1)
    
    // 損失ゾーン（薄い赤）
    loss_box := box.new(bar_index, stop_loss, bar_index, close, 
                        border_color=color.new(#EF5350, 80), 
                        bgcolor=color.new(#EF5350, 95), 
                        border_width=1)
    
    // エントリー価格ライン（白）
    entry_line := line.new(bar_index, close, bar_index, close, 
                           color=color.new(#FFFFFF, 30), width=1, style=line.style_solid)
    
    // TPライン（白）
    tp_line := line.new(bar_index, take_profit, bar_index, take_profit, 
                        color=color.new(#FFFFFF, 0), width=1, style=line.style_solid)
    
    // SLライン（赤）
    sl_line := line.new(bar_index, stop_loss, bar_index, stop_loss, 
                        color=color.new(#EF5350, 0), width=1, style=line.style_solid)

if strategy.position_size != 0 and not na(tp_line)
    line.set_x2(tp_line, bar_index)
    line.set_x2(sl_line, bar_index)
    line.set_x2(entry_line, bar_index)
    box.set_right(profit_box, bar_index)
    box.set_right(loss_box, bar_index)

// エントリーマーカー（通常エントリーまたはドテン）
plotshape(long_entry_condition and (positionIsFlat or is_short), 
          title="Long Entry", 
          style=shape.circle, 
          location=location.belowbar, 
          color=color.new(#FFFFFF, 0), 
          size=size.tiny)

plotshape(short_entry_condition and (positionIsFlat or is_long), 
          title="Short Entry", 
          style=shape.circle, 
          location=location.abovebar, 
          color=color.new(#EF5350, 0), 
          size=size.tiny)
